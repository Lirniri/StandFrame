-- Script start as bootstrap.pluto does it, with the profile's auto_copy_menu set:
-- the pack is copied into core (replacing an older copy) and loads as the built-in menu.
-- The script's lib and store are temp folders here, so nothing is written into src
local stand = require("stand")
stand.boot()

-- Where the copy goes: <scripts>/lib/AnitaDarin/. The code itself still loads from src (package.path)
local scripts = stand.tmpdir("startup_scripts")
local lib = $"{scripts}lib\\AnitaDarin\\"
filesystem.scripts_dir = || -> scripts
-- resources too, so nothing here can reach src (Delete Script below deletes for real)
local resources = stand.tmpdir("startup_resources")
filesystem.resources_dir = || -> resources

-- store: the real AnitaDarin pack and base language files, and a profile that copies the pack
stand.store = stand.tmpdir("startup_store")
local function copy_tree(from: string, to: string): void
    for _, path in io.listdir(from, true) do
        local target = to .. path:sub(#from + 1)
        if io.isdir(path) then
            io.makedirs(target)
        else
            stand.write_file(target, stand.read_file(path))
        end
    end
end
copy_tree($"{stand.SRC}store/AnitaDarin/menu/AnitaDarin", $"{stand.store}AnitaDarin/menu/AnitaDarin")
copy_tree($"{stand.SRC}store/AnitaDarin/base", $"{stand.store}AnitaDarin/base")
io.makedirs($"{stand.store}AnitaDarin/profiles")
stand.write_file($"{stand.store}AnitaDarin/profiles/main.json", '{"auto_copy_menu": "AnitaDarin", "language": "ru-ru"}')

-- An older copy in core: its manifest lists a file the pack no longer has
io.makedirs($"{lib}ui\\stand\\menu_from_store")
stand.write_file($"{lib}ui\\stand\\menu_from_store\\old.pluto", "return {}")
io.makedirs($"{lib}language")
stand.write_file($"{lib}language\\en-us.json", "{}")
stand.write_file($"{lib}ui\\stand\\menu_from_store\\.copied.json", '{"pack": "AnitaDarin", "files": ["ui\\\\stand\\\\menu_from_store\\\\old.pluto", "language\\\\en-us.json"]}')

-- bootstrap.pluto, from the utilities on
for _, name in { "util", "filesystem", "lang" } do
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end
Atdar.profile = Atdar.loader.load("core/profile")
Atdar.natives = Atdar.loader.auto({}, "natives")
Atdar.modules = Atdar.loader.load("core/module_manager")
Atdar.features = Atdar.loader.load("features/registry")
stand.clear_logs()
Atdar.ui.menu = require($"{Atdar.name}/ui/stand/menu")

stand.check(stand.find_log("'AnitaDarin' copied to core"), "the pack was copied at start")
stand.check(stand.find_log("Stand is in English"), "a saved language Stand can't show is reported, not a crash")
stand.check(io.exists($"{lib}ui\\stand\\menu_from_store\\main.pluto"), "its menu is in core")
stand.check(io.exists($"{lib}features\\self\\godmode.pluto"), "its features are in core")
stand.check(not io.exists($"{lib}ui\\stand\\menu_from_store\\old.pluto"), "the older copy's files are gone")
stand.check(not io.exists($"{lib}language\\en-us.json"), "its translations in lib too")
local core_languages = $"{Atdar.filesystem.paths.store}in_core\\menu\\languages\\"
stand.check(io.exists($"{core_languages}en-us.json") and io.exists($"{core_languages}ru-ru.json"), "the translations are in store")
stand.check(stand.read_file($"{lib}ui\\stand\\menu_from_store\\.copied.json"):find('"AnitaDarin"', 1, true), "the new copy has a manifest")

-- The copy is the pack's now: the next start leaves it as it is; a changed file makes it copy again
local builder = Atdar.loader.load("ui/stand/core/menu_builder")
local store_packs = $"{Atdar.filesystem.paths.store}menu\\"
local function pack_info()
    for _, pack in ipairs(builder.find_loadable_packs(store_packs)) do
        if pack.folder == "AnitaDarin" then
            return pack
        end
    end
    return nil
end
stand.check(builder.core_copy_is_current(pack_info(), lib, Atdar.filesystem.paths.store), "right after the copy: the same as the pack")
local godmode_path = $"{stand.store}AnitaDarin/menu/AnitaDarin/features/self/godmode.pluto"
local godmode_text = stand.read_file(godmode_path)
stand.write_file(godmode_path, godmode_text .. "\n-- changed\n")
stand.check(not builder.core_copy_is_current(pack_info(), lib, Atdar.filesystem.paths.store), "a file changed in store: not the same any more")
stand.write_file(godmode_path, godmode_text)
stand.check(builder.core_copy_is_current(pack_info(), lib, Atdar.filesystem.paths.store), "back as it was: the same again")

-- Loaded as the built-in menu, in the main body: the pack's lists are in the root
stand.check(stand.find_item(stand.root, "Self"), "the pack's Self list is in the menu")
stand.check(Atdar.features.has("self.godmode"), "its features are registered")
stand.equal(stand.find_log("not found"), nil, "no 'menu not found' notice")

-- ─── Found Commands: the menu's commands get custom names, kept in its commands folder ─────

local function found_commands() return stand.child(stand.find_item(stand.root, "Command Box"), "Found Commands") end
local function found_row(name)
    for _, child in found_commands().children do
        if stand.name_of(child) == name then
            return child
        end
    end
    return nil
end
local core_names = $"{lib}ui\\stand\\menu_from_store\\commands\\godmode.json"
local godmode = found_row("godmode")
stand.check(godmode and godmode.kind == "list", "the menu's command is a list, shown without the prefix")
stand.equal(stand.find_item(godmode, "Command").value, "atdargodmode", "inside: the full command")
menu.set_value(stand.find_item(godmode, "Custom Name"), "god")
stand.equal(stand.name_of(godmode), "god", "a custom name renames the row")
stand.equal(stand.find_item(godmode, "Command").value, "atdargod", "and the command: the prefix stays")
stand.check(stand.read_file(core_names) and stand.read_file(core_names):find('"name": "god"', 1, true),
    "the built-in menu's names are kept in core, next to its main.pluto")
-- Stand puts fields back to their default by itself (restoring its profile's state, click type 4):
-- that must not undo the name
local rename_field = stand.find_item(godmode, "Custom Name")
rename_field.on_change("", 4)
stand.equal(stand.name_of(godmode), "god", "Stand's own call with the empty default doesn't reset the name")
stand.check(io.exists(core_names), "and the file stays")
stand.clear_logs()
menu.set_value(stand.find_item(godmode, "Custom Name"), "halfgodmode")
stand.check(stand.find_log("already a command"), "another item's command can't be taken")
stand.equal(stand.name_of(godmode), "god", "and the name stays")
-- Found Commands' Open Commands Folder: the loaded menu's own commands folder, in core here
stand.toasts = {}
stand.click(stand.child(found_commands(), "Open Commands Folder"))
stand.check(stand.toasts[#stand.toasts]:find("ui\\stand\\menu_from_store\\commands\\", 1, true),
    $"Found Commands opens the built-in menu's commands folder ({stand.toasts[#stand.toasts]})")
stand.equal(found_row("debug"), nil, "the script's own commands aren't among the menu's")
local base_commands = stand.child(stand.find_item(stand.root, "Command Box"), "Base Commands")
stand.check(stand.find_item(base_commands, "debug"), "they're in Base Commands")
stand.equal(stand.find_item(base_commands, "godmode"), nil, "and the menu's aren't there")

stand.click(stand.find_item(godmode, "Reset Name"))
stand.equal(stand.name_of(found_row("godmode")), "godmode", "Reset Name gives the menu's name back")
stand.check(not io.exists(core_names), "with no custom names left the file goes")
menu.set_value(stand.find_item(found_row("godmode"), "Custom Name"), "god")

-- The pack's Settings: the divider above the script's section is the display name, not the file name
local pack_settings = nil
for _, child in stand.root.children do
    if child.kind == "list" and stand.name_of(child) == "Settings" then
        pack_settings = child
    end
end
local divider = pack_settings and pack_settings.children[1]
stand.check(divider and divider.kind == "divider", "the pack's Settings starts with a divider")
Atdar.profile.set("display_name", "StandPro")
stand.equal(stand.name_of(divider), "StandPro", "it shows the display name and follows it")
Atdar.profile.set("display_name", "AnitaDarin")

-- Disable Sprint: the native is called every frame, but the debug log only shows changes
local running = true
_G.PLAYER = { PLAYER_ID = || -> 0, PLAYER_PED_ID = || -> 1, SET_PLAYER_SPRINT = || -> nil }
_G.TASK = { IS_PED_RUNNING = || -> running, IS_PED_SPRINTING = || -> false }
Atdar.debug = true
stand.clear_logs()
stand.click(stand.find_item(stand.root, "Disable Sprint"))
stand.frame(5)
running = false
stand.frame(5)
local sprint_lines = 0
for _, line in stand.logs do
    if line:find("sprint is", 1, true) then
        sprint_lines += 1
    end
end
stand.equal(sprint_lines, 2, "Disable Sprint logs only its two changes in 10 frames")
Atdar.debug = false

-- The setting itself, in Settings
local item = stand.find_item(stand.root, "Copy Menu To Core")
stand.equal(item and stand.name_of(item), "Copy Menu To Core: AnitaDarin", "Settings show the copied pack")
stand.click(item, 1)
stand.equal(Atdar.profile.get("auto_copy_menu"), "", "picking Off clears it")
stand.equal(stand.name_of(item), "Copy Menu To Core: Off", "and the caption follows")

-- The user's steps: the copied built-in menu is loaded, then removed from core.
-- No menu is left, so the root shows the same notice as a start without a built-in menu
Atdar.profile.set("auto_copy_menu", "AnitaDarin")
local load_menu = stand.find_item(stand.root, "Load Menu")
local builtin = stand.find_item(load_menu, "(built-in)")
stand.check(builtin, "Load Menu lists the copied built-in menu")
stand.click(builtin, 1)
stand.clear_logs()
stand.click(stand.find_item(stand.find_item(stand.root, "Load Menu"), "(built-in)"), 2)
stand.check(not io.exists($"{lib}ui\\stand\\menu_from_store\\main.pluto"), "Remove from core deletes the copy")
stand.check(not io.exists($"{core_languages}en-us.json"), "and its translations in store")
stand.equal(stand.name_of(stand.root.children[1]), "Built-in menu not found", "the notice is back at the top")
stand.equal(stand.root.children[1].kind, "divider", "as a divider")
stand.check(not stand.find_item(stand.root, "Self"), "the menu's items are gone")
stand.check(stand.find_log("the menu comes back at the next start"), "it says auto-copy will bring the copy back")

-- ─── Load Menu: a pack's state, Unload ───────────────────────────────────────

local function load_menu() return stand.find_item(stand.root, "Load Menu") end
local function entry(name)
    for _, child in load_menu().children do
        if stand.name_of(child) == name then
            return child
        end
    end
    return nil
end
stand.click(entry("AnitaDarin"), 1)
stand.check(stand.find_item(stand.root, "Self"), "Load on the pack loads it")
stand.check(entry("AnitaDarin: loaded"), "Load Menu shows the pack as loaded")
-- The pack from store has its own commands folder: core's names stay with the built-in menu
stand.equal(stand.name_of(found_row("godmode")), "godmode", "the store pack doesn't get core's names")
menu.set_value(stand.find_item(found_row("godmode"), "Custom Name"), "gm")
stand.check(stand.read_file($"{stand.store}AnitaDarin/menu/AnitaDarin/commands/godmode.json"):find('"gm"', 1, true),
    "a store pack's names go to its folder in store")
stand.click(entry("AnitaDarin: loaded"), 1)
stand.check(found_row("gm") and found_row("gm").kind == "list", "loading it again gives its items the saved names")
stand.equal(stand.find_item(found_row("gm"), "Custom Name").value, "gm", "the field starts with the custom name")
stand.check(stand.read_file(core_names):find('"god"', 1, true), "and core's file is untouched")

stand.clear_logs()
local thefeed = Atdar.natives.visual.hud.thefeed
local real_remove_all = thefeed.remove_all
local feed_cleared = false
thefeed.remove_all = function() feed_cleared = true return 0 end
stand.click(stand.find_item(load_menu(), "Unload"))
thefeed.remove_all = real_remove_all
stand.check(feed_cleared, "Unload takes the script's notifications out of the game's feed")
stand.check(not stand.find_item(stand.root, "Self"), "Unload takes the menu's items out")
stand.equal(stand.name_of(stand.root.children[1]), "Built-in menu not found", "the notice is at the top again")
stand.check(entry("AnitaDarin"), "the pack is no longer shown as loaded")
stand.check(stand.find_log("Menu unloaded"), "Unload says so")
stand.clear_logs()
stand.click(stand.find_item(load_menu(), "Unload"))
stand.check(stand.find_log("No menu is loaded"), "a second Unload says there's nothing to unload")

-- ─── Delete Script: a second click within 5 seconds deletes the whole install, stops ─

-- The name is part of every path it deletes: an empty or odd name is refused
local installer = Atdar.loader.load("core/installer")
local real_name = Atdar.name
for _, bad in { "", "..", "a\b" } do
    Atdar.name = bad
    stand.check(not installer.delete(), $"delete refuses the name '{bad}'")
end
Atdar.name = real_name

stand.write_file(scripts .. "AnitaDarin.pluto", "-- launcher")
io.makedirs(resources .. "AnitaDarin/sub")
stand.write_file(resources .. "AnitaDarin/sub/image.png", "x")
local profiles = stand.store .. "AnitaDarin/profiles/"
local delete_list = stand.find_item(stand.find_item(stand.root, "Debug"), "Delete Script")
local confirm = stand.find_item(delete_list, "Delete Script For Good")

-- One click and a second one too late: nothing is deleted
stand.click(confirm)
stand.clock += 6000
stand.frame()
stand.click(confirm)
stand.check(io.exists(scripts .. "AnitaDarin.pluto") and io.exists(lib), "a second click after 5 seconds only asks again")
stand.clock += 6000
stand.frame()

-- A first click, then back out of the list: the next click only asks again
stand.click(confirm)
delete_list.on_back()
stand.frame()
stand.click(confirm)
stand.check(io.exists(scripts .. "AnitaDarin.pluto") and io.exists(lib), "after going back a click only asks again")
delete_list.on_back()
stand.frame()

-- By default profiles and settings stay: what build.py never touches either
stand.click(confirm)
stand.clock += 1000
stand.click(confirm)
stand.check(not io.exists(scripts .. "AnitaDarin.pluto"), "the launcher is deleted")
stand.check(not io.exists(lib), "lib/AnitaDarin is deleted")
stand.check(not io.exists(resources .. "AnitaDarin"), "resources/AnitaDarin is deleted, with its subfolders")
stand.check(not io.exists(stand.store .. "AnitaDarin/menu"), "store files from the project are deleted")
stand.check(io.exists(profiles .. "main.json") and io.exists(stand.store .. "AnitaDarin/config.json"),
    "profiles and config.json are kept by default")
stand.check(stand.stopped, "the script stops after deleting itself")

stand.check(Atdar.leaving, "and it's leaving: notifications go to Stand only now")

-- Clicks after the delete (the script is stopping) do nothing: no new warning, nothing posted
stand.clear_logs()
stand.click(confirm)
stand.click(confirm)
stand.equal(stand.find_log("Click it again"), nil, "a click after the delete asks nothing")

-- With Keep Profiles And Settings off, store goes too
installer.delete(false)
stand.check(not io.exists(stand.store .. "AnitaDarin"), "without keeping, store/AnitaDarin is deleted with the profiles")
stand.check(io.exists(stand.SRC .. "lib/AnitaDarin/bootstrap.pluto"), "src is untouched")

stand.finish()
