-- examples/modules: the examples run as written, so they stay correct when the code changes
local stand = require("stand")
stand.boot()
Atdar.modules = Atdar.loader.load("core/module_manager")
local modules = Atdar.modules
Atdar.debug = true

stand.equal(modules.load_dir($"{stand.ROOT}/examples/modules/"), 4, "all four examples load")
modules.start()
for _, name in { "example.basic", "example.clock", "example.session_watch", "example.reporter" } do
    stand.equal(modules.has(name) and modules.get(name).status, "running", $"{name} runs")
end

-- 03_tick: one notification when going online, none while nothing changes
stand.clear_logs()
stand.frame()
stand.online = true
stand.frame(3)
local joined = 0
for _, line in stand.logs do
    if line:find("joined an online session", 1, true) then
        joined += 1
    end
end
stand.equal(joined, 1, "session_watch notifies once per change")

-- 04_deps: reports the clock's uptime every 5 s, in debug mode
stand.clear_logs()
stand.clock += 6000
stand.frame()
stand.check(stand.find_log("clock has been running for"), "reporter uses the clock module")

stand.finish()
