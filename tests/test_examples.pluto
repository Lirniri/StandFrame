-- examples/: the examples run as written, so they stay correct when the code changes
local stand = require("stand")
stand.boot()
_G.PLAYER = { PLAYER_ID = || -> 0 }
for _, name in { "util", "filesystem", "lang", "color", "menu", "memory" } do
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end
-- A stand-in profile: the real one would save a profile file into src/store
Atdar.profile = { get = || -> nil, on_change = || -> nil, log_name = || -> "AnitaDarin" }
Atdar.natives = Atdar.loader.auto({}, "natives")
Atdar.parsers = Atdar.loader.auto({}, "parsers")
Atdar.modules = Atdar.loader.load("core/module_manager")
Atdar.features = Atdar.loader.load("features/registry")
local modules = Atdar.modules
Atdar.debug = true

-- ─── modules/ ────────────────────────────────────────────────────────────────

stand.equal(modules.load_dir($"{stand.ROOT}/examples/modules/"), 7, "all seven module examples load")
modules.start()
for _, name in { "example.basic", "example.clock", "example.session_watch", "example.reporter", "example.counter",
        "example.garage", "example.greeter" } do
    stand.equal(modules.has(name) and modules.get(name).status, "running", $"{name} runs")
end

-- 03_tick: one notification when going online, none while nothing changes
stand.clear_logs()
stand.frame()
stand.online = true
stand.frame(3)
local joined = 0
for _, line in stand.logs do
    if line:find("joined an online session", 1, true) then
        joined += 1
    end
end
stand.equal(joined, 1, "session_watch notifies once per change")

-- 04_deps: reports the clock's uptime every 5 s, in debug mode
stand.clear_logs()
stand.clock += 6000
stand.frame()
stand.check(stand.find_log("clock has been running for"), "reporter uses the clock module")

-- 05_menu_functions: its functions for the menu, the _helper left out
local Module = Atdar.loader.load("core/module")
local counter = modules.get("example.counter")
local names = {}
for _, fn in ipairs(Module.functions_of(counter)) do
    table.insert(names, fn.name)
end
stand.equal(table.concat(names, ", "), "add, save, value", "counter's functions for the menu, _reset_quietly apart")
-- 06_debug_display: its debug option is accepted, its functions work
local garage = modules.get("example.garage")
stand.equal(garage.debug.groups[1].name, "Getting", "the debug option is kept")
garage:park_many({ 5, 6, 5 })
stand.equal(garage:count(), 2, "park_many parks each vehicle once")
-- 07_translations: the module's own strings, in the script's language
local greeter = modules.get("example.greeter")
stand.equal(greeter:greet("Ann"), "Hello, Ann!", "its own English string")
stand.language = "ru"
stand.equal(greeter:greet("Ann"), "Привет, Ann!", "and its Russian one")
stand.language = "en"
local internal = Module.functions_of(counter, "internal")
stand.check(#internal == 1 and internal[1].name == "_reset_quietly", 'functions_of(mod, "internal"): the _ ones')
stand.equal(counter:add(3), 3, "add(amount) works")

-- ─── features/ ───────────────────────────────────────────────────────────────

local function run_files(dir: string): int
    local ran = 0
    for _, path in io.listdir(dir, true) do
        if path:sub(-6) == ".pluto" then
            local chunk = assert(loadfile(path))
            chunk()
            ran += 1
        end
    end
    return ran
end

local wanted_max = 5
_G.PLAYER = {
    GET_MAX_WANTED_LEVEL = || -> wanted_max,
    SET_MAX_WANTED_LEVEL = function(level) wanted_max = level end,
    RESET_PLAYER_STAMINA = || -> nil,
    PLAYER_ID = || -> 0,
    PLAYER_PED_ID = || -> 1,
}
stand.equal(run_files($"{stand.ROOT}/examples/features/"), 4, "all four feature examples load")
local features = Atdar.features
local kinds = {}
for _, id in { "example.heal", "example.no_wanted", "example.infinite_stamina", "example.regeneration" } do
    table.insert(kinds, features.has(id) and features.get(id).kind or "missing")
end
stand.equal(table.concat(kinds, ", "), "action, toggle, loop, action", "registered with their kinds")
local no_wanted = features.get("example.no_wanted")
no_wanted:enable()
stand.equal(wanted_max, 0, "02_toggle: on, no wanted level")
no_wanted:disable()
stand.equal(wanted_max, 5, "off, the old maximum is back")

-- ─── pack/ExamplePack ────────────────────────────────────────────────────────

local pack_dir = $"{stand.ROOT}/examples/pack/ExamplePack/"
stand.equal(run_files($"{pack_dir}features/"), 2, "the pack's features load")
Atdar.loader.load("core/i18n").add_source($"{pack_dir}language/")
local MenuNode = Atdar.loader.load("ui/stand/core/menu_node")
local builder = Atdar.loader.load("ui/stand/core/menu_builder")
local pack_root = new MenuNode(stand.root):list("Pack")
stand.check(builder.build_menu(pack_root, $"{pack_dir}menu/stand/"), "the pack's menu builds")
local self_list = stand.find_item(pack_root.handle, "Self")
stand.check(self_list ~= nil, "its Self list, named from the pack's language file")
stand.check(stand.find_item(self_list, "Heal") and stand.find_item(self_list, "No Wanted Level"),
    "with the pack's features")
stand.check(stand.find_item(pack_root.handle, "Settings") ~= nil, "and its Settings list")

-- ─── basics/ ─────────────────────────────────────────────────────────────────

local function run_example(name: string)
    return assert(loadfile($"{stand.ROOT}/examples/{name}.pluto"))()
end

stand.clear_logs()
run_example("basics/06_check")
stand.check(stand.find_log("adder is in slot 1"), "06_check: right arguments pass")
stand.check(stand.find_log("park: name must be a string, got nil"), "expecter: the wrong one is named")
stand.check(stand.find_log("style: unknown 'tall', expected open or closed"), "validator: a value not allowed")
stand.check(stand.find_log("option: unknown 'slotz', expected name, slots or style"), "validator: a mistyped option")
stand.check(stand.find_log("slots must be at least 1"), "validator: fail()")

stand.clear_logs()
run_example("basics/07_parsers_and_colors")
stand.check(stand.find_log("4 arguments: adder, 5, true, two words"), "07: args.parse")
stand.check(not stand.find_log("parse error: nil"), "args.parse says why it failed")
stand.check(stand.find_log('split: f(1, 2) | "a, b"'), "args.split")
stand.check(stand.find_log("has the word get: true"), "name.words")
stand.check(stand.find_log("is_parked returns bool"), "source.return_type")
stand.check(stand.find_log("command name: godmode"), "command_box.sanitize")
stand.check(stand.find_log("bases: heal; skipped: !!!"), "command_box.bases")
stand.check(stand.find_log("json: 2 slots, cut off: nil"), "json.decode")
stand.check(stand.find_log("game colour: 255, 128, 0, 255"), "color.to_game")
stand.check(stand.find_log("hex: FF8000"), "color.from_game and to_hex")
stand.check(stand.find_log("with alpha: 00000080"), "to_hex with alpha")
stand.check(stand.find_log("not a colour: nil"), "from_hex of something else")

-- The natives examples need the game; every function they call has to exist
for _, name in { "05_natives", "08_natives_more" } do
    local text = stand.read_file($"{stand.ROOT}/examples/basics/{name}.pluto")
    local calls = 0
    for chain in text:gmatch("natives%.([%w_%.]+)%(") do
        local target = Atdar.natives
        for part in chain:gmatch("[^%.]+") do
            target = type(target) == "table" and target[part] or nil
        end
        stand.equal(type(target), "function", $"{name}: natives.{chain}")
        calls += 1
    end
    stand.check(calls > 0, $"{name}: calls found")
end

-- ─── menu/helpers ────────────────────────────────────────────────────────────

local helpers_root = new MenuNode(stand.root):list("Menu helpers")
run_example("menu/helpers").build(helpers_root, {})
local helpers = stand.find_item(helpers_root.handle, "Helpers")
local forget = stand.find_item(helpers, "Forget Vehicles")
stand.clear_logs()
stand.click(forget)
stand.equal(stand.name_of(forget), "Click Again To Forget", "helpers: the first click asks again")
stand.check(not stand.find_log("forgotten"), "and does nothing yet")
stand.click(forget)
stand.check(stand.find_log("forgotten"), "the second click acts")
stand.clock += 6000
stand.frame()
stand.equal(stand.name_of(forget), "Forget Vehicles", "the button gets its name back")
stand.click(forget)
stand.back(helpers)
stand.clear_logs()
stand.click(forget)
stand.check(not stand.find_log("forgotten"), "leaving the list forgets a first click")
local address = stand.find_item(helpers, "Address")
stand.equal(stand.name_of(address), "Address: Click To Show", "spoiler: hidden at first")
stand.click(address)
stand.equal(stand.name_of(address), "Address: Vinewood 12", "a click shows it")
stand.check(stand.find_item(helpers, "From a table") and stand.find_item(helpers, "Amount"), "build_items: its items")
stand.check(stand.find_item(helpers, "Inside More") ~= nil, "and a nested list")
stand.check(not stand.find_log("is not an item") and not stand.find_log("needs '"), "with no warnings")

stand.finish()
