-- examples/: the examples run as written, so they stay correct when the code changes
local stand = require("stand")
stand.boot()
_G.PLAYER = { PLAYER_ID = || -> 0 }
for _, name in { "util", "filesystem", "lang", "color", "menu", "memory" } do
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end
-- A stand-in profile: the real one would save a profile file into src/store
Atdar.profile = { get = || -> nil, on_change = || -> nil, log_name = || -> "AnitaDarin" }
Atdar.natives = Atdar.loader.auto({}, "natives")
Atdar.parsers = Atdar.loader.auto({}, "parsers")
Atdar.modules = Atdar.loader.load("core/module_manager")
Atdar.features = Atdar.loader.load("features/registry")
local modules = Atdar.modules
Atdar.debug = true

-- ─── modules/ ────────────────────────────────────────────────────────────────

stand.equal(modules.load_dir($"{stand.ROOT}/examples/script/modules/"), 7, "all seven module examples load")
modules.start()
for _, name in { "example.basic", "example.clock", "example.session_watch", "example.reporter", "example.counter",
        "example.garage", "example.greeter" } do
    stand.equal(modules.has(name) and modules.get(name).status, "running", $"{name} runs")
end

-- 03_tick: one notification when going online, none while nothing changes
stand.clear_logs()
stand.frame()
stand.online = true
stand.frame(3)
local joined = 0
for _, line in stand.logs do
    if line:find("joined an online session", 1, true) then
        joined += 1
    end
end
stand.equal(joined, 1, "session_watch notifies once per change")

-- 04_deps: reports the clock's uptime every 5 s, in debug mode
stand.clear_logs()
stand.clock += 6000
stand.frame()
stand.check(stand.find_log("clock has been running for"), "reporter uses the clock module")

-- 05_menu_functions: its functions for the menu, the _helper left out
local Module = Atdar.loader.load("core/module")
local counter = modules.get("example.counter")
local names = {}
for _, fn in ipairs(Module.functions_of(counter)) do
    table.insert(names, fn.name)
end
stand.equal(table.concat(names, ", "), "add, save, value", "counter's functions for the menu, _reset_quietly apart")
-- 06_debug_display: its debug option is accepted, its functions work
local garage = modules.get("example.garage")
stand.equal(garage.debug.groups[1].name, "Getting", "the debug option is kept")
garage:park_many({ 5, 6, 5 })
stand.equal(garage:count(), 2, "park_many parks each vehicle once")
-- 07_translations: the module's own strings, in the script's language
local greeter = modules.get("example.greeter")
stand.equal(greeter:greet("Ann"), "Hello, Ann!", "its own English string")
stand.language = "ru"
stand.equal(greeter:greet("Ann"), "Привет, Ann!", "and its Russian one")
stand.language = "en"
local internal = Module.functions_of(counter, "internal")
stand.check(#internal == 1 and internal[1].name == "_reset_quietly", 'functions_of(mod, "internal"): the _ ones')
stand.equal(counter:add(3), 3, "add(amount) works")

-- ─── features/ ───────────────────────────────────────────────────────────────

local function run_files(dir: string): int
    local ran = 0
    for _, path in io.listdir(dir, true) do
        if path:sub(-6) == ".pluto" then
            local chunk = assert(loadfile(path))
            chunk()
            ran += 1
        end
    end
    return ran
end

local wanted_max = 5
_G.PLAYER = {
    GET_MAX_WANTED_LEVEL = || -> wanted_max,
    SET_MAX_WANTED_LEVEL = function(level) wanted_max = level end,
    RESET_PLAYER_STAMINA = || -> nil,
    PLAYER_ID = || -> 0,
    PLAYER_PED_ID = || -> 1,
}
stand.equal(run_files($"{stand.ROOT}/examples/script/features/"), 4, "all four feature examples load")
local features = Atdar.features
local kinds = {}
for _, id in { "example.heal", "example.no_wanted", "example.infinite_stamina", "example.regeneration" } do
    table.insert(kinds, features.has(id) and features.get(id).kind or "missing")
end
stand.equal(table.concat(kinds, ", "), "action, toggle, loop, action", "registered with their kinds")
local no_wanted = features.get("example.no_wanted")
no_wanted:enable()
stand.equal(wanted_max, 0, "02_toggle: on, no wanted level")
no_wanted:disable()
stand.equal(wanted_max, 5, "off, the old maximum is back")

-- ─── pack/ExamplePack ────────────────────────────────────────────────────────

local pack_dir = $"{stand.ROOT}/examples/script/pack/ExamplePack/"
stand.equal(run_files($"{pack_dir}features/"), 2, "the pack's features load")
Atdar.loader.load("core/i18n").add_source($"{pack_dir}language/")
local MenuNode = Atdar.loader.load("ui/stand/core/menu_node")
local builder = Atdar.loader.load("ui/stand/core/menu_builder")
local pack_root = new MenuNode(stand.root):list("Pack")
stand.check(builder.build_menu(pack_root, $"{pack_dir}menu/stand/"), "the pack's menu builds")
local self_list = stand.find_item(pack_root.handle, "Self")
stand.check(self_list ~= nil, "its Self list, named from the pack's language file")
stand.check(stand.find_item(self_list, "Heal") and stand.find_item(self_list, "No Wanted Level"),
    "with the pack's features")
stand.check(stand.find_item(pack_root.handle, "Settings") ~= nil, "and its Settings list")

-- ─── basics/ ─────────────────────────────────────────────────────────────────

local function run_example(name: string)
    return assert(loadfile($"{stand.ROOT}/examples/script/{name}.pluto"))()
end

stand.clear_logs()
run_example("basics/06_check")
stand.check(stand.find_log("adder is in slot 1"), "06_check: right arguments pass")
stand.check(stand.find_log("park: name must be a string, got nil"), "expecter: the wrong one is named")
stand.check(stand.find_log("style: unknown 'tall', expected open or closed"), "validator: a value not allowed")
stand.check(stand.find_log("option: unknown 'slotz', expected name, slots or style"), "validator: a mistyped option")
stand.check(stand.find_log("slots must be at least 1"), "validator: fail()")

stand.clear_logs()
run_example("basics/07_parsers_and_colors")
stand.check(stand.find_log("4 arguments: adder, 5, true, two words"), "07: args.parse")
stand.check(not stand.find_log("parse error: nil"), "args.parse says why it failed")
stand.check(stand.find_log('split: f(1, 2) | "a, b"'), "args.split")
stand.check(stand.find_log("has the word get: true"), "name.words")
stand.check(stand.find_log("is_parked returns bool"), "source.return_type")
stand.check(stand.find_log("command name: godmode"), "command_box.sanitize")
stand.check(stand.find_log("bases: heal; skipped: !!!"), "command_box.bases")
stand.check(stand.find_log("json: 2 slots, cut off: nil"), "json.decode")
stand.check(stand.find_log("game colour: 255, 128, 0, 255"), "color.to_game")
stand.check(stand.find_log("hex: FF8000"), "color.from_game and to_hex")
stand.check(stand.find_log("with alpha: 00000080"), "to_hex with alpha")
stand.check(stand.find_log("not a colour: nil"), "from_hex of something else")

-- The natives examples need the game; every function they call has to exist
for _, name in { "05_natives", "08_natives_more", "09_natives_all" } do
    local text = stand.read_file($"{stand.ROOT}/examples/script/basics/{name}.pluto")
    local calls = 0
    for chain in text:gmatch("natives%.([%w_%.]+)%(") do
        local target = Atdar.natives
        for part in chain:gmatch("[^%.]+") do
            target = type(target) == "table" and target[part] or nil
        end
        stand.equal(type(target), "function", $"{name}: natives.{chain}")
        calls += 1
    end
    stand.check(calls > 0, $"{name}: calls found")
end

-- ─── menu/helpers ────────────────────────────────────────────────────────────

local helpers_root = new MenuNode(stand.root):list("Menu helpers")
run_example("menu/helpers").build(helpers_root, {})
local helpers = stand.find_item(helpers_root.handle, "Helpers")
local forget = stand.find_item(helpers, "Forget Vehicles")
stand.clear_logs()
stand.click(forget)
stand.equal(stand.name_of(forget), "Click Again To Forget", "helpers: the first click asks again")
stand.check(not stand.find_log("forgotten"), "and does nothing yet")
stand.click(forget)
stand.check(stand.find_log("forgotten"), "the second click acts")
stand.clock += 6000
stand.frame()
stand.equal(stand.name_of(forget), "Forget Vehicles", "the button gets its name back")
stand.click(forget)
stand.back(helpers)
stand.clear_logs()
stand.click(forget)
stand.check(not stand.find_log("forgotten"), "leaving the list forgets a first click")
local address = stand.find_item(helpers, "Address")
stand.equal(stand.name_of(address), "Address: Click To Show", "spoiler: hidden at first")
stand.click(address)
stand.equal(stand.name_of(address), "Address: Vinewood 12", "a click shows it")
stand.check(stand.find_item(helpers, "From a table") and stand.find_item(helpers, "Amount"), "build_items: its items")
stand.check(stand.find_item(helpers, "Inside More") ~= nil, "and a nested list")
stand.check(not stand.find_log("is not an item") and not stand.find_log("needs '"), "with no warnings")

-- ─── menu/options ────────────────────────────────────────────────────────────

local options_root = new MenuNode(stand.root):list("Menu options")
run_example("menu/options").build(options_root, {})
local options = stand.find_item(options_root.handle, "Options")
stand.clear_logs()
stand.click(stand.find_item(options, "Say Hello"))
stand.check(stand.find_log("hello"), "options: a button from a table of options")
local nickname = stand.find_item(options, "Nickname")
nickname.on_change("restored", 4)
stand.check(not stand.find_log("nickname 'restored'"), "user_only: Stand restoring the field doesn't count")
nickname.on_change("Ann", 0)
stand.check(stand.find_log("nickname 'Ann'"), "the user's text does")
stand.click(stand.find_item(options, "Clear Saved"))
stand.check(stand.find_log("cleared"), "warning: asked first, then cleared")

-- ─── menu/changing ───────────────────────────────────────────────────────────

local changing_root = new MenuNode(stand.root):list("Menu changing")
run_example("menu/changing").build(changing_root, {})
local changing = stand.find_item(changing_root.handle, "Changing Items")
local stop = stand.child(changing, "Stop")
stand.equal(stop.visible, false, "changing: Stop is hidden while stopped")
stand.click(stand.child(changing, "Running"))
stand.equal(stand.child(changing, "Status").value, "Running", "set_value: the status follows")
stand.equal(stop.visible, true, "shown_when: Stop shows while running")
stand.click(stop)
stand.equal(stand.child(changing, "Status").value, "Stopped", "set_value(false, true) runs the toggle's handler")
stand.click(stand.child(changing, "Click Me"))
stand.click(stand.child(changing, "Click Me"))
stand.check(stand.child(changing, "Clicks: 2") ~= nil, "caption: the counter follows")

-- ─── menu/dynamic ────────────────────────────────────────────────────────────

local dynamic_root = new MenuNode(stand.root):list("Menu dynamic")
run_example("menu/dynamic").build(dynamic_root, {})
local dynamic = stand.find_item(dynamic_root.handle, "Dynamic")
local file_list = stand.child(dynamic, "Files")
stand.equal(#file_list.children, 0, "dynamic: Files is empty until opened")
stand.click(file_list)
stand.check(stand.child(file_list, "garage.json") ~= nil, "fill: opened, the files are there")
stand.back(file_list)
stand.equal(#file_list.children, 0, "and gone on back")
local tags = stand.child(dynamic, "Tags")
stand.click(stand.child(tags, "fast"))
stand.check(stand.child(tags, "fast") == nil and stand.child(tags, "red") ~= nil, "section: a tag taken off")
stand.child(tags, "Add Tag").on_change("blue", 0)
stand.equal(stand.name_of(tags.children[#tags.children - 1]), "blue", "a tag added before the field")
stand.click(stand.child(dynamic, "Take The Line Out"))
stand.check(stand.child(dynamic, "A line to take out") == nil, "remove(): the line is out")

-- ─── menu/refs ───────────────────────────────────────────────────────────────

local refs_root = new MenuNode(stand.root):list("Menu refs")
run_example("menu/refs").build(refs_root, {})
local ref_tools = stand.find_item(refs_root.handle, "Ref Tools")
stand.check(ref_tools ~= nil, "refs: a list made in a Stand ref")
stand.click(stand.child(ref_tools, "Rename Ping"))
stand.check(stand.child(ref_tools, "Ping (renamed)") ~= nil, "found by its command and renamed")
stand.triggered = {}
stand.click(stand.child(ref_tools, "Run Ping"))
stand.check(#stand.triggered == 1 and stand.triggered[1]:find("refsping", 1, true) ~= nil, "a command run as typed")
stand.check(stand.child(ref_tools, "Code: ****") ~= nil, "a spoiler in options form")

-- ─── call_function/ ──────────────────────────────────────────────────────────

if _G.v3 == nil then
    _G.v3 = { new = |x, y, z| -> { x = x, y = y, z = z } }
end

local call_dir = $"{stand.ROOT}/examples/script/call_function/"
local arguments = Atdar.loader.load("ui/logic/stand/arguments")

-- 01_by_hand: a code file for Atdar.user_script; its parameters give the fields
local demo = assert(loadfile($"{call_dir}01_by_hand.pluto"))()
stand.equal(demo.add(5), 5, "01: add(5)")
stand.equal(demo.add(5, "again"), 10, "and the total goes on")
stand.equal(demo.total, 10, "a variable of the table")
stand.equal(demo.limits.high, 10, "a table in the table, opened with {}")
stand.equal(demo.shout("hi", true), "HI!", "shout")
stand.equal(demo.is_between(5), true, "is_between")
local add_sig = arguments.signature_of(demo.add)
stand.equal(arguments.params_text(add_sig), "amount, note", "add's parameters")
stand.equal(add_sig.params[1].type .. " " .. add_sig.params[2].type, "int ?string", "with the types written in the code")
stand.equal(add_sig.params[2].default, "\"x\"", "and the default as written")
local shout_sig = arguments.signature_of(demo.shout)
local _, _, no_text = arguments.read(shout_sig, {})
stand.check(no_text ~= nil and no_text:find("text", 1, true) ~= nil, "a Text field without a default is required")
local _, _, not_boolean = arguments.read(shout_sig, { "hi", "yes" })
stand.check(not_boolean ~= nil and not_boolean:find("loud", 1, true) ~= nil, "a Boolean takes true or false only")
local _, shout_count, shout_error = arguments.read(shout_sig, { "hi", "true" })
stand.check(shout_count == 2 and shout_error == nil, "and true is fine")

-- 02_arguments: what the fields give for what is typed in them
stand.clear_logs()
run_example("call_function/02_arguments")
stand.check(stand.find_log("util.toast is only read, brackets: nil"), "02: no brackets, only read")
stand.check(stand.find_log("util.toast is called with (hi, 5)"), "brackets: called, with these arguments")
stand.check(stand.find_log("Atdar.util is opened: true"), "braces: a table to open")
stand.check(stand.find_log("set_speed(speed, boost), move(position, steps)"), "the parameters of a function")
stand.check(stand.find_log("set_speed reads 2.5, false (2 given)"), "a field never typed starts with its default")
stand.check(stand.find_log("boost: true or false is needed"), "strict: a word is no boolean")
stand.check(stand.find_log("speed: a number is needed"), "strict: a word is no number")
stand.check(stand.find_log("second: the argument is required"), "strict: a required argument")
stand.check(stand.find_log("(speed, boost) takes 2 argument(s), got 3"), "strict: too many arguments")
stand.check(stand.find_log("there is no such argument (the function has 2)"), "#3 with two fields")
stand.check(stand.find_log("move reads the vector 1, 2, 3 and 2 steps (2 given)"), "a vector, and a call as an argument")
stand.check(stand.find_log("z = math.floor(3.7)"), "an axis that is a call stays as written")
stand.check(stand.find_log("brackets made from the fields: #1, #2"), "the brackets follow the fields")
stand.check(stand.find_log("join(#2, #1) gets right, left"), "#2, #1: the order of the brackets")

-- 03_module_functions: a module of every kind of parameter, in the Modules list and Call Function
stand.equal(modules.load_dir(call_dir), 1, "03: its manifest registers the module")
modules.start()
local shop = modules.get("ExampleShop")
stand.equal(shop.status, "running", "ExampleShop runs")
local shop_names = {}
for _, fn in ipairs(Module.functions_of(shop)) do
    table.insert(shop_names, fn.name)
end
table.sort(shop_names)
stand.equal(table.concat(shop_names, ", "), "count, move_to, set_caption, set_open, set_speed, sum, tag",
    "its functions for the Modules list")
local shop_kinds = {}
for _, name in { "set_speed", "set_open", "set_caption", "move_to", "sum", "tag" } do
    table.insert(shop_kinds, arguments.kind_of(arguments.signature_of(shop[name], true).params[1].type))
end
stand.equal(table.concat(shop_kinds, ", "), "float, boolean, string, vector3, table, string", "a field kind per parameter")
local tag_sig = arguments.signature_of(shop.tag, true)
stand.equal(arguments.params_text(tag_sig), "name, note", "the owner's self isn't a field")
stand.equal(shop:sum({ 1, 2, 3 }), 6, "sum")
stand.equal(shop:tag("a"), "a", "tag without a note")
stand.equal(shop:tag("b", "new"), "b (new)", "tag with one")
stand.equal(shop:count(), 2, "count")
local found, method, owner = Atdar.parsers.proglang.pluto.path.resolve("ExampleShop:sum")
stand.check(found and type(method) == "function" and owner == shop, "ExampleShop:sum names the method, its owner is the module")

stand.finish()
