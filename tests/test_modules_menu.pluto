-- ─── debug = { ... }: how a module shows here ────────────────────────────────

local class Garage extends Module
    function __construct()
        parent:__construct({
            name = "garage",
            debug = {
                functions = {
                    park = {
                        help = "Parks a vehicle",
                        params = { handle = "the vehicle's handle" },
                        args = "42",
                    },
                },
                groups = {
                    { name = "Getting", functions = { "count", "_peek" } },
                },
                hide = { "secret", "wipe" },
                categories = {
                    { key = "getters", words = { "find" } },
                    { key = "shop", name = "Shop", words = { "buy" } },
                },
            },
        })
        self.cars = 0
        self.secret = "hidden"
    end
    function count(): int return self.cars end
    function park(handle: int): int
        self.cars += 1
        return handle
    end
    function sell(): void end
    function wipe(): void end
    function _peek(): int return self.cars end
    function _tidy(): void end
    function __audit(): int return self.cars end
    function get_cars(): int return self.cars end
    function find_car(): int return 1 end
    function set_cars(n: int): void self.cars = n end
    function is_full(): bool return false end
    function has_room(): bool return true end
    function save_all(): void end
    function load_all(): void end
    function remove_car(): void end
    function delete_car(): void end
    function buy_car(): void end
    function budget(): int return 0 end
    function getTotal(): int return 0 end
end
local garage = Atdar.modules.add(new Garage())
Atdar.modules.start_module("garage")
-- A word for every module: "has" makes a check too
modules_menu.add_category("checks", { "has" })
stand.back(list)
stand.click(list)
local garage_entry = stand.find_item(list, "garage: ")
local garage_fns = stand.child(stand.child(garage_entry, "Function Call"), "Module Functions")
stand.equal(names_in(garage_fns), "Variables | Getting | count(): int | _peek(): int | Functions"
    .. " | Getters | Setters | Checks | Loading | Saving | Remove | Delete | Shop | budget(): int | park(handle): int | sell(): void"
    .. " | Internal Functions | _tidy(): void | Private Functions | __audit(): int",
    "groups first (a _ function too), the rest under Functions, Internal Functions (_), Private Functions (__);"
    .. " hide, the constructor and metamethods left out")
-- Categories: a list per word in the names; "budget" has no word "get"
stand.equal(names_in(stand.child(garage_fns, "Getters")), "find_car(): int | getTotal(): int | get_cars(): int",
    "Getters: get (getTotal too), and find from the module's debug.categories")
stand.equal(names_in(stand.child(garage_fns, "Setters")), "set_cars(n): void", "Setters: set")
stand.equal(names_in(stand.child(garage_fns, "Checks")), "has_room(): bool | is_full(): bool",
    "Checks: is, and has from add_category for every module")
stand.equal(names_in(stand.child(garage_fns, "Loading")), "load_all(): void", "Loading: load")
stand.equal(names_in(stand.child(garage_fns, "Saving")), "save_all(): void", "Saving: save")
stand.equal(names_in(stand.child(garage_fns, "Remove")), "remove_car(): void", "Remove: remove")
stand.equal(names_in(stand.child(garage_fns, "Delete")), "delete_car(): void", "Delete: delete")
stand.equal(names_in(stand.child(garage_fns, "Shop")), "buy_car(): void", "a category of the module's own, with its name")
local park_node = stand.child(garage_fns, "park(handle): int")
stand.check(park_node.help:find("Parks a vehicle", 1, true) and park_node.help:find("handle - the vehicle's handle", 1, true),
    "the function's help and its parameters' from the module")
local park_args = field_under(park_node, "handle")
stand.equal(stand.name_of(park_args), "Number", "handle: int is a Number field")
stand.equal(park_args.value, "42", "the module's default arguments are in the field")
stand.check(park_args.help:find("the vehicle's handle", 1, true) == 1, "its help starts with what the module says of the parameter")
-- Default arguments written for several parameters go to them in order, the rest to Arguments
local defaults = Atdar.loader.load("ui/stand/core/arguments").texts_from(
    { params = { { name = "a" }, { name = "b" } }, vararg = true }, 'f(1, 2), "x, y", 7, 8')
stand.check(defaults[1] == "f(1, 2)" and defaults[2] == '"x, y"' and defaults.rest == "7, 8",
    "default arguments: commas inside brackets and quotes don't split; more than its parameters: the rest")
-- A Number takes a whole number
menu.set_value(park_args, "2.5")
stand.clear_logs()
stand.click(stand.child(park_node, "Call"))
stand.check(stand.find_log("handle: a whole number is needed"), "a Number field refuses a fraction")
menu.set_value(park_args, "8")
stand.clear_logs()
stand.click(stand.child(park_node, "Call"))
stand.check(stand.find_log("park(handle) -> 8"), "and takes a whole one")
menu.set_value(park_args, "42")
stand.equal(stand.child(garage_entry, "Arguments Guide"), nil, "the Arguments Guide isn't in a module's list: it's in Call Function")
stand.clear_logs()
stand.click(stand.child(park_node, "Call"))
stand.check(stand.find_log("park(handle) -> 42"), "and Call uses them")
local garage_vars = stand.child(garage_fns, "Variables")
stand.click(garage_vars)
stand.equal(names_in(garage_vars), "cars", "a hidden variable isn't shown; debug itself isn't a variable")
stand.back(garage_vars)

-- Live: a getter's Variable is kept up to date while its list is open, other functions wait for a call
local getters = stand.child(garage_fns, "Getters")
local get_cars_node = stand.child(getters, "get_cars(): int")
stand.click(get_cars_node)
garage.cars = 3
stand.clock += 300
stand.frame()
stand.check(stand.find_item(get_cars_node, "Variable: 3") ~= nil, "a getter's Variable follows the value while open")
garage.cars = 4
stand.clock += 300
stand.frame()
stand.check(stand.find_item(get_cars_node, "Variable: 4") ~= nil, "and keeps following it")
stand.back(get_cars_node)
garage.cars = 5
stand.clock += 300
stand.frame()
stand.check(stand.find_item(get_cars_node, "Variable: 4") ~= nil, "gone back: not called any more")
local sell_node = stand.child(garage_fns, "sell(): void")
local sold = 0
garage.sell = function() sold += 1 end
stand.click(sell_node)
stand.clock += 300
stand.frame(2)
stand.equal(sold, 0, "a function that isn't a getter or a check isn't called by opening its list")
stand.back(sell_node)

-- Disable Function Categories: this module's functions in one list, its hooks as a section again
local no_categories_toggle = stand.child(stand.child(garage_entry, "Function Call"), "Disable Function Categories")
stand.equal(no_categories_toggle.kind, "toggle", "a toggle under Reload")
stand.click(no_categories_toggle)
garage_fns = stand.child(stand.child(garage_entry, "Function Call"), "Module Functions")
stand.check(stand.child(garage_fns, "Getters") == nil and stand.child(garage_fns, "get_cars(): int") ~= nil,
    "on: no category lists, the functions in the one list")
stand.check(stand.child(stand.child(garage_entry, "Function Call"), "on_start(): void") ~= nil and stand.child(stand.child(garage_entry, "Function Call"), "Base Functions").kind == "divider",
    "and the base functions as a section under their divider")
stand.check(stand.child(stand.child(stand.child(entry_counter, "Function Call"), "Module Functions"), "Add") ~= nil, "other modules keep their categories")
stand.click(stand.child(garage_entry, "Reload"))
stand.equal(stand.child(stand.child(garage_entry, "Function Call"), "Disable Function Categories").value, true, "kept through Reload")
stand.click(stand.child(stand.child(garage_entry, "Function Call"), "Disable Function Categories"))
stand.check(stand.child(stand.child(stand.child(garage_entry, "Function Call"), "Module Functions"), "Getters") ~= nil, "off again: the categories are back")

-- ─── A module's own translations: language/ in its folder, its keys its own ──────

local talker_dir = stand.tmpdir("modules_menu_talker")
stand.write_file($"{talker_dir}talker.pluto", "local Module = Atdar.loader.load('core/module')\n"
    .. "return Atdar.modules.add(new Module({ name = 'talker' }))\n")
io.makedirs($"{talker_dir}language")
stand.write_file($"{talker_dir}language/en-us.json", '{"hello": "Hello", "refresh": {"name": "Not the script\'s"}}')
stand.write_file($"{talker_dir}language/ru-ru.json", '{"hello": "Привет"}')
Atdar.modules.load_dir(talker_dir)
local talker = Atdar.modules.get("talker")
stand.equal(talker:text("hello", "Hi"), "Hello", "self:text: the module's own string")
stand.equal(talker:text("missing", "Fallback"), "Fallback", "a key it doesn't have: the English given")
stand.language = "ru"
stand.equal(talker:text("hello", "Hi"), "Привет", "in the script's language")
stand.language = "en"
local i18n = Atdar.loader.load("core/i18n")
stand.equal(i18n.text("modules.refresh.name"), "Refresh", "its keys don't reach the script's strings")
stand.equal(i18n.text("hello", "none"), "none", "nor are they there without its prefix")
stand.equal(new Module({ name = "talker_in_code" }):text("hello", "Hi"), "Hi", "a module made in code: the English given")

-- ─── Arguments by type: a field for each parameter, named by what it takes ───────

-- What the last call of mix got
local got = nil
local class Typed extends Module
    function __construct() parent:__construct({ name = "typed" }) end
    function mix(whole: int, ratio: ?float, label: string, flag: bool, pos: vector3, items: table, handler: function,
            thing: userdata, free, extra: int|string, ...)
        got = table.pack(whole, ratio, label, flag, pos, items, handler, thing, free, extra, ...)
        return true
    end
    -- Defaults written in the code are what the fields start with
    function pace(speed: float = 1.5, loud = false, name: ?string, count: int = 3)
        got = table.pack(speed, loud, name, count)
        return true
    end
end
Atdar.modules.add(new Typed())
-- Stand's v3 isn't in the test: a table does
_G.v3 = { new = |x, y, z| -> { x = x, y = y, z = z } }
stand.back(list)
stand.click(list)
local typed_entry = stand.find_item(list, "typed: ")
local mix_node = stand.find_item(stand.child(stand.child(typed_entry, "Function Call"), "Module Functions"), "mix(")
stand.equal(names_in(stand.child(mix_node, "Arguments")),
    "whole | Number | ratio | Float Number | label | Text | flag | Boolean | pos | 3D Vector | items | Table | handler | Function"
    .. " | thing | Userdata | free | Argument * | extra | Argument * | ... | Arguments",
    "each parameter: its name, then a field named by its type; int|string is no one type; ... is Arguments at the end")
local mix_fields = {}
for _, name in { "whole", "ratio", "label", "flag", "pos", "items", "handler", "thing", "free", "extra" } do
    mix_fields[name] = field_under(mix_node, name)
end
local mix_rest = field_under(mix_node, "...")
stand.check(mix_fields.whole.commands[1]:find("moduleargsfor%d+_%d+_1$") and mix_rest.commands[1]:find("_rest$"),
    "commands: a number for each parameter, rest for Arguments")
local function mix_call(): void
    got = nil
    stand.clear_logs()
    stand.click(stand.child(mix_node, "Call"))
end
-- Nothing typed: everything is nil
mix_call()
-- The fields start with a value: 0 for a Number, false for a Boolean, 0, 0, 0 for a 3D Vector; a ?type, Text,
-- Table, Function, Userdata and Argument * start empty
stand.equal(mix_fields.whole.value, "0", "a Number starts with 0")
stand.equal(mix_fields.flag.value, "false", "a Boolean starts with false")
stand.equal(mix_fields.pos.value, "0, 0, 0", "a 3D Vector starts with 0, 0, 0")
stand.check(mix_fields.ratio.value == "" and mix_fields.label.value == "" and mix_fields.items.value == ""
    and mix_fields.free.value == "", "?float, Text, Table and Argument * start empty")
stand.check(got ~= nil and got[1] == 0 and got[4] == false and got[5].x == 0 and got[5].z == 0,
    "nothing typed: the function gets those values")
stand.check(got[2] == nil and got[3] == nil and got[6] == nil and got[9] == nil, "and nothing for the empty ones")
-- A field cleared by the user is not given, whatever it started with
menu.set_value(mix_fields.whole, "")
mix_call()
stand.equal(got[1], nil, "a field cleared: not given")
menu.set_value(mix_fields.whole, "0")
-- Each kind read as what it takes
menu.set_value(mix_fields.whole, "7")
menu.set_value(mix_fields.ratio, "2.5")
menu.set_value(mix_fields.label, 'a "b", c')
menu.set_value(mix_fields.flag, "true")
menu.set_value(mix_fields.pos, "1, 2, 3")
menu.set_value(mix_fields.items, "4, 5, 6")
menu.set_value(mix_fields.handler, "math.floor")
menu.set_value(mix_fields.thing, "v3.new(7, 8, 9)")
menu.set_value(mix_fields.free, "nothing quoted")
menu.set_value(mix_fields.extra, "x")
menu.set_value(mix_rest, '"more", 10')
mix_call()
stand.check(got ~= nil and got[1] == 7 and got[2] == 2.5, "Number and Float Number: numbers")
stand.equal(got[3], 'a "b", c', "Text: as typed, quotes and commas included")
stand.equal(got[4], true, "Boolean: true")
stand.check(got[5].x == 1 and got[5].y == 2 and got[5].z == 3, "3D Vector: three numbers make a vector")
stand.check(got[6][1] == 4 and got[6][3] == 6 and #got[6] == 3, "Table: the values separated by commas")
stand.equal(got[7], math.floor, "Function: the function at the path")
stand.check(got[8].x == 7 and got[8].z == 9, "Userdata: an expression")
stand.equal(got[9], "nothing quoted", "Argument *: an expression, a word is text")
stand.check(got[10] == "x" and got[11] == "more" and got[12] == 10, "Arguments: more, after the parameters")
-- A 3D Vector can be an expression too
menu.set_value(mix_fields.pos, "v3.new(4, 5, 6)")
mix_call()
stand.equal(got[5].y, 5, "3D Vector: an expression that gives one")
-- Wrong values are told, nothing is called
for _, case in {
    { "whole", "x", "whole: a whole number is needed" },
    { "ratio", "x", "ratio: a number is needed" },
    { "flag", "5", "flag: true or false is needed" },
    { "pos", "1, 2", "pos: three numbers are needed" },
    { "handler", "no.such.thing", "handler: there's no function 'no.such.thing'" },
} do
    local name, value, message = case[1], case[2], case[3]
    local before = mix_fields[name].value
    menu.set_value(mix_fields[name], value)
    mix_call()
    stand.check(got == nil and stand.find_log(message), $"{name}: '{value}' is refused: {message}")
    menu.set_value(mix_fields[name], before)
end
-- A default written in the code is what the field starts with, whatever the type would give
local pace_node = stand.find_item(stand.child(stand.child(typed_entry, "Function Call"), "Module Functions"), "pace(")
local speed_field = field_under(pace_node, "speed")
local loud_field = field_under(pace_node, "loud")
local name_field = field_under(pace_node, "name")
local count_field = field_under(pace_node, "count")
stand.check(speed_field.value == "1.5" and loud_field.value == "false" and name_field.value == "" and count_field.value == "3",
    "fields start with the code's defaults: 1.5, false, none for a ?type, 3")
got = nil
stand.click(stand.child(pace_node, "Call"))
stand.check(got ~= nil and got[1] == 1.5 and got[2] == false and got[3] == nil and got[4] == 3, "and the function gets them")
-- Call After Typing: a field typed by the user calls the function; Stand putting it back doesn't
stand.click(stand.child(mix_node, "Call After Typing"))
got = nil
mix_fields.whole.on_change("3", 4)
stand.equal(got, nil, "Stand's own change of a field calls nothing")
mix_fields.whole.on_change("3", 0)
stand.check(got ~= nil and got[1] == 3, "typing in a field calls the function")

-- ─── System modules: listed only while Show System Modules is on ─────────────

local systems_dir = stand.tmpdir("modules_menu_systems")
io.makedirs($"{systems_dir}systems/Helper")
stand.write_file($"{systems_dir}systems/Helper/Helper.pluto",
    "local Module = Atdar.loader.load('core/module')\nreturn Atdar.modules.add(new Module({ name = 'sys_helper' }))\n")
Atdar.modules.load_dir(systems_dir)
Atdar.modules.start()
stand.check(Atdar.modules.is_system("sys_helper"), "a module from systems\\ is a system one")
stand.back(list)
stand.click(list)
local show_system = stand.child(list, "Show System Modules")
stand.check(show_system ~= nil and show_system.kind == "toggle" and show_system.value == false,
    "Show System Modules: a toggle, off at first")
stand.check(names_in(list):find("Reload All | Show System Modules | Modules | 1: a: ", 1, true),
    "right under Reload All, above the Modules divider")
stand.equal(stand.find_item(list, "sys_helper"), nil, "off: the system module isn't listed")
stand.check(stand.find_item(list, "2: b: ") ~= nil, "the others are")
stand.equal(stand.child(list, "System Modules"), nil, "off: no System Modules list")
local count_off = #list.children
stand.click(show_system)
local system_list = stand.child(list, "System Modules")
stand.check(system_list ~= nil and system_list.kind == "list", "on: the System Modules list")
stand.check(stand.find_item(system_list, "sys_helper") ~= nil, "the system module is in it at once")
stand.check(stand.find_item(system_list, "CallFunction") ~= nil and stand.find_item(system_list, "FileEditor") ~= nil,
    "with the script's own system modules (loaded above)")
stand.equal(#list.children, count_off + 1, "the other entries are made once, not twice: one list more")
stand.click(show_system)
stand.equal(stand.find_item(list, "sys_helper"), nil, "off again: gone")
stand.equal(stand.child(list, "System Modules"), nil, "the System Modules list too")
stand.equal(#list.children, count_off, "and only it")
stand.click(stand.child(list, "Refresh"))
stand.equal(stand.find_item(list, "sys_helper"), nil, "Refresh doesn't bring it back while off")
stand.click(show_system)
stand.back(list)
stand.click(list)
stand.check(stand.child(list, "Show System Modules").value == true and stand.find_item(list, "sys_helper") ~= nil,
    "the choice stays when the list is opened again")
local helper_entry = stand.find_item(list, "sys_helper")
stand.click(stand.child(helper_entry, "Stop"))
stand.check(stand.name_of(helper_entry):find("stopped", 1, true), "a system module's entry works like the others")
Atdar.modules.start_module("sys_helper")

-- Stop All / Reload All reach the system modules only while they're shown
local helper = Atdar.modules.get("sys_helper")
stand.click(stand.child(list, "Stop All"))
stand.equal(helper.status, "stopped", "on: Stop All stops a system module too")
Atdar.modules.start_module("sys_helper")
Atdar.modules.start_module("a")
stand.click(stand.child(list, "Show System Modules"))
stand.click(stand.child(list, "Stop All"))
stand.equal(Atdar.modules.get("sys_helper").status, "running", "off: Stop All leaves a system module running")
stand.equal(Atdar.modules.get("a").status, "stopped", "and stops the others")
stand.click(stand.child(list, "Reload All"))
stand.equal(Atdar.modules.get("sys_helper"), helper, "off: Reload All doesn't reload a system module")
stand.click(stand.child(list, "Show System Modules"))
stand.click(stand.child(list, "Reload All"))
stand.check(Atdar.modules.get("sys_helper") ~= helper, "on: Reload All reloads it too")
stand.click(stand.child(list, "Show System Modules"))

stand.finish()
