-- ui/stand/modules/list: shown only in debug mode, statuses, actions, a module's functions, translations
local stand = require("stand")
stand.boot()
Atdar.filesystem = Atdar.loader.load("utils/filesystem")
local listeners = {}
Atdar.profile = { get = || -> nil, on_change = |fn| -> table.insert(listeners, fn) }
Atdar.modules = Atdar.loader.load("core/module_manager")
local Module = Atdar.loader.load("core/module")
local MenuNode = Atdar.loader.load("ui/stand/core/menu_node")

local stops = 0
Atdar.modules.add(new Module({ name = "a" }))
Atdar.modules.add(new Module({ name = "b", deps = { "a" }, on_stop = function() stops += 1 end }))

-- A module as a class, with functions of its own to call from the menu
local class Counter extends Module
    function __construct()
        parent:__construct({ name = "counter" })
        self.count = 0
    end
    function add(amount, note)
        self.count += amount
        return self.count, note
    end
    function reset()
        self.count = 0
    end
    function broken()
        error("it broke", 0)
    end
    function _hidden() end
end
local counter = Atdar.modules.add(new Counter())
local ticks = 0
Atdar.modules.add(new Module({ name = "ticker", on_tick = function() ticks += 1 end }))
-- A module from a file, so Reload can read it again
local reload_dir = stand.tmpdir("modules_menu_reload")
local function reloader_file(functions: string): string
    return "local Module = Atdar.loader.load('core/module')\n"
        .. "local class Reloader extends Module\n"
        .. "    function __construct() parent:__construct({ name = 'reloader' }) end\n"
        .. functions .. "\nend\nreturn Atdar.modules.add(new Reloader())\n"
end
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function one() return 1 end\n    function old_field(x) return x end"))
Atdar.modules.load_dir(reload_dir)
Atdar.modules.start()

local modules_menu = Atdar.loader.load("ui/stand/modules/list")
Atdar.loader.load("ui/stand/modules/place").build(new MenuNode(stand.root))

local divider = stand.find_item(stand.root, "Debug")
local list = stand.find_item(stand.root, "Modules")
stand.check(divider and list, "the Debug divider and the Modules list are built")
stand.check(not divider.visible and not list.visible, "hidden without debug mode")
for _, fn in listeners do fn("debug", true) end
stand.check(divider.visible and list.visible, "shown when debug mode turns on")
for _, fn in listeners do fn("debug", false) end
stand.check(not divider.visible and not list.visible, "hidden again when it turns off")

-- The items are made only while the list is open
stand.equal(#list.children, 0, "nothing in Modules until it's opened")
stand.click(list)
stand.check(#list.children > 0, "opening it makes its items")
stand.back(list)
stand.equal(#list.children, 0, "going back out removes them")
stand.click(list)
stand.click(list)
stand.equal(#stand.find_item(stand.root, "Modules").children, #list.children, "opened again: made once, not twice")

-- list_in(node): the Modules list in another menu, its items made while it's open
local elsewhere = new MenuNode(stand.root):list("Elsewhere")
local attached = modules_menu.list_in(elsewhere)
stand.check(attached.handle.visible and stand.name_of(attached.handle) == "Modules", "list_in puts a Modules list there")
stand.equal(#attached.handle.children, 0, "empty until it's opened")
stand.click(attached.handle)
stand.check(stand.find_item(attached.handle, "2: b: ") ~= nil, "opened, it lists the modules")
stand.back(attached.handle)
-- module_in(node, name): one module's list
local one = modules_menu.module_in(elsewhere, "b")
stand.equal(stand.name_of(one.handle), "2: b: running", "module_in: the module's list, named like in Modules")
stand.click(one.handle)
stand.check(stand.child(one.handle, "Status: running") ~= nil and stand.child(one.handle, "Stop") ~= nil
    and stand.child(stand.child(one.handle, "Function Call"), "Module Functions") ~= nil, "with its status, actions and functions")
stand.back(one.handle)
stand.equal(#one.handle.children, 0, "gone again after going back")
stand.equal(modules_menu.module_in(elsewhere, "missing"), nil, "no such module: nil")
stand.click(list)

local entry_b = stand.find_item(list, "2: b: ")
stand.equal(stand.name_of(entry_b), "2: b: running", "an entry shows the module's name, number and status")
stand.check(entry_b.help:find("Needs: a", 1, true), "its help shows the deps")

-- Each module is a list: its actions in the menu's order, then its functions
-- The names of the items the user sees (hidden ones left out)
local function names_in(node)
    local names = {}
    for _, child in node.children do
        if child.visible ~= false then
            table.insert(names, stand.name_of(child))
        end
    end
    return table.concat(names, " | ")
end
stand.equal(entry_b.kind, "list", "a module is a list")
stand.equal(names_in(entry_b), "Status: running | Start | Restart | Stop | Reload | Options | Function Call",
    "actions, the Options divider, then the Function Call list")
stand.equal(names_in(stand.child(entry_b, "Function Call")), "Disable Function Categories | Module Functions | Base Functions",
    "Function Call: Disable Function Categories, Module Functions, Base Functions")
stand.equal(stand.child(stand.child(entry_b, "Function Call"), "Base Functions").kind, "list", "Base Functions is a list, like a category")
stand.equal(names_in(stand.child(stand.child(entry_b, "Function Call"), "Base Functions")), "on_start(): void | on_tick(): void | on_stop(): void",
    "with the hooks")
stand.equal(names_in(stand.child(stand.child(entry_b, "Function Call"), "Module Functions")), "Variables | Functions | No functions",
    "in it the Variables list; one made without a class has no functions")

local entry_a = stand.find_item(list, "1: a: ")
stand.click(stand.child(entry_a, "Stop"))
stand.equal(stand.name_of(entry_a), "1: a: stopped", "Stop stops the module")
stand.equal(stand.name_of(entry_b), "2: b: stopped", "and what needs it; the entries are refreshed")
stand.equal(stops, 1, "b's on_stop ran")
stand.equal(stand.name_of(entry_a.children[1]), "Status: stopped", "the Status divider follows the module's status")
stand.equal(names_in(entry_a), "Status: stopped | Start | Restart | Stop | Reload",
    "stopped: the Options divider and the Function Call list are hidden")
stand.equal(names_in(entry_b), "Status: stopped | Start | Restart | Stop | Reload", "also in b, stopped with it")
stand.click(stand.child(entry_b, "Start"))
stand.equal(stand.name_of(entry_a), "1: a: running", "Start on b starts its dep a too")
stand.check(names_in(entry_a):find("| Options | Function Call", 1, true) and names_in(entry_b):find("| Options | Function Call", 1, true),
    "running again: both have them back")

-- ─── Functions: the module's own, a button without parameters, a text field with ─────────────

local entry_counter = stand.find_item(list, "3: counter: ")
local counter_functions = stand.child(stand.child(entry_counter, "Function Call"), "Module Functions")
stand.equal(counter_functions.kind, "list", "Module Functions is a list")
stand.equal(names_in(counter_functions), "Variables | Functions | Add | broken() | reset()"
    .. " | Internal Functions | _hidden()",
    "Variables, its own functions by name with their parameters, then the _ ones at the bottom; hooks and Module's own left out")
stand.equal(stand.child(counter_functions, "_hidden()").kind, "list", "a _ function is callable the same way")
-- Variables: the module's fields and their values when the list is opened
local variables = stand.child(counter_functions, "Variables")
counter.label = "main"
counter.items = { 1, 2 }
local function values_in(node)
    local lines = {}
    for _, child in node.children do
        table.insert(lines, $"{stand.name_of(child)}: {child.value}")
    end
    return table.concat(lines, " | ")
end
counter.vehicles = { [158214] = true, [169734] = true, nested = { x = 1 } }
stand.click(variables)
stand.equal(names_in(variables), "count | items (2) | label | vehicles (3)",
    "Variables: the module's own fields, sorted; a table is a list named with how many entries it has")
stand.equal(stand.child(variables, "count").value, "0", "a value as it is")
stand.equal(stand.child(variables, "label").value, '"main"', "a text in quotes")
local vehicles_node = stand.child(variables, "vehicles (3)")
stand.equal(vehicles_node.kind, "list", "a table field is a list")
stand.click(stand.child(variables, "items (2)"))
stand.equal(values_in(stand.child(variables, "items (2)")), "[1]: 1 | [2]: 2", "a list's entries by index, made when it's opened")
stand.click(vehicles_node)
stand.equal(names_in(vehicles_node), "[158214] | [169734] | nested (1)", "other keys sorted, tables inside are lists too")
stand.equal(stand.child(vehicles_node, "[158214]").value, "true", "each entry with its value")
stand.click(stand.child(vehicles_node, "nested (1)"))
stand.equal(stand.child(stand.child(vehicles_node, "nested (1)"), "x").value, "1", "down into a table inside")
-- While it's open: a changed value changes in place, a new entry makes the list again
local count_line = stand.child(variables, "count")
counter.count = 3
stand.clock += 300
stand.frame()
stand.equal(count_line.value, "3", "a changed value shows while the list is open")
stand.equal(stand.child(variables, "count"), count_line, "in place: the same line")
counter.vehicles[200000] = true
stand.clock += 300
stand.frame()
stand.check(stand.child(variables, "vehicles (4)") ~= nil, "an entry that came: the list is made again")
stand.back(variables)
counter.count = 9
stand.clock += 300
stand.frame()
stand.equal(#variables.children, 0, "gone back: nothing is looked at or made any more")
counter.count = 0
counter.vehicles = nil
counter.count = 7
stand.back(variables)
stand.click(variables)
stand.equal(stand.child(variables, "count").value, "7", "opened again: the values now")
counter.count = 0
counter.label = nil
counter.items = nil
local add_node = stand.child(stand.child(counter_functions, "Add"), "add(amount, note)")
stand.equal(add_node.kind, "list", "with parameters: a list too")
stand.equal(names_in(add_node), "Arguments | Call Settings | Call After Typing | Call | Call When Opened"
    .. " | Call When Hovered | Show Call Time | Show Result On Screen | Loop Status: stopped | Loop | Loop With Interval | Variable: —",
    "the Arguments list on top, then the call settings")
stand.equal(stand.child(add_node, "Arguments").kind, "list", "Arguments is a list")
stand.equal(names_in(stand.child(add_node, "Arguments")), "amount | Argument * | note | Argument *",
    "in it a divider with the parameter's name and a field for each")
-- The field under a parameter's divider, in the function's Arguments list
local function field_under(node, param: string)
    node = stand.child(node, "Arguments") or node
    for i, child in node.children do
        if child.kind == "divider" and stand.name_of(child) == param then
            return node.children[i + 1]
        end
    end
    return nil
end
local add_args = field_under(add_node, "amount")
local add_note = field_under(add_node, "note")
stand.equal(add_args.kind, "text_input", "a parameter's field is a text field")
stand.equal(stand.name_of(add_args), "Argument *", "named by what it takes: no type written, so Argument *")
-- Its command: the module's number, then the function's among all of its functions by name
-- (_hidden, add, broken, reset: "_" sorts first), then the parameter's
stand.check(add_args.commands[1]:find("moduleargsfor3_2_1$") ~= nil, $"a short command: {add_args.commands[1]}")
stand.check(add_note.commands[1]:find("moduleargsfor3_2_2$") ~= nil, $"the next parameter's: {add_note.commands[1]}")
local reset_node = stand.child(counter_functions, "reset()")
stand.equal(reset_node.kind, "list", "without: a list")
stand.equal(names_in(reset_node), "Call Settings | Call | Call When Opened | Call When Hovered | Show Call Time | Show Result On Screen | Loop Status: stopped | Loop | Loop With Interval | Variable: —",
    "Call Settings, Call, Call After, Call When Opened / Hovered, the loop (status, Loop, Loop With Interval), then what it gave last")
-- Call After: once, after the ms picked
counter.count = 5
local clock_before = stand.clock
stand.clear_logs()
stand.click(stand.child(reset_node, "Call"), 500)
stand.check(stand.find_log("Module 3.reset(): called in 500 ms"), "Call with a number of ms picked: it tells when")
-- The item is named Call at 0 and Call After with a number picked (Stand checks it while the item is on screen)
local call_item = stand.child(reset_node, "Call")
menu.set_value(call_item, 500)
stand.view_tick(call_item)
stand.equal(stand.name_of(call_item), "Call After", "a number picked: the item is named Call After")
menu.set_value(call_item, 0)
stand.view_tick(call_item)
stand.equal(stand.name_of(call_item), "Call", "back to 0: Call")
stand.check(stand.clock - clock_before >= 500 and counter.count == 0, "and calls the function after that wait")
counter.count = 0
stand.equal(stand.child(reset_node, "Loop").kind, "toggle", "Loop is a toggle")

stand.clear_logs()
menu.set_value(add_args, "5")
menu.set_value(add_note, '"a, b"')
stand.equal(counter.count, 0, "typing the arguments calls nothing")
stand.click(stand.child(add_node, "Call"))
stand.equal(counter.count, 5, "the arguments are passed: a number")
stand.check(stand.find_item(add_node, "Variable: 5, a, b") ~= nil, "Variable shows what the call gave last")
stand.check(stand.find_log('Module 3.add(amount, note) -> 5, a, b'), "and the results are told, the quoted text whole")
stand.click(stand.child(reset_node, "Call"))
stand.equal(counter.count, 0, "a button calls the function")
stand.check(stand.find_log("Module 3.reset(): done"), "a call without results says it's done")
stand.clear_logs()
stand.click(stand.child(stand.child(counter_functions, "broken()"), "Call"))
stand.check(stand.find_log("Module 3.broken() failed: it broke"), "an error in the function is told, not thrown")
stand.check(stand.find_log("| ERROR] Module 3.broken() failed"), "as an error: Errors Always In Stand applies to it")
-- Call When Opened: opening the list calls the function, only while it's on
counter.count = 5
stand.click(reset_node)
stand.equal(counter.count, 5, "opening the list calls nothing while Call When Opened is off")
stand.click(stand.child(reset_node, "Call When Opened"))
stand.click(reset_node)
stand.equal(counter.count, 0, "with it on, opening the list calls the function")
stand.click(stand.child(reset_node, "Call When Opened"))
counter.count = 5
stand.click(reset_node)
stand.equal(counter.count, 5, "off again: opening calls nothing")
-- Call When Hovered: the cursor on the list calls the function, only while it's on
stand.hover(reset_node)
stand.equal(counter.count, 5, "hovering calls nothing while Call When Hovered is off")
stand.click(stand.child(reset_node, "Call When Hovered"))
stand.hover(reset_node)
stand.equal(counter.count, 0, "with it on, hovering the list calls the function")
stand.click(stand.child(reset_node, "Call When Hovered"))
counter.count = 5
stand.hover(reset_node)
stand.equal(counter.count, 5, "off again: hovering calls nothing")
counter.count = 0

-- Loops of a function without parameters
local reset_status = stand.find_item(reset_node, "Loop Status")
counter.count = 5
stand.clear_logs()
stand.click(stand.child(reset_node, "Loop"))
stand.check(stand.find_log("Module 3.reset(): loop started"), "Loop is told")
stand.equal(stand.name_of(reset_status), "Loop Status: running", "Loop Status: running")
counter.count = 5
stand.frame()
stand.equal(counter.count, 0, "Loop calls the function every frame")
stand.click(stand.child(reset_node, "Loop"))
stand.check(stand.find_log("Module 3.reset(): loop stopped"), "switching Loop off is told")
stand.equal(stand.name_of(reset_status), "Loop Status: stopped", "Loop Status: stopped")
counter.count = 5
stand.frame()
stand.equal(counter.count, 5, "Loop off ends the loop")
-- With an interval: once every so many ms (a frame is stand.FRAME_MS here)
local adds = 0
local real_reset = counter.reset
counter.reset = function() adds += 1 end
stand.click(stand.child(reset_node, "Loop With Interval"), 300)
stand.check(stand.find_log("Module 3.reset(): loop every 300 ms"), "Loop With Interval tells its interval")
stand.equal(stand.name_of(reset_status), "Loop Status: every 300 ms", "Loop Status: every 300 ms")
stand.equal(stand.child(reset_node, "Loop").value, true, "Loop With Interval switches Loop on")
for _ = 1, 9 do
    stand.frame()
    stand.clock += stand.FRAME_MS
end
stand.check(adds >= 3 and adds <= 4, $"called once every 300 ms ({adds} calls in 900 ms)")
-- The module's Stop ends its functions' loops
stand.click(stand.child(entry_counter, "Stop"))
stand.equal(stand.name_of(reset_status), "Loop Status: stopped", "the module's Stop ends its functions' loops")
stand.equal(stand.child(reset_node, "Loop").value, false, "and switches Loop off")
adds = 0
stand.frame(3)
stand.equal(adds, 0, "nothing is called any more")
stand.click(stand.child(entry_counter, "Start"))
-- An error ends the loop, told as an error
counter.reset = function() error("loop broke", 0) end
stand.clear_logs()
stand.click(stand.child(reset_node, "Loop"))
stand.frame()
stand.check(stand.find_log("| ERROR] Module 3.reset() failed: loop broke"), "an error in a loop is told as an error")
stand.equal(stand.name_of(reset_status), "Loop Status: error", "Loop Status: error, the loop ended")
stand.equal(stand.child(reset_node, "Loop").value, false, "Loop switched off by the error")
-- Loop With Interval, then Loop off: the interval loop stops
counter.reset = function() adds += 1 end
stand.click(stand.child(reset_node, "Loop With Interval"), 300)
stand.click(stand.child(reset_node, "Loop"))
adds = 0
for _ = 1, 6 do
    stand.frame()
    stand.clock += stand.FRAME_MS
end
stand.equal(adds, 0, "Loop off stops a loop started with an interval")
counter.reset = real_reset
counter.count = 0

-- The hooks by hand: on_stop runs, the status stays
stops = 0
stand.click(stand.child(stand.child(stand.child(entry_b, "Function Call"), "Base Functions"), "on_stop(): void"))
stand.equal(stops, 1, "on_stop() calls the module's hook")
stand.equal(stand.name_of(entry_b), "2: b: running", "without changing its status")
-- on_tick by hand: a list with Start, Start For A While, Stop; works on a stopped module too
local entry_ticker = stand.find_item(list, "4: ticker: ")
stand.click(stand.child(entry_ticker, "Stop"))
local tick_node = stand.child(stand.child(stand.child(entry_ticker, "Function Call"), "Base Functions"), "on_tick(): void")
stand.equal(names_in(tick_node), "Start With Init | Start Loop Only | Start Loop For A While | Stop | Status: stopped",
    "on_tick() is a list of Start With Init, Start Loop Only, Start For A While, Stop, then its Status")
local tick_status = stand.child(tick_node, "Status: stopped")
stand.equal(tick_status.kind, "divider", "the Status is a divider")
stand.equal(stand.name_of(tick_status), "Status: stopped", "Status: stopped before a start")
ticks = 0
stand.frame(3)
stand.equal(ticks, 0, "a stopped module doesn't tick")
stand.clear_logs()
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.check(stand.find_log("Module 4.on_tick(): loop started"), "Start is told")
stand.frame(3)
stand.equal(ticks, 3, "Start runs on_tick every frame")
stand.equal(stand.profiled[#stand.profiled], "ticker.on_tick()", "timed by profiling.tick under the module's full name")
stand.equal(stand.name_of(tick_status), "Status: running", "Status: running")
stand.click(stand.child(tick_node, "Stop"))
stand.check(stand.find_log("Module 4.on_tick(): loop stopped"), "Stop is told")
stand.frame(3)
stand.equal(ticks, 3, "Stop ends it")
stand.equal(stand.name_of(tick_status), "Status: stopped", "Status: stopped after Stop")
stand.click(stand.child(tick_node, "Stop"))
stand.check(stand.find_log("Module 4.on_tick(): no loop started by hand"), "Stop with nothing running says so")
-- For a while: 1 s at stand.FRAME_MS a frame
ticks = 0
stand.click(stand.child(tick_node, "Start Loop For A While"), 1)
stand.check(stand.find_log("Module 4.on_tick(): loop started for 1 s"), "Start For A While tells for how long")
stand.equal(stand.name_of(tick_status), "Status: running, 1 s left", "Status shows the seconds left")
for _ = 1, 30 do
    stand.frame()
    stand.clock += stand.FRAME_MS
end
local ticked_for = ticks
stand.check(ticked_for > 0 and ticked_for <= 1000 // stand.FRAME_MS + 1, $"it ticks about 1 s ({ticked_for} frames)")
stand.check(stand.find_log("Module 4.on_tick(): time's up, loop stopped"), "and stops by itself, told")
stand.equal(stand.name_of(tick_status), "Status: stopped", "Status: stopped when the time's up")
-- Start again while running: the newer run replaces it, not twice a frame. A running module is stopped
-- first, so the manager doesn't tick it as well
stand.click(stand.child(entry_ticker, "Start"))
stand.equal(stand.name_of(entry_ticker), "4: ticker: running", "the module runs (the manager ticks it)")
stand.clear_logs()
ticks = 0
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.equal(stand.name_of(entry_ticker), "4: ticker: stopped", "starting on_tick by hand stops the running module")
stand.check(stand.find_log("Module 4 stopped: the loop runs by hand"), "and says so")
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.frame(2)
stand.equal(ticks, 2, "on_tick runs once a frame: not with the manager, not twice for starting again")
stand.click(stand.child(tick_node, "Stop"))
-- An error stops the run and is told as an error
local bad_tick = Atdar.modules.get("ticker")
bad_tick.on_tick = function() error("tick broke", 0) end
stand.clear_logs()
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.frame(2)
stand.check(stand.find_log("| ERROR] Module 4.on_tick() failed: tick broke"), "an error in on_tick is told as an error")
bad_tick.on_tick = function() ticks += 1 end
ticks = 0
stand.frame(2)
stand.equal(ticks, 0, "and the run stopped")
stand.equal(stand.name_of(tick_status), "Status: error", "Status: error")

-- What a call gave, as told: tables unpacked, functions as their signatures (the return type read from
-- the file they're written in)
local describe = modules_menu.describe
-- The word is hidden by default (Hide Function Word); these checks are for the long one
local values_logic = Atdar.loader.load("ui/logic/stand/values")
values_logic.hide_function = false
stand.equal(describe({ 1, 2, 3 }), "{1, 2, 3}", "a list of numbers: the numbers")
stand.equal(describe({ "a", "b" }), '{"a", "b"}', "a list of texts: the texts")
stand.equal(describe({}), "{}", "an empty table")
stand.equal(describe({ 1, name = "x", [10] = true }), '{1, [10] = true, name = "x"}', "keys after the list part")
stand.equal(describe({ inner = { 1, { 2, { 3 } } } }), "{inner = {1, {2, {...}}}}", "tables inside: three deep, deeper ones {...}")
local looped = { 1 }
looped.self = looped
stand.equal(describe(looped), "{1, self = {...}}", "a table inside itself doesn't loop")
local function probe_void(a, b): void end
local function probe_bool(): bool return true end
local function probe_long(first: int,
    second: string): ?int return nil end
local function probe_none(x) return x end
stand.equal(describe(probe_void), "function(a, b): void", "a function: its parameters and return type")
values_logic.hide_function = true
stand.equal(describe(probe_void), "(a, b): void", "Hide Function Word on: no function before the brackets")
stand.equal(values_logic.item_title({ name = "go", text = "(): void", is_function = true }), "go(): void", "a function line: the brackets follow the name")
stand.equal(values_logic.item_title({ name = "n", text = "5" }), "n: 5", "another line: name and value")
values_logic.hide_function = false
stand.equal(describe(probe_bool), "function(): bool", "without parameters")
stand.equal(describe(probe_long), "function(first, second): ?int", "parameters on more lines than one")
stand.equal(describe(probe_none), "function(x)", "no return type written: none shown")
stand.equal(describe(|...| -> nil), "function(...)", "a lambda with ...")
stand.equal(describe({ go = probe_bool }), "{go = function(): bool}", "a function inside a table")
stand.equal(describe(5), "5", "a number as it is")
stand.equal(describe("text"), "text", "a text on its own without quotes")

-- Stand restoring the field only sets the arguments
add_args.on_change("7", 4)
stand.equal(counter.count, 0, "Stand's own change of Arguments calls nothing")
-- Call After Typing: typing the arguments calls the function, Stand putting the field back doesn't
stand.click(stand.child(add_node, "Call After Typing"))
add_args.on_change("4", 0)
stand.equal(counter.count, 4, "with Call After Typing on, typing the arguments calls the function")
add_args.on_change("3", 4)
stand.equal(counter.count, 4, "Stand's own change of the field still calls nothing")
stand.click(stand.child(add_node, "Call After Typing"))
add_args.on_change("5", 0)
stand.equal(counter.count, 4, "off again: typing only keeps the arguments")
counter.count = 0

-- The arguments as typed
local modules_menu_args = Atdar.loader.load("parsers/proglang/pluto/args").parse
local args, count = modules_menu_args('adder, 5, true, false, nil, "x, y", 2.5')
stand.equal(count, 7, "pluto args counts every argument, nil too")
stand.check(args[1] == "adder" and args[2] == 5 and args[3] == true and args[4] == false and args[5] == nil
    and args[6] == "x, y" and args[7] == 2.5, "text, numbers, true, false, nil, a quoted text with a comma")
local _, none = modules_menu_args("")
stand.equal(none, 0, "nothing typed: no arguments")
-- Expressions: calls (natives and the like) are worked out, commas inside them don't split.
-- Stand's Lua has no load: the arguments must be read without it
local saved_load = _G.load
_G.load = nil
_G.FAKE = { handle = || -> 501, add = |a, b| -> a + b, pair = function() return 1, 2 end, value = 3, get = |self| -> self.value }
local worked, worked_count = modules_menu_args("FAKE.handle(), FAKE.add(2, 3), math.max(1, 7)")
stand.check(worked_count == 3 and worked[1] == 501 and worked[2] == 5 and worked[3] == 7,
    "calls in the arguments are made: FAKE.handle(), FAKE.add(2, 3), math.max(1, 7)")
local texts, texts_count = modules_menu_args("hello world, again")
stand.check(texts_count == 2 and texts[1] == "hello world" and texts[2] == "again",
    "what isn't an expression at all is split into texts")
local _, _, err = modules_menu_args("missing.call()")
stand.check(err ~= nil, "a call that fails gives an error")
local more, more_count = modules_menu_args("FAKE:get(), FAKE.value, -2.5, 0x10, 'q', FAKE.pair()")
stand.check(more_count == 7 and more[1] == 3 and more[2] == 3 and more[3] == -2.5 and more[4] == 16
    and more[5] == "q" and more[6] == 1 and more[7] == 2,
    ":method(), .field, negative and hex numbers, 'text', the last call gives all its values")
local nested, nested_count = modules_menu_args("FAKE.add(FAKE.pair()), FAKE.pair(), adder")
stand.check(nested_count == 3 and nested[1] == 3 and nested[2] == 1 and nested[3] == "adder",
    "calls inside calls; a call that isn't last gives its first value; a bare word is text")
stand.clear_logs()
menu.set_value(add_args, "FAKE.add(1, 1)")
menu.set_value(add_note, "FAKE.handle()")
stand.click(stand.child(add_node, "Call"))
stand.equal(counter.count, 2, "a call in a field reaches the function")
stand.check(stand.find_item(add_node, "Variable: 2, 501") ~= nil, "each field is one argument")
-- A call of a function with known parameters: the field becomes a list with that function's fields, here too
-- (FAKE.add(1, 1) above made it one already: FAKE.add's parameters are known)
local function amount_item() return field_under(add_node, "amount") end
local function type_amount(value: string): void
    local item = amount_item()
    if item.kind == "list" then
        item = item.children[1]
    end
    item.on_change(value, 0)
end
local amount_name = stand.name_of(add_args)
stand.check(amount_item().kind == "list" and stand.name_of(amount_item()) == $"{amount_name}: FAKE.add(1, 1)",
    "a call typed in a module function's field: the field is a list, named by the kind and the expression")
stand.equal(names_in(amount_item()), "Expression | a | Argument * | b | Argument *", "with the called function's parameters")
Atdar.test_inner = function(entity: int, alive: bool = false): int return entity * 2 end
type_amount("test_inner(4)")
stand.equal(names_in(amount_item()), "Expression | entity | Number | alive | Boolean", "another function typed: its parameters")
amount_item().children[3].on_change("6", 0)
counter.count = 0
stand.click(stand.child(add_node, "Call"))
stand.equal(counter.count, 12, "typing in its fields writes the expression the call takes")
type_amount("1")
stand.check(amount_item().kind == "text_input" and amount_item().value == "1", "a plain value typed: one field again")
add_args = amount_item()
add_note = field_under(add_node, "note")
counter.count = 2
Atdar.test_inner = nil
-- A field with two values isn't one argument
menu.set_value(add_args, "1, 2")
stand.clear_logs()
stand.click(stand.child(add_node, "Call"))
stand.check(stand.find_log("amount: one value is needed"), "two values in a field are told")
stand.equal(counter.count, 2, "and nothing is called")
-- A loop works the arguments out at each call
menu.set_value(add_args, "1")
menu.set_value(add_note, "")
stand.click(stand.child(add_node, "Loop"))
stand.frame(3)
stand.equal(counter.count, 5, "a loop passes the arguments at each call")
stand.check(stand.find_item(add_node, "Variable: 5, nil") ~= nil, "a loop keeps Variable up to date")
stand.equal(stand.debug_texts[#stand.debug_texts], "counter.add(amount, note) -> 5, nil",
    "what the call gave is drawn on screen (debug text)")
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 1, "once a frame, not twice")
-- The settings of Debug > Call Function > Settings are the same here (ui/stand/core/call_display)
local display = Atdar.loader.load("ui/stand/core/call_display")
display.show_result = false
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 0, "Show Result On Screen off: a module's loop draws nothing")
display.show_result = true
display.result_length = 20
stand.debug_texts = {}
stand.frame()
local cut_text = stand.debug_texts[#stand.debug_texts]
stand.check(cut_text ~= nil and #cut_text == 23 and cut_text:sub(-3) == "...", "Result Length On Screen: the text is cut with ...")
display.result_length = 100
local timed_names = {}
_G.profiling = { tick = function(name, fn) table.insert(timed_names, name) fn() end }
stand.frame()
stand.equal(timed_names[#timed_names], "counter.add()", "Show Call Time on: a module's loop is timed")
display.show_time = false
timed_names = {}
stand.frame()
stand.equal(#timed_names, 0, "off: not timed")
display.show_time = true
-- A function's own Show Call Time and Show Result On Screen: off for this function only
stand.click(stand.child(add_node, "Show Call Time"))
timed_names = {}
stand.frame()
stand.equal(#timed_names, 0, "Show Call Time off in the function: not timed, the setting for all still on")
stand.click(stand.child(add_node, "Show Call Time"))
stand.click(stand.child(add_node, "Show Result On Screen"))
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 0, "Show Result On Screen off in the function: nothing drawn")
stand.click(stand.child(add_node, "Show Result On Screen"))
stand.frame()
stand.equal(#stand.debug_texts, 1, "and on again: drawn")
_G.profiling = nil
-- A table is unpacked
stand.click(stand.child(add_node, "Loop"))
local real_add = counter.add
counter.add = function() return { 1, "a", { x = 2 } } end
stand.click(stand.child(add_node, "Loop"))
stand.frame()
stand.equal(stand.debug_texts[#stand.debug_texts], 'counter.add(amount, note) -> {1, "a", {x = 2}}', "a table unpacked")
-- A table it gave: its entries in the Value list under Variable
local value_list = stand.find_item(add_node, "Value (3)")
stand.check(value_list ~= nil and value_list.visible ~= false, "a table result: a Value list with how many entries it has")
stand.equal(names_in(value_list), '[1]: 1 | [2]: "a" | [3] (1)', "its entries: a value is a field with it, a table inside a list")
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: table", "a table of mixed kinds: just table")
-- No settings to find: a table is opened as it is, its functions are lists and its values fields
stand.equal(stand.find_item(add_node, "Table Depth"), nil, "a table result: no Table Depth")
stand.equal(stand.find_item(add_node, "Call Functions In Tables"), nil, "no Call Functions In Tables")
stand.equal(stand.find_item(add_node, "Change Variable Values"), nil, "no Change Variable Values")
-- Change Variable Values: the values in the table are fields; a value typed is put into the table and told
local edited = { 1, "a" }
counter.add = function() return edited end
stand.frame()
local edit_field = stand.find_item(stand.find_item(add_node, "Value (2)"), '[2]: "a"')
stand.check(edit_field ~= nil and edit_field.kind ~= "readonly", "a value in a table is a field")
stand.clear_logs()
edit_field.on_change('"b"', 0)
stand.equal(edited[2], "b", "a value typed in it goes into the table")
stand.check(stand.find_log('[2]') and stand.find_log('"b"') and not stand.find_log("ERROR"), "and the change is told, the new value in quotes")
-- The panel of a function in a table is Call Function's: it calls through the system module CallFunction,
-- loaded as the bootstrap does (it and FileEditor are system modules: not listed, the numbers above stay)
stand.equal(Atdar.modules.load_dir($"{stand.SRC}lib/AnitaDarin/modules/systems/"), 3, "the system modules load")
-- Only these two: start() would bring back the modules stopped above
Atdar.modules.start_module("CallFunction")
Atdar.modules.start_module("FileEditor")
-- Call Functions In Tables: a function in the table is a list with a field for each parameter it says
local table_calls = {}
local with_functions = { go = function(speed: int, note: string) table.insert(table_calls, table.pack(speed, note)) end,
    vague = function(...) end }
counter.add = function() return with_functions end
stand.frame()
local go_list = stand.find_item(stand.find_item(add_node, "Value (2)"), "go: function(speed, note)")
stand.check(go_list ~= nil and go_list.kind == "list", "a function in the table is a list")
stand.equal(#go_list.children, 0, "its panel is made when it's opened")
stand.click(go_list)
local go_names = {}
for _, child in stand.child(go_list, "Arguments").children do
    table.insert(go_names, stand.name_of(child))
end
local go_text = table.concat(go_names, " | ")
stand.check(go_text:find("speed | Number | note | Text", 1, true), "with a field for each of its parameters")
local vague_list = stand.find_item(stand.find_item(add_node, "Value (2)"), "vague: function(...)")
stand.click(vague_list)
local vague_names = {}
for _, child in stand.child(vague_list, "Arguments").children do
    table.insert(vague_names, stand.name_of(child))
end
stand.check(table.concat(vague_names, " | "):find("Arguments", 1, true), "one that says nothing of its parameters: the one Arguments field")
-- Without CallFunction running there's nothing to call through: a function in the table is a plain line
Atdar.modules.stop_module("CallFunction")
stand.clear_logs()
counter.add = function() return { go = with_functions.go, vague = with_functions.vague, more = 1 } end
stand.frame()
local plain_go = stand.find_item(stand.find_item(add_node, "Value (3)"), "go")
stand.check(plain_go ~= nil and plain_go.kind ~= "list", "CallFunction stopped: a function in the table is a line, not a list")
stand.check(not stand.find_log("ERROR"), "and nothing fails")
Atdar.modules.start_module("CallFunction")
counter.add = function() return { 1, "a", { x = 2 } } end
stand.frame()
-- Types in words: a table by what it holds
counter.add = function() return { 1, 2, 3 } end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: table of integers",
    "a table of integers: the type only, what it holds is in the Value list")
counter.add = function() return { 1, 2.5 } end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: table of numbers", "integers and floats: a table of numbers")
counter.add = function() return { "a", "b" } end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: table of strings", "a table of strings")
counter.add = function() return {} end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: empty table", "an empty table")
counter.add = function() return 2.5 end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: 2.5", "a plain value: the value, no type")
stand.equal(stand.name_of(add_node.children[#add_node.children]), "Value (0)", "and the Value list is the last item")
-- A userdata it gave (Stand's vectors): its name on the Variable line, its value on a line right under.
-- Stand's v3 isn't in the test: an open file with a vector's fields and name does
local fake_vector = io.open(stand.tmpdir("modules_menu_userdata") .. "vector.txt", "w")
debug.setmetatable(fake_vector, { __index = { x = 1.5, y = -2, z = 3.25 }, __tostring = || -> "Vector3: 00000201FD08E0C8" })
counter.add = function() return fake_vector end
stand.frame()
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: Vector3", "a userdata: its name on the Variable line")
local vector_line = stand.find_item(add_node, "1.500, -2.000, 3.250")
stand.check(vector_line ~= nil and vector_line.kind == "divider" and vector_line.visible ~= false,
    "and a vector's coordinates on a divider under it")
stand.equal(stand.debug_texts[#stand.debug_texts], "counter.add(amount, note) -> Vector3(1.500, -2.000, 3.250)",
    "the same in what's drawn on screen")
counter.add = function() return 2.5 end
stand.frame()
stand.check(vector_line.visible == false, "a value of another kind: the line is hidden")
stand.equal(stand.name_of(stand.find_item(add_node, "Variable: ")), "Variable: 2.5", "and Variable shows the value again")
counter.add = real_add
counter.count = 5
stand.click(stand.child(add_node, "Loop"))
counter.count = 2
menu.set_value(add_args, "missing.call()")
stand.click(stand.child(add_node, "Call"))
stand.check(stand.find_log("bad arguments"), "arguments that fail are told, nothing is called")
stand.check(stand.find_log("amount:"), "with the parameter they're typed for")
stand.equal(counter.count, 2, "and the function isn't called")
_G.load = saved_load

-- Start With Init: on_start, then the loop; on_stop when it ends
local starts, stops_by_hand = 0, 0
local ticker = Atdar.modules.get("ticker")
ticker.on_start = function() starts += 1 end
ticker.on_stop = function() stops_by_hand += 1 end
ticker.on_tick = function() ticks += 1 end
ticks = 0
stand.clear_logs()
stand.click(stand.child(tick_node, "Start With Init"))
stand.equal(starts, 1, "Start With Init calls on_start")
stand.check(stand.find_log("Module 4.on_tick(): initialised, loop started"), "and says so")
stand.frame(2)
stand.equal(ticks, 2, "then on_tick every frame")
stand.click(stand.child(tick_node, "Stop"))
stand.equal(stops_by_hand, 1, "Stop calls on_stop after a start with init")
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.click(stand.child(tick_node, "Stop"))
stand.equal(starts .. "," .. stops_by_hand, "1,1", "Start Loop Only calls neither on_start nor on_stop")
-- A failing on_start starts nothing
ticker.on_start = function() error("no init", 0) end
ticks = 0
stand.clear_logs()
stand.click(stand.child(tick_node, "Start With Init"))
stand.frame(2)
stand.equal(ticks, 0, "a failing on_start starts no loop")
stand.check(stand.find_log("| ERROR] Module 4.on_start() failed: no init"), "the error is told")
stand.equal(stand.name_of(tick_status), "Status: error", "Status: error")
ticker.on_start = function() starts += 1 end

-- While on_tick runs by hand the module's Status says so; its Stop ends the run too
local ticker_status = entry_ticker.children[1]
ticks = 0
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.equal(stand.name_of(ticker_status), "Status: running by hand", "the module's Status: running by hand")
stand.clear_logs()
stand.click(stand.child(entry_ticker, "Stop"))
stand.check(stand.find_log("Module 4.on_tick(): loop stopped"), "the module's Stop ends the run by hand, told")
stand.equal(stand.name_of(ticker_status), "Status: stopped", "the module's Status: stopped")
stand.equal(stand.name_of(tick_status), "Status: stopped", "and the run's")
stand.frame(2)
stand.equal(ticks, 0, "on_tick doesn't run any more")
stand.clear_logs()
stand.click(stand.child(entry_ticker, "Stop"))
stand.check(not stand.find_log("no loop started by hand"), "Stop without a run says nothing about it")
-- Restart too: the run ends, the module runs (ticked by the manager, once a frame)
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.click(stand.child(entry_ticker, "Restart"))
stand.equal(stand.name_of(ticker_status), "Status: running", "Restart ends the run, the module runs")
ticks = 0
stand.frame(2)
stand.equal(ticks, 2, "once a frame, by the manager only")
stand.click(stand.child(entry_ticker, "Stop"))

-- A changed file is marked; Reload Changed reloads only those modules
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function one() return 1 end\n    function old_field(x) return x end") .. "-- edited\n")
stand.click(stand.child(list, "Refresh"))
local marked = stand.find_item(list, "5: reloader: ")
stand.equal(stand.name_of(marked), "5: reloader: running · file changed", "a changed file is marked (Refresh, opening)")
stand.equal(stand.name_of(stand.find_item(list, "2: b: ")), "2: b: running", "a module made in code isn't")
stand.clear_logs()
stand.click(stand.child(list, "Reload Changed"))
stand.check(stand.find_log("Modules reloaded: 1"), "Reload Changed reloads the changed one")
stand.equal(stand.name_of(marked), "5: reloader: running", "and the mark goes")
stand.clear_logs()
stand.click(stand.child(list, "Reload Changed"))
stand.check(stand.find_log("No changed modules"), "nothing changed: says so")
-- Reload All: right under Reload Changed; reads every module's file again, changed or not
stand.check(names_in(list):find("Reload Changed | Reload All | ", 1, true), "Reload All is right under Reload Changed")
stand.clear_logs()
stand.click(stand.child(list, "Reload All"))
stand.check(stand.find_log("'reloader' reloaded from"), "an unchanged file is read again")
stand.check(stand.find_log("Modules reloaded: 1"), "only the modules from files count: the ones made in code are left")
-- A file changed while one is inside a module: going back out shows it, no Refresh needed
local reloader_entry = stand.find_item(list, "5: reloader: ")
stand.click(reloader_entry)
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function one() return 1 end\n    function old_field(x) return x end") .. "-- edited again\n")
stand.back(reloader_entry)
stand.equal(stand.name_of(reloader_entry), "5: reloader: running · file changed", "going back out of a module shows a file changed meanwhile")
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function one() return 1 end\n    function old_field(x) return x end") .. "-- edited\n")
stand.click(reloader_entry)
stand.back(reloader_entry)
stand.equal(stand.name_of(reloader_entry), "5: reloader: running", "and the mark goes when it's as loaded again")

-- A file added to the modules folder after the start: Refresh runs it and its module joins the list
stand.write_file($"{reload_dir}newcomer.pluto",
    "local Module = Atdar.loader.load('core/module')\nreturn Atdar.modules.add(new Module({ name = 'newcomer' }))\n")
stand.check(stand.find_item(list, "newcomer") == nil, "a new file's module isn't there before Refresh")
stand.clear_logs()
stand.click(stand.child(list, "Refresh"))
stand.check(stand.find_item(list, "newcomer") ~= nil, "Refresh adds the module of a new file to the list")
stand.check(Atdar.modules.get("newcomer"):is_running(), "and it's started")
stand.check(stand.find_log("Modules from new files: 1"), "and says how many")
stand.clear_logs()
stand.click(stand.child(list, "Refresh"))
stand.check(not stand.find_log("Modules from new files"), "nothing new: it stays quiet")

-- Reload: the code is read again, its functions in the menu are made again
local entry_reloader = stand.find_item(list, "5: reloader: ")
local function reloader_fns() return stand.child(stand.child(entry_reloader, "Function Call"), "Module Functions") end
stand.check(stand.child(reloader_fns(), "one()") ~= nil and stand.child(reloader_fns(), "old_field(x)") ~= nil,
    "a module from a file: its functions one() and old_field(x)")
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function two() return 2 end\n    function three(x) return x end"))
stand.click(stand.child(entry_reloader, "Reload"))
stand.equal(names_in(stand.child(entry_reloader, "Function Call")), "Disable Function Categories | Module Functions | Base Functions",
    "after Reload the list is made again, once")
stand.equal(names_in(reloader_fns()), "Variables | Functions | three(x) | two()",
    "with the new code's functions: one() and the field old_field(x) gone, nothing twice")
stand.clear_logs()
stand.click(stand.child(stand.child(reloader_fns(), "two()"), "Call"))
stand.check(stand.find_log("Module 5.two() -> 2"), "and they call the new code")
-- Call When Opened stays on when Reload makes the list again
local two_node = stand.child(reloader_fns(), "two()")
stand.click(stand.child(two_node, "Call When Opened"))
stand.click(stand.child(entry_reloader, "Reload"))
two_node = stand.child(reloader_fns(), "two()")
stand.equal(stand.child(two_node, "Call When Opened").value, true, "Call When Opened stays on after Reload")
stand.clear_logs()
stand.click(two_node)
stand.check(stand.find_log("Module 5.two() -> 2"), "and opening the new list calls the function")
-- The return type is read from the code that runs: after the file is edited and reloaded, from the new
-- text, though the lines moved; an edit not reloaded yet doesn't change it
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function two(): int return 2 end"))
stand.click(stand.child(entry_reloader, "Reload"))
stand.check(stand.child(reloader_fns(), "two(): int") ~= nil, "a type written after reloading shows")
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("\n\n    -- moved down\n    function two(): string return '2' end"))
stand.click(stand.child(entry_reloader, "Reload"))
stand.check(stand.child(reloader_fns(), "two(): string") ~= nil, "the lines moved: the new type, from the new lines")
stand.write_file($"{reload_dir}reloader.pluto",
    reloader_file("    function two(): bool return true end"))
stand.click(stand.child(stand.child(entry_reloader, "Function Call"), "Disable Function Categories"))
stand.click(stand.child(stand.child(entry_reloader, "Function Call"), "Disable Function Categories"))
stand.check(stand.child(reloader_fns(), "two(): string") ~= nil, "edited but not reloaded: the type of the code that runs")
stand.click(stand.child(entry_reloader, "Reload"))

-- Stop All, under Refresh: every module stops, on_tick run by hand too
stand.check(names_in(list):find("Refresh | Stop All", 1, true), "Stop All comes right under Refresh")
ticks = 0
stand.click(stand.child(tick_node, "Start Loop Only"))
stand.clear_logs()
stand.click(stand.child(list, "Stop All"))
for number, name in { "a", "b", "counter", "ticker", "reloader" } do
    local caption = $"{number}: {name}: "
    stand.equal(stand.name_of(stand.find_item(list, caption)), $"{caption}stopped", $"Stop All stops {name}")
end
stand.equal(stand.name_of(entry_b.children[1]), "Status: stopped", "and the Status dividers follow")
stand.equal(stand.child(entry_b, "Function Call").visible, false, "and the Function Call lists are hidden")
stand.check(stand.find_log("All modules stopped"), "Stop All is told")
stand.frame(2)
stand.equal(ticks, 0, "on_tick run by hand stops too")
stand.equal(stand.name_of(tick_status), "Status: stopped", "its Status too")
stand.click(stand.child(entry_b, "Start"))
stand.equal(stand.name_of(entry_b), "2: b: running", "a module starts again after Stop All")
stand.equal(stand.child(entry_b, "Function Call").visible, true, "its Function Call list is back")

-- Open Folder opens the copy Stand runs
stand.click(stand.find_item(list, "Open Folder"))
