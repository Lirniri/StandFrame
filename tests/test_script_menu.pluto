stand.check(entry("main (active)*"), "an unsaved change shows *")
stand.click(stand.find_item(entry("main (active)"), "Save"))
stand.check(entry("main (active)") and not entry("main (active)*"), "Save clears *")
stand.check(stand.read_file($"{profiles_dir}main.json"):find('"Edited"', 1, true), "Save wrote the profile")

stand.click(stand.find_item(entry("main (active)"), "Automatically Save"))
menu.set_value(short_name, "Auto")
stand.check(stand.read_file($"{profiles_dir}main.json"):find('"Auto"', 1, true) and not profile.is_dirty(),
    "Automatically Save writes every change")
stand.click(stand.find_item(entry("main (active)"), "Automatically Save"))

menu.set_value(stand.find_item(profiles(), "Create Profile"), "Second")
stand.equal(profile.active_name(), "second", "Create Profile makes and loads a profile")
stand.check(entry("second (active)") and entry("main"), "both profiles are listed")
stand.check(find("Profile: second"), "the header follows the active profile")

menu.set_value(find("Short Name"), "Second's")
stand.click(stand.find_item(entry("main"), "Load"))
stand.equal(profile.active_name(), "main", "Load makes main active")
stand.equal(find("Short Name").value, "Auto", "main's values are back in the fields")

stand.click(stand.find_item(entry("second"), "Save"))
stand.check(stand.read_file($"{profiles_dir}second.json"):find('"Auto"', 1, true), "Save on another profile overwrites it")

-- main can be deleted like any other; Create Main Profile makes it again
stand.click(stand.find_item(entry("main (active)"), "Delete"))
stand.equal(profile.active_name(), "second", "main deleted while active: another profile is loaded")
stand.check(not io.exists($"{profiles_dir}main.json"), "main's file is gone")
stand.equal(names_in(profiles()), "Create Profile | Create Main Profile | Open Folder | Profiles | second (active)",
    "only second is left")
-- The last one too, like Stand: the script goes on with its values, nothing listed
stand.click(stand.find_item(entry("second (active)"), "Delete"))
stand.check(not io.exists($"{profiles_dir}second.json"), "the only profile can be deleted too")
stand.equal(names_in(profiles()), "Create Profile | Create Main Profile | Open Folder | Profiles"
    .. " | No profiles: Create Main Profile or Save brings one back", "none listed, and how to get one back")
stand.equal(profile.active_name(), "second", "the script goes on with the values it has")
stand.clear_logs()
stand.click(stand.find_item(profiles(), "Create Main Profile"))
stand.check(io.exists($"{profiles_dir}main.json") and stand.find_log("Main profile main made"), "Create Main Profile makes main")
stand.check(entry("main") ~= nil, "it's listed")
profile.save()
stand.check(io.exists($"{profiles_dir}second.json"), "Save writes the deleted one back")
-- There already: the warning (the stand-in proceeds), then made again with the defaults
stand.write_file($"{profiles_dir}main.json", '{"short_name": "Changed"}')
stand.clear_logs()
stand.click(stand.find_item(profiles(), "Create Main Profile"))
stand.check(stand.find_log("made again with the defaults"), "main there: made again after the warning")
stand.check(not stand.read_file($"{profiles_dir}main.json"):find('"Changed"', 1, true), "its old values are gone")
stand.click(stand.find_item(entry("main"), "Load"))
stand.click(stand.find_item(entry("second"), "Delete"))
stand.equal(names_in(profiles()), "Create Profile | Create Main Profile | Open Folder | Profiles | main (active)",
    "second is deleted")
stand.check(not io.exists($"{profiles_dir}second.json"), "with its file")
-- Opening Profiles reads the list again: a profile file put there meanwhile is listed
stand.write_file($"{profiles_dir}dropped.json", "{}")
stand.click(profiles())
stand.check(entry("dropped") ~= nil, "opening Profiles lists a profile added meanwhile")
os.remove($"{profiles_dir}dropped.json")
stand.click(profiles())
stand.equal(entry("dropped"), nil, "and drops one that's gone")
-- The active main deleted as the only profile, then Create Main Profile: its file is written again
stand.click(stand.find_item(entry("main (active)"), "Delete"))
stand.check(not io.exists($"{profiles_dir}main.json") and profile.active_name() == "main", "main deleted, still active")
stand.click(stand.find_item(profiles(), "Create Main Profile"))
stand.check(io.exists($"{profiles_dir}main.json"), "Create Main Profile writes the active main's file")
stand.check(entry("main (active)") ~= nil, "and it's listed")

-- Copy Menu To Core and Command Box work from their new places
