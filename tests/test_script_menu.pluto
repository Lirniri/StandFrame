stand.check(stand.find_log("Stand is in English"), "with Stand in English it says why it can't")
stand.equal(stand.name_of(language), $"Language: {russian_name} (not with Stand in English)", "the caption shows it's unavailable")
stand.check(find("Settings"), "items stay in English")

