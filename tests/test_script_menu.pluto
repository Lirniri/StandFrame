stand.clear_logs()
stand.click(stand.child(create, "Create"))
stand.check(stand.find_log("There's a translation de-de already"), "a code there already is refused")
stand.check(stand.read_file($"{base}de-de.json"):find("Sprache", 1, true), "and its file isn't touched")
menu.set_value(code_field, "german")
stand.clear_logs()
stand.click(stand.child(create, "Create"))
stand.check(stand.find_log("'german' isn't a language code"), "not a code like de-de: refused")
-- Translate From: the new files start from the language picked
