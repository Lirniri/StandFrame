-- ui/stand/script/section (+ profile_menu, i18n languages): the script's section as laid out,
-- language choice, profiles, stubs, debug items
local stand = require("stand")
stand.boot()

-- A store of its own (profiles get written), with the script's real language files
stand.store = stand.tmpdir("script_menu_store")
-- resources: a folder that doesn't exist yet, so Open Resource Folder has to make it
local resources_root = stand.tmpdir("script_menu_resources")
filesystem.resources_dir = || -> resources_root
local base = $"{stand.store}AnitaDarin/core/language/"
io.makedirs(base)
for _, file in { "en-us.json", "ru-ru.json" } do
    stand.write_file($"{base}{file}", stand.read_file($"{stand.SRC}store/AnitaDarin/core/language/{file}"))
end
Atdar.filesystem = Atdar.loader.load("utils/filesystem")
Atdar.profile = Atdar.loader.load("core/profile")
Atdar.modules = Atdar.loader.load("core/module_manager")
local profile = Atdar.profile
local i18n = Atdar.loader.load("core/i18n")
local MenuNode = Atdar.loader.load("ui/stand/core/menu_node")
local script_menu = Atdar.loader.load("ui/stand/script/section")
local profiles_dir = $"{stand.store}AnitaDarin/profiles/"

-- What the menu loader finds in store when Load Menu is opened
FOUND_PACKS = { { folder = "AnitaDarin", name = "AnitaDarin" } }

-- Rebuilding the section, as menu.pluto's rebuild_settings does; the menu picker is faked
local function rebuild()
    stand.root.children = {}
    script_menu.build(new MenuNode(stand.root), {
        refresh = rebuild,
        packs = { { folder = "AnitaDarin", name = "AnitaDarin" } },
        find_packs = || -> FOUND_PACKS,
        fill_menus = |node| -> node:divider("Menus"),
        unload = function() UNLOADED = true end,
    })
end
rebuild()
-- The Modules list's items (the biggest file, with its parsers) aren't loaded with the section
local MODULES_MENU = "AnitaDarin/ui/stand/modules/list"
stand.equal(package.loaded[MODULES_MENU], nil, "the section is made without loading ui/stand/modules/list")
-- (Call Function's panel is made with the section, with the parsers of values: the Modules list's own one isn't)
stand.equal(package.loaded["AnitaDarin/parsers/proglang/pluto/name"], nil, "nor the parser it needs")

local function names_in(node)
    local names = {}
    for _, child in node.children do
        table.insert(names, stand.name_of(child))
    end
    return table.concat(names, " | ")
end
-- Searches the section's own items only: nested lists have items with the same names (Open Folder)
local function find(text)
    for _, child in stand.root.children do
        if stand.name_of(child):find(text, 1, true) then
            return child
        end
    end
    return nil
end
local function settings() return find("Settings") end
local function profiles() return find("Profiles") end
local function entry(name) return stand.find_item(profiles(), name) end

-- ─── Layout ──────────────────────────────────────────────────────────────────

stand.equal(names_in(stand.root),
    "Profile: main | Display Name | Short Name | Settings | Profiles | Load Menu | Command Box | Open Folder | Update | Debug"
    .. " | Remove Game Notifications",
    "the section's layout")
stand.equal(names_in(settings()), "Appearance | Language | Script | Rename Script", "Settings")
local appearance = stand.find_item(settings(), "Appearance")
stand.equal(names_in(appearance), "Notifications", "Appearance")
local notifications = stand.find_item(appearance, "Notifications")
-- The checks below expect these values; the defaults in core/profile may be anything
profile.set("notify_feed_style", "ticker")
profile.set("notify_subject_color_day", "white")
profile.set("notify_subject_color_night", "white")
profile.set("auto_copy_menu", "")
profile.set("notify", "stand")
profile.set("command_box_separator", "")
profile.set("command_box_found_separator", "")
profile.set("notify_flash", false)
profile.set("notify_feed_icon", "CHAT_BOX")
local default_picture_title = Atdar.loader.load("natives/visual/feed_picture").title(profile.default("notify_feed_picture"))
stand.equal(names_in(notifications), "Type: Stand | Emoticons | Errors Always In Stand | Notification Examples | Stand | Text On A New Line"
    .. " | Game | Notification Type: Post | Picture: " .. default_picture_title .. " | Icon: Chat | Flash Notifications | Day Starts At | Night Starts At"
    .. " | Day Background Color | Day Flash Color | Day Subject Color: White"
    .. " | Night Background Color | Night Flash Color | Night Subject Color: White",
    "Notifications, the game's feed under the Game divider")
stand.equal(stand.child(notifications, "Game").kind, "divider", "Game is a divider")
stand.click(stand.find_item(notifications, "Type"), 2)
stand.equal(profile.get("notify"), "game", "Type picks the game's feed")
stand.equal(stand.name_of(stand.find_item(notifications, "Type")), "Type: Game", "and the caption follows")

-- Notification Examples take their previous cards away from the game's feed before posting new ones
Atdar.util = Atdar.loader.load("utils/util")
Atdar.natives = Atdar.loader.auto({}, "natives")
local feed_items, removed_items = 0, {}
_G.HUD = {
    BEGIN_TEXT_COMMAND_THEFEED_POST = || -> nil,
    ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME = || -> nil,
    SET_SCRIPT_VARIABLE_HUD_COLOUR = || -> nil,
    THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST = || -> nil,
    END_TEXT_COMMAND_THEFEED_POST_TICKER = function() feed_items += 1 return feed_items end,
    THEFEED_REMOVE_ITEM = |id| -> table.insert(removed_items, id),
}
_G.CLOCK = { GET_CLOCK_HOURS = || -> 12, GET_CLOCK_MINUTES = || -> 0 }
local examples = stand.find_item(notifications, "Notification Examples")
local function names_of(node)
    local names = {}
    for _, child in node.children do
        table.insert(names, stand.name_of(child))
    end
    return table.concat(names, " | ")
end
stand.equal(names_of(examples), "Notification | Warning | Error | Success | All At Once",
    "Notification Examples: one of each kind, and all at once")
profile.set("notify_errors_in_stand", false)
local test_button = stand.child(examples, "Notification")
stand.click(test_button)
stand.check(feed_items == 1 and #removed_items == 0, "the first example is posted, nothing to take away")
stand.click(test_button)
stand.check(feed_items == 2 and #removed_items == 1 and removed_items[1] == 1, "the next click takes the previous one away first")
stand.click(stand.child(examples, "All At Once"))
stand.check(feed_items == 6 and #removed_items == 2, "All At Once: one of each of the four kinds")
notifications.on_back()
stand.check(#removed_items == 6, "going back out of Notifications takes every example away")
notifications.on_back()
stand.equal(#removed_items, 6, "and only once")
-- Remove Game Notifications: the script's posts out of the feed, told in Stand
stand.click(stand.child(examples, "Notification"))
stand.toasts = {}
stand.click(find("Remove Game Notifications"))
stand.equal(#removed_items, 7, "Remove Game Notifications takes the script's posts out of the feed")
stand.check(stand.toasts[#stand.toasts]:find("Success: Notifications taken out of the feed: 1", 1, true),
    "and tells how many, in Stand, as a success through the logger")
stand.toasts = {}
stand.click(find("Remove Game Notifications"))
stand.check(stand.toasts[#stand.toasts]:find("No notifications of the script in the feed", 1, true), "none there: says so")
profile.set("notify_errors_in_stand", true)
stand.click(stand.find_item(notifications, "Type"), 1)
local flash_toggle = stand.find_item(notifications, "Flash Notifications")
stand.click(flash_toggle)
stand.equal(profile.get("notify_flash"), flash_toggle.value, "Flash Notifications sets the profile")
stand.click(flash_toggle)
stand.equal(profile.get("notify_flash"), flash_toggle.value, "both ways")
profile.set("notify_flash", false)

local game = notifications
stand.click(stand.find_item(game, "Notification Type"), 1)
stand.equal(profile.get("notify_feed_style"), "message", "Notification Type picks a message card")
stand.equal(stand.name_of(stand.find_item(game, "Notification Type")), "Notification Type: Message", "and the caption follows")
-- Picture: the message card's only, so shown only while Message is picked; picking one asks the game to load it
local requested_dicts = {}
_G.GRAPHICS = {
    REQUEST_STREAMED_TEXTURE_DICT = |name| -> table.insert(requested_dicts, name),
    HAS_STREAMED_TEXTURE_DICT_LOADED = || -> false,
}
local picture = stand.find_item(game, "Picture")
stand.equal(picture.visible, true, "Picture shows while Message is picked")
local icon = stand.find_item(game, "Icon")
stand.equal(icon.visible, true, "Icon shows while Message is picked")
stand.click(icon, 2)
stand.equal(profile.get("notify_feed_icon"), "EMAIL", "Icon picks the card's icon")
stand.equal(stand.name_of(icon), "Icon: Email", "and the caption follows")
stand.click(icon, 1)
stand.equal(#picture.options, #Atdar.loader.load("natives/visual/feed_picture").list(), "every feed picture is offered")
stand.click(picture, 3)
stand.equal(profile.get("notify_feed_picture"), "CHAR_ALL_PLAYERS_CONF", "picking one keeps its full name")
stand.equal(stand.name_of(picture), "Picture: All Players Conf", "the caption shows a readable name")
stand.equal(requested_dicts[#requested_dicts], "CHAR_ALL_PLAYERS_CONF", "and the game is asked to load it")
profile.set("notify_feed_picture", profile.default("notify_feed_picture"))
local day_subject = stand.find_item(game, "Day Subject Color")
local night_subject = stand.find_item(game, "Night Subject Color")
stand.check(day_subject.visible and night_subject.visible, "Day / Night Subject Color show while Message is picked")
stand.equal(stand.name_of(day_subject), "Day Subject Color: White", "the caption shows the profile's color")
stand.click(day_subject, 7)
stand.equal(profile.get("notify_subject_color_day"), "red", "Day Subject Color picks the day's color")
stand.equal(stand.name_of(day_subject), "Day Subject Color: Red", "and the caption follows")
stand.click(night_subject, 4)
stand.equal(profile.get("notify_subject_color_night"), "grey", "Night Subject Color picks the night's")
stand.click(day_subject, 3)
stand.click(night_subject, 3)
stand.click(stand.find_item(game, "Notification Type"), 2)
stand.equal(picture.visible, false, "Picture hides while Post is picked")
stand.equal(stand.find_item(game, "Icon").visible, false, "Icon too")
stand.check(not day_subject.visible and not night_subject.visible, "the subject colors too")
local background = stand.find_item(game, "Day Background Color")
stand.equal(background.transparency, true, "the colours have Opacity, as in Stand")
stand.equal(profile.get("notify_background_day"), profile.default("notify_background_day"), "the day background starts at its default")
stand.equal(profile.get("notify_background_night"), profile.default("notify_background_night"), "the night one too")
stand.equal(profile.get("notify_flash_color_day"), profile.default("notify_flash_color_day"), "the flash colours start at their defaults")
local default_day = Atdar.loader.load("utils/color").from_hex(profile.default("notify_background_day"))
stand.equal(background.value.g, default_day.g, "the item shows the default colour")
background.on_change({ r = 1, g = 0.5, b = 0, a = 0.5 }, 0)
stand.equal(profile.get("notify_background_day"), "FF800080", "a picked colour is kept as hex with its opacity")
stand.find_item(game, "Day Flash Color").on_change({ r = 0, g = 0, b = 1, a = 1 }, 0)
stand.equal(profile.get("notify_flash_color_day"), "0000FFFF", "Day Flash Color")
stand.find_item(game, "Night Background Color").on_change({ r = 0, g = 0, b = 0, a = 1 }, 0)
stand.equal(profile.get("notify_background_night"), "000000FF", "Night Background Color")
stand.find_item(game, "Night Flash Color").on_change({ r = 1, g = 1, b = 1, a = 1 }, 0)
stand.equal(profile.get("notify_flash_color_night"), "FFFFFFFF", "Night Flash Color")
-- Stand calls the items when the script stops, with the color they show: "" (the game's own) shows
-- black, which must not become a picked black
profile.set("notify_flash_color_day", "")
stand.find_item(game, "Day Flash Color").on_change({ r = 0, g = 0, b = 0, a = 1 }, 4)
stand.equal(profile.get("notify_flash_color_day"), "", "the shown color reported back isn't saved as picked")
local day_start = stand.find_item(game, "Day Starts At")
stand.check(day_start.kind == "slider" and day_start.value == 7 and day_start.min == 0 and day_start.max == 23,
    "Day Starts At: an hour, 7 by default")
stand.equal(stand.find_item(game, "Night Starts At").value, 19, "Night Starts At: 19 by default")
menu.set_value(day_start, 6)
stand.equal(profile.get("notify_day_start"), 6, "moving the slider changes the hour")

-- Stand resets an item to the default it was made with (loading a Stand profile without it, click type 4).
-- That default is the real one, whatever the profile had when the menu was built
profile.set("notify_background_night", "11223344")
profile.set("notify_night_start", 21)
rebuild()
local rebuilt = stand.find_item(stand.find_item(stand.find_item(settings(), "Appearance"), "Notifications"), "Night Background Color")
stand.equal(rebuilt.default.b, 0x54 / 255, "the colour item's Stand default is the code default (1A3D54)")
stand.equal(rebuilt.value.b, 0x33 / 255, "but it shows the profile's colour")
stand.equal(profile.get("notify_background_night"), "11223344", "building didn't change the profile")
rebuilt.on_change(rebuilt.default, 4)
stand.equal(profile.get("notify_background_night"), "1A3D54FF", "Stand's reset goes to the code default, not the colour at build time")
local night = stand.find_item(stand.find_item(stand.find_item(settings(), "Appearance"), "Notifications"), "Night Starts At")
stand.check(night.default == 19 and night.value == 21, "the slider too: Stand default 19, shows the profile's 21")
menu.set_value(night, 19)
-- Saved with the menu's Save, so the checks below start without unsaved changes
stand.click(stand.find_item(entry("main (active)"), "Save"))
stand.equal(names_in(find("Load Menu")), "Unload | Copy Menu To Core: Off | Menus", "Load Menu")
-- Opening it looks for the menus again: the entries are made again, not added a second time
find("Load Menu").on_click()
stand.equal(names_in(find("Load Menu")), "Unload | Copy Menu To Core: Off | Menus", "Load Menu: opened, the menus made again")
local update_list = find("Update")
stand.equal(names_in(update_list), "Installed Version | Available Version | Last Check | Changes | Check | Check For Updates"
    .. " | Check On Start | Update Branch: main | Update | Update | Check Before Updating | Update Automatically"
    .. " | Check For Updates Every (Days)",
    "Update: the version lines, Changes, Check For Updates and its branch, then the Update divider with Update and its settings")
stand.equal(update_list.children[9].kind, "divider", "the Update divider under the branch")
stand.equal(update_list.children[2].value, "not checked", "the available version isn't known before a check")
stand.equal(update_list.children[3].value, "never", "and no check ran")
stand.toasts = {}
stand.click(stand.find_item(update_list, "Changes"))
stand.check(stand.toasts[#stand.toasts]:find("No changes to show", 1, true), "Changes: nothing before a check")
-- No internet in the test: the check fails and says why
_G.async_http = { have_access = || -> true, init = function(host, path, on_success, on_fail) on_fail("no answer") end,
    dispatch = function() end }
stand.toasts = {}
stand.click(stand.find_item(update_list, "Check For Updates"))
stand.check(stand.toasts[#stand.toasts]:find("Couldn't check for updates", 1, true), "Check For Updates says why it failed")
stand.toasts = {}
stand.click(update_list.children[10])
stand.check(stand.toasts[#stand.toasts]:find("Couldn't check for updates", 1, true), "Update checks first and stops when it can't")
stand.equal(names_in(find("Command Box")), "Base Commands Prefix | Base Commands Separator: None | Found Commands Prefix"
    .. " | Found Commands Separator: None | Commands | Base Commands | Found Commands | User Commands", "Command Box")
stand.equal(names_in(find("Open Folder")), "Open Lib Folder | Open Resource Folder | Open Store Folder | Open Log Folder", "Open Folder")

-- Open Folder opens the script's own folders; a missing one is made first
local function opened(item_name)
    stand.click(stand.find_item(find("Open Folder"), item_name))
    return stand.toasts[#stand.toasts]
end
stand.equal(opened("Open Lib Folder"), $"open_folder {stand.SRC}lib\\AnitaDarin\\", "Open Lib Folder")
stand.equal(opened("Open Store Folder"), $"open_folder {stand.store}AnitaDarin\\", "Open Store Folder")
stand.check(not io.isdir($"{resources_root}AnitaDarin"), "resources/AnitaDarin doesn't exist yet")
stand.equal(opened("Open Resource Folder"), $"open_folder {resources_root}AnitaDarin\\", "Open Resource Folder")
stand.check(io.isdir($"{resources_root}AnitaDarin"), "and it was made before opening")
stand.equal(names_in(find("Debug")),
    "Debug Mode | Stop After Changes | Load Timing | Reload Natives | Logs | Options from other menus | Settings | Debug | Call Function"
    .. " | Modules | Delete Script", "Debug")
-- The divider is called Logs too: the list is the one that opens
local logs_list
for _, child in find("Debug").children do
    if stand.name_of(child) == "Logs" and child.kind == "list" then
        logs_list = child
    end
end
stand.equal(names_in(logs_list), "Name In Logs: "
    .. (profile.get("log_name") == "display" and "Display Name" or "Short Name")
    .. " | Keep Logs (Days) | Write Info At Once | Clear Current Log File | Clear All Log Files", "Debug > Logs")
local debug_settings = stand.child(find("Debug"), "Settings")
stand.equal(names_in(debug_settings), "Languages", "Debug > Settings")
stand.equal(names_in(stand.child(debug_settings, "Languages")), "Show Keys | Send | Send Translation Path | Send File Path", "Debug > Settings > Languages")
stand.equal(names_in(profiles()), "Create Profile | Create Main Profile | Open Folder | Profiles | main (active)", "Profiles looks like Stand's")
stand.equal(names_in(entry("main (active)")), "Save | Load | Automatically Save | Reset To Defaults | Delete", "a profile's own list")

-- Unload runs menu.pluto's unload (tested in test_menu_startup)
stand.click(stand.find_item(find("Load Menu"), "Unload"))
stand.check(UNLOADED, "Unload calls the menu's unload")

-- Base Commands: the script's own, one list per item with commands, built after the whole section.
-- Found Commands is the loaded menu's: none here
local found = stand.child(find("Command Box"), "Base Commands")
stand.equal(names_in(stand.child(find("Command Box"), "Found Commands")),
    "Open Commands Folder | Commands | No menu is loaded or it has no commands",
    "Found Commands: its folder, the Commands divider, no menu, no commands")
stand.equal(found.children[2].kind, "divider", "Base Commands: the Commands divider under its folder too")
local function row(command)
    for _, child in found.children do
        if stand.name_of(child) == command then
            return child
        end
    end
    return nil
end
stand.check(#found.children > 5, $"Base Commands lists the section's commands ({#found.children})")
-- Load Menu and what's in it: all start with menuloader
for _, command in { "menuloader", "menuloaderunload", "menuloaderautocopy", "clearlog", "clearlogs" } do
    stand.check(row(command) ~= nil, $"Load Menu's command {command}")
end
local debug_row = row("debug")
stand.equal(debug_row and debug_row.kind, "list", "a row is a list named by the command without the prefix")
stand.equal(debug_row.help, "Debug Mode", "its help is the item's name")
stand.check(row("settings"), "lists also show their command")
-- The script's own commands get custom names too, kept in store/<script>/commands/<base>.json
-- Go To Item takes the cursor to the item itself
stand.click(stand.find_item(debug_row, "Go To Item"))
stand.check(stand.focused and stand.name_of(stand.focused) == "Debug Mode", "Go To Item focuses the item")
local script_names = $"{stand.store}AnitaDarin/commands/debug.json"
menu.set_value(stand.find_item(debug_row, "Custom Name"), "dbg")
stand.equal(stand.name_of(debug_row), "dbg", "a script command renamed: the row follows")
stand.equal(stand.find_item(debug_row, "Command").value, "atdardbg", "and the command, with the prefix")
stand.check(stand.read_file(script_names) and stand.read_file(script_names):find('"name": "dbg"', 1, true),
    "kept in store/AnitaDarin/commands/debug.json")
-- Open Commands Folder: Base Commands' opens the script's commands folder
stand.toasts = {}
stand.click(stand.child(found, "Open Commands Folder"))
stand.check(stand.toasts[#stand.toasts]:find("AnitaDarin\\commands\\", 1, true), "Base Commands: store/AnitaDarin/commands")
-- Extra words through the menu: Add Word makes one more command, its button takes it off
menu.set_value(stand.find_item(debug_row, "Add Word"), "dbgmode")
stand.equal(stand.find_item(debug_row, "Command").value, "atdardbg, atdardbgmode", "Add Word: one more command")
stand.equal(stand.name_of(debug_row), "dbg, dbgmode", "the row shows it too")
stand.check(stand.read_file(script_names):find('"dbgmode"', 1, true), "kept in the command's file")
stand.click(stand.child(debug_row, "dbgmode"))
stand.equal(stand.find_item(debug_row, "Command").value, "atdardbg", "its button takes it off")
stand.equal(stand.child(debug_row, "dbgmode"), nil, "and the button goes")
-- Made again (a rebuild, the next start), the item gets its custom name right away
rebuild()
found = stand.child(find("Command Box"), "Base Commands")
debug_row = row("dbg")
stand.check(debug_row and stand.find_item(debug_row, "Command").value == "atdardbg", "a rebuilt item keeps its custom name")
stand.click(stand.find_item(debug_row, "Reset Name"))
stand.equal(stand.name_of(debug_row), "debug", "Reset Name gives it back")
stand.check(not io.exists(script_names), "with no custom names left the file goes")

-- At the bottom of Debug, only in debug mode: the Debug divider, Call Function, Modules and Delete Script
local debug_list = find("Debug")
local debug_only = { debug_list.children[8], debug_list.children[9], debug_list.children[10], debug_list.children[11] }
local function all_visible(on)
    for _, it in debug_only do
        if it.visible ~= on then return false end
    end
    return true
end
stand.check(all_visible(false), "divider, Call Function, Modules and Delete Script are hidden without debug mode")
stand.check(stand.find_item(debug_list, "Load Timing").visible, "Load Timing shows without debug mode")
-- Call Function: Call A Function, Functions, then the Settings divider with Notice In Stand
local call_list = stand.find_item(debug_list, "Call Function")
stand.equal(names_in(call_list), "Call A Function | Functions | Arguments Guide | Settings | Use Short Names | Show Call Time | Show Result On Screen | Result Length On Screen | Notice In Stand | Files Editor",
    "Call Function: two lists, the Arguments Guide, then the settings")
-- Arguments Guide: how to write the arguments, as a notice in Stand
stand.toasts = {}
stand.click(stand.child(call_list, "Arguments Guide"))
stand.check(stand.toasts[#stand.toasts] and stand.toasts[#stand.toasts]:find("Each argument has its own field", 1, true), "Arguments Guide tells it in Stand")
stand.check(stand.toasts[#stand.toasts]:find("An empty field is not given", 1, true), "and what an empty field means")
stand.equal(stand.child(call_list, "Settings").kind, "divider", "Settings is a divider")
stand.equal(stand.child(call_list, "Notice In Stand").value, true, "Notice In Stand is on by default")
-- Call A Function: the name may have brackets, as it's written in a call: "name()" or "name(arguments)"
local by_name = stand.child(call_list, "Call A Function")
local function_name = stand.child(by_name, "Function Name")
stand.check(stand.child(by_name, "Notice In Stand") == nil, "the Notice In Stand toggle isn't in Call A Function any more")
local call_button
for _, child in by_name.children do
    -- "Call" is also the divider above it
    if child.kind == "action" and stand.name_of(child) == "Call" then
        call_button = child
    end
end
local called = {}
Atdar.test_call = function(...) table.insert(called, table.pack(...)) return 7 end
stand.clear_logs()
function_name.on_change("test_call()", 0)
stand.click(call_button)
stand.frame()
stand.equal(#called, 1, "a name with empty brackets is found and called")
stand.equal(called[1].n, 0, "without arguments")
function_name.on_change("test_call(5, true)", 0)
stand.click(call_button)
stand.frame()
stand.equal(called[2] and called[2].n, 2, "the brackets' content is the arguments when the Arguments field is empty")
stand.equal(called[2] and called[2][1], 5, "the first one a number")
stand.check(not stand.find_log("not found"), "and nothing is reported as missing")
-- A table result: the table settings are made at the end, right under the Value list; a plain one takes them away
Atdar.test_table = function() return { 1, 2 } end
Atdar.test_plain_value = function() return 5 end
function_name.on_change("test_table", 0)
stand.click(call_button)
stand.frame()
local by_name_names = {}
for _, child in by_name.children do
    table.insert(by_name_names, stand.name_of(child))
end
stand.equal(table.concat(by_name_names, " | ", #by_name_names - 3),
    "Value (2) | Table Depth | Call Functions In Tables | Change Variable Values",
    "a table result: Table Depth, Call Functions In Tables and Change Variable Values are the last items, under the Value list")
function_name.on_change("test_plain_value", 0)
stand.click(call_button)
stand.frame()
stand.equal(stand.child(by_name, "Table Depth"), nil, "a plain result: the table settings are gone")
Atdar.test_table, Atdar.test_plain_value = nil, nil
function_name.on_change("", 0)

-- A loop draws what the function gave on screen (debug text), once a frame, like a module's loop
Atdar.test_loop = function() return 7 end
function_name.on_change("test_loop", 0)
stand.debug_texts = {}
stand.click(stand.child(by_name, "Loop"))
stand.frame()
stand.equal(stand.debug_texts[#stand.debug_texts], "test_loop -> 7", "Loop draws the name and what the function gave")
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 1, "once a frame, not twice")
Atdar.test_loop = function() return { 1, "a" } end
stand.frame()
stand.equal(stand.debug_texts[#stand.debug_texts], 'test_loop -> {1, "a"}', "a table unpacked")
Atdar.test_loop = function() end
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 0, "a call that gives nothing draws nothing")
stand.click(stand.child(by_name, "Loop"))
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 0, "stopped: nothing drawn")
-- Show Result On Screen and Show Call Time: each can be turned off
stand.equal(stand.child(call_list, "Show Result On Screen").value, true, "Show Result On Screen is on by default")
stand.equal(stand.child(call_list, "Show Call Time").value, true, "Show Call Time is on by default")
local timed = {}
_G.profiling = { tick = function(label_text, fn) table.insert(timed, label_text) fn() end }
Atdar.test_loop = function() return 7 end
stand.click(stand.child(by_name, "Loop"))
stand.frame()
stand.equal(timed[#timed], "test_loop()", "Show Call Time on: the call is timed, with its name")
stand.click(stand.child(call_list, "Show Call Time"))
stand.equal(Atdar.loader.load("ui/stand/core/call_display").show_time, false, "(the setting is shared: ui/stand/core/call_display)")
timed = {}
stand.frame()
stand.equal(#timed, 0, "off: not timed")
stand.click(stand.child(call_list, "Show Result On Screen"))
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts, 0, "Show Result On Screen off: nothing drawn")
stand.click(stand.child(call_list, "Show Result On Screen"))
stand.click(stand.child(call_list, "Show Call Time"))
stand.frame()
stand.equal(stand.debug_texts[#stand.debug_texts], "test_loop -> 7", "and on again: drawn")
-- Result Length On Screen: a long result is cut, so it doesn't run off the screen
local length = stand.child(call_list, "Result Length On Screen")
stand.check(length.kind == "slider" and length.value == 100, "Result Length On Screen is a slider, 100 by default")
Atdar.test_loop = function() return string.rep("x", 300) end
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts[#stand.debug_texts], 103, "a long result: 100 characters and ...")
stand.check(stand.debug_texts[#stand.debug_texts]:sub(-3) == "...", "cut with ...")
menu.set_value(length, 30)
stand.debug_texts = {}
stand.frame()
stand.equal(#stand.debug_texts[#stand.debug_texts], 33, "the slider sets how many")
Atdar.test_loop = function() return 7 end
stand.debug_texts = {}
stand.frame()
stand.equal(stand.debug_texts[#stand.debug_texts], "test_loop -> 7", "a short one isn't cut")
menu.set_value(length, 100)
stand.click(stand.child(by_name, "Loop"))
_G.profiling = nil
Atdar.test_loop = nil
function_name.on_change("", 0)

-- The setting is a switch that other lists read: it's on, can be turned off and on again
stand.click(stand.child(call_list, "Notice In Stand"))
stand.equal(stand.child(call_list, "Notice In Stand").value, false, "Notice In Stand can be turned off")
stand.click(stand.child(call_list, "Notice In Stand"))
function_name.on_change("", 0)

-- Functions: Add puts a path in the list. One that takes arguments is a list with a field for each, one that
-- takes none is a button; each is named with its number. Clear takes one out by it
local functions_list = stand.child(call_list, "Functions")
local add_function = stand.child(functions_list, "Add")
local clear_one = stand.child(functions_list, "Clear")
local clear_all = stand.child(functions_list, "Clear All")
stand.check(add_function and add_function.kind == "text_input" and clear_one and clear_one.kind == "text_input"
    and clear_all and clear_all.kind == "action", "Functions: Add and Clear are fields, Clear All a button")
local function added_names(): string
    local names = {}
    for i = 6, #functions_list.children do
        table.insert(names, stand.name_of(functions_list.children[i]))
    end
    return table.concat(names, " | ")
end
stand.equal(names_in(functions_list), "Add | Clear | Clear All | Save Functions | Functions", "Add, Clear, Clear All, the Functions divider; nothing under it at first")
stand.equal(functions_list.children[5].kind, "divider", "the Functions divider is under Save Functions")
local typed_calls = {}
Atdar.test_typed = function(count: int, name: string, ...) table.insert(typed_calls, table.pack(count, name, ...)) return count end
local plain_calls = 0
Atdar.test_plain = function(): int plain_calls += 1 return 1 end
NATIVE_TEST = { GET_THING = function(...) return 5 end }
stand.clear_logs()
add_function.on_change("test_missing", 0)
stand.check(stand.find_log("'test_missing' not found") and added_names() == "", "a path that leads nowhere isn't added")
add_function.on_change("test_typed(1, 2)", 0)
stand.equal(added_names(), "1: test_typed(count, name, ...)", "a function with parameters is added with its number and its parameters, brackets cut")
add_function.on_change("test_plain", 0)
add_function.on_change("NATIVE_TEST.GET_THING", 0)
stand.equal(added_names(), "1: test_typed(count, name, ...) | 2: test_plain: int | 3: GET_THING(...)",
    "a native's namespace is left out of the name; none: the return type written; ... for what's not said of the arguments")
stand.clear_logs()
add_function.on_change("test_plain", 0)
stand.check(stand.find_log("is in the list already") and #functions_list.children == 8, "the same path twice: once")
add_function.on_change("test_plain", 4)
add_function.on_change("", 0)
stand.equal(#functions_list.children, 8, "Stand putting the field back adds nothing, nor does an empty one")
local typed_item = stand.child(functions_list, "1: test_typed(count, name, ...)")
local plain_item = stand.child(functions_list, "2: test_plain: int")
stand.equal(plain_item.kind, "action", "a function without parameters is a button")
stand.equal(typed_item.kind, "list", "one with parameters is a list")
stand.equal(stand.child(functions_list, "3: GET_THING(...)").kind, "list", "a function of any arguments (...) is a list: Stand's natives say nothing of theirs")
stand.equal(stand.name_of(typed_item.children[1]) .. " | " .. stand.name_of(typed_item.children[2]), "count | Number",
    "its first parameter: a divider and a Number field, int being written")
stand.equal(stand.name_of(typed_item.children[3]) .. " | " .. stand.name_of(typed_item.children[4]), "name | Text", "the next: Text")
stand.equal(stand.name_of(typed_item.children[5]) .. " | " .. stand.name_of(typed_item.children[6]), "... | Arguments", "and the rest")
stand.check(stand.child(typed_item, "Call") ~= nil and stand.child(typed_item, "Loop") ~= nil, "then the panel: Call, Loop...")
stand.check(stand.child(typed_item, "Notice In Stand") == nil, "without the Notice In Stand toggle: it's in the settings")
stand.click(plain_item)
stand.frame()
stand.equal(plain_calls, 1, "the button calls the function")
menu.set_value(typed_item.children[2], "4")
menu.set_value(typed_item.children[4], "hello there")
menu.set_value(typed_item.children[6], "true, 9")
stand.click(stand.child(typed_item, "Call"))
stand.frame()
stand.check(#typed_calls == 1 and typed_calls[1][1] == 4 and typed_calls[1][2] == "hello there" and typed_calls[1][3] == true
    and typed_calls[1][4] == 9, "Call passes what's typed in the fields, in order")
menu.set_value(typed_item.children[2], "x")
stand.clear_logs()
stand.click(stand.child(typed_item, "Call"))
stand.frame()
stand.check(#typed_calls == 1 and stand.find_log("count: a whole number is needed"), "a wrong value is told, nothing is called")
menu.set_value(typed_item.children[2], "4")
-- Clear takes one out by its number, the others are numbered again and keep what's typed
stand.clear_logs()
clear_one.on_change("7", 0)
stand.check(stand.find_log("There's no function number '7'") and #functions_list.children == 8, "a number with no function is told")
clear_one.on_change("x", 0)
stand.equal(#functions_list.children, 8, "so is what isn't a number")
clear_one.on_change("1", 4)
stand.equal(#functions_list.children, 8, "Stand putting the field back takes nothing out")
menu.set_value(stand.child(functions_list, "3: GET_THING(...)").children[1], "5")
clear_one.on_change("1", 0)
stand.equal(added_names(), "1: test_plain: int | 2: GET_THING(...)", "Clear: the function gone, the others numbered again")
stand.equal(stand.child(functions_list, "2: GET_THING(...)").children[1].value, "5", "the others keep what's typed in their fields")
add_function.on_change("test_typed", 0)
stand.equal(added_names(), "1: test_plain: int | 2: GET_THING(...) | 3: test_typed(count, name, ...)", "one added again goes to the end")
-- Use Short Names: on, the last name only; off, the whole path is shown; the list follows at once
stand.equal(stand.child(call_list, "Use Short Names").value, true, "Use Short Names is on by default")
stand.click(stand.child(call_list, "Use Short Names"))
stand.equal(added_names(), "1: test_plain: int | 2: NATIVE_TEST.GET_THING(...) | 3: test_typed(count, name, ...)",
    "off: the native's whole path")
stand.check(stand.child(functions_list, "2: NATIVE_TEST.GET_THING(...)").children[1].value == "5", "the fields keep what's typed")
stand.click(stand.child(call_list, "Use Short Names"))
stand.equal(added_names(), "1: test_plain: int | 2: GET_THING(...) | 3: test_typed(count, name, ...)", "on again: the short name")
stand.click(clear_all)
stand.equal(names_in(functions_list), "Add | Clear | Clear All | Save Functions | Functions", "Clear All takes them all out")
Atdar.test_plain, NATIVE_TEST = nil, nil

-- Short names to call by: with Use Short Names on, a function is typed by the last part of its path
Atdar.test_deep = { sub = { unique_short_fn = function(): int return 7 end } }
TEST_SHORT = { another_short = function(...) end }
stand.clear_logs()
add_function.on_change("unique_short_fn", 0)
stand.equal(added_names(), "1: unique_short_fn: int", "Add takes a short name: it's found in Atdar")
add_function.on_change("another_short", 0)
stand.equal(added_names(), "1: unique_short_fn: int | 2: another_short(...)", "and in a global table")
stand.click(stand.child(call_list, "Use Short Names"))
stand.equal(added_names(), "1: test_deep.sub.unique_short_fn: int | 2: TEST_SHORT.another_short(...)",
    "they're kept with the full paths: off, those are shown")
stand.clear_logs()
add_function.on_change("unique_short_fn", 0)
stand.check(stand.find_log("'unique_short_fn' not found"), "with Use Short Names off a short name isn't looked for")
stand.click(stand.child(call_list, "Use Short Names"))
stand.click(clear_all)
-- The user's own short names, from store/<script>/user/call_function/short_names.json
local names_dir = $"{stand.store}AnitaDarin/user/call_function/"
io.makedirs(names_dir)
stand.write_file($"{names_dir}short_names.json", '{"mine": "test_deep.sub.unique_short_fn", "broken": "no.such.path", "bad": 5}')
stand.clear_logs()
add_function.on_change("mine", 0)
stand.equal(added_names(), "1: unique_short_fn: int", "a name from the file is the path it gives")
stand.check(stand.read_file($"{names_dir}short_names.json"):find("mine", 1, true), "(the file is only read)")
add_function.on_change("broken", 0)
stand.check(stand.find_log("'broken' not found") and added_names() == "1: unique_short_fn: int", "a name in the file whose path leads nowhere isn't added")
stand.click(stand.child(call_list, "Use Short Names"))
stand.click(clear_all)
stand.clear_logs()
add_function.on_change("mine", 0)
stand.check(stand.find_log("'mine' not found") and added_names() == "", "with Use Short Names off the file isn't used: only a path is")
stand.click(stand.child(call_list, "Use Short Names"))
stand.click(clear_all)
os.remove($"{names_dir}short_names.json")
Atdar.test_deep, TEST_SHORT = nil, nil

-- Save Functions: the list is kept in a file while it's on, and comes back when the menu is first made
local saved_path = $"{stand.store}AnitaDarin/user/call_function/saved_functions.json"
Atdar.test_saved = function(a: int) end
add_function.on_change("test_saved", 0)
stand.check(not io.exists(saved_path), "Save Functions is off: nothing is written")
stand.click(stand.child(functions_list, "Save Functions"))
stand.check(io.exists(saved_path) and stand.read_file(saved_path):find("test_saved", 1, true), "on: the list is written")
add_function.on_change("test_plain_saved", 0)
stand.check(not stand.read_file(saved_path):find("test_plain_saved", 1, true), "a path that isn't found isn't written")
clear_one.on_change("1", 0)
stand.check(not stand.read_file(saved_path):find("test_saved", 1, true), "Clear is written too")
add_function.on_change("test_saved", 0)
-- A fresh copy of the list's code, as at the next start: the functions come back from the file
package.loaded["AnitaDarin/ui/stand/script/call_function"] = nil
local fresh = Atdar.loader.load("ui/stand/script/call_function")
local fresh_handle = fresh.build(new MenuNode(stand.root))
stand.check(stand.find_item(fresh_handle, "1: test_saved(a)") ~= nil, "the functions come back from the file")
stand.equal(stand.find_item(fresh_handle, "Save Functions").value, true, "with Save Functions on")
stand.click(stand.child(functions_list, "Save Functions"))
stand.check(io.exists(saved_path) and stand.read_file(saved_path):find("test_saved", 1, true), "off: the file stays")
stand.check(stand.read_file(saved_path):find('"save": false', 1, true), "marked as not used")
-- At the next start with it off: the list isn't taken from the file, the switch is off
package.loaded["AnitaDarin/ui/stand/script/call_function"] = nil
local off_handle = Atdar.loader.load("ui/stand/script/call_function").build(new MenuNode(stand.root))
stand.equal(stand.find_item(off_handle, "Save Functions").value, false, "the next start: Save Functions is off")
stand.check(stand.find_item(off_handle, "test_saved") == nil, "and the file's list isn't used")
stand.click(clear_all)
Atdar.test_saved = nil

-- Made again (the section being built again): the functions added and what's typed in their fields stay
Atdar.test_typed = function(count: int, name: string) end
add_function.on_change("test_typed", 0)
menu.set_value(stand.child(functions_list, "1: test_typed(count, name)").children[2], "6")
rebuild()
debug_list = find("Debug")
debug_only = { debug_list.children[8], debug_list.children[9], debug_list.children[10], debug_list.children[11] }
call_list = stand.find_item(debug_list, "Call Function")
functions_list = stand.child(call_list, "Functions")
local rebuilt_item = stand.child(functions_list, "1: test_typed(count, name)")
stand.check(rebuilt_item ~= nil and rebuilt_item.children[2].value == "6", "rebuilt: the function and the text in its field are kept")
stand.click(stand.child(functions_list, "Clear All"))
Atdar.test_typed = nil

-- The registry of short names (core/call_function/short_name.json): a name gives the path, params and returns
-- give the argument fields and the return type of a function that says nothing of its own
-- (the section was made again above: its items are the new ones)
add_function = stand.child(functions_list, "Add")
clear_all = stand.child(functions_list, "Clear All")
local registry_dir = $"{stand.store}AnitaDarin/core/call_function/"
io.makedirs(registry_dir)
stand.write_file($"{registry_dir}short_name.json", '{"reg_one": {"path": "test_reg_fn", "params": [{"name": "a", "type": "int", "default": "3"}], "returns": "int"},'
    .. ' "reg_none": {"path": "test_reg_none", "params": [], "returns": "int"},'
    .. ' "reg_bad": {"path": "test_reg_bad", "params": [{"include_last_vehicle": "x", "type": "bool"}], "returns": "int"},'
    .. ' "reg_no_path": {"params": [], "returns": "int"}}')
Atdar.test_reg_fn = function(...) end
Atdar.test_reg_none = function(...) end
Atdar.test_reg_bad = function(...) end
stand.click(clear_all)
stand.clear_logs()
add_function.on_change("reg_one", 0)
stand.equal(added_names(), "1: test_reg_fn(a): int", "a registry name: its path, the params and the return type from the registry")
stand.equal(stand.child(functions_list, "1: test_reg_fn(a): int").children[2].value, "3", "the field starts with the registry's default")
stand.equal(stand.name_of(stand.child(functions_list, "1: test_reg_fn(a): int").children[2]), "Number", "named by the registry's type")
add_function.on_change("reg_none", 0)
stand.equal(stand.child(functions_list, "2: test_reg_none: int").kind, "action", "params [] in the registry: a function that takes none is a button")
add_function.on_change("reg_bad", 0)
stand.check(stand.find_log("reg_bad (short_name.json): parameter 1 has no"), "a parameter without a name is told")
stand.check(stand.child(functions_list, "3: test_reg_bad(...)") ~= nil, "and the registry's params aren't used for it")
add_function.on_change("reg_no_path", 0)
stand.check(stand.find_log("'reg_no_path' not found"), "an entry without a path isn't a short name")
stand.click(clear_all)
os.remove($"{registry_dir}short_name.json")
Atdar.test_reg_fn, Atdar.test_reg_none, Atdar.test_reg_bad = nil, nil, nil

-- The Stand API file: its place is core/call_function/stand_api.json; read as it's written
local registry_logic = Atdar.loader.load("ui/logic/stand/script/call_function_registry")
stand.equal(next(registry_logic.stand_api()), nil, "stand_api: no file in the store - empty")
local api_dir = $"{stand.store}AnitaDarin/core/call_function/"
io.makedirs(api_dir)
stand.write_file($"{api_dir}stand_api.json", '{"util.toast": {"params": [{"name": "text", "type": "string"}], "returns": "void"}}')
stand.equal(registry_logic.stand_api()["util.toast"].returns, "void", "stand_api: the file as written")
stand.write_file($"{api_dir}stand_api.json", "{broken")
stand.equal(next(registry_logic.stand_api()), nil, "stand_api: a damaged file - empty")
os.remove($"{api_dir}stand_api.json")

-- ─── Files Editor: the JSON files of Call Function as a tree ─────────────────

local editor_core = $"{stand.store}AnitaDarin/core/call_function/"
local editor_user = $"{stand.store}AnitaDarin/user/call_function/"
io.makedirs(editor_core)
io.makedirs(editor_user)
stand.write_file($"{editor_core}short_name.json", '{"a": {"path": "x", "params": []}}')
stand.write_file($"{editor_core}stand_api.json", '{}')
os.remove($"{editor_user}saved_functions.json")
os.remove($"{editor_user}saved_functions.json.bak")

-- A store with no user/call_function folder yet: Stand's list_files fails on a missing folder, the list must not
local real_store = Atdar.filesystem.paths.store
local bare_store = stand.tmpdir("editor_bare_store") .. "AnitaDarin/"
io.makedirs($"{bare_store}core/call_function")
stand.write_file($"{bare_store}core/call_function/short_name.json", "{}")
Atdar.filesystem.paths.store = bare_store
local bare_files = Atdar.loader.load("ui/logic/stand/script/call_function_files").list()
Atdar.filesystem.paths.store = real_store
stand.check(#bare_files == 1 and bare_files[1].id == "core/call_function/short_name.json" and bare_files[1].protected,
    "no user/call_function folder: the core files are listed, nothing fails")

local editor = stand.child(call_list, "Files Editor")
stand.equal(#editor.children, 0, "Files Editor: nothing in it until it's opened")
stand.click(editor)
stand.equal(names_in(editor), "Create File | Files | core/short_name.json | core/stand_api.json",
    "opened: Create File, the Files divider, a list per file (core first)")
stand.equal(stand.child(editor, "Files").kind, "divider", "Files is a divider")

-- A protected file: no Delete File
local short_name_list = stand.child(editor, "core/short_name.json")
stand.click(short_name_list)
stand.check(stand.child(short_name_list, "Protected file: it can't be deleted") ~= nil and stand.child(short_name_list, "Delete File") == nil,
    "short_name.json can't be deleted: no Delete File, it says it's protected")
stand.check(stand.child(stand.child(editor, "core/stand_api.json"), "Delete File") == nil, "nor stand_api.json")
local files_logic = Atdar.loader.load("ui/logic/stand/script/call_function_files")
local refused, refused_why = files_logic.delete("core/call_function/short_name.json")
stand.check(refused == false and refused_why == "protected" and io.exists($"{editor_core}short_name.json"), "the logic refuses to delete short_name.json too, not only the menu")
stand.equal(select(2, files_logic.delete("core/call_function/stand_api.json")), "protected", "and stand_api.json")
stand.equal(names_in(short_name_list), "Protected file: it can't be deleted | Add Value | Add Table | Remove | a (2)",
    "the file's table: Add Value, Add Table, Remove, then the entries; a table is a list with how many it has")

-- Values: added under a name, changed, taken away; every change is written at once
local function stored(name: string): string
    return stand.read_file($"{editor_core}{name}")
end
stand.child(short_name_list, "Add Value").on_change('speed = 5', 0)
stand.check(stored("short_name.json"):find('"speed": 5', 1, true), "name = value: written to the file at once")
stand.equal(stand.child(short_name_list, "speed").value, "5", "and shown as a field with the value")
stand.child(short_name_list, "Add Value").on_change('kind = int', 0)
stand.equal(stand.child(short_name_list, "kind").value, '"int"', "a bare word is text, shown in quotes (also one Lua knows: string, table)")
stand.child(short_name_list, "Add Value").on_change('type = string', 0)
stand.equal(stand.child(short_name_list, "type").value, '"string"', "a name of Lua's own is text too")
stand.child(short_name_list, "speed").on_change('true', 0)
stand.check(stored("short_name.json"):find('"speed": true', 1, true), "a field changed: written")
stand.clear_logs()
stand.child(short_name_list, "speed").on_change('util', 0)
stand.check(stored("short_name.json"):find('"speed": "util"', 1, true), "a bare word is text, also util, which Lua knows")
stand.child(short_name_list, "speed").on_change('5, 6', 0)
stand.check(stand.find_log("One value is needed"), "two values are refused")
stand.child(short_name_list, "speed").on_change('v3.new(1, 2, 3)', 0)
stand.check(stand.find_log("Only text, a number, true or false"), "a value that is none of those is refused: tables are made with Add Table")
stand.child(short_name_list, "speed").on_change('nil', 0)
stand.equal(stand.child(short_name_list, "speed"), nil, "nil takes the entry away")
stand.check(not stored("short_name.json"):find('"speed"', 1, true), "and it's out of the file")

-- Tables: made, opened, filled; a value alone is added at the end of a list
stand.child(short_name_list, "Add Table").on_change('params', 0)
local params_list = stand.child(short_name_list, "params (0)")
stand.check(params_list ~= nil and params_list.kind == "list", "Add Table: a table under the name, a list to open")
stand.click(params_list)
stand.equal(names_in(params_list), "Add Value | Add Table | Remove | Empty", "opened: the same controls, and Empty for a table with nothing in it")
