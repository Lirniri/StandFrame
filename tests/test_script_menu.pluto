stand.equal(stand.name_of(language), "Die Sprache: Deutsch", "Reload Translations: the edit shows")
-- Translation Progress: each translation's share as a notice, the strings left in Stand's log
stand.clear_logs()
stand.click(stand.child(language_list, "Translation Progress"))
local progress_notice = stand.toasts[#stand.toasts]
stand.check(progress_notice:find("Deutsch: %d+%% %(1 of %d+%)") ~= nil, $"one German string translated ({progress_notice})")
stand.check(progress_notice:find(russian_name, 1, true) ~= nil, "Russian too")
