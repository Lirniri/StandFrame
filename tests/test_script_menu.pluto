-- ─── Language ────────────────────────────────────────────────────────────────

local language_list = stand.child(settings(), "Language")
stand.equal(names_in(language_list), "Language: Auto (Stand) | Translation | Create Translation | Translation Progress"
    .. " | Reload Translations"
    .. " | Open Translation Folder", "Language: the picker at the top, then the Translation divider and its items")
local language = stand.find_item(language_list, "Language: ")
stand.equal(language.kind, "list_action", "the language is picked from a list action")
-- The picker's options as shown: labels in Stand's language, names as they are
local function options_of(it): string
    local names = {}
    for _, option in ipairs(it.options) do
        table.insert(names, type(option) == "number" and lang.get_localised(option) or option)
    end
    return table.concat(names, " | ")
end
local function option_index(it, name: string): ?int
    for i, option in ipairs(it.options) do
        local shown = type(option) == "number" and lang.get_localised(option) or option
        if shown:find(name, 1, true) then
            return i
        end
    end
    return nil
end
-- The names are the files' language_name, whatever they're set to
local function language_name(file)
    return stand.read_file($"{base}{file}"):match('"language_name"%s*:%s*"([^"]+)"')
end
local english_name, russian_name = language_name("en-us.json"), language_name("ru-ru.json")
stand.equal(options_of(language), $"Auto (Stand) | {english_name} | {russian_name}", "languages: Auto, English first, then the others")

