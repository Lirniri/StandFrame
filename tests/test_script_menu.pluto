stand.click(from, option_index(from, russian_name))
stand.equal(stand.name_of(from), $"Translate From: {russian_name}", "Translate From shows the language picked")
menu.set_value(code_field, "uk-ua")
menu.set_value(stand.child(create, "Language Name"), "")
stand.click(stand.child(create, "Create"))
local ukrainian = stand.read_file($"{base}uk-ua.json")
stand.check(ukrainian and ukrainian:find('"Язык: %%s"'), "translated from Russian: the Russian text to translate")
stand.check(ukrainian and ukrainian:find('"language_name"%s*:%s*"uk%-ua"'), "no name given: the code is the name")

-- Reload Translations: an edited file shows without restarting
stand.language = "de"
stand.frame()
stand.click(language, option_index(language, "Deutsch"))
stand.equal(stand.name_of(language), "Sprache: Deutsch", "the German file's text is shown")
