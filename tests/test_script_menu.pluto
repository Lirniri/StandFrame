stand.equal(profile.get("auto_copy_menu"), "AnitaDarin", "Copy Menu To Core is set from Load Menu")
stand.click(stand.find_item(find("Command Box"), "Separator"), 2)
stand.equal(profile.get("command_box_separator"), "_", "Separator is set from Command Box")

-- ─── Reset To Defaults: a second click within 5 seconds ──────────────────────

local main_entry = entry("main (active)")
local reset = stand.child(main_entry, "Reset To Defaults")
profile.set("log_name", "display")
profile.set("command_box_separator", "")
stand.clear_logs()
stand.click(reset)
stand.equal(profile.get("log_name"), "display", "the first click resets nothing")
stand.equal(stand.name_of(reset), "Click Again To Reset", "it asks for a second click")
stand.check(stand.find_log("within 5 seconds"), "and says what would happen")
main_entry.on_back()
stand.frame()
stand.equal(stand.name_of(reset), "Reset To Defaults", "going back out of the list cancels it")
stand.click(reset)
stand.click(reset)
stand.equal(profile.get("log_name"), profile.default("log_name"), "the second click resets the active profile")
stand.equal(profile.get("command_box_separator"), profile.default("command_box_separator"), "every value")
local log_name_shown = profile.default("log_name") == "display" and "Display Name" or "Short Name"
stand.equal(stand.name_of(stand.find_item(find("Debug"), "Name In Logs")), $"Name In Logs: {log_name_shown}", "and the menu shows it")
stand.check(profile.is_dirty(), "kept on Save, like any change")

-- ─── Rename Script: no warning while the script stops ────────────────────────

local warnings = 0
local real_warning = menu.show_warning
menu.show_warning = function() warnings += 1 end
local rename_field = stand.find_item(settings(), "Rename Script")
menu.set_value(rename_field, "Other")
stand.equal(warnings, 1, "a new name is asked about")
menu.set_value(rename_field, "AnitaDarin")
stand.equal(warnings, 1, "the current name isn't asked about")

-- A folder held open: the message says so and which one
local script_installer = Atdar.loader.load("core/installer")
local real_rename = script_installer.rename
local counting_warning = menu.show_warning
script_installer.rename = function() return false, "reason", "lib\\AnitaDarin" end
menu.show_warning = function(_, _, _, proceed) proceed() end
stand.clear_logs()
menu.set_value(rename_field, "Busy")
stand.check(stand.find_log("an open folder is keeping the script from being renamed (lib\\AnitaDarin)"), "a held folder is named in the message")
script_installer.rename = real_rename
menu.show_warning = counting_warning

stand.stop()
menu.set_value(rename_field, "Third")
stand.equal(warnings, 1, "no warning while the script stops")
menu.show_warning = real_warning

-- Update's settings are kept in the profile already (last: they leave it changed)
local update_list = find("Update")
local auto_update = update_list.children[5]
stand.equal(auto_update.value, profile.get("auto_update") == true, "Update Automatically shows the profile's value")
local auto_before = profile.get("auto_update")
stand.click(auto_update)
stand.equal(profile.get("auto_update"), not auto_before, "and switching it saves it")
stand.click(auto_update)
local check_days = update_list.children[6]
stand.equal(check_days.kind, "click_slider", "Check For Updates Every is a click slider")
stand.equal(check_days.value, profile.get("update_check_days"), "showing the profile's days")
local days_before = profile.get("update_check_days")
stand.click(check_days, 3)
stand.equal(profile.get("update_check_days"), 3, "a click saves the days picked")
stand.check(stand.toasts[#stand.toasts]:find("every 3 days", 1, true), "and says so")
stand.click(check_days, 0)
stand.check(stand.toasts[#stand.toasts]:find("won't be checked", 1, true), "0: never")
profile.set("update_check_days", days_before)
local branch_item = update_list.children[2]
stand.equal(stand.name_of(branch_item), "Update Branch: main", "Update Branch shows the profile's branch")
stand.click(branch_item, 2)
stand.equal(profile.get("update_branch"), "experiment", "picking experiment saves it")
stand.equal(stand.name_of(branch_item), "Update Branch: experiment", "and the item shows it")
stand.check(stand.toasts[#stand.toasts]:find("from the experiment branch", 1, true), "and says so")
stand.click(branch_item, 1)
stand.equal(profile.get("update_branch"), "main", "main back")

-- ─── User Commands: a name that runs other commands ──────────────────────────

local user_dir = $"{stand.store}AnitaDarin\\commands\\user\\"
local user_list = stand.child(find("Command Box"), "User Commands")
stand.equal(names_in(user_list), "Prefix | Separator: None | Create | Remove | Commands | settingsatdar",
    "User Commands: prefix, separator, Create, Remove, then the commands - the example made the first time")
-- The example: settingsatdar opens the script's settings through their command
local example = stand.child(user_list, "settingsatdar")
stand.equal(stand.child(example, "Commands").value, "atdar.settings", "the example runs the settings' command (the dot by default)")
stand.check(stand.read_file($"{user_dir}settingsatdar.json"), "and is kept in a file like any other")
stand.triggered = {}
stand.click(example.children[1])
stand.equal(stand.triggered[1], "atdar.settings", "running it gives the settings' command to the command box")
stand.equal(stand.name_of(example.children[1]), "Settings", "its Run is named after what it runs: the Settings item")
-- Create: the name typed, cleaned; an empty command below
menu.set_value(stand.child(user_list, "Create"), "Ready Set!")
stand.check(io.exists($"{user_dir}readyset.json"), "Create makes commands/user/<name>.json (the name cleaned)")
local ready = stand.child(user_list, "readyset")
stand.equal(names_in(ready), "readyset | Commands | Description",
    "a command's list: Run, named after the command it is, then Commands and Description")
local run = ready.children[1]
-- Run reads "Run" with the cursor on it (entering the list puts it there), the command again off it
stand.hover(run)
stand.equal(stand.name_of(run), "Run", "with the cursor on it: Run")
stand.leave(run)
stand.equal(stand.name_of(run), "readyset", "the cursor off it: the command's name")
stand.hover(run)
stand.back(ready)
stand.equal(stand.name_of(run), "readyset", "going back out of the list: the command's name too")
stand.equal(table.concat(run.commands, ","), "readyset", "Run is the command itself, named as typed (no prefix by default)")
stand.equal(stand.find_item(stand.child(find("Command Box"), "Base Commands"), "readyset"), nil, "it isn't in Base Commands")
stand.triggered = {}
stand.clear_logs()
stand.click(run)
stand.equal(#stand.triggered, 0, "with no Commands it runs nothing")
stand.check(stand.find_log("runs nothing yet"), "and says so")
-- Commands: separated by ;, kept in the file, run through the command box
menu.set_value(stand.child(ready, "Commands"), "godmode on; ; tpwaypoint ")
stand.check(stand.read_file($"{user_dir}readyset.json"):find('"tpwaypoint"', 1, true), "Commands are kept in its file")
stand.click(run)
stand.equal(stand.triggered[#stand.triggered], "godmode on; tpwaypoint", "Run gives them to the command box, empty ones dropped")
stand.equal(stand.name_of(run), "godmode on, tpwaypoint", "commands no item answers to: Run is named after them as written")
menu.set_value(stand.child(ready, "Description"), "Ready for anything")
stand.check(run.help:find("Ready for anything", 1, true) and run.help:find("godmode on; tpwaypoint", 1, true),
    "Run's help: the description and what it runs")
-- A command running itself is stopped
menu.set_value(stand.child(ready, "Commands"), "readyset")
local real_trigger = menu.trigger_commands
menu.trigger_commands = function(input)
    table.insert(stand.triggered, input)
    stand.click(stand.by_command(input))
end
stand.clear_logs()
stand.click(run)
stand.check(stand.find_log("runs itself over and over"), "a command running itself is stopped")
menu.trigger_commands = real_trigger
-- The same name again, or a command Stand has already: refused
stand.clear_logs()
menu.set_value(stand.child(user_list, "Create"), "readyset")
stand.check(stand.find_log("There's a command readyset already"), "the same name again is refused")
-- The prefix and separator rename it right away
menu.set_value(stand.child(user_list, "Prefix"), "my")
stand.check(table.concat(stand.child(user_list, "readyset").children[1].commands, ","):find("myreadyset", 1, true),
    "a prefix given renames it")
stand.click(stand.find_item(user_list, "Separator: "), 2)
stand.check(table.concat(stand.child(user_list, "readyset").children[1].commands, ","):find("my_readyset", 1, true),
    "a separator too")
-- Remove: picked, gone with its file
local remove = stand.child(user_list, "Remove")
stand.click(remove, 1)
stand.check(not io.exists($"{user_dir}readyset.json") and stand.child(user_list, "readyset") == nil,
    "Remove takes the command and its file away")
stand.click(remove, 1)
stand.check(stand.child(user_list, "settingsatdar") == nil, "the example can be removed too")
stand.check(stand.find_item(user_list, "No commands yet"), "none left: says so")
rebuild()
user_list = stand.child(find("Command Box"), "User Commands")
stand.check(stand.find_item(user_list, "No commands yet"), "the example removed isn't made again (the folder is there)")

stand.finish()
