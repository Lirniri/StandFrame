stand.language = "en"
stand.frame()
stand.click(stand.child(language_list, "Open Translation Folder"))
local opened_folder = stand.toasts[#stand.toasts]
stand.check(opened_folder:find("^open_folder ") and opened_folder:find("AnitaDarin\\base\\language\\", 1, true),
    $"Open Translation Folder opens the script's language folder ({opened_folder})")
