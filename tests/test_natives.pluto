-- natives: functions with the handle (id, name) first, on fake natives: entity, ped, vehicle, player,
-- hud.blip, and the hud_color / feed_picture tables
local stand = require("stand")
stand.boot()
Atdar.util = Atdar.loader.load("utils/util")
Atdar.util.game = Atdar.loader.load("utils/util/game")
Atdar.natives = Atdar.loader.auto({}, "natives")
local entity = Atdar.natives.entity
local ped = Atdar.natives.entity.ped
local vehicle = Atdar.natives.entity.vehicle
local player = Atdar.natives.player
local user = Atdar.util.game.players.user

-- A fake game: the local player is id 0 with ped 100
local game = { player = 0, ped = 100, health = {}, max_health = {}, dead = {}, in_vehicle = {}, calls = {} }
local function call(name, ...) table.insert(game.calls, table.concat({ name, ... }, " ")) end
local function last_call() return game.calls[#game.calls] end
_G.PLAYER = {
    PLAYER_ID = || -> game.player,
    PLAYER_PED_ID = || -> game.ped,
    GET_PLAYER_PED_SCRIPT_INDEX = |id| -> id == game.player ? game.ped : 200 + id,
    SET_PLAYER_SPRINT = |id, on| -> call("SET_PLAYER_SPRINT", id, tostring(on)),
    SET_PLAYER_INVINCIBLE = |id, on| -> call("SET_PLAYER_INVINCIBLE", id, tostring(on)),
    GET_PLAYER_MAX_ARMOUR = || -> 100,
    GET_MAX_WANTED_LEVEL = function(...) call("GET_MAX_WANTED_LEVEL", select("#", ...)) return 5 end,
}
_G.ENTITY = {
    DOES_ENTITY_EXIST = |h| -> h ~= -1,
    IS_ENTITY_A_PED = |h| -> h >= 100 and h < 500,
    IS_ENTITY_A_VEHICLE = |h| -> h >= 500,
    IS_ENTITY_DEAD = |h| -> game.dead[h] == true,
    GET_ENTITY_HEALTH = |h| -> game.health[h] or 0,
    GET_ENTITY_MAX_HEALTH = |h| -> game.max_health[h] or 200,
    SET_ENTITY_HEALTH = function(h, value) game.health[h] = value end,
}
_G.PED = {
    IS_PED_IN_ANY_VEHICLE = |h| -> game.in_vehicle[h] ~= nil,
    GET_VEHICLE_PED_IS_IN = |h| -> game.in_vehicle[h] or 0,
    SET_PED_ARMOUR = |h, value| -> call("SET_PED_ARMOUR", h, value),
    SET_PED_CONFIG_FLAG = |h, flag, on| -> call("SET_PED_CONFIG_FLAG", h, flag, tostring(on)),
    GET_PED_PARACHUTE_LANDING_TYPE = || -> 2,
}
_G.WEAPON = { GIVE_WEAPON_TO_PED = |h, hash, ammo| -> call("GIVE_WEAPON_TO_PED", h, hash, ammo) }
_G.NETWORK = {
    NETWORK_DOES_NETWORK_ID_EXIST = |net| -> net == 9,
    NET_TO_ENT = |net| -> 500 + net,
    NETWORK_EXPLODE_VEHICLE = |h, _, _, net| -> call("NETWORK_EXPLODE_VEHICLE", h, net),
}
_G.VEHICLE = { EXPLODE_VEHICLE = |h| -> call("EXPLODE_VEHICLE", h) }
_G.players = { user_ped = || -> game.ped }
_G.v3 = { new = |v| -> v }

-- ─── entity ──────────────────────────────────────────────────────────────────

game.health[100] = 50
entity.set_health(100)
stand.equal(game.health[100], 200, "entity.set_health(handle) with no value restores the maximum")
entity.set_health(100, 80)
stand.equal(game.health[100], 80, "and sets a given value")
stand.equal(entity.from_net_id(9), 509, "from_net_id gives the entity behind a network id")
stand.equal(entity.from_net_id(1), nil, "and nil for one that doesn't exist")

-- ─── ped (and its parts: flags, weapon, parachute) ───────────────────────────

stand.check(ped.is_ped(100) and not ped.is_ped(600), "ped.is_ped")
ped.set_scuba(100, true)
stand.equal(last_call(), $"SET_PED_CONFIG_FLAG 100 {ped.flags.CONFIG.IS_SCUBA} true", "set_scuba goes through ped.flags")
ped.weapon.give(100, "WEAPON_PISTOL", 30)
stand.equal(last_call(), $"GIVE_WEAPON_TO_PED 100 {util.joaat('WEAPON_PISTOL')} 30", "weapon.give takes a weapon name")
ped.weapon.give(100, 12345)
stand.equal(last_call(), "GIVE_WEAPON_TO_PED 100 12345 1", "and a hash as it is")
stand.equal(ped.parachute.get_landing_type(100), 2, "parachute.get_landing_type (was get_lading_type)")
game.in_vehicle[100] = 501
stand.check(ped.vehicle.is_in_any(100) and ped.vehicle.get(100) == 501, "ped.vehicle")
game.in_vehicle[100] = nil

-- ─── vehicle ─────────────────────────────────────────────────────────────────

stand.check(vehicle.does_exist(501) and not vehicle.does_exist(100), "vehicle.does_exist: an existing entity that's a vehicle")
-- create: with is_network the game's native and its flags, without it Stand's entities.create_vehicle
VEHICLE.CREATE_VEHICLE = function(model, x, y, z, heading, network, host, p7)
    call("CREATE_VEHICLE", model, x, y, z, heading, tostring(network), tostring(host), tostring(p7))
    return 600
end
_G.entities = _G.entities or {}
entities.create_vehicle = function(model, pos, heading)
    call("create_vehicle", model, pos.x, pos.y, pos.z, heading)
    return 601
end
_G.v3 = { new = function(x, y, z) if type(x) == "table" then return x end return { x = x, y = y, z = z } end }
stand.equal(vehicle.create("adder", 1, 2, 3, 90), 601, "create without is_network: Stand's entities.create_vehicle")
stand.equal(last_call(), $"create_vehicle {util.joaat('adder')} 1 2 3 90", "with the model's hash and the position")
stand.equal(vehicle.create(12345, 1, 2, 3, 90, true), 600, "create with is_network: the game's CREATE_VEHICLE")
stand.equal(last_call(), "CREATE_VEHICLE 12345 1 2 3 90 true false false", "the flags not given are false")
stand.equal(vehicle.create("adder", 1, 2, 3, 90, false, true, true), 600, "every flag given")
stand.equal(last_call(), $"CREATE_VEHICLE {util.joaat('adder')} 1 2 3 90 false true true", "passed as they are")

vehicle.explode({ vehicle = 501, net_id = 9 })
stand.equal(last_call(), "NETWORK_EXPLODE_VEHICLE 501 9", "explode with a net id is networked")
vehicle.explode({ vehicle = 501 })
stand.equal(last_call(), "EXPLODE_VEHICLE 501", "explode without one is local")

-- ─── player ──────────────────────────────────────────────────────────────────

stand.equal(player.get_id(), 0, "player.get_id: the local player")
stand.equal(player.get_ped_id(), 100, "get_ped_id(): the local player's ped")
stand.equal(player.get_ped_id(3), 203, "get_ped_id(id): another player's")
player.movement.set_sprint(0, false)
stand.equal(last_call(), "SET_PLAYER_SPRINT 0 false", "player.movement")
player.set_godmode(0, true)
stand.equal(last_call(), "SET_PLAYER_INVINCIBLE 0 true", "set_godmode")
stand.equal(player.wanted_level.get_max(), 5, "wanted_level.get_max")
stand.equal(last_call(), "GET_MAX_WANTED_LEVEL 0", "with no arguments: the native takes none")

game.health[100] = 10
game.dead[100] = true
user.restore_health()
stand.equal(game.health[100], 10, "user.restore_health leaves a dead ped alone")
game.dead[100] = nil
user.restore_health()
stand.equal(game.health[100], 200, "and restores a living one")
user.restore_armor()
stand.equal(last_call(), "SET_PED_ARMOUR 100 100", "user.restore_armor: the player's max armor")

-- ─── hud.blip and the waypoint ───────────────────────────────────────────────

local blip = Atdar.natives.visual.hud.blip
local blips = { [1] = 8, [2] = 8, [3] = 1 }
local waypoint_blip = 0
local next_index = {}
_G.HUD = {
    DOES_BLIP_EXIST = |h| -> blips[h] ~= nil,
    GET_WAYPOINT_BLIP_ENUM_ID = || -> 8,
    GET_FIRST_BLIP_INFO_ID = function(sprite)
        if sprite == 8 and waypoint_blip ~= 0 then
            return waypoint_blip
        end
        next_index[sprite] = 0
        for h = 1, 3 do
            if blips[h] == sprite then
                next_index[sprite] = h
                return h
            end
        end
        return 0
    end,
    GET_NEXT_BLIP_INFO_ID = function(sprite)
        for h = next_index[sprite] + 1, 3 do
            if blips[h] == sprite then
                next_index[sprite] = h
                return h
            end
        end
        return 0
    end,
    GET_BLIP_FROM_ENTITY = |h| -> h == 501 ? 3 : 0,
    GET_BLIP_COLOUR = |h| -> h * 10,
    GET_BLIP_HUD_COLOUR = |h| -> h * 100,
    GET_BLIP_INFO_ID_COORD = |h| -> { x = h, y = 0, z = 0 },
    IS_WAYPOINT_ACTIVE = || -> waypoint_blip ~= 0,
}
stand.equal(#blip.get_all(8), 2, "blip.get_all(sprite): every blip with it")
stand.equal(blip.get_color(1), 10, "get_color")
stand.equal(blip.get_color(1, true), 100, "get_color(blip, true): the HUD colour")
stand.equal(blip.get_from_entity(501), 3, "get_from_entity")
stand.equal(blip.get_from_entity(42), nil, "and nil for an entity without one")
waypoint_blip = 2
stand.equal(Atdar.natives.visual.hud.waypoint.get_blip(), 2, "waypoint.get_blip")
stand.equal(Atdar.natives.world.map.waypoint.get_coords().x, 2, "world.map.waypoint.get_coords")
waypoint_blip = 0

-- ─── HUD colours and feed pictures: tables ───────────────────────────────────

local hud_color = Atdar.natives.visual.color.hud
stand.equal(hud_color.RED, 6, "hud_color.RED is the index natives take")
stand.equal(hud_color.SCRIPT_VARIABLE, 128, "the script slot the feed background uses")
stand.equal(hud_color.name_of(9), "BLUE", "name_of(index)")
stand.equal(hud_color.name_of(999), nil, "name_of an unknown index is nil")
local red = hud_color.default(hud_color.RED)
stand.check(red.r == 224 and red.g == 50 and red.b == 50 and red.a == 255, "default(index): the RGBA from hudcolor.dat")
red.r = 0
stand.equal(hud_color.default(hud_color.RED).r, 224, "default() gives a copy")
local colors = hud_color.list()
stand.check(#colors == 235 and colors[1].index == 0 and colors[235].index == 234, "list(): every colour, indexes 0 - 234")

local feed_picture = Atdar.natives.visual.feed_picture
stand.equal(feed_picture.LESTER, "CHAR_LESTER", "feed_picture.LESTER is the full name")
stand.check(feed_picture.is_known("CHAR_SOCIAL_CLUB") and not feed_picture.is_known("CHAR_NOPE"), "is_known(name)")
local pictures = feed_picture.list()
local unique = {}
for _, name in pictures do unique[name] = true end
local count = 0
for _ in pairs(unique) do count += 1 end
stand.check(#pictures == 168 and count == 168, "list(): 168 pictures, no repeats")
stand.equal(feed_picture.ACTING_UP, "CHAR_ACTING_UP", "CHAR_ACTING_UP is there")
stand.equal(feed_picture.title("CHAR_SOCIAL_CLUB"), "Social Club", "title(): a readable name")
stand.equal(feed_picture.title("CHAR_CALL911"), "Call911", "title() keeps digits")

stand.finish()
