-- utils/menu and utils/color: menu items Stand doesn't have ready-made, colour conversions
local stand = require("stand")
stand.boot()
local ui = Atdar.loader.load("utils/menu")
local color = Atdar.loader.load("utils/color")

-- color(): Stand's colour submenu without opacity
local picked = nil
local item = ui.color(stand.root, "Background Color", { "atdarbg" }, "help", { r = 0.5, g = 0.25, b = 0 },
    function(colour) picked = colour end)
stand.equal(item.kind, "colour", "color() makes a Stand colour command")
stand.equal(item.transparency, false, "without transparency: no Opacity part")
stand.equal(item.value.r, 0.5, "the default colour")
stand.equal(item.value.a, 1.0, "fully opaque")
stand.equal(item.commands[1], "atdarbg", "command names")
item.on_change({ r = 1, g = 0, b = 0, a = 1 }, 0)
stand.equal(picked and picked.r, 1, "on_change gets the picked colour")
local see_through = ui.color(stand.root, "Glass", {}, "", { r = 0, g = 0, b = 0, a = 0.5 }, || -> nil, true)
stand.equal(see_through.transparency, true, "transparency on: with Opacity, as in Stand")
stand.equal(see_through.value.a, 0.5, "and the default's opacity is kept")

-- spoiler(): the value hidden until a click, hidden again by the next one
local spoiler = ui.spoiler(stand.root, "AnitaDarin", "Hello!")
stand.equal(stand.name_of(spoiler), "AnitaDarin: Hidden", "spoiler: hidden at first")
stand.click(spoiler)
stand.equal(stand.name_of(spoiler), "AnitaDarin: Hello!", "a click shows the value")
stand.click(spoiler)
stand.equal(stand.name_of(spoiler), "AnitaDarin: Hidden", "another click hides it again")
local custom = ui.spoiler(stand.root, "Key", "123", "***")
stand.equal(stand.name_of(custom), "Key: ***", "spoiler: own text in place of the value")

-- utils/color: hex <-> Stand (0.0 - 1.0) <-> game (0 - 255)
local orange = color.from_hex("FF8000")
stand.check(orange.r == 1 and orange.b == 0 and orange.a == 1, "from_hex: RRGGBB")
stand.equal(color.from_hex("#ff800080").a, 128 / 255, "from_hex: #, lower case and alpha")
stand.equal(color.from_hex(""), nil, "from_hex: empty is nil")
stand.equal(color.from_hex("FF80"), nil, "from_hex: too short is nil")
stand.equal(color.from_hex("GG8000"), nil, "from_hex: not hex is nil")
stand.equal(color.to_hex(orange), "FF8000", "to_hex")
stand.equal(color.to_hex({ r = 0, g = 0, b = 0, a = 0.5 }, true), "00000080", "to_hex with alpha")
stand.equal(color.to_hex({ r = 2, g = -1, b = 0 }), "FF0000", "to_hex clamps out-of-range values")
local r, g, b, a = color.to_game(orange)
stand.check(r == 255 and g == 128 and b == 0 and a == 255, "to_game")
stand.equal(color.to_hex(color.from_game(255, 128, 0)), "FF8000", "from_game")

-- Atdar.menu's parts: what a pack builds its menu with, each loaded the first time it's asked for
stand.equal(rawget(ui, "confirm"), nil, "a part isn't loaded until it's asked for")
stand.check(rawequal(ui.confirm, Atdar.loader.load("ui/stand/core/confirm")), "Atdar.menu.confirm is ui/stand/core/confirm")
stand.check(rawget(ui, "confirm") ~= nil, "and it's kept once loaded")
stand.check(rawequal(ui.builder, Atdar.loader.load("ui/stand/core/menu_builder")), "Atdar.menu.builder")
stand.check(rawequal(ui.settings, Atdar.loader.load("ui/stand/core/settings")), "Atdar.menu.settings")
stand.check(rawequal(ui.clicks, Atdar.loader.load("ui/logic/stand/clicks")), "Atdar.menu.clicks")
local wrapped = new ui.Node(stand.root)
stand.equal(wrapped:divider("Made through Atdar.menu.Node").kind, "divider", "Atdar.menu.Node wraps a Stand ref")
stand.equal(ui.nothing_like_this, nil, "a name that is no part is nil")

-- ─── Items in a Stand ref, the options form (Atdar.menu.<kind>) ──────────────

local ref_list = ui.list(stand.root, { name = "Wrapped" })
stand.check(ref_list.handle ~= nil and stand.child(stand.root, "Wrapped") == ref_list.handle, "list(ref, opts): a MenuNode in the ref")
local pressed = 0
local button = ui.action(ref_list.handle, { name = "Press", on_click = function() pressed += 1 end })
stand.click(button.ref)
stand.equal(pressed, 1, "action(ref, opts): the button works and is a MenuItem")
local flag = ui.toggle(ref_list, { name = "Flag", on_change = || -> nil })
stand.equal(flag.kind, "toggle", "a node works as the parent too")
stand.check(ui.node(ref_list.handle) == ui.node(ref_list.handle), "one node per ref")
ui.node(ref_list.handle):clear()
stand.equal(#ref_list.handle.children, 1, "that node removes what was made through the ref, not the node's own")
stand.check(ui.root().handle == stand.root and ui.root() == ui.root(), "root(): the script's root, one node")
local outside = ui.item(stand.child(stand.root, "Wrapped"))
outside:set_name("Renamed")
stand.equal(stand.name_of(ref_list.handle), "Renamed", "item(ref): a ref from Stand changed through MenuItem")
local hidden_item = ui.spoiler(stand.root, { name = "Code", value = "42", hidden = "***" })
stand.equal(stand.name_of(hidden_item.ref), "Code: ***", "spoiler(ref, opts) gives back the MenuItem")
local picker = ui.color(stand.root, { name = "Tint", default = { r = 1, g = 0, b = 0 }, on_change = || -> nil })
stand.equal(picker.ref.kind, "colour", "color(ref, opts) too")
stand.check(ui.Item ~= nil and ui.live ~= nil and ui.refs ~= nil, "the new parts: Item, live, refs")

stand.finish()
