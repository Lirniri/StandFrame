-- ui/stand/core/commands: command names with the profile's prefix, renamed in place when it changes
local stand = require("stand")
stand.boot()
local values = { command_box_prefix = "atdar", command_box_separator = "", command_box_found_prefix = "atdar", command_box_found_separator = "" }
local listeners = {}
Atdar.profile = {
    get = |key| -> values[key],
    on_change = |fn| -> table.insert(listeners, fn),
}
local function profile_set(key, value)
    values[key] = value
    for _, fn in listeners do fn(key, value) end
end
local commands = Atdar.loader.load("ui/stand/core/commands")

stand.equal(table.concat(commands.names({ "godmode", "God Mode!", "godmode" }), ","), "atdargodmode",
    "names are cleaned, prefixed and deduplicated")
stand.clear_logs()
stand.equal(#commands.names({ "!!!" }), 0, "a name with no allowed characters is skipped")
stand.check(stand.find_log("has no allowed characters"), "and that's logged")
stand.clear_logs()
stand.equal(#commands.names({ "" }), 0, "{ \"\" } is no command, like {}")
stand.equal(stand.find_log("has no allowed characters"), nil, "and isn't warned about")

-- Items are renamed in place when the profile's prefix or separator changes
local item = menu.action(stand.root, "God", commands.names({ "godmode" }), "", || -> nil)
commands.track(item, { "godmode" })
profile_set("command_box_separator", "_")
stand.equal(table.concat(item.commands, ","), "atdar_godmode", "the separator applies to tracked items")
profile_set("command_box_prefix", "Ani Dar")
stand.equal(table.concat(item.commands, ","), "anidar_godmode", "a new prefix is cleaned and applied")
profile_set("command_box_prefix", "")
stand.equal(table.concat(item.commands, ","), "godmode", "an empty prefix means none")

-- An item deleted without untrack: renaming the rest doesn't fail on it, and it's forgotten
local forgotten = menu.action(stand.root, "Forgotten", commands.names({ "forgotten" }), "", || -> nil)
commands.track(forgotten, { "forgotten" })
local kept = menu.action(stand.root, "Kept", commands.names({ "kept" }), "", || -> nil)
commands.track(kept, { "kept" })
menu.delete(forgotten)
local real_set_names = menu.set_command_names
menu.set_command_names = function(it, names)
    if it.deleted then
        error("deleted command")
    end
    real_set_names(it, names)
end
local renamed_ok = pcall(profile_set, "command_box_prefix", "zz")
menu.set_command_names = real_set_names
stand.check(renamed_ok, "a new prefix doesn't fail on an item deleted without untrack")
stand.equal(kept.commands[1], "zz_kept", "the other items are renamed")
stand.equal(commands.names_of(forgotten), nil, "and the deleted one is forgotten")
local listed = false
for _, item in ipairs(commands.list()) do
    if item.ref == forgotten then listed = true end
end
stand.check(not listed, "nor listed in Found Commands")
commands.untrack(kept)
profile_set("command_box_prefix", "")

-- Untracked (deleted) items aren't touched any more
commands.untrack(item)
profile_set("command_box_prefix", "x")
stand.equal(table.concat(item.commands, ","), "godmode", "untracked items keep their names")

-- The loaded menu's commands have a prefix and separator of their own: the same base name can't clash
profile_set("command_box_prefix", "atdar")
profile_set("command_box_separator", "")
local script_item = menu.action(stand.root, "Settings", commands.names({ "settings" }), "", || -> nil)
commands.track(script_item, { "settings" })
commands.begin_menu(stand.tmpdir("commands_menu_none"))
local menu_item = menu.action(stand.root, "Pack Settings", commands.names({ "settings" }), "", || -> nil)
commands.track(menu_item, { "settings" })
commands.end_menu()
stand.equal(script_item.commands[1], menu_item.commands[1], "with the same prefix and separator they clash")
profile_set("command_box_found_separator", "_")
stand.equal(menu_item.commands[1], "atdar_settings", "the found separator renames the menu's commands")
stand.equal(script_item.commands[1], "atdarsettings", "and leaves the script's alone")
profile_set("command_box_found_prefix", "ad")
stand.equal(menu_item.commands[1], "ad_settings", "the found prefix too")
stand.equal(script_item.commands[1], "atdarsettings", "the script's commands keep theirs")
commands.untrack(script_item)
commands.untrack(menu_item)

stand.clear_logs()
commands.set_separator("-")
stand.check(stand.find_log("separator must be"), "only '' and '_' are allowed as separators")

-- ─── Custom names and extra words: commands/<base>.json in the owner's folder ──────────────────

profile_set("command_box_found_prefix", "atdar")
profile_set("command_box_found_separator", "")
local menu_dir = stand.tmpdir("commands_words")
-- An older commands.json there: still read, moved into the folder at the first save
stand.write_file($"{menu_dir}commands.json", '{"heal": "hp"}')
commands.begin_menu(menu_dir)
local god = menu.action(stand.root, "God", commands.names({ "godmode" }), "", || -> nil)
commands.track(god, { "godmode" })
local heal = menu.action(stand.root, "Heal", commands.names({ "heal" }), "", || -> nil)
commands.track(heal, { "heal" })
commands.end_menu()
stand.equal(heal.commands[1], "atdarhp", "an older commands.json's name still applies")

stand.check(commands.add_word(god, "GM"), "add_word: an extra word")
stand.equal(table.concat(god.commands, ","), "atdargodmode,atdargm", "it's one more command, with the prefix")
stand.equal(table.concat(commands.bases_of(god), ","), "godmode,gm", "bases_of lists it after the name")
local god_file = $"{menu_dir}commands/godmode.json"
stand.check(stand.read_file(god_file) and stand.read_file(god_file):find('"gm"', 1, true), "kept in commands/godmode.json")
stand.check(not io.exists($"{menu_dir}commands.json"), "the older commands.json is moved over and goes")
stand.check(stand.read_file($"{menu_dir}commands/heal.json"):find('"hp"', 1, true), "its names in files of their own")
local _, own = commands.add_word(god, "gm")
stand.equal(own, "own", "a word it has already: refused")
local _, taken = commands.add_word(god, "hp")
stand.equal(taken, "taken", "another item's command: refused")
local _, invalid = commands.add_word(god, "!!!")
stand.equal(invalid, "invalid", "nothing usable in it: refused")
stand.check(commands.set_custom(god, "god"), "a custom name with words")
stand.equal(table.concat(god.commands, ","), "atdargod,atdargm", "the name first, then the words")
local _, word_taken = commands.set_custom(heal, "gm")
stand.equal(word_taken, "taken", "another item's word can't be a name")
-- Names are compared with their prefixes: the script's fly (atdar_fly) leaves the menu's atdarfly free
local script_config, menu_config = commands.get_config("script"), commands.get_config("menu")
commands.set_separator("_", "script")
commands.set_separator("", "menu")
local fly = menu.action(stand.root, "Fly", commands.names({ "fly" }), "", || -> nil)
commands.track(fly, { "fly" })
stand.check(commands.set_custom(heal, "fly"), "the same name under another prefix isn't taken")
stand.equal(heal.commands[1], "atdarfly", "the menu's item takes it")
commands.set_separator("", "script")
local _, same_full = commands.set_custom(heal, "fly")
stand.equal(same_full, "taken", "the same full name is (the script's is atdarfly now too)")
commands.set_custom(heal, "hp")
-- A dot between the prefix and the name
commands.set_separator(".", "script")
stand.equal(fly.commands[1], "atdar.fly", "the dot as a separator: atdar.fly")
commands.set_separator(script_config.separator, "script")
commands.set_separator(menu_config.separator, "menu")
commands.untrack(fly)
menu.delete(fly)
stand.check(commands.remove_word(god, "gm"), "remove_word")
stand.equal(table.concat(commands.words_of(god), ","), "", "no words left")
commands.set_custom(god, "")
stand.check(not io.exists(god_file), "no name and no words: the file goes")
-- Read again (the next start): names and words come back from the folder
commands.add_word(heal, "medkit")
commands.begin_menu(menu_dir)
local heal_again = menu.action(stand.root, "Heal", commands.names({ "heal" }), "", || -> nil)
commands.track(heal_again, { "heal" })
commands.end_menu()
stand.equal(table.concat(heal_again.commands, ","), "atdarhp,atdarmedkit", "read again: the name and the words")

stand.finish()
