-- ui/stand/commands: command names with the profile's prefix, renamed in place when it changes
local stand = require("stand")
stand.boot()
local values = { command_prefix = "atdar", command_separator = "", found_command_prefix = "atdar", found_command_separator = "" }
local listeners = {}
Atdar.profile = {
    get = |key| -> values[key],
    on_change = |fn| -> table.insert(listeners, fn),
}
local function profile_set(key, value)
    values[key] = value
    for _, fn in listeners do fn(key, value) end
end
local commands = Atdar.loader.load("ui/stand/commands")

stand.equal(table.concat(commands.names({ "godmode", "God Mode!", "godmode" }), ","), "atdargodmode",
    "names are cleaned, prefixed and deduplicated")
stand.clear_logs()
stand.equal(#commands.names({ "!!!" }), 0, "a name with no allowed characters is skipped")
stand.check(stand.find_log("has no allowed characters"), "and that's logged")
stand.clear_logs()
stand.equal(#commands.names({ "" }), 0, "{ \"\" } is no command, like {}")
stand.equal(stand.find_log("has no allowed characters"), nil, "and isn't warned about")

-- Items are renamed in place when the profile's prefix or separator changes
local item = menu.action(stand.root, "God", commands.names({ "godmode" }), "", || -> nil)
commands.track(item, { "godmode" })
profile_set("command_separator", "_")
stand.equal(table.concat(item.commands, ","), "atdar_godmode", "the separator applies to tracked items")
profile_set("command_prefix", "Ani Dar")
stand.equal(table.concat(item.commands, ","), "anidar_godmode", "a new prefix is cleaned and applied")
profile_set("command_prefix", "")
stand.equal(table.concat(item.commands, ","), "godmode", "an empty prefix means none")

-- An item deleted without untrack: renaming the rest doesn't fail on it, and it's forgotten
local forgotten = menu.action(stand.root, "Forgotten", commands.names({ "forgotten" }), "", || -> nil)
commands.track(forgotten, { "forgotten" })
local kept = menu.action(stand.root, "Kept", commands.names({ "kept" }), "", || -> nil)
commands.track(kept, { "kept" })
menu.delete(forgotten)
local real_set_names = menu.set_command_names
menu.set_command_names = function(it, names)
    if it.deleted then
        error("deleted command")
    end
    real_set_names(it, names)
end
local renamed_ok = pcall(profile_set, "command_prefix", "zz")
menu.set_command_names = real_set_names
stand.check(renamed_ok, "a new prefix doesn't fail on an item deleted without untrack")
stand.equal(kept.commands[1], "zz_kept", "the other items are renamed")
stand.equal(commands.names_of(forgotten), nil, "and the deleted one is forgotten")
local listed = false
for _, item in ipairs(commands.list()) do
    if item.ref == forgotten then listed = true end
end
stand.check(not listed, "nor listed in Found Commands")
commands.untrack(kept)
profile_set("command_prefix", "")

-- Untracked (deleted) items aren't touched any more
commands.untrack(item)
profile_set("command_prefix", "x")
stand.equal(table.concat(item.commands, ","), "godmode", "untracked items keep their names")

-- The loaded menu's commands have a prefix and separator of their own: the same base name can't clash
profile_set("command_prefix", "atdar")
profile_set("command_separator", "")
local script_item = menu.action(stand.root, "Settings", commands.names({ "settings" }), "", || -> nil)
commands.track(script_item, { "settings" })
commands.begin_menu({ read = || -> nil })
local menu_item = menu.action(stand.root, "Pack Settings", commands.names({ "settings" }), "", || -> nil)
commands.track(menu_item, { "settings" })
commands.end_menu()
stand.equal(script_item.commands[1], menu_item.commands[1], "with the same prefix and separator they clash")
profile_set("found_command_separator", "_")
stand.equal(menu_item.commands[1], "atdar_settings", "the found separator renames the menu's commands")
stand.equal(script_item.commands[1], "atdarsettings", "and leaves the script's alone")
profile_set("found_command_prefix", "ad")
stand.equal(menu_item.commands[1], "ad_settings", "the found prefix too")
stand.equal(script_item.commands[1], "atdarsettings", "the script's commands keep theirs")
commands.untrack(script_item)
commands.untrack(menu_item)

stand.clear_logs()
commands.set_separator("-")
stand.check(stand.find_log("separator must be"), "only '' and '_' are allowed as separators")

stand.finish()
