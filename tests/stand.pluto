-- tests/stand.pluto
--
-- A fake Stand API, so the script's code runs outside the game, plus small test helpers.
-- Every test file starts with:
--     local stand = require("stand")
--     stand.boot()            -- Atdar with its loader, like the launcher and bootstrap make it
-- and ends with stand.finish(), which exits with 1 if any check failed.
--
-- Only what the tests need is faked. Natives (PLAYER, ENTITY, ...) are faked by each test itself.

local stand = {}

-- ─── Paths ───────────────────────────────────────────────────────────────────

local here = io.absolute(debug.getinfo(1, "S").source:gsub("^@", ""))
stand.TESTS = here:match("^(.*)[/\\][^/\\]+$")
stand.ROOT = stand.TESTS:match("^(.*)[/\\][^/\\]+$")
stand.SRC = $"{stand.ROOT}/src/"
-- Natives dump from Stand, kept locally (not in git); nil if missing
stand.NATIVES_DUMP = $"{stand.ROOT}/experiments/natives-3407a/init.lua"

package.path = $"{stand.SRC}lib/?.pluto;{package.path}"

-- ─── Test helpers ────────────────────────────────────────────────────────────

local passed, failed = 0, 0

function stand.check(cond, name: string): bool
    if cond then
        passed += 1
    else
        failed += 1
        print($"  FAIL  {name}")
    end
    return cond
end

function stand.equal(actual, expected, name: string): bool
    if actual == expected then
        passed += 1
        return true
    end
    failed += 1
    print($"  FAIL  {name}: expected {tostring(expected)}, got {tostring(actual)}")
    return false
end

-- Prints the summary and exits: 0 if everything passed, 1 otherwise
function stand.finish(): void
    local name = (debug.getinfo(2, "S").source:match("([^/\\]+)%.pluto$")) or "test"
    print($"{name}: {passed} passed, {failed} failed")
    os.exit(failed == 0 ? 0 : 1)
end

-- Removes a folder and everything in it
local function remove_tree(dir: string): void
    if not io.isdir(dir) then
        return
    end
    local paths = io.listdir(dir, true)
    -- Longest first: files and inner folders before the folders holding them
    table.sort(paths, |a, b| -> #a > #b)
    -- io.remove, unlike os.remove, also removes (empty) folders
    for _, path in paths do
        io.remove(path)
    end
    io.remove(dir)
end

-- @return A fresh empty folder tests/.tmp/<name>/ (ignored by git)
function stand.tmpdir(name: string): string
    local dir = $"{stand.TESTS}/.tmp/{name}/"
    remove_tree(dir)
    io.makedirs(dir)
    return dir
end

function stand.write_file(path: string, text: string): void
    local file = assert(io.open(path, "w"))
    file:write(text)
    file:close()
end

function stand.read_file(path: string): ?string
    local file = io.open(path, "r")
    if not file then
        return nil
    end
    local text = file:read("*a")
    file:close()
    return text
end

-- ─── util ────────────────────────────────────────────────────────────────────

-- Lines written with util.log and util.toast, oldest first; clear with stand.clear_logs()
stand.logs = {}
stand.toasts = {}
-- Names profiling.once / profiling.tick timed, in order
stand.profiled = {}
-- Lines util.draw_debug_text drew, in order
stand.debug_texts = {}
-- Texts given to menu.trigger_commands, oldest first
stand.triggered = {}

function stand.clear_logs(): void
    stand.logs = {}
    stand.toasts = {}
end

-- @return The first log line containing text (plain search), or nil
function stand.find_log(text: string): ?string
    for _, line in stand.logs do
        if line:find(text, 1, true) then
            return line
        end
    end
    return nil
end

-- Fake clock: util.yield(ms) moves it forward, so waiting code finishes instantly
stand.clock = 0
-- Ms a util.yield() without an argument takes, i.e. one frame
stand.FRAME_MS = 100
-- Called on every util.yield, e.g. to make an asset "load" after some time
stand.on_yield = nil
-- Whether util.is_session_started() says we're online
stand.online = false

local tick_handlers = {}
local stop_handlers = {}

-- Jenkins one-at-a-time, like util.joaat: lowercase, signed 32-bit result
local function joaat(text: string): int
    local hash = 0
    for i = 1, #text do
        hash = (hash + text:lower():byte(i)) & 0xFFFFFFFF
        hash = (hash + (hash << 10)) & 0xFFFFFFFF
        hash = hash ~ (hash >> 6)
    end
    hash = (hash + (hash << 3)) & 0xFFFFFFFF
    hash = hash ~ (hash >> 11)
    hash = (hash + (hash << 15)) & 0xFFFFFFFF
    return hash >= 0x80000000 ? hash - 0x100000000 : hash
end

_G.profiling = {
    once = function(name, fn)
        table.insert(stand.profiled, name)
        fn()
    end,
    tick = function(name, fn)
        table.insert(stand.profiled, name)
        fn()
    end,
}

_G.util = {
    log = |line| -> table.insert(stand.logs, line),
    toast = |line| -> table.insert(stand.toasts, line),
    require_natives = || -> nil,
    current_time_millis = || -> stand.clock,
    yield = function(ms)
        stand.clock += ms or stand.FRAME_MS
        if stand.on_yield then
            stand.on_yield()
        end
    end,
    create_tick_handler = |fn| -> table.insert(tick_handlers, fn),
    on_stop = |fn| -> table.insert(stop_handlers, fn),
    is_session_started = || -> stand.online,
    -- Runs the thread right away, to its end
    create_thread = |fn| -> fn(),
    stop_script = function() stand.stopped = true end,
    restart_script = function() stand.restarted = true end,
    joaat = joaat,
    open_folder = |path| -> table.insert(stand.toasts, $"open_folder {path}"),
    draw_debug_text = |line| -> table.insert(stand.debug_texts, line),
}

-- ─── filesystem (on the real disk) ───────────────────────────────────────────

-- Where filesystem.store_dir() points; tests that write use stand.tmpdir() here
stand.store = $"{stand.SRC}store/"

_G.filesystem = {
    scripts_dir = || -> stand.SRC,
    store_dir = || -> stand.store,
    resources_dir = || -> $"{stand.SRC}resources/",
    exists = |path| -> io.exists(path),
    is_dir = |path| -> io.isdir(path),
    mkdirs = |path| -> io.makedirs(path),
    -- Like Stand's: a folder that isn't there is an error, not an empty list
    list_files = function(dir)
        local files = {}
        if not io.isdir(dir) then
            error("operation failed", 2)
        end
        for _, path in io.listdir(dir) do
            table.insert(files, path)
        end
        return files
    end,
}

-- ─── lang (Stand's label system) ─────────────────────────────────────────────

-- Language Stand shows; set it to test translations
stand.language = "en"

local labels = {}          -- label -> English text
local label_of = {}        -- English text -> label
local translations = {}    -- language -> { [label] = text }
local translating = "en"   -- language set by lang.set_translate

_G.lang = {
    register = function(text)
        table.insert(labels, text)
        label_of[text] = #labels
        return #labels
    end,
    find_registered = |text| -> label_of[text] or 0,
    -- Like Stand: English is the source language, it takes no translations
    set_translate = function(code)
        if code == "en" then
            error("Provided language has no data")
        end
        translating = code
    end,
    translate = function(label, text)
        translations[translating] ??= {}
        translations[translating][label] = text
    end,
    get_localised = function(label)
        local localised = translations[stand.language] and translations[stand.language][label]
        return localised or labels[label]
    end,
    get_current = || -> stand.language,
}

-- ─── menu ────────────────────────────────────────────────────────────────────

-- Click types Stand defines as globals
_G.CLICK_MENU = 0
--
-- Every item is a table: { kind, name, help, parent, children, value, visible, ... }.
-- Callbacks are called the way Stand calls them; stand.click() acts like the user

local function item(kind: string, parent, name, help, extra: ?table): table
    local it = extra or {}
    it.kind = kind
    it.name = name
    it.help = help
    it.parent = parent
    it.children = {}
    it.visible = true
    if parent then
        table.insert(parent.children, it)
    end
    return it
end

stand.root = item("list", nil, "Root", "")

-- Toggles that are on: their toggle_loop callback runs every stand.frame()
local function set_value(it, value): void
    if it.value == value then
        return
    end
    it.value = value
    if it.kind == "toggle" then
        it.on_change(value, 0)
    elseif it.kind == "toggle_loop" and not value then
        it.on_stop()
    elseif it.kind == "text_input" or it.kind == "slider" then
        it.on_change(value, 0)
    end
end

_G.menu = {
    my_root = || -> stand.root,
    list = |parent, name, commands, help, on_click, on_back| -> item("list", parent, name, help,
        { commands = commands, on_click = on_click, on_back = on_back }),
    divider = |parent, name| -> item("divider", parent, name, ""),
    readonly = |parent, name, value| -> item("readonly", parent, name, "", { value = value }),
    readonly_name = |parent, name| -> item("readonly_name", parent, name, ""),
    hyperlink = |parent, name, link, help| -> item("hyperlink", parent, name, help, { link = link }),
    action = |parent, name, commands, help, on_click| -> item("action", parent, name, help, { commands = commands, on_click = on_click }),
    toggle = |parent, name, commands, help, on_change, default| -> item("toggle", parent, name, help,
        { commands = commands, on_change = on_change, value = default == true }),
    toggle_loop = |parent, name, commands, help, on_tick, on_stop| -> item("toggle_loop", parent, name, help,
        { commands = commands, on_tick = on_tick, on_stop = on_stop, value = false }),
    list_action = |parent, name, commands, help, options, on_select| -> item("list_action", parent, name, help,
        { commands = commands, options = options, on_select = on_select }),
    slider = |parent, name, commands, help, min, max, default, step, on_change| -> item("slider", parent, name, help,
        { commands = commands, min = min, max = max, value = default, default = default, step = step, on_change = on_change }),
    click_slider = |parent, name, commands, help, min, max, default, step, on_click| -> item("click_slider", parent, name,
        help, { commands = commands, min = min, max = max, value = default, step = step, on_click = on_click }),
    textslider = |parent, name, commands, help, options, on_click| -> item("textslider", parent, name, help,
        { commands = commands, options = options, on_click = on_click }),
    text_input = |parent, name, commands, help, on_change, default| -> item("text_input", parent, name, help,
        { commands = commands, on_change = on_change, value = default }),
    -- value: the colour { r, g, b, a }; the user picking one is it.on_change(colour, click_type)
    colour = |parent, name, commands, help, default, transparency, on_change| -> item("colour", parent, name, help,
        { commands = commands, value = default, default = default, transparency = transparency, on_change = on_change }),
    delete = function(it)
        it.deleted = true
        if it.parent then
            for i, child in it.parent.children do
                if child == it then
                    table.remove(it.parent.children, i)
                    break
                end
            end
        end
    end,
    get_value = |it| -> it.value,
    -- Deleted items aren't valid any more
    is_ref_valid = |it| -> type(it) == "table" and not it.deleted,
    get_menu_name = |it| -> it.name,
    set_value = set_value,
    set_menu_name = function(it, name) it.name = name end,
    set_help_text = function(it, help) it.help = help end,
    set_list_action_options = function(it, options) it.options = options end,
    -- What the command box was given, oldest first (stand.triggered)
    trigger_commands = function(input) table.insert(stand.triggered, input) end,
    -- The item answering to a command name (its commands as Stand has them), nil if none
    ref_by_command_name = |name| -> stand.by_command(name),
    set_visible = function(it, visible) it.visible = visible end,
    set_command_names = function(it, names) it.commands = names end,
    -- Where the cursor was sent last (stand.focused)
    focus = function(it) stand.focused = it end,
    -- Called when the cursor comes onto the item (stand.hover)
    -- Run by stand.view_tick(it): what Stand does every tick while the item is on screen
    on_tick_in_viewport = function(it, fn)
        it.view_ticks ??= {}
        table.insert(it.view_ticks, fn)
    end,
    on_focus = function(it, fn)
        it.on_focus_handlers ??= {}
        table.insert(it.on_focus_handlers, fn)
    end,
    on_blur = function(it, fn)
        it.on_blur_handlers ??= {}
        table.insert(it.on_blur_handlers, fn)
    end,
    -- Proceeds right away, as if the user confirmed
    show_warning = |_, _, _, proceed| -> proceed(),
}

-- Acts like the user: switches a toggle, clicks an action, picks option index of a list_action
function stand.click(it, option: ?int): void
    if it.kind == "toggle" or it.kind == "toggle_loop" then
        set_value(it, not it.value)
    elseif it.kind == "action" then
        it.on_click(0)
    elseif it.kind == "list_action" then
        it.on_select(option, it.options[option], 0)
    elseif it.kind == "click_slider" then
        it.on_click(option or it.value, 0)
    elseif it.kind == "list" then
        -- Opening the list
        if it.on_click then
            it.on_click(0)
        end
    else
        error($"stand.click: can't click a {it.kind}")
    end
end

-- One tick of an item on screen: its menu.on_tick_in_viewport handlers run
function stand.view_tick(it): void
    for _, fn in it.view_ticks or {} do
        fn()
    end
end

-- Acts like the user moving the cursor onto an item: its menu.on_focus handlers run
function stand.hover(it): void
    for _, fn in it.on_focus_handlers or {} do
        fn()
    end
end

-- Acts like the user moving the cursor off an item: its menu.on_blur handlers run
function stand.leave(it): void
    for _, fn in it.on_blur_handlers or {} do
        fn()
    end
end

-- Acts like the user going back out of a list: its on_back runs
function stand.back(it): void
    if it.on_back then
        it.on_back()
    end
end

-- The script stopping: runs the util.on_stop handlers
function stand.stop(): void
    for _, fn in stop_handlers do
        fn()
    end
end

-- One game frame: tick handlers, then the toggle_loops that are on
function stand.frame(count: int = 1): void
    for _ = 1, count do
        for i = #tick_handlers, 1, -1 do
            if tick_handlers[i]() == false then
                table.remove(tick_handlers, i)
            end
        end
        local function tick_loops(it)
            for _, child in it.children do
                if child.kind == "toggle_loop" and child.value then
                    child.on_tick()
                end
                tick_loops(child)
            end
        end
        tick_loops(stand.root)
    end
end

-- @return An item's name as text: names may be Stand labels (ints) from i18n
function stand.name_of(it): string
    if type(it.name) == "number" then
        return lang.get_localised(it.name)
    end
    return tostring(it.name)
end

-- @return The item answering to a command name, like menu.ref_by_command_name; nil if none
function stand.by_command(name: string, parent: ?table): ?table
    for _, child in (parent or stand.root).children do
        for _, command in ipairs(child.commands or {}) do
            if command == name and not child.deleted then
                return child
            end
        end
        local found = stand.by_command(name, child)
        if found then
            return found
        end
    end
    return nil
end

-- @return The first item under parent (any depth) whose name contains text
function stand.find_item(parent, text: string): ?table
    for _, child in parent.children do
        if stand.name_of(child):find(text, 1, true) then
            return child
        end
        local found = stand.find_item(child, text)
        if found then
            return found
        end
    end
    return nil
end

-- A direct child of parent whose name is exactly text (find_item matches a part of the name), or nil
function stand.child(parent, text: string): ?table
    if parent == nil then
        return nil
    end
    for _, child in parent.children do
        if stand.name_of(child) == text then
            return child
        end
    end
    return nil
end


-- ─── Atdar ───────────────────────────────────────────────────────────────────

-- Creates Atdar with its loader and globals, like the launcher and the top of bootstrap.pluto
function stand.boot(): table
    -- log_dir: the logger's files go to tests/.tmp, not into the project's src/store
    _G.Atdar = { ui = {}, name = "AnitaDarin", debug = false, log_dir = stand.tmpdir("logs") }
    Atdar.loader = require("AnitaDarin/core/loader")
    Atdar.globals = Atdar.loader.load("globals")
    return Atdar
end

return stand
