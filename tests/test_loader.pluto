-- core/loader: load() survives broken files, auto() reaches every natives file
local stand = require("stand")
stand.boot()
local loader = Atdar.loader

-- load(): a file that throws or returns no table gives an empty table and a log line, not a crash
package.preload["AnitaDarin/test_throws"] = function() error("boom") end
package.preload["AnitaDarin/test_no_table"] = || -> true
stand.equal(next(loader.load("test_throws")), nil, "throwing file loads as an empty table")
stand.check(stand.find_log("failed to load 'test_throws'"), "throwing file is logged")
stand.equal(next(loader.load("test_no_table")), nil, "file without a table loads as an empty table")
stand.check(stand.find_log("'test_no_table' did not return a table"), "file without a table is logged")

-- The log says which file asked for the one that failed (not a tail call: that frame would be gone)
package.preload["AnitaDarin/test_asks_missing"] = function()
    local missing = loader.load("test_missing")
    return missing
end
loader.load("test_asks_missing")
local missing_line = stand.find_log("failed to load 'test_missing'") or ""
stand.check(missing_line:find("%(from .*test_loader%.pluto:%d+%)"), "the log names the file and line asking for the load")

-- Every .pluto under natives/ loads as a table without errors, and is reachable by its path through
-- auto() (natives.visual.hud.minimap, natives.entity.ped.weapon)
Atdar.natives = loader.auto({}, "natives")
local natives_dir = $"{stand.SRC}lib/AnitaDarin/natives"
local count = 0
stand.clear_logs()
for _, path in io.listdir(natives_dir, true) do
    local relative = path:sub(#natives_dir + 2):match("^(.+)%.pluto$")
    if relative then
        count += 1
        local parts = {}
        for part in relative:gmatch("[^/\\]+") do
            table.insert(parts, part)
        end
        local dotted = table.concat(parts, ".")
        stand.equal(type(loader.load($"natives/{table.concat(parts, '/')}")), "table", $"natives/{dotted} loads")
        do
            local value = Atdar.natives
            for _, part in parts do
                value = type(value) == "table" ? value[part] : nil
            end
            stand.equal(type(value), "table", $"natives.{dotted} is reachable")
        end
    end
end
stand.check(count > 30, $"found the natives files ({count})")
stand.equal(stand.find_log("failed to load"), nil, "no natives file failed to load")

-- Load times: every file load() reads is timed; nested loads are part of the parent's total, not its own
local timing_of = function(path)
    for _, entry in ipairs(loader.timings) do
        if entry.path == path then return entry end
    end
    return nil
end
local entity = timing_of("natives/entity")
local world = timing_of("natives/world")
stand.check(entity and world, "natives/entity and natives/world were timed")
stand.check(entity.total >= entity.own and entity.own >= 0, "total includes nested loads, own doesn't")
stand.check(world.depth > entity.depth, "natives/world is loaded inside natives/entity: one level deeper")
local before = #loader.timings
loader.load("natives/entity")
stand.equal(#loader.timings, before, "a file already loaded isn't timed again")

-- measure(): times any work, passes its results and errors through
stand.equal(select(2, loader.measure("C:/x/work.pluto", function() return true, 42 end)), 42, "measure returns what fn returns")
local ok, err = pcall(loader.measure, "broken work", || -> error("boom", 0))
stand.check(not ok and err == "boom", "measure lets an error through")
stand.check(timing_of("broken work") ~= nil, "and still records the time")
local outer = loader.measure("outer", function()
    loader.measure("inner", function() local t = loader.now() while loader.now() - t < 5 do end end)
    return true
end)
stand.check(outer and timing_of("outer").total >= timing_of("inner").total, "an outer measure's total includes the inner")
stand.check(timing_of("outer").own < timing_of("inner").total, "but its own time doesn't")

-- report(): a summary line and the slowest files
stand.clear_logs()
loader.report(123.4, 3)
stand.check(stand.find_log("load times: "), "report: the summary")
stand.check(stand.find_log("the whole start 123.4 ms"), "with the whole start when given")

-- Load Timing logs each load as it happens; without it nothing per file
package.preload["AnitaDarin/test_quiet"] = || -> {}
stand.clear_logs()
loader.load("test_quiet")
stand.equal(stand.find_log("loaded 'test_quiet' in "), nil, "without Load Timing a load isn't logged")
Atdar.load_timing = true
package.preload["AnitaDarin/test_timed"] = || -> {}
loader.load("test_timed")
stand.check(stand.find_log("loaded 'test_timed' in "), "with Load Timing each load is logged")
Atdar.load_timing = false

-- A typo is nil, not an empty table, and the disk is checked only once per name
local real_exists = filesystem.exists
local checks = 0
filesystem.exists = function(path) checks += 1 return real_exists(path) end
stand.equal(Atdar.natives.visual.hudd, nil, "a typo is nil")
local after_first = checks
stand.equal(Atdar.natives.visual.hudd, nil, "the typo is still nil")
stand.equal(checks, after_first, "the typo isn't checked on disk again")
filesystem.exists = real_exists

-- Loaded once and kept: the same table every time; the facade's own functions win over files
stand.check(rawequal(Atdar.natives.visual.hud, Atdar.natives.visual.hud), "a submodule is loaded once")
stand.equal(type(rawget(Atdar.natives.visual, "hud")), "table", "a loaded submodule is stored in the facade")
stand.equal(type(Atdar.natives.world.snap_to_ground), "function", "the facade's own functions are there")

-- reload(): the loaded files are forgotten and load again on first use; a typo found missing before
-- is checked again (a file may have been added)
local old_hud = Atdar.natives.visual.hud
local forgotten = loader.reload(Atdar.natives, "natives")
stand.check(forgotten >= 2, "reload forgets the loaded native files")
stand.equal(rawget(Atdar.natives, "visual"), nil, "and takes them out of Atdar.natives")
stand.check(package.loaded["AnitaDarin/natives/visual/hud"] == nil, "and out of require's cache")
local new_hud = Atdar.natives.visual.hud
stand.equal(type(new_hud), "table", "they load again on first use")
stand.check(not rawequal(new_hud, old_hud), "as new tables, read from disk again")
checks = 0
filesystem.exists = function(path) checks += 1 return real_exists(path) end
stand.equal(Atdar.natives.visual.hudd, nil, "a typo is still nil")
stand.check(checks > 0, "but is checked on disk again after a reload")
filesystem.exists = real_exists

-- keep(): the same table by name, across reloads
local kept = loader.keep("test/state")
kept.value = 5
stand.check(rawequal(loader.keep("test/state"), kept) and loader.keep("test/state").value == 5, "keep gives the same table back")

stand.finish()
