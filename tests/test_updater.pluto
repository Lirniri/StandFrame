-- core/updater: paths under the script's name, user data kept, plan, apply, removal.
-- The network is a fake async_http here; files go to tests/.tmp only
local stand = require("stand")
stand.boot()
local json = require "pluto:json"
local updater = Atdar.loader.load("core/updater")

-- ─── Fake GitHub ─────────────────────────────────────────────────────────────

-- URL path -> body, or a number: that HTTP status. Missing: the request fails
local served = {}
local requests = {}
local access = true
_G.async_http = {
    have_access = || -> access,
    init = function(host, path, on_success, on_fail)
        table.insert(requests, host .. path)
        local answer = served[path]
        async_http.pending = function()
            if answer == nil then
                on_fail("no answer")
            elseif type(answer) == "number" then
                on_success("", {}, answer)
            else
                on_success(answer, {}, 200)
            end
        end
    end,
    dispatch = function()
        async_http.pending()
    end,
}

local BASE = "/Lirniri/Stand-AnitaDarin/main/"
local function serve(path: string, content) served[$"{BASE}src/{path}"] = content end
local function publish(files: table, version: string)
    local listed = {}
    for path, content in pairs(files) do
        listed[path] = { sha256 = updater.hash(path, content), size = #content }
        serve(path, content)
    end
    served[$"{BASE}updater/manifest.json"] = json.encode({ format = 1, project = "AnitaDarin", version = version, files = listed })
end

-- ─── Paths ───────────────────────────────────────────────────────────────────

local o = { scripts_dir = "C:\\LS\\", project = "AnitaDarin", name = "Renamed" }
stand.equal(updater.target_of("AnitaDarin.pluto", o), "C:\\LS\\Renamed.pluto", "the launcher goes under the script's name")
stand.equal(updater.target_of("lib/AnitaDarin/core/loader.pluto", o), "C:\\LS\\lib\\Renamed\\core\\loader.pluto",
    "lib files go to lib/<name>/")
stand.equal(updater.target_of("store/AnitaDarin/core/language/en-us.json", o),
    "C:\\LS\\store\\Renamed\\core\\language\\en-us.json", "store files to store/<name>/")
for _, bad in { "lib/Other/x.pluto", "lib/AnitaDarin/../../evil.pluto", "C:/evil.pluto", "/evil.pluto",
    "lib\\AnitaDarin\\x.pluto", "Other.pluto", "lib/AnitaDarin/" } do
    stand.equal(updater.target_of(bad, o), nil, $"a path outside the script's places is never written: {bad}")
end

stand.check(updater.is_user_data("store/AnitaDarin/config.json", "AnitaDarin"), "config.json is the user's")
stand.check(updater.is_user_data("store/AnitaDarin/profiles/main.json", "AnitaDarin"), "profiles are")
stand.check(updater.is_user_data("store/AnitaDarin/commands/debug.json", "AnitaDarin"), "command names are")
stand.check(updater.is_user_data("store/AnitaDarin/user/call_function/short_names.json", "AnitaDarin"), "the user folder is: short names, saved functions")
stand.check(not updater.is_user_data("store/AnitaDarin/core/language/en-us.json", "AnitaDarin"), "core/language isn't")
stand.check(updater.is_user_data("store/AnitaDarin/menu/AnitaDarin/profiles/main.json", "AnitaDarin"), "a pack's profiles are")
stand.check(not updater.is_user_data("store/AnitaDarin/core/language/en-us.json", "AnitaDarin"), "translations aren't")
stand.check(not updater.is_user_data("lib/AnitaDarin/commands/x.pluto", "AnitaDarin"), "nothing in lib is")

-- The same hash as manifest.py: sha256 of the text without \r (Python: hashlib.sha256(b"a\nb\n"))
local AB = "911169ddaaf146aff539f58c26c489af3b892dff0fe283c1c264c65ae5aa59a2"
stand.equal(updater.hash("x.pluto", "a\nb\n"), AB, "sha256 as manifest.py counts it")
stand.equal(updater.hash("x.pluto", "a\r\nb\r\n"), AB, "\\r\\n and \\n hash the same in text")
stand.check(updater.hash("x.png", "a\r\nb") ~= updater.hash("x.png", "a\nb"), "a binary file is hashed as it is")

-- ─── Check: what differs ─────────────────────────────────────────────────────

local dir = stand.tmpdir("updater")
local ls = $"{dir}LuaScripts\\"
local opts = { name = "Renamed", scripts_dir = ls }
local function installed(path: string): ?string return stand.read_file(updater.target_of(path, { scripts_dir = ls, project = "AnitaDarin", name = "Renamed" })) end

-- Writes the bytes as they are (like a copied file), its folder made
local function put(path: string, text: string)
    io.makedirs(path:match("^(.*)[/\\][^/\\]+$"))
    local file = assert(io.open(path, "wb"))
    file:write(text)
    file:close()
end
-- Installed by hand (build.py): the same core, an old loader, the user's config, a menu copied to core
put($"{ls}lib\\Renamed\\core\\same.pluto", "same\r\n")
put($"{ls}lib\\Renamed\\core\\loader.pluto", "old loader\n")
put($"{ls}store\\Renamed\\config.json", "{\"mine\": true}")
put($"{ls}lib\\Renamed\\menu_copy\\main.pluto", "a menu copied to core")
publish({
    ["AnitaDarin.pluto"] = "launcher\n",
    ["lib/AnitaDarin/core/same.pluto"] = "same\n",
    ["lib/AnitaDarin/core/loader.pluto"] = "new loader\n",
    ["store/AnitaDarin/config.json"] = "{\"default\": true}",
    ["store/AnitaDarin/profiles/main.json"] = "{}",
}, "0.1.0")

local plan, err = updater.check(opts)
stand.check(plan ~= nil, $"check gives a plan ({tostring(err)})")
stand.equal(requests[1], "raw.githubusercontent.com/Lirniri/Stand-AnitaDarin/main/updater/manifest.json", "the manifest from main")
stand.equal(plan.version, "0.1.0", "with the release's version")
stand.equal(table.concat(plan.download, " | "),
    "AnitaDarin.pluto | lib/AnitaDarin/core/loader.pluto | store/AnitaDarin/profiles/main.json",
    "downloads the missing and the changed; the same (\\r\\n or not) and the user's config stay")
stand.equal(#plan.remove, 0, "removes nothing on the first update: it doesn't know what's its own")
stand.check(not updater.is_up_to_date(plan), "not up to date")

-- ─── Apply ───────────────────────────────────────────────────────────────────

local progress = {}
local ok, apply_err = updater.apply(plan, function(done, total) table.insert(progress, $"{done}/{total}") end)
stand.check(ok, $"apply writes the files ({tostring(apply_err)})")
stand.equal(table.concat(progress, " "), "1/3 2/3 3/3", "telling the progress")
stand.equal(stand.read_file($"{ls}Renamed.pluto"), "launcher\n", "the launcher under the script's name")
stand.equal(installed("lib/AnitaDarin/core/loader.pluto"), "new loader\n", "the changed file replaced")
stand.equal(installed("store/AnitaDarin/config.json"), "{\"mine\": true}", "the user's config kept")
stand.equal(installed("store/AnitaDarin/profiles/main.json"), "{}", "a missing profile made")
stand.check(not io.exists($"{ls}lib\\Renamed\\core\\loader.pluto.update"), "no .update files left")
stand.equal(updater.installed(opts).version, "0.1.0", "the release is remembered as installed")
local installed_text = stand.read_file($"{ls}store\\Renamed\\updater\\installed.json")
stand.check(installed_text and installed_text:find("\n%s+\"version\""), "written through JsonFile: indented like the script's other JSON files")
plan = updater.check(opts)
stand.check(updater.is_up_to_date(plan), "checked again: up to date")

-- Files that match the release without an update (build.py): remember puts the version down
os.remove($"{ls}store\\Renamed\\updater\\installed.json")
stand.equal(updater.installed(opts), nil, "nothing installed by an update yet")
updater.remember(plan)
stand.equal(updater.installed(opts).version, "0.1.0", "an up-to-date check remembers the version")

-- ─── Next release: a file gone ───────────────────────────────────────────────

served = {}
publish({
    ["AnitaDarin.pluto"] = "launcher\n",
    ["lib/AnitaDarin/core/loader.pluto"] = "newer loader\n",
    ["store/AnitaDarin/config.json"] = "{\"default\": true}",
}, "0.2.0")
plan = updater.check(opts)
stand.equal(table.concat(plan.remove, " | "), "lib/AnitaDarin/core/same.pluto",
    "removes what the last update had and this one hasn't; never the user's profile")
stand.check(updater.apply(plan), "the next release applies")
stand.check(not io.exists($"{ls}lib\\Renamed\\core\\same.pluto"), "the gone file is removed")
stand.equal(installed("store/AnitaDarin/profiles/main.json"), "{}", "the user's profile stays")
stand.equal(stand.read_file($"{ls}lib\\Renamed\\menu_copy\\main.pluto"), "a menu copied to core",
    "a file the updater didn't put there stays")

-- ─── Failures: nothing written ───────────────────────────────────────────────

served = {}
publish({ ["lib/AnitaDarin/core/loader.pluto"] = "loader 3\n", ["lib/AnitaDarin/core/other.pluto"] = "other\n" }, "0.3.0")
serve("lib/AnitaDarin/core/other.pluto", "not what the manifest says\n")
plan = updater.check(opts)
ok, apply_err = updater.apply(plan)
stand.check(not ok and apply_err:find("doesn't match the manifest", 1, true), "a download not matching its hash: fails")
stand.equal(installed("lib/AnitaDarin/core/loader.pluto"), "newer loader\n", "and nothing is written, the good ones neither")
serve("lib/AnitaDarin/core/other.pluto", 404)
ok, apply_err = updater.apply(plan)
stand.check(not ok and apply_err:find("HTTP 404", 1, true), "a file not found: fails with the status")
serve("lib/AnitaDarin/core/other.pluto", nil)
ok, apply_err = updater.apply(plan)
stand.check(not ok and apply_err:find("no answer", 1, true), "no answer: fails with the reason")

served[$"{BASE}updater/manifest.json"] = "not json"
plan, err = updater.check(opts)
stand.check(plan == nil and err:find("not a manifest", 1, true), "a broken manifest: says so")
served[$"{BASE}updater/manifest.json"] = json.encode({ project = "Other", files = {} })
plan, err = updater.check(opts)
stand.check(plan == nil and err:find("'Other'", 1, true), "another project's manifest: refused")
access = false
plan, err = updater.check(opts)
stand.check(plan == nil and err:find("Disable Internet Access in Stand > Lua Scripts > Renamed", 1, true), "no internet access: says where to allow it")
access = true

-- A request that never answers times out
_G.async_http.dispatch = function() end
local body, fetch_err = updater.fetch("raw.githubusercontent.com", "/x", 1000)
stand.check(body == nil and fetch_err == "timed out", "no answer in time: timed out")

-- The releases made: updater/versions.json, newest first
_G.async_http.dispatch = function() async_http.pending() end
served[$"{BASE}updater/versions.json"] = json.encode({ versions = { "0.1.2", "0.1.1", 7 } })
local listed, versions_err = updater.versions(opts)
stand.check(listed ~= nil and #listed == 2 and listed[1] == "0.1.2" and listed[2] == "0.1.1", "versions: the file's, newest first, only texts")
served[$"{BASE}updater/versions.json"] = "nope"
listed, versions_err = updater.versions(opts)
stand.check(listed == nil and versions_err:find("not a list of versions", 1, true), "versions: a broken file says so")
served[$"{BASE}updater/versions.json"] = nil
listed, versions_err = updater.versions(opts)
stand.check(listed == nil and versions_err:find("no answer", 1, true), "versions: no file - why")
access = false
listed, versions_err = updater.versions(opts)
stand.check(listed == nil and versions_err:find("Disable Internet Access", 1, true), "versions: no internet access - says where to allow it")
access = true

-- Update To Version (core/update_manager.install_version): the refs a typed version can mean. Nothing is
-- served for them here, so nothing gets installed (the real scripts folder is not touched)
_G.async_http.dispatch = function() async_http.pending() end
-- What the manager needs around it: the script's strings, a profile that holds nothing
for _, name in { "util", "filesystem", "lang" } do
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end
Atdar.profile = { get = || -> nil, set = || -> nil, on_change = || -> nil, log_name = || -> "AnitaDarin" }
local manager = Atdar.loader.load("core/update_manager")
requests = {}
stand.clear_logs()
stand.equal(manager.install_version("9.9.9"), "failed", "a version with no release: fails")
stand.equal(requests[1], "raw.githubusercontent.com/Lirniri/Stand-AnitaDarin/v9.9.9/updater/manifest.json", "0.1.8 is the tag v0.1.8 first")
stand.equal(requests[2], "raw.githubusercontent.com/Lirniri/Stand-AnitaDarin/9.9.9/updater/manifest.json", "then the bare number")
stand.check(stand.find_log("No release found for '9.9.9'"), "and says there is none")
stand.equal(manager.busy, false, "the manager is free again")
requests = {}
manager.install_version("some-branch")
stand.equal(#requests, 1, "anything else is a ref as typed, once")
stand.check(requests[1]:find("/some-branch/updater/manifest.json", 1, true) ~= nil, "a branch, a tag or a commit")

stand.finish()
