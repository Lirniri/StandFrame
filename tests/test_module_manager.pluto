-- core/module_manager + core/module + core/module_manifest: modules found by their manifests and loaded when
-- started, deps, start/stop order, retry, ticking, reload from disk
local stand = require("stand")
stand.boot()
Atdar.modules = Atdar.loader.load("core/module_manager")
local Module = Atdar.loader.load("core/module")
local modules = Atdar.modules

-- Module files on disk, each with its manifest (<name>.info.json), so reload_module can read them again.
-- Each records its events in EVENTS, and in LOADED how many times its file ran
local dir = stand.tmpdir("module_manager")
local function module_file(name: string, deps: string, version: int, extra: string = ""): string
    return $"LOADED['{name}'] = (LOADED['{name}'] or 0) + 1\n"
        .. "local Module = Atdar.loader.load('core/module')\n"
        .. $"return Atdar.modules.add(new Module(\{ name = '{name}', deps = \{ {deps} },\n"
        .. $"    on_start = function() {extra} table.insert(EVENTS, 'start {name} v{version}') end,\n"
        .. $"    on_stop = function() table.insert(EVENTS, 'stop {name} v{version}') end,\n"
        .. $"    on_tick = function() TICKS['{name}'] = (TICKS['{name}'] or 0) + 1 end }))\n"
end
_G.EVENTS = {}
_G.TICKS = {}
_G.LOADED = {}
-- c needs b needs a; d stands alone; e needs a module that doesn't exist. b and e say it in their files,
-- c in its manifest
stand.write_file($"{dir}a.pluto", module_file("a", "", 1))
stand.write_file($"{dir}b.pluto", module_file("b", "'a'", 1))
stand.write_file($"{dir}c.pluto", module_file("c", "", 1, "if FAIL_C then error('c broke') end"))
stand.write_file($"{dir}d.pluto", module_file("d", "", 1))
stand.write_file($"{dir}e.pluto", module_file("e", "'missing'", 1))
for _, name in { "a", "b", "d", "e" } do
    stand.write_manifest(dir, name, name)
end
stand.write_manifest(dir, "c", "c", ', "dependencies": ["b"]')
-- A .pluto file without a manifest isn't a module: never run
stand.write_file($"{dir}helper.pluto", "LOADED.helper = 1\nreturn { x = 1 }\n")
_G.FAIL_C = true

stand.equal(modules.load_dir(dir), 5, "the five manifests' modules are registered")
stand.equal(next(LOADED), nil, "reading the manifests runs no module file")
stand.equal(table.concat(modules.names(), ","), "a,b,c,d,e", "they're there by their ids, in the manifests' order")
stand.check(modules.get("a").loaded == false and modules.get("a").status == "registered", "each a stand-in until it starts")
stand.equal(modules.get("c").deps[1], "b", "the stand-in has the manifest's dependencies")
stand.equal(modules.file_changed("a"), false, "a file that hasn't run yet isn't changed")
stand.equal(modules.load_dir(dir), 0, "the same folder again: nothing new")
modules.start()
stand.check(LOADED.a == 1 and LOADED.b == 1 and LOADED.d == 1, "starting runs each file once")
stand.equal(LOADED.helper, nil, "a file without a manifest isn't run")
stand.check(modules.get("a").loaded, "the stand-in is replaced by the module its file registered")
stand.equal(table.concat(modules.names(), ","), "a,b,c,d,e", "at the same place in the order")

-- debug = { ... }: checked when the module is made, so a typo shows at once
local function rejects(debug_opts, text: string, name: string): void
    local ok, err = pcall(|| -> new Module({ name = "with_debug", debug = debug_opts }))
    stand.check(not ok and tostring(err):find(text, 1, true), name)
end
rejects("x", "debug must be a table", "debug must be a table")
rejects({ hidden = {} }, "debug: unknown 'hidden', expected categories, functions, groups or hide", "a typo in a part")
rejects({ hide = "a" }, "debug.hide must be a table", "hide must be a list")
rejects({ functions = { f = { helps = "" } } }, "debug.functions.f: unknown 'helps', expected help, params, args or live", "a typo in a function's options")
rejects({ groups = { { name = "G" } } }, "debug.groups[1] must be", "a group needs its functions")
rejects({ categories = { { words = { "x" } } } }, "debug.categories[1] must be", "a category needs its key")
local fine = new Module({ name = "with_debug", debug = { hide = { "x" } } })
stand.equal(fine.debug.hide[1], "x", "a right one is kept as self.debug")
stand.equal(next(new Module({ name = "no_debug" }).debug), nil, "none given: an empty table")

-- skip_first_tick: the first tick after every start is skipped
stand.check(not pcall(|| -> new Module({ name = "bad_skip", skip_first_tick = "yes" })), "skip_first_tick must be a boolean")
local skip_ticks = 0
local skipper = new Module({ name = "skipper", skip_first_tick = true, on_tick = function() skip_ticks += 1 end })
skipper:start()
skipper:tick()
stand.equal(skip_ticks, 0, "skip_first_tick: the first tick does nothing")
skipper:tick()
stand.equal(skip_ticks, 1, "and the next one runs")
skipper:stop()
skipper:start()
skipper:tick()
stand.equal(skip_ticks, 1, "skipped again after every start")
local no_skip_ticks = 0
local no_skip = new Module({ name = "no_skip", on_tick = function() no_skip_ticks += 1 end })
no_skip:start()
no_skip:tick()
stand.equal(no_skip_ticks, 1, "without it the first tick runs")

-- file_changed: whether the file differs from the code running
stand.equal(modules.file_changed("a"), false, "a file as it was loaded: not changed")
stand.write_file($"{dir}a.pluto", module_file("a", "", 1) .. "-- edited\n")
stand.equal(modules.file_changed("a"), true, "edited after loading: changed")
stand.write_file($"{dir}a.pluto", module_file("a", "", 1))
stand.equal(modules.file_changed("a"), false, "the same text again: not changed")
stand.equal(new Module({ name = "made_in_code" }) and modules.file_changed("made_in_code"), false,
    "a module made in code has no file to change")

-- A module loaded from a file knows its folder and keeps JSON files there; one made in code has none
stand.equal(modules.file_of("a"), $"{dir}a.pluto", "file_of: the file a module came from")
stand.equal(modules.get("a"):folder(), dir, "folder(): the folder of the module's file")
local saved_file = modules.get("a"):json_file("saved")
stand.equal(saved_file.path, $"{dir}saved.json", "json_file(name): <folder><name>.json")
stand.check(saved_file:write({ items = { 1, 2 } }), "it can be written")
stand.equal(#saved_file:read().items, 2, "and read back")
local in_code = new Module({ name = "in_code" })
stand.equal(in_code:folder(), nil, "a module made in code has no folder")
stand.equal(in_code:json_file("x"), nil, "nor JSON files")

local function status(name) return modules.get(name).status end
local function events() local text = table.concat(EVENTS, ", ") EVENTS = {} return text end

stand.equal(events(), "start a v1, start b v1, start d v1", "deps start first; failing modules don't start")
stand.equal(status("c"), "failed", "c failed in on_start")
stand.equal(status("e"), "failed", "e needs a module that isn't registered")
stand.check(modules.get("e").error:find("isn't registered", 1, true), "e's error says why")

-- A path Lua cut in an error shows from Stand's folder on
local cut_path = new Module({ name = "cut_path" })
cut_path:fail("on_tick failed\n...ata\\Roaming\\Stand\\Lua Scripts\\lib\\natives-3407a\\init.lua:8919: bad argument")
stand.equal(cut_path.error, "on_tick failed\nStand\\Lua Scripts\\lib\\natives-3407a\\init.lua:8919: bad argument",
    "the cut beginning of the path is gone")
cut_path:fail("...Scripts\\lib\\x.lua:1: no Stand folder in it")
stand.equal(cut_path.error, "...Scripts\\lib\\x.lua:1: no Stand folder in it", "cut after Stand's folder: left as it is")

-- One shared tick: each running module ticks once per frame
stand.frame()
stand.equal(TICKS.a, 1, "a ticks once per frame")
stand.equal(TICKS.c, nil, "a failed module doesn't tick")

-- Stopping a stops what needs it first
modules.stop_module("a")
stand.equal(events(), "stop b v1, stop a v1", "b stops before a")
stand.equal(status("d"), "running", "unrelated d keeps running")

-- Starting c retries it and starts its deps in order
_G.FAIL_C = false
stand.check(modules.start_module("c"), "c starts on retry")
stand.equal(events(), "start a v1, start b v1, start c v1", "deps come back first")

-- After a stop and start, a module still ticks once per frame, not twice
modules.stop_module("b")
stand.equal(status("c"), "stopped", "stopping b also stopped c, which needs it")
modules.start_module("b")
TICKS = {}
stand.frame()
stand.equal(TICKS.b, 1, "b ticks once after a restart")
modules.start_module("c")
events()

-- Reload: the file is read again; modules that need it restart; the order stays
stand.write_file($"{dir}a.pluto", module_file("a", "", 2))
stand.check(modules.reload_module("a"), "reload returns true")
stand.equal(events(), "stop c v1, stop b v1, stop a v1, start a v2, start b v1, start c v1", "reload restarts the dependents")
stand.equal(table.concat(modules.names(), ","), "a,b,c,d,e", "the order is kept")

-- Reload of a broken file: the old version comes back and runs
stand.write_file($"{dir}a.pluto", "this is not lua (")
stand.clear_logs()
stand.check(not modules.reload_module("a"), "a broken file returns false")
stand.equal(events(), "stop c v1, stop b v1, stop a v2, start a v2, start b v1, start c v1", "the old version is back")
stand.check(stand.find_log("'a' not reloaded, the old version is back"), "the failed reload is logged")
stand.equal(table.concat(modules.names(), ","), "a,b,c,d,e", "the order is kept after a failed reload")

-- Module options are checked
local ok, err = pcall(|| -> new Module({ name = "x", deps = "a" }))
stand.check(not ok and tostring(err):find("deps must be a table", 1, true), "deps must be a table")
ok, err = pcall(|| -> modules.add(new Module({ name = "a" })))
stand.check(not ok and tostring(err):find("already registered", 1, true), "names are unique")

-- A dependency cycle is reported, not followed forever
modules.add(new Module({ name = "x", deps = { "y" } }))
modules.add(new Module({ name = "y", deps = { "x" } }))
stand.clear_logs()
modules.start()
stand.check(stand.find_log("dependency cycle: x -> y -> x"), "a cycle is logged")

-- System modules: the ones whose manifest is in systems\ of a folder load_dir read, or says "system": true
local sys_dir = stand.tmpdir("module_manager_systems")
io.makedirs($"{sys_dir}systems/Tool")
stand.write_file($"{sys_dir}plain.pluto", module_file("plain", "", 1))
stand.write_manifest(sys_dir, "plain", "plain")
stand.write_file($"{sys_dir}flagged.pluto", module_file("flagged", "", 1))
stand.write_manifest(sys_dir, "flagged", "flagged", ', "system": true')
stand.write_file($"{sys_dir}systems/Tool/Tool.pluto", module_file("tool", "", 1))
stand.write_file($"{sys_dir}systems/Tool/info.json", '{"id": "tool", "entry": "Tool.pluto"}')
-- A file of the module's folder that isn't its entry (a helper): not a module, not run
stand.write_file($"{sys_dir}systems/Tool/helper.pluto", "LOADED.tool_helper = 1\nreturn { x = 1 }\n")
local names_before = #modules.names()
stand.equal(modules.load_dir(sys_dir), 3, "the three manifests' modules, the helper isn't one")
stand.equal(#modules.names() - names_before, 3, "and no more than them")
stand.check(modules.is_system("tool"), "a module in systems\\ is a system one")
stand.check(modules.get("tool").system, "its instance says so too")
stand.check(modules.is_system("flagged"), "so is one whose manifest says \"system\": true")
stand.check(not modules.is_system("plain"), "one next to systems\\ isn't")
stand.check(not modules.is_system("a"), "nor one from another folder")
stand.check(not modules.is_system("x"), "nor one made in code")
stand.equal(modules.load_new(), 0, "load_new: nothing new")

-- is_running by name: false for a module that isn't there
modules.start_module("tool")
stand.check(modules.is_running("tool"), "is_running: a running module")
stand.check(modules.is_system("tool") and modules.get("tool").loaded, "still a system one after its file ran")
stand.equal(LOADED.tool_helper, nil, "the helper next to it wasn't run")
modules.stop_module("tool")
stand.check(not modules.is_running("tool"), "a stopped one isn't")
stand.check(not modules.is_running("no_such_module"), "nor one that isn't there (no error)")

-- hand_over / take_over: what an instance leaves for the next one, taken once
local handed = { kept = 1 }
modules.hand_over("tool", handed)
stand.equal(modules.take_over("tool"), handed, "take_over gives what was handed over")
stand.equal(modules.take_over("tool"), nil, "only once")

-- ─── Manifests ───────────────────────────────────────────────────────────────

-- A module's file that leaves its name to the manifest
local function manifest_module(id: string): string
    return "LOADED['" .. id .. "'] = (LOADED['" .. id .. "'] or 0) + 1\n"
        .. "local Module = Atdar.loader.load('core/module')\n"
        .. "return Atdar.modules.add(new Module({ on_start = function() table.insert(EVENTS, 'start " .. id .. "') end }))\n"
end

local man_dir = stand.tmpdir("module_manager_manifests")
for _, folder in { "full/code", "with_main", "with_init" } do
    io.makedirs(man_dir .. folder)
end
-- A folder with every field, its entry in a subfolder
stand.write_file($"{man_dir}full/info.json", '{"id": "m_full", "name": "Full Module", "version": "1.2.3", "author": "Tester",'
    .. ' "entry": "code/start.pluto", "enabled": true, "system": false, "dependencies": ["m_base"]}')
stand.write_file($"{man_dir}full/code/start.pluto", manifest_module("m_full"))
-- A single file: <name>.info.json, the entry <name>.pluto
stand.write_manifest(man_dir, "m_base", "m_base")
stand.write_file($"{man_dir}m_base.pluto", manifest_module("m_base"))
-- A folder without "entry": main.pluto, or init.pluto when there's no main
stand.write_file($"{man_dir}with_main/info.json", '{"id": "m_main"}')
stand.write_file($"{man_dir}with_main/main.pluto", manifest_module("m_main"))
stand.write_file($"{man_dir}with_main/init.pluto", "error('main.pluto comes first')\n")
stand.write_file($"{man_dir}with_init/info.json", '{"id": "m_init"}')
stand.write_file($"{man_dir}with_init/init.pluto", manifest_module("m_init"))
-- Not started by itself; one that needs it starts it
stand.write_manifest(man_dir, "off", "m_off", ', "enabled": false')
stand.write_file($"{man_dir}off.pluto", manifest_module("m_off"))
stand.write_manifest(man_dir, "needs_off", "m_needs_off", ', "enabled": false, "dependencies": ["m_off"]')
stand.write_file($"{man_dir}needs_off.pluto", manifest_module("m_needs_off"))
-- Files that don't do what the manifest says
stand.write_manifest(man_dir, "wrong_name", "m_wrong")
stand.write_file($"{man_dir}wrong_name.pluto", "local Module = Atdar.loader.load('core/module')\n"
    .. "return Atdar.modules.add(new Module({ name = 'm_other' }))\n")
stand.write_manifest(man_dir, "silent", "m_silent")
stand.write_file($"{man_dir}silent.pluto", "return {}\n")
-- Sound manifests whose entry file isn't there, or isn't in the manifest's folder: registered, failed
stand.write_manifest(man_dir, "no_entry", "m_no_entry")
stand.write_file($"{man_dir}outside.info.json", '{"id": "m_outside", "entry": "../module_manager/a.pluto"}')
-- Manifests that can't be used
stand.write_file($"{man_dir}broken.info.json", '{"id": "m_broken", ')
stand.write_file($"{man_dir}broken.pluto", manifest_module("m_broken"))
stand.write_file($"{man_dir}no_id.info.json", '{"name": "No Id"}')
stand.write_file($"{man_dir}typo.info.json", '{"id": "m_typo", "dependancies": []}')
stand.write_file($"{man_dir}bad_deps.info.json", '{"id": "m_bad_deps", "dependencies": "m_base"}')
stand.write_file($"{man_dir}bad_enabled.info.json", '{"id": "m_bad_enabled", "enabled": "yes"}')
-- The same id again (sorted after m_base's own manifest)
stand.write_file($"{man_dir}zz_dup.info.json", '{"id": "m_base", "entry": "m_base.pluto"}')

LOADED = {}
events()
stand.clear_logs()
stand.equal(modules.load_dir(man_dir), 10, "the ten sound manifests' modules are registered")
stand.equal(next(LOADED), nil, "and no module file ran")

-- What can't be used is logged and skipped, the rest is there
stand.check(stand.find_log("broken.info.json\n    isn't a JSON object"), "broken JSON: logged")
stand.check(stand.find_log("no_id.info.json\n    id must be a non-empty string"), "no id: logged")
stand.check(stand.find_log("typo.info.json\n    fields: unknown 'dependancies'"), "a typo in a field: logged")
stand.check(stand.find_log("bad_deps.info.json\n    dependencies must be a table, got string"), "dependencies of a wrong type: logged")
stand.check(stand.find_log("bad_enabled.info.json\n    enabled must be a boolean, got string"), "enabled of a wrong type: logged")
-- No entry file: the module is there, failed with the reason, for the Modules list to show
stand.equal(modules.get("m_no_entry").status, "failed", "no entry file: registered as failed")
stand.check(modules.get("m_no_entry").error:find("entry not found: no_entry.pluto", 1, true), "with the reason")
stand.check(stand.find_log("| m_no_entry | ERROR] entry not found: no_entry.pluto"), "and it's logged")
stand.check(modules.get("m_no_entry"):folder() ~= nil and modules.file_of("m_no_entry") == nil, "it has a folder, no file")
stand.equal(modules.get("m_outside").status, "failed", "an entry outside the manifest's folder: failed too")
stand.check(modules.get("m_outside").error:find("entry '../module_manager/a.pluto'", 1, true), "with the reason")
stand.check(not modules.start_module("m_no_entry") and modules.get("m_no_entry").status == "failed",
    "Start looks for the file again: still not there")
stand.check(stand.find_log("module 'm_base' is already registered, the duplicate is skipped"), "the same id again: a warning")
for _, id in { "m_broken", "m_typo", "m_bad_deps", "m_bad_enabled" } do
    stand.check(not modules.has(id), $"{id} isn't registered")
end

-- A path with / only: a listing gives a subfolder's files with \
local function slashed(path: ?string): ?string
    return path and path:gsub("\\", "/")
end

-- The manifest's fields are on the stand-in
local full = modules.get("m_full")
stand.check(full.id == "m_full" and full.name == "m_full", "id: the module's name")
stand.equal(full.display_name, "Full Module", "name: how it's shown")
stand.equal(full.version, "1.2.3", "version")
stand.equal(full.author, "Tester", "author")
stand.check(full.enabled == true and full.system == false and full.loaded == false, "enabled, system, and not loaded yet")
stand.equal(table.concat(full.deps, ","), "m_base", "dependencies")
stand.equal(slashed(modules.file_of("m_full")), slashed($"{man_dir}full/code/start.pluto"), "entry: from the manifest's folder")
stand.equal(slashed(full:folder()), slashed($"{man_dir}full/"), "folder(): the manifest's, not the entry's")
stand.equal(slashed(modules.manifest_of("m_full").path), slashed($"{man_dir}full/info.json"), "manifest_of: the manifest read")
stand.equal(modules.get("m_base").display_name, "m_base", "no name: the id is shown")
stand.equal(modules.file_of("m_base"), $"{man_dir}m_base.pluto", "a single file's entry: <name>.pluto")
stand.equal(slashed(modules.file_of("m_main")), slashed($"{man_dir}with_main/main.pluto"), "a folder's entry: main.pluto first")
stand.equal(slashed(modules.file_of("m_init")), slashed($"{man_dir}with_init/init.pluto"), "init.pluto when there's no main")

-- Starting loads the file, its dependencies first; the module made by the file has the manifest's fields
stand.check(modules.start_module("m_full"), "a module starts from its manifest")
stand.equal(events(), "start m_base, start m_full", "the manifest's dependencies start first")
stand.check(LOADED.m_full == 1 and LOADED.m_base == 1 and LOADED.m_main == nil, "only the files needed ran")
full = modules.get("m_full")
stand.check(full.loaded and full.name == "m_full", "a file that leaves the name out: the manifest's id")
stand.check(full.display_name == "Full Module" and full.version == "1.2.3" and full.author == "Tester",
    "the module made by the file has the manifest's fields")
stand.equal(table.concat(full.deps, ","), "m_base", "and its dependencies")

-- enabled: false - registered, not started by start(); started by hand, or for a module that needs it
modules.start()
stand.check(modules.is_running("m_main") and modules.is_running("m_init"), "start() starts the enabled ones")
stand.check(LOADED.m_full == 1, "a file that ran isn't run again")
stand.check(modules.get("m_off").status == "registered" and LOADED.m_off == nil, "enabled: false - not started, its file not run")
events()
stand.check(modules.start_module("m_needs_off"), "started by hand")
stand.equal(events(), "start m_off, start m_needs_off", "and what it needs starts with it, disabled or not")

-- A file that registers another name, or nothing: the module fails, nothing else is registered
stand.equal(modules.get("m_wrong").status, "failed", "a file registering another name fails")
stand.check(modules.get("m_wrong").error:find("the name must be the manifest's id", 1, true), "and says why")
stand.check(not modules.has("m_other"), "the other name isn't registered")
stand.equal(modules.get("m_silent").status, "failed", "a file that registers nothing fails")
stand.check(modules.get("m_silent").error:find("didn't register the module", 1, true), "and says why")
stand.write_file($"{man_dir}silent.pluto", manifest_module("m_silent"))
stand.equal(modules.file_changed("m_silent"), true, "a failed module's file edited since: changed")
stand.check(modules.reload_module("m_silent") and modules.get("m_silent").loaded, "Reload gives it another try")

-- load_new: a manifest that couldn't be used before and can now, and a manifest that's new
stand.write_file($"{man_dir}broken.info.json", '{"id": "m_broken"}')
stand.write_file($"{man_dir}no_entry.pluto", manifest_module("m_no_entry"))
stand.equal(modules.load_new(), 1, "load_new registers the mended manifest's module")
stand.check(modules.is_running("m_broken"), "and starts it")
stand.check(modules.is_running("m_no_entry") and modules.get("m_no_entry").loaded, "a module whose entry file came since starts too")
stand.equal(modules.load_new(), 0, "once")

-- Reload reads the manifest again too
stand.write_file($"{man_dir}full/info.json", '{"id": "m_full", "name": "Fuller Module", "version": "2.0.0",'
    .. ' "entry": "code/start.pluto", "dependencies": ["m_base", "m_main"]}')
stand.equal(modules.file_changed("m_full"), true, "an edited manifest: changed")
stand.check(modules.reload_module("m_full"), "reload with a new manifest")
full = modules.get("m_full")
stand.check(full.version == "2.0.0" and full.display_name == "Fuller Module" and full.author == nil,
    "the new manifest's fields")
stand.equal(table.concat(full.deps, ","), "m_base,m_main", "and dependencies")
stand.equal(LOADED.m_full, 2, "the file ran again")
stand.equal(modules.file_changed("m_full"), false, "not changed any more")
modules.stop_module("m_main")
stand.check(not modules.is_running("m_full"), "the new dependency counts: stopping it stops the module")
modules.start_module("m_full")
-- A manifest broken since: the one read before stays in use
stand.write_file($"{man_dir}full/info.json", "not json")
stand.clear_logs()
stand.check(modules.reload_module("m_full"), "reload with a broken manifest still reloads the file")
stand.check(stand.find_log("its manifest can't be used, the one read before stays"), "and says the old manifest stays")
stand.equal(modules.get("m_full").version, "2.0.0", "the fields of the one read before")

-- ─── A module of several files: load_file ────────────────────────────────────

local parts_dir = stand.tmpdir("module_manager_parts")
io.makedirs($"{parts_dir}Parts/sub")
local function helper_file(value: int): string
    return "LOADED.helper = (LOADED.helper or 0) + 1\nreturn { value = " .. value .. " }\n"
end
stand.write_file($"{parts_dir}Parts/info.json", '{"id": "m_parts", "entry": "Parts.pluto"}')
stand.write_file($"{parts_dir}Parts/Parts.pluto", "local Module = Atdar.loader.load('core/module')\n"
    .. "local class Parts extends Module\n"
    .. "    function __construct()\n"
    .. "        parent:__construct({})\n"
    .. "        self.helper = self:load_file('sub/helper')\n"
    .. "    end\n"
    .. "    function value() return self:load_file('sub/helper').value end\n"
    .. "end\n"
    .. "return Atdar.modules.add(new Parts())\n")
stand.write_file($"{parts_dir}Parts/sub/helper.pluto", helper_file(1))
LOADED = {}
stand.equal(modules.load_dir(parts_dir), 1, "a module of two files: one manifest, one module")
stand.check(modules.start_module("m_parts"), "it starts")
stand.equal(modules.get("m_parts"):value(), 1, "self:load_file gives what the module's other file returns")
stand.equal(LOADED.helper, 1, "the file ran once for the instance, however many times it's asked for")
stand.equal(modules.file_changed("m_parts"), false, "nothing edited: not changed")
stand.write_file($"{parts_dir}Parts/sub/helper.pluto", helper_file(2))
stand.equal(modules.file_changed("m_parts"), true, "the other file edited: the module is changed")
stand.equal(modules.get("m_parts"):value(), 1, "the code that runs is still the old one")
stand.check(modules.reload_module("m_parts"), "Reload")
stand.equal(modules.get("m_parts"):value(), 2, "reads the module's other files again")
stand.equal(modules.file_changed("m_parts"), false, "and it isn't changed any more")
stand.check(modules.loaded_text_of(modules.get("m_parts"):folder() .. "sub\\helper.pluto") ~= nil,
    "the file's text is kept for reading its functions' source")
-- A broken other file: the reload fails, the old module and its files stay
stand.write_file($"{parts_dir}Parts/sub/helper.pluto", "this is not lua (")
stand.check(not modules.reload_module("m_parts"), "a broken other file: the reload fails")
stand.check(modules.is_running("m_parts") and modules.get("m_parts"):value() == 2, "the old version is back and runs")
stand.equal(modules.file_changed("m_parts"), true, "still changed: the file differs from the code that runs")
-- Only the module's own folder, only a module with one
ok, err = pcall(|| -> modules.get("m_parts"):load_file("../../module_manager/a"))
stand.check(not ok and tostring(err):find("[Module 'm_parts'] load_file", 1, true), "a file outside the module's folder is an error")
ok, err = pcall(|| -> modules.get("x"):load_file("anything"))
stand.check(not ok and tostring(err):find("isn't a module with a folder", 1, true), "so is one asked by a module made in code")

stand.finish()
