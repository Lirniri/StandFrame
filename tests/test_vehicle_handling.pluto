-- The handling group: natives.memory.handling / vehicle / holds and util.game.vehicle (handling, on_current, drift_mode,
-- lessen_burnouts, heli_stabilisation, gravity, drive_on_water, forge_model) on a fake game: a table of memory cells and
-- fake natives. The layout of the memory is Stand-OSS's and not checked in the game, so this checks the logic around it:
-- reading and writing by name, the holders, the way back, the current vehicle pattern
local stand = require("stand")
stand.boot()
Atdar.util = Atdar.loader.load("utils/util")
Atdar.util.game = Atdar.loader.load("utils/util/game")
Atdar.natives = Atdar.loader.auto({}, "natives")
_G.v3 = { new = function(x, y, z) if type(x) == "table" then return x end return { x = x, y = y, z = z } end }
util.is_session_started = || -> stand.online
util.get_ground_z = || -> false, 0.0

Atdar.memory = { handle_to_pointer = |h| -> entities.handle_to_pointer(h) }

local mem_handling = Atdar.natives.memory.handling
local mem_vehicle = Atdar.natives.memory.vehicle
local holds = Atdar.natives.memory.holds
local handling = Atdar.util.game.vehicle.handling
local on_current = Atdar.util.game.vehicle.on_current

-- ─── A fake memory ───────────────────────────────────────────────────────────

-- One cell per address: the cell holds what was last written there, as a number
local cells = {}
_G.memory = {
    read_float = |a| -> cells[a] or 0.0,
    read_int = |a| -> cells[a] or 0,
    read_long = |a| -> cells[a] or 0,
    read_short = |a| -> cells[a] or 0,
    read_byte = |a| -> cells[a] or 0,
    write_float = function(a, v) cells[a] = v end,
    write_int = function(a, v) cells[a] = v end,
    write_ubyte = function(a, v) cells[a] = v end,
    alloc = function(size) return 0x900000 end,
    free = function(a) end,
}

-- Vehicles: handle -> pointer, the handling data they share, their model
local PTR = { [500] = 0x100000, [501] = 0x110000, [502] = 0x120000, [503] = 0x130000, [504] = 0x140000 }
local MODEL = { [500] = 1000, [501] = 1001, [502] = 2000, [503] = 3000, [504] = 4000 }
local DATA_CAR, DATA_BIKE, DATA_HELI, DATA_BOAT = 0x200000, 0x210000, 0x220000, 0x230000
local SUB_CAR, SUB_FLY = 0x400000, 0x420000
local VT_CAR = 0x7001

local function put(data: int, offset: int, value: any): void
    cells[data + offset] = value
end

-- Cars 500 and 501 share one data with one sub (a car's); 502 is a bike, 503 a heli with a flying sub, 504 a boat
for _, handle in { 500, 501 } do
    cells[PTR[handle] + 0x960] = DATA_CAR
    cells[PTR[handle] + 0x20] = 0x500000 + handle
    cells[0x500000 + handle + 0x18] = MODEL[handle]
    cells[PTR[handle] + 0xC9C] = 9.8
end
cells[DATA_CAR + 0x158] = 0x300000
cells[DATA_CAR + 0x158 + 8] = 1
cells[0x300000] = SUB_CAR
cells[SUB_CAR] = VT_CAR
put(DATA_CAR, 0x0C, 1500.0)    -- mass
put(DATA_CAR, 0x48, 0.5)       -- drive_bias_front
put(DATA_CAR, 0x4C, 0.3)       -- acceleration
put(DATA_CAR, 0x90, 2.0)       -- traction_curve_min
put(DATA_CAR, 0x88, 2.1)       -- traction_curve_max
put(DATA_CAR, 0xA8, 1.0)       -- low_speed_traction_loss_mult
put(DATA_CAR, 0x20, 0.1)       -- centre_of_mass x
put(DATA_CAR, 0x24, 0.2)
put(DATA_CAR, 0x28, 0.3)
put(DATA_CAR, 0x13C, 12345)    -- ai_handling_hash
SUB_CAR_FLAGS = SUB_CAR + 0x3C
cells[SUB_CAR + 0x3C] = 0x1     -- aflags

cells[PTR[502] + 0x960] = DATA_BIKE
cells[DATA_BIKE + 0x158 + 8] = 0
cells[PTR[503] + 0x960] = DATA_HELI
cells[DATA_HELI + 0x158] = 0x310000
cells[DATA_HELI + 0x158 + 8] = 1
cells[0x310000] = SUB_FLY
cells[SUB_FLY] = 0x7002
cells[SUB_FLY + 0xC8] = 1
put(SUB_FLY, 0x08, 10.0)       -- thrust
put(SUB_FLY, 0x48, 1.5)        -- attack_lift_mult
put(SUB_FLY, 0x4C, 1.6)        -- attack_dive_mult
put(SUB_FLY, 0x3C, 4.0)        -- pitch_stabilise
put(SUB_FLY, 0x30, 5.0)        -- roll_stabilise
put(SUB_FLY, 0x20, 6.0)        -- yaw_stabilise
put(SUB_FLY, 0x58, 2.0)        -- wind_mult
cells[PTR[504] + 0x960] = DATA_BOAT
cells[DATA_BOAT + 0x158 + 8] = 0

-- ─── Fake natives ────────────────────────────────────────────────────────────

local game = {
    vehicle = 0, driver = true, ped = 100, speed = 0.0, snow = 0.0,
    kind = { [1000] = "car", [1001] = "car", [2000] = "bike", [3000] = "heli", [4000] = "boat" },
    calls = {}, coords = {}, rot = {}, upside_down = false, water = 5.0, objects = {}, next_object = 800,
    loaded = false, hash = {}, visible = {}, frozen = {},
}
local function call(name, ...) table.insert(game.calls, table.concat({ name, ... }, " ")) end
local function count_calls(prefix: string): int
    local n = 0
    for _, line in game.calls do
        if line:sub(1, #prefix) == prefix then
            n += 1
        end
    end
    return n
end
_G.entities = {
    handle_to_pointer = |h| -> PTR[h] or 0x600000 + h,
    get_user_vehicle_as_handle = || -> game.vehicle,
    set_gravity_multiplier = function(pointer, mult) call("gravity_mult", mult) cells[pointer + 0xC9C] = mult * 9.8000002 end,
}
_G.PLAYER = { PLAYER_ID = || -> 0, PLAYER_PED_ID = || -> game.ped }
_G.ENTITY = {
    DOES_ENTITY_EXIST = |h| -> h ~= 0 and h ~= -1 and not (game.gone or {})[h],
    IS_ENTITY_A_VEHICLE = |h| -> h >= 500 and h < 600,
    GET_ENTITY_MODEL = |h| -> MODEL[h] or 0,
    GET_ENTITY_SPEED = |h| -> game.speed,
    GET_ENTITY_COORDS = |h| -> game.coords[h] or { x = 0.0, y = 0.0, z = 0.0 },
    GET_ENTITY_ROTATION = |h| -> game.rot[h] or { x = 0.0, y = 0.0, z = 0.0 },
    GET_ENTITY_FORWARD_VECTOR = |h| -> { x = 0.0, y = 1.0, z = 0.0 },
    IS_ENTITY_UPSIDEDOWN = |h| -> game.upside_down,
    SET_ENTITY_COORDS_NO_OFFSET = function(h, x, y, z) game.coords[h] = { x = x, y = y, z = z } call("coords", h) end,
    SET_ENTITY_ROTATION = function(h, x, y, z) game.rot[h] = { x = x, y = y, z = z } end,
    FREEZE_ENTITY_POSITION = function(h, on) game.frozen[h] = on end,
    SET_ENTITY_VISIBLE = function(h, on) game.visible[h] = on end,
    SET_ENTITY_NO_COLLISION_ENTITY = function(a, b) call("no_collision", a, b) end,
    DELETE_ENTITY = function(h) call("delete", h) game.gone = game.gone or {} game.gone[h] = true end,
}
_G.OBJECT = {
    CREATE_OBJECT = function(hash, x, y, z)
        game.next_object += 1
        game.coords[game.next_object] = { x = x, y = y, z = z }
        call("create", game.next_object)
        return game.next_object
    end,
}
_G.STREAMING = {
    HAS_MODEL_LOADED = |hash| -> game.loaded,
    REQUEST_MODEL = |hash| -> call("request"),
    SET_MODEL_AS_NO_LONGER_NEEDED = |hash| -> call("no_longer_needed"),
}
_G.WATER = {
    TEST_VERTICAL_PROBE_AGAINST_ALL_WATER = function(x, y, z, flags, ptr)
        if game.water == nil then
            return 0
        end
        cells[ptr] = game.water
        return 1
    end,
}
_G.MISC = { GET_SNOW_LEVEL = || -> game.snow }
_G.VEHICLE = {
    IS_THIS_MODEL_A_CAR = |m| -> game.kind[m] == "car",
    IS_THIS_MODEL_A_BIKE = |m| -> game.kind[m] == "bike",
    IS_THIS_MODEL_A_BICYCLE = |m| -> false,
    IS_THIS_MODEL_A_QUADBIKE = |m| -> false,
    IS_THIS_MODEL_A_BOAT = |m| -> game.kind[m] == "boat",
    IS_THIS_MODEL_A_JETSKI = |m| -> false,
    IS_THIS_MODEL_A_HELI = |m| -> game.kind[m] == "heli",
    IS_THIS_MODEL_A_PLANE = |m| -> game.kind[m] == "plane",
    IS_THIS_MODEL_A_TRAIN = |m| -> false,
    GET_PED_IN_VEHICLE_SEAT = |h, seat| -> game.driver and game.ped or 0,
    MODIFY_VEHICLE_TOP_SPEED = |h, v| -> call("top_speed", v),
}
util.is_this_model_a_blimp = || -> false
util.is_this_model_a_trailer = || -> false
util.is_this_model_a_submarine = || -> false

local function approx(a: number, b: number): bool
    return math.abs(a - b) < 0.001
end

-- ─── natives.memory.vehicle ──────────────────────────────────────────────────

stand.equal(mem_vehicle.get_handling_data(500), DATA_CAR, "the handling data is behind the vehicle's pointer")
stand.equal(mem_vehicle.get_handling_data(999), nil, "a handle that is not a vehicle has none")
stand.check(mem_vehicle.get_pointer(-1) == nil, "no vehicle, no pointer")
stand.equal(mem_vehicle.get_archetype_hash(500), 1000, "the hash of the model info")
stand.check(approx(mem_vehicle.get_gravity(500), 9.8), "the gravity of the wheels")

-- ─── natives.memory.handling: the layout ─────────────────────────────────────

stand.check(mem_handling.has_field("mass") and mem_handling.has_field("boat.keel_sphere_size"), "plain and section names are fields")
stand.check(mem_handling.has_field("drive_bias_front") and mem_handling.has_field("thrust"), "a name only one section has works plain")
stand.check(not mem_handling.has_field("turn_res") and mem_handling.has_field("flying.turn_res") and mem_handling.has_field("submarine.turn_res"),
    "a name in two sections needs its section")
stand.equal(mem_handling.get_field_type("centre_of_mass"), "vec3", "a vec3 field says so")
stand.equal(mem_handling.get_field_type("nothing"), nil, "an unknown field has no type")
stand.check(#mem_handling.get_field_names("weapon") > 40 and #mem_handling.get_sections() == 10, "the sections are there, the weapon one with its six of each")

stand.check(approx(mem_handling.get(500, "mass"), 1500.0), "get reads a float")
local com = mem_handling.get(500, "centre_of_mass")
stand.check(approx(com.x, 0.1) and approx(com.y, 0.2) and approx(com.z, 0.3), "get reads a vec3")
stand.equal(mem_handling.get(500, "ai_handling_hash"), 12345, "get reads a hash")
stand.equal(mem_handling.get(500, "car.aflags"), nil, "the car sub handling data is not known before it is learned")
stand.equal(#mem_handling.list_subs(500), 1, "list_subs shows what a vehicle has")
stand.check(mem_handling.learn_sub(500, "car"), "a vehicle with one sub teaches the car vtable")
stand.equal(mem_handling.get_sub(500, "car"), SUB_CAR, "and then the car sub is found")
stand.equal(mem_handling.get(500, "aflags"), 1, "so its fields are read")
stand.equal(mem_handling.get_sub(503, "flying"), SUB_FLY, "the flying sub is told by its own type field")
stand.equal(mem_handling.get_sub(503, "boat"), nil, "a vehicle without that sub gives nil")
stand.check(not mem_handling.learn_sub(503, "flying") or mem_handling.get_sub(503, "flying") == SUB_FLY, "learning a flying sub changes nothing")
stand.equal(mem_handling.get(504, "mass"), 0.0, "a vehicle with an empty data reads zeros")

-- ─── natives.memory.handling: writing, holders, the way back ─────────────────

stand.check(mem_handling.set(500, "mass", 3000.0), "set writes")
stand.check(approx(mem_handling.get(501, "mass"), 3000.0), "the vehicle that shares the data sees it")
stand.check(approx(mem_handling.get_original(501, "mass"), 1500.0), "the original is kept")
stand.check(mem_handling.is_changed(500, "mass"), "it is changed")
stand.check(not mem_handling.set(500, "mass", "heavy"), "a value of the wrong type is refused")
stand.check(not mem_handling.set(500, "no_such_field", 1.0), "an unknown field is refused")
stand.check(not mem_handling.set(503, "boat.keel_sphere_size", 1.0), "a field of a sub the vehicle lacks is refused")
stand.check(mem_handling.set(500, "mass", 3500.0, "other"), "a second holder writes the same field")
stand.check(approx(mem_handling.get(500, "mass"), 3500.0), "the last holder wins")
stand.check(mem_handling.release(500, "mass", "other"), "the last holder lets go")
stand.check(approx(mem_handling.get(500, "mass"), 3000.0), "so the first one's value is back")
stand.check(mem_handling.release(500, "mass", "user") and approx(mem_handling.get(500, "mass"), 1500.0), "and when none is left the original is back")
stand.check(not mem_handling.is_changed(500, "mass") and #mem_handling.get_changes() == 0, "nothing is left")
stand.check(not mem_handling.release(500, "mass", "user"), "letting go twice says no")

stand.check(mem_handling.set(500, "centre_of_mass", { x = 1.0, y = 2.0, z = 3.0 }), "a vec3 is written from a table")
stand.check(approx(cells[DATA_CAR + 0x28], 3.0), "all three numbers")
stand.check(not mem_handling.set(500, "centre_of_mass", 1.0), "a vec3 needs a table")
mem_handling.reset(500)
stand.check(approx(cells[DATA_CAR + 0x28], 0.3), "reset gives the vec3 back")

stand.check(mem_handling.set_bits(500, "aflags", 0x30, true, "a"), "bits are put on")
stand.check(mem_handling.set_bits(500, "aflags", 0x100, true, "b"), "by a second holder too")
stand.equal(cells[SUB_CAR_FLAGS], 0x131, "both stay with the old ones")
stand.check(mem_handling.set_bits(500, "aflags", 0x1, false, "b"), "a holder takes a bit out")
stand.equal(cells[SUB_CAR_FLAGS], 0x130, "and it is out")
stand.check(mem_handling.release(500, "aflags", "a"), "one holder lets go")
stand.equal(cells[SUB_CAR_FLAGS], 0x100, "the other one's bits stay: the first holder's bit is gone, the cleared one still is")
mem_handling.release(500, "aflags", "b")
stand.equal(cells[SUB_CAR_FLAGS], 0x1, "and the flags are as they were")
stand.check(not mem_handling.set_bits(500, "mass", 1, true), "bits of a float are refused")

-- A change through a model comes back without the vehicle
mem_handling.set(500, "acceleration", 9.0)
mem_handling.set(503, "attack_lift_mult", 0.0)
game.gone = { [500] = true, [503] = true }
stand.equal(mem_handling.reset_model(1000), 1, "reset_model gives back what a model changed, the vehicle gone or not")
stand.check(approx(cells[DATA_CAR + 0x4C], 0.3), "the main field is back")
stand.check(approx(cells[SUB_FLY + 0x48], 0.0), "a field of another model stays")
stand.equal(mem_handling.reset_all(), 1, "reset_all gives the rest back, also a field of a sub handling data")
stand.check(approx(cells[SUB_FLY + 0x48], 1.5), "the flying field is back")
game.gone = {}

mem_handling.set(500, "acceleration", 7.0, "x")
mem_handling.set(500, "mass", 1.0, "x")
mem_handling.set(500, "mass", 2.0, "y")
stand.equal(mem_handling.release_holder("x"), 2, "release_holder lets go everywhere")
stand.check(approx(cells[DATA_CAR + 0x4C], 0.3) and approx(cells[DATA_CAR + 0x0C], 2.0), "what another holder has stays")
mem_handling.reset(500)

-- ─── util.game.vehicle.handling ──────────────────────────────────────────────

game.vehicle = 500
stand.check(handling.set(nil, "drive_bias_front", 0.9), "no vehicle means the one the player is in")
stand.check(approx(handling.get(nil, "drive_bias_front"), 0.9), "get reads it")
stand.equal(handling.set_many(500, { mass = 2000.0, acceleration = 0.8, nothing = 1 }), 2, "set_many says how many were written")
stand.check(handling.scale(500, "acceleration", 2.0) and handling.scale(500, "acceleration", 2.0) and approx(handling.get(500, "acceleration"), 0.6),
    "scale is of the original, twice is not a square")
local all = handling.get_all(500, "main")
stand.check(approx(all.mass, 2000.0) and all.thrust == nil, "get_all reads a section")
stand.equal(handling.reset(500), 3, "reset gives back every field")
stand.check(approx(handling.get(500, "mass"), 1500.0) and approx(handling.get(500, "drive_bias_front"), 0.5), "to what they were")
game.vehicle = 0
stand.check(not handling.set(nil, "mass", 1.0), "with no vehicle there is nothing to set")
handling.set(500, "mass", 1.0)
stand.equal(handling.reset_all(), 1, "reset_all")
stand.check(approx(cells[DATA_CAR + 0x0C], 1500.0), "gives it back")

-- ─── holds ───────────────────────────────────────────────────────────────────

local made, undone = 0, 0
local function apply() made += 1 end
local function undo() undone += 1 end
stand.check(holds.acquire("k", "a", apply, undo), "the first holder makes the change")
stand.check(not holds.acquire("k", "b", apply, undo) and made == 1, "the second one does not make it again")
stand.check(not holds.acquire("k", "b", apply, undo) and holds.get_count("k") == 2, "a holder counts once")
stand.check(not holds.release("k", "a") and undone == 0 and holds.is_held("k"), "a release with another holder left undoes nothing")
stand.check(holds.release("k", "b") and undone == 1 and not holds.is_held("k"), "the last release undoes")
stand.check(not holds.release("k", "b"), "a holder that holds nothing gives false")
stand.check(not holds.acquire("bad", "a", || -> error("boom"), undo) and not holds.is_held("bad"), "an apply that fails holds nothing")

stand.check(holds.acquire_nop("roll", "a", 0x500100, 3), "acquire_nop patches the code")
stand.check(Atdar.natives.memory.patch.is_patched("roll") and cells[0x500100] == 0x90, "the bytes are NOP")
stand.check(not holds.acquire_nop("roll", "b", 0x500100, 3), "a second holder does not patch again")
holds.release("roll", "a")
stand.check(Atdar.natives.memory.patch.is_patched("roll"), "the patch stays for the other holder")
holds.release("roll", "b")
stand.check(not Atdar.natives.memory.patch.is_patched("roll"), "and goes with the last")
holds.acquire("left", "a", nil, undo)
local before = undone
holds.release_all()
stand.equal(undone, before + 1, "release_all runs the undo of what is held")

-- ─── on_current ──────────────────────────────────────────────────────────────

local kinds = on_current.get_kinds(MODEL[503])
stand.check(kinds.heli and kinds.air and not kinds.car, "a heli is of the kinds heli and air")
stand.check(on_current.get_kinds(MODEL[504]).aquatic, "a boat is aquatic")
stand.check(on_current.passes({ car = true }, { "car" }, nil) and not on_current.passes({ car = true }, { "bike" }, nil), "only")
stand.check(not on_current.passes({ car = true, air = true }, nil, { "air" }) and on_current.passes({ car = true }, nil, { "air" }), "except")

local log_of = {}
local behaviour = on_current.create("Test", {
    except = { "bike" },
    change = function(vehicle, model, b) table.insert(log_of, "change " .. vehicle) b.store[model] = { vehicle = vehicle } end,
    undo = function(vehicle, model, b) table.insert(log_of, "undo " .. vehicle) b.take(model) end,
    frame = function(vehicle) table.insert(log_of, "frame " .. vehicle) end,
})
stand.check(not pcall(on_current.create, "x", { change = || -> nil }), "change and undo are needed")
stand.check(not pcall(on_current.create, "x", { change = || -> nil, undo = || -> nil, wrong = 1 }), "an unknown option is refused")

game.vehicle = 500
behaviour.enable()
behaviour.enable()
stand.frame()
stand.equal(table.concat(log_of, ","), "change 500,frame 500", "the current vehicle is changed once")
stand.frame()
stand.equal(log_of[#log_of], "frame 500", "then it only has frames")
stand.equal(#log_of, 3, "and not changed again")
stand.equal(behaviour.get_vehicle(), 500, "the behaviour says which vehicle")
stand.check(behaviour.store[1000] ~= nil, "the store is of the model")
game.vehicle = 501
stand.frame()
stand.equal(table.concat(log_of, ",", 4), "undo 500,change 501,frame 501", "another vehicle: the old one is undone, the new one changed")
game.vehicle = 502
stand.frame()
stand.equal(log_of[#log_of], "undo 501", "a bike is filtered out")
stand.equal(behaviour.get_vehicle(), nil, "nothing is held")
game.vehicle = 500
game.driver = false
stand.frame()
stand.equal(behaviour.get_vehicle(), nil, "a passenger is not the driver")
game.driver = true
stand.frame()
behaviour.refresh()
stand.frame()
stand.equal(table.concat(log_of, ",", #log_of - 2), "undo 500,change 500,frame 500", "refresh undoes and does again")
local length = #log_of
behaviour.disable()
stand.equal(log_of[length + 1], "undo 500", "disable undoes")
stand.frame()
stand.equal(#log_of, length + 1, "and nothing runs after it")
stand.check(not behaviour.is_enabled(), "it is off")

-- A failing hook switches it off and undoes
local boom = on_current.create("Boom", { change = || -> error("nope"), undo = function() table.insert(log_of, "boom undo") end })
game.vehicle = 500
boom.enable()
stand.frame()
stand.check(not boom.is_enabled(), "an error in a hook stops it")
stand.check(stand.find_log("Boom stopped"), "and is logged")

-- ─── drift mode ──────────────────────────────────────────────────────────────

local drift = Atdar.util.game.vehicle.drift_mode
local function flags(): int return cells[SUB_CAR_FLAGS] end
game.vehicle = 500
game.speed = 20.0
drift.set_preset("loose")
stand.check(table.concat(drift.get_presets(), ",") == "grippy,loose,stand", "the presets")
drift.set_value("handbrake_force", 1.234)
drift.set_value("not_a_field", 1.0)
drift.enable()
stand.check(drift.is_enabled(), "drift is on")
stand.frame()
stand.equal(drift.get_vehicle(), 500, "it holds the car")
stand.check(approx(cells[DATA_CAR + 0x4C], 1.65), "the tune is written: acceleration")
stand.check(approx(cells[DATA_CAR + 0x7C], 1.234), "a number set by hand wins")
stand.check(approx(cells[DATA_CAR + 0x80], 1.3482 * 1.1), "the preset's steering")
stand.check(approx(cells[DATA_CAR + 0x90], 1.625 * 0.9), "the traction is the dry one at speed, times the preset")
stand.equal(flags() & drift.DEFAULT_FLAGS, drift.DEFAULT_FLAGS, "the flags are on, found by learning the car sub")
stand.equal(flags() & drift.FLAG.TRACTION_OFF, 0, "the bits Stand leaves out are not")
stand.equal(count_calls("top_speed 30"), 1, "the top speed is raised")
game.speed = 2.0
stand.frame()
stand.check(approx(cells[DATA_CAR + 0x90], 1.625 * 0.9 * 1.5), "slower: more traction")
game.snow = 0.5
game.speed = 20.0
stand.frame()
stand.check(approx(cells[DATA_CAR + 0x90], 1.925 * 0.9), "snow: the snow values")
game.snow = 0.0
drift.set_traction_scale(0.5)
stand.frame(2)
stand.check(approx(cells[DATA_CAR + 0x90], 1.625 * 0.9 * 0.5), "a changed setting is taken while it is on")
drift.set_flag(drift.FLAG.TRACTION_OFF, true)
stand.frame(2)
stand.check(flags() & drift.FLAG.TRACTION_OFF ~= 0, "a flag set while it is on")
game.vehicle = 502
stand.frame()
stand.check(approx(cells[DATA_CAR + 0x4C], 0.3) and approx(cells[DATA_CAR + 0x90], 2.0), "a bike is not a drift car: the car is back as it was")
stand.equal(flags(), 1, "with the flags as they were")
stand.equal(#mem_handling.get_changes(), 0, "nothing is left changed")
local last_top_speed = nil
for _, line in game.calls do
    if line:sub(1, 9) == "top_speed" then
        last_top_speed = line
    end
end
stand.equal(last_top_speed, "top_speed 10.0", "and the top speed is given back")
game.vehicle = 504
stand.frame()
stand.equal(drift.get_vehicle(), nil, "a boat neither")
drift.clear_values()
game.vehicle = 501
drift.set_traction_scale(1.0)
stand.frame()
stand.check(drift.get_vehicle() == 501 and approx(cells[DATA_CAR + 0x7C], 0.9), "the next car is changed with the cleared values")

-- ─── lessen burnouts, on the same data as drift ──────────────────────────────

local lessen = Atdar.util.game.vehicle.lessen_burnouts
lessen.set_value(0.25)
lessen.enable()
stand.frame()
stand.check(approx(cells[DATA_CAR + 0xA8], 0.25), "the last holder of a field wins: lessen's 0.25 over drift's 0.0")
lessen.disable()
stand.check(approx(cells[DATA_CAR + 0xA8], 0.0), "lessen lets go: drift's value is back, not the original")
lessen.enable()
stand.frame()
drift.disable()
stand.frame()
stand.check(approx(cells[DATA_CAR + 0xA8], 0.25) and approx(cells[DATA_CAR + 0x4C], 0.3), "drift off: its numbers are as they were, lessen's stays")
game.vehicle = 502
stand.frame()
stand.check(approx(cells[DATA_CAR + 0xA8], 1.0), "lessen off the car: the original")
stand.check(lessen.get_vehicle() == 502, "lessen works on a bike too (no filter)")
lessen.disable()
stand.equal(#mem_handling.get_changes(), 0, "nothing is left changed")

-- ─── heli auto stabilisation ─────────────────────────────────────────────────

local stab = Atdar.util.game.vehicle.heli_stabilisation
stab.set_stabilise_scale(0.0)
stab.enable()
game.vehicle = 500
stand.frame()
stand.equal(stab.get_vehicle(), nil, "a car is not a heli")
game.vehicle = 503
stand.frame()
stand.equal(stab.get_vehicle(), 503, "a heli is")
stand.check(approx(cells[SUB_FLY + 0x48], 0.0) and approx(cells[SUB_FLY + 0x58], 0.0), "lift and wind are zero")
stand.check(approx(cells[SUB_FLY + 0x3C], 0.0) and approx(cells[SUB_FLY + 0x30], 0.0), "the stabilisation is scaled")
stand.check(approx(cells[SUB_FLY + 0x08], 13.5), "the thrust is raised by 1.35")
stand.check(approx(stab.get_originals()["flying.thrust"], 10.0), "the originals of the model are kept")
stab.set_thrust_scale(1.0)
stab.set_stabilise_scale(0.5)
stand.frame(2)
stand.check(approx(cells[SUB_FLY + 0x08], 10.0) and approx(cells[SUB_FLY + 0x3C], 2.0), "changed settings are taken while on, of the original")
stab.disable()
stand.check(approx(cells[SUB_FLY + 0x48], 1.5) and approx(cells[SUB_FLY + 0x3C], 4.0) and approx(cells[SUB_FLY + 0x58], 2.0), "disable gives it all back")

-- ─── gravity ─────────────────────────────────────────────────────────────────

local gravity = Atdar.util.game.vehicle.gravity
gravity.set_multiplier(0.5)
gravity.enable()
game.vehicle = 503
stand.frame()
stand.check(approx(cells[PTR[503] + 0xC9C], 9.8000002), "an aircraft keeps the normal gravity (not_in_aircraft)")
gravity.set_not_in_aircraft(false)
stand.frame()
stand.check(approx(cells[PTR[503] + 0xC9C], 4.9000001), "or with that off gets the multiple")
game.vehicle = 500
stand.frame()
stand.check(approx(cells[PTR[500] + 0xC9C], 4.9000001), "a car gets the multiple")
cells[PTR[500] + 0xC9C] = 9.8
stand.frame()
stand.check(approx(cells[PTR[500] + 0xC9C], 4.9000001), "the game writing it back is answered at the next frame")
gravity.disable()
stand.check(approx(cells[PTR[500] + 0xC9C], 9.8), "disable puts the old gravity back")
local entities_backup = _G.entities.set_gravity_multiplier
_G.entities.set_gravity_multiplier = nil
gravity.set_multiplier(2.0)
gravity.enable()
stand.frame()
stand.check(approx(cells[PTR[500] + 0xC9C], 19.6), "without Stand's function the field is written")
gravity.disable()
_G.entities.set_gravity_multiplier = entities_backup

-- ─── drive on water ──────────────────────────────────────────────────────────

local water = Atdar.util.game.vehicle.drive_on_water
game.vehicle = 500
game.coords[500] = { x = 10.0, y = 20.0, z = 4.0 }
water.set_depth(0.3)
stand.online = true
water.enable()
stand.check(not water.is_enabled() and stand.find_log("online"), "online it refuses to start")
stand.online = false
water.enable()
stand.frame()
stand.check(not water.has_block() and count_calls("request") >= 1, "the model is requested, and the block waits for it")
game.loaded = true
stand.frame()
stand.check(water.has_block(), "when the model has loaded the block is made")
local block = game.next_object
stand.check(game.frozen[block] and game.visible[block] == false, "frozen and invisible")
stand.check(count_calls("no_collision " .. block .. " 100") == 1, "with no collision with the player")
stand.check(approx(game.coords[block].z, 5.0 - 0.3), "its top is under the surface by the depth")
stand.check(game.coords[500].z > 4.0, "a vehicle that is under the block is lifted onto it")
game.coords[500] = { x = 10.0, y = 20.0, z = 6.0 }
game.water = 6.0
local moves = count_calls("coords")
game.upside_down = true
stand.frame()
stand.equal(count_calls("coords"), moves, "an upside down vehicle gets no block moves near it")
game.upside_down = false
stand.frame()
stand.check(count_calls("coords") > moves, "the right way up it does")
game.water = nil
stand.frame()
stand.check(not water.has_block() and count_calls("delete " .. block) == 1, "no water below: the block is removed")
game.water = 5.0
stand.frame()
stand.check(water.has_block(), "and made again when there is water")
game.vehicle = 504
stand.frame()
stand.check(not water.has_block(), "a boat is not driven on water: the block is gone")
game.vehicle = 500
stand.frame()
water.disable()
stand.check(not water.has_block() and count_calls("no_longer_needed") >= 1, "disable removes the block and gives the model back")

-- ─── forge model ─────────────────────────────────────────────────────────────

local forge = Atdar.util.game.vehicle.forge_model
local function hash_of(handle: int): int return cells[0x500000 + handle + 0x18] end
game.vehicle = 500
forge.set_model("ruffian")
forge.enable()
stand.frame()
stand.equal(hash_of(500), Atdar.util.hash("ruffian"), "the model info has the forged hash")
game.vehicle = 502
stand.frame()
stand.equal(hash_of(500), 1000, "leaving the vehicle writes the old hash back")
game.vehicle = 500
stand.frame()
forge.set_model(Atdar.util.hash("sultan"))
stand.frame(2)
stand.equal(hash_of(500), Atdar.util.hash("sultan"), "a new model is taken at once")
game.gone = { [500] = true }
game.vehicle = 0
stand.frame()
stand.equal(hash_of(500), 1000, "the hash is written back by the pointer when the vehicle is gone")
game.gone = {}
forge.disable()
stand.online = true
forge.enable()
stand.check(not forge.is_enabled(), "online it refuses to start")
stand.online = false

-- ─── the script stops ────────────────────────────────────────────────────────

game.vehicle = 500
drift.enable()
stand.frame()
stand.check(approx(cells[DATA_CAR + 0x4C], 1.65), "drift is on again")
stand.stop()
stand.check(approx(cells[DATA_CAR + 0x4C], 0.3), "when the script stops, the handling is given back")
stand.equal(#mem_handling.get_changes(), 0, "with nothing left")
stand.equal(flags(), 1, "and the flags")

stand.finish()
