-- Notifications: the profile's notify picks Stand, the game's feed or log only (utils/util.toast via the logger);
-- errors go to Stand unless notify_errors_in_stand is off; a failing feed falls back to Stand
local stand = require("stand")
stand.boot()
stand.store = stand.tmpdir("notify_store")
Atdar.filesystem = Atdar.loader.load("utils/filesystem")
Atdar.util = Atdar.loader.load("utils/util")
Atdar.profile = Atdar.loader.load("core/profile")
Atdar.natives = Atdar.loader.auto({}, "natives")
local profile = Atdar.profile
local Logger = Atdar.loader.load("core/logger")
local log = new Logger("Test")
-- The message card's picture when the profile has its default (core/profile)
local default_picture = profile.default("notify_feed_picture")
-- The default background colours as the game gets them ("r,g,b,a"), whatever they're set to
local color = Atdar.loader.load("utils/color")
local function game_rgba(key)
    local r, g, b, a = color.to_game(color.from_hex(profile.default(key)))
    return $"{r},{g},{b},{a}"
end
-- The checks below expect these values; the defaults in core/profile may be anything
profile.set("notify_feed_style", "ticker")
profile.set("notify_subject_color_day", "white")
profile.set("notify_subject_color_night", "white")
profile.set("notify_flash", false)
profile.set("notify_feed_icon", "CHAT_BOX")
-- Emoticons are checked on their own at the end
profile.set("notify_emoticons", false)

-- The game's feed: what was posted, and how the last post looked
local feed = {}
local text = nil
local look = {}
local script_color = nil
local clock = 12
_G.CLOCK = { GET_CLOCK_HOURS = || -> clock, GET_CLOCK_MINUTES = || -> 0 }
_G.HUD = {
    BEGIN_TEXT_COMMAND_THEFEED_POST = function() text = nil end,
    ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME = function(value) text = value end,
    SET_SCRIPT_VARIABLE_HUD_COLOUR = function(r, g, b, a)
        script_color = $"{r},{g},{b},{a}"
        look.color_sets = (look.color_sets or 0) + 1
    end,
    THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST = function(index) look.background = index end,
    THEFEED_SET_RGBA_PARAMETER_FOR_NEXT_MESSAGE = function(r, g, b, a) look.flash_color = $"{r},{g},{b},{a}" end,
    END_TEXT_COMMAND_THEFEED_POST_TICKER = function(blink)
        look.flash = blink
        table.insert(feed, text)
        return #feed
    end,
    END_TEXT_COMMAND_THEFEED_POST_MESSAGETEXT = function(txd, _, flash, icon, sender, subject)
        look.flash = flash
        look.icon = icon
        table.insert(feed, $"{txd}|{sender}|{subject}|{text}")
        return #feed
    end,
    THEFEED_REMOVE_ITEM = function(id) feed[id] = "removed" end,
}

local function shown(fn)
    stand.toasts = {}
    feed = {}
    fn()
    return #stand.toasts, #feed
end

-- The checks below start from Stand, whatever the default is
profile.set("notify", "stand")
stand.equal(profile.get("notify"), "stand", "notifications start in Stand here")
stand.equal(profile.get("notify_errors_in_stand"), true, "errors always in Stand by default")

local toasts, posts = shown(|| -> log:notify("hello"))
stand.check(toasts == 1 and posts == 0 and stand.toasts[1]:find("hello", 1, true), "Stand: a Stand notification")

profile.set("notify", "game")
toasts, posts = shown(|| -> log:notify("to the feed"))
stand.check(toasts == 0 and posts == 1 and feed[1]:find("to the feed", 1, true), "Game Feed: posted to the game's feed")
toasts, posts = shown(|| -> log:warn("careful"))
stand.check(toasts == 0 and posts == 1, "warnings follow the choice too")
toasts, posts = shown(|| -> log:error("broke"))
stand.check(toasts == 1 and posts == 0, "errors still go to Stand")

-- util.toast to the feed gives the post's id, thefeed.remove(id) takes it away; the card gets the script's name
feed = {}
local post_id = Atdar.util.toast("removable", { target = "game" })
stand.equal(post_id, 1, "util.toast to the feed returns the post's id")
Atdar.natives.visual.hud.thefeed.remove(post_id)
stand.equal(feed[1], "removed", "thefeed.remove(id) removes it from the feed")
Atdar.util.toast("card", { target = "game", style = "message", subject = "Profiles" })
stand.equal(feed[2], $"{default_picture}|{Atdar.name}|~w~Profiles|card",
    "style message: picture, sender, subject (in the day's color), text")
profile.set("display_name", "StandX")
Atdar.util.toast("renamed", { target = "game", style = "message" })
stand.equal(feed[3], $"{default_picture}|StandX||renamed", "the sender is the profile's Display Name, not the file name")
profile.set("display_name", "")
Atdar.util.toast("no name", { target = "game", style = "message" })
stand.equal(feed[4], $"{default_picture}|{Atdar.name}||no name", "an empty Display Name falls back to the file name")
profile.set("display_name", Atdar.name)

-- The card's picture: the profile's, asked to load first; opts.picture overrides it
local asked = {}
_G.GRAPHICS = { REQUEST_STREAMED_TEXTURE_DICT = |name| -> table.insert(asked, name), HAS_STREAMED_TEXTURE_DICT_LOADED = || -> true }
profile.set("notify_feed_picture", "CHAR_LESTER")
Atdar.util.toast("pictured", { target = "game", style = "message" })
stand.check(feed[#feed]:find("^CHAR_LESTER|") ~= nil, "the card shows the profile's picture")
stand.equal(asked[#asked], "CHAR_LESTER", "which is asked to load first")
Atdar.util.toast("own", { target = "game", style = "message", picture = "CHAR_MICHAEL" })
stand.check(feed[#feed]:find("^CHAR_MICHAEL|") ~= nil, "opts.picture overrides it")
profile.set("notify_feed_picture", default_picture)
feed = {}
stand.equal(Atdar.util.toast("in stand", { target = "stand" }), nil, "util.toast to Stand returns nothing")

-- The feed's look comes from the profile (Appearance > Game): style, flash, colours
look = {}
feed = {}
log:notify("plain")
stand.check(look.background == 128 and script_color == game_rgba("notify_background_day") and look.flash == false,
    "by default: the day background (noon by the fake clock), no flash")
clock = 22
log:notify("night")
stand.equal(script_color, game_rgba("notify_background_night"), "and the night one")
clock = 12
profile.set("notify_feed_style", "message")
profile.set("notify_flash", true)
profile.set("notify_background_day", "FF800080")
profile.set("notify_flash_color_day", "0000FF")
profile.set("notify_background_night", "10203040")
profile.set("notify_flash_color_night", "FFFFFF")
look = {}
log:notify("styled")
stand.check(feed[#feed]:find($"{default_picture}|", 1, true), "notify_feed_style message: a message card")
stand.equal(look.flash, true, "notify_flash: it flashes")
stand.equal(look.background, 128, "the background is the script's HUD colour slot")
stand.equal(script_color, "255,128,0,128", "filled with the picked colour and its opacity")
stand.equal(look.flash_color, "0,0,255,255", "the flash colour (hex without alpha: opaque)")

-- Day 7:00 - 18:59 by the game's clock, night the rest; the hours come from the profile
clock = 19
log:notify("evening")
stand.equal(script_color, "16,32,48,64", "at 19:00 the night background")
stand.equal(look.flash_color, "255,255,255,255", "and the night flash colour")
clock = 6
log:notify("dawn")
stand.equal(script_color, "16,32,48,64", "at 6:00 still night")
clock = 7
log:notify("morning")
stand.equal(script_color, "255,128,0,128", "at 7:00 the day background again")
profile.set("notify_day_start", 22)
profile.set("notify_night_start", 6)
clock = 23
log:notify("over midnight")
stand.equal(script_color, "255,128,0,128", "the day can go over midnight (22 - 6)")
clock = 12
log:notify("noon")
stand.equal(script_color, "16,32,48,64", "and then noon is night")
profile.set("notify_day_start", 7)
profile.set("notify_night_start", 19)
look = {}
Atdar.util.toast("calm", { target = "game", style = "ticker", important = false })
stand.check(look.flash == false and look.flash_color == nil, "opts override the profile: no flash, no flash colour")
profile.set("notify_flash", false)
profile.set("notify_feed_style", "ticker")
profile.set("notify_background_day", "")
profile.set("notify_background_night", "")

-- A message card from the logger: the level is the subject, the text is the message alone
profile.set("notify_feed_style", "message")
profile.set("notify_subject_color_day", "default")
log:warn("careful there")
stand.equal(feed[#feed], $"{default_picture}|{Atdar.name}|Warning|careful there",
    "the card's subject is the level, its text without the log tag")
log:notify("all good")
stand.check(feed[#feed]:find("|Information|all good", 1, true) ~= nil, "notify: Information")
-- The subject's color: the day's or the night's; a picked one or by type
profile.set("notify_subject_color_day", "level")
log:warn("by type")
stand.check(feed[#feed]:find("|~y~Warning|by type", 1, true) ~= nil, "By Type: a warning is yellow")
log:notify("by type")
stand.check(feed[#feed]:find("|~b~Information|", 1, true) ~= nil, "information blue")
profile.set("notify_subject_color_day", "grey")
log:warn("grey")
stand.check(feed[#feed]:find("|~c~Warning|grey", 1, true) ~= nil, "a picked color is the same for every type")
profile.set("notify_subject_color_night", "orange")
clock = 23
log:warn("at night")
stand.check(feed[#feed]:find("|~o~Warning|at night", 1, true) ~= nil, "at night the night's subject color")
clock = 12
profile.set("notify_subject_color_day", "default")
profile.set("notify_subject_color_night", "default")
-- With core/i18n loaded the level is in the script's language
local i18n_name = $"{Atdar.name}/core/i18n"
local real_i18n = package.loaded[i18n_name]
package.loaded[i18n_name] = { text = |key, english| -> key == "logger.level.warn" and "Предупреждение" or english }
log:warn("translated")
stand.equal(feed[#feed], $"{default_picture}|{Atdar.name}|Предупреждение|translated", "the level is translated")
package.loaded[i18n_name] = real_i18n
Atdar.util.toast("own subject", { target = "game", style = "message", subject = "Profiles", level = "WARN" })
stand.check(feed[#feed]:find("|Profiles|own subject", 1, true) ~= nil, "opts.subject wins over the level")
profile.set("notify_feed_style", "ticker")
-- The name in lines is the profile's Name In Logs, whatever its default
local log_name = profile.log_name()
Atdar.debug = false
log:notify("a post")
stand.equal(feed[#feed], $"[{log_name}] Information: a post", "a post: the short line, the level in words, no source")
Atdar.debug = true
log:notify("a debug post")
stand.equal(feed[#feed], $"[{log_name} | Test | INFO] a debug post", "in debug mode the whole line")
Atdar.debug = false
stand.clear_logs()
profile.set("notify", "stand")
stand.toasts = {}
log:warn("careful in Stand")
stand.equal(stand.toasts[1], $"[{log_name}] Warning: careful in Stand", "Stand's notification: the short line too")
stand.check(stand.find_log($"[{log_name} | Test | WARN] careful in Stand"), "the log keeps the whole line")
-- Text On A New Line: the text under the head in Stand's notification
profile.set("notify_stand_newline", true)
stand.toasts = {}
log:warn("on its own line")
stand.equal(stand.toasts[1], $"[{log_name}] Warning:\non its own line", "Text On A New Line: the text under the head")
Atdar.debug = true
stand.toasts = {}
log:notify("debug on its own line")
stand.equal(stand.toasts[1], $"[{log_name} | Test | INFO]\ndebug on its own line", "in debug mode under the whole head")
Atdar.debug = false
stand.toasts = {}
Atdar.util.toast("not from the logger", { target = "stand" })
stand.equal(stand.toasts[1], "not from the logger", "a message without a head shows as it is")
stand.check(stand.find_log($"[{log_name} | Test | INFO] debug on its own line"), "the log stays one line")
profile.set("notify_stand_newline", false)
profile.set("notify", "game")

-- remove_all(): every post the script made goes from the feed
local thefeed = Atdar.natives.visual.hud.thefeed
thefeed.remove_all()
feed = {}
log:notify("one")
log:notify("two")
stand.equal(thefeed.remove_all(), 2, "remove_all() takes away the script's posts")
stand.check(feed[1] == "removed" and feed[2] == "removed", "both are removed from the feed")
stand.equal(thefeed.remove_all(), 0, "and forgets them")
for i = 1, 105 do log:notify($"many {i}") end
stand.equal(thefeed.remove_all(), 100, "only the last 100 are kept")
feed = {}

-- A text longer than the game shows (99 bytes) goes out as more posts, cut at spaces, never inside a letter
local split = thefeed.split_text
local words = string.rep("word ", 30)
local parts = split(words)
stand.check(#parts == 2 and #parts[1] <= 99 and not parts[1]:find(" $") and parts[1]:sub(-4) == "word",
    $"split at a space, words whole ({#parts} parts, {#parts[1]} bytes)")
stand.equal(table.concat(parts, " "), words, "nothing lost but the spaces at the cuts")
local cyrillic = split(string.rep("я", 80))
stand.check(#cyrillic == 2 and #cyrillic[1] == 98 and #cyrillic[2] == 62, "Cyrillic: cut between letters (2 bytes each)")
stand.equal(#split("short"), 1, "a short text is one part")
stand.equal(#split(""), 1, "an empty text is one part")

thefeed.remove_all()
feed = {}
profile.set("notify_feed_style", "message")
local long_text = "Модуль 1 остановлен: цикл идёт вручную, а это ещё много текста сверху, чтобы точно не влезло"
profile.set("notify_background_day", "FF800080")
profile.set("notify_background_night", "FF800080")
look.color_sets = 0
local long_id = log:notify(long_text)
stand.equal(#feed, 2, "a long card goes on as a second card")
stand.check(feed[1]:find("|Модуль 1 остановлен", 1, true) ~= nil and feed[1]:find("влезло", 1, true) == nil
    and feed[2]:find("влезло$") ~= nil, "the first card has the start, the second the rest of the text")
stand.check(feed[1]:find("|Information|", 1, true) and feed[2]:find("|Information|", 1, true),
    "both cards look the same: sender, subject")
stand.equal(look.color_sets, 2, "the background colour is set for each card (the game takes it for one post)")
thefeed.remove(long_id)
stand.check(feed[1] == "removed" and feed[2] == "removed", "remove(id) of the first takes away every card")
feed = {}
profile.set("notify_feed_style", "ticker")
profile.set("notify_background_day", "")
profile.set("notify_background_night", "")

-- The card's icon: the profile's, opts.icon overrides it
profile.set("notify_feed_style", "message")
log:notify("with an icon")
stand.equal(look.icon, 1, "the profile's icon (Chat)")
profile.set("notify_feed_icon", "MONEY")
log:notify("money")
stand.equal(look.icon, 9, "a picked icon")
Atdar.util.toast("own icon", { target = "game", style = "message", icon = 2 })
stand.equal(look.icon, 2, "opts.icon overrides it")
profile.set("notify_feed_icon", "CHAT_BOX")
profile.set("notify_feed_style", "ticker")

-- While the script is leaving (deleted, renamed, stopping) nothing goes to the game's feed
Atdar.leaving = true
local toasts_leaving, posts_leaving = shown(|| -> log:notify("leaving"))
stand.check(toasts_leaving == 1 and posts_leaving == 0, "a leaving script notifies in Stand, not the feed")
Atdar.leaving = nil

-- A paused feed shows nothing: the notification goes to Stand instead
local feed_paused = false
HUD.THEFEED_IS_PAUSED = || -> feed_paused
feed_paused = true
local toasts_paused, posts_paused = shown(|| -> log:notify("while paused"))
stand.check(toasts_paused == 1 and posts_paused == 0 and stand.toasts[1]:find("while paused", 1, true),
    "a paused feed: the notification shows in Stand")
feed_paused = false
local toasts_running, posts_running = shown(|| -> log:notify("running again"))
stand.check(toasts_running == 0 and posts_running == 1, "once the feed runs again, it goes there")
HUD.THEFEED_IS_PAUSED = nil

-- notify() gives the post's id back, so a caller can take its card away again
local posted = log:notify("removable by the caller")
stand.equal(type(posted), "number", "log:notify returns the post's id of a feed notification")
profile.set("notify", "stand")
stand.equal(log:notify("in Stand"), nil, "and nil for a Stand one")
profile.set("notify", "game")

profile.set("notify", "none")
stand.clear_logs()
toasts, posts = shown(|| -> log:notify("quiet"))
stand.check(toasts == 0 and posts == 0, "Log Only: nothing on screen")
stand.check(stand.find_log("quiet"), "but it's in the log")
toasts, posts = shown(|| -> log:error("still seen"))
stand.equal(toasts, 1, "Log Only: errors still show in Stand")

profile.set("notify_errors_in_stand", false)
toasts, posts = shown(|| -> log:error("silent"))
stand.check(toasts == 0 and posts == 0, "with errors-in-Stand off, errors follow the choice too")

-- target: where one notice shows, whatever the profile says
profile.set("notify", "game")
stand.toasts = {}
local posts_before = #feed
log:notify("to Stand anyway", "stand")
stand.check(#stand.toasts == 1 and stand.toasts[1]:find("to Stand anyway", 1, true) and #feed == posts_before,
    "target stand: in Stand though the profile says the game")
profile.set("notify", "stand")
stand.toasts = {}
log:success("to the feed anyway", "game")
stand.check(#stand.toasts == 0 and feed[#feed]:find("to the feed anyway", 1, true), "target game: in the feed though the profile says Stand")
profile.set("notify_errors_in_stand", true)
profile.set("notify", "game")
stand.toasts = {}
log:error("an error to the feed", "game")
stand.check(#stand.toasts == 0, "an error with target game goes to the feed, Errors Always In Stand or not")
profile.set("notify_errors_in_stand", false)

-- The feed failing (its natives missing) doesn't swallow the notification: it shows in Stand
profile.set("notify", "game")
_G.HUD = {}
toasts, posts = shown(|| -> log:notify("feed is down"))
stand.check(toasts == 1 and stand.toasts[1]:find("feed is down", 1, true), "a failing feed falls back to Stand")

-- Emoticons: at the end of the sentence by the kind of notification, on screen only
profile.set("notify", "stand")
profile.set("notify_emoticons", true)
for _, case in { { "notify", "notify_emoticon_info" }, { "warn", "notify_emoticon_warn" },
        { "error", "notify_emoticon_error" }, { "success", "notify_emoticon_success" } } do
    profile.set(case[2], profile.default(case[2]))
    stand.toasts = {}
    stand.clear_logs()
    log[case[1]](log, "done")
    local emoticon = profile.get(case[2])
    stand.check(stand.toasts[1]:sub(-#emoticon - 5) == $"done {emoticon}", $"{case[1]}: '{emoticon}' at the end")
    stand.check(stand.find_log("] done") and not stand.find_log($"done {emoticon}"), $"{case[1]}: the log without it")
end
profile.set("notify_emoticon_info", "")
stand.toasts = {}
log:notify("plain")
stand.check(stand.toasts[1]:sub(-5) == "plain", "an empty emoticon: none")
profile.set("notify_emoticons", false)
stand.toasts = {}
log:warn("off")
stand.check(stand.toasts[1]:sub(-3) == "off", "emoticons off: none")
stand.toasts = {}
profile.set("notify_emoticons", true)
log:success("copied")
stand.check(stand.toasts[1]:find("Success: copied", 1, true), "success: its own kind, in words")

stand.finish()
