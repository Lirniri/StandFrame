-- parsers/: text into values - color, json, proglang.pluto (args, name, source, path), stand.command_box -
-- and the facades
local stand = require("stand")
stand.boot()
Atdar.parsers = Atdar.loader.auto({}, "parsers")
local parsers = Atdar.parsers

-- ─── Facade ──────────────────────────────────────────────────────────────────

local pluto = parsers.proglang.pluto
stand.check(rawequal(pluto.args, Atdar.loader.load("parsers/proglang/pluto/args")),
    "Atdar.parsers.proglang.pluto.args is parsers/proglang/pluto/args, loaded on first use")
stand.equal(type(rawget(parsers, "proglang")), "table", "proglang is kept in Atdar.parsers once loaded")
stand.equal(parsers.proglang.cobol, nil, "a language that isn't there is nil")
stand.equal(parsers.nonexistent, nil, "a parser that isn't there is nil")

-- ─── args ────────────────────────────────────────────────────────────────────

local args, count = pluto.args.parse('adder, 5, true, nil, "x, y"')
stand.check(count == 5 and args[1] == "adder" and args[2] == 5 and args[3] == true and args[4] == nil
    and args[5] == "x, y", "args.parse: a bare word, number, true, nil, a quoted text with a comma")
_G.FAKE = { add = |a, b| -> a + b }
args, count = pluto.args.parse("FAKE.add(2, 3), math.max(1, 7)")
stand.check(count == 2 and args[1] == 5 and args[2] == 7, "args.parse: calls are made, commas inside don't split")
args, count = pluto.args.parse("hello world, again")
stand.check(count == 2 and args[1] == "hello world", "args.parse: not an expression - texts split by commas")
local _, _, err = pluto.args.parse("missing.call()")
stand.check(err ~= nil, "args.parse: a call to something unknown gives an error")
stand.equal(table.concat(pluto.args.split('f(1, 2), "a, b", {3, 4}'), " | "), 'f(1, 2) | "a, b" | {3, 4}',
    "args.split: commas inside brackets and quotes don't split, nothing worked out")
stand.equal(#pluto.args.split("  "), 0, "args.split: nothing typed - nothing")
-- A name no global has is something of the script (natives.entity... is Atdar.natives.entity...)
Atdar.test_args_tbl = { twice = function(n) return n * 2 end, inner = { value = 7 } }
args, count = pluto.args.parse("test_args_tbl.twice(4), test_args_tbl.inner.value")
stand.check(count == 2 and args[1] == 8 and args[2] == 7, "args.parse: a name of the script's, without Atdar in front")
args, count = pluto.args.parse("test_args_tbl")
stand.check(count == 1 and args[1] == "test_args_tbl", "args.parse: a bare word is its own text, also one the script has")
Atdar.test_args_tbl = nil
-- resolve: the names nothing else has (short names)
local function short_names(name: string)
    if name == "short_one" then
        return function(n) return (n or 0) + 41 end
    end
    return nil
end
args, count = pluto.args.parse("short_one(), short_one(1)", short_names)
stand.check(count == 2 and args[1] == 41 and args[2] == 42, "args.parse: resolve gives the names nothing else has")
local _, _, unknown_err = pluto.args.parse("short_two()", short_names)
stand.equal(unknown_err, "'short_two' isn't known", "args.parse: a name resolve doesn't know either is told")
-- A mistyped name is told by the name, not by Lua's "attempt to call a nil value"
local _, _, typo_err = pluto.args.parse("FAKE.addd(1, 2)")
stand.equal(typo_err, "'FAKE.addd' isn't a function", "args.parse: a call of what isn't a function")
local _, _, deep_err = pluto.args.parse("FAKE.nothing.deeper")
stand.equal(deep_err, "'FAKE.nothing' is nil, it has no 'deeper'", "args.parse: a field of nil")
local _, _, method_err = pluto.args.parse("FAKE:nothing()")
stand.equal(method_err, "'FAKE:nothing' isn't a function", "args.parse: a method that isn't there")
-- call_of: one call of a path, cut into the path and its arguments' texts
local called, pieces = pluto.args.call_of('game.set(5, f(1), "a, b")')
stand.check(called == "game.set" and table.concat(pieces, " | ") == '5 | f(1) | "a, b"', "args.call_of: the path and the arguments as typed")
called, pieces = pluto.args.call_of(" f() ")
stand.check(called == "f" and #pieces == 0, "args.call_of: a call without arguments")
stand.equal(pluto.args.call_of("5"), nil, "args.call_of: a value isn't a call")
stand.equal(pluto.args.call_of("f(1), g(2)"), nil, "args.call_of: two calls aren't one")
stand.equal(pluto.args.call_of("f(1)(2)"), nil, "args.call_of: a call of a call isn't a call of a path")
stand.equal(pluto.args.call_of("a:b(1)"), nil, "args.call_of: a method isn't a call of a path")
stand.equal(pluto.args.call_of("f(1"), nil, "args.call_of: an unclosed bracket")

-- ─── color ───────────────────────────────────────────────────────────────────

local orange = parsers.color.hex("FF8000")
stand.check(orange.r == 1 and orange.b == 0 and orange.a == 1, "color.hex: RRGGBB")
stand.equal(parsers.color.hex("#ff800080").a, 128 / 255, "color.hex: #, lower case and alpha")
stand.equal(parsers.color.hex("FF80"), nil, "color.hex: too short is nil")
stand.check(Atdar.loader.load("utils/color").from_hex("FF8000").g == orange.g, "utils/color.from_hex reads hex through it")

-- ─── json ────────────────────────────────────────────────────────────────────

stand.equal(parsers.json.decode('{"a": 1}').a, 1, "json.decode: an object")
stand.equal(parsers.json.decode('[1, 2]')[2], 2, "json.decode: an array")
stand.equal(parsers.json.decode('{"a": 1, "b":'), nil, "json.decode: cut off is nil, not the part that parsed")
stand.equal(parsers.json.decode("{bad}"), nil, "json.decode: not JSON is nil")
stand.equal(next(parsers.json.decode("{}")), nil, "json.decode: {} is an empty table")

-- ─── name ────────────────────────────────────────────────────────────────────

local words = pluto.name.words("get_handle")
stand.check(words.get and words.handle, "name.words: snake_case")
words = pluto.name.words("isLastExist")
stand.check(words.is and words.last and words.exist, "name.words: camelCase, lower case")

-- ─── source ──────────────────────────────────────────────────────────────────

local dir = stand.tmpdir("parsers_source")
stand.write_file($"{dir}typed.pluto", "local m = {}\nfunction m.count(a,\n    b): int\n    return a + b\nend\nfunction m.plain() end\nreturn m\n")
local typed = dofile($"{dir}typed.pluto")
stand.equal(pluto.source.return_type(typed.count), "int", "source.return_type: written after parameters on another line")
stand.equal(pluto.source.return_type(typed.plain), nil, "source.return_type: none written - nil")
stand.equal(pluto.source.return_type(print), nil, "source.return_type: a C function - nil")
-- The types of the parameters: only those written; defaults, ?, | and parameters on other lines are read
stand.write_file($"{dir}params.pluto", "local m = {}\nfunction m.go(amount: int, note, ratio: ?float = 0.5,\n    pos: vector3|string, items: table = {1, 2}, ...) end\nfunction m.none() end\nreturn m\n")
local params = dofile($"{dir}params.pluto")
local types = pluto.source.param_types(params.go)
stand.check(types.amount == "int" and types.ratio == "?float" and types.pos == "vector3|string" and types.items == "table",
    "source.param_types: the type written for each parameter, without its default")
stand.equal(types.note, nil, "source.param_types: a parameter with no type isn't in it")
stand.equal(next(pluto.source.param_types(params.none)), nil, "source.param_types: no parameters - empty")
stand.equal(next(pluto.source.param_types(print)), nil, "source.param_types: a C function - empty")
local param_defaults = pluto.source.param_defaults(params.go)
stand.check(param_defaults.ratio == "0.5" and param_defaults.items == "{1, 2}", "source.param_defaults: the default as written, with or without a type")
stand.check(param_defaults.amount == nil and param_defaults.note == nil, "source.param_defaults: none written - not in it")
stand.write_file($"{dir}defaults.pluto", "local m = {}\nfunction m.go(a: int = 5, b = false, c: ?int = nil, d = v3.new(1, 2, 3)) end\nreturn m\n")
local written = pluto.source.param_defaults(dofile($"{dir}defaults.pluto").go)
stand.check(written.a == "5" and written.b == "false" and written.c == nil and written.d == "v3.new(1, 2, 3)",
    "source.param_defaults: = nil isn't a default; an expression with commas stays whole")
stand.equal(next(pluto.source.param_defaults(print)), nil, "source.param_defaults: a C function - empty")
-- Stand's natives: the types are in comments, in front of function and of the names
local NATIVES = "local N = {}\n"
    .. "N.PLAYER_PED_ID=--[[Ped (int)]] function()return 1 end\n"
    .. "N.IS_IT=--[[BOOL (bool)]] function(--[[int]] entity, --[[float]] seconds)return true end\n"
    .. "N.WAIT=--[[void]] function(--[[int]] ms)return 0 end\n"
    .. "N.NAME=--[[string]] function()return '' end\n"
    .. "N.WHERE=--[[Vector3 (vector3)]] function()return 0 end\n"
    .. "return N\n"
stand.write_file($"{dir}natives.pluto", NATIVES)
local natives = dofile($"{dir}natives.pluto")
stand.equal(pluto.source.return_type(natives.PLAYER_PED_ID), "int", "source.return_type: a native's Ped (int) is int")
stand.equal(pluto.source.return_type(natives.IS_IT), "bool", "source.return_type: BOOL (bool) is bool")
stand.equal(pluto.source.return_type(natives.WAIT), "void", "source.return_type: void")
stand.equal(pluto.source.return_type(natives.NAME), "string", "source.return_type: string")
stand.equal(pluto.source.return_type(natives.WHERE), "vector3", "source.return_type: Vector3 (vector3) is vector3")
local native_types = pluto.source.param_types(natives.IS_IT)
stand.check(native_types.entity == "int" and native_types.seconds == "float", "source.param_types: a native's parameters from the comments")

-- ─── path ────────────────────────────────────────────────────────────────────

Atdar.test_path = { fn = || -> 1, nested = { fn = || -> 2 }, value = 7 }
local found, fn = pluto.path.resolve("test_path.nested.fn")
stand.check(found and fn() == 2, "path.resolve: a path from Atdar with dots")
found, fn = pluto.path.resolve("Atdar.test_path.fn")
stand.check(found and fn() == 1, "path.resolve: Atdar. in front is the same")
found, fn = pluto.path.resolve("math.floor")
stand.check(found and fn(2.5) == 2, "path.resolve: the first word Atdar hasn't is a global")
found, fn = pluto.path.resolve("test_path.fn()")
stand.check(found and fn() == 1, "path.resolve: brackets at the end aren't part of the path")
local method_found, method, owner = pluto.path.resolve("test_path:fn")
stand.check(method_found and owner == Atdar.test_path and method() == 1, "path.resolve: a colon gives the method and its owner")
-- A name both Stand and the script have: plain it's Stand's, with Atdar in front the script's
Atdar.test_clash = { who = "atdar" }
_G.test_clash = { who = "stand" }
local _, plain_table = pluto.path.resolve("test_clash")
local _, scripts_table = pluto.path.resolve("Atdar.test_clash")
stand.check(plain_table.who == "stand" and scripts_table.who == "atdar", "path.resolve: a global of Stand first; the script's table of the name with Atdar in front")
Atdar.test_clash = nil
_G.test_clash = nil
stand.equal(pluto.path.resolve("test_path.missing"), false, "path.resolve: nothing there - false")
stand.equal(pluto.path.resolve("test_path:value"), false, "path.resolve: a colon after something that isn't a function - false")
local path_text, inline = pluto.path.split("game.set_speed(5, true)")
stand.check(path_text == "game.set_speed" and inline == "5, true", "path.split: the path and what's in the brackets")
stand.equal(select("#", pluto.path.split("game.go")), 2, "path.split: no brackets - the path, nil")
stand.equal(pluto.path.short_name("PLAYER.PLAYER_PED_ID"), "PLAYER_PED_ID", "path.short_name: what's after the last dot")
stand.equal(pluto.path.short_name("ENTITY.GET_ENTITY_COORDS()"), "GET_ENTITY_COORDS", "path.short_name: and the brackets")
stand.equal(pluto.path.short_name("util.toast"), "toast", "path.short_name: any namespace, Stand's own too")
stand.equal(pluto.path.short_name("game.repair_vehicle"), "repair_vehicle", "path.short_name: the script's")
stand.equal(pluto.path.short_name("VehicleManager:get"), "get", "path.short_name: a method too")
stand.equal(pluto.path.short_name("test"), "test", "path.short_name: a name without a namespace")
-- find: a function by its short name, in Atdar and then in the globals
Atdar.test_path = { deep = { found_fn = function() end }, found_fn = function() end }
TEST_FIND = { found_fn = function() end, other_fn = function() end, table_not_fn = {} }
local matches = pluto.path.find("found_fn")
stand.check(#matches == 3 and matches[1] == "test_path.deep.found_fn" and matches[2] == "test_path.found_fn" and matches[3] == "TEST_FIND.found_fn",
    "path.find: Atdar first, each part in order, then the globals")
stand.equal(pluto.path.find("other_fn")[1], "TEST_FIND.other_fn", "path.find: a global table's function")
stand.equal(pluto.path.find("table_not_fn")[1], nil, "path.find: a table isn't a function")
stand.equal(#pluto.path.find("no_such_fn"), 0, "path.find: none - empty")
stand.equal(#pluto.path.find("test_path.found_fn"), 0, "path.find: a name with a dot isn't a short name")
-- the script's natives are looked into by their files, loaded or not
Atdar.natives = Atdar.natives or Atdar.loader.auto({}, "natives")
local native_path = pluto.path.find("get_forward_z")[1]
stand.equal(native_path, "Atdar.natives.entity.get_forward_z", "path.find: a native of the script by its short name")
stand.equal(pluto.path.resolve(native_path), true, "path.find: and the path it gives resolves")
stand.equal(pluto.path.find("get_rpm")[1], "Atdar.natives.entity.vehicle.engine.get_rpm", "path.find: a function in a table of a natives module")
Atdar.test_path = nil
TEST_FIND = nil

-- ─── stand.command_box ───────────────────────────────────────────────────────

local command_box = parsers.stand.command_box
stand.check(rawequal(command_box, Atdar.loader.load("parsers/stand/command_box")), "Atdar.parsers.stand.command_box")
stand.equal(command_box.sanitize("God Mode_2!"), "godmode_2", "command_box.sanitize: lower case, a-z 0-9 _ only")
local clean, skipped = command_box.bases({ "God Mode", "godmode", "", "!!", "fly" })
stand.equal(table.concat(clean, " "), "godmode fly", "command_box.bases: sanitized, no repeats, no empty ones")
stand.equal(table.concat(skipped, " "), "!!", "and what had nothing usable, \"\" left out quietly")
local entry = command_box.entry("godmode", "God", { "gm", "", "GM", "god", "godmode", 5 })
stand.check(entry.name == "god" and table.concat(entry.words, " ") == "gm",
    "command_box.entry: the name and words clean, repeats of the base, the name and each other dropped")
stand.equal(command_box.entry("godmode", "GodMode", {}), nil, "command_box.entry: the base itself as the name - nothing left")
stand.equal(command_box.entry("godmode", 42, "gm"), nil, "command_box.entry: values of the wrong kind are ignored")

-- ─── Errors: a value of the wrong kind is the caller's mistake ───────────────
-- An error naming the parser, the function and what was wrong, pointing at the call (this file),
-- not inside the parser. Text that can't be read is no error: that's covered above

-- @param call A function of this file making the call, so the error has a line here to point at
-- @return The error of call(), or nil if it didn't fail
local function error_of(call): ?string
    local ok, err = pcall(call)
    if ok then
        return nil
    end
    return tostring(err)
end

local function check_error(err: ?string, expected: string, name: string): void
    stand.check(err ~= nil and err:find(expected, 1, true) ~= nil, $"{name}: says what was wrong ({tostring(err)})")
    stand.check(err ~= nil and err:find("test_parsers.pluto:", 1, true) ~= nil, $"{name}: points at the call")
end

check_error(error_of(|| -> pluto.args.parse(nil)), "[parsers/proglang/pluto/args] parse: input must be a string, got nil",
    "args.parse(nil)")
check_error(error_of(|| -> pluto.args.split(5)), "[parsers/proglang/pluto/args] split: input must be a string, got number",
    "args.split(5)")
check_error(error_of(|| -> pluto.name.words({})), "[parsers/proglang/pluto/name] words: name must be a string, got table",
    "name.words({})")
check_error(error_of(|| -> pluto.source.return_type("count")),
    "[parsers/proglang/pluto/source] return_type: fn must be a function, got string", "source.return_type(\"count\")")
check_error(error_of(|| -> pluto.source.param_types("count")),
    "[parsers/proglang/pluto/source] param_types: fn must be a function, got string", "source.param_types(\"count\")")
check_error(error_of(|| -> pluto.source.param_defaults("count")),
    "[parsers/proglang/pluto/source] param_defaults: fn must be a function, got string", "source.param_defaults(\"count\")")
check_error(error_of(|| -> pluto.path.resolve(5)), "[parsers/proglang/pluto/path] resolve: typed must be a string, got number",
    "path.resolve(5)")
check_error(error_of(|| -> command_box.sanitize(nil)), "[parsers/stand/command_box] sanitize: text must be a string, got nil",
    "command_box.sanitize(nil)")
check_error(error_of(|| -> command_box.bases("godmode")),
    "[parsers/stand/command_box] bases: names must be a table, got string", "command_box.bases(\"godmode\")")
check_error(error_of(|| -> command_box.bases({ "fly", 5 })),
    "[parsers/stand/command_box] bases: names[2] must be a string, got number", "command_box.bases({ \"fly\", 5 })")
check_error(error_of(|| -> command_box.entry(nil, "god")),
    "[parsers/stand/command_box] entry: base must be a string, got nil", "command_box.entry(nil)")
check_error(error_of(|| -> command_box.entry("", "god")),
    "[parsers/stand/command_box] entry: base must be a command's base name", "command_box.entry(\"\")")
-- A call that fails inside the arguments isn't a wrong kind: parse gives it back as its error, no throw
local _, _, call_err = pluto.args.parse("missing.call()")
stand.check(type(call_err) == "string", "args.parse: a failing call in the text is returned as an error, not thrown")

stand.finish()
