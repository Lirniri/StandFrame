local module = {}

function module.is_getting_up(ped: int): bool
    return TASK.IS_PED_GETTING_UP(ped)
end

function module.get_active(ped: int, type: int)
    return TASK.GET_IS_TASK_ACTIVE(ped, type)
end

-- @param mode 1 — all tasks, 2 — secondary task, 3 — all tasks immediately
function module.clear(ped: int, mode: int = 0): void
    switch mode do
        case 1:
            TASK.CLEAR_PED_TASKS_IMMEDIATELY(ped)
            break
        case 2:
            TASK.CLEAR_PED_SECONDARY_TASK(ped)
            break
        default:
            TASK.CLEAR_PED_TASKS(ped)
    end
end

function module.sky_dive(ped: int, instant: bool): void
    TASK.TASK_SKY_DIVE(ped, instant)
end

return module
