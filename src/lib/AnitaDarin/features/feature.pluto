local class_utils = Atdar.globals.pluto.class

-- Declared first and assigned explicitly so methods can reference Feature
local Feature

-- Lifecycle methods hold the re-entry guards; subclasses override on_* hooks instead
local SEALED = { 
    "tick",
    "enable",
    "disable",
    "trigger",
    "is_enabled"
}

local HOOKS = { on_tick = true, on_enable = true, on_disable = true, on_trigger = true }

-- Hook each kind can't work without (from opts or a subclass override)
local REQUIRED_HOOK = { loop = "on_tick", action = "on_trigger" }

local function validate_opts(instance: table, opts: table): void
    if type(opts.id) ~= "string" or opts.id == "" then
        error($"[Feature] id must be a non-empty string, got {type(opts.id)}")
    end
    local label = $"[Feature '{opts.id}']"

    for key, value in pairs(opts) do
        if key ~= "id" and key ~= "kind" and not HOOKS[key] then
            error($"{label} unknown option '{key}'")
        end
        if HOOKS[key] and type(value) ~= "function" then
            error($"{label} '{key}' must be a function, got {type(value)}")
        end
    end

    if opts.kind ~= "loop" and opts.kind ~= "toggle" and opts.kind ~= "action" then
        error($"{label} unknown kind '{tostring(opts.kind)}', expected loop, toggle or action")
    end

    local hook = REQUIRED_HOOK[opts.kind]
    if hook and opts[hook] == nil and instance[hook] == Feature[hook] then
        error($"{label} kind '{opts.kind}' requires {hook}")
    end
end

Feature = class

    function __construct(opts: table)
        class_utils.fix_index(self)
        class_utils.construct.check_sealed(self, Feature, SEALED, $"Feature '{opts.id}'")
        validate_opts(self, opts)

        self.id = opts.id
        self.kind = opts.kind
        self.enabled = false

        self.on_tick = opts.on_tick or self.on_tick
        self.on_enable = opts.on_enable or self.on_enable
        self.on_disable = opts.on_disable or self.on_disable
        self.on_trigger = opts.on_trigger or self.on_trigger
    end

    function tick()
        if !self.enabled then
            self:enable()
        end
        -- util.toast("Tick: ".. self.id)
        self:on_tick()
    end
    function on_tick()
        -- body
        -- util.toast("OnTick: ".. self.id)
    end

    function is_enabled(): bool
        return self.enabled
    end

    function enable(): void
        if self.enabled then
            return
        end
        -- util.toast("Enable: ".. self.id)
        self.enabled = true
        self:on_enable()
    end
    function on_enable(): void
        -- body
        -- util.toast("OnEnable: ".. self.id)
    end

    function disable(): void
        if !self.enabled then
            return
        end
        -- util.toast("Disable: ".. self.id)
        self.enabled = false
        self:on_disable()
    end
    function on_disable(): void
        -- body
        -- util.toast("OnDisable: ".. self.id)
    end

    function trigger()
        -- util.toast("Trigger: ".. self.id)
        self:on_trigger()
    end
    function on_trigger()
        -- util.toast("OnTrigger: ".. self.id)
        -- body
    end

end

return Feature