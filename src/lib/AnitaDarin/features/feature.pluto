local class_utils = Atdar.globals.pluto.class
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Feature")

-- Declared first and assigned explicitly so methods can reference Feature
local Feature

-- Lifecycle methods hold the re-entry guards; subclasses override on_* hooks instead
local SEALED = { 
    "tick",
    "enable",
    "disable",
    "trigger",
    "is_enabled"
}

local HOOKS = { on_tick = true, on_enable = true, on_disable = true, on_trigger = true }

-- Valid kinds and the hook each can't work without (from opts or a subclass override)
local KINDS = {
    loop = { requires = "on_tick" },
    toggle = {},
    action = { requires = "on_trigger" },
}

local function kind_names(): string
    local names = {}
    for name in pairs(KINDS) do
        table.insert(names, name)
    end
    table.sort(names)
    return table.concat(names, ", ")
end

local function validate_opts(instance: table, opts: table): void
    if type(opts.id) ~= "string" or opts.id == "" then
        error($"[Feature] id must be a non-empty string, got {type(opts.id)}")
    end
    local label = $"[Feature '{opts.id}']"

    for key, value in pairs(opts) do
        if key ~= "id" and key ~= "kind" and not HOOKS[key] then
            error($"{label} unknown option '{key}'")
        end
        if HOOKS[key] and type(value) ~= "function" then
            error($"{label} '{key}' must be a function, got {type(value)}")
        end
    end

    local kind = KINDS[opts.kind]
    if not kind then
        error($"{label} unknown kind '{tostring(opts.kind)}', expected one of: {kind_names()}")
    end

    local hook = kind.requires
    if hook and opts[hook] == nil and instance[hook] == Feature[hook] then
        error($"{label} kind '{opts.kind}' requires {hook}")
    end
end

Feature = class

    function __construct(opts: table)
        class_utils.fix_index(self)
        class_utils.construct.check_sealed(self, Feature, SEALED, $"Feature '{opts.id}'")
        validate_opts(self, opts)

        self.id = opts.id
        self.kind = opts.kind
        self.enabled = false

        self.on_tick = opts.on_tick or self.on_tick
        self.on_enable = opts.on_enable or self.on_enable
        self.on_disable = opts.on_disable or self.on_disable
        self.on_trigger = opts.on_trigger or self.on_trigger
    end

    -- Calls a hook, logs which version runs and catches its errors
    private function call_hook(name: string): void
        local overridden = self[name] ~= Feature[name]
        if name ~= "on_tick" then -- on_tick runs every frame, would flood the log
            log:debug($"{self.id}: {name} ({overridden ? "overridden" : "default"})")
        end
        local ok, err = pcall(self[name], self)
        if not ok then
            log:error($"{self.id}: {name} failed\n{err}")
        end
    end

    

    function tick()
        if !self.enabled then
            self:enable()
        end
        self:call_hook("on_tick")
    end
    function on_tick()
        -- body
    end

    function is_enabled(): bool
        return self.enabled
    end

    function enable(): void
        if self.enabled then
            return
        end
        self.enabled = true
        self:call_hook("on_enable")
    end
    function on_enable(): void
        -- body
    end

    function disable(): void
        if !self.enabled then
            return
        end
        self.enabled = false
        self:call_hook("on_disable")
    end
    function on_disable(): void
        -- body
    end

    function trigger()
        self:call_hook("on_trigger")
    end
    function on_trigger()
        -- body
    end

end

-- Read by menu_node.pluto to check that every kind has a menu item
Feature.KINDS = KINDS

return Feature