local class_utils = Atdar.globals.pluto.class
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Feature")

-- Declared first and assigned explicitly so methods can reference Feature
local Feature

-- Lifecycle methods hold the re-entry guards; subclasses override on_* hooks instead
local SEALED = { 
    "save_state",
    "load_state",
    "tick",
    "enable",
    "disable",
    "trigger",
    "is_enabled"
}

local HOOKS = {
    on_save_state = true,
    on_load_state = true,
    on_tick = true,
    on_enable = true,
    on_disable = true,
    on_trigger = true
}

-- Valid kinds and the hook each can't work without (from opts or a subclass override)
local KINDS = {
    loop = { requires = "on_tick" },
    toggle = {},
    action = { requires = "on_trigger" },
}

local function kind_names(): string
    local names = {}
    for name in pairs(KINDS) do
        table.insert(names, name)
    end
    table.sort(names)
    return table.concat(names, ", ")
end

local function validate_opts(instance: table, opts: table): void
    if type(opts.id) ~= "string" or opts.id == "" then
        error($"[Feature] id must be a non-empty string, got {type(opts.id)}")
    end
    local label = $"[Feature '{opts.id}']"

    for key, value in pairs(opts) do
        if key ~= "id" and key ~= "kind" and not HOOKS[key] then
            error($"{label} unknown option '{key}'")
        end
        if HOOKS[key] and type(value) ~= "function" then
            error($"{label} '{key}' must be a function, got {type(value)}")
        end
    end

    local kind = KINDS[opts.kind]
    if not kind then
        error($"{label} unknown kind '{tostring(opts.kind)}', expected one of: {kind_names()}")
    end

    local hook = kind.requires
    if hook and opts[hook] == nil and instance[hook] == Feature[hook] then
        error($"{label} kind '{opts.kind}' requires {hook}")
    end
end

Feature = class

    function __construct(opts: table)
        class_utils.fix_index(self)
        class_utils.construct.check_sealed(self, Feature, SEALED, $"Feature '{opts.id}'")
        validate_opts(self, opts)

        self.id = opts.id
        self.kind = opts.kind

        -- States
        self.error = nil -- set when a hook failed and switched the feature off; cleared by disable()
        self.failure_handler = nil -- set by the menu: switches its item off (set_failure_handler)
        
        -- State > for Actions
        self.enabled = false -- for enable/disable
        self.triggered = false -- for trigger

        -- States > Save/Load
        self.on_save_state = opts.on_save_state or self.on_save_state
        self.on_load_state = opts.on_load_state or self.on_load_state
        
        -- Actions
        self.on_tick = opts.on_tick or self.on_tick
        self.on_enable = opts.on_enable or self.on_enable
        self.on_disable = opts.on_disable or self.on_disable
        self.on_trigger = opts.on_trigger or self.on_trigger
    end

    -- Calls a hook, logs which version runs and catches its errors
    -- @return Whether the hook finished without an error
    private function call_hook(name: string): bool
        local overridden = self[name] ~= Feature[name]
        if name ~= "on_tick" then -- on_tick runs every frame, would flood the log
            log:debug($"{self.id}: {name} ({overridden ? "overridden" : "default"})")
        end
        local ok, err = pcall(self[name], self)
        if not ok then
            self:fail(name, err)
        end
        return ok
    end

    -- A failed hook switches the feature off, so a broken on_tick doesn't fail (and notify) every frame.
    -- The error is shown once; the feature stays off until the user switches it on again
    private function fail(name: string, err): void
        -- A failure in the cleanup itself is only logged: disabling again from here would loop
        local cleanup = name == "on_disable" or name == "load_state"
        if cleanup or not self.enabled then
            log:error($"{self.id}: {name} failed\n{err}")
            return
        end
        log:error($"{self.id}: {name} failed, switched off\n{err}")
        -- on_disable and load_state undo what the feature did before it broke
        self:disable()
        -- After disable(), which clears it
        self.error = $"{name}: {err}"
        if self.failure_handler then
            pcall(self.failure_handler)
        end
    end

    -- fn() is called after a hook failed and switched the feature off; the menu uses it to switch its item off
    function set_failure_handler(fn: function): void
        self.failure_handler = fn
    end

    -- @return What failed and why, or nil
    function get_error(): ?string
        return self.error
    end

    function save_state()
        self:on_save_state()
    end
    function on_save_state()
        -- body
    end

    function load_state()
        self:on_load_state()
    end
    function on_load_state()
        -- body
    end

    function tick()
        -- Failed and not switched off yet: don't start again on the next frame
        if self.error then
            return
        end
        if !self.enabled then
            self:enable()
        end
        self:call_hook("on_tick")
    end
    function on_tick()
        -- body
    end

    function is_enabled(): bool
        return self.enabled
    end

    function enable(): void
        if self.enabled then
            return
        end
        self:call_hook("save_state")
        self.enabled = true
        self:call_hook("on_enable")
    end
    function on_enable(): void
        -- body
    end
    function disable(): void
        -- Switching off also clears a failure, so switching on again tries anew
        self.error = nil
        if !self.enabled then
            return
        end
        self.enabled = false
        self:call_hook("on_disable")
        self:call_hook("load_state")
    end
    function on_disable(): void
        -- body
    end

    function is_triggering()
        return self.triggered
    end
    function trigger()
        if self.triggered then
            return -- still running from the previous click
        end
        self.triggered = true
        self:call_hook("on_trigger")
        self.triggered = false
    end
    function on_trigger()
        -- body
    end

end

-- Read by menu_node.pluto to check that every kind has a menu item
Feature.KINDS = KINDS

return Feature