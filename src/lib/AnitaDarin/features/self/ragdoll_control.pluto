-- lib/AnitaDarin/features/self/ragdoll_control.pluto

local ToggleModule = require($"{Atdar.name}/core/toggle_module")

local class RagdollControl extends ToggleModule
    name = "self.ragdoll_control"

    function on_tick()
        local player = players.user()
        PLAYER.GIVE_PLAYER_RAGDOLL_CONTROL(player, true)
    end

    function on_disable()
        PLAYER.GIVE_PLAYER_RAGDOLL_CONTROL(players.user(), false)
    end
end

return RagdollControl
