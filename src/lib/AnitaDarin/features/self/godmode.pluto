local load = require($"{Atdar.name}/core/loader")
local Feature = load("features/feature")

-- Ticks because the game resets the flag on death/respawn
return new Feature({
    id = "self.godmode",
    kind = "loop",

    on_tick = function(self)
        local n_player = Atdar.natives.player
        local player = n_player.get_id()
        if not n_player.is_godmode(player) then
            n_player.set_godmode(player, true)
        end
    end,

    on_disable = function(self)
        local n_player = Atdar.natives.player
        n_player.set_godmode(n_player.get_id(), false)
    end,
})
