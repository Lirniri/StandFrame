local module = {}

local is_enabled = false

function module.is_enabled(): bool
    return is_enabled
end

-- Called every tick: the game resets the flag on death/respawn
function module.enable(): void
    is_enabled = true
    local n_player = Atdar.natives.player
    local player = n_player.get_id()
    if not n_player.is_godmode(player) then
        n_player.set_half_godmode(player, true)
    end
end

function module.disable(): void
    if is_enabled then
        is_enabled = false
        local n_player = Atdar.natives.player
        local player = n_player.get_id()
        n_player.set_half_godmode(player, false)
    end
end

return module
