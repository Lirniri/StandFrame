local module = {}

    function module.is_on_ground(entity, max_height: number|bool = false): bool
        local is_in_air = ENTITY.IS_ENTITY_IN_AIR(entity)
        if is_in_air then
            return false
        end

        local coords = ENTITY.GET_ENTITY_COORDS(entity)
        local found, ground_z = util.get_ground_z(coords.x, coords.y, coords.z)

        if max_height == false then
            return found and (coords.z - ground_z) >= 0
        else
            return found and (coords.z - ground_z) <= max_height
        end
    end

    -- @desc Returns the coordinates of an entity, optionally snapped to the ground.
    -- @param entity The entity handle
    -- @param max_height Maximum height above ground to snap (or false to always snap)
    -- @return The entity coordinates as a vector3
    function module.get_coords(entity: int, max_height: number|bool = 1.3): vector3
        local coords = ENTITY.GET_ENTITY_COORDS(entity)

        local found, ground_z = util.get_ground_z(coords.x, coords.y, coords.z)
        if max_height == false then
            if found and (coords.z - ground_z) >= 0 then
                coords.z = ground_z
            end
        else
            if found and (coords.z - ground_z) <= max_height then
                coords.z = ground_z
            end
        end

        return v3.new(coords)
    end
    -- @desc Sets the coordinates of an entity, optionally snapped to the ground.
    -- @param entity The entity handle
    -- @param coords Target coordinates as a vector3
    -- @param max_height Maximum height above ground to snap (or false to always snap)
    -- @return false if coords is nil, true otherwise
    function module.set_coords(entity: int, coords: ?vector3, max_height: number|bool = 1000, clear_area: bool = false, x_axis: bool = false, y_axis: bool = false, z_axis: bool = false): bool
        if coords == nil then
            return false
        end

        local pos = v3.new(coords)
        -- Search from above so targets below ground (e.g. waypoint z) still find it
        local found, ground_z = util.get_ground_z(pos.x, pos.y, pos.z)
        if max_height ~= false then
            if found and (pos.z - ground_z) <= max_height then
                pos.z = ground_z
            end
        end

        ENTITY.SET_ENTITY_COORDS(entity, pos.x, pos.y, pos.z, x_axis, y_axis, z_axis, clear_area)
        return true
    end
    
return module