-- lib/AnitaDarin/bootstrap.pluto

util.require_natives("3407a")

Atdar.loader = require($"{Atdar.name}/core/loader")

Atdar.globals = Atdar.loader.load("globals")

-- Libraries
local UTILS = {
    "util",
    "filesystem",
    "lang", -- after filesystem: reads language files from store
}
for _, name in UTILS do
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end

-- Script profile: display/short name, command prefix. Needs filesystem paths, used by the logger and menu
Atdar.profile = Atdar.loader.load("core/profile")

-- Native wrappers: Atdar.natives.<section>. An error in one file doesn't crash the script, that file stays empty
local NATIVES = {
    -- Game systems
    "streaming",
    "input",
    "visual",
    "audio",

    -- Game objects and the world
    "entity",
    "player",
    "network",
    "world",
    "weapon",
}

Atdar.natives = {}
for _, name in NATIVES do
    Atdar.natives[name] = Atdar.loader.load($"natives/{name}")
end

-- Features register themselves in Atdar.features; the menu looks them up by id.
-- Which features get loaded depends on the menu: built-in ones or the chosen pack's
Atdar.features = Atdar.loader.load("features/registry")

Atdar.ui.menu = require($"{Atdar.name}/ui/stand/menu")

-- \,