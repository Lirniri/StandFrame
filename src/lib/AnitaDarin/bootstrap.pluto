-- lib/AnitaDarin/bootstrap.pluto

util.require_natives("3407a")

-- Libraries
local UTILS = {
    "util",
    "players",
    "filesystem",
}

for _, name in UTILS do
    local ok, lib = pcall(require, $"{Atdar.name}/utils/{name}")
    if not ok then
        util.log($"[Utils] failed to load '{name}': {lib}")
        util.toast($"Utils '{name}' failed to load\n{lib}")
        lib = {}
    end
    Atdar[name] = lib
end

-- Native wrappers: an error in one section doesn't crash the script, the section stays empty
local NATIVES = {
    "entity",
    "player",
    "network",
    "visual",
    "world",
    "weapon",
    "audio",
    "input",
    "streaming",
}

for _, name in NATIVES do
    local ok, lib = pcall(require, $"{Atdar.name}/game/natives/{name}")
    if not ok then
        util.log($"[game/natives] failed to load '{name}': {lib}")
        util.toast($"game/natives '{name}' failed to load\n{lib}")
        lib = {}
    end
    Atdar[name] = lib
end


Atdar.ui.menu = require($"{Atdar.name}/ui/stand/menu")

-- \,