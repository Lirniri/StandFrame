-- lib/AnitaDarin/bootstrap.pluto

-- The loader comes first (it needs no natives), so the whole start is timed, the game's natives included
Atdar.loader = require($"{Atdar.name}/core/loader")
local started = Atdar.loader.now()

Atdar.loader.measure("natives-3407a (util.require_natives)", util.require_natives, "3407a")

Atdar.globals = Atdar.loader.load("globals")

-- Libraries
Atdar.util = {}
local UTILS = {
    "util", -- Atdar.util
    "filesystem",
    "lang", -- after filesystem: reads language files from store
    "color", -- Atdar.color: hex <-> Stand (0.0 - 1.0) <-> game (0 - 255) colours
    "menu", -- Atdar.menu: menu items Stand doesn't have ready-made (color without opacity, spoiler)
    "memory", -- Atdar.memory: entity handle <-> pointer
    "game", -- Atdar.util.game: things built on natives (game.entity.vehicle.repair, game.players.user.restore_health)
}
for _, name in UTILS do
    -- Not Atdar.game: it is in utils/util/game
    if name == "game" then
        Atdar.util[name] = Atdar.loader.load($"utils/util/{name}")
        continue
    end
    Atdar[name] = Atdar.loader.load($"utils/{name}")
end


-- Script profile: display/short name, command prefix. Needs filesystem paths, used by the logger and menu
Atdar.profile = Atdar.loader.load("core/profile")

-- Native wrappers: Atdar.natives.<section>, each loaded from natives/<section>.pluto on first use.
-- An error in one file doesn't crash the script, that file stays empty
Atdar.natives = Atdar.loader.auto({}, "natives")

-- Parsers: Atdar.parsers.<kind>, each loaded from parsers/<kind>.pluto on first use. Text into values:
-- color (hex), json, proglang (programming languages: proglang.pluto.args / name / source),
-- stand (what Stand takes: stand.command_box)
Atdar.parsers = Atdar.loader.auto({}, "parsers")

-- Modules: internal parts the script starts by itself, in dependency order (core/module).
-- Before features and the menu, so those can use them
Atdar.modules = Atdar.loader.load("core/module_manager")
Atdar.modules.load_dir($"{Atdar.filesystem.paths.lib}modules\\")
Atdar.modules.start()

-- Features register themselves in Atdar.features; the menu looks them up by id.
-- Which features get loaded depends on the menu: built-in ones or the chosen pack's
Atdar.features = Atdar.loader.load("features/registry")

Atdar.ui.menu = require($"{Atdar.name}/ui/stand/menu")

-- Load Timing on: how long the start took and which files were the slowest, in Stand's log
if Atdar.load_timing then
    Atdar.loader.report(Atdar.loader.now() - started)
    local Logger = Atdar.loader.load("core/logger")
    local i18n = Atdar.loader.load("core/i18n")
    local log = new Logger("Loader")
    log:notify(i18n.text("profile.load_timing.done"))
end
