-- lib/AnitaDarin/bootstrap.pluto

util.require_natives("3407a")

local loader = require($"{Atdar.name}/core/loader")

Atdar.globals = loader("globals")

-- Libraries
local UTILS = {
    "util",
    "filesystem",
}

for _, name in UTILS do
    local ok, lib = pcall(require, $"{Atdar.name}/utils/{name}")
    if not ok then
        util.log($"[Utils] failed to load '{name}': {lib}")
        util.toast($"Utils '{name}' failed to load\n{lib}")
        lib = {}
    end
    Atdar[name] = lib
end

-- Native wrappers: Atdar.natives.<section>. An error in one file doesn't crash the script, that file stays empty
local NATIVES = {
    "entity",
    "player",
    "network",
    "visual",
    "world",
    "weapon",
    "audio",
    "input",
    "streaming",
}


Atdar.natives = {}
for _, name in NATIVES do
    Atdar.natives[name] = loader($"natives/{name}")
end


Atdar.ui.menu = require($"{Atdar.name}/ui/stand/menu")

-- \,