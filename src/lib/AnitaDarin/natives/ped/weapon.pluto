-- ped.weapon: a ped's weapons. Part of every Ped. Weapons may be given by name ("WEAPON_PISTOL") or hash

local class PedWeapon

    function __construct(ped: table)
        self.ped = ped
    end

    -- State

    function is_reloading(): bool
        return PED.IS_PED_RELOADING(self.ped:handle())
    end

    function is_switching(): bool
        return PED.IS_PED_SWITCHING_WEAPON(self.ped:handle())
    end

    function has(weapon: int|string, p2: bool = false): bool
        return WEAPON.HAS_PED_GOT_WEAPON(self.ped:handle(), Atdar.util.hash(weapon), p2)
    end

    function has_with_component(weapon: int|string, component: int|string): bool
        return WEAPON.HAS_PED_GOT_WEAPON_COMPONENT(self.ped:handle(), Atdar.util.hash(weapon), Atdar.util.hash(component))
    end

    -- Get

    -- @return Coordinates of the ped's last weapon impact, or nil if there is none
    function last_impact_coord(): ?vector3
        local coords_ptr = memory.alloc(24)
        if WEAPON.GET_PED_LAST_WEAPON_IMPACT_COORD(self.ped:handle(), coords_ptr) then
            return v3.new(memory.read_vector3(coords_ptr))
        end
        return nil
    end

    -- Actions

    function give(weapon: int|string, ammo: int = 1, is_hidden: bool = false, force_in_hand: bool = false): void
        WEAPON.GIVE_WEAPON_TO_PED(self.ped:handle(), Atdar.util.hash(weapon), ammo, is_hidden, force_in_hand)
    end

end

return PedWeapon
