-- ped.vehicle: the vehicle a ped is in. Part of every Ped

local Entity = Atdar.loader.load("natives/entity")

local class PedVehicle

    function __construct(ped: table)
        self.ped = ped
    end

    -- State

    function is_in_any(include_entering: bool = false): bool
        return PED.IS_PED_IN_ANY_VEHICLE(self.ped:handle(), include_entering)
    end

    -- vehicle: a Vehicle or a handle
    function is_in_this(vehicle: table|int, include_entering: bool = false): bool
        return PED.IS_PED_IN_VEHICLE(self.ped:handle(), Entity.handle_of(vehicle), include_entering)
    end

    -- Get

    -- @return The Vehicle the ped is in, or nil if it isn't in one
    function get(include_entering: bool = false): ?table
        if not self:is_in_any(include_entering) then
            return nil
        end
        local Vehicle = Atdar.natives.vehicle
        return new Vehicle(PED.GET_VEHICLE_PED_IS_IN(self.ped:handle(), include_entering))
    end

end

return PedVehicle
