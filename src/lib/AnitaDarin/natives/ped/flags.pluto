-- ped.flags: a ped's config and reset flags. Part of every Ped; the flag ids are Ped.CONFIG and Ped.RESET.
--   config flags stay set until changed (SET/GET_PED_CONFIG_FLAG)
--   reset flags are cleared by the game every frame, so they're set each tick (SET/GET_PED_RESET_FLAG)

local class PedFlags

    function __construct(ped: table)
        self.ped = ped
    end

    -- Get

    function get_config(flag: int): bool
        return PED.GET_PED_CONFIG_FLAG(self.ped:handle(), flag, true)
    end

    function get_reset(flag: int): bool
        return PED.GET_PED_RESET_FLAG(self.ped:handle(), flag)
    end

    -- Set

    function set_config(flag: int, toggle: bool): void
        PED.SET_PED_CONFIG_FLAG(self.ped:handle(), flag, toggle)
    end

    function set_reset(flag: int, toggle: bool): void
        PED.SET_PED_RESET_FLAG(self.ped:handle(), flag, toggle)
    end

end

PedFlags.CONFIG = {
    DROWNS_IN_WATER = 3,
    DROWNS_IN_SINKING_VEHICLE = 4,
    DIES_INSTANTLY_WHEN_SWIMMING = 5,
    IS_SCUBA = 135,
}

PedFlags.RESET = {
    -- body
}

return PedFlags
