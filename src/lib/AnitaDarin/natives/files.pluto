    return FILES.GET_DLC_WEAPON_DATA(dlc_weapon_index, out_data)
end

-- Same as GET_DLC_WEAPON_DATA but only works for DLC weapons that are available in SP
-- @param out_data Pointer: pass memory.alloc(size) and read the result back
function module.get_dlc_weapon_data_sp(dlc_weapon_index: int, out_data: int): bool
    return FILES.GET_DLC_WEAPON_DATA_SP(dlc_weapon_index, out_data)
end

