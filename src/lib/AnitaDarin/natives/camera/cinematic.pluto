-- The cinematic camera and cinematic shots

local module = {}

-- State

function module.is_rendering(): bool
    return CAM.IS_CINEMATIC_CAM_RENDERING()
end

function module.is_shaking(): bool
    return CAM.IS_CINEMATIC_CAM_SHAKING()
end

function module.is_idle_rendering(): bool
    return CAM.IS_CINEMATIC_IDLE_CAM_RENDERING()
end

-- Hash is always JOAAT("CAMERA_MAN_SHOT") in decompiled scripts
function module.is_shot_active(p0: int): bool
    return CAM.IS_CINEMATIC_SHOT_ACTIVE(p0)
end

-- Tests some cinematic camera flags
function module.is_input_active(): bool
    return CAM.IS_CINEMATIC_CAM_INPUT_ACTIVE()
end

-- Set

function module.set_button_active(p0: bool): void
    CAM.SET_CINEMATIC_BUTTON_ACTIVE(p0)
end

function module.set_shake_amplitude(p0: float): void
    CAM.SET_CINEMATIC_CAM_SHAKE_AMPLITUDE(p0)
end

function module.set_news_channel_active_this_update(): void
    CAM.SET_CINEMATIC_NEWS_CHANNEL_ACTIVE_THIS_UPDATE()
end

function module.set_mode_active(toggle: bool): void
    CAM.SET_CINEMATIC_MODE_ACTIVE(toggle)
end

-- Actions

function module.shake(shake_type: string, amount: float): void
    CAM.SHAKE_CINEMATIC_CAM(shake_type, amount)
end

function module.stop_shaking(p0: bool): void
    CAM.STOP_CINEMATIC_CAM_SHAKING(p0)
end

function module.disable_vehicle_idle_mode_this_update(): void
    CAM.DISABLE_CINEMATIC_VEHICLE_IDLE_MODE_THIS_UPDATE()
end

-- Resets the vehicle idle camera timer. Calling this in a loop will disable the idle camera
function module.invalidate_vehicle_idle_mode(): void
    CAM.INVALIDATE_CINEMATIC_VEHICLE_IDLE_MODE()
end

function module.invalidate_idle(): void
    CAM.INVALIDATE_IDLE_CAM()
end

function module.create_shot(p0: int, time: int, p2: bool, entity: int): void
    CAM.CREATE_CINEMATIC_SHOT(p0, time, p2, entity)
end

function module.stop_shot(p0: int): void
    CAM.STOP_CINEMATIC_SHOT(p0)
end

function module.force_rendering_this_update(toggle: bool): void
    CAM.FORCE_CINEMATIC_RENDERING_THIS_UPDATE(toggle)
end

function module.disable_slow_mo_this_update(): bool
    return CAM.DISABLE_CINEMATIC_SLOW_MO_THIS_UPDATE()
end

return module
