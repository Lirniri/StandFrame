local module = {}

-- State

function module.is_active(player_id: int): bool
    return NETWORK.NETWORK_IS_PLAYER_ACTIVE(player_id)
end

function module.is_friend(player_id: int): bool
    local player_handle = memory.alloc(104)
    NETWORK.NETWORK_HANDLE_FROM_PLAYER(player_id, player_handle, 13)
    local isFriend = NETWORK.NETWORK_IS_HANDLE_VALID(player_handle, 13) and NETWORK.NETWORK_IS_FRIEND(player_handle)
    return isFriend
end

function module.is_godmode(player_id: int): bool
    -- return PLAYER.GET_PLAYER_INVINCIBLE(player) -- TODO: Попытатья делать так чтобы, эта функция работала.
    return players.is_godmode(player_id)
end

function module.is_dead(player_id: int): bool
    local entity = Atdar.natives.entity
    local ped = module.get_ped_id(player_id)
    return entity.is_dead(ped)
end

function module.is_ragdoll(ped: int): bool
    return PED.IS_PED_RAGDOLL(ped)
end

function module.can_ragdoll(ped: int): bool
    return PED.CAN_PED_RAGDOLL(ped)
end

function module.is_player_dead(player_id: int): bool
    return PLAYER.IS_PLAYER_DEAD(player_id)
end

function module.is_pressing_horn(player_id: int): bool
    return PLAYER.IS_PLAYER_PRESSING_HORN(player_id)
end

-- Checks whether the specified player has a Ped, the Ped is not dead, is not injured and is not arrested
function module.is_playing(player_id: int): bool
    return PLAYER.IS_PLAYER_PLAYING(player_id)
end

function module.is_ready_for_cutscene(player_id: int): bool
    return PLAYER.IS_PLAYER_READY_FOR_CUTSCENE(player_id)
end

-- Can the player control himself, used to disable controls for player for things like a cutscene
