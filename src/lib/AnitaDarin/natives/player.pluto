local load = require($"{Atdar.name}/core/loader")

local module = { user = {} }

function module.get_name(player_id: int, ignore_streamer_spoof: bool = false)
    return players.get_name(player_id, ignore_streamer_spoof)
end

function module.get_rockstar_id(player_id: int, ignore_streamer_spoof: bool = false)
    return players.get_rockstar_id(player_id)
end

function module.get_money(player_id: int, type: int = 0)
    switch type do
        case 1:
            return players.get_wallet(player_id)
            break
        case 2:
            return players.get_bank(player_id)
            break
        default:
            return players.get_money(player_id)
    end
end
function module.get_position()
    
end

function module.is_exist(player_id: ?int = nil): int
    local player = player_id
    return NETWORK.NETWORK_IS_PLAYER_ACTIVE(player)
end
-- @return Ped of the given player, or of the local player if player_id is nil
function module.get_id(player_id: ?int = nil): int
    return PLAYER.PLAYER_ID()
end
function module.get_all_id(include_user: bool = true): int
    local ids = {}
    for _, p_id in players.list(include_user, true, true) do
        ids[p_id] = p_id
    end
    return ids
end

function module.get_ped_from_id(player_id: int): int
    return PLAYER.GET_PLAYER_PED_SCRIPT_INDEX(player_id)
end
function module.get_ped_id(player_id: ?int = nil): int
    if player_id ~= nil then
        return module.get_ped_from_id(player_id)
    end
    return PLAYER.PLAYER_PED_ID()
end

-- @return Tables of peds and matching player ids for every player in session
-- @return Table of { [player_id] = ped } for every player in session
function module.get_all_peds(include_user: bool = true): table
    local peds = {}
    for _, p_id in players.list(include_user, true, true) do
        peds[p_id] = module.get_ped_from_id(p_id)
    end
    return peds -- and player_id
end

-- @return Player id that owns the given ped (-1 if the ped is not a player), or the local player if ped is nil
function module.from_ped_to_player_id(ped: ?int = nil): int
    if ped ~= nil then
        return NETWORK.NETWORK_GET_PLAYER_INDEX_FROM_PED(ped)
    end
    return PLAYER.PLAYER_ID()
end

function module.get_net_id(player_id: int)
    local player = player_id
    return players.get_net_player(player)
end

function module.is_friend(player_id: int): bool
    local player_handle = memory.alloc(104)
    NETWORK_HANDLE_FROM_PLAYER(player_id, player_handle, 13)
    local isFriend = NETWORK_IS_HANDLE_VALID(player_handle, 13) and NETWORK_IS_FRIEND(player_handle)
    return isFriend
end

function module.is_godmode(player_id: int): bool
    local player = player_id
    -- return PLAYER.GET_PLAYER_INVINCIBLE(player)
    return players.is_godmode(player)
end

function module.set_godmode(player_id: int, toggle: bool): void
    local player = player_id
    PLAYER.SET_PLAYER_INVINCIBLE(player, toggle)
end
function module.set_half_godmode(player_id: int, toggle: bool): void
    local player = player_id
    PLAYER.SET_PLAYER_INVINCIBLE_BUT_HAS_REACTIONS(player, toggle)
end

function module.give_ragdoll_control(player_id: int, toggle: int): void
    local player = player_id
    PLAYER.GIVE_PLAYER_RAGDOLL_CONTROL(player)
end

-- @return Index of the active character slot
function module.get_char_slot(): int
    return util.get_char_slot()
end

function module.remove_helmet(player_id: int, p2: bool)
    local player = player_id
    PLAYER.REMOVE_PLAYER_HELMET(player, p2)
end

function module.user.get_vehicle(include_last_vehicle: bool = true, asPointer: bool = false)
    local handle = entities.get_user_vehicle_as_handle(include_last_vehicle)
    local pointer = entities.get_user_vehicle_as_pointer(include_last_vehicle)
    return asPointer and pointer or handle
end

function module.user.get_personal_vehicle(include_last_vehicle: bool = true, asPointer: bool = false): int
    if not util.is_session_started() then
        return nil
    end
    local handle = entities.get_user_personal_vehicle_as_handle(include_last_vehicle)
    local pointer = entities.handle_to_pointer(handle)
    return asPointer and pointer or handle
end

module.movement = load("natives/player/movement")
module.camera = load("natives/player/camera")
module.wanted_level = load("natives/player/wanted_level")
module.switch = load("natives/player/switch")

return module
