    PLAYER.RESET_PLAYER_INPUT_GAIT(player_id)
end

-- Only 1 match. ob_sofa_michael
function module.attach_virtual_bound(
    p0: float, p1: float, p2: float, p3: float, p4: float, p5: float, p6: float, p7: float
): void
    -- body function:
    PLAYER.PLAYER_ATTACH_VIRTUAL_BOUND(p0, p1, p2, p3, p4, p5, p6, p7)
end

function module.detach_virtual_bound(): void
    PLAYER.PLAYER_DETACH_VIRTUAL_BOUND()
end

-- Appears only 3 times in the scripts, more specifically in michael1.ysc
function module.extend_world_boundary(x: float, y: float, z: float): void
    PLAYER.EXTEND_WORLD_BOUNDARY_FOR_PLAYER(x, y, z)
end

function module.reset_world_boundary(): void
    PLAYER.RESET_WORLD_BOUNDARY_FOR_PLAYER()
end

function module.disable_vehicle_rewards(player_id: int): void
    PLAYER.DISABLE_PLAYER_VEHICLE_REWARDS(player_id)
end

-- Resets values set by SET_SCRIPT_FIRE_POSITION
function module.remove_script_fire_position(): void
    PLAYER.REMOVE_SCRIPT_FIRE_POSITION()
end

return Atdar.loader.auto(module, "natives/player")
