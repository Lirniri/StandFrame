local module = {}

-- State

function module.is_active(player_id: int): bool
    return NETWORK.NETWORK_IS_PLAYER_ACTIVE(player_id)
end

function module.is_friend(player_id: int): bool
    local player_handle = memory.alloc(104)
    NETWORK.NETWORK_HANDLE_FROM_PLAYER(player_id, player_handle, 13)
    local isFriend = NETWORK.NETWORK_IS_HANDLE_VALID(player_handle, 13) and NETWORK.NETWORK_IS_FRIEND(player_handle)
    return isFriend
end

function module.is_godmode(player_id: int): bool
    -- return PLAYER.GET_PLAYER_INVINCIBLE(player) -- TODO: Попытатья делать так чтобы, эта функция работала.
    return players.is_godmode(player_id)
end

function module.is_dead(player_id: int): bool
    local entity = Atdar.natives.entity
    local ped = module.get_ped_id(player_id)
    return entity.is_dead(ped)
end

function module.is_ragdoll(ped: int): bool
    return PED.IS_PED_RAGDOLL(ped)
end

function module.can_ragdoll(ped: int): bool
    return PED.CAN_PED_RAGDOLL(ped)
end

-- Get

function module.get_id(): int
    return PLAYER.PLAYER_ID()
end

function module.get_all_id(include_user: bool = true): table
    local ids = {}
    for _, p_id in players.list(include_user, true, true) do
        ids[p_id] = p_id
    end
    return ids
end

function module.get_name(player_id: int, ignore_streamer_spoof: bool = false)
    return players.get_name(player_id, ignore_streamer_spoof)
end

function module.get_rockstar_id(player_id: int)
    return players.get_rockstar_id(player_id)
end

function module.get_net(player_id: int)
    return players.get_net_player(player_id)
end

function module.get_money(player_id: int, kind: int|string = 0)

    local value = kind

    if type(value) == "string" then
        value = string:lower(value)
    end

    if value == 1 or value == "wallet" then
        return players.get_wallet(player_id)
    elseif value == 2 or value == "bank" then
        return players.get_bank(player_id)
    else
        return players.get_money(player_id)
    end
end

function module.get_position(player_id: int): vector3
    return players.get_position(player_id)
end

function module.get_waypoint(player_id: int): vector3
    return players.get_waypoint(player_id)
end

function module.get_max_armor(player_id: int): int
    return PLAYER.GET_PLAYER_MAX_ARMOUR(player_id)
end

function module.get_ped_from_id(player_id: int): int
    return PLAYER.GET_PLAYER_PED_SCRIPT_INDEX(player_id)
end

-- @return Ped of the given player, or of the local player if player_id is nil
function module.get_ped_id(player_id: ?int = nil): int
    if player_id ~= nil then
        return module.get_ped_from_id(player_id)
    end
    return PLAYER.PLAYER_PED_ID()
end

-- @return Table of { [player_id] = ped } for every player in session
function module.get_all_peds(include_user: bool = true): table
    local peds = {}
    for _, p_id in players.list(include_user, true, true) do
        peds[p_id] = module.get_ped_from_id(p_id)
    end
    return peds
end

-- @return Player id that owns the given ped (-1 if the ped is not a player), or the local player if ped is nil
function module.from_ped_to_id(ped: ?int = nil): int
    if ped ~= nil then
        return NETWORK.NETWORK_GET_PLAYER_INDEX_FROM_PED(ped)
    end
    return PLAYER.PLAYER_ID()
end

-- Set

function module.set_invincible(player_id: int, toggle: bool): void
    PLAYER.SET_PLAYER_INVINCIBLE(player_id, toggle)
end

function module.set_invincible_bus_has_reactions(player_id: int, toggle: bool): void
    PLAYER.SET_PLAYER_INVINCIBLE_BUT_HAS_REACTIONS(player_id, toggle)
end

function module.set_max_armor(player_id: int, value: int): int
    return PLAYER.SET_PLAYER_MAX_ARMOUR(player_id, value)
end

-- Actions

function module.give_ragdoll_control(player_id: int, toggle: bool): void
    PLAYER.GIVE_PLAYER_RAGDOLL_CONTROL(player_id, toggle)
end

function module.remove_helmet(player_id: int, p2: bool)
    PLAYER.REMOVE_PLAYER_HELMET(player_id, p2)
end

return Atdar.loader.auto(module, "natives/player")
