-- Get

function module.get_id(): int
    return PLAYER.PLAYER_ID()
end

function module.get_all_id(include_user: bool = true): table
    local ids = {}
    for _, p_id in players.list(include_user, true, true) do
        ids[p_id] = p_id
    end
    return ids
end

function module.get_name(player_id: int, ignore_streamer_spoof: bool = false)
    return players.get_name(player_id, ignore_streamer_spoof)
end

function module.get_rockstar_id(player_id: int)
    return players.get_rockstar_id(player_id)
end

function module.get_net(player_id: int)
    return players.get_net_player(player_id)
end

function module.get_money(player_id: int, kind: int|string = 0)

    local value = kind

    if type(value) == "string" then
        value = string:lower(value)
    end

    if value == 1 or value == "wallet" then
        return players.get_wallet(player_id)
    elseif value == 2 or value == "bank" then
        return players.get_bank(player_id)
    else
        return players.get_money(player_id)
    end
end

function module.get_position(player_id: int): vector3
    return players.get_position(player_id)
end

function module.get_waypoint(player_id: int): vector3
    return players.get_waypoint(player_id)
end

function module.get_max_armor(player_id: int): int
    return PLAYER.GET_PLAYER_MAX_ARMOUR(player_id)
end

function module.get_ped_from_id(player_id: int): int
    return PLAYER.GET_PLAYER_PED_SCRIPT_INDEX(player_id)
end

-- @return Ped of the given player, or of the local player if player_id is nil
function module.get_ped_id(player_id: ?int = nil): int
    if player_id ~= nil then
        return module.get_ped_from_id(player_id)
    end
    return PLAYER.PLAYER_PED_ID()
end

-- @return Table of { [player_id] = ped } for every player in session
function module.get_all_peds(include_user: bool = true): table
    local peds = {}
    for _, p_id in players.list(include_user, true, true) do
        peds[p_id] = module.get_ped_from_id(p_id)
    end
    return peds
end

-- @return Player id that owns the given ped (-1 if the ped is not a player), or the local player if ped is nil
function module.from_ped_to_id(ped: ?int = nil): int
    if ped ~= nil then
        return NETWORK.NETWORK_GET_PLAYER_INDEX_FROM_PED(ped)
    end
    return PLAYER.PLAYER_ID()
end

-- Gets the ped for a specified player index
function module.get_ped(player_id: int): int
    return PLAYER.GET_PLAYER_PED(player_id)
end

-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_rgb_colour(player_id: int, r: int, g: int, b: int): void
