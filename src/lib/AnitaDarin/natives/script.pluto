-- Scripts and threads (SCRIPT, BRAIN, SECURITY natives)

local module = {}

-- State

function module.is_object_within_brain_activation_range(object: int): bool
    return BRAIN.IS_OBJECT_WITHIN_BRAIN_ACTIVATION_RANGE(object)
end

-- Gets whether the world point the calling script is registered to is within desired range of the player
function module.is_world_point_within_brain_activation_range(): bool
    return BRAIN.IS_WORLD_POINT_WITHIN_BRAIN_ACTIVATION_RANGE()
end

-- Returns if a script has been loaded into the game. Used to see if a script was loaded after requesting
function module.has_loaded(script_name: string): bool
    return SCRIPT.HAS_SCRIPT_LOADED(script_name)
end

function module.does_exist(script_name: string): bool
    return SCRIPT.DOES_SCRIPT_EXIST(script_name)
end

function module.has_with_name_hash_loaded(script_hash: int): bool
    return SCRIPT.HAS_SCRIPT_WITH_NAME_HASH_LOADED(script_hash)
end

function module.does_with_name_hash_exist(script_hash: int): bool
    return SCRIPT.DOES_SCRIPT_WITH_NAME_HASH_EXIST(script_hash)
end

function module.is_thread_active(thread_id: int): bool
    return SCRIPT.IS_THREAD_ACTIVE(thread_id)
end

-- Get

function module.get_name_this_id(thread_id: int): string
    return SCRIPT.GET_NAME_OF_SCRIPT_WITH_THIS_ID(thread_id)
end

function module.get_id_this_thread(): int
    return SCRIPT.GET_ID_OF_THIS_THREAD()
end

-- Gets the number of instances of the specified script is currently running
function module.get_number_of_threads_running_this_hash(script_hash: int): int
    return SCRIPT.GET_NUMBER_OF_THREADS_RUNNING_THE_SCRIPT_WITH_THIS_HASH(script_hash)
end

function module.get_name(): string
    return SCRIPT.GET_THIS_SCRIPT_NAME()
end

function module.get_hash_name(): int
    return SCRIPT.GET_HASH_OF_THIS_SCRIPT_NAME()
end

function module.get_number_of_events(event_group: int): int
    return SCRIPT.GET_NUMBER_OF_EVENTS(event_group)
end

function module.get_event_exists(event_group: int, event_index: int): bool
    return SCRIPT.GET_EVENT_EXISTS(event_group, event_index)
end

function module.get_event_at_index(event_group: int, event_index: int): int
    return SCRIPT.GET_EVENT_AT_INDEX(event_group, event_index)
end

-- @param event_data Pointer: pass memory.alloc(size) and read the result back
function module.get_event_data(
    event_group: int, event_index: int, event_data: int, event_data_size: int
): bool
    -- body function:
    return SCRIPT.GET_EVENT_DATA(event_group, event_index, event_data, event_data_size)
end

function module.get_no_loading_screen(): bool
    return SCRIPT.GET_NO_LOADING_SCREEN()
end

-- Set

function module.set_as_no_longer_needed(script_name: string): void
    SCRIPT.SET_SCRIPT_AS_NO_LONGER_NEEDED(script_name)
end

function module.set_with_name_hash_as_no_longer_needed(script_hash: int): void
    SCRIPT.SET_SCRIPT_WITH_NAME_HASH_AS_NO_LONGER_NEEDED(script_hash)
end

function module.set_no_loading_screen(toggle: bool): void
    SCRIPT.SET_NO_LOADING_SCREEN(toggle)
end

-- Actions

function module.add_to_random_ped(name: string, model: int, p2: float, p3: float): void
    BRAIN.ADD_SCRIPT_TO_RANDOM_PED(name, model, p2, p3)
end

-- Registers a script for any object with a specific model hash
function module.register_object_brain(
    script_name: string, model_hash: int, p2: int, activation_range: float, p4: int, p5: int
): void
    -- body function:
    BRAIN.REGISTER_OBJECT_SCRIPT_BRAIN(script_name, model_hash, p2, activation_range, p4, p5)
end

function module.register_world_point_brain(script_name: string, activation_range: float, p2: int): void
    BRAIN.REGISTER_WORLD_POINT_SCRIPT_BRAIN(script_name, activation_range, p2)
end

function module.enable_brain_set(brain_set: int): void
    BRAIN.ENABLE_SCRIPT_BRAIN_SET(brain_set)
end

function module.disable_brain_set(brain_set: int): void
    BRAIN.DISABLE_SCRIPT_BRAIN_SET(brain_set)
end

function module.reactivate_all_world_brains_that_are_waiting_till_out_of_range(): void
    BRAIN.REACTIVATE_ALL_WORLD_BRAINS_THAT_ARE_WAITING_TILL_OUT_OF_RANGE()
end

function module.reactivate_all_object_brains_that_are_waiting_till_out_of_range(): void
    BRAIN.REACTIVATE_ALL_OBJECT_BRAINS_THAT_ARE_WAITING_TILL_OUT_OF_RANGE()
end

function module.reactivate_named_world_brains_waiting_till_out_of_range(script_name: string): void
    BRAIN.REACTIVATE_NAMED_WORLD_BRAINS_WAITING_TILL_OUT_OF_RANGE(script_name)
end

-- Looks like a cousin of above function _6D6840CEE8845831 as it was found among them. Must be similar
function module.reactivate_named_object_brains_waiting_till_out_of_range(script_name: string): void
    BRAIN.REACTIVATE_NAMED_OBJECT_BRAINS_WAITING_TILL_OUT_OF_RANGE(script_name)
end

function module.request(script_name: string): void
    SCRIPT.REQUEST_SCRIPT(script_name)
end

function module.request_with_name_hash(script_hash: int): void
    SCRIPT.REQUEST_SCRIPT_WITH_NAME_HASH(script_hash)
end

function module.terminate_thread(thread_id: int): void
    SCRIPT.TERMINATE_THREAD(thread_id)
end

-- Starts a new iteration of the current threads
function module.thread_iterator_reset(): void
    SCRIPT.SCRIPT_THREAD_ITERATOR_RESET()
end

function module.thread_iterator_get_next_thread_id(): int
    return SCRIPT.SCRIPT_THREAD_ITERATOR_GET_NEXT_THREAD_ID()
end

function module.terminate_this_thread(): void
    SCRIPT.TERMINATE_THIS_THREAD()
end

-- @param event_data Pointer: pass memory.alloc(size) and read the result back
function module.trigger_event(event_group: int, event_data: int, event_data_size: int, player_bits: int): void
    SCRIPT.TRIGGER_SCRIPT_EVENT(event_group, event_data, event_data_size, player_bits)
end

function module.shutdown_loading_screen(): void
    SCRIPT.SHUTDOWN_LOADING_SCREEN()
end

function module.commit_to_loadingscreen_selction(): void
    SCRIPT.COMMIT_TO_LOADINGSCREEN_SELCTION()
end

function module.bg_is_exitflag_set(): bool
    return SCRIPT.BG_IS_EXITFLAG_SET()
end

function module.bg_set_exitflag_response(): void
    SCRIPT.BG_SET_EXITFLAG_RESPONSE()
end

-- Hashed version of BG_START_CONTEXT
function module.bg_start_context_hash(context_hash: int): void
    SCRIPT.BG_START_CONTEXT_HASH(context_hash)
end

-- Hashed version of BG_END_CONTEXT
function module.bg_end_context_hash(context_hash: int): void
    SCRIPT.BG_END_CONTEXT_HASH(context_hash)
end

-- Inserts the given context into the background scripts context map
function module.bg_start_context(context_name: string): void
    SCRIPT.BG_START_CONTEXT(context_name)
end

-- Deletes the given context from the background scripts context map
function module.bg_end_context(context_name: string): void
    SCRIPT.BG_END_CONTEXT(context_name)
end

function module.bg_does_launch_param_exist(script_index: int, p1: string): bool
    return SCRIPT.BG_DOES_LAUNCH_PARAM_EXIST(script_index, p1)
end

function module.bg_get_launch_param_value(script_index: int, p1: string): int
    return SCRIPT.BG_GET_LAUNCH_PARAM_VALUE(script_index, p1)
end

function module.bg_get_id_from_name_hash(p0: int): int
    return SCRIPT.BG_GET_SCRIPT_ID_FROM_NAME_HASH(p0)
end

-- New variant of SEND_TU_SCRIPT_EVENT that automatically initializes the event data header
-- @param event_data Pointer: pass memory.alloc(size) and read the result back
function module.send_tu_event_new(
    event_group: int, event_data: int, event_data_size: int, player_bits: int, event_type: int
): void
    -- body function:
    SCRIPT._SEND_TU_SCRIPT_EVENT_NEW(event_group, event_data, event_data_size, player_bits, event_type)
end

-- Registers a protected variable that will be checked for modifications by the anticheat
-- @param variable Pointer: pass memory.alloc(size) and read the result back
function module.register_variable(variable: int): void
    SECURITY.REGISTER_SCRIPT_VARIABLE(variable)
end

-- @param variable Pointer: pass memory.alloc(size) and read the result back
function module.unregister_variable(variable: int): void
    SECURITY.UNREGISTER_SCRIPT_VARIABLE(variable)
end

function module.force_check_variables(): void
    SECURITY.FORCE_CHECK_SCRIPT_VARIABLES()
end

return module
