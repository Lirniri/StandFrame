-- Cutscenes (CUTSCENE natives)

local module = {}

-- State

function module.has_loaded(): bool
    return CUTSCENE.HAS_CUTSCENE_LOADED()
end

function module.has_this_cutscene_loaded(cutscene_name: string): bool
    return CUTSCENE.HAS_THIS_CUTSCENE_LOADED(cutscene_name)
end

function module.can_request_assets_for_entity(): bool
    return CUTSCENE.CAN_REQUEST_ASSETS_FOR_CUTSCENE_ENTITY()
end

function module.is_playback_flag_set(flag: int): bool
    return CUTSCENE.IS_CUTSCENE_PLAYBACK_FLAG_SET(flag)
end

-- Simply checks if the cutscene has loaded and doesn't check via CutSceneManager as opposed to HAS_[THIS]_CUTSCENE_LOADED
function module.has_cut_file_loaded(cutscene_name: string): bool
    return CUTSCENE.HAS_CUT_FILE_LOADED(cutscene_name)
end

function module.was_skipped(): bool
    return CUTSCENE.WAS_CUTSCENE_SKIPPED()
end

function module.has_finished(): bool
    return CUTSCENE.HAS_CUTSCENE_FINISHED()
end

function module.is_active(): bool
    return CUTSCENE.IS_CUTSCENE_ACTIVE()
end

function module.is_playing(): bool
    return CUTSCENE.IS_CUTSCENE_PLAYING()
end

function module.is_authorized(cutscene_name: string): bool
    return CUTSCENE.IS_CUTSCENE_AUTHORIZED(cutscene_name)
end

function module.does_handle_exist(cutscene_handle: int): int
    return CUTSCENE.DOES_CUTSCENE_HANDLE_EXIST(cutscene_handle)
end

function module.can_set_enter_state_for_registered_entity(cutscene_ent_name: string, model_hash: int): bool
    return CUTSCENE.CAN_SET_ENTER_STATE_FOR_REGISTERED_ENTITY(cutscene_ent_name, model_hash)
end

function module.can_set_exit_state_for_registered_entity(cutscene_ent_name: string, model_hash: int): bool
    return CUTSCENE.CAN_SET_EXIT_STATE_FOR_REGISTERED_ENTITY(cutscene_ent_name, model_hash)
end

function module.can_set_exit_state_for_camera(p0: bool): bool
    return CUTSCENE.CAN_SET_EXIT_STATE_FOR_CAMERA(p0)
end

function module.is_multihead_fade_up(): bool
    return CUTSCENE.IS_MULTIHEAD_FADE_UP()
end

function module.can_use_mobile_phone_during(): bool
    return CUTSCENE.CAN_USE_MOBILE_PHONE_DURING_CUTSCENE()
end

function module.does_entity_exist(cutscene_ent_name: string, model_hash: int): bool
    return CUTSCENE.DOES_CUTSCENE_ENTITY_EXIST(cutscene_ent_name, model_hash)
end

-- Possibly HAS_CUTSCENE_CUT_THIS_FRAME, needs more research
function module.has_cut_this_frame(): bool
    return CUTSCENE.HAS_CUTSCENE_CUT_THIS_FRAME()
end

-- Get

function module.get_cut_file_concat_count(cutscene_name: string): int
    return CUTSCENE.GET_CUT_FILE_CONCAT_COUNT(cutscene_name)
end

function module.get_time(): int
    return CUTSCENE.GET_CUTSCENE_TIME()
end

function module.get_play_time(): int
    return CUTSCENE.GET_CUTSCENE_PLAY_TIME()
end

function module.get_total_duration(): int
    return CUTSCENE.GET_CUTSCENE_TOTAL_DURATION()
end

function module.get_end_time(): int
    return CUTSCENE.GET_CUTSCENE_END_TIME()
end

function module.get_play_duration(): int
    return CUTSCENE.GET_CUTSCENE_PLAY_DURATION()
end

function module.get_section_playing(): int
    return CUTSCENE.GET_CUTSCENE_SECTION_PLAYING()
end

function module.get_entity_index_entity(cutscene_ent_name: string, model_hash: int): int
    return CUTSCENE.GET_ENTITY_INDEX_OF_CUTSCENE_ENTITY(cutscene_ent_name, model_hash)
end

function module.get_concat_section_playing(): int
    return CUTSCENE.GET_CUTSCENE_CONCAT_SECTION_PLAYING()
end

function module.get_entity_index_of_registered_entity(cutscene_ent_name: string, model_hash: int): int
    return CUTSCENE.GET_ENTITY_INDEX_OF_REGISTERED_ENTITY(cutscene_ent_name, model_hash)
end

-- Set

-- Sets the cutscene's owning thread ID
function module.set_script_can_start(thread_id: int): void
    CUTSCENE.SET_SCRIPT_CAN_START_CUTSCENE(thread_id)
end

function module.set_entity_streaming_flags(cutscene_ent_name: string, p1: int, p2: int): void
    CUTSCENE.SET_CUTSCENE_ENTITY_STREAMING_FLAGS(cutscene_ent_name, p1, p2)
end

function module.set_origin(x: float, y: float, z: float, p3: float, p4: int): void
    CUTSCENE.SET_CUTSCENE_ORIGIN(x, y, z, p3, p4)
end

function module.set_origin_and_orientation(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, p6: int
): void
    -- body function:
    CUTSCENE.SET_CUTSCENE_ORIGIN_AND_ORIENTATION(x1, y1, z1, x2, y2, z2, p6)
end

function module.set_vehicle_model_player_will_exit_scene(model_hash: int): void
    CUTSCENE.SET_VEHICLE_MODEL_PLAYER_WILL_EXIT_SCENE(model_hash)
end

-- Only used twice in R* scripts
function module.set_trigger_area(x1: float, y1: float, z1: float, x2: float, y2: float, z2: float): void
    CUTSCENE.SET_CUTSCENE_TRIGGER_AREA(x1, y1, z1, x2, y2, z2)
end

function module.set_pad_can_shake_during(toggle: bool): void
    CUTSCENE.SET_PAD_CAN_SHAKE_DURING_CUTSCENE(toggle)
end

function module.set_fade_values(p0: bool, p1: bool, p2: bool, p3: bool): void
    CUTSCENE.SET_CUTSCENE_FADE_VALUES(p0, p1, p2, p3)
end

function module.set_multihead_fade(p0: bool, p1: bool, p2: bool, p3: bool): void
    CUTSCENE.SET_CUTSCENE_MULTIHEAD_FADE(p0, p1, p2, p3)
end

function module.set_multihead_fade_manual(p0: bool): void
    CUTSCENE.SET_CUTSCENE_MULTIHEAD_FADE_MANUAL(p0)
end

function module.set_car_generators_can_update_during(p0: bool): void
    CUTSCENE.SET_CAR_GENERATORS_CAN_UPDATE_DURING_CUTSCENE(p0)
end

function module.set_can_be_skipped(p0: bool): void
    CUTSCENE.SET_CUTSCENE_CAN_BE_SKIPPED(p0)
end

function module.set_can_display_minimap_during_update(): void
    CUTSCENE.SET_CAN_DISPLAY_MINIMAP_DURING_CUTSCENE_THIS_UPDATE()
end

function module.set_ped_component_variation(
    cutscene_ent_name: string, component_id: int, drawable_id: int, texture_id: int, model_hash: int
): void
    -- body function:
    CUTSCENE.SET_CUTSCENE_PED_COMPONENT_VARIATION(cutscene_ent_name, component_id, drawable_id, texture_id, model_hash)
end

function module.set_ped_component_variation_from_ped(
    cutscene_ent_name: string, ped: int, model_hash: int
): void
    -- body function:
    CUTSCENE.SET_CUTSCENE_PED_COMPONENT_VARIATION_FROM_PED(cutscene_ent_name, ped, model_hash)
end

function module.set_ped_prop_variation(
    cutscene_ent_name: string, component_id: int, drawable_id: int, texture_id: int, model_hash: int
): void
    -- body function:
    CUTSCENE.SET_CUTSCENE_PED_PROP_VARIATION(cutscene_ent_name, component_id, drawable_id, texture_id, model_hash)
end

-- Actions

function module.request(cutscene_name: string, flags: int): void
    CUTSCENE.REQUEST_CUTSCENE(cutscene_name, flags)
end

function module.request_with_playback_list(cutscene_name: string, playback_flags: int, flags: int): void
    CUTSCENE.REQUEST_CUTSCENE_WITH_PLAYBACK_LIST(cutscene_name, playback_flags, flags)
end

function module.remove(): void
    CUTSCENE.REMOVE_CUTSCENE()
end

-- Simply loads the cutscene and doesn't do extra stuff that REQUEST_CUTSCENE does
function module.request_cut_file(cutscene_name: string): void
    CUTSCENE.REQUEST_CUT_FILE(cutscene_name)
end

-- Simply unloads the cutscene and doesn't do extra stuff that REMOVE_CUTSCENE does
function module.remove_cut_file(cutscene_name: string): void
    CUTSCENE.REMOVE_CUT_FILE(cutscene_name)
end

function module.start(flags: int): void
    CUTSCENE.START_CUTSCENE(flags)
end

function module.start_at_coords(x: float, y: float, z: float, flags: int): void
    CUTSCENE.START_CUTSCENE_AT_COORDS(x, y, z, flags)
end

function module.stop(p0: bool): void
    CUTSCENE.STOP_CUTSCENE(p0)
end

function module.stop_immediately(): void
    CUTSCENE.STOP_CUTSCENE_IMMEDIATELY()
end

function module.register_entity(
    cutscene_ped: int, cutscene_ent_name: string, p2: int, model_hash: int, p4: int
): void
    -- body function:
    CUTSCENE.REGISTER_ENTITY_FOR_CUTSCENE(cutscene_ped, cutscene_ent_name, p2, model_hash, p4)
end

-- Stops current cutscene with a fade transition
function module.network_set_mocap_can_be_skipped(p0: bool): void
    CUTSCENE.NETWORK_SET_MOCAP_CUTSCENE_CAN_BE_SKIPPED(p0)
end

return module
