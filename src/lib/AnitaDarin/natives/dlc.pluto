-- Installed DLC packs and cloud content checks (DLC natives)

local module = {}

-- State

function module.are_any_ccs_pending(): bool
    return DLC.ARE_ANY_CCS_PENDING()
end

function module.is_present(dlc_hash: int): bool
    return DLC.IS_DLC_PRESENT(dlc_hash)
end

-- Sets the value of the specified variable to 0
-- @param p0 Pointer: pass memory.alloc(size) and read the result back
function module.has_cloud_requests_finished(p0: int, unused: int): bool
    return DLC.HAS_CLOUD_REQUESTS_FINISHED(p0, unused)
end

-- Get

function module.get_extracontent_cloud_result(): int
    return DLC.GET_EXTRACONTENT_CLOUD_RESULT()
end

function module.get_ever_had_bad_pack_order(): bool
    return DLC.GET_EVER_HAD_BAD_PACK_ORDER()
end

function module.get_is_loading_screen_active(): bool
    return DLC.GET_IS_LOADING_SCREEN_ACTIVE()
end

function module.get_is_initial_loading_screen_active(): bool
    return DLC.GET_IS_INITIAL_LOADING_SCREEN_ACTIVE()
end

-- Actions

function module.check_cloud_data_correct(): bool
    return DLC.DLC_CHECK_CLOUD_DATA_CORRECT()
end

function module.check_compat_pack_configuration(): bool
    return DLC.DLC_CHECK_COMPAT_PACK_CONFIGURATION()
end

function module.on_enter_sp(): void
    DLC.ON_ENTER_SP()
end

-- This loads the GTA:O dlc map parts (high end garages, apartments)
function module.on_enter_mp(): void
    DLC.ON_ENTER_MP()
end

return module
