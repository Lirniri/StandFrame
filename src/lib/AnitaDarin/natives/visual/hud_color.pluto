-- Index and name of each colour: module.RED == 6; NAMES[6] == "RED"
local NAMES = {}
local DEFAULTS = {}
for _, entry in ipairs(COLORS) do
    local index, name = entry[1], entry[2]
    module[name] = index
    NAMES[index] = name
    DEFAULTS[index] = { r = entry[3], g = entry[4], b = entry[5], a = entry[6] }
end

-- Get

-- @return The colour's name without HUD_COLOUR_ ("RED"), or nil for an unknown index
function module.name_of(index: int): ?string
    return NAMES[index]
end

-- @return The default colour of the slot, 0 - 255 (a copy), or nil for an unknown index
function module.default(index: int): ?table
    local colour = DEFAULTS[index]
    if colour == nil then
        return nil
    end
    return { r = colour.r, g = colour.g, b = colour.b, a = colour.a }
end

-- @return The colour the game uses for the slot now, 0 - 255
function module.get(index: int): table
    local r, g, b, a = memory.alloc_int(), memory.alloc_int(), memory.alloc_int(), memory.alloc_int()
    HUD.GET_HUD_COLOUR(index, r, g, b, a)
    return { r = memory.read_int(r), g = memory.read_int(g), b = memory.read_int(b), a = memory.read_int(a) }
end

-- @return Every colour in index order: { index, name, r, g, b, a } (copies), e.g. for a menu list
function module.list(): table
    local list = {}
    for _, entry in ipairs(COLORS) do
        table.insert(list, { index = entry[1], name = entry[2], r = entry[3], g = entry[4], b = entry[5], a = entry[6] })
    end
    return list
end

return module
