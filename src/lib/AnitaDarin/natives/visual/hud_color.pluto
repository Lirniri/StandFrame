-- HUD colours: the game's colour slots (HUD_COLOUR_*), by index, with their default RGBA.
-- Natives that take a "hudColorIndex" take these indexes: THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST,
-- blips, text. Scripts can replace a slot's colour (REPLACE_HUD_COLOUR_WITH_RGBA), so the default here
-- isn't always what the game shows now: get() asks the game.
-- Source: https://docs.fivem.net/docs/game-references/hud-colors/ (common:/data/ui/hudcolor.dat)
--
--     local hud_color = Atdar.natives.visual.hud_color
--     hud_color.RED                    -- 6, the index for natives
--     hud_color.default(hud_color.RED) -- { r = 224, g = 50, b = 50, a = 255 }
--     hud_color.get(hud_color.RED)     -- the colour the game uses now
--     hud_color.name_of(6)             -- "RED"

