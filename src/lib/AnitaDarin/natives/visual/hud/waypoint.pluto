local blip = Atdar.loader.load("natives/visual/hud/blip")

local module = {}

function module.is_active(): bool
    return HUD.IS_WAYPOINT_ACTIVE()
end

function module.get_blip(): ?int
    local handle = HUD.GET_FIRST_BLIP_INFO_ID(blip.waypoint.get_sprite())
    return blip.is_exist(handle) ? handle : nil
end

-- Set

function module.set_force_show_gps(toggle: bool): void
    HUD.SET_FORCE_SHOW_GPS(toggle)
end

-- This native removes the current waypoint from the map
function module.set_off(): void
    HUD.SET_WAYPOINT_OFF()
end

function module.set_new(x: float, y: float): void
    HUD.SET_NEW_WAYPOINT(x, y)
end

function module.set_fake_gps_player_position_this_frame(x: float, y: float, p2: any): void
    HUD.SET_FAKE_GPS_PLAYER_POSITION_THIS_FRAME(x, y, p2)
end

function module.set_gps_flags(p0: int, p1: float): void
    HUD.SET_GPS_FLAGS(p0, p1)
end

function module.set_gps_custom_route_render(toggle: bool, radar_thickness: int, map_thickness: int): void
    HUD.SET_GPS_CUSTOM_ROUTE_RENDER(toggle, radar_thickness, map_thickness)
end

function module.set_gps_multi_route_render(toggle: bool): void
    HUD.SET_GPS_MULTI_ROUTE_RENDER(toggle)
end

function module.set_gps_flashes(toggle: bool): void
    HUD.SET_GPS_FLASHES(toggle)
end

-- Actions

function module.delete_waypoints_this_player(): void
    HUD.DELETE_WAYPOINTS_FROM_THIS_PLAYER()
end

function module.refresh(): void
    HUD.REFRESH_WAYPOINT()
end

-- Clears the GPS flags. Only the script that originally called SET_GPS_FLAGS can clear them
function module.clear_gps_flags(): void
    HUD.CLEAR_GPS_FLAGS()
end

function module.clear_gps_race_track(): void
    HUD.CLEAR_GPS_RACE_TRACK()
end

-- Starts a new GPS custom-route, allowing you to plot lines on the map
function module.start_gps_custom_route(hud_color: int, display_on_foot: bool, follow_player: bool): void
    HUD.START_GPS_CUSTOM_ROUTE(hud_color, display_on_foot, follow_player)
end

function module.add_point_to_gps_custom_route(x: float, y: float, z: float): void
    HUD.ADD_POINT_TO_GPS_CUSTOM_ROUTE(x, y, z)
end

function module.clear_gps_custom_route(): void
    HUD.CLEAR_GPS_CUSTOM_ROUTE()
end

-- Starts a new GPS multi-route, allowing you to create custom GPS paths
function module.start_gps_multi_route(hud_color: int, route_from_player: bool, display_on_foot: bool): void
    HUD.START_GPS_MULTI_ROUTE(hud_color, route_from_player, display_on_foot)
end

function module.add_point_to_gps_multi_route(x: float, y: float, z: float): void
    HUD.ADD_POINT_TO_GPS_MULTI_ROUTE(x, y, z)
end

function module.clear_gps_multi_route(): void
    HUD.CLEAR_GPS_MULTI_ROUTE()
end

function module.clear_gps_player(): void
    HUD.CLEAR_GPS_PLAYER_WAYPOINT()
end

return module
