local module = { color = {}, begin = {}, end = {} }

function module.is_paused(): bool
    return HUD.THEFEED_IS_PAUSED()
end

function module.pause(): void
    HUD.THEFEED_PAUSE()
end

function module.resume(): void
    HUD.THEFEED_RESUME()
end

function module.freeze_next(): void
    HUD.THEFEED_FREEZE_NEXT_POST()
end

function module.remove(id: int): void
    HUD.THEFEED_REMOVE_ITEM(id)
end

-- thefeed > color

function module.color.set_text_background(color)
    HUD.THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST(color)
end

-- thefeed > begin
function module.begin.post(): void
    HUD.BEGIN_TEXT_COMMAND_THEFEED_POST("STRING")
    -- visual.hud.text.add_string
end

-- thefeed > end
function module.end.post_message(
    sender: string, 
    subject: string,
    flash: bool = false,
    icon_type: int = 0,
    txd_name,
    texture_name
): int


    --[[
        iconTypes:
        1 : Chat Box
        2 : Email
        3 : Add Friend Request
        4 : Nothing
        5 : Nothing
        6 : Nothing
        7 : Right Jumping Arrow
        8 : RP Icon
        9 : $ Icon
    ]]
    -- "sender" is the very top header. This can be any old string.
    -- "subject" is the header under the sender.

    local txd = txd_name
    local texture = texture_name
    local icon = icon_type

    return HUD.END_TEXT_COMMAND_THEFEED_POST_MESSAGETEXT(
        txd,
        texture,
        flash,
        icon,
        sender,
        subject
    )
end

function module.end.post_ticker(blink: bool = 0, p1: bool = 1, is_mp: bool = false): int
    if is_mp then
        return HUD.END_TEXT_COMMAND_THEFEED_POST_MPTICKER(blink, p1)
    end
    return HUD.END_TEXT_COMMAND_THEFEED_POST_TICKER(blink, p1)
end



return module