-- thefeed: the game's notification feed (above the minimap). Every post gets an id the game gives,
-- thefeed.remove(id) takes it away again.
--
--     local thefeed = Atdar.natives.visual.hud.thefeed
--     local id = thefeed.post_ticker("Saved")
--     thefeed.post_message("Text", { sender = "AnitaDarin", subject = "Profiles", picture = "CHAR_SOCIAL_CLUB" })
--     thefeed.remove(id)
--     thefeed.remove_all()               -- every post the script made (also when the script stops)

local hud_color = Atdar.loader.load("natives/visual/hud_color")

local module = {}

-- Message icons (post_message's opts.icon): the small sign at the card's top right. 4 - 6 show none
module.ICON = {
    CHAT_BOX = 1,
    EMAIL = 2,
    FRIEND_REQUEST = 3,
    NONE = 4,
    ARROW = 7,
    RP = 8,
    MONEY = 9,
}

-- Starts a post with this text; an END_TEXT_COMMAND_THEFEED_POST_* native finishes it
local function begin_post(text: string): void
    HUD.BEGIN_TEXT_COMMAND_THEFEED_POST("STRING")
    HUD.ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME(text)
end

-- State

function module.is_paused(): bool
    return HUD.THEFEED_IS_PAUSED()
end

-- Set

-- The background colour of the next post (a HUD colour index, natives/visual/hud_color)
function module.set_next_background(hud_color: int): void
    HUD.THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST(hud_color)
end


-- The background of the next post in any colour (0 - 255). The background takes only a HUD colour
-- index, so the script slot is filled with this colour and its index is used
function module.set_next_background_color(r: int, g: int, b: int, a: int = 255): void
    HUD.SET_SCRIPT_VARIABLE_HUD_COLOUR(r, g, b, a)
    -- HUD_COLOUR_SCRIPT_VARIABLE: the slot left for scripts to fill with their own colour
    HUD.THEFEED_SET_BACKGROUND_COLOR_FOR_NEXT_POST(hud_color.SCRIPT_VARIABLE)
end

-- The colour the next post flashes in, when it flashes (0 - 255)
function module.set_next_flash_color(r: int, g: int, b: int, a: int = 255): void
    HUD.THEFEED_SET_RGBA_PARAMETER_FOR_NEXT_MESSAGE(r, g, b, a)
end

-- Actions

-- Takes a post away from the feed
function module.remove(id: int): void
    HUD.THEFEED_REMOVE_ITEM(id)
end

function module.pause(): void
    HUD.THEFEED_PAUSE()
end

function module.resume(): void
    HUD.THEFEED_RESUME()
end

-- The next post stays on screen
function module.freeze_next(): void
    HUD.THEFEED_FREEZE_NEXT_POST()
end

-- The script's own posts still known, oldest first: remove_all() takes them away. The game gives
-- no list of its feed, so only posts made here can be removed. The oldest are forgotten past this many
local KEEP_POSTS = 100
local posts = {}

-- @return The id, for the caller
local function remember(id: int): int
    table.insert(posts, id)
    if #posts > KEEP_POSTS then
        table.remove(posts, 1)
    end
    return id
end

-- Takes every post the script made away from the feed (other scripts' and the game's stay)
-- @return How many were removed
function module.remove_all(): int
    local count = #posts
    for _, id in ipairs(posts) do
        pcall(module.remove, id)
    end
    posts = {}
    return count
end

-- The script's posts go with it
util.on_stop(|| -> module.remove_all())

-- Plain text.
-- @param important Blinks
-- @param is_mp The online style
-- @return The post's id (remove(id) takes it away)
function module.post_ticker(text: string, important: bool = false, is_mp: bool = false): int
    begin_post(text)
    if is_mp then
        return remember(HUD.END_TEXT_COMMAND_THEFEED_POST_MPTICKER(important, true))
    end
    return remember(HUD.END_TEXT_COMMAND_THEFEED_POST_TICKER(important, true))
end

-- A message card: picture, sender (the top line), subject (under it), the text below.
-- opts: sender, subject, picture (a texture dictionary that's also the texture name, e.g. "CHAR_SOCIAL_CLUB"),
--       icon (module.ICON, default CHAT_BOX), important (flashes)
-- @return The post's id (remove(id) takes it away)
function module.post_message(text: string, opts: table = {}): int
    begin_post(text)
    local picture = opts.picture or "CHAR_SOCIAL_CLUB"
    local id = HUD.END_TEXT_COMMAND_THEFEED_POST_MESSAGETEXT(picture, picture, opts.important == true,
        opts.icon or module.ICON.CHAT_BOX, opts.sender or "", opts.subject or "")
    return remember(id)
end

return module
