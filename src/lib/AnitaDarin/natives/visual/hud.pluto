local load = Atdar.loader.load

local module = {}

module.blip = load("natives/visual/hud/blip")

module.money = load("natives/visual/hud/money")
module.minimap = load("natives/visual/hud/minimap")
module.text = load("natives/visual/hud/text")
module.thefeed = load("natives/visual/hud/thefeed")
module.waypoint = load("natives/visual/hud/waypoint")
module.wanted_level = load("natives/visual/hud/wanted_level")

-- hud
function module.is_hidden(): bool
    return HUD.IS_HUD_HIDDEN()
end

function module.get_color(hud_color_index: int): table
    local r, g, b, a = memory.alloc_int(), memory.alloc_int(), memory.alloc_int(), memory.alloc_int()
    HUD.GET_HUD_COLOUR(hud_color_index, r, g, b, a)
    return {
        r = memory.read_int(r),
        g = memory.read_int(g),
        b = memory.read_int(b),
        a = memory.read_int(a),
    }
end

return module
