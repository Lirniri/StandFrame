-- Shape tests (raycasts)

local module = {}

-- Get

-- @param hit Pointer: pass memory.alloc(size) and read the result back
-- @param end_coords Pointer: pass memory.alloc(size) and read the result back
-- @param surface_normal Pointer: pass memory.alloc(size) and read the result back
-- @param entity_hit Pointer: pass memory.alloc(size) and read the result back
function module.get_result(
    shape_test_handle: int, hit: int, end_coords: int, surface_normal: int, entity_hit: int
): int
    -- body function:
    return SHAPETEST.GET_SHAPE_TEST_RESULT(shape_test_handle, hit, end_coords, surface_normal, entity_hit)
end

-- Returns the result of a shape test, also returning the material of any touched surface
-- @param hit Pointer: pass memory.alloc(size) and read the result back
-- @param end_coords Pointer: pass memory.alloc(size) and read the result back
-- @param surface_normal Pointer: pass memory.alloc(size) and read the result back
-- @param material_hash Pointer: pass memory.alloc(size) and read the result back
-- @param entity_hit Pointer: pass memory.alloc(size) and read the result back
function module.get_result_including_material(
    shape_test_handle: int, hit: int, end_coords: int, surface_normal: int, material_hash: int,
    entity_hit: int
): int
    -- body function:
    return SHAPETEST.GET_SHAPE_TEST_RESULT_INCLUDING_MATERIAL(shape_test_handle, hit, end_coords, surface_normal, material_hash, entity_hit)
end

-- Actions

-- Asynchronously starts a line-of-sight (raycast) world probe shape test
function module.start_los_probe(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, flags: int, entity: int,
    p8: int
): int
    -- body function:
    return SHAPETEST.START_SHAPE_TEST_LOS_PROBE(x1, y1, z1, x2, y2, z2, flags, entity, p8)
end

function module.start_expensive_synchronous_los_probe(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, flags: int, entity: int,
    p8: int
): int
    -- body function:
    return SHAPETEST.START_EXPENSIVE_SYNCHRONOUS_SHAPE_TEST_LOS_PROBE(x1, y1, z1, x2, y2, z2, flags, entity, p8)
end

function module.start_bounding_box(entity: int, flags1: int, flags2: int): int
    return SHAPETEST.START_SHAPE_TEST_BOUNDING_BOX(entity, flags1, flags2)
end

function module.start_box(
    x: float, y: float, z: float, dim_x: float, dim_y: float, dim_z: float, rot_x: float,
    rot_y: float, rot_z: float, p9: any, flags: int, entity: int, p12: any
): int
    -- body function:
    return SHAPETEST.START_SHAPE_TEST_BOX(x, y, z, dim_x, dim_y, dim_z, rot_x, rot_y, rot_z, p9, flags, entity, p12)
end

function module.start_bound(entity: int, flags1: int, flags2: int): int
    return SHAPETEST.START_SHAPE_TEST_BOUND(entity, flags1, flags2)
end

-- Raycast from point to point, where the ray has a radius
function module.start_capsule(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, radius: float, flags: int,
    entity: int, p9: int
): int
    -- body function:
    return SHAPETEST.START_SHAPE_TEST_CAPSULE(x1, y1, z1, x2, y2, z2, radius, flags, entity, p9)
end

function module.start_swept_sphere(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, radius: float, flags: int,
    entity: int, p9: any
): int
    -- body function:
    return SHAPETEST.START_SHAPE_TEST_SWEPT_SPHERE(x1, y1, z1, x2, y2, z2, radius, flags, entity, p9)
end

-- Returns a ShapeTest handle that can be used with GET_SHAPE_TEST_RESULT
-- @param p_vec1 Pointer: pass memory.alloc(size) and read the result back
-- @param p_vec2 Pointer: pass memory.alloc(size) and read the result back
function module.start_mouse_cursor_los_probe(
    p_vec1: int, p_vec2: int, flag: int, entity: int, flag2: int
): int
    -- body function:
    return SHAPETEST.START_SHAPE_TEST_MOUSE_CURSOR_LOS_PROBE(p_vec1, p_vec2, flag, entity, flag2)
end

function module.release_script_guid_from_entity(entity_hit: int): void
    SHAPETEST.RELEASE_SCRIPT_GUID_FROM_ENTITY(entity_hit)
end

return module
