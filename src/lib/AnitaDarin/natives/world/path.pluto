local module = {}

-- State

function module.is_vehicle_node_id_valid(vehicle_node_id: int): bool
    return PATHFIND.IS_VEHICLE_NODE_ID_VALID(vehicle_node_id)
end

function module.are_nodes_loaded_for_area(x1: float, y1: float, x2: float, y2: float): bool
    return PATHFIND.ARE_NODES_LOADED_FOR_AREA(x1, y1, x2, y2)
end

-- Gets a value indicating whether the specified position is on a road
function module.is_point_on_road(x: float, y: float, z: float, vehicle: int): bool
    return PATHFIND.IS_POINT_ON_ROAD(x, y, z, vehicle)
end

function module.is_navmesh_required_region_in_use(): bool
    return PATHFIND.IS_NAVMESH_REQUIRED_REGION_IN_USE()
end

function module.are_all_navmesh_regions_loaded(): bool
    return PATHFIND.ARE_ALL_NAVMESH_REGIONS_LOADED()
end

function module.is_navmesh_loaded_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float
): bool
    -- body function:
    return PATHFIND.IS_NAVMESH_LOADED_IN_AREA(x1, y1, z1, x2, y2, z2)
end

function module.does_navmesh_blocking_object_exist(p0: any): bool
    return PATHFIND.DOES_NAVMESH_BLOCKING_OBJECT_EXIST(p0)
end

-- Get

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_safe_coord_for_ped(
    x: float, y: float, z: float, on_ground: bool, out_position: int, flags: int
): bool
    -- body function:
    return PATHFIND.GET_SAFE_COORD_FOR_PED(x, y, z, on_ground, out_position, flags)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_closest_vehicle_node(
    x: float, y: float, z: float, out_position: int, node_flags: int, p5: float, p6: float
): bool
    -- body function:
    return PATHFIND.GET_CLOSEST_VEHICLE_NODE(x, y, z, out_position, node_flags, p5, p6)
end

-- Get the closest vehicle node to a given position
-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_closest_major_vehicle_node(
    x: float, y: float, z: float, out_position: int, unknown1: float, unknown2: float
): bool
    -- body function:
    return PATHFIND.GET_CLOSEST_MAJOR_VEHICLE_NODE(x, y, z, out_position, unknown1, unknown2)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param out_heading Pointer: pass memory.alloc(size) and read the result back
function module.get_closest_vehicle_node_with_heading(
    x: float, y: float, z: float, out_position: int, out_heading: int, node_type: int, p6: float,
    p7: float
): bool
    -- body function:
    return PATHFIND.GET_CLOSEST_VEHICLE_NODE_WITH_HEADING(x, y, z, out_position, out_heading, node_type, p6, p7)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_nth_closest_vehicle_node(
    x: float, y: float, z: float, nth_closest: int, out_position: int, node_flags: int,
    unknown1: float, unknown2: float
): bool
    -- body function:
    return PATHFIND.GET_NTH_CLOSEST_VEHICLE_NODE(x, y, z, nth_closest, out_position, node_flags, unknown1, unknown2)
end

-- Returns the id
function module.get_nth_closest_vehicle_node_id(
    x: float, y: float, z: float, nth: int, node_flags: int, p5: float, p6: float
): int
    -- body function:
    return PATHFIND.GET_NTH_CLOSEST_VEHICLE_NODE_ID(x, y, z, nth, node_flags, p5, p6)
end

-- Get the nth closest vehicle node and its heading
-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param out_heading Pointer: pass memory.alloc(size) and read the result back
-- @param out_num_lanes Pointer: pass memory.alloc(size) and read the result back
function module.get_nth_closest_vehicle_node_with_heading(
    x: float, y: float, z: float, nth_closest: int, out_position: int, out_heading: int,
    out_num_lanes: int, node_flags: int, unknown3: float, unknown4: float
): bool
    -- body function:
    return PATHFIND.GET_NTH_CLOSEST_VEHICLE_NODE_WITH_HEADING(x, y, z, nth_closest, out_position, out_heading, out_num_lanes, node_flags, unknown3, unknown4)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param out_heading Pointer: pass memory.alloc(size) and read the result back
function module.get_nth_closest_vehicle_node_id_with_heading(
    x: float, y: float, z: float, nth_closest: int, out_position: int, out_heading: int,
    node_flags: int, p7: float, p8: float
): int
    -- body function:
    return PATHFIND.GET_NTH_CLOSEST_VEHICLE_NODE_ID_WITH_HEADING(x, y, z, nth_closest, out_position, out_heading, node_flags, p7, p8)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param out_heading Pointer: pass memory.alloc(size) and read the result back
function module.get_nth_closest_vehicle_node_favour_direction(
    x: float, y: float, z: float, desired_x: float, desired_y: float, desired_z: float,
    nth_closest: int, out_position: int, out_heading: int, node_flags: int, p10: float, p11: float
): bool
    -- body function:
    return PATHFIND.GET_NTH_CLOSEST_VEHICLE_NODE_FAVOUR_DIRECTION(x, y, z, desired_x, desired_y, desired_z, nth_closest, out_position, out_heading, node_flags, p10, p11)
end

-- Gets the density and flags of the closest node to the specified position
-- @param density Pointer: pass memory.alloc(size) and read the result back
-- @param flags Pointer: pass memory.alloc(size) and read the result back
function module.get_vehicle_node_properties(x: float, y: float, z: float, density: int, flags: int): bool
    return PATHFIND.GET_VEHICLE_NODE_PROPERTIES(x, y, z, density, flags)
end

-- Calling this with an invalid node id, will crash the game
-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_vehicle_node_position(node_id: int, out_position: int): void
    PATHFIND.GET_VEHICLE_NODE_POSITION(node_id, out_position)
end

function module.get_vehicle_node_is_gps_allowed(node_id: int): bool
    return PATHFIND.GET_VEHICLE_NODE_IS_GPS_ALLOWED(node_id)
end

function module.get_vehicle_node_is_switched_off(node_id: int): bool
    return PATHFIND.GET_VEHICLE_NODE_IS_SWITCHED_OFF(node_id)
end

-- @param p5 Pointer: pass memory.alloc(size) and read the result back
-- @param p6 Pointer: pass memory.alloc(size) and read the result back
-- @param p7 Pointer: pass memory.alloc(size) and read the result back
-- @param p8 Pointer: pass memory.alloc(size) and read the result back
-- @param p9 Pointer: pass memory.alloc(size) and read the result back
function module.get_closest_road(
    x: float, y: float, z: float, p3: float, p4: int, p5: int, p6: int, p7: int, p8: int, p9: int,
    p10: bool
): bool
    -- body function:
    return PATHFIND.GET_CLOSEST_ROAD(x, y, z, p3, p4, p5, p6, p7, p8, p9, p10)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param node_id Pointer: pass memory.alloc(size) and read the result back
function module.get_random_vehicle_node(
    x: float, y: float, z: float, radius: float, p4: bool, p5: bool, p6: bool, out_position: int,
    node_id: int
): bool
    -- body function:
    return PATHFIND.GET_RANDOM_VEHICLE_NODE(x, y, z, radius, p4, p5, p6, out_position, node_id)
end

-- @param centre_point Pointer: pass memory.alloc(size) and read the result back
-- @param heading Pointer: pass memory.alloc(size) and read the result back
function module.get_spawn_coords_for_vehicle_node(
    node_address: int, towards_coors_x: float, towards_coors_y: float, towards_coors_z: float,
    centre_point: int, heading: int
): vector3
    -- body function:
    return PATHFIND.GET_SPAWN_COORDS_FOR_VEHICLE_NODE(node_address, towards_coors_x, towards_coors_y, towards_coors_z, centre_point, heading)
end

-- Determines the name of the street which is the closest to the given coordinates
-- @param street_name Pointer: pass memory.alloc(size) and read the result back
-- @param crossing_road Pointer: pass memory.alloc(size) and read the result back
function module.get_street_name_at_coord(
    x: float, y: float, z: float, street_name: int, crossing_road: int
): void
    -- body function:
    PATHFIND.GET_STREET_NAME_AT_COORD(x, y, z, street_name, crossing_road)
end

function module.get_gps_blip_route_length(): int
    return PATHFIND.GET_GPS_BLIP_ROUTE_LENGTH()
end

-- @param result Pointer: pass memory.alloc(size) and read the result back
function module.get_pos_along_gps_type_route(result: int, p1: bool, p2: float, p3: int): bool
    return PATHFIND.GET_POS_ALONG_GPS_TYPE_ROUTE(result, p1, p2, p3)
end

function module.get_gps_blip_route_found(): bool
    return PATHFIND.GET_GPS_BLIP_ROUTE_FOUND()
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_road_boundary_using_heading(
    x: float, y: float, z: float, heading: float, out_position: int
): bool
    -- body function:
    return PATHFIND.GET_ROAD_BOUNDARY_USING_HEADING(x, y, z, heading, out_position)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
function module.get_position_by_side_of_road(x: float, y: float, z: float, p3: int, out_position: int): bool
    return PATHFIND.GET_POSITION_BY_SIDE_OF_ROAD(x, y, z, p3, out_position)
end

-- Gets the next zone that has been disabled using SET_GPS_DISABLED_ZONE_AT_INDEX
function module.get_next_gps_disabled_zone_index(): int
    return PATHFIND.GET_NEXT_GPS_DISABLED_ZONE_INDEX()
end

function module.get_num_navmeshes_existing_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float
): int
    -- body function:
    return PATHFIND.GET_NUM_NAVMESHES_EXISTING_IN_AREA(x1, y1, z1, x2, y2, z2)
end

-- Returns CGameWorldHeightMap's maximum Z value at specified point (grid node)
function module.get_approx_height_for_point(x: float, y: float): float
    return PATHFIND.GET_APPROX_HEIGHT_FOR_POINT(x, y)
end

-- Returns CGameWorldHeightMap's maximum Z among all grid nodes that intersect with the specified rectangle
function module.get_approx_height_for_area(x1: float, y1: float, x2: float, y2: float): float
    return PATHFIND.GET_APPROX_HEIGHT_FOR_AREA(x1, y1, x2, y2)
end

-- Returns CGameWorldHeightMap's minimum Z value at specified point (grid node)
function module.get_approx_floor_for_point(x: float, y: float): float
    return PATHFIND.GET_APPROX_FLOOR_FOR_POINT(x, y)
end

-- Returns CGameWorldHeightMap's minimum Z among all grid nodes that intersect with the specified rectangle
function module.get_approx_floor_for_area(x1: float, y1: float, x2: float, y2: float): float
    return PATHFIND.GET_APPROX_FLOOR_FOR_AREA(x1, y1, x2, y2)
end

-- Set

-- When nodeEnabled is set to false, all nodes in the area get disabled
function module.set_roads_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, node_enabled: bool,
    unknown2: bool
): void
    -- body function:
    PATHFIND.SET_ROADS_IN_AREA(x1, y1, z1, x2, y2, z2, node_enabled, unknown2)
end

function module.set_roads_in_angled_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, width: float, unknown1: bool,
    unknown2: bool, unknown3: bool
): void
    -- body function:
    PATHFIND.SET_ROADS_IN_ANGLED_AREA(x1, y1, z1, x2, y2, z2, width, unknown1, unknown2, unknown3)
end

function module.set_ped_paths_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, p6: bool, p7: any
): void
    -- body function:
    PATHFIND.SET_PED_PATHS_IN_AREA(x1, y1, z1, x2, y2, z2, p6, p7)
end

function module.set_allow_stream_prologue_nodes(toggle: bool): void
    PATHFIND.SET_ALLOW_STREAM_PROLOGUE_NODES(toggle)
end

function module.set_allow_stream_heist_island_nodes(type: int): void
    PATHFIND.SET_ALLOW_STREAM_HEIST_ISLAND_NODES(type)
end

function module.set_roads_back_to_original(
    p0: float, p1: float, p2: float, p3: float, p4: float, p5: float, p6: any
): void
    -- body function:
    PATHFIND.SET_ROADS_BACK_TO_ORIGINAL(p0, p1, p2, p3, p4, p5, p6)
end

function module.set_roads_back_to_original_in_angled_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, width: float, p7: any
): void
    -- body function:
    PATHFIND.SET_ROADS_BACK_TO_ORIGINAL_IN_ANGLED_AREA(x1, y1, z1, x2, y2, z2, width, p7)
end

function module.set_ambient_ped_range_multiplier_this_frame(multiplier: float): void
    PATHFIND.SET_AMBIENT_PED_RANGE_MULTIPLIER_THIS_FRAME(multiplier)
end

function module.set_ped_paths_back_to_original(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, p6: any
): void
    -- body function:
    PATHFIND.SET_PED_PATHS_BACK_TO_ORIGINAL(x1, y1, z1, x2, y2, z2, p6)
end

function module.set_ignore_no_gps_flag(toggle: bool): void
    PATHFIND.SET_IGNORE_NO_GPS_FLAG(toggle)
end

function module.set_ignore_no_gps_flag_until_first_normal_node(toggle: bool): void
    PATHFIND.SET_IGNORE_NO_GPS_FLAG_UNTIL_FIRST_NORMAL_NODE(toggle)
end

function module.set_gps_disabled_zone(x1: float, y1: float, z1: float, x2: float, y2: float, z3: float): void
    PATHFIND.SET_GPS_DISABLED_ZONE(x1, y1, z1, x2, y2, z3)
end

function module.set_gps_disabled_zone_at_index(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, index: int
): void
    -- body function:
    PATHFIND.SET_GPS_DISABLED_ZONE_AT_INDEX(x1, y1, z1, x2, y2, z2, index)
end

-- Actions

function module.load_all_path_nodes(set: bool): bool
    return PATHFIND.LOAD_ALL_PATH_NODES(set)
end

-- Used internally for long range tasks
function module.request_path_nodes_in_area_this_frame(x1: float, y1: float, x2: float, y2: float): bool
    return PATHFIND.REQUEST_PATH_NODES_IN_AREA_THIS_FRAME(x1, y1, x2, y2)
end

function module.adjust_ambient_ped_spawn_densities_this_frame(
    p0: any, p1: any, p2: any, p3: any, p4: any, p5: any, p6: any
): void
    -- body function:
    PATHFIND.ADJUST_AMBIENT_PED_SPAWN_DENSITIES_THIS_FRAME(p0, p1, p2, p3, p4, p5, p6)
end

-- @param direction Pointer: pass memory.alloc(size) and read the result back
-- @param p5 Pointer: pass memory.alloc(size) and read the result back
-- @param dist_to_nx_junction Pointer: pass memory.alloc(size) and read the result back
function module.generate_directions_to_coord(
    x: float, y: float, z: float, p3: bool, direction: int, p5: int, dist_to_nx_junction: int
): int
    -- body function:
    return PATHFIND.GENERATE_DIRECTIONS_TO_COORD(x, y, z, p3, direction, p5, dist_to_nx_junction)
end

-- Clears a disabled GPS route area from a certain index previously set using `SET_GPS_DISABLED_ZONE_AT_INDEX`
function module.clear_gps_disabled_zone_at_index(index: int): void
    PATHFIND.CLEAR_GPS_DISABLED_ZONE_AT_INDEX(index)
end

function module.add_navmesh_required_region(x: float, y: float, radius: float): void
    PATHFIND.ADD_NAVMESH_REQUIRED_REGION(x, y, radius)
end

function module.remove_navmesh_required_regions(): void
    PATHFIND.REMOVE_NAVMESH_REQUIRED_REGIONS()
end

-- Set toggle true to disable navmesh
function module.disable_navmesh_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, toggle: bool
): void
    -- body function:
    PATHFIND.DISABLE_NAVMESH_IN_AREA(x1, y1, z1, x2, y2, z2, toggle)
end

function module.add_navmesh_blocking_object(
    p0: float, p1: float, p2: float, p3: float, p4: float, p5: float, p6: float, p7: bool, p8: any
): int
    -- body function:
    return PATHFIND.ADD_NAVMESH_BLOCKING_OBJECT(p0, p1, p2, p3, p4, p5, p6, p7, p8)
end

function module.update_navmesh_blocking_object(
    p0: any, p1: float, p2: float, p3: float, p4: float, p5: float, p6: float, p7: float, p8: any
): void
    -- body function:
    PATHFIND.UPDATE_NAVMESH_BLOCKING_OBJECT(p0, p1, p2, p3, p4, p5, p6, p7, p8)
end

function module.remove_navmesh_blocking_object(p0: any): void
    PATHFIND.REMOVE_NAVMESH_BLOCKING_OBJECT(p0)
end

-- Calculates the travel distance between a set of points
function module.calculate_travel_distance_between_points(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float
): float
    -- body function:
    return PATHFIND.CALCULATE_TRAVEL_DISTANCE_BETWEEN_POINTS(x1, y1, z1, x2, y2, z2)
end

return module
