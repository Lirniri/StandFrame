local module = {}

-- State

function module.is_scene(): bool
    return INTERIOR.IS_INTERIOR_SCENE()
end

function module.is_valid(interior: int): bool
    return INTERIOR.IS_VALID_INTERIOR(interior)
end

function module.is_ready(interior: int): bool
    return INTERIOR.IS_INTERIOR_READY(interior)
end

function module.is_collision_marked_outside(x: float, y: float, z: float): bool
    return INTERIOR.IS_COLLISION_MARKED_OUTSIDE(x, y, z)
end

function module.is_entity_set_active(interior: int, entity_set_name: string): bool
    return INTERIOR.IS_INTERIOR_ENTITY_SET_ACTIVE(interior, entity_set_name)
end

function module.is_disabled(interior: int): bool
    return INTERIOR.IS_INTERIOR_DISABLED(interior)
end

function module.is_capped(interior: int): bool
    return INTERIOR.IS_INTERIOR_CAPPED(interior)
end

-- Get

function module.get_heading(interior: int): float
    return INTERIOR.GET_INTERIOR_HEADING(interior)
end

-- @param position Pointer: pass memory.alloc(size) and read the result back
-- @param name_hash Pointer: pass memory.alloc(size) and read the result back
function module.get_location_and_namehash(interior: int, position: int, name_hash: int): void
    INTERIOR.GET_INTERIOR_LOCATION_AND_NAMEHASH(interior, position, name_hash)
end

-- Returns the group ID of the specified interior
function module.get_group_id(interior: int): int
    return INTERIOR.GET_INTERIOR_GROUP_ID(interior)
end

function module.get_offset_from_in_world_coords(interior: int, x: float, y: float, z: float): vector3
    return INTERIOR.GET_OFFSET_FROM_INTERIOR_IN_WORLD_COORDS(interior, x, y, z)
end

function module.get_room_key_from_entity(entity: int): int
    return INTERIOR.GET_ROOM_KEY_FROM_ENTITY(entity)
end

function module.get_key_for_entity_in_room(entity: int): int
    return INTERIOR.GET_KEY_FOR_ENTITY_IN_ROOM(entity)
end

function module.get_from_entity(entity: int): int
    return INTERIOR.GET_INTERIOR_FROM_ENTITY(entity)
end

function module.get_room_key_for_game_viewport(): int
    return INTERIOR.GET_ROOM_KEY_FOR_GAME_VIEWPORT()
end

-- Returns the current interior id from gameplay camera
function module.get_from_primary_view(): int
    return INTERIOR.GET_INTERIOR_FROM_PRIMARY_VIEW()
end

function module.get_at_coords(x: float, y: float, z: float): int
    return INTERIOR.GET_INTERIOR_AT_COORDS(x, y, z)
end

function module.get_at_coords_with_type(x: float, y: float, z: float, interior_type: string): int
    return INTERIOR.GET_INTERIOR_AT_COORDS_WITH_TYPE(x, y, z, interior_type)
end

-- Hashed version of GET_INTERIOR_AT_COORDS_WITH_TYPE
function module.get_at_coords_with_typehash(x: float, y: float, z: float, type_hash: int): int
    return INTERIOR.GET_INTERIOR_AT_COORDS_WITH_TYPEHASH(x, y, z, type_hash)
end

function module.get_from_collision(x: float, y: float, z: float): int
    return INTERIOR.GET_INTERIOR_FROM_COLLISION(x, y, z)
end

-- Set

function module.set_room_for_game_viewport_by_name(room_name: string): void
    INTERIOR.SET_ROOM_FOR_GAME_VIEWPORT_BY_NAME(room_name)
end

function module.set_room_for_game_viewport_by_key(room_hash_key: int): void
    INTERIOR.SET_ROOM_FOR_GAME_VIEWPORT_BY_KEY(room_hash_key)
end

-- Only used once in the entire game scripts
function module.set_in_use(interior: int): bool
    return INTERIOR.SET_INTERIOR_IN_USE(interior)
end

function module.set_entity_set_tint_index(interior: int, entity_set_name: string, color: int): void
    INTERIOR.SET_INTERIOR_ENTITY_SET_TINT_INDEX(interior, entity_set_name, color)
end

function module.set_is_exterior_only(entity: int, toggle: bool): void
    INTERIOR.SET_IS_EXTERIOR_ONLY(entity, toggle)
end

-- Actions

function module.clear_room_for_entity(entity: int): void
    INTERIOR.CLEAR_ROOM_FOR_ENTITY(entity)
end

function module.force_room_for_entity(entity: int, interior: int, room_hash_key: int): void
    INTERIOR.FORCE_ROOM_FOR_ENTITY(entity, interior, room_hash_key)
end

function module.retain_entity_in(entity: int, interior: int): void
    INTERIOR.RETAIN_ENTITY_IN_INTERIOR(entity, interior)
end

-- Immediately removes entity from an interior. Like sets entity to `limbo` room
function module.clear_state_of_entity(entity: int): void
    INTERIOR.CLEAR_INTERIOR_STATE_OF_ENTITY(entity)
end

function module.force_activating_tracking_on_entity(p0: any, p1: any): void
    INTERIOR.FORCE_ACTIVATING_TRACKING_ON_ENTITY(p0, p1)
end

function module.force_room_for_game_viewport(interior_id: int, room_hash_key: int): void
    INTERIOR.FORCE_ROOM_FOR_GAME_VIEWPORT(interior_id, room_hash_key)
end

function module.clear_room_for_game_viewport(): void
    INTERIOR.CLEAR_ROOM_FOR_GAME_VIEWPORT()
end

function module.add_pickup_to_room_by_name(pickup: int, room_name: string): void
    INTERIOR.ADD_PICKUP_TO_INTERIOR_ROOM_BY_NAME(pickup, room_name)
end

function module.pin_in_memory(interior: int): void
    INTERIOR.PIN_INTERIOR_IN_MEMORY(interior)
end

function module.unpin(interior: int): void
    INTERIOR.UNPIN_INTERIOR(interior)
end

function module.activate_groups_using_camera(): void
    INTERIOR.ACTIVATE_INTERIOR_GROUPS_USING_CAMERA()
end

function module.enable_stadium_probes_this_frame(toggle: bool): void
    INTERIOR.ENABLE_STADIUM_PROBES_THIS_FRAME(toggle)
end

function module.activate_entity_set(interior: int, entity_set_name: string): void
    INTERIOR.ACTIVATE_INTERIOR_ENTITY_SET(interior, entity_set_name)
end

function module.deactivate_entity_set(interior: int, entity_set_name: string): void
    INTERIOR.DEACTIVATE_INTERIOR_ENTITY_SET(interior, entity_set_name)
end

function module.refresh(interior: int): void
    INTERIOR.REFRESH_INTERIOR(interior)
end

-- This is the native that is used to hide the exterior of GTA Online apartment buildings when you are inside an apartment
function module.enable_exterior_cull_model_this_frame(map_object_hash: int): void
    INTERIOR.ENABLE_EXTERIOR_CULL_MODEL_THIS_FRAME(map_object_hash)
end

function module.enable_shadow_cull_model_this_frame(map_object_hash: int): void
    INTERIOR.ENABLE_SHADOW_CULL_MODEL_THIS_FRAME(map_object_hash)
end

function module.disable(interior: int, toggle: bool): void
    INTERIOR.DISABLE_INTERIOR(interior, toggle)
end

function module.cap(interior: int, toggle: bool): void
    INTERIOR.CAP_INTERIOR(interior, toggle)
end

function module.disable_metro_system(toggle: bool): void
    INTERIOR.DISABLE_METRO_SYSTEM(toggle)
end

return module
