local module = {}

-- State

function module.is_prev_type(weather_type: string): bool
    return MISC.IS_PREV_WEATHER_TYPE(weather_type)
end

function module.is_next_type(weather_type: string): bool
    return MISC.IS_NEXT_WEATHER_TYPE(weather_type)
end

-- Get

-- Returns current weather name hash
function module.get_prev_type_hash_name(): int
    return MISC.GET_PREV_WEATHER_TYPE_HASH_NAME()
end

-- Returns weather name hash
function module.get_next_type_hash_name(): int
    return MISC.GET_NEXT_WEATHER_TYPE_HASH_NAME()
end

-- @param weather_type1 Pointer: pass memory.alloc(size) and read the result back
-- @param weather_type2 Pointer: pass memory.alloc(size) and read the result back
-- @param percent_weather2 Pointer: pass memory.alloc(size) and read the result back
function module.get_curr_state(weather_type1: int, weather_type2: int, percent_weather2: int): void
    MISC.GET_CURR_WEATHER_STATE(weather_type1, weather_type2, percent_weather2)
end

function module.get_wind_speed(): float
    return MISC.GET_WIND_SPEED()
end

function module.get_wind_direction(): vector3
    return MISC.GET_WIND_DIRECTION()
end

function module.get_rain_level(): float
    return MISC.GET_RAIN_LEVEL()
end

function module.get_snow_level(): float
    return MISC.GET_SNOW_LEVEL()
end

function module.get_clouds_alpha(): float
    return MISC.GET_CLOUDS_ALPHA()
end

-- Set

function module.set_type_persist(weather_type: string): void
    MISC.SET_WEATHER_TYPE_PERSIST(weather_type)
end

function module.set_type_now_persist(weather_type: string): void
    MISC.SET_WEATHER_TYPE_NOW_PERSIST(weather_type)
end

function module.set_type_now(weather_type: string): void
    MISC.SET_WEATHER_TYPE_NOW(weather_type)
end

function module.set_type_overtime_persist(weather_type: string, time: float): void
    MISC.SET_WEATHER_TYPE_OVERTIME_PERSIST(weather_type, time)
end

function module.set_random_type(): void
    MISC.SET_RANDOM_WEATHER_TYPE()
end

function module.set_curr_state(weather_type1: int, weather_type2: int, percent_weather2: float): void
    MISC.SET_CURR_WEATHER_STATE(weather_type1, weather_type2, percent_weather2)
end

function module.set_override(weather_type: string): void
    MISC.SET_OVERRIDE_WEATHER(weather_type)
end

function module.set_override_weatherex(weather_type: string, p1: bool): void
    MISC.SET_OVERRIDE_WEATHEREX(weather_type, p1)
end

function module.set_wind(speed: float): void
    MISC.SET_WIND(speed)
end

function module.set_wind_speed(speed: float): void
    MISC.SET_WIND_SPEED(speed)
end

-- The wind direction in radians
function module.set_wind_direction(direction: float): void
    MISC.SET_WIND_DIRECTION(direction)
end

function module.set_rain(intensity: float): void
    MISC.SET_RAIN(intensity)
end

function module.set_snow(level: float): void
    MISC.SET_SNOW(level)
end

function module.set_cloud_settings_override(p0: string): void
    MISC.SET_CLOUD_SETTINGS_OVERRIDE(p0)
end

function module.set_clouds_alpha(opacity: float): void
    MISC.SET_CLOUDS_ALPHA(opacity)
end

-- Actions

function module.clear_type_persist(): void
    MISC.CLEAR_WEATHER_TYPE_PERSIST()
end

function module.clear_type_now_persist_network(milliseconds: int): void
    MISC.CLEAR_WEATHER_TYPE_NOW_PERSIST_NETWORK(milliseconds)
end

function module.clear_override(): void
    MISC.CLEAR_OVERRIDE_WEATHER()
end

function module.force_lightning_flash(): void
    MISC.FORCE_LIGHTNING_FLASH()
end

function module.preload_cloud_hat(name: string): void
    MISC.PRELOAD_CLOUD_HAT(name)
end

function module.load_cloud_hat(name: string, transition_time: float): void
    MISC.LOAD_CLOUD_HAT(name, transition_time)
end

function module.unload_cloud_hat(name: string, p1: float): void
    MISC.UNLOAD_CLOUD_HAT(name, p1)
end

function module.unload_all_cloud_hats(): void
    MISC.UNLOAD_ALL_CLOUD_HATS()
end

function module.plm_is_in_constrained_mode(): bool
    return MISC.PLM_IS_IN_CONSTRAINED_MODE()
end

-- Returns duration of how long the game has been in power-saving mode (aka "constrained") in milliseconds
function module.plm_get_constrained_duration_ms(): int
    return MISC.PLM_GET_CONSTRAINED_DURATION_MS()
end

return module
