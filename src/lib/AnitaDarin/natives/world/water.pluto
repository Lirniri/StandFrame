local module = {}

-- Get

-- This function set height to the value of z-axis of the water surface
-- @param height Pointer: pass memory.alloc(size) and read the result back
function module.get_height(x: float, y: float, z: float, height: int): bool
    return WATER.GET_WATER_HEIGHT(x, y, z, height)
end

-- @param height Pointer: pass memory.alloc(size) and read the result back
function module.get_height_no_waves(x: float, y: float, z: float, height: int): bool
    return WATER.GET_WATER_HEIGHT_NO_WAVES(x, y, z, height)
end

-- Gets the aggressiveness factor of the ocean waves
function module.get_deep_ocean_scaler(): float
    return WATER.GET_DEEP_OCEAN_SCALER()
end

-- Set

function module.set_deep_ocean_scaler(intensity: float): void
    WATER.SET_DEEP_OCEAN_SCALER(intensity)
end

function module.set_calmed_wave_height_scaler(height: float): void
    WATER.SET_CALMED_WAVE_HEIGHT_SCALER(height)
end

-- Actions

-- @param result Pointer: pass memory.alloc(size) and read the result back
function module.test_probe_against(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, result: int
): bool
    -- body function:
    return WATER.TEST_PROBE_AGAINST_WATER(x1, y1, z1, x2, y2, z2, result)
end

-- @param water_height Pointer: pass memory.alloc(size) and read the result back
function module.test_probe_against_all(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, flags: int, water_height: int
): int
    -- body function:
    return WATER.TEST_PROBE_AGAINST_ALL_WATER(x1, y1, z1, x2, y2, z2, flags, water_height)
end

-- @param water_height Pointer: pass memory.alloc(size) and read the result back
function module.test_vertical_probe_against_all(
    x: float, y: float, z: float, flags: int, water_height: int
): int
    -- body function:
    return WATER.TEST_VERTICAL_PROBE_AGAINST_ALL_WATER(x, y, z, flags, water_height)
end

-- Sets the water height for a given position and radius
function module.modify(x: float, y: float, radius: float, height: float): void
    WATER.MODIFY_WATER(x, y, radius, height)
end

function module.add_extra_calming_quad(
    x_low: float, y_low: float, x_high: float, y_high: float, height: float
): int
    -- body function:
    return WATER.ADD_EXTRA_CALMING_QUAD(x_low, y_low, x_high, y_high, height)
end

function module.remove_extra_calming_quad(calming_quad: int): void
    WATER.REMOVE_EXTRA_CALMING_QUAD(calming_quad)
end

-- Sets the waves intensity back to original (1.0 in most cases)
function module.reset_deep_ocean_scaler(): void
    WATER.RESET_DEEP_OCEAN_SCALER()
end

return module
