-- The game's cameras (CAM natives). Not entities: a camera has a handle of its own that ENTITY
-- natives don't take. Where other players look is natives.player.camera (Stand's players API)

local module = {}

-- Names of scripted camera kinds, for CAM.CREATE_CAM / CREATE_CAM_WITH_PARAMS
module.types = {
    scripted = "DEFAULT_SCRIPTED_CAMERA",
    scripted_fly = "DEFAULT_SCRIPTED_FLY_CAMERA",
    animated = "DEFAULT_ANIMATED_CAMERA",
    spline = "DEFAULT_SPLINE_CAMERA",
    timed_spline = "TIMED_SPLINE_CAMERA",
}

-- State

-- Returns whether or not the passed camera handle exists
function module.does_exist(cam: int): bool
    return CAM.DOES_CAM_EXIST(cam)
end

-- Returns whether or not the passed camera handle is active
function module.is_active(cam: int): bool
    return CAM.IS_CAM_ACTIVE(cam)
end

function module.is_rendering(cam: int): bool
    return CAM.IS_CAM_RENDERING(cam)
end

function module.is_spline_paused(cam: int): bool
    return CAM.IS_CAM_SPLINE_PAUSED(cam)
end

function module.is_interpolating(cam: int): bool
    return CAM.IS_CAM_INTERPOLATING(cam)
end

function module.is_shaking(cam: int): bool
    return CAM.IS_CAM_SHAKING(cam)
end

-- In drunk_controller.c4, sub_309
function module.is_script_global_shaking(): bool
    return CAM.IS_SCRIPT_GLOBAL_SHAKING()
end

function module.is_playing_anim(cam: int, anim_name: string, anim_dictionary: string): bool
    return CAM.IS_CAM_PLAYING_ANIM(cam, anim_name, anim_dictionary)
end

function module.was_fly_constrained_on_previous_udpate(cam: int): bool
    return CAM.WAS_FLY_CAM_CONSTRAINED_ON_PREVIOUS_UDPATE(cam)
end

function module.is_interpolating_from_script_cams(): bool
    return CAM.IS_INTERPOLATING_FROM_SCRIPT_CAMS()
end

function module.is_interpolating_to_script_cams(): bool
    return CAM.IS_INTERPOLATING_TO_SCRIPT_CAMS()
end

function module.is_sphere_visible(x: float, y: float, z: float, radius: float): bool
    return CAM.IS_SPHERE_VISIBLE(x, y, z, radius)
end

function module.is_in_vehicle_mobile_phone_rendering(): bool
    return CAM.IS_IN_VEHICLE_MOBILE_PHONE_CAMERA_RENDERING()
end

function module.is_allowed_independent_modes(): bool
    return CAM.IS_ALLOWED_INDEPENDENT_CAMERA_MODES()
end

-- Get

-- @return The context the view mode is chosen for now (on foot, in a vehicle, ...)
function module.get_active_view_mode_context(): int
    return CAM.GET_CAM_ACTIVE_VIEW_MODE_CONTEXT()
end

-- @return The view mode (first person, third person near / mid / far, ...) set for a context
function module.get_view_mode_for_context(context: int): int
    return CAM.GET_CAM_VIEW_MODE_FOR_CONTEXT(context)
end

-- @param rotation_order The order the axes are turned in, 0 - 5; 2 is what scripts mostly use
-- @return Where the camera that's drawn now looks
function module.get_final_rotation(rotation_order: int = 2): vector3
    return CAM.GET_FINAL_RENDERED_CAM_ROT(rotation_order)
end

function module.get_rendering(): int
    return CAM.GET_RENDERING_CAM()
end

function module.get_coord(cam: int): vector3
    return CAM.GET_CAM_COORD(cam)
end

-- The last parameter, as in other "ROT" methods, is usually 2
function module.get_rot(cam: int, rotation_order: int): vector3
    return CAM.GET_CAM_ROT(cam, rotation_order)
end

function module.get_fov(cam: int): float
    return CAM.GET_CAM_FOV(cam)
end

function module.get_near_clip(cam: int): float
    return CAM.GET_CAM_NEAR_CLIP(cam)
end

function module.get_far_clip(cam: int): float
    return CAM.GET_CAM_FAR_CLIP(cam)
end

function module.get_near_dof(cam: int): float
    return CAM.GET_CAM_NEAR_DOF(cam)
end

function module.get_far_dof(cam: int): float
    return CAM.GET_CAM_FAR_DOF(cam)
end

function module.get_dof_strength(cam: int): float
    return CAM.GET_CAM_DOF_STRENGTH(cam)
end

function module.get_debug(): int
    return CAM.GET_DEBUG_CAM()
end

function module.get_spline_phase(cam: int): float
    return CAM.GET_CAM_SPLINE_PHASE(cam)
end

-- I'm pretty sure the parameter is the camera as usual, but I am not certain so I'm going to leave it as is
function module.get_spline_node_phase(cam: int): float
    return CAM.GET_CAM_SPLINE_NODE_PHASE(cam)
end

function module.get_spline_node_index(cam: int): int
    return CAM.GET_CAM_SPLINE_NODE_INDEX(cam)
end

function module.get_anim_current_phase(cam: int): float
    return CAM.GET_CAM_ANIM_CURRENT_PHASE(cam)
end

function module.get_final_rendered_coord(): vector3
    return CAM.GET_FINAL_RENDERED_CAM_COORD()
end

function module.get_final_rendered_remote_player_rot(player_id: int, rotation_order: int): vector3
    return CAM.GET_FINAL_RENDERED_REMOTE_PLAYER_CAM_ROT(player_id, rotation_order)
end

-- Gets some camera fov
function module.get_final_rendered_fov(): float
    return CAM.GET_FINAL_RENDERED_CAM_FOV()
end

function module.get_final_rendered_remote_player_fov(player_id: int): float
    return CAM.GET_FINAL_RENDERED_REMOTE_PLAYER_CAM_FOV(player_id)
end

function module.get_final_rendered_near_clip(): float
    return CAM.GET_FINAL_RENDERED_CAM_NEAR_CLIP()
end

function module.get_final_rendered_far_clip(): float
    return CAM.GET_FINAL_RENDERED_CAM_FAR_CLIP()
end

function module.get_final_rendered_near_dof(): float
    return CAM.GET_FINAL_RENDERED_CAM_NEAR_DOF()
end

function module.get_final_rendered_far_dof(): float
    return CAM.GET_FINAL_RENDERED_CAM_FAR_DOF()
end

function module.get_final_rendered_motion_blur_strength(): float
    return CAM.GET_FINAL_RENDERED_CAM_MOTION_BLUR_STRENGTH()
end

function module.get_focus_ped_on_screen(
    p0: float, p1: int, p2: float, p3: float, p4: float, p5: float, p6: float, p7: int, p8: int
): int
    -- body function:
    return CAM.GET_FOCUS_PED_ON_SCREEN(p0, p1, p2, p3, p4, p5, p6, p7, p8)
end

-- Set

-- Set camera as active/inactive
function module.set_active(cam: int, active: bool): void
    CAM.SET_CAM_ACTIVE(cam, active)
end

function module.set_params(
    cam: int, pos_x: float, pos_y: float, pos_z: float, rot_x: float, rot_y: float, rot_z: float,
    field_of_view: float, p8: any, p9: int, p10: int, p11: int
): void
    -- body function:
    CAM.SET_CAM_PARAMS(cam, pos_x, pos_y, pos_z, rot_x, rot_y, rot_z, field_of_view, p8, p9, p10, p11)
end

-- Sets the position of the cam
function module.set_coord(cam: int, pos_x: float, pos_y: float, pos_z: float): void
    CAM.SET_CAM_COORD(cam, pos_x, pos_y, pos_z)
end

-- Sets the rotation of the cam
function module.set_rot(cam: int, rot_x: float, rot_y: float, rot_z: float, rotation_order: int): void
    CAM.SET_CAM_ROT(cam, rot_x, rot_y, rot_z, rotation_order)
end

-- Sets the field of view of the cam
function module.set_fov(cam: int, field_of_view: float): void
    CAM.SET_CAM_FOV(cam, field_of_view)
end

function module.set_near_clip(cam: int, near_clip: float): void
    CAM.SET_CAM_NEAR_CLIP(cam, near_clip)
end

function module.set_far_clip(cam: int, far_clip: float): void
    CAM.SET_CAM_FAR_CLIP(cam, far_clip)
end

function module.set_motion_blur_strength(cam: int, strength: float): void
    CAM.SET_CAM_MOTION_BLUR_STRENGTH(cam, strength)
end

function module.set_near_dof(cam: int, near_dof: float): void
    CAM.SET_CAM_NEAR_DOF(cam, near_dof)
end

function module.set_far_dof(cam: int, far_dof: float): void
    CAM.SET_CAM_FAR_DOF(cam, far_dof)
end

function module.set_dof_strength(cam: int, dof_strength: float): void
    CAM.SET_CAM_DOF_STRENGTH(cam, dof_strength)
end

function module.set_dof_planes(cam: int, p1: float, p2: float, p3: float, p4: float): void
    CAM.SET_CAM_DOF_PLANES(cam, p1, p2, p3, p4)
