end

function module.disable_collision_for_object(entity: int): void
    CAM.DISABLE_CAM_COLLISION_FOR_OBJECT(entity)
end

function module.bypass_collision_buoyancy_test_this_update(): void
    CAM.BYPASS_CAMERA_COLLISION_BUOYANCY_TEST_THIS_UPDATE()
end

function module.use_script_for_ambient_population_origin_this_frame(p0: bool, p1: bool): void
    CAM.USE_SCRIPT_CAM_FOR_AMBIENT_POPULATION_ORIGIN_THIS_FRAME(p0, p1)
end

function module.force_tightspace_custom_framing_this_update(): void
    CAM.FORCE_TIGHTSPACE_CUSTOM_FRAMING_THIS_UPDATE()
end

function module.bypass_cutscene_rendering_this_update(): void
    CAM.BYPASS_CUTSCENE_CAM_RENDERING_THIS_UPDATE()
end

function module.stop_cutscene_shaking(p0: any): void
    CAM.STOP_CUTSCENE_CAM_SHAKING(p0)
end

function module.disable_near_clip_scan_this_update(): void
    CAM.DISABLE_NEAR_CLIP_SCAN_THIS_UPDATE()
end

function module.prevent_collision_settings_for_triplehead_in_interiors_this_update(): void
    CAM.CAMERA_PREVENT_COLLISION_SETTINGS_FOR_TRIPLEHEAD_IN_INTERIORS_THIS_UPDATE()
end

function module.replay_get_max_distance_allowed_from_player(): float
    return CAM.REPLAY_GET_MAX_DISTANCE_ALLOWED_FROM_PLAYER()
end

return Atdar.loader.auto(module, "natives/camera")
