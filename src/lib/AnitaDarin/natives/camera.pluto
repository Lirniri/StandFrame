end

-- Last param determines if its relative to the Entity
function module.attach_to_entity(
    cam: int, entity: int, x_offset: float, y_offset: float, z_offset: float, is_relative: bool
): void
    -- body function:
    CAM.ATTACH_CAM_TO_ENTITY(cam, entity, x_offset, y_offset, z_offset, is_relative)
end

function module.attach_to_ped_bone(
    cam: int, ped: int, bone_index: int, x: float, y: float, z: float, heading: bool
): void
