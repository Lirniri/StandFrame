-- Actions

function module.render_script_cams(
    render: bool, ease: bool, ease_time: int, p3: bool, p4: bool, p5: any
): void
    -- body function:
    CAM.RENDER_SCRIPT_CAMS(render, ease, ease_time, p3, p4, p5)
end

-- This native makes the gameplay camera zoom into first person/third person with a special effect
function module.stop_rendering_script_cams_using_catch_up(render: bool, p1: float, p2: int, p3: any): void
    CAM.STOP_RENDERING_SCRIPT_CAMS_USING_CATCH_UP(render, p1, p2, p3)
end

function module.create(cam_name: string, p1: bool): int
    return CAM.CREATE_CAM(cam_name, p1)
end

function module.create_with_params(
    cam_name: string, pos_x: float, pos_y: float, pos_z: float, rot_x: float, rot_y: float,
    rot_z: float, fov: float, p8: bool, p9: int
): int
    -- body function:
    return CAM.CREATE_CAM_WITH_PARAMS(cam_name, pos_x, pos_y, pos_z, rot_x, rot_y, rot_z, fov, p8, p9)
end

function module.create_camera(cam_hash: int, p1: bool): int
    return CAM.CREATE_CAMERA(cam_hash, p1)
end

function module.create_camera_with_params(
    cam_hash: int, pos_x: float, pos_y: float, pos_z: float, rot_x: float, rot_y: float,
    rot_z: float, fov: float, p8: bool, p9: any
): int
    -- body function:
    return CAM.CREATE_CAMERA_WITH_PARAMS(cam_hash, pos_x, pos_y, pos_z, rot_x, rot_y, rot_z, fov, p8, p9)
end

function module.destroy(cam: int, b_script_host_cam: bool): void
    CAM.DESTROY_CAM(cam, b_script_host_cam)
end

function module.destroy_all_cams(b_script_host_cam: bool): void
