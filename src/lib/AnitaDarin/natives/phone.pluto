-- The mobile phone object and its camera (MOBILE natives)

local module = {}

-- State

-- This one is weird and seems to return a TRUE state regardless of whether the phone is visible on screen or tucked away
function module.can_be_seen_on_screen(): bool
    return MOBILE.CAN_PHONE_BE_SEEN_ON_SCREEN()
end

-- Get

-- @param rotation Pointer: pass memory.alloc(size) and read the result back
function module.get_rotation(rotation: int, p1: int): void
    MOBILE.GET_MOBILE_PHONE_ROTATION(rotation, p1)
end

-- @param position Pointer: pass memory.alloc(size) and read the result back
function module.get_position(position: int): void
    MOBILE.GET_MOBILE_PHONE_POSITION(position)
end

-- @param render_id Pointer: pass memory.alloc(size) and read the result back
function module.get_render_id(render_id: int): void
    MOBILE.GET_MOBILE_PHONE_RENDER_ID(render_id)
end

-- Set

function module.set_scale(scale: float): void
    MOBILE.SET_MOBILE_PHONE_SCALE(scale)
end

-- Last parameter is unknown and always zero
function module.set_rotation(rot_x: float, rot_y: float, rot_z: float, p3: any): void
    MOBILE.SET_MOBILE_PHONE_ROTATION(rot_x, rot_y, rot_z, p3)
end

function module.set_position(pos_x: float, pos_y: float, pos_z: float): void
    MOBILE.SET_MOBILE_PHONE_POSITION(pos_x, pos_y, pos_z)
end

function module.set_dof_state(toggle: bool): void
    MOBILE.SET_MOBILE_PHONE_DOF_STATE(toggle)
end

-- Actions

-- Creates a mobile phone of the specified type
function module.create(phone_type: int): void
    MOBILE.CREATE_MOBILE_PHONE(phone_type)
end

-- Destroys the currently active mobile phone
function module.destroy(): void
    MOBILE.DESTROY_MOBILE_PHONE()
end

function module.script_is_moving_offscreen(toggle: bool): void
    MOBILE.SCRIPT_IS_MOVING_MOBILE_PHONE_OFFSCREEN(toggle)
end

function module.cell_set_input(direction: int): void
    MOBILE.CELL_SET_INPUT(direction)
end

function module.cell_horizontal_mode_toggle(toggle: bool): void
    MOBILE.CELL_HORIZONTAL_MODE_TOGGLE(toggle)
end

function module.cell_cam_activate(p0: bool, p1: bool): void
    MOBILE.CELL_CAM_ACTIVATE(p0, p1)
end

function module.cell_cam_activate_selfie_mode(toggle: bool): void
    MOBILE.CELL_CAM_ACTIVATE_SELFIE_MODE(toggle)
end

function module.cell_cam_activate_shallow_dof_mode(toggle: bool): void
    MOBILE.CELL_CAM_ACTIVATE_SHALLOW_DOF_MODE(toggle)
end

function module.cell_cam_set_selfie_mode_side_offset_scaling(p0: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_SIDE_OFFSET_SCALING(p0)
end

function module.cell_cam_set_selfie_mode_horz_pan_offset(horizontal_pan: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_HORZ_PAN_OFFSET(horizontal_pan)
end

function module.cell_cam_set_selfie_mode_vert_pan_offset(vert_pan: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_VERT_PAN_OFFSET(vert_pan)
end

function module.cell_cam_set_selfie_mode_roll_offset(roll: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_ROLL_OFFSET(roll)
end

function module.cell_cam_set_selfie_mode_distance_scaling(distance_scaling: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_DISTANCE_SCALING(distance_scaling)
end

function module.cell_cam_set_selfie_mode_head_yaw_offset(yaw: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_HEAD_YAW_OFFSET(yaw)
end

function module.cell_cam_set_selfie_mode_head_roll_offset(roll: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_HEAD_ROLL_OFFSET(roll)
end

function module.cell_cam_set_selfie_mode_head_pitch_offset(pitch: float): void
    MOBILE.CELL_CAM_SET_SELFIE_MODE_HEAD_PITCH_OFFSET(pitch)
end

function module.cell_cam_is_char_visible_no_face_check(entity: int): bool
    return MOBILE.CELL_CAM_IS_CHAR_VISIBLE_NO_FACE_CHECK(entity)
end

return module
