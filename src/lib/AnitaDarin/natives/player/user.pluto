local module = {}

function module.restore_health()
    local ped = players.user_ped()
    local entity = Atdar.natives.entity
    entity.set_health(ped, entity.get_max_health(ped))
end
function module.restore_armor()
    local n_player = Atdar.natives.player
    local n_ped = Atdar.natives.entity.ped
    local player = n_player.get_id()
    local ped = n_player.get_ped_id()
    n_ped.set_armor(ped, n_player.get_max_armor(player))
end
function module.restore_stamina()
    local n_player = Atdar.natives.player
    local n_ped = Atdar.natives.entity.ped
    local player = n_player.get_id()
    local ped = n_player.get_ped_id()
    n_ped.set_armor(ped, n_player.get_max_armor(player))
end

-- @return Index of the active character slot
function module.get_char_slot(): int
    return util.get_char_slot()
end

function module.get_vehicle(include_last_vehicle: bool = true, as_pointer: bool = false)
    local handle = entities.get_user_vehicle_as_handle(include_last_vehicle)
    local pointer = entities.get_user_vehicle_as_pointer(include_last_vehicle)
    return as_pointer and pointer or handle
end

function module.get_personal_vehicle(include_last_vehicle: bool = true, as_pointer: bool = false): int
    if not util.is_session_started() then
        return nil
    end
    local handle = entities.get_user_personal_vehicle_as_handle(include_last_vehicle)
    local pointer = entities.handle_to_pointer(handle)
    return as_pointer and pointer or handle
end


return module