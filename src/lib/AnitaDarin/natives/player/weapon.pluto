-- player.weapon: a player's aiming. Part of every Player; the weapons themselves are the ped's (ped.weapon)

local Entity = Atdar.loader.load("natives/entity")

local class PlayerWeapon

    function __construct(player: table)
        self.player = player
    end

    -- State

    -- @param entity If given (an Entity or a handle), checks aiming at it; otherwise aiming at all
    function is_free_aiming(entity: ?table|int): bool
        local id = self.player:get_id()
        if entity ~= nil then
            return PLAYER.IS_PLAYER_FREE_AIMING_AT_ENTITY(id, Entity.handle_of(entity))
        end
        return PLAYER.IS_PLAYER_FREE_AIMING(id)
    end

end

return PlayerWeapon
