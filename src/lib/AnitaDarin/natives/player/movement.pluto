-- player.movement: a player's sprint and stamina. Part of every Player

local class PlayerMovement

    function __construct(player: table)
        self.player = player
    end

    -- Get

    function get_sprint_stamina(): float
        return PLAYER.GET_PLAYER_SPRINT_STAMINA_REMAINING(self.player:get_id())
    end

    -- Set

    -- false stops the player from sprinting until set back to true
    function set_sprint(toggle: bool): void
        PLAYER.SET_PLAYER_SPRINT(self.player:get_id(), toggle)
    end

    -- Actions

    function restore_sprint_stamina(value: float = 1.0): void
        PLAYER.RESTORE_PLAYER_STAMINA(self.player:get_id(), value)
    end

    function reset_sprint_stamina(): void
        PLAYER.RESET_PLAYER_STAMINA(self.player:get_id())
    end

end

return PlayerMovement
