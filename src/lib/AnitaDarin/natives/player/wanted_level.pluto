-- player.wanted_level: a player's wanted stars. Part of every Player

local class PlayerWantedLevel

    function __construct(player: table)
        self.player = player
    end

    -- Get

    function get_current(): int
        return PLAYER.GET_PLAYER_WANTED_LEVEL(self.player:get_id())
    end

    function get_max(): int
        return PLAYER.GET_MAX_WANTED_LEVEL()
    end

    function get_radius(): float
        return PLAYER.GET_WANTED_LEVEL_RADIUS(self.player:get_id())
    end

    -- Set

    function set(level: int, disable_on_mission: bool = false): void
        PLAYER.SET_PLAYER_WANTED_LEVEL(self.player:get_id(), level, disable_on_mission)
    end

    function set_no_drop(level: int, p2: bool = false): void
        PLAYER.SET_PLAYER_WANTED_LEVEL_NO_DROP(self.player:get_id(), level, p2)
    end

    function set_now(p1: bool = false): void
        PLAYER.SET_PLAYER_WANTED_LEVEL_NOW(self.player:get_id(), p1)
    end

    -- Actions

    -- Sets the level right away: for the local player through the natives, for others through Stand
    function change(level: int): void
        local id = self.player:get_id()
        if id ~= players.user() then
            players.set_wanted_level(id, level)
            return
        end
        PLAYER.SET_PLAYER_WANTED_LEVEL_NO_DROP(id, level, false)
        PLAYER.SET_PLAYER_WANTED_LEVEL_NOW(id, false)
        PLAYER.SET_PLAYER_WANTED_LEVEL(id, level, false)
    end

end

return PlayerWantedLevel
