local load = Atdar.loader.load

local module = {}

module.user = load("natives/player/camera/user")

function module.get_position(player_id: int): vector3
    return players.get_cam_pos(player_id)
end

function module.get_rotation(player_id: int): vector3
    return players.get_cam_rot(player_id)
end

return module