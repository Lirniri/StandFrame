function module.is_jumping(ped: int, doing_beast_jump: bool = false): bool
    if doing_beast_jump then
        return PED.IS_PED_DOING_A_BEAST_JUMP(ped)
    end
    return PED.IS_PED_JUMPING(ped)
end

function module.is_going_into_cover(ped: int): bool
