local module = {}

-- State

-- Whether it's in the game and a ped
function module.is_exist(ped: int): bool
    local is_entity = Atdar.natives.entity.is_exist(ped)
    local is_ped = module.is_ped(ped)
    return is_entity and is_ped
end

function module.is_ped(ped: int): bool
    return ENTITY.IS_ENTITY_A_PED(ped)
end

function module.is_player(ped: int): bool
    return PED.IS_PED_A_PLAYER(ped)
end

function module.is_human(ped: int): bool
    return PED.IS_PED_HUMAN(ped)
end

function module.is_male(ped: int): bool
    return PED.IS_PED_MALE(ped)
end


function module.is_dead(ped: int): bool
    local entity = Atdar.natives.entity
    if module.is_ped(ped) then
        return entity.is_dead(ped)
    else
        return nil
    end
end

-- State > Movement
function module.is_stopped(ped: int): bool
    return PED.IS_PED_STOPPED(ped)
end

function module.is_walking(ped: int): bool
    return TASK.IS_PED_WALKING(ped)
end

function module.is_running(ped: int): bool
    return TASK.IS_PED_RUNNING(ped)
end

function module.is_sprinting(ped: int): bool
    return TASK.IS_PED_SPRINTING(ped)
end

function module.is_strafing(ped: int): bool
    return TASK.IS_PED_STRAFING(ped)
end

function module.is_still(ped: int): bool
    return TASK.IS_PED_STILL(ped)
end

function module.is_getting_up(ped: int): bool
    return TASK.IS_PED_GETTING_UP(ped)
end

function module.is_jumping(ped: int, doing_beast_jump: bool = false): bool
    if doing_beast_jump then
        return PED.IS_PED_DOING_A_BEAST_JUMP(ped)
    end
    return PED.IS_PED_JUMPING(ped)
end

function module.is_going_into_cover(ped: int): bool
    return PED.IS_PED_GOING_INTO_COVER(ped)
end

function module.is_in_high_cover(ped: int): bool
    return PED.IS_PED_IN_HIGH_COVER(ped)
end

function module.is_in_cover(ped: int, except_use_weapon: bool = false): bool
    return PED.IS_PED_IN_COVER(ped, except_use_weapon)
end

function module.is_swimming(ped: int, under_water: bool = false): bool
    if under_water then
        return PED.IS_PED_SWIMMING_UNDER_WATER(ped)
    end
    return PED.IS_PED_SWIMMING(ped)
end

function module.is_scuba(ped: int): bool
    local flag = module.flags.CONFIG.IS_SCUBA
    return module.flags.get_config(ped, flag)
end

function module.is_max_health(ped: int): bool
    local health = module.get_health(ped)
    local max_health = module.get_max_health(ped)
    return health ~= nil and health >= max_health
end

-- Get

function module.get_all(as_pointers: bool = false)
    if as_pointers then
        return entities.get_all_peds_as_pointers()
    end
    return entities.get_all_peds_as_handles()
end

function module.get_health(ped): int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        return entity.get_health(ped)
    else
        return nil
    end
end

function module.get_max_health(ped): int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        return entity.get_max_health(ped)
    else
        return nil
    end
end

function module.get_armor(ped: int): int
    return PED.GET_PED_ARMOUR(ped)
end

function module.get_net_id(ped): int
    return NETWORK.PED_TO_NET(ped)
end

function module.from_net_id(net_id): ?int
    local is_net_id_exist = NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then
        return nil
    end
    return NETWORK.NET_TO_PED(net_id)
end

-- Set

function module.set_scuba(ped: int, toggle: bool): void
    module.flags.set_config(ped, module.flags.CONFIG.IS_SCUBA, toggle)
end

-- @return Whether it was a ped (nothing is set otherwise)
function module.set_health(ped: int, value: ?int, instigator: int = 0, weapon_type: int = 0): bool
    if not module.is_ped(ped) then
        return false
    end
    Atdar.natives.entity.set_health(ped, value, instigator, weapon_type)
    return true
end

-- @return Whether it was a ped (nothing is set otherwise)
function module.set_max_health(ped: int, value: ?int, instigator: int = 0, weapon_type: int = 0): bool
    if not module.is_ped(ped) then
        return false
    end
    Atdar.natives.entity.set_max_health(ped, value, instigator, weapon_type)
    return true
end

function module.set_armor(ped: int, value: int): void
    PED.SET_PED_ARMOUR(ped, value)
end

function module.add_armor(ped: int, value: int): void
    PED.ADD_ARMOUR_TO_PED(ped, value)
end

return Atdar.loader.auto(module, "natives/entity/ped")
