local load = Atdar.loader.load

local module = {}

function module.is_ped(ped): bool
    return ENTITY.IS_ENTITY_A_PED(ped)
end

function module.is_human(ped: int): bool
    return PED.IS_PED_HUMAN(ped)
end

function module.is_male(ped: int): bool
    return PED.IS_PED_MALE(ped)
end

function module.is_player(player_id: int): bool
    return PED.IS_PED_A_PLAYER(player_id)
end


function module.is_sprinting(ped: int): bool
    return TASK.IS_PED_SPRINTING(ped)
end

function module.is_stopped(ped: int): bool
    return PED.IS_PED_STOPPED(ped)
end

function module.is_jumping(ped: int): bool
    return PED.IS_PED_JUMPING(ped)
end

function module.is_swimming(ped: int, under_water: bool = false): bool
    return under_water and PED.IS_PED_SWIMMING_UNDER_WATER(ped) or PED.IS_PED_SWIMMING(ped)
end


function module.is_scuba(ped: int): bool
    return module.flags.get_config(ped, module.flags.CONFIG.IS_SCUBA)
end

function module.set_scuba(ped: int, toggle: bool): void
    module.flags.set_config(ped, module.flags.CONFIG.IS_SCUBA, toggle)
end


function module.get_net_id(ped): int
    return NETWORK.PED_TO_NET(ped)
end
function module.from_net_id(net_id): ?int
    local is_net_id_exist NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then return nil end
    return NETWORK.NET_TO_PED(net_id)
end

function module.get_all(as_pointer: bool = false)
    local handle = entities.get_all_peds_as_handles()
    local pointer = entities.get_all_peds_as_pointers()
    return as_pointer and pointer or handle
end


function module.get_health(ped): int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        return entity.get_health(ped)
    else
        return nil
    end
end
function module.get_max_health(ped): int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        return entity.get_max_health(ped)
    else
        return nil
    end
end

function module.is_max_health(ped: int): bool
    local health = module.get_health(ped)
    return health ~= nil and health >= module.get_max_health(ped)
end

function module.set_health(ped: int, value: ?int, instigator: int = 0, weaponType: int = 0): ?int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        entity.set_health(ped, value, instigator, weaponType)
    else
        return nil
    end
end

function module.set_max_health(ped: int, value: ?int, instigator: int = 0, weaponType: int = 0): ?int
    local entity = Atdar.natives.entity
    local is_ped = module.is_ped(ped)
    if is_ped then
        entity.set_health(ped, value, instigator, weaponType)
    else
        return nil
    end
end

function module.get_armor(ped: int, value: int): int
    return PED.GET_PED_ARMOUR(ped, value)
end

function module.set_armor(ped: int, value: int): int
    return PED.SET_PED_ARMOUR(ped, value)
end

function module.add_armor(ped: int, value: int): int
    return PED.ADD_ARMOUR_TO_PED(ped, value)
end

module.task = load("natives/entity/ped/task")
module.weapon = load("natives/entity/ped/weapon")
module.parachute = load("natives/entity/ped/parachute")

module.vehicle = load("natives/entity/ped/vehicle")

module.flags = load("natives/entity/ped/flags")

return module
