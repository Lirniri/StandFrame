local module = {}

-- State

-- Whether it's in the game and a ped
function module.does_exist(ped: int): bool
    local is_entity = Atdar.natives.entity.does_exist(ped)
    local is_ped = module.is_ped(ped)
    return is_entity and is_ped
end

function module.is_ped(ped: int): bool
    return ENTITY.IS_ENTITY_A_PED(ped)
end

function module.is_player(ped: int): bool
    return PED.IS_PED_A_PLAYER(ped)
end

function module.is_human(ped: int): bool
    return PED.IS_PED_HUMAN(ped)
end

function module.is_male(ped: int): bool
    return PED.IS_PED_MALE(ped)
end

function module.is_dead(ped: int): bool
    local entity = Atdar.natives.entity
    if module.is_ped(ped) then
        return entity.is_dead(ped)
    else
        return nil
    end
end

function module.is_in_model(ped: int, model_hash: int): bool
    return PED.IS_PED_IN_MODEL(ped, model_hash)
end

function module.is_cop_in_area_3d(x1: float, y1: float, z1: float, x2: float, y2: float, z2: float): bool
    return PED.IS_COP_PED_IN_AREA_3D(x1, y1, z1, x2, y2, z2)
end

-- Gets a value indicating whether this ped's health is below its injured threshold
function module.is_injured(ped: int): bool
    return PED.IS_PED_INJURED(ped)
end

-- Returns whether the specified ped is hurt
function module.is_hurt(ped: int): bool
    return PED.IS_PED_HURT(ped)
end

-- Gets a value indicating whether this ped's health is below its fatally injured threshold. The default threshold is 100
function module.is_fatally_injured(ped: int): bool
    return PED.IS_PED_FATALLY_INJURED(ped)
end

function module.is_dead_or_dying(ped: int, p1: bool): bool
