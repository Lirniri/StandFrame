-- Actions

function module.create(
    ped_type: int, model_hash: int, x: float, y: float, z: float, heading: float, is_network: bool,
    b_script_host_ped: bool
): int
    -- body function:
    return PED.CREATE_PED(ped_type, model_hash, x, y, z, heading, is_network, b_script_host_ped)
end

-- Deletes the specified ped, then sets the handle pointed to by the pointer to NULL
-- @param ped Pointer: pass memory.alloc(size) and read the result back
function module.delete(ped: int): void
    PED.DELETE_PED(ped)
end

function module.clone(ped: int, is_network: bool, b_script_host_ped: bool, copy_head_blend_flag: bool): int
