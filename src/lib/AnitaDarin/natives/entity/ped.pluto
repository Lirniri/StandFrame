local load = require($"{Atdar.name}/core/loader")

local module = {}

function module.is_player(player_id: int): bool
    return PED.IS_PED_A_PLAYER(player_id)
end

function module.get_net_id(ped): int
    return NETWORK.PED_TO_NET(ped)
end
function module.from_net_id(net_id): ?int
    local is_net_id_exist NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then return nil end
    return NETWORK.NET_TO_PED(net_id)
end

function module.get_all(asPointer: bool = false)
    local handle = entities.get_all_peds_as_handles()
    local pointer = entities.get_all_peds_as_pointers()
    return asPointer and pointer or handle
end

function module.is_human(ped: int): bool
    return PED.IS_PED_HUMAN(ped)
end

function module.is_male(ped: int): bool
    return PED.IS_PED_MALE(ped)
end

function module.is_stopped(ped: int): bool
    return PED.IS_PED_STOPPED(ped)
end

function module.is_jumping(ped: int): bool
    return PED.IS_PED_JUMPING(ped)
end

module.parachute = load("natives/entity/ped/parachute")
module.task = load("natives/entity/ped/task")
module.weapon = load("natives/entity/ped/weapon")

return module
