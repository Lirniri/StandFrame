-- Set

function module.set_scuba(ped: int, toggle: bool): void
    module.flags.set_config(ped, module.flags.CONFIG.IS_SCUBA, toggle)
end

-- @return Whether it was a ped (nothing is set otherwise)
function module.set_health(ped: int, value: ?int, instigator: int = 0, weapon_type: int = 0): bool
    if not module.is_ped(ped) then
        return false
    end
    Atdar.natives.entity.set_health(ped, value, instigator, weapon_type)
    return true
end

-- @return Whether it was a ped (nothing is set otherwise)
function module.set_max_health(ped: int, value: ?int, instigator: int = 0, weapon_type: int = 0): bool
    if not module.is_ped(ped) then
        return false
    end
    Atdar.natives.entity.set_max_health(ped, value, instigator, weapon_type)
    return true
end

