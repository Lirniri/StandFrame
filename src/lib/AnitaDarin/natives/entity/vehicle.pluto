-- HookOffset defines where the hook is attached. leave at 0 for default attachment
function module.attach_to_tow_truck(
    tow_truck: int, vehicle: int, rear: bool, hook_offset_x: float, hook_offset_y: float,
    hook_offset_z: float
): void
