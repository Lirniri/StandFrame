local module = {}

function module.get_net_id(vehicle): int
    return NETWORK.VEH_TO_NET(vehicle)
end
function module.from_net_id(net_id): ?int
    local is_net_id_exist = NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then return nil end
    return NETWORK.NET_TO_VEH(net_id)
end

function module.get_all(asPointer: bool = false): table
    local handle = entities.get_all_vehicles_as_handles()
    local pointer = entities.get_all_vehicles_as_pointer()
    return asPointer and pointer or handle
end

function module.is_stopped(vehicle: int): bool
    return VEHICLE.IS_VEHICLE_STOPPED(vehicle)
end

-- opts: { vehicle, is_audible = true, is_invisible = false, net_id = nil }
-- net_id given: networked explosion (NETWORK_EXPLODE_VEHICLE), otherwise a local one
function module.explode(opts: table): void
    local vehicle = opts.vehicle
    local is_audible = opts.is_audible ~= false
    local is_invisible = opts.is_invisible == true
    if opts.net_id ~= nil then
        NETWORK.NETWORK_EXPLODE_VEHICLE(vehicle, is_audible, is_invisible, opts.net_id)
    else
        VEHICLE.EXPLODE_VEHICLE(vehicle, is_audible, is_invisible)
    end
end

return module