end

-- First two parameters swapped. Scripts verify that towTruck is the first parameter, not the second
function module.detach_from_tow_truck(tow_truck: int, vehicle: int): void
    VEHICLE.DETACH_VEHICLE_FROM_TOW_TRUCK(tow_truck, vehicle)
