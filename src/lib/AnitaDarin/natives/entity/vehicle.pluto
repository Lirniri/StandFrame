local module = {
    -- Variables
    gearbox = {},
    engine = {
        max_health = 1000
    }
}

-- Variables

-- State

function module.does_exist(vehicle: int): bool
    local is_entity = Atdar.natives.entity.does_exist(vehicle)
    local is_vehicle = module.is_vehicle(vehicle)
    return is_entity and is_vehicle
end

function module.is_destroyed(vehicle: int): bool
    local n_entity = Atdar.natives.entity
    
    if not n_entity.does_exist(vehicle) then
        return true
    end

    if module.is_vehicle(vehicle) then
        return n_entity.is_dead(vehicle) or n_entity.get_health(vehicle) <= 0
    end

    return false
end

function module.is_vehicle(entity: int): bool
    return ENTITY.IS_ENTITY_A_VEHICLE(entity)
end

function module.is_model(hash: int|string): bool
    return Atdar.natives.streaming.vehicle.is_model(hash)
end

function module.is_a_blimp(model: int|string)
    return util.is_this_model_a_blimp(model)
end

function module.is_a_submarine(model: int|string)
    return util.is_this_model_a_submarine(model)
end

function module.is_a_submarine_car(model: int|string)
    return util.is_this_model_a_submarine_car(model)
end

function module.is_a_trailer(model: int|string)
    return util.is_this_model_a_trailer(model)
end

-- Whether it can be driven (set_undriveable). Right after a repair it may still say false for a moment
-- @param on_fire_check Also false while it's on fire
function module.is_driveable(vehicle: int, on_fire_check: bool = false): bool
    return VEHICLE.IS_VEHICLE_DRIVEABLE(vehicle, on_fire_check)
end

-- State > Movement

function module.is_stopped(vehicle: int): bool
    return VEHICLE.IS_VEHICLE_STOPPED(vehicle)
end

-- Get

-- @return The heading, nil if it isn't a vehicle
function module.get_heading(vehicle: int, from_eulers: bool = false): ?float
    if module.is_vehicle(vehicle) then
        return Atdar.natives.entity.get_heading(vehicle, from_eulers)
    end
    return nil
end

-- vehicle_or_model: vehicle handle (number) or model name (string, e.g. "adder")
function module.get_class(vehicle_or_model: int|string): int
    local target = vehicle_or_model

    if type(target) == "string" then
        return VEHICLE.GET_VEHICLE_CLASS_FROM_NAME(Atdar.util.hash(target))
    end
    if module.does_exist(target) then
        return VEHICLE.GET_VEHICLE_CLASS(target)
    end
    if module.is_model(target) then
        return VEHICLE.GET_VEHICLE_CLASS_FROM_NAME(target)
    end

    error($"[natives/vehicle] get_class: {tostring(target)} is not a vehicle, vehicle model or model name")
end

function module.get_all(as_pointers: bool = false): table
    if as_pointers then
        return entities.get_all_vehicles_as_pointers()
    end

    return entities.get_all_vehicles_as_handles()
end

function module.get_net_id(vehicle): int
    return NETWORK.VEH_TO_NET(vehicle)
end

function module.from_net_id(net_id): ?int
    local is_net_id_exist = Atdar.natives.network.does_net_id_exist(net_id)
    if not is_net_id_exist then
        return nil
    end

    return NETWORK.NET_TO_VEH(net_id)
end

-- Get>Gearbox

function module.gearbox.get_current(vehicle: int): int
    if not module.does_exist(vehicle) then
        return 0
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        return entities.get_current_gear(addr)
    end

    return 0
end

function module.gearbox.get_next(vehicle: int): int
    if not module.does_exist(vehicle) then
        return 0
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        return entities.get_next_gear(addr)
    end

    return 0
end

-- Get>Engine

function module.engine.get_rpm(vehicle: int): int
    if not module.does_exist(vehicle) then
        return 0
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        return entities.get_rpm(addr)
    end

    return 0
end

-- Set

-- Set>Gearbox

function module.gearbox.set_current(vehicle: int, current_gearbox: int): void
    if not module.does_exist(vehicle) then
        return
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        entities.set_current_gear(addr, current_gearbox)
    end

    return
end

function module.gearbox.set_next(vehicle: int, next_gearbox: int): void
    if not module.does_exist(vehicle) then
        return
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        entities.set_next_gear(addr, next_gearbox)
    end

    return
end

-- Set>Engine

function module.engine.set_rpm(vehicle: int, rpm: float): void
    if not module.does_exist(vehicle) then
        return
    end

    local addr = Atdar.memory.handle_to_pointer(vehicle)
    if addr then
        entities.set_rpm(addr, rpm)
    end

    return
end

-- Repairs what's broken (doors, windows, lights, wheels), not the dents
function module.set_fixed(vehicle: int): void
    VEHICLE.SET_VEHICLE_FIXED(vehicle)
end

-- Takes the dents out of the body
function module.set_deformation_fixed(vehicle: int): void
    VEHICLE.SET_VEHICLE_DEFORMATION_FIXED(vehicle)
end

-- -4000 - 1000; below 0 the engine is on fire
function module.set_engine_health(vehicle: int, health: float): void
    VEHICLE.SET_VEHICLE_ENGINE_HEALTH(vehicle, health)
end

-- 0 - 1000
function module.set_body_health(vehicle: int, health: float): void
    VEHICLE.SET_VEHICLE_BODY_HEALTH(vehicle, health)
end

-- -999 - 1000; below 0 the petrol tank leaks and burns
function module.set_petrol_tank_health(vehicle: int, health: float): void
    VEHICLE.SET_VEHICLE_PETROL_TANK_HEALTH(vehicle, health)
end

-- true: it can't be driven any more
function module.set_undriveable(vehicle: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_UNDRIVEABLE(vehicle, toggle)
end

-- Starts or stops the engine
-- @param instantly Without the starting sound and delay
-- @param disable_auto_start The engine doesn't start by itself when someone gets in
function module.set_engine_on(
    vehicle: int,
    on: bool,
    instantly: bool = false, 
    disable_auto_start: bool = false
): void
    -- body
    VEHICLE.SET_VEHICLE_ENGINE_ON(vehicle, on, instantly, disable_auto_start)
end

-- 0.0 (clean) - 15.0 (dirtiest)
function module.set_dirt_level(vehicle: int, level: float): void
    VEHICLE.SET_VEHICLE_DIRT_LEVEL(vehicle, level)
end

-- Actions

-- Deletes the vehicle from the game
-- @return Whether it was a vehicle (nothing is deleted otherwise)
function module.delete(vehicle: int): bool

    if not module.is_vehicle(vehicle) then
        return false
    end

    Atdar.natives.entity.delete(vehicle)
    return true
end

-- Spawns a vehicle of a model (name or hash) at x, y, z facing heading.
-- is_network given (and the flags after it) - the game's VEHICLE.CREATE_VEHICLE with exactly those flags;
-- without it - Stand's entities.create_vehicle, which picks them itself.
-- The game's native needs the model loaded first (STREAMING.REQUEST_MODEL / HAS_MODEL_LOADED)
-- @param allow_low_z The native's p7: true lets the vehicle spawn below z -100 (the game refuses that otherwise)
-- @return The vehicle's handle
function module.create(
    hash: int|string,
    x: float, y: float, z: float,
    heading: float,
    is_network: bool,
    script_host_vehicle: bool,
    allow_low_z: bool
): int
    -- body
    local model = Atdar.util.hash(hash)
    if is_network ~= nil then
        return VEHICLE.CREATE_VEHICLE(
            model, x, y, z, heading,
            is_network,
            script_host_vehicle == true,
            allow_low_z == true
        )
    end
    return entities.create_vehicle(
        model,
        v3.new(x, y, z),
        heading
    )
end

-- opts: { vehicle, is_audible = true, is_invisible = false, net_id = nil }
-- net_id given: networked explosion (NETWORK_EXPLODE_VEHICLE), otherwise a local one
function module.explode(opts: table): void
    local vehicle = opts.vehicle
    local is_audible = opts.is_audible ~= false
    local is_invisible = opts.is_invisible == true

    if opts.net_id ~= nil then
        NETWORK.NETWORK_EXPLODE_VEHICLE(
            vehicle,
            is_audible, is_invisible,
            opts.net_id
        )
    else
        VEHICLE.EXPLODE_VEHICLE(
            vehicle,
            is_audible, is_invisible
        )
    end
end

return module
