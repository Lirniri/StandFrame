local module = {}

-- State

function module.is_in_free_fall(ped: int): bool
    return PED.IS_PED_IN_PARACHUTE_FREE_FALL(ped)
end

-- Get

function module.get_state(ped: int): int
    --[[ @return:
        -1: Normal
        0: Wearing parachute on back
        1: Parachute opening
        2: Parachute open
        3: Falling to doom (e.g. after exiting parachute)
    ]]
    return PED.GET_PED_PARACHUTE_STATE(ped)
end

function module.get_landing_type(ped: int): int
    --[[ @return:
        -1: no landing
        0: landing on both feet
        1: stumbling
        2: rolling
        3: ragdoll
    ]]
    return PED.GET_PED_PARACHUTE_LANDING_TYPE(ped)
end

-- The native writes the tint into a pointer instead of returning it
function module.get_tint(ped: int): int
    local tint_ptr = memory.alloc_int()
    PED.GET_PED_PARACHUTE_TINT_INDEX(ped, tint_ptr)
    return memory.read_int(tint_ptr)
end

-- Set

function module.set_tint(ped: int, tint: int): void
    PED.SET_PED_PARACHUTE_TINT_INDEX(ped, tint)
end

function module.set_reserve_tint_index(ped: int, p1: any): void
    PED.SET_PED_RESERVE_PARACHUTE_TINT_INDEX(ped, p1)
end

-- Actions

function module.give(ped: int): void
    local hash = util.joaat("GADGET_PARACHUTE")
    WEAPON.GIVE_WEAPON_TO_PED(ped, hash, 1, false, false)
end

function module.force_open(ped: int): void
    PED.FORCE_PED_TO_OPEN_PARACHUTE(ped)
end

function module.create_bag_object(ped: int, p1: bool, p2: bool): int
    return PED.CREATE_PARACHUTE_BAG_OBJECT(ped, p1, p2)
end

function module.clear_pack_variation(ped: int): void
    PED.CLEAR_PED_PARACHUTE_PACK_VARIATION(ped)
end

return module
