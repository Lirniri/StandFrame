end

-- Has 5 parameters since latest patches
function module.set_current_visible(ped: int, visible: bool, deselect_weapon: bool, p3: bool, p4: bool): void
    WEAPON.SET_PED_CURRENT_WEAPON_VISIBLE(ped, visible, deselect_weapon, p3, p4)
end

function module.set_drops_weapons_when_dead(ped: int, toggle: bool): void
