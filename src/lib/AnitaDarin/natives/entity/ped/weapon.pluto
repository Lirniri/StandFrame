local module = {}

-- Weapons and components are names ("WEAPON_PISTOL") or hashes: Atdar.util.hash takes both

-- State

function module.is_reloading(ped: int): bool
    return PED.IS_PED_RELOADING(ped)
end

function module.is_switching(ped: int): bool
    return PED.IS_PED_SWITCHING_WEAPON(ped)
end

function module.has(ped: int, weaponHash: int|string, p2: bool = false): bool
    local hash = Atdar.util.hash(weaponHash)
    return WEAPON.HAS_PED_GOT_WEAPON(ped, hash, p2)
end

function module.has_with_component(ped: int, weaponHash: int|string, componentHash: int|string): bool
    local hash = Atdar.util.hash(weaponHash)
    local compHash = Atdar.util.hash(componentHash)
    return WEAPON.HAS_PED_GOT_WEAPON_COMPONENT(ped, hash, compHash)
end

-- TODO: there is no HAS_PED_GOT_WEAPON_MANAGER in natives 3407a, find the right native
-- function module.has_manager(ped: int): bool
--     return WEAPON.HAS_PED_GOT_WEAPON_MANAGER(ped)
-- end

function module.is_shooting_in_area(
    ped: int, x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, p7: bool, p8: bool
): bool
    -- body function:
    return PED.IS_PED_SHOOTING_IN_AREA(ped, x1, y1, z1, x2, y2, z2, p7, p8)
end

function module.is_any_shooting_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, p6: bool, p7: bool
): bool
    -- body function:
    return PED.IS_ANY_PED_SHOOTING_IN_AREA(x1, y1, z1, x2, y2, z2, p6, p7)
end

-- Returns whether the specified ped is shooting
function module.is_shooting(ped: int): bool
    return PED.IS_PED_SHOOTING(ped)
end

-- Checks if the ped is currently equipped with a weapon matching a bit specified using a bitwise-or in typeFlags
function module.is_armed(ped: int, type_flags: int): bool
    return WEAPON.IS_PED_ARMED(ped, type_flags)
end

function module.is_ready_to_shoot(ped: int): bool
    return WEAPON.IS_PED_WEAPON_READY_TO_SHOOT(ped)
end

function module.has_been_damaged(ped: int, weapon_hash: int, weapon_type: int): bool
    return WEAPON.HAS_PED_BEEN_DAMAGED_BY_WEAPON(ped, weapon_hash, weapon_type)
end

function module.is_component_active(ped: int, weapon_hash: int, component_hash: int): bool
    return WEAPON.IS_PED_WEAPON_COMPONENT_ACTIVE(ped, weapon_hash, component_hash)
end

-- This native returns a true or false value
function module.is_current_silenced(ped: int): bool
    return WEAPON.IS_PED_CURRENT_WEAPON_SILENCED(ped)
end

-- Get

-- @return Coordinates of the ped's last weapon impact, or nil if there is none
function module.last_impact_coord(ped: int): ?vector3
    local coords_ptr = memory.alloc(24)
    if WEAPON.GET_PED_LAST_WEAPON_IMPACT_COORD(ped, coords_ptr) then
        return v3.new(memory.read_vector3(coords_ptr))
    end
    return nil
end

function module.get_time_damaged(ped: int, weapon_hash: int): int
    return PED.GET_TIME_PED_DAMAGED_BY_WEAPON(ped, weapon_hash)
end

-- @param weapon_hash Pointer: pass memory.alloc(size) and read the result back
function module.get_current(ped: int, weapon_hash: int, p2: bool): bool
    return WEAPON.GET_CURRENT_PED_WEAPON(ped, weapon_hash, p2)
end

function module.get_current_entity_index(ped: int, p1: any): int
    return WEAPON.GET_CURRENT_PED_WEAPON_ENTITY_INDEX(ped, p1)
end

function module.get_best(ped: int, p1: bool): int
    return WEAPON.GET_BEST_PED_WEAPON(ped, p1)
end

-- @param weapon_hash Pointer: pass memory.alloc(size) and read the result back
function module.get_current_vehicle(ped: int, weapon_hash: int): bool
    return WEAPON.GET_CURRENT_PED_VEHICLE_WEAPON(ped, weapon_hash)
end

function module.get_weapontype_in_slot(ped: int, weapon_slot: int): int
    return WEAPON.GET_PED_WEAPONTYPE_IN_SLOT(ped, weapon_slot)
end

function module.get_ammo_in(ped: int, weaponhash: int): int
    return WEAPON.GET_AMMO_IN_PED_WEAPON(ped, weaponhash)
end

function module.get_max_ammo_in_clip(ped: int, weapon_hash: int, p2: bool): int
    return WEAPON.GET_MAX_AMMO_IN_CLIP(ped, weapon_hash, p2)
end

-- @param ammo Pointer: pass memory.alloc(size) and read the result back
function module.get_ammo_in_vehicle_clip(vehicle: int, seat: int, ammo: int): bool
    return WEAPON._GET_AMMO_IN_VEHICLE_WEAPON_CLIP(vehicle, seat, ammo)
end

-- @param ammo Pointer: pass memory.alloc(size) and read the result back
function module.get_ammo_in_clip(ped: int, weapon_hash: int, ammo: int): bool
    return WEAPON.GET_AMMO_IN_CLIP(ped, weapon_hash, ammo)
end

function module.get_ammo_by_type(ped: int, ammo_type_hash: int): int
    return WEAPON.GET_PED_AMMO_BY_TYPE(ped, ammo_type_hash)
end

-- Returns the current ammo type of the specified ped's specified weapon
function module.get_ammo_type(ped: int, weapon_hash: int): int
    return WEAPON.GET_PED_AMMO_TYPE_FROM_WEAPON(ped, weapon_hash)
end

-- Returns the base/default ammo type of the specified ped's specified weapon
function module.get_original_ammo_type(ped: int, weapon_hash: int): int
    return WEAPON.GET_PED_ORIGINAL_AMMO_TYPE_FROM_WEAPON(ped, weapon_hash)
end

function module.get_is_gadget_equipped(ped: int, gadget_hash: int): bool
    return WEAPON.GET_IS_PED_GADGET_EQUIPPED(ped, gadget_hash)
end

-- Returns the hash of the weapon
function module.get_selected(ped: int): int
    return WEAPON.GET_SELECTED_PED_WEAPON(ped)
end

function module.get_lockon_distance_of_current(ped: int): float
    return WEAPON.GET_LOCKON_DISTANCE_OF_CURRENT_PED_WEAPON(ped)
end

function module.get_max_range_of_current(ped: int): float
    return WEAPON.GET_MAX_RANGE_OF_CURRENT_PED_WEAPON(ped)
end

-- Drops the current weapon and returns the object
function module.get_object(ped: int, p1: bool): int
    return WEAPON.GET_WEAPON_OBJECT_FROM_PED(ped, p1)
end

function module.get_tint_index(ped: int, weapon_hash: int): int
    return WEAPON.GET_PED_WEAPON_TINT_INDEX(ped, weapon_hash)
end

-- Returns -1 if camoComponentHash is invalid/not attached to the weapon
function module.get_component_tint_index(ped: int, weapon_hash: int, camo_component_hash: int): int
    return WEAPON.GET_PED_WEAPON_COMPONENT_TINT_INDEX(ped, weapon_hash, camo_component_hash)
end

function module.get_camo_index(ped: int, weapon_hash: int): int
    return WEAPON.GET_PED_WEAPON_CAMO_INDEX(ped, weapon_hash)
end

function module.get_clip_size(weapon_hash: int): int
    return WEAPON.GET_WEAPON_CLIP_SIZE(weapon_hash)
end

-- Set

function module.set_block_ambient_peds_from_dropping_weapons_this_frame(): void
    PED._SET_BLOCK_AMBIENT_PEDS_FROM_DROPPING_WEAPONS_THIS_FRAME()
end

function module.set_ai_damage_modifier(value: float): void
    PED.SET_AI_WEAPON_DAMAGE_MODIFIER(value)
end

function module.set_ai_melee_damage_modifier(modifier: float): void
    PED.SET_AI_MELEE_WEAPON_DAMAGE_MODIFIER(modifier)
end

function module.set_firing_pattern(ped: int, pattern_hash: int): void
    PED.SET_PED_FIRING_PATTERN(ped, pattern_hash)
end

function module.set_shoot_rate(ped: int, shoot_rate: int): void
    PED.SET_PED_SHOOT_RATE(ped, shoot_rate)
end

function module.set_movement_clipset(ped: int, clip_set: string): void
    PED.SET_PED_WEAPON_MOVEMENT_CLIPSET(ped, clip_set)
end

function module.set_enable_blocking(ped: int, toggle: bool): void
    PED.SET_PED_ENABLE_WEAPON_BLOCKING(ped, toggle)
end

function module.set_shoots_at_coord(ped: int, x: float, y: float, z: float, toggle: bool): void
    PED.SET_PED_SHOOTS_AT_COORD(ped, x, y, z, toggle)
end

function module.set_can_switch(ped: int, toggle: bool): void
    PED.SET_PED_CAN_SWITCH_WEAPON(ped, toggle)
end

function module.set_current(ped: int, weapon_hash: int, b_force_in_hand: bool): void
    WEAPON.SET_CURRENT_PED_WEAPON(ped, weapon_hash, b_force_in_hand)
end

function module.set_current_vehicle(ped: int, weapon_hash: int): bool
    return WEAPON.SET_CURRENT_PED_VEHICLE_WEAPON(ped, weapon_hash)
end

function module.set_cycle_vehicle_weapons_only(ped: int): void
    WEAPON.SET_PED_CYCLE_VEHICLE_WEAPONS_ONLY(ped)
end

function module.set_ammo(ped: int, weapon_hash: int, ammo: int, p3: bool): void
    WEAPON.SET_PED_AMMO(ped, weapon_hash, ammo, p3)
end

function module.set_infinite_ammo(ped: int, toggle: bool, weapon_hash: int): void
    WEAPON.SET_PED_INFINITE_AMMO(ped, toggle, weapon_hash)
end

function module.set_infinite_ammo_clip(ped: int, toggle: bool): void
