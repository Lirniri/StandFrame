end

function module.set_drops_inventory(
    ped: int, weapon_hash: int, x_offset: float, y_offset: float, z_offset: float, ammo_count: int
): void
    -- body function:
    WEAPON.SET_PED_DROPS_INVENTORY_WEAPON(ped, weapon_hash, x_offset, y_offset, z_offset, ammo_count)
end

function module.set_ammo_in_vehicle_clip(vehicle: int, seat: int, ammo: int): bool
    return WEAPON._SET_AMMO_IN_VEHICLE_WEAPON_CLIP(vehicle, seat, ammo)
end

function module.set_ammo_in_clip(ped: int, weapon_hash: int, ammo: int): bool
    return WEAPON.SET_AMMO_IN_CLIP(ped, weapon_hash, ammo)
end

function module.set_ammo_by_type(ped: int, ammo_type_hash: int, ammo: int): void
    WEAPON.SET_PED_AMMO_BY_TYPE(ped, ammo_type_hash, ammo)
end

function module.set_ammo_to_drop(ped: int, p1: int): void
    WEAPON.SET_PED_AMMO_TO_DROP(ped, p1)
end

function module.set_gadget(ped: int, gadget_hash: int, p2: bool): void
    WEAPON.SET_PED_GADGET(ped, gadget_hash, p2)
end

function module.set_tint_index(ped: int, weapon_hash: int, tint_index: int): void
    WEAPON.SET_PED_WEAPON_TINT_INDEX(ped, weapon_hash, tint_index)
end

function module.set_component_tint_index(
    ped: int, weapon_hash: int, camo_component_hash: int, color_index: int
): void
    -- body function:
    WEAPON.SET_PED_WEAPON_COMPONENT_TINT_INDEX(ped, weapon_hash, camo_component_hash, color_index)
end

function module.set_chance_of_firing_blanks(ped: int, x_bias: float, y_bias: float): void
    WEAPON.SET_PED_CHANCE_OF_FIRING_BLANKS(ped, x_bias, y_bias)
end

-- Returns handle of the projectile
function module.set_shoot_ordnance(ped: int, p1: float): int
    return WEAPON.SET_PED_SHOOT_ORDNANCE_WEAPON(ped, p1)
end

function module.set_damage_modifier(weapon: int, damage_modifier: float): void
    WEAPON._SET_WEAPON_PED_DAMAGE_MODIFIER(weapon, damage_modifier)
end

function module.set_eqipped_start_spinning_at_full_speed(ped: int): void
    WEAPON.SET_EQIPPED_WEAPON_START_SPINNING_AT_FULL_SPEED(ped)
end

function module.set_can_select_inventory(ped: int, weapon_hash: int, toggle: bool): void
    WEAPON.SET_CAN_PED_SELECT_INVENTORY_WEAPON(ped, weapon_hash, toggle)
end

function module.set_can_select_all_weapons(ped: int, toggle: bool): void
    WEAPON.SET_CAN_PED_SELECT_ALL_WEAPONS(ped, toggle)
end

-- Actions

function module.give(ped: int, weaponHash: int|string, ammoCount: int = 1, isHidden: bool = false, bForceInHand: bool = false): void
    local hash = Atdar.util.hash(weaponHash)
    WEAPON.GIVE_WEAPON_TO_PED(ped, hash, ammoCount, isHidden, bForceInHand)
end

function module.reset_ai_damage_modifier(): void
    PED.RESET_AI_WEAPON_DAMAGE_MODIFIER()
end

function module.reset_ai_melee_damage_modifier(): void
    PED.RESET_AI_MELEE_WEAPON_DAMAGE_MODIFIER()
end

function module.reset_movement_clipset(ped: int): void
    PED.RESET_PED_WEAPON_MOVEMENT_CLIPSET(ped)
end

function module.stop_firing_when_dropped(ped: int): void
    PED.STOP_PED_WEAPON_FIRING_WHEN_DROPPED(ped)
end

function module.add_ammo(ped: int, weapon_hash: int, ammo: int): void
    WEAPON.ADD_AMMO_TO_PED(ped, weapon_hash, ammo)
end

function module.give_delayed(ped: int, weapon_hash: int, ammo_count: int, b_force_in_hand: bool): void
    WEAPON.GIVE_DELAYED_WEAPON_TO_PED(ped, weapon_hash, ammo_count, b_force_in_hand)
end

function module.remove_all_weapons(ped: int, p1: bool): void
    WEAPON.REMOVE_ALL_PED_WEAPONS(ped, p1)
end

-- This native removes a specified weapon from your selected ped
function module.remove(ped: int, weapon_hash: int): void
    WEAPON.REMOVE_WEAPON_FROM_PED(ped, weapon_hash)
end

-- Hides the players weapon during a cutscene
function module.hide_for_scripted_cutscene(ped: int, toggle: bool): void
    WEAPON.HIDE_PED_WEAPON_FOR_SCRIPTED_CUTSCENE(ped, toggle)
end

function module.clear_last_damage(ped: int): void
    WEAPON.CLEAR_PED_LAST_WEAPON_DAMAGE(ped)
end

function module.add_ammo_by_type(ped: int, ammo_type_hash: int, ammo: int): void
    WEAPON.ADD_PED_AMMO_BY_TYPE(ped, ammo_type_hash, ammo)
end

function module.give_component(ped: int, weapon_hash: int, component_hash: int): void
    WEAPON.GIVE_WEAPON_COMPONENT_TO_PED(ped, weapon_hash, component_hash)
end

function module.remove_component(ped: int, weapon_hash: int, component_hash: int): void
    WEAPON.REMOVE_WEAPON_COMPONENT_FROM_PED(ped, weapon_hash, component_hash)
end

function module.make_reload(ped: int): bool
    return WEAPON.MAKE_PED_RELOAD(ped)
end

function module.give_object(weapon_object: int, ped: int): void
    WEAPON.GIVE_WEAPON_OBJECT_TO_PED(weapon_object, ped)
end

-- Gives the specified loadout to the specified ped
function module.give_loadout(ped: int, loadout_hash: int): void
    WEAPON.GIVE_LOADOUT_TO_PED(ped, loadout_hash)
end

return module
