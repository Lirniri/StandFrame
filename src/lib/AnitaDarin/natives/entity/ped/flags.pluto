-- Get

-- The flags found on { name, flag } as a list from the lowest number up: the numbers or the names
local function list_flags(set: table, return_as_int: bool): table

    local result = {}

    table.sort(set, function(a, b) return a.flag < b.flag end)

    for _, entry in ipairs(set) do
        if return_as_int then
            table.insert(result, entry.flag)
        else
            table.insert(result, entry.name)
        end
    end

    return result
end

function module.get_config(ped: int, flag: int): bool
    return PED.GET_PED_CONFIG_FLAG(ped, flag, true)
end

-- Every config flag of the table CONFIG with its value now. One native call for each of the 468, so not every frame
-- @param return_as_int true (default): by the number of the flag, { [457] = true, ... }; false: by its name,
--                      { FORCED_AIM_FROM_ARREST = true, ... }
function module.get_all_configs(ped: int, return_as_int: bool = true): table

    local configs = {}

    for name, flag in pairs(module.CONFIG) do

        local value = PED.GET_PED_CONFIG_FLAG(ped, flag, true)

        if return_as_int then
            configs[flag] = value
        else
            configs[name] = value
        end
    end

    return configs
end

-- Only the config flags that are on now, from the lowest number up: a list, short enough for the screen. The same
-- 468 native calls as get_all_configs
-- @param return_as_int true (default): the numbers, { 3, 135, 457 }; false: the names, { "DROWNS_IN_WATER", ... }
function module.get_active_configs(ped: int, return_as_int: bool = true): table

    local set = {}

    for name, flag in pairs(module.CONFIG) do
        if PED.GET_PED_CONFIG_FLAG(ped, flag, true) then
            table.insert(set, { name = name, flag = flag })
        end
    end

    return list_flags(set, return_as_int)
end

function module.get_reset(ped: int, flag: int): bool
    return PED.GET_PED_RESET_FLAG(ped, flag)
end

-- Every reset flag of the table RESET with its value now, as get_all_configs. A reset flag lasts one frame and one
-- set by another script is seen only if it was set before this read
-- @param return_as_int true (default): by the number of the flag; false: by its name
function module.get_all_resets(ped: int, return_as_int: bool = true): table

    local resets = {}

    for name, flag in pairs(module.RESET) do

        local value = PED.GET_PED_RESET_FLAG(ped, flag)

        if return_as_int then
            resets[flag] = value
        else
            resets[name] = value
        end
    end

    return resets
end

-- Only the reset flags that are on now, from the lowest number up, as get_active_configs
-- @param return_as_int true (default): the numbers; false: the names
function module.get_active_resets(ped: int, return_as_int: bool = true): table

    local set = {}

    for name, flag in pairs(module.RESET) do
        if PED.GET_PED_RESET_FLAG(ped, flag) then
            table.insert(set, { name = name, flag = flag })
        end
    end

    return list_flags(set, return_as_int)
end

-- Set

function module.set_config(ped: int, flag: int, toggle: bool): void
    PED.SET_PED_CONFIG_FLAG(ped, flag, toggle)
end

function module.set_reset(ped: int, flag: int, toggle: bool): void
    PED.SET_PED_RESET_FLAG(ped, flag, toggle)
end

return module
