local module = {}

-- Config flags: stay set until changed (SET/GET_PED_CONFIG_FLAG)

module.CONFIG = {
    DROWNS_IN_WATER = 3,
    DROWNS_IN_SINKING_VEHICLE = 4,
    DIES_INSTANTLY_WHEN_SWIMMING = 5,
    IS_SCUBA = 135,
    IS_IN_THE_AIR = 76,
    DONT_ACTIVATE_RAGDOLL_FROM_FALLING = 164,
}

-- Reset flags: cleared by the game every frame, so they're set each tick (SET/GET_PED_RESET_FLAG)
module.RESET = {
    IS_JUMPING = 18,
    IS_LANDING = 19, -- landing after being in the air
    IS_FALLING = 125, -- pure fall state: no parachuting, no landing
}

-- Get

function module.get_config(ped: int, flag: int): bool
    return PED.GET_PED_CONFIG_FLAG(ped, flag, true)
end

function module.get_reset(ped: int, flag: int): bool
    return PED.GET_PED_RESET_FLAG(ped, flag)
end

-- Set

function module.set_config(ped: int, flag: int, toggle: bool): void
    PED.SET_PED_CONFIG_FLAG(ped, flag, toggle)
end

function module.set_reset(ped: int, flag: int, toggle: bool): void
    PED.SET_PED_RESET_FLAG(ped, flag, toggle)
end

return module
