local module = {}

function module.get_all(as_pointer: bool = false)
    if as_pointer then
        return entities.get_all_objects_as_pointers()
    end
    return entities.get_all_objects_as_handles()
end

function module.get_net_id(obj): int
    return NETWORK.OBJ_TO_NET(obj)
end

function module.from_net_id(net_id): ?int
    local is_net_id_exist = NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then return nil end
    return NETWORK.NET_TO_OBJ(net_id)
end

return module
