-- Set

-- This is an alias of SET_ENTITY_AS_NO_LONGER_NEEDED
-- @param object Pointer: pass memory.alloc(size) and read the result back
function module.set_as_no_longer_needed(object: int): void
    ENTITY.SET_OBJECT_AS_NO_LONGER_NEEDED(object)
end

function module.set_targettable(object: int, targettable: bool, p2: any): void
    OBJECT.SET_OBJECT_TARGETTABLE(object, targettable, p2)
end

-- Sets the 34th and 35th object flags related to player peds
function module.set_targettable_by_player(object: int, set_flag34: bool, set_flag35: bool): void
    OBJECT._SET_OBJECT_TARGETTABLE_BY_PLAYER(object, set_flag34, set_flag35)
end

function module.set_force_vehicles_to_avoid(object: int, toggle: bool): void
    OBJECT.SET_OBJECT_FORCE_VEHICLES_TO_AVOID(object, toggle)
end

-- Overrides the climbing/blocking flags of the object, used in the native scripts mostly for "prop_dock_bouy_*"
function module.set_allow_low_lod_buoyancy(object: int, toggle: bool): void
    OBJECT.SET_OBJECT_ALLOW_LOW_LOD_BUOYANCY(object, toggle)
end

-- Adjust the physics parameters of a prop, or otherwise known as "object". This is useful for simulated gravity
function module.set_physics_params(
    object: int, weight: float, p2: float, p3: float, p4: float, p5: float, gravity: float,
    p7: float, p8: float, p9: float, p10: float, buoyancy: float
): void
    -- body function:
    OBJECT.SET_OBJECT_PHYSICS_PARAMS(object, weight, p2, p3, p4, p5, gravity, p7, p8, p9, p10, buoyancy)
end

function module.set_activate_physics_as_soon_as_it_is_unfrozen(object: int, toggle: bool): void
    OBJECT.SET_ACTIVATE_OBJECT_PHYSICS_AS_SOON_AS_IT_IS_UNFROZEN(object, toggle)
