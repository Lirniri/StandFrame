end

function module.clear_garage(garage_hash: int, is_network: bool): void
    OBJECT.CLEAR_GARAGE(garage_hash, is_network)
end

function module.clear_objects_inside_garage(
    garage_hash: int, vehicles: bool, peds: bool, objects: bool, is_network: bool
): void
    -- body function:
    OBJECT.CLEAR_OBJECTS_INSIDE_GARAGE(garage_hash, vehicles, peds, objects, is_network)
end

function module.disable_tidying_up_in_garage(id: int, toggle: bool): void
    OBJECT.DISABLE_TIDYING_UP_IN_GARAGE(id, toggle)
end

function module.enable_saving_in_garage(garage_hash: int, toggle: bool): void
    OBJECT.ENABLE_SAVING_IN_GARAGE(garage_hash, toggle)
end

function module.close_safehouse_garages(): void
    OBJECT.CLOSE_SAFEHOUSE_GARAGES()
end

function module.remove_high_detail_model(object: int): void
    OBJECT.REMOVE_OBJECT_HIGH_DETAIL_MODEL(object)
end

function module.break_fragment_child(p0: int, p1: any, p2: bool): void
    OBJECT.BREAK_OBJECT_FRAGMENT_CHILD(p0, p1, p2)
end

function module.damage_fragment_child(p0: any, p1: any, p2: any): void
    OBJECT.DAMAGE_OBJECT_FRAGMENT_CHILD(p0, p1, p2)
end

function module.fix_fragment(object: int): void
    OBJECT.FIX_OBJECT_FRAGMENT(object)
end

function module.track_visibility(object: int): void
    OBJECT.TRACK_OBJECT_VISIBILITY(object)
end

function module.allow_damage_events_for_non_networked_objects(value: bool): void
    OBJECT.ALLOW_DAMAGE_EVENTS_FOR_NON_NETWORKED_OBJECTS(value)
end

function module.only_clean_up_when_out_of_range(object: int): void
    OBJECT.ONLY_CLEAN_UP_OBJECT_WHEN_OUT_OF_RANGE(object)
end

return Atdar.loader.auto(module, "natives/entity/object")
