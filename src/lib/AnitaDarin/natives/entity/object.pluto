local module = {}

function module.get_all(as_pointers: bool = false)
    if as_pointers then
        return entities.get_all_objects_as_pointers()
    end
    return entities.get_all_objects_as_handles()
end

function module.get_net_id(obj): int
    return NETWORK.OBJ_TO_NET(obj)
end

function module.from_net_id(net_id): ?int
    local is_net_id_exist = NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id)
    if not is_net_id_exist then return nil end
    return NETWORK.NET_TO_OBJ(net_id)
end

-- State

function module.has_been_broken(object: int, p1: any): bool
    return OBJECT.HAS_OBJECT_BEEN_BROKEN(object, p1)
end

function module.has_closest_type_been_broken(
    p0: float, p1: float, p2: float, p3: float, model_hash: int, p5: any
): bool
    -- body function:
    return OBJECT.HAS_CLOSEST_OBJECT_OF_TYPE_BEEN_BROKEN(p0, p1, p2, p3, model_hash, p5)
end

function module.has_closest_type_been_completely_destroyed(
    x: float, y: float, z: float, radius: float, model_hash: int, p5: bool
): bool
    -- body function:
    return OBJECT.HAS_CLOSEST_OBJECT_OF_TYPE_BEEN_COMPLETELY_DESTROYED(x, y, z, radius, model_hash, p5)
end

function module.is_garage_empty(garage_hash: int, p1: bool, p2: int): bool
    return OBJECT.IS_GARAGE_EMPTY(garage_hash, p1, p2)
end

function module.is_player_entirely_inside_garage(garage_hash: int, player_id: int, p2: float, p3: int): bool
    return OBJECT.IS_PLAYER_ENTIRELY_INSIDE_GARAGE(garage_hash, player_id, p2, p3)
end

function module.is_player_partially_inside_garage(garage_hash: int, player_id: int, p2: int): bool
    return OBJECT.IS_PLAYER_PARTIALLY_INSIDE_GARAGE(garage_hash, player_id, p2)
end

function module.are_entities_entirely_inside_garage(
    garage_hash: int, p1: bool, p2: bool, p3: bool, p4: any
): bool
    -- body function:
    return OBJECT.ARE_ENTITIES_ENTIRELY_INSIDE_GARAGE(garage_hash, p1, p2, p3, p4)
end

function module.is_any_entity_entirely_inside_garage(
    garage_hash: int, p1: bool, p2: bool, p3: bool, p4: any
): bool
    -- body function:
    return OBJECT.IS_ANY_ENTITY_ENTIRELY_INSIDE_GARAGE(garage_hash, p1, p2, p3, p4)
end

-- Despite the name, it does work for any entity type
function module.is_entirely_inside_garage(garage_hash: int, entity: int, p2: float, p3: int): bool
    return OBJECT.IS_OBJECT_ENTIRELY_INSIDE_GARAGE(garage_hash, entity, p2, p3)
end

-- Despite the name, it does work for any entity type
function module.is_partially_inside_garage(garage_hash: int, entity: int, p2: int): bool
    return OBJECT.IS_OBJECT_PARTIALLY_INSIDE_GARAGE(garage_hash, entity, p2)
end

function module.does_type_exist_at_coords(
    x: float, y: float, z: float, radius: float, hash: int, p5: bool
): bool
    -- body function:
    return OBJECT.DOES_OBJECT_OF_TYPE_EXIST_AT_COORDS(x, y, z, radius, hash, p5)
end

function module.is_point_in_angled_area(
    x_pos: float, y_pos: float, z_pos: float, x1: float, y1: float, z1: float, x2: float, y2: float,
    z2: float, width: float, debug: bool, include_z: bool
): bool
    -- body function:
    return OBJECT.IS_POINT_IN_ANGLED_AREA(x_pos, y_pos, z_pos, x1, y1, z1, x2, y2, z2, width, debug, include_z)
end

function module.is_any_near_point(x: float, y: float, z: float, range: float, p4: bool): bool
    return OBJECT.IS_ANY_OBJECT_NEAR_POINT(x, y, z, range, p4)
end

function module.is_near_point(object_hash: int, x: float, y: float, z: float, range: float): bool
    return OBJECT.IS_OBJECT_NEAR_POINT(object_hash, x, y, z, range)
end

function module.is_visible(object: int): bool
    return OBJECT.IS_OBJECT_VISIBLE(object)
end

function module.does_rayfire_map_exist(object: int): bool
    return OBJECT.DOES_RAYFIRE_MAP_OBJECT_EXIST(object)
end

function module.is_prop_light_overriden(object: int): bool
    return OBJECT.IS_PROP_LIGHT_OVERRIDEN(object)
end

-- Get

-- Has 8 params in the latest patches
function module.get_closest_type(
    x: float, y: float, z: float, radius: float, model_hash: int, is_mission: bool, p6: bool,
    p7: bool
): int
    -- body function:
    return OBJECT.GET_CLOSEST_OBJECT_OF_TYPE(x, y, z, radius, model_hash, is_mission, p6, p7)
end

function module.get_has_been_completely_destroyed(p0: any): bool
    return OBJECT.GET_HAS_OBJECT_BEEN_COMPLETELY_DESTROYED(p0)
end

function module.get_offset_from_coord_and_heading_in_world_coords(
    x_pos: float, y_pos: float, z_pos: float, heading: float, x_offset: float, y_offset: float,
    z_offset: float
): vector3
    -- body function:
    return OBJECT.GET_OFFSET_FROM_COORD_AND_HEADING_IN_WORLD_COORDS(x_pos, y_pos, z_pos, heading, x_offset, y_offset, z_offset)
end

-- @param out_position Pointer: pass memory.alloc(size) and read the result back
-- @param out_rotation Pointer: pass memory.alloc(size) and read the result back
function module.get_coords_and_rotation_of_closest_type(
    x: float, y: float, z: float, radius: float, model_hash: int, out_position: int,
    out_rotation: int, rotation_order: int
): bool
    -- body function:
    return OBJECT.GET_COORDS_AND_ROTATION_OF_CLOSEST_OBJECT_OF_TYPE(x, y, z, radius, model_hash, out_position, out_rotation, rotation_order)
end

function module.get_fragment_damage_health(p0: any, p1: bool): float
    return OBJECT.GET_OBJECT_FRAGMENT_DAMAGE_HEALTH(p0, p1)
end

function module.get_rayfire_map(x: float, y: float, z: float, radius: float, name: string): int
    return OBJECT.GET_RAYFIRE_MAP_OBJECT(x, y, z, radius, name)
end

-- Get a destructible object's state
function module.get_state_of_rayfire_map(object: int): int
    return OBJECT.GET_STATE_OF_RAYFIRE_MAP_OBJECT(object)
end

function module.get_rayfire_map_anim_phase(object: int): float
    return OBJECT.GET_RAYFIRE_MAP_OBJECT_ANIM_PHASE(object)
