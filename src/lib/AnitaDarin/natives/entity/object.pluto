-- Actions

function module.create(
    model_hash: int, x: float, y: float, z: float, is_network: bool, b_script_host_obj: bool,
    dynamic: bool
): int
    -- body function:
    return OBJECT.CREATE_OBJECT(model_hash, x, y, z, is_network, b_script_host_obj, dynamic)
end

function module.create_no_offset(
    model_hash: int, x: float, y: float, z: float, is_network: bool, b_script_host_obj: bool,
    dynamic: bool, p7: any
): int
    -- body function:
    return OBJECT.CREATE_OBJECT_NO_OFFSET(model_hash, x, y, z, is_network, b_script_host_obj, dynamic, p7)
end

-- Deletes the specified object, then sets the handle pointed to by the pointer to NULL
-- @param object Pointer: pass memory.alloc(size) and read the result back
function module.delete(object: int): void
    OBJECT.DELETE_OBJECT(object)
end

function module.place_on_ground_properly(object: int): bool
    return OBJECT.PLACE_OBJECT_ON_GROUND_PROPERLY(object)
end

function module.place_object_on_ground_or_object_properly(object: int): bool
    return OBJECT.PLACE_OBJECT_ON_GROUND_OR_OBJECT_PROPERLY(object)
end

function module.rotate(object: int, p1: float, p2: float, p3: bool): bool
    return OBJECT.ROTATE_OBJECT(object, p1, p2, p3)
end

function module.slide(
    object: int, to_x: float, to_y: float, to_z: float, speed_x: float, speed_y: float,
    speed_z: float, collision: bool
): bool
    -- body function:
    return OBJECT.SLIDE_OBJECT(object, to_x, to_y, to_z, speed_x, speed_y, speed_z, collision)
end

function module.play_auto_start_anim(p0: any): void
    OBJECT.PLAY_OBJECT_AUTO_START_ANIM(p0)
end

function module.open_all_barriers_for_race(p0: bool): void
