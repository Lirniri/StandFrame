-- class Vehicle extends Entity: a vehicle in the game.
--
--     local Vehicle = Atdar.natives.vehicle
--     local car = Vehicle.user()            -- the player's (last) vehicle, read on every call
--     if car:is_exist() then car:explode() end
--     Vehicle.class_of("adder")             -- for models, without a vehicle

local Entity = Atdar.loader.load("natives/entity")

local class Vehicle extends Entity

    -- State

    -- An entity that exists and is a vehicle: a handle of -1 (no vehicle) or of a ped is false
    function is_exist(): bool
        local handle = self:handle()
        if not ENTITY.DOES_ENTITY_EXIST(handle) then
            return false
        end
        return ENTITY.IS_ENTITY_A_VEHICLE(handle)
    end

    function is_stopped(): bool
        return VEHICLE.IS_VEHICLE_STOPPED(self:handle())
    end

    -- Get

    function get_class(): int
        return VEHICLE.GET_VEHICLE_CLASS(self:handle())
    end

    function get_net_id(): int
        return NETWORK.VEH_TO_NET(self:handle())
    end

    -- Actions

    -- opts: { is_audible = true, is_invisible = false, net_id = nil }
    -- net_id given: a networked explosion (NETWORK_EXPLODE_VEHICLE), otherwise a local one
    function explode(opts: table = {}): void
        local is_audible = opts.is_audible ~= false
        local is_invisible = opts.is_invisible == true
        if opts.net_id ~= nil then
            NETWORK.NETWORK_EXPLODE_VEHICLE(self:handle(), is_audible, is_invisible, opts.net_id)
            return
        end
        VEHICLE.EXPLODE_VEHICLE(self:handle(), is_audible, is_invisible)
    end

end

-- One object per kind of the player's vehicle, made on first use; the handle is read on every call
local user = {}

-- @return The player's vehicle (with include_last, also the last one they left); check is_exist(),
-- the handle is -1 when there is none
function Vehicle.user(include_last: bool = true): table
    local key = include_last ? "last" : "current"
    user[key] ??= new Vehicle(|| -> entities.get_user_vehicle_as_handle(include_last))
    return user[key]
end

-- @return The player's personal vehicle, or nil outside an online session
function Vehicle.personal(include_last: bool = true): ?table
    if not util.is_session_started() then
        return nil
    end
    return new Vehicle(entities.get_user_personal_vehicle_as_handle(include_last))
end

-- @return Handles (or pointers) of every vehicle in the world
function Vehicle.get_all(as_pointers: bool = false): table
    if as_pointers then
        return entities.get_all_vehicles_as_pointers()
    end
    return entities.get_all_vehicles_as_handles()
end

-- @return The vehicle behind a network id, or nil if there is none
function Vehicle.from_net_id(net_id: int): ?table
    if not NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id) then
        return nil
    end
    return new Vehicle(NETWORK.NET_TO_VEH(net_id))
end

-- Models, without a vehicle in the world

-- model: a model name ("adder") or hash
function Vehicle.is_model(model: int|string): bool
    return STREAMING.IS_MODEL_A_VEHICLE(Atdar.util.hash(model))
end

-- model: a model name ("adder") or hash
function Vehicle.class_of(model: int|string): int
    return VEHICLE.GET_VEHICLE_CLASS_FROM_NAME(Atdar.util.hash(model))
end

return Vehicle
