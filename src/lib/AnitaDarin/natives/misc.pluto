end

function module.is_sniper_bullet_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float
): bool
    -- body function:
    return MISC.IS_SNIPER_BULLET_IN_AREA(x1, y1, z1, x2, y2, z2)
end

-- Determines whether there is a projectile within the specified coordinates. The coordinates form a rectangle
function module.is_projectile_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_PROJECTILE_IN_AREA(x1, y1, z1, x2, y2, z2, owned_by_player)
end

function module.is_projectile_type_in_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, type: int,
    owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_PROJECTILE_TYPE_IN_AREA(x1, y1, z1, x2, y2, z2, type, owned_by_player)
end

function module.is_projectile_type_in_angled_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, width: float, p7: any,
    owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_PROJECTILE_TYPE_IN_ANGLED_AREA(x1, y1, z1, x2, y2, z2, width, p7, owned_by_player)
end

function module.is_projectile_type_within_distance(
    x: float, y: float, z: float, projectile_hash: int, radius: float, owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_PROJECTILE_TYPE_WITHIN_DISTANCE(x, y, z, projectile_hash, radius, owned_by_player)
end

-- For projectiles, see: IS_PROJECTILE_TYPE_IN_ANGLED_AREA
function module.is_bullet_in_angled_area(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, width: float,
    owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_BULLET_IN_ANGLED_AREA(x1, y1, z1, x2, y2, z2, width, owned_by_player)
end

function module.is_bullet_in_area(x: float, y: float, z: float, radius: float, owned_by_player: bool): bool
    return MISC.IS_BULLET_IN_AREA(x, y, z, radius, owned_by_player)
end

function module.is_bullet_in_box(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, owned_by_player: bool
): bool
    -- body function:
    return MISC.IS_BULLET_IN_BOX(x1, y1, z1, x2, y2, z2, owned_by_player)
end

function module.has_bullet_impacted_in_area(x: float, y: float, z: float, p3: float, p4: bool, p5: bool): bool
    return MISC.HAS_BULLET_IMPACTED_IN_AREA(x, y, z, p3, p4, p5)
end

function module.has_bullet_impacted_in_box(
    p0: float, p1: float, p2: float, p3: float, p4: float, p5: float, p6: bool, p7: bool
): bool
    -- body function:
    return MISC.HAS_BULLET_IMPACTED_IN_BOX(p0, p1, p2, p3, p4, p5, p6, p7)
end

