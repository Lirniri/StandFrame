local module = { radio = {} }

function module.radio.is_active(): bool
    return AUDIO.IS_MOBILE_PHONE_RADIO_ACTIVE()
end
function module.radio.set_state(station_id: int): void
    AUDIO.SET_MOBILE_PHONE_RADIO_STATE(station_id)
end
function module.radio.enable(toggle: bool): void
    AUDIO.SET_MOBILE_RADIO_ENABLED_DURING_GAMEPLAY(toggle)
end

-- State

function module.is_ped_ringtone_playing(ped: int): bool
    return AUDIO.IS_PED_RINGTONE_PLAYING(ped)
end

function module.is_call_ongoing(): bool
    return AUDIO.IS_MOBILE_PHONE_CALL_ONGOING()
end

function module.is_interference_active(): bool
    return AUDIO.IS_MOBILE_INTERFERENCE_ACTIVE()
end

-- Set

-- This native controls where the game plays audio from. By default the microphone is positioned on the player
function module.set_microphone_position(
    toggle: bool, x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, x3: float,
    y3: float, z3: float
): void
    -- body function:
    AUDIO.SET_MICROPHONE_POSITION(toggle, x1, y1, z1, x2, y2, z2, x3, y3, z3)
end

-- Actions

function module.play_ped_ringtone(ringtone_name: string, ped: int, p2: bool): void
    AUDIO.PLAY_PED_RINGTONE(ringtone_name, ped, p2)
end

function module.stop_ped_ringtone(ped: int): void
    AUDIO.STOP_PED_RINGTONE(ped)
end

function module.start_script_conversation(p0: bool, p1: bool): void
    AUDIO.START_SCRIPT_PHONE_CONVERSATION(p0, p1)
end

function module.preload_script_conversation(p0: bool, p1: bool): void
    AUDIO.PRELOAD_SCRIPT_PHONE_CONVERSATION(p0, p1)
end

-- Sets audio flag "OverrideMicrophoneSettings"
function module.override_microphone_settings(hash: int, toggle: bool): void
    AUDIO.OVERRIDE_MICROPHONE_SETTINGS(hash, toggle)
end

function module.freeze_microphone(): void
    AUDIO.FREEZE_MICROPHONE()
end

return module
