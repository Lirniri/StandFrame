-- Ped speech, conversations and voices

local module = {}

-- State

function module.is_scripted_conversation_ongoing(): bool
    return AUDIO.IS_SCRIPTED_CONVERSATION_ONGOING()
end

function module.is_scripted_conversation_loaded(): bool
    return AUDIO.IS_SCRIPTED_CONVERSATION_LOADED()
end

function module.is_ambient_speech_playing(ped: int): bool
    return AUDIO.IS_AMBIENT_SPEECH_PLAYING(ped)
end

function module.is_scripted_speech_playing(p0: int): bool
    return AUDIO.IS_SCRIPTED_SPEECH_PLAYING(p0)
end

function module.is_any_speech_playing(ped: int): bool
    return AUDIO.IS_ANY_SPEECH_PLAYING(ped)
end

function module.is_any_positional_speech_playing(): bool
    return AUDIO.IS_ANY_POSITIONAL_SPEECH_PLAYING()
end

function module.is_ped_in_current_conversation(ped: int): bool
    return AUDIO.IS_PED_IN_CURRENT_CONVERSATION(ped)
end

function module.is_animal_vocalization_playing(ped_handle: int): bool
    return AUDIO.IS_ANIMAL_VOCALIZATION_PLAYING(ped_handle)
end

function module.is_ambient_speech_disabled(ped: int): bool
    return AUDIO.IS_AMBIENT_SPEECH_DISABLED(ped)
end

-- Get

function module.get_is_preloaded_conversation_ready(): bool
    return AUDIO.GET_IS_PRELOADED_CONVERSATION_READY()
end

function module.get_current_scripted_conversation_line(): int
    return AUDIO.GET_CURRENT_SCRIPTED_CONVERSATION_LINE()
end

function module.get_ambient_voice_name_hash(ped: int): int
    return AUDIO.GET_AMBIENT_VOICE_NAME_HASH(ped)
end

-- Set

function module.set_position_for_null_conv_ped(p0: any, p1: float, p2: float, p3: float): void
    AUDIO.SET_POSITION_FOR_NULL_CONV_PED(p0, p1, p2, p3)
end

function module.set_entity_for_null_conv_ped(p0: int, entity: int): void
    AUDIO.SET_ENTITY_FOR_NULL_CONV_PED(p0, entity)
end

function module.set_conversation_audio_controlled_by_anim(p0: bool): void
    AUDIO.SET_CONVERSATION_AUDIO_CONTROLLED_BY_ANIM(p0)
end

function module.set_conversation_audio_placeholder(p0: bool): void
    AUDIO.SET_CONVERSATION_AUDIO_PLACEHOLDER(p0)
end

function module.set_no_ducking_for_conversation(p0: bool): void
    AUDIO.SET_NO_DUCKING_FOR_CONVERSATION(p0)
end

function module.set_player_angry(ped: int, toggle: bool): void
    AUDIO.SET_PLAYER_ANGRY(ped, toggle)
end

function module.set_ambient_voice_name(ped: int, name: string): void
    AUDIO.SET_AMBIENT_VOICE_NAME(ped, name)
end

function module.set_ambient_voice_name_hash(ped: int, hash: int): void
    AUDIO.SET_AMBIENT_VOICE_NAME_HASH(ped, hash)
end

-- Assigns some ambient voice to the ped
function module.set_ped_voice_full(ped: int): void
    AUDIO.SET_PED_VOICE_FULL(ped)
end

function module.set_ped_race_and_voice_group(ped: int, p1: int, voice_group: int): void
    AUDIO.SET_PED_RACE_AND_VOICE_GROUP(ped, p1, voice_group)
end

function module.set_ped_voice_group(ped: int, voice_group_hash: int): void
    AUDIO.SET_PED_VOICE_GROUP(ped, voice_group_hash)
end

function module.set_ped_voice_group_from_race_to_pvg(ped: int, voice_group_hash: int): void
    AUDIO.SET_PED_VOICE_GROUP_FROM_RACE_TO_PVG(ped, voice_group_hash)
end

function module.set_ped_gender(ped: int, p1: bool): void
    AUDIO.SET_PED_GENDER(ped, p1)
end

-- Sets the ped drunk sounds.  Only works with PLAYER_PED_ID
function module.set_ped_is_drunk(ped: int, toggle: bool): void
    AUDIO.SET_PED_IS_DRUNK(ped, toggle)
end

function module.set_animal_mood(animal: int, mood: int): void
    AUDIO.SET_ANIMAL_MOOD(animal, mood)
end

function module.set_vehicle_conversations_persist(p0: bool, p1: bool): void
    AUDIO.SET_VEHICLE_CONVERSATIONS_PERSIST(p0, p1)
end

function module.set_vehicle_conversations_persist_new(p0: bool, p1: bool, p2: bool): void
    AUDIO.SET_VEHICLE_CONVERSATIONS_PERSIST_NEW(p0, p1, p2)
end

function module.set_ped_walla_density(p0: float, p1: float): void
    AUDIO.SET_PED_WALLA_DENSITY(p0, p1)
end

function module.set_ped_interior_walla_density(p0: float, p1: float): void
    AUDIO.SET_PED_INTERIOR_WALLA_DENSITY(p0, p1)
end

-- Actions

function module.create_new_scripted_conversation(): void
    AUDIO.CREATE_NEW_SCRIPTED_CONVERSATION()
end

function module.add_line_to_conversation(
    index: int, p1: string, p2: string, p3: int, p4: int, p5: bool, p6: bool, p7: bool, p8: bool,
    p9: int, p10: bool, p11: bool, p12: bool
): void
    -- body function:
    AUDIO.ADD_LINE_TO_CONVERSATION(index, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12)
end

function module.add_ped_to_conversation(index: int, ped: int, p2: string): void
    AUDIO.ADD_PED_TO_CONVERSATION(index, ped, p2)
end

function module.start_script_conversation(p0: bool, p1: bool, p2: bool, p3: bool): void
    AUDIO.START_SCRIPT_CONVERSATION(p0, p1, p2, p3)
end

function module.preload_script_conversation(p0: bool, p1: bool, p2: bool, p3: bool): void
    AUDIO.PRELOAD_SCRIPT_CONVERSATION(p0, p1, p2, p3)
end

function module.start_preloaded_conversation(): void
    AUDIO.START_PRELOADED_CONVERSATION()
end

function module.pause_scripted_conversation(p0: bool): void
    AUDIO.PAUSE_SCRIPTED_CONVERSATION(p0)
end

function module.restart_scripted_conversation(): void
    AUDIO.RESTART_SCRIPTED_CONVERSATION()
end

function module.stop_scripted_conversation(p0: bool): int
    return AUDIO.STOP_SCRIPTED_CONVERSATION(p0)
end

function module.skip_to_next_scripted_conversation_line(): void
    AUDIO.SKIP_TO_NEXT_SCRIPTED_CONVERSATION_LINE()
end

function module.interrupt_conversation(ped: int, voiceline: string, speaker: string): void
    AUDIO.INTERRUPT_CONVERSATION(ped, voiceline, speaker)
end

function module.interrupt_conversation_and_pause(ped: int, p1: string, speaker: string): void
    AUDIO.INTERRUPT_CONVERSATION_AND_PAUSE(ped, p1, speaker)
end

function module.play_ped_ambient_speech_native(
    ped: int, speech_name: string, speech_param: string, p3: any
): void
    -- body function:
    AUDIO.PLAY_PED_AMBIENT_SPEECH_NATIVE(ped, speech_name, speech_param, p3)
end

function module.play_ped_ambient_speech_and_clone_native(
    ped: int, speech_name: string, speech_param: string, p3: any
): void
    -- body function:
    AUDIO.PLAY_PED_AMBIENT_SPEECH_AND_CLONE_NATIVE(ped, speech_name, speech_param, p3)
end

function module.play_ped_ambient_speech_with_voice_native(
    ped: int, speech_name: string, voice_name: string, speech_param: string, p4: bool
): void
    -- body function:
    AUDIO.PLAY_PED_AMBIENT_SPEECH_WITH_VOICE_NATIVE(ped, speech_name, voice_name, speech_param, p4)
end

function module.play_ambient_speech_from_position_native(
    speech_name: string, voice_name: string, x: float, y: float, z: float, speech_param: string
): void
    -- body function:
    AUDIO.PLAY_AMBIENT_SPEECH_FROM_POSITION_NATIVE(speech_name, voice_name, x, y, z, speech_param)
end

-- This native enables the audio flag "TrevorRageIsOverridden" and sets the voice effect to `voiceEffect`
function module.override_trevor_rage(voice_effect: string): void
    AUDIO.OVERRIDE_TREVOR_RAGE(voice_effect)
end

function module.reset_trevor_rage(): void
    AUDIO.RESET_TREVOR_RAGE()
end

function module.play_pain(ped: int, pain_id: int, p1: int, p3: any): void
    AUDIO.PLAY_PAIN(ped, pain_id, p1, p3)
end

function module.stop_current_playing_speech(ped: int): void
    AUDIO.STOP_CURRENT_PLAYING_SPEECH(ped)
end

function module.stop_current_playing_ambient_speech(ped: int): void
    AUDIO.STOP_CURRENT_PLAYING_AMBIENT_SPEECH(ped)
end

function module.play_animal_vocalization(ped_handle: int, p1: int, speech_name: string): void
    AUDIO.PLAY_ANIMAL_VOCALIZATION(ped_handle, p1, speech_name)
end

function module.stop_ped_speaking(ped: int, shaking: bool): void
    AUDIO.STOP_PED_SPEAKING(ped, shaking)
end

function module.block_all_speech_from_ped(ped: int, p1: bool, p2: bool): void
    AUDIO.BLOCK_ALL_SPEECH_FROM_PED(ped, p1, p2)
end

function module.stop_ped_speaking_synced(ped: int, p1: bool): void
    AUDIO.STOP_PED_SPEAKING_SYNCED(ped, p1)
end

function module.disable_ped_pain_audio(ped: int, toggle: bool): void
    AUDIO.DISABLE_PED_PAIN_AUDIO(ped, toggle)
end

function module.block_speech_context_group(p0: string, p1: int): void
    AUDIO.BLOCK_SPEECH_CONTEXT_GROUP(p0, p1)
end

function module.unblock_speech_context_group(p0: string): void
    AUDIO.UNBLOCK_SPEECH_CONTEXT_GROUP(p0)
end

function module.force_ped_panic_walla(): void
    AUDIO.FORCE_PED_PANIC_WALLA()
end

return module
