-- class Object extends Entity: a prop or any other object in the game.
--
--     local Object = Atdar.natives.object
--     local prop = new Object(handle)

local Entity = Atdar.loader.load("natives/entity")

local class Object extends Entity

    -- Get

    function get_net_id(): int
        return NETWORK.OBJ_TO_NET(self:handle())
    end

end

-- @return Handles (or pointers) of every object in the world
function Object.get_all(as_pointers: bool = false): table
    if as_pointers then
        return entities.get_all_objects_as_pointers()
    end
    return entities.get_all_objects_as_handles()
end

-- @return The object behind a network id, or nil if there is none
function Object.from_net_id(net_id: int): ?table
    if not NETWORK.NETWORK_DOES_NETWORK_ID_EXIST(net_id) then
        return nil
    end
    return new Object(NETWORK.NET_TO_OBJ(net_id))
end

return Object
