-- IPLs (map placements)

local module = {}

-- State

function module.is_active(ipl_name: string): bool
    return STREAMING.IS_IPL_ACTIVE(ipl_name)
end

-- Actions

function module.request(ipl_name: string): void
    STREAMING.REQUEST_IPL(ipl_name)
end

-- Removes an IPL from the map
function module.remove(ipl_name: string): void
    STREAMING.REMOVE_IPL(ipl_name)
end

function module.group_swap_start(ipl_name1: string, ipl_name2: string): void
    STREAMING.IPL_GROUP_SWAP_START(ipl_name1, ipl_name2)
end

function module.group_swap_cancel(): void
    STREAMING.IPL_GROUP_SWAP_CANCEL()
end

function module.group_swap_is_ready(): bool
    return STREAMING.IPL_GROUP_SWAP_IS_READY()
end

function module.group_swap_finish(): void
    STREAMING.IPL_GROUP_SWAP_FINISH()
end

function module.group_swap_is_active(): bool
    return STREAMING.IPL_GROUP_SWAP_IS_ACTIVE()
end

return module
