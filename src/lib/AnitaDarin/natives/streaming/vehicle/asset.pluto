-- class VehicleAsset extends StreamingAsset: a vehicle asset. They're numbered per model (asset id), not named.
--
--     new Atdar.natives.streaming.vehicle.asset("adder", 0):request()

local StreamingAsset = Atdar.loader.load("natives/streaming/asset")

local class VehicleAsset extends StreamingAsset

    -- model: vehicle model name or hash; asset: the asset id (int)
    function __construct(model: int|string, asset: int)
        parent:__construct($"vehicle asset {asset} of '{model}'")
        self.model = type(model) == "string" ? util.joaat(model) : model
        self.asset = asset
    end

    -- State

    function is_loaded(): bool
        return VEHICLE.HAS_VEHICLE_ASSET_LOADED(self.asset)
    end

    -- Actions

    function send_request(): void
        VEHICLE.REQUEST_VEHICLE_ASSET(self.model, self.asset)
    end

end

return VehicleAsset
