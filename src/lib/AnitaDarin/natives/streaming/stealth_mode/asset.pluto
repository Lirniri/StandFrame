-- class StealthModeAsset extends StreamingAsset: a stealth mode (movement style) asset, by name.
--
--     new Atdar.natives.streaming.stealth_mode.asset(name):request()

local StreamingAsset = Atdar.loader.load("natives/streaming/asset")

local class StealthModeAsset extends StreamingAsset

    function __construct(name: string)
        parent:__construct($"stealth mode asset '{name}'")
        self.name = name
    end

    -- State

    function is_loaded(): bool
        return PED.HAS_STEALTH_MODE_ASSET_LOADED(self.name)
    end

    -- Actions

    function send_request(): void
        PED.REQUEST_STEALTH_MODE_ASSET(self.name)
    end

end

return StealthModeAsset
