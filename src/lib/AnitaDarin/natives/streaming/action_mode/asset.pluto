-- class ActionModeAsset extends StreamingAsset: an action mode (movement style) asset, by name.
--
--     new Atdar.natives.streaming.action_mode.asset(name):request()

local StreamingAsset = Atdar.loader.load("natives/streaming/asset")

local class ActionModeAsset extends StreamingAsset

    function __construct(name: string)
        parent:__construct($"action mode asset '{name}'")
        self.name = name
    end

    -- State

    function is_loaded(): bool
        return PED.HAS_ACTION_MODE_ASSET_LOADED(self.name)
    end

    -- Actions

    function send_request(): void
        PED.REQUEST_ACTION_MODE_ASSET(self.name)
    end

end

return ActionModeAsset
