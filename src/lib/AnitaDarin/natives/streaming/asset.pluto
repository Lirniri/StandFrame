function request_vehicle(hash, asset, timeout = 2000)
    local name = type(hash) == "string" ? util.joaat(hash) : hash
    timeout += util.current_time_millis()

    VEHICLE.REQUEST_VEHICLE_ASSET(hash, asset)
    white (not VEHICLE.HAS_VEHICLE_ASSET_LOADED(asset) and util.current_time_millis() < timeout) do
        util.yield()
    end
    if not VEHICLE.HAS_VEHICLE_ASSET_LOADED(asset) then
        -- body
    end
end

return module