local Logger = Atdar.loader.load("core/logger")

local log = new Logger("natives/streaming/asset")

local module = {}

-- State
-- Only check whether an asset is in memory; nothing is requested

-- asset: action mode asset name
function module.is_action_mode_loaded(asset)
    return PED.HAS_ACTION_MODE_ASSET_LOADED(asset)
end

-- asset: stealth mode asset name
function module.is_stealth_mode_loaded(asset)
    return PED.HAS_STEALTH_MODE_ASSET_LOADED(asset)
end

-- asset: named PTFX asset, e.g. "scr_rcbarry2"
function module.is_ptfx_loaded(asset)
    return STREAMING.HAS_NAMED_PTFX_ASSET_LOADED(asset)
end

-- Actions

-- Requests a PTFX asset without waiting for it; name nil -> the script's default PTFX asset.
-- Use request_ptfx() below to also wait until it loads
function module._request_ptfx(name)
    if name ~= nil then
        STREAMING.REQUEST_NAMED_PTFX_ASSET(name)
    else
        STREAMING.REQUEST_PTFX_ASSET()
    end
end

-- Frees a PTFX asset when it's no longer needed; name nil -> the script's default PTFX asset
function module.remove_ptfx(name)
    if name ~= nil then
        STREAMING.REMOVE_NAMED_PTFX_ASSET(name)
    else
        STREAMING.REMOVE_PTFX_ASSET()
    end
end

-- Waits until is_loaded() or the timeout runs out; warns on timeout
-- @return Whether the asset loaded
local function wait_loaded(what: string, is_loaded: function, timeout: int): bool
    local deadline = util.current_time_millis() + timeout
    while not is_loaded() and util.current_time_millis() < deadline do
        util.yield()
    end
    if is_loaded() then
        return true
    end
    log:warn($"{what} didn't load in {timeout} ms")
    return false
end

-- request_*: requests the asset and waits until it loads (yields, so call from a tick/thread, not the main body).
-- Action/stealth mode and PTFX assets are requested by name, not by hash
-- @return Whether the asset loaded before the timeout (ms)

function module.request_action_mode(name: string, timeout: int = 2000): bool
    PED.REQUEST_ACTION_MODE_ASSET(name)
    return wait_loaded($"action mode asset '{name}'", || -> module.is_action_mode_loaded(name), timeout)
end

function module.request_stealth_mode(name: string, timeout: int = 2000): bool
    PED.REQUEST_STEALTH_MODE_ASSET(name)
    return wait_loaded($"stealth mode asset '{name}'", || -> module.is_stealth_mode_loaded(name), timeout)
end

function module.request_ptfx(name: string, timeout: int = 2000): bool
    STREAMING.REQUEST_NAMED_PTFX_ASSET(name)
    return wait_loaded($"ptfx asset '{name}'", || -> module.is_ptfx_loaded(name), timeout)
end

-- model: vehicle model name or hash
function module.request_vehicle(model: int|string, asset: int, timeout: int = 2000): bool
    local hash = type(model) == "string" ? util.joaat(model) : model
    VEHICLE.REQUEST_VEHICLE_ASSET(hash, asset)
    return wait_loaded($"vehicle asset {asset} of '{model}'", || -> Atdar.natives.streaming.vehicle.asset.is_loaded(asset), timeout)
end


-- Asset type -> its request function, picked by request()
local REQUEST = {
    action_mode = |opts| -> module.request_action_mode(opts.name, opts.timeout),
    stealth_mode = |opts| -> module.request_stealth_mode(opts.name, opts.timeout),
    ptfx = |opts| -> module.request_ptfx(opts.name, opts.timeout),
    vehicle = |opts| -> module.request_vehicle(opts.model, opts.asset, opts.timeout),
}

-- One entry point for all asset types; opts.what picks the type, the rest are its arguments:
--   { what = "action_mode" | "stealth_mode" | "ptfx", name = "...", timeout = 2000 }
--   { what = "vehicle", model = "adder", asset = 0, timeout = 2000 }
-- @return Whether the asset loaded
function module.request(opts: table): bool
    local request = REQUEST[opts.what]
    if not request then
        log:error($"unknown asset type '{tostring(opts.what)}', expected action_mode, stealth_mode, ptfx or vehicle")
        return false
    end
    return request(opts)
end

return module
