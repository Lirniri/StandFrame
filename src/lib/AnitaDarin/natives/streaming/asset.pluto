local module = {}

function request_action_mode(name, timeout = 2000)
    local name = type(name) == "string" ? util.joaat(name) : name
    timeout += util.current_time_millis()

    PED.REQUEST_ACTION_MODE_ASSET(name)
    white (not PED.HAS_ACTION_MODE_ASSET_LOADED(name) and util.current_time_millis() < timeout) do
        util.yield()
    end
    if not PED.HAS_ACTION_MODE_ASSET_LOADED(name) then
        -- body
    end
end

