-- class StreamingAsset: the base of every asset type (ptfx, action_mode, stealth_mode, vehicle).
-- A subclass says how to check and how to ask for its asset; the waiting is here, the same for all:
--
--     local fx = new Atdar.natives.streaming.ptfx.asset("scr_rcbarry2")
--     if fx:request() then ... end     -- asks and waits up to 2000 ms (yields: call from a tick or thread)
--     fx:request(false)                -- only asks, doesn't wait
--     fx:is_loaded()
--
-- A subclass defines:
--   is_loaded(): bool    - whether the game has it in memory
--   send_request(): void - asks the game to load it, without waiting

local class_utils = Atdar.globals.pluto.class

local class StreamingAsset

    -- @param what How the asset is named in the timeout warning, e.g. "ptfx asset 'scr_rcbarry2'"
    function __construct(what: string)
        -- Pluto bug: a subclass declared after an asset was made would look up methods here
        class_utils.fix_index(self)
        self.what = what
    end

    -- State

    function is_loaded(): bool
        error($"[StreamingAsset] {self.what}: is_loaded() isn't defined")
    end

    -- Actions

    function send_request(): void
        error($"[StreamingAsset] {self.what}: send_request() isn't defined")
    end

    -- Asks for the asset and waits until it loads (yields, see streaming.wait_loaded).
    -- timeout false -> only asks, doesn't wait; returns whether it's already loaded
    -- @return Whether it loaded before the timeout (ms)
    function request(timeout: int|bool = 2000): bool
        self:send_request()
        if timeout == false then
            return self:is_loaded()
        end
        return Atdar.natives.streaming.wait_loaded(self.what, || -> self:is_loaded(), timeout)
    end

end

return StreamingAsset
