-- class PtfxAsset extends StreamingAsset: a particle effect asset, by name, e.g. "scr_rcbarry2".
--
--     local fx = new Atdar.natives.streaming.ptfx.asset("scr_rcbarry2")
--     fx:request()
--     fx:remove()                       -- frees it when it's no longer needed
--     new Atdar.natives.streaming.ptfx.asset()   -- no name: the script's default PTFX asset

local StreamingAsset = Atdar.loader.load("natives/streaming/asset")

local class PtfxAsset extends StreamingAsset

    -- name nil -> the script's default PTFX asset
    function __construct(name: ?string)
        if name ~= nil then
            parent:__construct($"ptfx asset '{name}'")
        else
            parent:__construct("default ptfx asset")
        end
        self.name = name
    end

    -- State

    function is_loaded(): bool
        if self.name ~= nil then
            return STREAMING.HAS_NAMED_PTFX_ASSET_LOADED(self.name)
        end
        return STREAMING.HAS_PTFX_ASSET_LOADED()
    end

    -- Actions

    function send_request(): void
        if self.name ~= nil then
            STREAMING.REQUEST_NAMED_PTFX_ASSET(self.name)
            return
        end
        STREAMING.REQUEST_PTFX_ASSET()
    end

    -- Frees the asset when it's no longer needed
    function remove(): void
        if self.name ~= nil then
            STREAMING.REMOVE_NAMED_PTFX_ASSET(self.name)
            return
        end
        STREAMING.REMOVE_PTFX_ASSET()
    end

end

return PtfxAsset
