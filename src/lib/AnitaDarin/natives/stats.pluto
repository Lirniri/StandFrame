-- Player stats (STATS natives)

local module = {}

-- State

function module.is_stats_tracking_enabled(): bool
    return STATS.STAT_IS_STATS_TRACKING_ENABLED()
end

function module.is_recording(): bool
    return STATS.STAT_IS_RECORDING_STAT()
end

-- Or non-flyable area
function module.is_player_vehicle_above_ocean(): bool
    return STATS.STAT_IS_PLAYER_VEHICLE_ABOVE_OCEAN()
end

-- Get

function module.get_block_saves(): bool
    return STATS.STAT_GET_BLOCK_SAVES()
end

function module.get_load_safe_to_progress_to_mp_from_sp(): bool
    return STATS.STAT_GET_LOAD_SAFE_TO_PROGRESS_TO_MP_FROM_SP()
end

-- Returns stat hash based on dataType, statIndex/statId and characterSlot. Related to CStatsMpCharacterMappingData
function module.get_hash_for_character(data_type: int, stat_index: int, char_slot: int): int
    return STATS._GET_STAT_HASH_FOR_CHARACTER_STAT(data_type, stat_index, char_slot)
end

