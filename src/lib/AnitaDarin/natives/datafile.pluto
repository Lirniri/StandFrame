-- Data files and dictionaries (DATAFILE natives: UGC, cloud saves)

local module = {}

-- State

function module.is_valid_request_id(index: int): bool
    return DATAFILE.DATAFILE_IS_VALID_REQUEST_ID(index)
end

function module.has_loaded_file_data(request_id: int): bool
    return DATAFILE.DATAFILE_HAS_LOADED_FILE_DATA(request_id)
end

function module.has_valid_file_data(request_id: int): bool
    return DATAFILE.DATAFILE_HAS_VALID_FILE_DATA(request_id)
end

function module.is_save_pending(): bool
    return DATAFILE.DATAFILE_IS_SAVE_PENDING()
end

-- Get

-- @return A pointer, read it with memory.read_*
function module.get_file_dict(p0: int): int
    return DATAFILE.DATAFILE_GET_FILE_DICT(p0)
end

-- @return A pointer, read it with memory.read_*
function module.get_file_dict_for_additional_data_file(p0: any): int
    return DATAFILE.DATAFILE_GET_FILE_DICT_FOR_ADDITIONAL_DATA_FILE(p0)
end

-- Actions

-- Adds the given requestID to the watch list
function module.watch_request_id(request_id: int): void
    DATAFILE.DATAFILE_WATCH_REQUEST_ID(request_id)
end

function module.clear_watch_list(): void
    DATAFILE.DATAFILE_CLEAR_WATCH_LIST()
end

function module.select_active_file(request_id: int, p1: any): bool
    return DATAFILE.DATAFILE_SELECT_ACTIVE_FILE(request_id, p1)
end

function module.delete_requested_file(request_id: int): bool
    return DATAFILE.DATAFILE_DELETE_REQUESTED_FILE(request_id)
end

-- @param data Pointer: pass memory.alloc(size) and read the result back
function module.ugc_create_content(
    data: int, data_count: int, content_name: string, description: string, tags_csv: string,
    content_type_name: string, publish: bool, p7: any
): bool
