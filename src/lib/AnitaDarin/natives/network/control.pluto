local module = {}

-- State

-- Whether this game controls the entity: online only one player's game does, offline always
function module.has_entity(entity: int): bool
    return NETWORK.NETWORK_HAS_CONTROL_OF_ENTITY(entity)
end

function module.has_id(net_id: int): bool
    return NETWORK.NETWORK_HAS_CONTROL_OF_NETWORK_ID(net_id)
end

function module.has_pickup(pickup: int): bool
    return NETWORK.NETWORK_HAS_CONTROL_OF_PICKUP(pickup)
end

function module.has_door(door_hash: int): bool
    return NETWORK.NETWORK_HAS_CONTROL_OF_DOOR(door_hash)
end

-- Actions

-- Asks the session for control of the entity; it comes later, or not at all
function module.request_entity(entity: int): bool
    return NETWORK.NETWORK_REQUEST_CONTROL_OF_ENTITY(entity)
end

function module.request_id(net_id: int): bool
    return NETWORK.NETWORK_REQUEST_CONTROL_OF_NETWORK_ID(net_id)
end

function module.request_door(door_id: int): bool
    return NETWORK.NETWORK_REQUEST_CONTROL_OF_DOOR(door_id)
end

return module
