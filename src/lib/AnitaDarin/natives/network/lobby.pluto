-- Auto multiplayer lobby flags (LOADINGSCREEN natives)

local module = {}

-- Set

function module.set_auto_multiplayer(toggle: bool): void
    LOADINGSCREEN.LOBBY_SET_AUTO_MULTIPLAYER(toggle)
end

function module.set_auto_multiplayer_event(toggle: bool): void
    LOADINGSCREEN.LOBBY_SET_AUTO_MULTIPLAYER_EVENT(toggle)
end

function module.set_auto_mp_random_job(toggle: bool): void
    LOADINGSCREEN.LOBBY_SET_AUTO_MP_RANDOM_JOB(toggle)
end

-- Actions

function module.auto_multiplayer_menu(): bool
    return LOADINGSCREEN.LOBBY_AUTO_MULTIPLAYER_MENU()
end

function module.auto_multiplayer_freemode(): bool
    return LOADINGSCREEN.LOBBY_AUTO_MULTIPLAYER_FREEMODE()
end

function module.auto_multiplayer_event(): bool
    return LOADINGSCREEN.LOBBY_AUTO_MULTIPLAYER_EVENT()
end

function module.auto_multiplayer_random_job(): bool
    return LOADINGSCREEN.LOBBY_AUTO_MULTIPLAYER_RANDOM_JOB()
end

function module.shutdown_session_clears_auto_multiplayer(toggle: bool): void
    LOADINGSCREEN.SHUTDOWN_SESSION_CLEARS_AUTO_MULTIPLAYER(toggle)
end

return module
