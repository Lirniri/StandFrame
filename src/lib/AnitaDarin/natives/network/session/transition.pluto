local module = {}

function module.get_type()
    local is_private = NETWORK.NETWORK_IS_TRANSITION_PRIVATE()
    local is_closed_crew = NETWORK.NETWORK_IS_TRANSITION_CLOSED_CREW()
    local is_closed_friends = NETWORK.NETWORK_IS_TRANSITION_CLOSED_FRIENDS()
    local is_solo = NETWORK.NETWORK_IS_TRANSITION_SOLO()
    local is_to_game = NETWORK.NETWORK_IS_TRANSITION_TO_GAME()

    if is_private then
        return 1
    end
    if is_closed_crew then
        return 2
    end
    if is_closed_friends then
        return 3
    end
    if is_solo then
        return 4
    end
    if is_to_game then
        return 5
    end

    return 0
end

