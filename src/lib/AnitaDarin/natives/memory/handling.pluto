-- The handling data of a vehicle (the numbers of handling.meta: mass, grip, gears, flight, boat...) read and written
-- in the game's memory by the name of a field. The layout follows Stand-OSS (CHandlingData and its sub handling data), NOT
-- CHECKED IN GAME: when an offset is wrong, the numbers read are nonsense and a write may break the vehicle, so
-- the way back is built in: the first write of a field keeps the old value, reset puts it back (see the holders below).
--
--     local handling = Atdar.natives.memory.handling
--
--     handling.get(vehicle, "mass")                          -- 1500.0, nil when the data or the field isn't there
--     handling.set(vehicle, "drive_bias_front", 0.5)         -- true if it was written
--     handling.set(vehicle, "boat.keel_sphere_size", 0.2)    -- a field of a sub handling data, by its section
--     handling.set_bits(vehicle, "aflags", 1 << 4, true)     -- bits of a flags field
--     handling.reset(vehicle)                                -- every field written here is as it was
--
-- One CHandlingData belongs to every vehicle of a handling name, so a change reaches all of them (and the vehicles
-- spawned after it) until it is given back: the old values are kept by the address of the data, with the models they were
-- changed through (reset_model). Several users can write one field: each is a holder with its own value, the last
-- holder wins, and when a holder lets go the value of the one before it is back, or the original when none is left.
-- Everything is given back when the script stops.
local module = {}

-- The values of eHandlingType: which sub handling data it is
module.HANDLING_TYPE = {
    BIKE = 0,
    FLYING = 1,
    VERTICAL_FLYING = 2,
    BOAT = 3,
    SEAPLANE = 4,
    SUBMARINE = 5,
    TRAIN = 6,
    TRAILER = 7,
    CAR = 8,
    WEAPON = 9,
    SPECIAL_FLIGHT = 10,
}

-- The offsets of the layout that are not fields
module.offsets = {
    sub_array = 0x158,       -- CHandlingData: the atArray of the pointers to the sub handling data { pointer, count (u16), capacity (u16) }
    flying_type = 0xC8,      -- CFlyingHandlingData: its own eHandlingType (flying or vertical flying)
}

-- The most sub handling data that are read: the game has about 3 of them
local MAX_SUBS = 8

-- The holder that writes without naming itself
module.DEFAULT_HOLDER = "user"

-- The sections of fields: "main" is the CHandlingData itself, the others are its sub handling data, by the name of the
-- section. A field is { name, offset, type }: float by default, "int", "uint", "hash", "ubyte" or "vec3" (3 floats)
local SECTIONS = {}

