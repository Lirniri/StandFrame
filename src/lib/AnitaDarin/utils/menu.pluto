-- lib/AnitaDarin/utils/menu.pluto
--
-- Atdar.menu: what a menu file (a pack's or the script's own) builds its menu with, in one place, so a pack
-- needn't know where each part lives in lib.
--
--   Items Stand doesn't have ready-made, made in a Stand ref (a MenuNode's is node.handle):
--     Atdar.menu.spoiler(ref, "Address", "Vinewood 12")       -- a line that hides its value until clicked
--     Atdar.menu.color(ref, "Color", { "color" }, "", { r = 1, g = 0, b = 0 }, on_change)
--
--   The parts of the script's own menu, each loaded the first time it's asked for:
--     Atdar.menu.Node        MenuNode: new Atdar.menu.Node(ref) wraps a Stand ref (ui/stand/core/menu_node)
--     Atdar.menu.builder     builder.build_items(node, items): a submenu written as a table (menu_builder)
--     Atdar.menu.confirm     confirm.action(node, name, again_name, on_confirm): a button that acts on a
--                            second click (ui/stand/core/confirm)
--     Atdar.menu.settings    the script's own section: set_parent, set_divider, set_name, add (ui/stand/core/settings)
--     Atdar.menu.commands    command names with the profile's prefix: names, track (ui/stand/core/commands)
--     Atdar.menu.arguments   a field for each parameter of a function, by its type (ui/stand/core/arguments)
--     Atdar.menu.modules     modules.list_in(node), modules.module_in(node, name): the Modules list in any menu
--     Atdar.menu.clicks      clicks.is_user_action(click_type): whether a handler's call is the user's

local module = {}

-- Where each part is in lib
local PARTS = {
    Node = "ui/stand/core/menu_node",
    builder = "ui/stand/core/menu_builder",
    confirm = "ui/stand/core/confirm",
    settings = "ui/stand/core/settings",
    commands = "ui/stand/core/commands",
    arguments = "ui/stand/core/arguments",
    modules = "ui/stand/modules/place",
    clicks = "ui/logic/stand/clicks",
}

-- A part is loaded when it's first asked for and kept: this file loads before the profile and the features
-- the parts need. A name that is no part stays nil, so a typo isn't hidden
setmetatable(module, {
    __index = function(self, key)

        local path = PARTS[key]

        if path == nil then
            return nil
        end

        local part = Atdar.loader.load(path)

        rawset(self, key, part)

        return part
    end,
})

-- A spoiler: a line that hides its value until clicked; another click hides it again.
--
--     Atdar.menu.spoiler(root, "AnitaDarin", "Hello!")   -- "AnitaDarin: Hidden", after a click "AnitaDarin: Hello!"
--
-- @param value What is hidden
-- @param hidden_text Shown in place of the value while it's hidden
-- @return The command
function module.spoiler(parent, menu_name: string, value: string = "", hidden_text: string = "Hidden", help_text: string = "")
    local shown = false
    local ref
    ref = menu.action(parent, $"{menu_name}: {hidden_text}", {}, help_text, function()
        shown = not shown
        if shown then
            menu.set_menu_name(ref, $"{menu_name}: {value}")
            return
        end
        menu.set_menu_name(ref, $"{menu_name}: {hidden_text}")
    end)
    return ref
end

-- A colour picker: the same submenu as Stand's own colours (HSV, RGB, hex code, copy),
-- without the Opacity part unless transparency is on.
--
--     Atdar.menu.color(root, "Background Color", { "atdarbg" }, "", { r = 0, g = 0, b = 0 }, function(colour)
--         -- colour.r, colour.g, colour.b, colour.a: 0.0 - 1.0
--     end, true)
--
-- @param default { r, g, b, a }, each from 0.0 to 1.0; no a -> opaque
-- @param on_change Called with the colour ({ r, g, b, a }; without transparency a is always 1.0) and the click type
-- @param transparency Adds Opacity, as in Stand's own colours
-- @return The command
function module.color(parent, menu_name: string, command_names: table, help_text: string, default: table, on_change,
        transparency: bool = false)
    local alpha = 1.0
    if transparency and default.a ~= nil then
        alpha = default.a
    end
    local colour = { r = default.r, g = default.g, b = default.b, a = alpha }
    return menu.colour(parent, menu_name, command_names, help_text, colour, transparency, on_change)
end

return module
