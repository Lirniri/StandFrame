local module = {}

function module.delete(command, reset_to_default: bool): void
    if reset_to_default then
        menu.default_and_delete(command)
    else
        menu.delete(command)
    end
end

function module.attach(parent, command, type: int|string): void
    switch type do
        case 1:
        case "after":
            menu.attach_after(parent, command)
            break
        case 2:
        case "before":
            menu.attach_before(parent, command)
            break
        default:
            menu.attach(parent, command)
    end
end

return module