local Logger = Atdar.loader.load("core/logger")

local log = new Logger("AirControl")

-- Steering of a plain fall (no ragdoll, no parachute) the way Stand's own Graceland does it: not by a native, by
-- the flags inside the game's fall task. Stand-OSS hooks the task and adds 0x11C00 to its flags: 0xC00 can turn in
-- the air (no natural-motion fall, air control), 0x1000 damps the vertical speed, 0x10000 is the landing of the beast.
-- The names are those of a comment in that source, not checked against the game.
--
--     local air = Atdar.util.game.players.user.air_control
--
--     air.enable()
--     air.set_flags(air.AIR_CONTROL)   -- only the steering, without the damping and the landing
--     air.disable()
--
-- The flags are written from the memory (Atdar.natives.memory.ped), once per frame to the fall task of the local player,
-- where Stand does it on each update of the task: it can be late by a frame. If the offsets of the memory belong to
-- another build of the game, nothing is found and nothing is written: look at the log (debug) and describe()
local module = {}

module.AIR_CONTROL = Atdar.natives.memory.ped.FALL_FLAG.AIR_CONTROL
module.DAMP_Z = Atdar.natives.memory.ped.FALL_FLAG.DAMP_Z
module.BEAST_FALL = Atdar.natives.memory.ped.FALL_FLAG.BEAST_FALL

-- flags: the bits of the steering and the damping; beast_fall: whether the bit of the animation of the beast's fall
-- (BEAST_FALL) is put on top of them, a setting of its own
local settings = {
    flags = module.AIR_CONTROL | module.DAMP_Z,
    beast_fall = true,
    debug = false,
}

-- Whether it's on, which run of the tick handler is the wanted one, the bits it put in the fall that goes now (to take
-- them out again), whether that fall is told in the log yet
local state = { enabled = false, run = 0, added = 0, in_fall = false, fall_start = 0, probe_index = nil }

-- The search for the bit of an animation (probe_bits), nil when it is not on: { seconds, first, last }
local probe = nil

-- Whether it's on
function module.is_enabled(): bool
    return state.enabled
end

-- Settings

-- Which bits are put in the flags of the fall task besides the animation of the beast (set_beast_fall): module.AIR_CONTROL
-- and DAMP_Z by default, one or together (AIR_CONTROL | DAMP_Z). BEAST_FALL given here is taken out of it: it is
-- switched with set_beast_fall
function module.set_flags(flags: int): void
    settings.flags = flags & ~module.BEAST_FALL
end

-- Whether the fall has the animation of the beast's fall (the arms out, BEAST_FALL, 0x10000 of Stand's 0x11C00), on by
-- default; off: only the steering and the damping. It can be changed in the middle of a fall: the bit is put or taken out
function module.set_beast_fall(toggle: bool): void
    settings.beast_fall = toggle
end

-- The bits that are put in the fall now
local function wanted_bits(): int

    if settings.beast_fall then
        return settings.flags | module.BEAST_FALL
    end

    return settings.flags
end

-- Whether the flags before and after are written to the log in each fall
function module.set_debug(toggle: bool): void
    settings.debug = toggle
end

-- A way to find what a bit of the fall task does (the animation of the beast's fall did not come with BEAST_FALL): in each
-- fall from now, one bit of the flags at a time is put on on top of the wanted ones, from first to last, each for
-- the seconds, and the log says which bit is on at the moment (debug on): fall from high up and watch the animation, the
-- time of the log line when it changes tells the bit. A bit that is wanted already is skipped. It stops by itself after the last bit
-- @param seconds How long a bit is on, 1.5 by default
-- @param first The number of the first bit (0 is 0x1, 16 is 0x10000), 0 by default
-- @param last The number of the last bit, 31 by default
function module.probe_bits(seconds: number = 1.5, first: int = 0, last: int = 31): void
    probe = { seconds = math.max(seconds, 0.2), first = math.max(first, 0), last = math.min(last, 31) }
    state.probe_index = nil
end

-- Stops the search for a bit
function module.stop_probe(): void
    probe = nil
    state.probe_index = nil
end

-- The bit that is the probe's at the moment of this fall, 0 when it is not on or is over
local function probe_bit(): int

    if probe == nil then
        return 0
    end

    local index = probe.first + math.floor((util.current_time_millis() - state.fall_start) / (probe.seconds * 1000))

    if index > probe.last then
        return 0
    end

    if index ~= state.probe_index then
        state.probe_index = index

        local digits = string.format("%X", 1 << index)

        log:debug($"probe: bit {index} (0x{digits}) is on")
    end

    return 1 << index
end

-- Get

-- The tasks of the local player now (their numbers from the root), what to look at when nothing happens
function module.describe(): string
    return Atdar.natives.memory.task.describe(Atdar.natives.player.get_ped_id())
end

local function hex(value: int): string
    return string.format("%X", value)
end

-- One frame
local function tick(): void

    local mem_ped = Atdar.natives.memory.ped
    local ped = Atdar.natives.player.get_ped_id()
    local flags = mem_ped.get_fall_flags(ped)

    if flags == nil then
        state.in_fall = false
        state.added = 0
        state.probe_index = nil
        return
    end

    if not state.in_fall then
        state.in_fall = true
        state.fall_start = util.current_time_millis()

        if settings.debug then
            log:debug($"fall task found, flags {hex(flags)}")
        end
    end

    -- The bits that are put in: the wanted ones and the one of the search
    local wanted = wanted_bits() | probe_bit()

    -- A bit this put in that is not wanted any more (the animation switched off in the fall, the search went on) is taken out
    local unwanted = state.added & ~wanted

    if unwanted ~= 0 then
        flags = flags & ~unwanted
        state.added = state.added & ~unwanted
        mem_ped.set_fall_flags(ped, flags)
    end

    if flags & wanted == wanted then
        return
    end

    state.added = state.added | (wanted & ~flags)
    mem_ped.set_fall_flags(ped, flags | wanted)

    if settings.debug then
        log:debug($"flags {hex(flags)} -> {hex(flags | wanted)}")
    end
end

-- Takes out the bits it put in the fall that goes on now
local function release(): void

    local ped = Atdar.natives.player.get_ped_id()

    if state.added ~= 0 then
        Atdar.natives.memory.ped.remove_fall_flags(ped, state.added)
    end

    state.added = 0
    state.in_fall = false
end

-- Actions

-- Switches it on. A second call does nothing
function module.enable(): void

    if state.enabled then
        return
    end

    state.enabled = true
    state.run += 1

    -- The offsets that have a signature are read from the game's code first (none have yet)
    for name, found in pairs(Atdar.natives.memory.task.resolve()) do

        if found then
            log:debug($"offset {name}: read from the code")
        else
            log:debug($"offset {name}: not found, the default stays")
        end
    end

    local run = state.run

    util.create_tick_handler(function()

        if not state.enabled or state.run ~= run then
            return false
        end

        local ok, err = pcall(tick)

        if not ok then
            log:error($"air control stopped\n{err}")
            state.enabled = false
            return false
        end

        return true
    end)
end

-- Switches it off, and takes the bits out of the fall that goes on
function module.disable(): void

    if not state.enabled then
        return
    end

    state.enabled = false
    pcall(release)
end

util.on_stop(function()
    if state.enabled then
        module.disable()
    end
end)

return module
