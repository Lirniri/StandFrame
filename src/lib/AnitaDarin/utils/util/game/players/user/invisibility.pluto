-- The player's ped is invisible (Stand's Invisibility): every frame it is hidden, and told to stay visible to the player
-- himself (so he sees himself in the network session, where the game would hide him as well). Visible again at disable.
--
--     local hidden = Atdar.util.game.players.user.invisibility
--
--     hidden.enable()
--     hidden.disable()
local ticker = Atdar.util.game.players.user.ticker

-- Whether the player sees his own ped while it's invisible to the others (off by default)
local is_local_visible = false

local function tick(): void

    local ped = Atdar.natives.player.get_ped_id()

    Atdar.natives.entity.set_visible(ped, false, false)
    if is_local_visible then
        Atdar.natives.network.set_entity_locally_visible(ped)
    end
end

local function release(): void
    Atdar.natives.entity.set_visible(Atdar.natives.player.get_ped_id(), true, false)
end

local module = ticker.make("Invisibility", tick, release)

-- Whether he still sees himself in a network session, where the game would hide him as well. Any time, before or after enable()
function module.set_local_visible(toggle: bool): void
    is_local_visible = toggle
end

return module
