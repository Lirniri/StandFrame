local i18n = Atdar.loader.load("core/i18n")

local module = {}

-- Wrappers over core/i18n

-- Stand label for menu items (names, help texts): shown in Stand's language, saved in English in profiles
function module.translate(key: string, fallback: ?string = nil): int
    return i18n.label(key, fallback)
end

-- Ready text in Stand's current language, for strings built from parts
function module.text(key: string, fallback: ?string = nil): string
    return i18n.text(key, fallback)
end

-- Stand's current language code ("en", "ru", ...)
function module.get_language(): string
    return lang.get_current()
end

function module.get_key(key: string)
    return i18n.get(key)
end

return module
