local module = {}

-- How a game notification is posted: plain text, or a message card with a picture, sender and subject
local POST = {
    ticker = function(thefeed, message: string, opts: table)
        return thefeed.post_ticker(message, opts.important == true)
    end,
    message = function(thefeed, message: string, opts: table)
        return thefeed.post_message(message, {
            sender = opts.sender or Atdar.name,
            subject = opts.subject,
            picture = opts.picture,
            icon = opts.icon,
            important = opts.important,
        })
    end,
}

-- Shows a message to the user in the configured way.
-- opts.target: "stand" | "game" (the game's feed) | "none" (default: the profile's notify, then "stand")
-- opts.style for "game": "ticker" (default) | "message" with opts.sender, opts.subject, opts.picture, opts.icon
-- @return The FeedPost for "game" (post:remove() takes it away), otherwise nil
function module.toast(message: string, opts: table = {}): ?table
    local profile = Atdar.profile
    local target = opts.target or (profile and profile.get and profile.get("notify")) or "stand"

    if target == "stand" then
        util.toast(message)
    elseif target == "game" then
        local style = opts.style or "ticker"
        local post = POST[style]
        if not post then
            error($"[util.toast] unknown style '{style}', expected ticker or message")
        end
        return post(Atdar.natives.visual.hud.thefeed, message, opts)
    end
    return nil
end

-- Model name -> hash; a number is taken as a hash already
function module.hash(name_or_hash: int|string, reverse: bool = false): int
    if reverse then
        if type(name_or_hash) == "string" then
            return util.reverse_joaat(name_or_hash)
        end
    else
        if type(name_or_hash) == "string" then
            return util.joaat(name_or_hash)
        end
    end
    return name_or_hash
end

function module.uhash(hash: string): int
    return util.ujoaat(hash)
end

return module
