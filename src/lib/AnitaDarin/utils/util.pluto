local color = Atdar.loader.load("utils/color")
local Logger = Atdar.loader.load("core/logger")
local hud_text = Atdar.loader.load("natives/visual/hud/text")

-- The subject colour "level": by the notification's type
local LEVEL_COLORS = { INFO = "blue", WARN = "yellow", ERROR = "red" }

-- The subject with the profile's colour code for the time of day in front ("~y~Warning")
-- @param period "day" or "night"
local function colored_subject(subject: string, level: ?string, period: string): string
    local name = Atdar.profile and Atdar.profile.get and Atdar.profile.get($"notify_subject_color_{period}") or "default"
    if name == "level" then
        name = LEVEL_COLORS[level] or "default"
    end
    local code = hud_text.COLOR[name]
    if code == nil or name == "default" then
        return subject
    end
    return code .. subject
end
local texture_dict = Atdar.loader.load("natives/streaming/texture_dict/asset")

local module = {}

-- Stopping: Atdar.leaving (see toast)
util.on_stop(function() Atdar.leaving = true end)

-- A profile value, or nil before the profile has loaded (early errors)
local function setting(key: string)
    local profile = Atdar.profile
    if not (profile and profile.get) then
        return nil
    end
    return profile.get(key)
end

-- Who a message card is from: the profile's Display Name; Atdar.name (the script's file name)
-- only before the profile has loaded or while the name is empty
local function sender_name(): string
    local name = setting("display_name")
    if type(name) ~= "string" or name == "" then
        return Atdar.name
    end
    return name
end

-- How a game notification is posted: plain text, or a message card with a picture, sender and subject
local POST = {
    ticker = function(thefeed, message: string, opts: table, flash: bool, period: string)
        return thefeed.post_ticker(message, flash)
    end,
    message = function(thefeed, message: string, opts: table, flash: bool, period: string)
        local picture = opts.picture or setting("notify_feed_picture") or "CHAR_ACTING_UP"
        -- Asked without waiting: toast can't wait here. The menu asks for the profile's picture
        -- at the start and when it's picked, so it's loaded by the time a card shows
        pcall(texture_dict.request, picture, false)
        -- From the logger: the level goes to the subject, the card's text is the message alone
        local subject = opts.subject
        if subject == nil and opts.level ~= nil then
            subject = Logger.level_title(opts.level)
        end
        if subject ~= nil and subject ~= "" then
            subject = colored_subject(subject, opts.level, period)
        end
        return thefeed.post_message(opts.text or message, {
            sender = opts.sender or sender_name(),
            subject = subject,
            picture = picture,
            icon = opts.icon or thefeed.ICON[setting("notify_feed_icon") or ""],
            important = flash,
        })
    end,
}

-- A colour saved as hex in the profile -> r, g, b, a 0 - 255, or nil when it's "" (the game's own)
local function game_color(key: string)
    local colour = color.from_hex(setting(key) or "")
    if not colour then
        return nil
    end
    return color.to_game(colour)
end

-- "day" or "night" by the game's clock and the profile's hours: the suffix of the colour keys
local function time_of_day(): string
    local day_start = setting("notify_day_start") or 7
    local night_start = setting("notify_night_start") or 19
    if Atdar.natives.world.time.is_between(day_start, night_start) then
        return "day"
    end
    return "night"
end

-- Posts to the game's feed, looking the way the profile says unless opts says otherwise
local function post_to_feed(message: string, opts: table): int
    local style = opts.style or setting("notify_feed_style") or "ticker"
    local post = POST[style]
    if not post then
        error($"[util.toast] unknown style '{style}', expected ticker or message")
    end

    local flash = setting("notify_flash") == true
    if opts.important ~= nil then
        flash = opts.important == true
    end

    local thefeed = Atdar.natives.visual.hud.thefeed
    local period = time_of_day()
    local r, g, b, a = game_color($"notify_background_{period}")
    if r then
        thefeed.set_next_background_color(r, g, b, a)
    end
    if flash then
        local fr, fg, fb, fa = game_color($"notify_flash_color_{period}")
        if fr then
            thefeed.set_next_flash_color(fr, fg, fb, fa)
        end
    end
    return post(thefeed, message, opts, flash, period)
end

-- Shows a message to the user in the configured way.
-- opts.target: "stand" | "game" (the game's feed) | "none" (default: the profile's notify, then "stand")
-- For "game" the profile's look is used (notify_feed_style, notify_flash, day/night colours); opts can override:
--   opts.style "ticker" | "message" with opts.sender, opts.subject, opts.picture (default the profile's
--   notify_feed_picture), opts.icon; opts.important (flash).
--   From the logger: opts.level ("INFO", "WARN", "ERROR") - a card's subject, its name in the script's
--   language; opts.text - the card's text instead of the whole log line
-- @return The post's id for "game" (thefeed.remove(id) takes it away), otherwise nil
function module.toast(message: string, opts: table = {}): ?int
    local target = opts.target or setting("notify") or "stand"
    -- While the script is leaving (deleted, renamed, stopping) nothing goes to the game's feed: posting
    -- calls the game with texts and pictures, and doing that as the script goes away crashed the game.
    -- Stand's own notification is plain text
    if target == "game" and Atdar.leaving then
        target = "stand"
    end
    if target == "stand" then
        util.toast(message)
    elseif target == "game" then
        -- A paused feed (cutscenes, the pause menu, loading, a script that paused it) shows nothing:
        -- the notification goes to Stand then, so it isn't lost
        local paused_ok, paused = pcall(Atdar.natives.visual.hud.thefeed.is_paused)
        if paused_ok and paused then
            util.toast(message)
            return nil
        end
        return post_to_feed(message, opts)
    end
    return nil
end

-- Model name -> hash; a number is taken as a hash already
function module.hash(name_or_hash: int|string, reverse: bool = false): int
    if reverse then
        if type(name_or_hash) == "string" then
            return util.reverse_joaat(name_or_hash)
        end
    else
        if type(name_or_hash) == "string" then
            return util.joaat(name_or_hash)
        end
    end
    return name_or_hash
end

function module.uhash(hash: string): int
    return util.ujoaat(hash)
end

return module
