local module = {}

-- How a game notification is finished: plain text, or a message card with a picture, sender and subject
local END_POST = {
    ticker = function(hud, opts: table)
        return hud.thefeed["end"].post_ticker(opts.important == true, true, false)
    end,
    message = function(hud, opts: table)
        local picture = opts.picture or "CHAR_SOCIAL_CLUB"
        return hud.thefeed["end"].post_message(opts.sender or Atdar.name, opts.subject or "",
            opts.important == true, opts.icon or 1, picture, picture)
    end,
}

-- Shows a message to the user in the configured way.
-- opts.target: "stand" | "game" | "none" (default: Atdar.settings.notify, then "stand")
-- opts.style for "game": "ticker" (default) | "message" with opts.sender, opts.subject, opts.picture, opts.icon
-- @return Feed item id for "game", pass it to thefeed.remove()
function module.toast(message: string, opts: table = {}): ?int
    local settings = Atdar.settings
    local target = opts.target or (settings and settings.notify) or "stand"

    if target == "stand" then
        util.toast(message)
    elseif target == "game" then
        local style = opts.style or "ticker"
        local end_post = END_POST[style]
        if not end_post then
            error($"[util.toast] unknown style '{style}', expected ticker or message")
        end
        local hud = Atdar.natives.visual.hud
        hud.thefeed.begin.post()
        hud.text.add_string(message)
        return end_post(hud, opts)
    end
    return nil
end

-- Model name -> hash; a number is taken as a hash already
function module.hash(name_or_hash: int|string): int
    if type(name_or_hash) == "string" then
        return util.joaat(name_or_hash)
    end
    return name_or_hash
end

function module.uhash(hash: int|string): int
    return util.ujoaat(hash)
end

return module
