local module = {}

-- Sends a notification using the configured target or an explicit one (stand | game | none)
function module.toast(message, target: ?string)
    -- Atdar.logger:send_text(message, target or Atdar.settings.notify)
end

function module.snap_to_ground(coords: vector3, max_height: number|bool = 1.3): vector3
    local found, ground_z = util.get_ground_z(coords.x, coords.y, coords.z)
    
    if max_height == false then
        if found and (coords.z - ground_z) >= 0 then
            coords.z = ground_z
        end
    else
        if found and (coords.z - ground_z) <= max_height then
            coords.z = ground_z
        end
    end

    return coords
end

function module.half_godmode(player_id: int, toggle: bool = true)
    local player = player_id
    PLAYER.SET_PLAYER_INVINCIBLE_BUT_HAS_REACTIONS(player, toggle)
end


return module
