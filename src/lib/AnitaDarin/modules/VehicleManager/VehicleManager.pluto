local Module = Atdar.loader.load("core/module")

-- The folder saved vehicles go to, inside the module's
local SAVE_FOLDER = "vehicles"

-- What's saved of a vehicle: { handle, model, name (when Stand knows it), x, y, z, heading }.
-- The handle is the one the game gave it this session: the game gives a new one when it's spawned again
local function vehicle_data(handle: int): table
    local n_entity = Atdar.natives.entity
    local model = n_entity.get_model(handle)
    local coords = ENTITY.GET_ENTITY_COORDS(handle, true)
    local data = { handle = handle, model = model, x = coords.x, y = coords.y, z = coords.z, heading = n_entity.get_heading(handle) }
    local name = util.reverse_joaat(model)
    if name ~= nil and name ~= "" then
        data.name = name
    end
    return data
end

local class VehicleManager extends Module
    
    function __construct(ped: int = 0)
        parent:__construct({
            name = "VehicleManager",
            -- Inside the options: a bare `debug = ...` here would replace Lua's debug library for the whole script
            debug = {
                hide = {
                    "_free_name"
                }
            }
        })
        -- State lives in fields; set defaults here
        self.ped_id = ped 

        self.last_handle = -1
        self.auto_remember = false

        self.vehicles = {}
    end

    -- The vehicle the player is in at the start is remembered a frame later (on_tick): the natives it needs
    -- aren't loaded while the script starts
    function on_start()
        self.current_vehicle = 0
        self.__ticked = false
    end

    -- Remembers every vehicle the player gets into
    function on_tick()
        -- Stand runs the first tick right away, while the script is still starting: skipped, so the
        -- natives load a frame later, not in the start's time
        if not self.__ticked then
            self.__ticked = true
            return
        end

        -- State
        if not self:is_last_exist() then
            self:remove_last_vehicle()
        end

        if self:is_auto_remember() then
            self:_remember_current_vehicle()
        end

    end

    function on_stop()
        -- body
    end

    -- Is

    function is_ped_exist(): bool
        local n_ped = Atdar.natives.entity.ped
        return n_ped.does_exist(self:get_ped_id())
    end

    -- Whether the vehicle remembered last is still in the game
    function is_last_exist(): bool
        local handle = self:get_handle()
        if handle == nil then
            return false
        end
        return Atdar.natives.entity.vehicle.does_exist(handle)
    end

    function is_auto_remember(): bool
        return self.auto_remember
    end

    -- Get

    -- The ped the manager looks at: the one given to set_ped_id, or the player's own when none is set (0)
    function get_ped_id(): int
        if self.ped_id ~= 0 then
            return self.ped_id
        end
        return Atdar.natives.player.get_ped_id()
    end

    -- The last vehicle remembered (add_vehicle), or nil if there's none
    function get_handle(): ?int
        if self.last_handle == -1 then
            return nil
        end
        return self.last_handle
    end

    -- Every vehicle remembered, as a list of handles
    function get_handles(): table
        local handles = {}
        for handle in pairs(self.vehicles) do
            table.insert(handles, handle)
        end
        return handles
    end

    -- Set

    -- The ped the manager looks at; only a whole number (a handle), like add_vehicle takes
    function set_ped_id(ped: int): void
        if math.type(ped) ~= "integer" then
            self.log:warn(self:text("not_ped", "'%s' isn't a ped's handle, not set"):format(tostring(ped)))
            return
        end
        self.ped_id = ped
    end

    function set_auto_remember(toggle: bool): void
        self.auto_remember = toggle
    end

    -- Remembers a vehicle the script made or the player got into
    function add_vehicle(handle: int): void
    -- Only a real handle: a whole number, not -1 / 0 ("none" from Stand and from the game's natives).
    -- Anything else (a function, a text typed in the menu) would break every function reading the table
        if math.type(handle) ~= "integer" or handle == -1 or handle == 0 then
            self.log:warn(self:text("not_handle", "'%s' isn't a vehicle's handle, not remembered"):format(tostring(handle)))
            return
        end
        self.vehicles[handle] = true
        self.last_handle = handle
    end

    -- Forgets a vehicle
    function remove_vehicle(handle: int): void
        self.vehicles[handle] = nil
        if self.last_handle == handle then
            self.last_handle = nil
        end
    end
    -- Forgets the vehicle remembered last (only from the table: the vehicle stays in the game)
    function remove_last_vehicle(): void
        if self.last_handle == nil then
            return
        end
        self:remove_vehicle(self.last_handle)
    end
    -- Forgets all vehicles
    function remove_all_vehicles(): void
        self.vehicles = {}
        self.last_handle = nil
    end

    -- Actions

    -- The vehicle the player sits in, remembered once when they get into it (not every frame they stay).
    -- self.current_vehicle: the one they were in last time, 0 - none
    function _remember_current_vehicle(): void
        local ped = self:get_ped_id()
        local vehicle = Atdar.natives.entity.ped.vehicle.get(ped)
        
        if vehicle == self.current_vehicle then
            return
        end

        self.current_vehicle = vehicle
        if vehicle ~= 0 and self.vehicles[vehicle] == nil then
            self:add_vehicle(vehicle)
            self.log:debug($"remembered the vehicle the player got into: {vehicle}")
        end
    end

    -- Repairs a vehicle (natives entity.vehicle.repair): damage and dents gone, full health, drivable
    -- @param dirt_level A number - the dirt it gets (0.0 - 15.0); true - washed clean; nothing - the dirt stays
    -- @return Whether it was a vehicle in the game
    function repair(handle: int, dirt_level: float|bool, start_engine: bool): bool
        if math.type(handle) ~= "integer" then
            return false
        end

        return Atdar.util.game.entity.vehicle.repair(handle, dirt_level or false, start_engine)
    end

    -- Repairs the vehicle remembered last
    -- @return Whether there was one in the game
    function repair_last(dirt_level: float|bool, start_engine: bool): bool
        return self:repair(self:get_handle(), dirt_level, start_engine)
    end

    -- Repairs every remembered vehicle still in the game
    -- @return How many were repaired
    function repair_all(dirt_level: float|bool, start_engine: bool): int
        local repaired = 0

        for _, handle in ipairs(self:get_handles()) do
            if self:repair(handle, dirt_level, start_engine) then
                repaired += 1
            end
        end

        return repaired
    end

    -- Explodes a vehicle
    -- @return Whether it was exploded (one already gone or already dead is left alone)
    function explode(handle: int): bool
        if math.type(handle) ~= "integer" then
            return false
        end

        local n_vehicle = Atdar.natives.entity.vehicle
        if not n_vehicle.does_exist(handle) then
            return false
        end

        if n_vehicle.is_destroyed(handle) then
            return false
        end

        n_vehicle.explode({
            vehicle = handle,
            net_id = n_vehicle.get_net_id(handle)
        })
        return true
    end

    -- Explodes the vehicle remembered last
    -- @return Whether there was one in the game
    function explode_last(): bool
        return self:explode(self:get_handle())
    end

    -- Explodes every remembered vehicle still in the game
    -- @return How many were exploded
    function explode_all(): int
        
        local exploded = 0

        for _, handle in ipairs(self:get_handles()) do
            if self:explode(handle) then
                exploded += 1
            end
        end

        return exploded
    end

    -- Spawns a vehicle and remembers it. By default 5 m in front of the player, facing where the player faces.
    -- Yields while the model loads: call it from a feature's action or a tick, not the script's main body
    -- @param model A model name ("adder") or hash
    -- @param coords Where (a vector3); nil - in front of the player
    -- @param heading Which way it faces; nil - the player's way
    -- @return The vehicle's handle, or nil if the model isn't a vehicle, didn't load or the game made none
    function create(model: int|string, coords: ?vector3, heading: ?float): ?int
        local n_vehicle = Atdar.natives.entity.vehicle
        local hash = Atdar.util.hash(model)
        if not n_vehicle.is_model(hash) then
            self.log:warn(self:text("not_model", "'%s' isn't a vehicle model"):format(tostring(model)))
            return nil
        end

        -- The game makes a vehicle only of a loaded model (a timeout is logged by streaming)
        local model_asset = Atdar.natives.streaming.model.asset
        if not model_asset.request(hash) then
            return nil
        end

        local ped = self:get_ped_id()
        if coords == nil then
            coords = v3.new(ENTITY.GET_OFFSET_FROM_ENTITY_IN_WORLD_COORDS(ped, 0.0, 5.0, 0.0))
        end
        if heading == nil then
            heading = Atdar.natives.entity.get_heading(ped)
        end

        local handle = n_vehicle.create(hash, coords.x, coords.y, coords.z, heading)
        -- Made: the game may let the model go from memory now
        model_asset.remove(hash)
        if handle == nil or handle == -1 then
            self.log:warn(self:text("not_made", "The game made no '%s'"):format(tostring(model)))
            return nil
        end

        self:add_vehicle(handle)
        return handle
    end

    -- Deletes a vehicle from the game and forgets it
    -- @return Whether it was deleted (one already gone is only forgotten)
    function delete(handle: int): bool
        if math.type(handle) ~= "integer" then
            return false
        end

        self:remove_vehicle(handle)

        local n_vehicle = Atdar.natives.entity.vehicle

        if not n_vehicle.does_exist(handle) then
            return false
        end
        return n_vehicle.delete(handle)
    end

    function delete_last(): bool
        return self:delete(self:get_handle())
    end

    -- Deletes every remembered vehicle from the game and forgets them
    -- @return How many were deleted (ones already gone are only forgotten)
    function delete_all(): int
        local deleted = 0

        for _, handle in ipairs(self:get_handles()) do
            if self:delete(handle) then
                deleted += 1
            end
        end

        return deleted
    end

    -- Saving

    -- Saves one vehicle to its own file in the module's vehicles folder (modules/VehicleManager/vehicles/):
    -- the model, where it stands and which way it faces, enough to spawn it again with create().
    -- @param name The file's name; nil - the model's name, with _2, _3... when that one is taken
    -- @return The file's name (without .json), nil if the vehicle doesn't exist or the file couldn't be written
    function save_vehicle(handle: int, name: ?string): ?string
        if math.type(handle) ~= "integer" or not Atdar.natives.entity.does_exist(handle) then
            self.log:warn(self:text("not_in_game", "%s isn't a vehicle in the game"):format(tostring(handle)))
            return nil
        end

        local data = vehicle_data(handle)

        local file_name = name
        if file_name == nil or file_name == "" then
            file_name = self:_free_name(data.name or $"vehicle_{data.model}")
        end

        -- Characters Windows doesn't allow in a file's name
        file_name = file_name:gsub('[<>:"/\\|?*]', "_")

        local file = self:json_file($"{SAVE_FOLDER}/{file_name}")
        if file == nil then
            self.log:warn(self:text("no_folder", "The module isn't loaded from a file: there's no folder to save to"))
            return nil
        end

        if not file:write(data) then
            self.log:warn(self:text("not_written", "Couldn't write %s"):format(file.path))
            return nil
        end

        self.log:info(self:text("saved", "Saved to %s"):format(file.path))
        return file_name
    end

    -- Saves every remembered vehicle that still exists, each to its own file (save_vehicle)
    -- @return How many were saved
    function save_vehicles(): int
        local saved = 0

        for handle in pairs(self.vehicles) do
            if math.type(handle) == "integer"
                and Atdar.natives.entity.does_exist(handle)
                and self:save_vehicle(handle) ~= nil then
                saved += 1
            end
        end

        return saved
    end

    -- "adder", or "adder_2", "adder_3"... when the file is there already
    function _free_name(base: string): string
        local name = base
        local number = 1

        while self:json_file($"{SAVE_FOLDER}/{name}"):exists() do
            number += 1
            name = $"{base}_{number}"
        end

        return name
    end

end

return Atdar.modules.add(new VehicleManager())