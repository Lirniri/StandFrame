-- TEST MODULE (delete the modules/test folder when done)
-- Checks: a missing dependency. Must NOT start: expect one error notification
-- "needs module 'test.missing', which isn't registered", while the other test modules still start

local Module = Atdar.loader.load("core/module")

return Atdar.modules.add(new Module({
    name = "test.broken_dep",
    deps = { "test.missing" },

    on_start = function(self)
        self.log:notify("this must never show")
    end,
}))
