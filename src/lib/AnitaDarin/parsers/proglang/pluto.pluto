-- lib/AnitaDarin/parsers/proglang/pluto.pluto
--
-- Parsers of Pluto, the script's language, each in parsers/proglang/pluto/, loaded on first use:
--   args   - arguments typed as in a call: parse() works them out, split() only cuts them
--   name   - the words of a name in code: words("getHandle")
--   source - what the source says and the running code doesn't keep: return_type(fn)
--
--     Atdar.parsers.proglang.pluto.source.return_type(fn)

local module = {}

return Atdar.loader.auto(module, "parsers/proglang/pluto")
