-- lib/AnitaDarin/parsers/proglang/pluto/source.pluto
--
-- What the running code doesn't keep but its source file says: a function's return type and the types of its
-- parameters. Type hints are gone once Pluto compiles the code, so they're read from the file, at the line
-- debug.getinfo gives for the function.
-- Stand's natives (util.require_natives) have their types in comments instead, which are read the same way:
--     PLAYER_PED_ID=--[[Ped (int)]] function()...      -- returns "int"
--     WAIT=--[[void]] function(--[[int]] ms)...         -- returns "void", ms is "int"
--
--     Atdar.parsers.proglang.pluto.source.return_type(Atdar.natives.entity.vehicle.repair)  -- "bool"
--     Atdar.parsers.proglang.pluto.source.param_types(Atdar.natives.entity.vehicle.repair)  -- { vehicle = "int" }
--     Atdar.parsers.proglang.pluto.source.param_defaults(fn)  -- "function f(a: int = 5)" -> { a = "5" }

-- A value of the wrong kind is the caller's mistake (core/check); text that can't be read isn't one -
-- that's what a parser is for
local expect = Atdar.loader.load("core/check").expecter("parsers/proglang/pluto/source")

local module = {}

-- File path -> { text = the text, lines = its lines }; split again only when the text is another
local source_lines = {}

-- The lines a function's line numbers belong to. A module file: the text its running code was read
-- from (core/module_manager), so an edit or a Reload never leaves them pointing at other lines. Any
-- other file (the lib's, not changed while the script runs): read from disk once
-- @return The lines, or false if there's no text
local function lines_of(path: string)
    local text = Atdar.modules ~= nil and Atdar.modules.loaded_text_of(path) or nil
    local cached = source_lines[path]

    if text == nil and cached ~= nil then
        return cached.lines
    end

    if cached ~= nil and cached.text == text then
        return cached.lines
    end

    if text == nil then
        text = Atdar.loader.load("core/filesystem/file").read(path)
    end

    local lines = false
    if text ~= nil then
        lines = {}
        for line in (text .. "\n"):gmatch("([^\n]*)\n") do
            table.insert(lines, (line:gsub("\r$", "")))
        end
    end

    source_lines[path] = { text = text, lines = lines }
    return lines
end

-- A function's header as written: the parameters in brackets and what follows them ("(a: int, b) : bool").
-- The header may take a few lines
-- @return The parameters' text without the brackets, the text after them, and the text before "function" on
-- its line; nil if the source can't be found (lambdas and C functions have none)
local function header_of(fn)
    local info = debug.getinfo(fn, "S")
    if info.what ~= "Lua" or info.source:sub(1, 1) ~= "@" or info.linedefined < 1 then
        return nil
    end

    local lines = lines_of(info.source:sub(2))
    if not lines then
        return nil
    end

    local joined = ""
    for i = info.linedefined, math.min(info.linedefined + 5, #lines) do
        joined ..= lines[i] .. " "
        local before, inside, rest = joined:match("^(.-)function[^(]*(%b())(.*)")
        if inside ~= nil then
            return inside:sub(2, -2), rest, before
        end
    end

    return nil
end

-- A type written in a comment of a native: "Ped (int)" -> "int", "BOOL (bool)" -> "bool", "void" and "float" as they are
local function comment_type(text: string): string
    local inner = text:match("%(([%w_]+)%)")
    return inner or text:match("^%s*(.-)%s*$")
end

-- The return type written after a function's parameters ("function name(a, b): bool" -> "bool"),
-- the parameters may take a few lines; or, for a native, in the comment in front of "function"
-- @return The type, or nil if none is written or the file can't be read (lambdas and C functions have none)
function module.return_type(fn): ?string
    expect("return_type", "fn", fn, "function")
    local _, after, before = header_of(fn)
    if after == nil then
        return nil
    end

    local written = after:match("^%s*:%s*([%w_?|%.]+)")
    if written ~= nil then
        return written
    end

    local commented = before:match("%-%-%[%[([^%]]-)%]%]%s*$")
    if commented ~= nil then
        return comment_type(commented)
    end

    return nil
end

-- The parameters' text cut at the commas outside brackets, braces and quotes ("a: int, b = f(1, 2)" -> 2 pieces)
local function split_params(text: string): table

    local pieces = {}
    local depth, quote, start = 0, nil, 1

    for i = 1, #text do
        local c = text:sub(i, i)
        if quote ~= nil then
            if c == quote then
                quote = nil
            end
        elseif c == '"' or c == "'" then
            quote = c
        elseif c == "(" or c == "{" or c == "[" then
            depth += 1
        elseif c == ")" or c == "}" or c == "]" then
            depth -= 1
        elseif c == "," and depth == 0 then
            table.insert(pieces, text:sub(start, i - 1))
            start = i + 1
        end
    end

    table.insert(pieces, text:sub(start))
    return pieces
end

-- The types written for a function's parameters ("function add(amount: int, note: ?string, any)"):
-- { amount = "int", note = "?string" }; a native's are in comments in front of the names. A parameter with
-- no type isn't in it
-- @return The table (empty if nothing is written or the file can't be read)
function module.param_types(fn): table

    expect("param_types", "fn", fn, "function")

    local types = {}

    local inside = header_of(fn)
    if inside == nil then
        return types
    end

    for _, piece in ipairs(split_params(inside)) do
        -- "name: type" or "name: type = default"
        local name, type_text = piece:match("^%s*([%a_][%w_]*)%s*:%s*([^=]*)")
        if name ~= nil then
            type_text = type_text:match("^(.-)%s*$")
            if type_text ~= "" then
                types[name] = type_text
            end
        else
            -- A native's: "--[[int]] name"
            local commented, native_name = piece:match("^%s*%-%-%[%[([^%]]-)%]%]%s*([%a_][%w_]*)")
            if native_name ~= nil then
                types[native_name] = comment_type(commented)
            end
        end
    end

    return types
end

-- The defaults written for a function's parameters ("function go(speed: float = 1.5, loud = false)"):
-- { speed = "1.5", loud = "false" }, as the text written. A parameter with none, or with = nil, isn't in it
-- @return The table (empty if nothing is written or the file can't be read)
function module.param_defaults(fn): table

    expect("param_defaults", "fn", fn, "function")

    local defaults = {}

    local inside = header_of(fn)
    if inside == nil then
        return defaults
    end

    for _, piece in ipairs(split_params(inside)) do
        local name, written = piece:match("^%s*([%a_][%w_]*)[^=]*=%s*(.-)%s*$")
        if name ~= nil and written ~= "" and written ~= "nil" then
            defaults[name] = written
        end
    end
    
    return defaults
end

return module
