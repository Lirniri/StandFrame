-- lib/AnitaDarin/parsers/proglang/pluto/name.pluto
--
-- Names in code read as words, snake_case or camelCase alike.
--
--     Atdar.parsers.proglang.pluto.name.words("get_handle")  -- { get = true, handle = true }
--     Atdar.parsers.proglang.pluto.name.words("getHandle")   -- the same

-- A value of the wrong kind is the caller's mistake (core/check); text that can't be read isn't one -
-- that's what a parser is for
local expect = Atdar.loader.load("core/check").expecter("parsers/proglang/pluto/name")

local module = {}

-- The words of a name, lower case, as a set: "get_handle" / "getHandle" -> { get = true, handle = true }
function module.words(name: string): table

    expect("words", "name", name, "string")

    local words = {}
    local spaced = name:gsub("(%l)(%u)", "%1_%2")

    for word in spaced:gmatch("[^_]+") do
        words[word:lower()] = true
    end
    
    return words
end

return module
