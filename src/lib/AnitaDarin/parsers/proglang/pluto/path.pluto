-- lib/AnitaDarin/parsers/proglang/pluto/path.pluto
--
-- A path typed as in code, worked out into what it names: a function, a table, any value the script can reach.
--
--     local path = Atdar.parsers.proglang.pluto.path
--     path.resolve("game.repair_vehicle")      -- true, the function
--     path.resolve("VehicleManager:get")        -- true, the method, its module (the self to call it with)
--     path.resolve("PLAYER.PLAYER_PED_ID()")    -- true, the native (the brackets are cut: see split)
--     path.short_name("PLAYER.PLAYER_PED_ID")   -- "PLAYER_PED_ID"; "game.repair_vehicle" -> "repair_vehicle"
--     path.find("get_user_vehicle_as_handle")   -- { "entities.get_user_vehicle_as_handle" }
--     path.find("get_forward_z")                -- { "Atdar.natives.entity.get_forward_z" }
--
-- The first word is a global of Stand first (util, entities, menu, PLAYER, ...), else something of the script
-- (game.repair_vehicle; a module's name may come first: VehicleManager.get). The script has tables named like
-- Stand's (Atdar.util, Atdar.menu): those are reached with Atdar in front (Atdar.util.hash), plain util is Stand's.
-- With a colon the function is a method of what's before it (VehicleManager:get).
-- An item of a table is named by its key in square brackets, a number or a text: Atdar.util.hash["x"], some.list[1].name.
-- Braces at the end ask for the table to be opened to see what's in it: Atdar.util{} (see split).

-- A value of the wrong kind is the caller's mistake (core/check); text that can't be read isn't one -
-- that's what a parser is for
local expect = Atdar.loader.load("core/check").expecter("parsers/proglang/pluto/path")

local module = {}

-- The value one step down a path: a module of the manager at the root, else a field
local function step(current, key)
    if current == Atdar and type(key) == "string" and Atdar.modules ~= nil and Atdar.modules.has(key) then
        return Atdar.modules.get(key)
    end
    if type(current) ~= "table" then
        return nil
    end
    local ok, value = pcall(function() return current[key] end)
    if not ok then
        return nil
    end
    return value
end

-- The keys of a path in order, a name or a [key] each: "a.b[1].c" -> a, b, 1, c; a ["text"] key may have dots in it
-- @return The keys; nil when a bracket isn't closed or is empty
local function keys_of(path: string): ?table

    local keys = {}
    local index = 1

    while index <= #path do

        local char = path:sub(index, index)

        if char == "." then
            index += 1
        elseif char == "[" then

            -- A quoted key may have a ] in it: the closing one is the first after the closing quote
            local from = index + 1
            local quote = path:match("^%s*([\"'])", from)

            if quote ~= nil then
                local open = path:find(quote, from, true)
                from = (path:find(quote, open + 1, true) or open) + 1
            end

            local close = path:find("]", from, true)

            if close == nil then
                return nil
            end

            local inner = path:sub(index + 1, close - 1):match("^%s*(.-)%s*$")
            local text = inner:match("^\"(.*)\"$") or inner:match("^'(.*)'$")

            if inner == "" then
                return nil
            elseif text ~= nil then
                table.insert(keys, text)
            elseif inner:match("^%-?%d+$") then
                table.insert(keys, math.tointeger(tonumber(inner)))
            else
                table.insert(keys, inner)
            end

            index = close + 1
        else

            local word = path:match("^[^%.%[]+", index)

            table.insert(keys, word)
            index += #word
        end
    end

    return keys
end

-- "PLAYER.PLAYER_PED_ID()" and "game.set_speed(5)" -> the path and what is in the brackets (nil without them);
-- "Atdar.util{}" -> the path without the braces, and that the table is asked to be opened
-- @return The path, the text in the brackets, and true when it ended with {} (nothing more otherwise)
function module.split(name: string)
    
    expect("split", "name", name, "string")

    local path, inline = name:match("^(.-)%s*%((.*)%)%s*$")

    if path == nil then

        local table_path = name:match("^(.-)%s*{%s*}%s*$")

        if table_path ~= nil then
            return table_path, nil, true
        end

        return name, nil
    end

    return path, inline
end

-- "game.repair_vehicle" -> the function (or table, or any value); "VehicleManager:get" -> the method and
-- the owner to pass as self. Brackets at the end are not part of the path
-- @return Whether there is something at the path, what it is, and its owner (nil for a plain path)
function module.resolve(typed: string)

    expect("resolve", "typed", typed, "string")

    local path = module.split(typed)
    local owner_path = path
    local method = nil

    local colon = path:find(":", 1, true)
    if colon ~= nil then
        owner_path = path:sub(1, colon - 1)
        method = path:sub(colon + 1)
    end

    local keys = keys_of(owner_path)

    if keys == nil then
        return false
    end

    local current = Atdar
    local first = true
    for _, key in ipairs(keys) do
        local was_first = first
        first = false
        -- "Atdar.name" is the same as "name"
        if was_first and key == "Atdar" then
            continue
        end
        local next_value = nil
        -- The first word: a global of Stand (util, menu, entities, ...) before the script's own table of that name
        if was_first and type(key) == "string" then
            next_value = _G[key]
        end
        if next_value == nil then
            next_value = step(current, key)
        end
        current = next_value
        if current == nil then
            return false
        end
    end

    if method == nil then
        return true, current
    end

    local fn = step(current, method)
    if type(fn) ~= "function" then
        return false
    end

    return true, fn, current
end

-- How deep the tables of Atdar, of the script's natives (a module and the tables in it) and of the globals
-- are looked into by find
local FIND_DEPTH = { atdar = 4, natives = 2, globals = 2 }
-- Globals that aren't looked into: the language's own and the ones that hold everything
local FIND_SKIP = { _G = true, _ENV = true, Atdar = true, package = true, debug = true, io = true, os = true,
    string = true, table = true, math = true, utf8 = true, coroutine = true }

-- Adds to out the paths of the functions called name in tbl and the tables in it, down to depth
local function scan(tbl: table, prefix: string, depth: int, name: string, out: table, seen: table): void
    if seen[tbl] then
        return
    end

    seen[tbl] = true

    local keys = {}

    -- A table of the script's may be a proxy that can't be walked: it's skipped then
    local walked = pcall(function()
        for key in pairs(tbl) do
            if type(key) == "string" and key:sub(1, 2) ~= "__" then
                table.insert(keys, key)
            end
        end
    end)

    if not walked then
        return
    end

    table.sort(keys)

    for _, key in ipairs(keys) do
        local ok, value = pcall(function() return tbl[key] end)
        if ok then
            if key == name and type(value) == "function" then
                table.insert(out, $"{prefix}{key}")
            elseif type(value) == "table" and depth > 1 then
                scan(value, $"{prefix}{key}.", depth - 1, name, out, seen)
            end
        end
    end
end

-- The natives' files as dotted paths from natives/ (entity.ped.task), kept after the first search
local natives_files = nil

-- Adds the .pluto files under dir to out, named by their path from natives/ with dots
local function collect_natives(dir: string, prefix: string, out: table): void
    for _, path in ipairs(filesystem.list_files(dir)) do
        local file = path:match("([^\\/]+)[\\/]?$")
        if filesystem.is_dir(path) then
            collect_natives($"{path}\\", $"{prefix}{file}.", out)
        elseif file:match("%.pluto$") then
            table.insert(out, prefix .. file:sub(1, -7))
        end
    end
end

-- Every file of the script's natives. They load on first use, so a table walk of Atdar doesn't see the ones
-- nobody asked for yet: the search goes by the files, and loads each module it looks into
local function natives_modules(): table

    if natives_files ~= nil then
        return natives_files
    end

    natives_files = {}

    local dir = $"{filesystem.scripts_dir()}lib\\{Atdar.name}\\natives\\"

    if filesystem.is_dir(dir) then
        collect_natives(dir, "", natives_files)
    end

    table.sort(natives_files)

    return natives_files
end

-- Adds every function of tbl, and of the tables in it down to depth, to index by its short name
local function index_functions(tbl: table, prefix: string, depth: int, index: table, seen: table): void

    if seen[tbl] then
        return
    end

    seen[tbl] = true

    local keys = {}

    -- A table of the script's may be a proxy that can't be walked: it's skipped then
    local walked = pcall(function()
        for key in pairs(tbl) do
            if type(key) == "string" and key:sub(1, 2) ~= "__" then
                table.insert(keys, key)
            end
        end
    end)

    if not walked then
        return
    end

    table.sort(keys)

    for _, key in ipairs(keys) do
        local ok, value = pcall(function() return tbl[key] end)
        if ok then
            if type(value) == "function" then
                index[key] ??= {}
                table.insert(index[key], $"{prefix}{key}")
            elseif type(value) == "table" and depth > 1 then
                index_functions(value, $"{prefix}{key}.", depth - 1, index, seen)
            end
        end
    end
end

-- Short name -> the paths of the natives' functions of that name, made once: a search that walked every
-- natives module each time cost milliseconds, and a loop that names its function by a short name searches
-- at every call. Each file's module is looked into on its own: the other modules lying in it (entity.vehicle
-- in entity) are left to their files, so none is cut short by being met first from the folder above
local natives_index = nil

local function natives_by_name(): table

    if natives_index ~= nil then
        return natives_index
    end

    -- No natives yet (a script without them): nothing is kept, so they're found once they're there
    if Atdar.natives == nil then
        return {}
    end

    natives_index = {}

    local loaded = {}
    local is_module = {}

    for _, file in ipairs(natives_modules()) do
        local path = $"Atdar.natives.{file}"
        local found, tbl = module.resolve(path)
        if found and type(tbl) == "table" then
            table.insert(loaded, { path = path, tbl = tbl })
            is_module[tbl] = true
        end
    end

    for _, entry in ipairs(loaded) do
        local seen = {}
        for tbl in pairs(is_module) do
            seen[tbl] = tbl ~= entry.tbl or nil
        end
        index_functions(entry.tbl, $"{entry.path}.", FIND_DEPTH.natives, natives_index, seen)
    end

    return natives_index
end

-- Forgets the natives' files and functions found, for the next search to look again: after the natives
-- are loaded again (Reload Natives), whose functions are other ones then
function module.forget_natives(): void
    natives_files = nil
    natives_index = nil
end

-- The full paths of the functions with this short name (no dot or colon in it), to call by it: what Atdar
-- has first (game.repair_vehicle), then the script's natives (Atdar.natives.entity.get_forward_z), then the
-- globals one level down (entities.get_user_vehicle_as_handle, util.toast, PLAYER.PLAYER_PED_ID). Each part
-- in alphabetical order, so the first is the same every time. The first search loads every natives file
-- @return The paths, the first is the one to use; empty when there's none
function module.find(name: string): table

    expect("find", "name", name, "string")

    local out = {}
    if name == "" or name:find("[%.:%s]") then
        return out
    end

    local seen = {}

    -- The natives are searched by their files below, not by what happens to be loaded now
    if Atdar.natives ~= nil then
        seen[Atdar.natives] = true
    end

    scan(Atdar, "", FIND_DEPTH.atdar, name, out, seen)

    -- resolve takes the first word as Stand's global when there is one (memory is Stand's too): the script's
    -- own table of that name is reached with Atdar in front
    for index, path in ipairs(out) do
        if _G[path:match("^[^%.]+")] ~= nil then
            out[index] = $"Atdar.{path}"
        end
    end

    for _, path in ipairs(natives_by_name()[name] or {}) do
        table.insert(out, path)
    end

    local globals = {}
    for key, value in pairs(_G) do
        if type(key) == "string" and type(value) == "table" and not FIND_SKIP[key] then
            table.insert(globals, key)
        end
    end
    table.sort(globals)
    for _, key in ipairs(globals) do
        scan(_G[key], $"{key}.", FIND_DEPTH.globals, name, out, seen)
    end

    return out
end

-- The short name of a path: what's after the last dot or colon, whatever the namespace is (Stand's natives,
-- Stand's own functions, the script's, a module's): PLAYER.PLAYER_PED_ID -> PLAYER_PED_ID,
-- util.toast -> toast, VehicleManager:get -> get. Brackets are cut
function module.short_name(typed: string): string
    expect("short_name", "typed", typed, "string")
    local path = module.split(typed)
    return path:match("([^%.:]+)$") or path
end

return module
