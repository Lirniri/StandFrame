-- lib/AnitaDarin/parsers/proglang/pluto/path.pluto
--
-- A path typed as in code, worked out into what it names: a function, a table, any value the script can reach.
--
--     local path = Atdar.parsers.proglang.pluto.path
--     path.resolve("game.repair_vehicle")      -- true, the function
--     path.resolve("VehicleManager:get")        -- true, the method, its module (the self to call it with)
--     path.resolve("PLAYER.PLAYER_PED_ID()")    -- true, the native (the brackets are cut: see split)
--     path.short_name("PLAYER.PLAYER_PED_ID")   -- "PLAYER_PED_ID"; "game.repair_vehicle" -> "repair_vehicle"
--     path.find("get_user_vehicle_as_handle")   -- { "entities.get_user_vehicle_as_handle" }
--
-- The first word is a global of Stand first (util, entities, menu, PLAYER, ...), else something of the script
-- (game.repair_vehicle; a module's name may come first: VehicleManager.get). The script has tables named like
-- Stand's (Atdar.util, Atdar.menu): those are reached with Atdar in front (Atdar.util.hash), plain util is Stand's.
-- With a colon the function is a method of what's before it (VehicleManager:get).

-- A value of the wrong kind is the caller's mistake (core/check); text that can't be read isn't one -
-- that's what a parser is for
local expect = Atdar.loader.load("core/check").expecter("parsers/proglang/pluto/path")

local module = {}

-- The value one step down a path: a module of the manager at the root, else a field
local function step(current, key: string)
    if current == Atdar and Atdar.modules ~= nil and Atdar.modules.has(key) then
        return Atdar.modules.get(key)
    end
    if type(current) ~= "table" then
        return nil
    end
    local ok, value = pcall(function() return current[key] end)
    if not ok then
        return nil
    end
    return value
end

-- "PLAYER.PLAYER_PED_ID()" and "game.set_speed(5)" -> the path and what is in the brackets (nil without them)
-- @return The path, and the text in the brackets
function module.split(name: string)
    
    expect("split", "name", name, "string")

    local path, inline = name:match("^(.-)%s*%((.*)%)%s*$")

    if path == nil then
        return name, nil
    end

    return path, inline
end

-- "game.repair_vehicle" -> the function (or table, or any value); "VehicleManager:get" -> the method and
-- the owner to pass as self. Brackets at the end are not part of the path
-- @return Whether there is something at the path, what it is, and its owner (nil for a plain path)
function module.resolve(typed: string)

    expect("resolve", "typed", typed, "string")

    local path = module.split(typed)
    local owner_path = path
    local method = nil

    local colon = path:find(":", 1, true)
    if colon ~= nil then
        owner_path = path:sub(1, colon - 1)
        method = path:sub(colon + 1)
    end

    local current = Atdar
    local first = true
    for key in owner_path:gmatch("[^%.]+") do
        local was_first = first
        first = false
        -- "Atdar.name" is the same as "name"
        if was_first and key == "Atdar" then
            continue
        end
        local next_value = nil
        -- The first word: a global of Stand (util, menu, entities, ...) before the script's own table of that name
        if was_first then
            next_value = _G[key]
        end
        if next_value == nil then
            next_value = step(current, key)
        end
        current = next_value
        if current == nil then
            return false
        end
    end

    if method == nil then
        return true, current
    end

    local fn = step(current, method)
    if type(fn) ~= "function" then
        return false
    end

    return true, fn, current
end

-- How deep the tables of Atdar and of the globals are looked into by find
local FIND_DEPTH = { atdar = 4, globals = 2 }
-- Globals that aren't looked into: the language's own and the ones that hold everything
local FIND_SKIP = { _G = true, _ENV = true, Atdar = true, package = true, debug = true, io = true, os = true,
    string = true, table = true, math = true, utf8 = true, coroutine = true }

-- Adds to out the paths of the functions called name in tbl and the tables in it, down to depth
local function scan(tbl: table, prefix: string, depth: int, name: string, out: table, seen: table): void
    if seen[tbl] then
        return
    end

    seen[tbl] = true

    local keys = {}

    -- A table of the script's may be a proxy that can't be walked: it's skipped then
    local walked = pcall(function()
        for key in pairs(tbl) do
            if type(key) == "string" and key:sub(1, 2) ~= "__" then
                table.insert(keys, key)
            end
        end
    end)

    if not walked then
        return
    end

    table.sort(keys)

    for _, key in ipairs(keys) do
        local ok, value = pcall(function() return tbl[key] end)
        if ok then
            if key == name and type(value) == "function" then
                table.insert(out, $"{prefix}{key}")
            elseif type(value) == "table" and depth > 1 then
                scan(value, $"{prefix}{key}.", depth - 1, name, out, seen)
            end
        end
    end
end

-- The full paths of the functions with this short name (no dot or colon in it), to call by it: what Atdar
-- has first (game.repair_vehicle), then the globals one level down (entities.get_user_vehicle_as_handle,
-- util.toast, PLAYER.PLAYER_PED_ID). Each part in alphabetical order, so the first is the same every time
-- @return The paths, the first is the one to use; empty when there's none
function module.find(name: string): table

    expect("find", "name", name, "string")

    local out = {}
    if name == "" or name:find("[%.:%s]") then
        return out
    end

    local seen = {}
    scan(Atdar, "", FIND_DEPTH.atdar, name, out, seen)

    local globals = {}
    for key, value in pairs(_G) do
        if type(key) == "string" and type(value) == "table" and not FIND_SKIP[key] then
            table.insert(globals, key)
        end
    end
    table.sort(globals)
    for _, key in ipairs(globals) do
        scan(_G[key], $"{key}.", FIND_DEPTH.globals, name, out, seen)
    end

    return out
end

-- The short name of a path: what's after the last dot or colon, whatever the namespace is (Stand's natives,
-- Stand's own functions, the script's, a module's): PLAYER.PLAYER_PED_ID -> PLAYER_PED_ID,
-- util.toast -> toast, VehicleManager:get -> get. Brackets are cut
function module.short_name(typed: string): string
    expect("short_name", "typed", typed, "string")
    local path = module.split(typed)
    return path:match("([^%.:]+)$") or path
end

return module
