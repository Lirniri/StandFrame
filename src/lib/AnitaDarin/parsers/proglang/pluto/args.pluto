-- lib/AnitaDarin/parsers/proglang/pluto/args.pluto
--
-- Arguments typed as text, as in a call in Lua: '5, true, "text", v3.new(1, 2, 3)'.
--   parse(input) - worked out into values: numbers, true, false, nil, "text", names the script sees
--                  (natives, entities, Atdar, v3, ...) with .field, :method(...) and calls (...)
--                  and #1, #2 for the values the caller gives (parse's field)
--   split(input) - only cut into the texts of the arguments, nothing worked out
--   call_of(input) - "f(1, 2)" cut into the path called and the texts of its arguments
--
--     local args = Atdar.parsers.proglang.pluto.args
--     args.parse('adder, 5, PLAYER.PLAYER_PED_ID()')  -- { "adder", 5, 1234 }, 3
--     args.split('f(1, 2), "a, b"')                   -- { "f(1, 2)", '"a, b"' }
--     args.call_of('game.set(5, true)')               -- "game.set", { "5", "true" }
--
-- A name is a global first (util, PLAYER, v3), then something of the script (natives.entity.get_coords is
-- Atdar.natives.entity.get_coords), then whatever parse's resolve(name) gives it (the short names of
-- Debug > Call Function: user_ped() for players.user_ped()). The last two only for a name with . : or (
-- after it: a bare word is still its own text

-- A value of the wrong kind is the caller's mistake (core/check); text that can't be read isn't one -
-- that's what a parser is for
local expect = Atdar.loader.load("core/check").expecter("parsers/proglang/pluto/args")

local module = {}

-- ─── Texts, when it isn't an expression ──────────────────────────────────────

-- One argument as typed: nil, true, false, a number, otherwise the text itself
local function value_of(raw: string)
    if raw == "nil" then
        return nil
    end
    if raw == "true" then
        return true
    end
    if raw == "false" then
        return false
    end
    local number = tonumber(raw)
    if number ~= nil then
        return number
    end
    return raw
end

-- 'adder, 5, true, "a, b"' -> "adder", 5, true, "a, b": split by commas, a quoted text kept whole
-- (quotes "" or ''), spaces around each argument dropped. For what isn't a Lua expression (see parse)
-- @return The arguments and how many there are (nil ones count too)
local function split_texts(input: string)
    local args, count = {}, 0
    local i, len = 1, #input
    while i <= len do
        local c = input:sub(i, i)
        if c:match("%s") then
            i += 1
        elseif c == '"' or c == "'" then
            local close = input:find(c, i + 1, true) or (len + 1)
            count += 1
            args[count] = input:sub(i + 1, close - 1)
            local comma = input:find(",", close + 1, true)
            i = comma ~= nil ? comma + 1 : len + 1
        else
            local comma = input:find(",", i, true)
            local stop = comma ~= nil ? comma - 1 : len
            count += 1
            args[count] = value_of(input:sub(i, stop):match("^%s*(.-)%s*$"))
            i = stop + 2
        end
    end
    return args, count
end

-- ─── Reading the arguments as expressions ────────────────────────────────────
-- Stand's Lua has no load, so the expressions are read here. Understood: nil, true, false, numbers
-- (5, -2.5, 0x1F), "text" / 'text', names the script sees (natives, entities, Atdar, v3, ...) with .field,
-- :method(...) and calls (...) after them. A bare word that names nothing is its own text: adder -> "adder".
-- The reader is a table { src, pos }; what isn't an expression is thrown as { unreadable = why }

local KEYWORDS = { ["nil"] = { n = 1 }, ["true"] = { n = 1, true }, ["false"] = { n = 1, false } }

local function unreadable(reader: table, why: string): void
    error({ unreadable = $"{why} at {reader.pos}" }, 0)
end

-- The next character that isn't a space ("" at the end), without taking it
local function peek(reader: table): string
    reader.pos = reader.src:find("%S", reader.pos) or (#reader.src + 1)
    return reader.src:sub(reader.pos, reader.pos)
end

-- Takes a name (letters, digits, _) if one is next
local function take_name(reader: table): ?string
    peek(reader)
    local name = reader.src:match("^[%a_][%w_]*", reader.pos)
    if name ~= nil then
        reader.pos += #name
    end
    return name
end

-- Takes the name after '.' or ':'
local function need_name(reader: table, after: string): string
    local name = take_name(reader)
    if name == nil then
        unreadable(reader, $"a name expected after '{after}'")
    end
    return name
end

local read_list

-- A name that isn't a global: something of the script (natives -> Atdar.natives, a module by its name), then
-- what the reader's resolve gives it; nil when nothing has the name
local function named(reader: table, name: string)

    local modules = Atdar.modules

    if modules ~= nil and modules.has ~= nil and modules.has(name) then
        return modules.get(name)
    end

    local own = Atdar[name]
    if own ~= nil then
        return own
    end

    if reader.resolve ~= nil then
        return reader.resolve(name)
    end

    return nil
end

-- The value's field; what has no fields (nil, a number) is told by the name typed for it
local function field_of(value, field: string, trail: string)

    local kind = type(value)

    if kind == "nil" then
        error($"'{trail}' is nil, it has no '{field}'", 0)
    end

    if kind ~= "table" and kind ~= "userdata" and kind ~= "string" then
        error($"'{trail}' is a {kind}, it has no '{field}'", 0)
    end

    return value[field]
end

-- Whether the value can be called: a function, or a table or userdata that says how (__call)
local function callable(value): bool

    if type(value) == "function" then
        return true
    end

    local meta = getmetatable(value)

    return type(meta) == "table" and meta.__call ~= nil
end

-- One expression; its values packed (a call may give several, nil ones too)
local function read_expr(reader: table): table
    local c = peek(reader)
    if c == '"' or c == "'" then
        local close = reader.src:find(c, reader.pos + 1, true)
        if close == nil then
            unreadable(reader, "unclosed text")
        end
        local value = reader.src:sub(reader.pos + 1, close - 1)
        reader.pos = close + 1
        return { n = 1, value }
    end

    -- #1: the value of the field with that number, from what the caller gives (parse's field)
    if c == "#" then
        local digits = reader.src:match("^#(%d+)", reader.pos)
        if digits == nil or reader.field == nil then
            unreadable(reader, "a field number expected after '#'")
        end
        reader.pos += #digits + 1

        -- #1(>1): the arguments of the call written in the field, as the Function Name shows them; the field has them
        local shown = reader.src:match("^%(([%s>%d,]*)%)", reader.pos)
        if shown ~= nil then
            reader.pos += #shown + 2
        end

        return { n = 1, reader.field(math.tointeger(tonumber(digits))) }
    end

    local number_text = reader.src:match("^%-?%.?%d[%w%.]*", reader.pos)
    if number_text ~= nil then
        local number = tonumber(number_text)
        if number == nil then
            unreadable(reader, $"'{number_text}' isn't a number")
        end
        reader.pos += #number_text
        return { n = 1, number }
    end

    local name = take_name(reader)
    if name == nil then
        unreadable(reader, $"unexpected '{c}'")
    end
    if KEYWORDS[name] ~= nil then
        return KEYWORDS[name]
    end

    -- A name with a dot that the caller knows as one (asstr.only), not a field of what's before the dot
    local joined = nil
    local after = reader.src:match("^%.([%a_][%w_]*)", reader.pos)

    if after ~= nil and reader.command ~= nil then
        joined = reader.command($"{name}.{after}")
    end

    if joined ~= nil then
        name = $"{name}.{after}"
        reader.pos += #after + 1
    end

    local values = { n = 1, joined or _G[name] }
    local next_c = peek(reader)
    if values[1] == nil then
        if next_c ~= "." and next_c ~= ":" and next_c ~= "(" then
            return { n = 1, name }
        end
        values[1] = named(reader, name)
        if values[1] == nil then
            error($"'{name}' isn't known", 0)
        end
    end

    -- What is read so far, as typed: the errors name it ("'ENTITY.GET_COORDS' isn't a function")
    local trail = name

    -- .field, :method(...), (...)
    while true do
        next_c = peek(reader)
        if next_c == "." then
            reader.pos += 1
            local field = need_name(reader, ".")
            values = { n = 1, field_of(values[1], field, trail) }
            trail = $"{trail}.{field}"
        elseif next_c == ":" then
            reader.pos += 1
            local method = need_name(reader, ":")
            if peek(reader) ~= "(" then
                unreadable(reader, "'(' expected after a method")
            end
            reader.pos += 1
            local target = values[1]
            local fn = field_of(target, method, trail)
            trail = $"{trail}:{method}"
            if not callable(fn) then
                error($"'{trail}' isn't a function", 0)
            end
            local args, count = read_list(reader, ")")
            values = table.pack(fn(target, table.unpack(args, 1, count)))
            trail = $"{trail}()"
        elseif next_c == "(" then
            if not callable(values[1]) then
                error($"'{trail}' isn't a function", 0)
            end
            reader.pos += 1
            local args, count = read_list(reader, ")")
            values = table.pack(values[1](table.unpack(args, 1, count)))
            trail = $"{trail}()"
        else
            return values
        end
    end
end

-- Expressions separated by commas up to close (")", or "" for the end of the text), close taken too.
-- As in Lua, only the last one gives all its values, the others their first
-- @return The values and how many there are
read_list = function(reader, close)
    local args, count = {}, 0
    if peek(reader) == close then
        reader.pos += 1
        return args, count
    end
    while true do
        local values = read_expr(reader)
        local c = peek(reader)
        if c == "," then
            count += 1
            args[count] = values[1]
            reader.pos += 1
        elseif c == close then
            for i = 1, values.n do
                args[count + i] = values[i]
            end
            reader.pos += 1
            return args, count + values.n
        else
            unreadable(reader, close == "" ? "',' expected" : $"',' or '{close}' expected")
        end
    end
end

-- ─── Public ──────────────────────────────────────────────────────────────────

-- The arguments as typed, read as expressions separated by commas: numbers, true, false, nil, "text",
-- calls (entities.get_user_vehicle_as_handle(), PLAYER.PLAYER_PED_ID()), vectors (v3.new(1, 2, 3)).
-- A bare word is its own text: adder -> "adder". What isn't an expression at all (hello world) is split
-- by commas into texts instead
-- @param resolve function(name) -> the value of a name nothing else has (a short name), or nil
-- @param field function(number) -> the value of what #number stands for (#1 in the text); without it # isn't understood
-- @param command function(name) -> the function of a name with a dot that is one name (asstr.only), or nil
-- @return The arguments, how many there are (nil ones count too), and the error if working one out failed
function module.parse(input: string, resolve: ?function, field: ?function, command: ?function)
    expect("parse", "input", input, "string")
    local ok, args, count = pcall(read_list, { src = input, pos = 1, resolve = resolve, field = field, command = command }, "")
    if ok then
        return args, count, nil
    end
    if type(args) == "table" and args.unreadable ~= nil then
        local texts, texts_count = split_texts(input)
        return texts, texts_count, nil
    end
    return {}, 0, tostring(args)
end

-- The arguments as typed, split at the commas between them, not those inside brackets or quotes, and
-- trimmed; nothing is worked out: 'FAKE.add(1, 2), "a, b"' -> { "FAKE.add(1, 2)", '"a, b"' }
function module.split(input: string): table

    expect("split", "input", input, "string")

    local pieces = {}
    local depth, quote, start = 0, nil, 1

    for i = 1, #input do
        local c = input:sub(i, i)
        if quote ~= nil then
            if c == quote then
                quote = nil
            end

        elseif c == '"' or c == "'" then
            quote = c
        elseif c == "(" or c == "{" or c == "[" then
            depth += 1
        elseif c == ")" or c == "}" or c == "]" then
            depth -= 1
        elseif c == "," and depth == 0 then
            table.insert(pieces, input:sub(start, i - 1))
            start = i + 1
        end
    end

    table.insert(pieces, input:sub(start))

    local trimmed = {}
    for _, piece in ipairs(pieces) do
        local clean = piece:match("^%s*(.-)%s*$")
        if clean ~= "" then
            table.insert(trimmed, clean)
        end
    end

    return trimmed
end

-- One argument typed as a call, cut into what is called and its arguments' texts, nothing worked out:
-- "game.set(5, f(1))" -> "game.set", { "5", "f(1)" }. Only a whole call of a path: not "f(1) + 2", not
-- "a:b(1)" (a method needs its owner), not a call of a call ("f(1)(2)")
-- @return The path and the texts of its arguments; nil when the text isn't such a call
function module.call_of(input: string)

    expect("call_of", "input", input, "string")

    local path, inner = input:match("^%s*([%a_][%w_%.]*)%s*%((.*)%)%s*$")

    if path == nil or path:sub(-1) == "." or path:find("..", 1, true) then
        return nil
    end

    -- The first bracket must close at the very end: "f(1), g(2)" isn't one call
    local depth, quote = 0, nil

    for i = 1, #inner do
        local c = inner:sub(i, i)
        if quote ~= nil then
            if c == quote then
                quote = nil
            end
        elseif c == '"' or c == "'" then
            quote = c
        elseif c == "(" then
            depth += 1
        elseif c == ")" then
            depth -= 1
            if depth < 0 then
                return nil
            end
        end
    end

    if depth ~= 0 or quote ~= nil then
        return nil
    end

    return path, module.split(inner)
end

return module
