-- lib/AnitaDarin/parsers/json.pluto
--
-- JSON text read strictly: a whole object or array, or nothing. core JsonFile reads files with it,
-- the updater its manifest.
--
--     Atdar.parsers.json.decode('{"a": 1}')     -- { a = 1 }
--     Atdar.parsers.json.decode('{"a": 1, "b":') -- nil (pluto:json alone would give { a = 1 })

local json = require "pluto:json"

local module = {}

-- The characters the checks look at, as string.byte gives them: compared as numbers, so no one-character
-- string is made for each of them
local QUOTE = 34 -- "
local BACKSLASH = 92
local OPEN_BRACKET = 91 -- [
local CLOSE_BRACKET = 93 -- ]
local OPEN_BRACE = 123 -- {
local CLOSE_BRACE = 125 -- }

-- Whether every bracket the text opens is closed, outside of strings: '{"a":{"b":1}' (a cut-off file that
-- still starts with { and ends with }) is not
local function is_balanced(text: string): bool

    local depth = 0
    local position = 1
    local in_string = false

    while true do

        -- Only the characters that matter: strings are jumped over, not walked through
        local at = text:find(in_string and '["\\]' or '[%[%]{}"]', position)

        if at == nil then
            break
        end

        local char = text:byte(at)
        position = at + 1

        if in_string then
            if char == BACKSLASH then
                position = at + 2
            else
                in_string = false
            end
        elseif char == QUOTE then
            in_string = true
        elseif char == OPEN_BRACE or char == OPEN_BRACKET then
            depth += 1
        else
            depth -= 1
            if depth < 0 then
                return false
            end
        end
    end

    return depth == 0 and not in_string
end

-- pluto:json doesn't throw on bad input: it returns nil or the part it could parse, so a cut-off
-- file would load with keys silently missing ('{"a":1,"b":' gives { a = 1 }). Checked here instead
-- @return The decoded table, or nil if the text isn't one whole JSON object or array
function module.decode(text: string): ?table

    -- Where the text without the whitespace around it starts and ends: looked at in place, a file isn't
    -- copied to be trimmed
    local from = text:find("%S")

    if from == nil then
        return nil
    end

    local to = text:match(".*()%S")
    local first, last = text:byte(from), text:byte(to)

    if not ((first == OPEN_BRACE and last == CLOSE_BRACE) or (first == OPEN_BRACKET and last == CLOSE_BRACKET)) then
        return nil
    end

    -- The whitespace around has no brackets and no quotes, the whole text counts the same
    if not is_balanced(text) then
        return nil
    end

    local data = json.decode(text)

    if type(data) ~= "table" then
        return nil
    end

    -- '{bad}' decodes to an empty table; the whitespace is stripped only for that case, not for every file
    if next(data) == nil then
        local compact = text:gsub("%s", "")
        if compact ~= "{}" and compact ~= "[]" then
            return nil
        end
    end

    return data
end

return module
