-- Stops the script when its own files change on disk (the profile's Stop After Changes, Debug section).
-- Meant for development: after build.py copies a new version in, the script stops and is started again by hand.
-- Files are compared by write time and size, looked at once a second, and only while the setting is on:
-- what changed before it was switched on doesn't count

local Logger = Atdar.loader.load("core/logger")
local i18n = Atdar.loader.load("core/i18n")

local log = new Logger("FileWatch")

local module = {}

-- How often the files are looked at, ms
local CHECK_MS = 1000

-- path -> "write time:size" of the files when the setting was switched on; nil while it is off
local snapshot = nil
local last_check = 0
local stopping = false


-- One file's stamp: changes when the file is written or its size changes
-- @param path: string
-- @return string
local function stamp(path: string): string
    local ok_time, written = pcall(io.writetime, path)
    local ok_size, size = pcall(io.filesize, path)
    -- variable: "ok_time" is bool
    -- variable: "ok_size" is bool

    if not ok_time then
        written = 0
    end
    if not ok_size then
        size = 0
    end

    return $"{written}:{size}"
    -- what returns: the stamp
end


-- Every file of the script: its lib folder and the launcher next to the other scripts
-- @return table path -> stamp
local function take_snapshot(): table
    local result = {}
    local paths = Atdar.filesystem.paths
    local launcher = $"{paths.scripts}{Atdar.name}.pluto"
    -- table: result is only string/string
    -- variable: "launcher" is string

    local ok, files = pcall(io.listdir, paths.lib, true)
    if ok then
        -- @param
        -- @return
        for _, path in files do
            if io.isfile(path) then
                result[path] = stamp(path)
            end
        end
    end

    if io.exists(launcher) then
        result[launcher] = stamp(launcher)
    end

    return result
    -- what returns: the files and their stamps
end


-- The first file that differs from the snapshot: written, added or removed
-- @param before: table
-- @param now: table
-- @return ?string
local function find_change(before: table, now: table): ?string
    -- @param
    -- @return
    for path, value in now do
        if before[path] ~= value then
            return path
            -- what returns: the changed or new file
        end
    end

    -- @param
    -- @return
    for path in before do
        if now[path] == nil then
            return path
            -- what returns: the removed file
        end
    end

    return nil
    -- what returns: nothing changed
end


-- Stops the script; the notice is for the user to start it again
-- @param path: string
-- @return void
local function stop_for(path: string): void
    stopping = true
    local short = path:gsub("\\", "/")
    -- variable: "short" is string

    log:notify(i18n.text("profile.stop_on_change.stopped"):format(short:match("[^/]+$") or short))
    util.create_thread(function()
        util.yield()
        util.stop_script()
    end)
end


-- One look at the files, at most once in CHECK_MS. Public for the tests; the tick handler below calls it
-- @return bool true if the script is stopping
function module.check(): bool
    if stopping then
        return true
        -- what returns: already stopping
    end

    if Atdar.profile.get("stop_on_change") ~= true then
        snapshot = nil
        return false
        -- what returns: the setting is off
    end

    local now = util.current_time_millis()
    -- variable: "now" is number

    if snapshot == nil then
        snapshot = take_snapshot()
        last_check = now
        return false
        -- what returns: just switched on, the files as they are now are the ones to compare with
    end

    if now - last_check < CHECK_MS then
        return false
        -- what returns: not time yet
    end
    last_check = now

    local changed = find_change(snapshot, take_snapshot())
    if changed == nil then
        return false
        -- what returns: nothing changed
    end

    stop_for(changed)
    return true
    -- what returns: a file changed, the script is stopping
end

-- Forgets the snapshot and the stop, as if the script had just started. For the tests
-- @return void
function module.reset(): void
    snapshot = nil
    last_check = 0
    stopping = false
end

util.create_tick_handler(function()
    module.check()
    return true
end)

return module
