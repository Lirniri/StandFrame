-- Stops the script when its own files change on disk (the profile's Stop After Changes, Debug section).
-- Meant for development: after build.py copies a new version in, the script stops and is started again by hand.
-- Files are compared by write time and size, looked at once a second, and only while the setting is on:
-- what changed before it was switched on doesn't count.
-- The folder is listed in full only every RESCAN_MS (to find added files); in between only the known files are looked at.
-- The script stops only when the files have been quiet for QUIET_MS: a build copying many files takes a while,
-- and stopping on the first one would have the script start again on half-copied files

local Logger = Atdar.loader.load("core/logger")
local i18n = Atdar.loader.load("core/i18n")

local log = new Logger("FileWatch")

local module = {}

-- How often the known files are looked at, ms
local CHECK_MS = 1000

-- How often the whole folder is listed again to find added files, ms
local RESCAN_MS = 5000

-- How long the files must stay unchanged after the last change before the script stops, ms
local QUIET_MS = 2000

-- path -> "write time:size" of the files when the setting was switched on; nil while it is off
local snapshot = nil
local last_check = 0
local last_scan = 0
local stopping = false
-- The first file that changed since the files were quiet, and when the last change was seen
local pending = nil
local last_change = 0

-- One file's stamp: changes when the file is written or its size changes
local function stamp(path: string): string

    local ok_time, written = pcall(io.writetime, path)
    local ok_size, size = pcall(io.filesize, path)

    if not ok_time then
        written = 0
    end
    if not ok_size then
        size = 0
    end

    return $"{written}:{size}"
end

-- Every file of the script (its lib folder and the launcher next to the other scripts) with its stamp
local function take_snapshot(): table

    local result = {}
    local paths = Atdar.filesystem.paths
    local launcher = $"{paths.scripts}{Atdar.name}.pluto"

    local ok, files = pcall(io.listdir, paths.lib, true)
    if ok then
        for _, path in files do
            if io.isfile(path) then
                result[path] = stamp(path)
            end
        end
    end

    if io.exists(launcher) then
        result[launcher] = stamp(launcher)
    end

    return result
end

-- Stamps of the files already known, without listing the folder. Removed files are left out, added ones are not seen
local function refresh_snapshot(known: table): table

    local result = {}

    for path in known do
        if io.exists(path) then
            result[path] = stamp(path)
        end
    end

    return result
end

-- The first file that differs from the snapshot: written, added or removed
local function find_change(before: table, now: table): ?string

    for path, value in now do
        if before[path] ~= value then
            return path
        end
    end

    for path in before do
        if now[path] == nil then
            return path
        end
    end

    return nil
end

-- Stops the script; the notice is for the user to start it again
local function stop_for(path: string): void

    local short = path:gsub("\\", "/")

    stopping = true

    log:notify(i18n.text("profile.stop_on_change.stopped"):format(short:match("[^/]+$") or short))
    util.create_thread(function()
        util.yield()
        util.stop_script()
    end)
end

-- One look at the files, at most once in CHECK_MS. Public for the tests; the tick handler below calls it
-- @return Whether the script is stopping
function module.check(): bool

    local now = util.current_time_millis()
    local current
    local changed

    if stopping then
        return true
    end

    if Atdar.profile.get("stop_on_change") ~= true then
        snapshot = nil
        pending = nil
        return false
    end

    -- Just switched on: the files as they are now are the ones to compare with
    if snapshot == nil then
        snapshot = take_snapshot()
        last_check = now
        last_scan = now
        return false
    end

    if now - last_check < CHECK_MS then
        return false
    end
    last_check = now

    if now - last_scan >= RESCAN_MS then
        current = take_snapshot()
        last_scan = now
    else
        current = refresh_snapshot(snapshot)
    end

    changed = find_change(snapshot, current)

    -- Still changing: wait, and compare with the files as they are now
    if changed ~= nil then
        snapshot = current
        pending = pending or changed
        last_change = now
        return false
    end

    if pending == nil or now - last_change < QUIET_MS then
        return false
    end

    stop_for(pending)
    return true
end

-- Forgets the snapshot and the stop, as if the script had just started. For the tests
function module.reset(): void
    snapshot = nil
    last_check = 0
    last_scan = 0
    stopping = false
    pending = nil
    last_change = 0
end

util.create_tick_handler(function()
    module.check()
    return true
end)

return module
