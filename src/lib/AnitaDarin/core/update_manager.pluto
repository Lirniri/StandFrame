-- Drives the updater (core/updater) for the menu and for the automatic check: keeps what the last check
-- found, runs check and install one at a time and tells the user what happened.
-- Settings are in the profile: update_branch, update_check_before, auto_update, update_check_days,
-- update_last_check. Update To Version installs the release of a version typed (install_version).
-- What the last check found and the list of versions are kept in store/<script>/updater/cache.json, so the menu
-- shows them after a restart without asking the network again.
-- Strings: core/language "updater_menu" > "msg"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")
local updater = Atdar.loader.load("core/updater")
local installer = Atdar.loader.load("core/installer")
local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local paths = Atdar.loader.load("core/filesystem/paths")

local log = new Logger("Updater")

local _, text = i18n.scope("updater_menu")

local module = {}

-- What the last check found (see updater.plan), nil before the first one or after an install
module.plan = nil

-- Whether a check or an install is running
module.busy = false

-- How far the download of an update has come: { done, total }, nil when none is running
module.progress = nil

-- Percent steps between two progress notifications
local NOTIFY_STEP = 10

-- Seconds in a day
local DAY = 86400

-- How often the automatic check looks whether it's due, ms
local AUTO_TICK = 3600000

-- Whether the automatic check is on (can_start_auto), and whether its thread is alive
module.auto_check = false
local auto_running = false

-- Called after a check or an install, for the menu to show the new state
local listeners = {}

function module.on_change(listener: function): void
    table.insert(listeners, listener)
end

local function changed(): void
    for _, listener in ipairs(listeners) do
        pcall(listener)
    end
end

local function options(): table

    local branch = Atdar.profile.get("update_branch") or "main"

    -- "all" lists the versions of every branch; what's installed comes from main then
    if branch == "all" then
        branch = "main"
    end

    return { name = Atdar.name, branch = branch }
end

-- ─── The cache ───────────────────────────────────────────────────────────────

-- How long a kept list of versions is used without asking the network again, seconds
local VERSIONS_MAX_AGE = 3600

-- The most files of a check kept in the cache
local MAX_CACHED_CHANGES = 1000

local cache_state = nil

-- store/<script>/updater/cache.json: { version, branch, checked_at, up_to_date, changes = { { kind, path } },
-- versions = { { version, branch } }, versions_for, versions_at }
local function cache_file(): table
    return new JsonFile($"{paths.store}updater\\cache.json")
end

-- What the cache holds, read once
local function cache(): table
    if cache_state == nil then
        cache_state = cache_file():read() or {}
    end
    return cache_state
end

local function save_cache(): void
    cache_file():write(cache())
end

-- The branch the cache was made for must be the one updates come from now
local function cache_is_current(): bool
    return cache().version ~= nil and cache().branch == options().branch
end

-- Which list of versions it is: the branch, and whether the lists are synced with it
local function versions_key(): string
    return $"{Atdar.profile.get("update_branch") or "main"}|{tostring(Atdar.profile.get("update_versions_sync") ~= false)}"
end

-- Keeps what a check found
local function remember_check(plan: table): void

    local lines = {}

    for _, path in ipairs(plan.download) do
        table.insert(lines, { kind = "update", path = path })
    end

    for _, path in ipairs(plan.remove) do
        table.insert(lines, { kind = "remove", path = path })
    end

    local kept = cache()

    kept.version = plan.version
    kept.branch = plan.opts.branch
    kept.checked_at = os.time()
    kept.up_to_date = updater.is_up_to_date(plan)
    kept.changes = {}

    for i = 1, math.min(#lines, MAX_CACHED_CHANGES) do
        kept.changes[i] = lines[i]
    end

    save_cache()
end

-- The files changed: what was kept of the last check is no longer true
local function forget_check(): void

    local kept = cache()

    kept.version = nil
    kept.branch = nil
    kept.checked_at = nil
    kept.up_to_date = nil
    kept.changes = nil
    save_cache()
end

-- The version of the release the last update installed, nil if the script wasn't installed by an update
function module.installed_version(): ?string
    local data = updater.installed(options())

    if data == nil then
        return nil
    end

    return data.version
end

-- The version the last check found (this run's, else the one kept from an earlier run), nil before one
function module.available_version(): ?string

    if module.plan ~= nil then
        return module.plan.version
    end

    if cache_is_current() then
        return cache().version
    end

    return nil
end

-- Whether the last check found nothing to update
function module.is_up_to_date(): bool

    if module.plan ~= nil then
        return updater.is_up_to_date(module.plan)
    end

    return cache_is_current() and cache().up_to_date == true
end

-- When the last check was, os.time(); 0 before one
function module.last_check_time(): int
    return cache().checked_at or Atdar.profile.get("update_last_check") or 0
end

-- What the available version changes, nothing before a check
-- @return Lines { kind = "update"|"remove", path }
function module.changes(): table

    local lines = {}

    -- Not checked in this run: what the last run found
    if module.plan == nil then
        if cache_is_current() then
            return cache().changes or lines
        end

        return lines
    end

    for _, path in ipairs(module.plan.download) do
        table.insert(lines, { kind = "update", path = path })
    end

    for _, path in ipairs(module.plan.remove) do
        table.insert(lines, { kind = "remove", path = path })
    end

    return lines
end

-- Whether the automatic check is on and it's been update_check_days since the last one
function module.is_check_due(): bool

    local days = Atdar.profile.get("update_check_days") or 0
    local last = Atdar.profile.get("update_last_check") or 0

    if days == 0 then
        return false
    end

    return os.time() - last >= days * DAY
end

-- Downloads the manifest and compares it with the installed files, remembering the result.
-- Yields: call it from a thread
-- @return The plan, or nil and why not
local function run_check_unguarded()

    -- Checked here too, for the reason to be shown in the user's language
    if not updater.has_access() then
        return nil, text("msg.no_access"):format(Atdar.name)
    end

    local plan, err = updater.check(options())

    if plan == nil then
        return nil, err
    end

    module.plan = plan
    updater.remember(plan)
    remember_check(plan)
    Atdar.profile.set("update_last_check", os.time())
    return plan, nil
end

-- run_check that never throws: a broken manifest or a failing write is a failed check, not a thread that dies
-- with busy left on
-- @return The plan, or nil and why not
local function run_check()

    local ok, plan, err = pcall(run_check_unguarded)

    if not ok then
        log:info($"check failed: {plan}")
        return nil, tostring(plan)
    end

    return plan, err
end

-- Checks and tells what was found. Yields: call it from a thread
-- @return The plan, nil if the check failed or another one is running
function module.check()

    if module.busy then
        log:notify(text("msg.busy"))
        return nil
    end

    module.busy = true
    local plan, err = run_check()
    module.busy = false

    if plan == nil then
        log:warn(text("msg.check_failed"):format(err))
        return nil
    end

    changed()

    if updater.is_up_to_date(plan) then
        log:notify(text("msg.up_to_date"):format(tostring(plan.version)))
        return plan
    end

    log:notify(text("msg.found"):format(tostring(plan.version), #plan.download + #plan.remove))
    return plan
end

-- Carries a plan out: tells, downloads, writes. Called with module.busy set; clears it
-- @return "installed", "up_to_date" or "failed"
local function apply_plan(plan: table): string

    if updater.is_up_to_date(plan) then
        module.busy = false
        changed()
        log:notify(text("msg.up_to_date"):format(tostring(plan.version)))
        return "up_to_date"
    end

    log:notify(text("msg.installing"):format(#plan.download))

    local notified = 0

    module.progress = { done = 0, total = #plan.download }
    changed()

    local called, ok, apply_err, reason = pcall(updater.apply, plan, function(done: int, total: int)

        module.progress = { done = done, total = total }
        changed()

        local percent = done * 100 // total

        -- Not every file: an update is many of them, it would flood the notifications
        if Atdar.profile.get("update_progress_notify") ~= false and (percent - notified >= NOTIFY_STEP or done == total) then
            notified = percent
            log:notify(text("msg.progress"):format(percent, done, total))
        end
    end)
    module.busy = false

    -- An error thrown inside the update is a failed update; nothing was put in place before the swap
    if not called then
        ok, apply_err, reason = false, tostring(ok), nil
    end

    if not ok then
        module.progress = nil
        changed()
    end

    if not ok and reason == "stale" then
        log:error(text("msg.stale"))
        return "failed"
    end

    if not ok then
        log:error(text("msg.install_failed"):format(apply_err))
        return "failed"
    end

    module.plan = nil
    forget_check()
    changed()
    log:success(text("msg.installed"):format(tostring(plan.version)), "stand")
    return "installed"
end

-- Installs what the last check found; with update_check_before on (or no check yet) it checks first and
-- stops if there's nothing newer. Yields: call it from a thread
-- @return "installed", "up_to_date", "failed" or "busy"; the script is to be restarted after "installed"
function module.install(): string

    if module.busy then
        log:notify(text("msg.busy"))
        return "busy"
    end

    module.busy = true

    local plan = module.plan
    local err = nil

    if plan == nil or Atdar.profile.get("update_check_before") ~= false then
        plan, err = run_check()
    end

    if plan == nil then
        module.busy = false
        log:warn(text("msg.check_failed"):format(err))
        return "failed"
    end

    return apply_plan(plan)
end

-- The versions the last fetch_versions got, nil before one
module.versions_found = nil

-- The branches that make releases: main - the tried ones, experiment - all of them, the newest too
local RELEASE_BRANCHES = { "main", "experiment" }

-- Whether version a is newer than b: "0.1.10" is newer than "0.1.9"
local function is_newer(a: string, b: string): bool

    local left, right = {}, {}

    for number in a:gmatch("%d+") do
        table.insert(left, tonumber(number))
    end

    for number in b:gmatch("%d+") do
        table.insert(right, tonumber(number))
    end

    for i = 1, math.max(#left, #right) do
        local x, y = left[i] or 0, right[i] or 0
        if x ~= y then
            return x > y
        end
    end

    return false
end

-- The versions released, newest first, each with the branch it was released to: { version, branch }.
-- With Sync With Branch on (the default) it's the update branch's: main's own releases, or all of them for
-- experiment. Off, or with the branch "all": every branch's together, each under the branch that released it.
-- A file that doesn't say (an older one) is read as: main's list is main's, the rest are experiment's.
-- Yields: call it from a thread
-- @return The entries, or nil and why not
function module.fetch_versions()

    local o = options()
    local entries = {}

    if Atdar.profile.get("update_versions_sync") ~= false and Atdar.profile.get("update_branch") ~= "all" then

        local versions, err = updater.versions(o)

        if versions == nil then
            return nil, err
        end

        for _, entry in ipairs(versions) do
            -- main takes the versions made for main only
            if not (o.branch == "main" and entry.branch == "experiment") then
                table.insert(entries, { version = entry.version, branch = entry.branch or o.branch })
            end
        end

        module.keep_versions(entries)
        return entries, nil
    end

    -- Each version once: the branch its file entry says, else the first list that has it; a list that can't be
    -- read is skipped
    local found = {}
    local order = {}
    local last_err = nil

    for _, branch in ipairs(RELEASE_BRANCHES) do

        o.branch = branch
        local versions, err = updater.versions(o)

        if versions == nil then
            last_err = err
        else
            for _, entry in ipairs(versions) do
                local record = found[entry.version]
                if record == nil then
                    record = { version = entry.version, branch = entry.branch, listed_in = branch }
                    found[entry.version] = record
                    table.insert(order, record)
                elseif record.branch == nil then
                    record.branch = entry.branch
                end
            end
        end
    end

    if #order == 0 then
        return nil, last_err
    end

    for _, record in ipairs(order) do
        table.insert(entries, { version = record.version, branch = record.branch or record.listed_in })
    end

    table.sort(entries, |a, b| -> is_newer(a.version, b.version))
    module.keep_versions(entries)
    return entries, nil
end

-- Keeps the list of versions in the cache, for the next opening of the list and the next run
function module.keep_versions(entries: table): void

    module.versions_found = entries

    local kept = cache()

    kept.versions = entries
    kept.versions_for = versions_key()
    kept.versions_at = os.time()
    save_cache()
end

-- The list of versions of an earlier fetch, while it's less than an hour old and for the same branch and sync:
-- the list opens without asking the network
-- @return The entries, or nil when there's none to use
function module.cached_versions(): ?table

    local kept = cache()

    if kept.versions == nil or kept.versions_for ~= versions_key() then
        return nil
    end

    if os.time() - (kept.versions_at or 0) > VERSIONS_MAX_AGE then
        return nil
    end

    module.versions_found = kept.versions
    return kept.versions
end

-- The refs of the repo a typed version can mean: "0.1.8" is the release tagged v0.1.8 (or 0.1.8); anything
-- else - a tag, a branch, a commit - is taken as typed
local function refs_of(typed: string): table

    local version = typed:match("^v?(%d+%.%d+%.%d+)$")

    if version ~= nil then
        return { $"v{version}", version }
    end

    return { typed }
end

-- Installs the release of a version, an older one too: the files are made the same as that release's
-- (profiles and settings stay). Yields: call it from a thread
-- @param typed "0.1.8", or a tag, a branch or a commit of the repo
-- @return "installed", "up_to_date", "failed" or "busy"; the script is to be restarted after "installed"
function module.install_version(typed: string): string

    if module.busy then
        log:notify(text("msg.busy"))
        return "busy"
    end

    if not updater.has_access() then
        log:warn(text("msg.check_failed"):format(text("msg.no_access"):format(Atdar.name)))
        return "failed"
    end

    module.busy = true

    local plan = nil
    local err = nil

    for _, ref in ipairs(refs_of(typed)) do

        local ok, found, why = pcall(updater.check, { name = Atdar.name, branch = ref })

        if ok then
            plan, err = found, why
        else
            plan, err = nil, tostring(found)
        end

        if plan ~= nil then
            break
        end
    end

    if plan == nil then
        module.busy = false
        log:warn(text("msg.version_not_found"):format(typed, tostring(err)))
        return "failed"
    end

    return apply_plan(plan)
end

-- Installs a version and starts the script again when it was installed. Yields: call it from a thread
function module.install_version_and_restart(typed: string): void
    if module.install_version(typed) == "installed" then
        installer.restart()
    end
end

-- Installs and starts the script again when it was updated. Yields: call it from a thread
function module.install_and_restart(): void
    if module.install() == "installed" then
        installer.restart()
    end
end

-- One round of the automatic check: checks when due (or at once with force), installs what it found
-- if auto_update is on
local function auto_round(force: bool): void

    if not force and not module.is_check_due() then
        return
    end

    local plan = module.check()

    if plan == nil or updater.is_up_to_date(plan) then
        return
    end

    if Atdar.profile.get("auto_update") == true then
        module.install_and_restart()
    end
end

-- Whether the automatic check is on
function module.is_started_auto(): bool
    return module.auto_check
end

-- Starts the thread of the automatic check: a round soon after the start, then every AUTO_TICK.
-- It ends by itself once the check is switched off
local function run_auto(): void
    
    auto_running = true

    util.create_thread(function()
        util.yield(10000) -- the script is still starting

        -- The first round is at the start: Check On Start asks for a check whether it's due or not.
        -- 0 days means never, so it asks for nothing then
        local first = Atdar.profile.get("update_check_on_start") ~= false and (Atdar.profile.get("update_check_days") or 0) ~= 0

        while module.auto_check do
            auto_round(first)
            first = false
            util.yield(AUTO_TICK)
        end

        auto_running = false
    end)
end

-- Switches the automatic check on or off at any time. When it's on, the interval and auto_update
-- of the profile decide what a round does
function module.can_start_auto(toggle: bool): void
    module.auto_check = toggle

    if toggle and not auto_running then
        run_auto()
    end
end

-- Called at the script's start: the automatic check is on
function module.start_auto(): void
    module.can_start_auto(true)
end

return module
