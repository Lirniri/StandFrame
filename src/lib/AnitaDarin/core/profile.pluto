-- Script profiles: store/<script>/profiles/<name>.json, the active one named in store/<script>/config.json.
-- Defaults live here in code; a missing profile file is created from them, so profiles never need to ship in git.
-- Stand's own profiles already keep item states, these only hold what Stand doesn't have.

local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Profile")

local DEFAULTS = {
    -- How many of OLD_DEFAULTS (below) the profile has had: a new one all of them (set there)
    defaults_version = 0,
    display_name = Atdar.name,  -- shown to the user: settings section, built-in menu entry
    short_name = "AniDar",
    command_box_prefix = "atdar",
    command_box_separator = ".",     -- "" -> atdargodmode, "_" -> atdar_godmode, "." -> atdar.godmode
    -- The same for the loaded menu's commands (Found Commands), so they can't clash with the script's own
    command_box_found_prefix = "atdar",
    command_box_found_separator = "",
    -- The same for the user's own commands (User Commands: a name running other commands). None: a command
    -- is called exactly what the user named it ("settingsatdar")
    command_box_user_prefix = "",
    command_box_user_separator = "",
    log_name = "short",         -- name in log and toast lines: "short" | "display"
    debug = false,              -- show debug-level log lines
    stop_on_change = false,     -- stop the script when its files change on disk (core/file_watch)
    load_timing = false,        -- log how long each file takes to load, and the report at start (core/loader)
    log_keep_days = 7,          -- days of log files kept in store/<script>/logs (today counts); 0 = all
    -- Every log line on disk at once; otherwise warnings and errors only, the rest within a second
    log_info_at_once = false,
    auto_copy_menu = "AnitaDarin",        -- folder of a menu pack in store, copied to core at every start; "" = off
    auto_update = false,        -- a new version found by a check is installed by itself (updater_menu)
    update_check_days = 1,      -- check for a new version once in this many days; 0 = never
    update_branch = "main",     -- the repo's branch updates come from: "main" (releases) | "experiment" (newest)
    language = "auto",          -- language file code ("ru-ru") the script shows; "auto" = Stand's language
    notify = "game",           -- where notifications show: "stand" | "game" (the game's feed) | "none" (log only)
    notify_errors_in_stand = true, -- errors show in Stand whatever notify says, so none goes unseen
    notify_stand_newline = false, -- Stand's notifications: the text on its own line under [name | source | level]
    -- An emoticon at the end of a notification, by its kind (logger notify / warn / error / success)
    notify_emoticons = true,
    notify_emoticon_info = ":)",
    notify_emoticon_warn = "(!",
    notify_emoticon_error = ":(",
    notify_emoticon_success = ":D",
    notify_flash = true,       -- notifications in the game's feed flash
    notify_feed_style = "message", -- how a notification looks in the game's feed: "ticker" (a post) | "message" (a card)
    notify_feed_picture = "CHAR_ACTING_UP", -- the message card's picture (natives/visual/feed_picture)
    notify_feed_icon = "ARROW", -- the message card's icon: a natives/visual/hud/thefeed ICON name
    -- The feed's colours by the game's clock: day from notify_day_start up to notify_night_start (hours), night the rest.
    -- Hex "RRGGBBAA"; "" = the game's own colour (the flash colours start with it)
    notify_day_start = 7,
    notify_night_start = 19,
    notify_background_day = "00687DFF", -- Sea wave (0, 104, 125)
    notify_flash_color_day = "000000FF", -- black (0, 0, 0)
    notify_background_night = "1A3D54FF", -- dark teal (26, 61, 84)
    notify_flash_color_night = "00687DFF", -- Sea wave (0, 104, 125)
    -- The message card's subject colour, day and night: a natives/visual/hud/text COLOR name ("white", ...)
    -- or "level" (by the notification's type)
    notify_subject_color_day = "yellow",
    notify_subject_color_night = "yellow",
}

local DEFAULT_PROFILE = "main"

local STORE_DIR = $"{Atdar.filesystem.paths.store}"
local PROFILES_DIR = $"{STORE_DIR}profiles\\"
local config_file = new JsonFile($"{STORE_DIR}config.json")

local module = {}

local active = DEFAULT_PROFILE
local values = {}
local listeners = {}
-- Changes apply right away but reach the file only on save(), like Stand's own profiles,
-- unless the profile has autosave on
local dirty = false
-- config.json: the active profile and which profiles save every change by themselves
local config = { profile = DEFAULT_PROFILE, autosave = {} }

local function profile_file(name: string): table
    return new JsonFile($"{PROFILES_DIR}{name}.json")
end

local function write_config(): void
    config_file:write(config)
end

-- Profile names become file names: a-z, 0-9, _ and -
function module.sanitize_name(name: string): string
    local clean = name:lower():gsub("[^%w_%-]", "")
    return clean
end

local function notify_all(): void
    for key in pairs(DEFAULTS) do
        for _, listener in ipairs(listeners) do
            listener(key, values[key])
        end
    end
end

-- Defaults that were changed, oldest first: a profile still holding all of the old ones together gets the
-- new ones when it loads (it never chose them, they were only what the script gave it). Each is done once
-- per profile: defaults_version says how many it has had, so a value chosen later is never replaced.
-- A new one goes at the end
local OLD_DEFAULTS = {
    -- 2026-11-08: user commands were prefixed atdar_ for a day; now they're named exactly as typed
    { command_box_user_prefix = "atdar", command_box_user_separator = "_" },
}
DEFAULTS.defaults_version = #OLD_DEFAULTS

-- Keys renamed: a profile with the old name gets its value under the new one when it loads (2026-11-08:
-- the command box's keys all start with command_box_)
local RENAMED_KEYS = {
    command_prefix = "command_box_prefix",
    command_separator = "command_box_separator",
    found_command_prefix = "command_box_found_prefix",
    found_command_separator = "command_box_found_separator",
    user_command_prefix = "command_box_user_prefix",
    user_command_separator = "command_box_user_separator",
}

-- Puts the new defaults over old ones the profile never chose, the ones after its defaults_version
-- @param version How many OLD_DEFAULTS the profile has had (0 for one older than defaults_version)
-- @return Whether anything was replaced
local function replace_old_defaults(version: int): bool
    local replaced = false
    for i, old in ipairs(OLD_DEFAULTS) do
        local all_old = i > version
        for key, value in pairs(old) do
            if values[key] ~= value then
                all_old = false
            end
        end
        if all_old then
            for key in pairs(old) do
                values[key] = DEFAULTS[key]
            end
            replaced = true
        end
    end
    return replaced
end

-- Reads the profile, fills in keys it lacks from the defaults and writes it back if anything was missing
local function load_profile(name: string): void
    local file = profile_file(name)
    local data = file:read() or {}
    local changed = false
    for old_key, new_key in pairs(RENAMED_KEYS) do
        if data[old_key] ~= nil then
            if data[new_key] == nil then
                data[new_key] = data[old_key]
            end
            changed = true
        end
    end
    -- Read before the defaults fill it in: a profile without it is older than every OLD_DEFAULTS
    local version = math.type(data.defaults_version) == "integer" and data.defaults_version or 0
    values = {}
    for key, default in pairs(DEFAULTS) do
        if data[key] == nil then
            values[key] = default
            changed = true
        else
            values[key] = data[key]
        end
    end
    if replace_old_defaults(version) then
        changed = true
    end
    if values.defaults_version ~= #OLD_DEFAULTS then
        values.defaults_version = #OLD_DEFAULTS
        changed = true
    end
    active = name
    dirty = false
    if changed then
        file:write(values)
    end
end

-- Writes the current values into a profile, like Stand's Save on any profile: saving into another
-- profile overwrites it with what's in use now, the active profile stays the same
-- @return Whether it was written
function module.save_to(name: string): bool
    if not profile_file(name):write(values) then
        return false
    end
    if name == active then
        dirty = false
    end
    return true
end

-- Writes the current values into the active profile
function module.save(): void
    module.save_to(active)
end

function module.is_autosave(name: string): bool
    return config.autosave[name] == true
end

-- With autosave on, every change of the profile is written right away
function module.set_autosave(name: string, on: bool): void
    config.autosave[name] = on or nil
    write_config()
    if on and name == active and dirty then
        module.save()
    end
end

-- Folder with the profile files, e.g. to open it
function module.folder(): string
    return PROFILES_DIR
end

-- Whether there are changes not saved to the active profile yet
function module.is_dirty(): bool
    return dirty
end

-- Calls fn(key, value) whenever a value changes, including when another profile is loaded
function module.on_change(fn: function): void
    table.insert(listeners, fn)
end

function module.get(key: string)
    return values[key]
end

-- The value a key has in a new profile (the defaults in this file)
function module.default(key: string)
    return DEFAULTS[key]
end

function module.set(key: string, value): void
    if DEFAULTS[key] == nil then
        log:warn($"unknown profile key '{key}'")
        return
    end
    if values[key] == value then
        return
    end
    values[key] = value
    dirty = true
    if config.autosave[active] then
        module.save()
    end
    for _, listener in ipairs(listeners) do
        listener(key, value)
    end
end

function module.active_name(): string
    return active
end

-- @return Names of the saved profiles, sorted
function module.list(): table
    local names = {}
    if filesystem.is_dir(PROFILES_DIR) then
        for _, path in ipairs(filesystem.list_files(PROFILES_DIR)) do
            local name = path:match("([^\\/]+)%.json$")
            if name then
                table.insert(names, name)
            end
        end
    end
    table.sort(names)
    return names
end

-- Loads a saved profile; unsaved changes of the current one are dropped
function module.switch(name: string): void
    load_profile(name)
    config.profile = name
    write_config()
    notify_all()
end

-- Puts a profile's values back to the defaults above. The active one applies right away (saved
-- now if it saves itself, otherwise on Save, like any change); another profile is written as is
-- @return Whether it was done
function module.reset(name: string): bool
    local defaults = {}
    for key, value in pairs(DEFAULTS) do
        defaults[key] = value
    end
    if name ~= active then
        return profile_file(name):write(defaults)
    end
    values = defaults
    dirty = true
    if config.autosave[active] then
        module.save()
    end
    notify_all()
    return true
end

-- Creates a profile from the current values (saved or not) and switches to it; the old profile's file is untouched
-- @return The created name, or nil if the name is empty or taken
function module.create(name: string): ?string
    local clean = module.sanitize_name(name)
    if clean == "" then
        log:warn($"profile name '{name}' has no allowed characters (a-z, 0-9, _, -)")
        return nil
    end
    local file = profile_file(clean)
    if file:exists() then
        log:warn($"profile '{clean}' already exists")
        return nil
    end
    if not file:write(values) then
        return nil
    end
    module.switch(clean)
    return clean
end

-- Deletes a profile; the main one stays, and deleting the active one switches to main
-- Deletes a profile, main and the last one too (like Stand; create_main makes main again). Deleting the
-- active one loads another; with none left the script goes on with the values it has, unsaved (Save
-- writes them back), and the next start makes the profile it was on again with the defaults
-- @return Whether it was deleted
function module.delete(name: string): bool
    local others = {}
    for _, other in ipairs(module.list()) do
        if other ~= name then
            table.insert(others, other)
        end
    end
    profile_file(name):remove()
    if config.autosave[name] then
        config.autosave[name] = nil
        write_config()
    end
    if name == active then
        if #others == 0 then
            dirty = true
            return true
        end
        -- main when it's there, otherwise the first one by name
        local next_name = others[1]
        for _, other in ipairs(others) do
            if other == DEFAULT_PROFILE then
                next_name = other
            end
        end
        module.switch(next_name)
    end
    return true
end

-- The main profile's name ("main"): the one a new script starts with
function module.main_name(): string
    return DEFAULT_PROFILE
end

function module.exists(name: string): bool
    return profile_file(name):exists()
end

-- Makes the main profile with the defaults; one that's there is made again (its values lost). The caller
-- asks first when it's there. While it's the active one, the defaults apply right away
-- @return Whether it was written
function module.create_main(): bool
    if not module.reset(DEFAULT_PROFILE) then
        return false
    end
    -- The active one gets the defaults in memory only (reset writes it just with autosave on): its file is
    -- written here, so main is there again, e.g. after it was deleted while active
    if DEFAULT_PROFILE == active then
        return module.save_to(DEFAULT_PROFILE)
    end
    return true
end

-- Name for log and toast lines, as the profile chooses
function module.log_name(): string
    return values.log_name == "display" ? values.display_name : values.short_name
end

local saved = config_file:read() or {}
if type(saved.profile) == "string" then
    config.profile = saved.profile
end
if type(saved.autosave) == "table" then
    for name, on in pairs(saved.autosave) do
        if on == true then
            config.autosave[name] = true
        end
    end
end
load_profile(config.profile)
if not config_file:exists() then
    write_config()
end

-- Keep Atdar.debug and Atdar.load_timing in sync with the profile values at all times
Atdar.debug = values.debug == true
Atdar.load_timing = values.load_timing == true
table.insert(listeners, function(key: string, value)
    if key == "debug" then
        Atdar.debug = value == true
    elseif key == "load_timing" then
        Atdar.load_timing = value == true
    end
end)

return module
