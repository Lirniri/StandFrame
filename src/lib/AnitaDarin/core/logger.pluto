-- lib/AnitaDarin/core/logger.pluto


--[[ Example:
    local Logger = Atdar.loader.load("core/logger")
    local log = new Logger("HalfGodmode")   -- name shown in the brackets

    log:debug("...")   -- only when Atdar.debug = true
    log:info("...")    -- to the logs and console
    log:notify("...")  -- logs, console and an on-screen toast (messages for the user)
    log:warn("...")    -- logs, console and a toast
    log:error("...")   -- logs, console and a toast
]]

-- A message of several lines (an error with its traceback) is logged with the lines after the first indented,
-- so they read as its part. In a warning or an error the paths are shortened (Logger.tidy): the script's own files
-- from its folder on ("AnitaDarin\modules\..."), everything else in Stand's Lua Scripts from that folder on
-- ("Lua Scripts\Test\x.pluto"); the paths Lua cut ("...and\Lua Scripts\Test\...") too.
-- A line that comes again right after itself isn't written to the script's file again: the next other line
-- (or the next write to disk) puts "+ repeated N more time(s)" under it, as Stand's own log does



-- Every line goes to Stand's log (its file and console, util.log) and to the script's own log file,
-- one per day: store/<script>/logs/AnitaDarin_2026-11-06.log. Toasts show on screen where the profile says

-- ─── Log file ────────────────────────────────────────────────────────────────

-- The open file of today; a new day (or another folder) opens a new one
local log_file = { path = nil, handle = nil }

-- os.time() the open file's day ends at, and the Atdar.log_dir it was opened with: until then (and with the
-- same folder) today_file gives the handle without building the day and the path again. 0 - nothing to reuse
local day_ends = 0
local opened_dir = nil

-- Lines written but not on disk yet, and when they last went (see Writing to disk below)
local unflushed = false
local last_flush = 0

-- Set when the file can't be opened or written: lines then go to Stand's log only,
-- so a full disk or a locked file doesn't fail every line
local file_broken = false

-- The line written last, how many times it came again since, and the time of the last of them ("[12:00:00] ")
local last_line = nil
local repeats = 0
local last_repeat = ""

-- Writes how many times the last line came again, if it did
local function write_repeats(): void

    if repeats > 0 and log_file.handle then
        log_file.handle:write(last_repeat, $"+ repeated {repeats} more time(s)\n")
    end

    repeats = 0
end

-- store/<script>/logs/; Atdar.log_dir points elsewhere (the tests do)
local function log_dir(): string
    if Atdar.log_dir then
        return Atdar.log_dir
    end
    return $"{filesystem.store_dir()}{Atdar.name}\\logs\\"
end

local function close_file(): void
    if log_file.handle then
        pcall(write_repeats)
        -- Closing puts what waits in the buffer on disk too
        log_file.handle:close()
        unflushed = false
    end
    last_line = nil
    repeats = 0
    log_file.handle = nil
    log_file.path = nil
    day_ends = 0
end

-- @param day "2026-11-06"
-- @return os.time() of the midnight the day ends at, 0 if the day can't be read
local function end_of(day: string): int

    local year, month, number = day:match("^(%d+)%-(%d+)%-(%d+)$")

    if not year then
        return 0
    end

    return os.time({ year = tonumber(year), month = tonumber(month), day = tonumber(number) + 1, hour = 0 })
end

-- The day files in the folder: { name = "2026-11-06", path = ... }; other files aren't touched.
-- Any name ending in the date counts, so files named before the script's name was added are cleaned too
local function day_files(dir: string): table

    local list = {}

    if not filesystem.exists(dir) then
        return list
    end

    for _, path in ipairs(filesystem.list_files(dir)) do
        local day = path:match("(%d%d%d%d%-%d%d%-%d%d)%.log$")
        if day then
            table.insert(list, { name = day, path = path })
        end
    end

    return list
end

-- How many days of files are kept: the profile's log_keep_days, 0 = all
local function keep_days(): int

    local profile = Atdar.profile
    local days = profile and profile.get and profile.get("log_keep_days")

    if type(days) ~= "number" then
        return 0
    end

    return days
end

-- Removes the day files older than the kept days (today counts as one)
local function remove_old_files(dir: string, today: string): void
    local days = keep_days()
    if days <= 0 then
        return
    end

    local year, month, day = today:match("^(%d+)%-(%d+)%-(%d+)$")
    if not year then
        return
    end

    -- Noon, so a daylight saving switch doesn't move the day
    local noon = os.time({ year = tonumber(year), month = tonumber(month), day = tonumber(day), hour = 12 })
    local oldest = os.date("%Y-%m-%d", noon - (days - 1) * 86400)

    for _, file in ipairs(day_files(dir)) do
        if file.name < oldest then
            os.remove(file.path)
        end
    end
end

-- Opens today's file if it isn't the open one yet; on opening, old files are removed.
-- Errors when it can't be opened
local function today_file()

    -- Every line comes through here: the same day and folder need no date and no path
    if log_file.handle ~= nil and Atdar.log_dir == opened_dir and os.time() < day_ends then
        return log_file.handle
    end

    local dir = log_dir()
    local today = os.date("%Y-%m-%d")

    -- The script's file name first: the files still sort by date, and a copied file says whose it is.
    -- Not the Display Name: changing it would split a day into two files
    local path = $"{dir}{Atdar.name}_{today}.log"
    if path == log_file.path then
        opened_dir = Atdar.log_dir
        day_ends = end_of(today)
        return log_file.handle
    end
    close_file()

    if not filesystem.exists(dir) then
        filesystem.mkdirs(dir)
    end

    pcall(remove_old_files, dir, today)

    local handle, err = io.open(path, "a")

    if not handle then
        error(err)
    end
    log_file.handle = handle
    log_file.path = path
    opened_dir = Atdar.log_dir
    day_ends = end_of(today)
    return handle
end

-- ─── Writing to disk ─────────────────────────────────────────────────────────
-- A warning or an error is put on disk at once: what a crash leaves in the file must have them. Other lines
-- wait in the file's buffer and go once a second (or with the next warning, or when the file closes), so a
-- module logging every frame in debug mode doesn't touch the disk every frame. The profile's
-- log_info_at_once (Debug > Write Info At Once) puts every line on disk at once

-- How long a line waits to go to disk at most, ms
local FLUSH_MS = 1000

-- Puts the lines written so far on disk
local function flush_file(): void
    if unflushed and log_file.handle then
        pcall(write_repeats)
        pcall(log_file.handle.flush, log_file.handle)
    end
    unflushed = false
    last_flush = util.current_time_millis()
end

local function info_at_once(): bool
    local profile = Atdar.profile
    return profile ~= nil and profile.get ~= nil and profile.get("log_info_at_once") == true
end

local function write_to_file(level: string, line: string): void

    local handle = today_file()

    -- The same line again: counted, the count goes with the next write to disk (a second at most), also
    -- for a warning - written at once each time, it would never be counted
    if line == last_line then
        repeats += 1
        last_repeat = os.date("[%H:%M:%S] ")
        unflushed = true
        return
    end

    write_repeats()
    last_line = line
    handle:write(os.date("[%H:%M:%S] "), line, "\n")
    unflushed = true
    if level == "WARN" or level == "ERROR" or info_at_once() then
        flush_file()
    end
end

-- The lines waiting go to disk once a second
util.create_tick_handler(function()
    if unflushed and util.current_time_millis() - last_flush >= FLUSH_MS then
        flush_file()
    end
    return true
end)

util.on_stop(close_file)

-- ─── Level names for the user ────────────────────────────────────────────────

-- Shown on screen (a message card's subject); the log keeps INFO / WARN / ERROR
local LEVEL_ENGLISH = { DEBUG = "Debug", INFO = "Information", WARN = "Warning", ERROR = "Error", SUCCESS = "Success" }

-- The profile's emoticon for a level's notification (notify_emoticon_info / _warn / _error / _success),
-- "" while they're off or before the profile has loaded. On screen only: the log keeps the text as it is
local function emoticon_of(level: string): string
    local profile = Atdar.profile
    if not (profile and profile.get) or profile.get("notify_emoticons") ~= true then
        return ""
    end
    local emoticon = profile.get($"notify_emoticon_{level:lower()}")
    return type(emoticon) == "string" and emoticon or ""
end

-- @return The level's name in the script's language ("Предупреждение"); English until core/i18n has
-- loaded (it loads after the logger, and lines can come before it)
local function level_title(level: string): string

    local english = LEVEL_ENGLISH[level] or level
    local i18n = package.loaded[$"{Atdar.name}/core/i18n"]

    if type(i18n) ~= "table" or type(i18n.text) ~= "function" then
        return english
    end

    local ok, title = pcall(i18n.text, $"logger.level.{level:lower()}", english)
    if not ok or type(title) ~= "string" then
        return english
    end

    return title
end

-- ─── Readable messages ───────────────────────────────────────────────────────

-- How the folder of the scripts is shown in a path
local SHOWN_DIR = "Lua Scripts\\"

-- Stand's Lua Scripts folder, asked for once
local scripts_dir = nil

-- The paths of the script's files in a text shown from Lua Scripts on: the full ones (no user's folder
-- in a log sent to someone) and the ones Lua cut in an error ("...ata\Roaming\Stand\Lua Scripts\lib\x.lua:1:").
-- A path cut after the folder's name stays as it is
local function tidy(text: string): string

    if scripts_dir == nil then
        scripts_dir = filesystem.scripts_dir()
    end

    local at = scripts_dir ~= "" and text:find(scripts_dir, 1, true) or nil

    while at ~= nil do
        text = text:sub(1, at - 1) .. SHOWN_DIR .. text:sub(at + #scripts_dir)
        at = text:find(scripts_dir, at + #SHOWN_DIR, true)
    end

    -- A function: the text put in isn't read as a pattern's replacement
    text = text:gsub("%.%.%.[^\n:]-Lua Scripts[/\\]", || -> SHOWN_DIR)

    -- The script's own files from its folder on: "AnitaDarin\modules\game\...", the rest of the way is the same
    -- for everyone. Other libs (natives) keep theirs
    local own = (Atdar.name:gsub("%W", "%%%0"))

    return (text:gsub("Lua Scripts\\lib[/\\](" .. own .. "[/\\])", "%1"))
end

-- ─── Logger ──────────────────────────────────────────────────────────────────

local class Logger

    -- source: what's logging, e.g. "MenuBuilder"; nil logs with the script name only
    function __construct(source: ?string = nil)
        self.source = source
    end

    -- The name lines start with. Built per line: the profile's name can change while the script runs.
    -- The logger loads before the profile, so early lines use the script's name
    function name(): string
        local profile = Atdar.profile
        return profile and profile.log_name and profile.log_name() or Atdar.name
    end

    -- The head of the whole line, for the log and in debug mode: "[AnitaDarin | Modules | INFO]"
    function full_head(level: string): string
        if self.source then
            return $"[{self:name()} | {self.source} | {level}]"
        end
        return $"[{self:name()} | {level}]"
    end

    -- "[AnitaDarin | Modules | INFO] text"
    function full_line(level: string, msg: string): string
        return $"{self:full_head(level)} {msg}"
    end

    -- The head shown to the user outside debug mode: "[AnitaDarin] Information:", the level in the
    -- script's language and no source
    function short_head(level: string): string
        return $"[{self:name()}] {level_title(level)}:"
    end

    -- @param target Where it shows, whatever the profile says: "stand" or "game"; nil - as the profile says
    -- @return The post's id when the toast went to the game's feed (thefeed.remove(id) takes it away), otherwise nil
    function write(level: string, msg: string, toast: bool, target: ?string): ?int

        if level == "WARN" or level == "ERROR" then
            msg = tidy(msg)
        end

        -- The lines after the first indented, in the logs only: on screen the text is as given
        local logged = msg

        if msg:find("\n", 1, true) then
            logged = msg:gsub("\n", "\n    ")
        end

        local line = self:full_line(level, logged)
        util.log(line)
        if not file_broken then
            local ok, err = pcall(write_to_file, level, line)
            if not ok then
                file_broken = true
                pcall(close_file)
                util.log(self:full_line("WARN", $"the log file can't be written ({err}), lines go to Stand's log only"))
            end
        end
        if toast then
            -- On screen: the whole line in debug mode, otherwise the short one. The head apart too:
            -- Stand's notification may put the text on a line of its own (opts.head)
            local head = Atdar.debug ? self:full_head(level) : self:short_head(level)

            -- The emoticon at the end of the sentence: "Saved :D"
            local emoticon = emoticon_of(level)
            if emoticon ~= "" then
                msg = $"{msg} {emoticon}"
            end

            local shown = $"{head} {msg}"

            -- Where it shows is the profile's notify; errors go to Stand unless the profile says otherwise
            local profile = Atdar.profile

            if target == nil and level == "ERROR" and profile and profile.get
                and profile.get("notify_errors_in_stand") ~= false then
                target = "stand"
            end

            -- utils/util loads after the logger, so errors during early loading use Stand's toast.
            -- A notification that fails itself (e.g. the game's feed) still shows, in Stand
            -- The whole line for Stand and feed posts; a message card shows the level as its subject
            -- and the text alone (opts.level, opts.text)
            local utils = Atdar.util
            if utils and utils.toast then
                local ok, post = pcall(utils.toast, shown, { target = target, level = level, text = msg, head = head })
                if ok then
                    return post
                end
            end
            
            util.toast(shown)
        end
        return nil
    end

    -- Only when Atdar.debug is on
    function debug(msg: string): void
        if Atdar.debug then
            self:write("DEBUG", msg, false)
        end
    end

    function info(msg: string): void
        self:write("INFO", msg, false)
    end

    -- notify / warn / error / success show where the profile says; target "stand" or "game" puts one
    -- there whatever it says, for special cases (e.g. "stand" when a post in the feed would be in the way)

    -- Info the user should see, e.g. the result of something they clicked
    -- @return The post's id when it went to the game's feed, otherwise nil
    function notify(msg: string, target: ?string): ?int
        return self:write("INFO", msg, true, target)
    end

    -- Something the user should know about, but the script keeps working
    function warn(msg: string, target: ?string): ?int
        return self:write("WARN", msg, true, target)
    end

    function error(msg: string, target: ?string): ?int
        return self:write("ERROR", msg, true, target)
    end

    -- Something done that the user asked for and might wonder about: copied, saved, created
    -- @return The post's id when it went to the game's feed, otherwise nil
    function success(msg: string, target: ?string): ?int
        return self:write("SUCCESS", msg, true, target)
    end

end

-- @return The level's name for the user in the script's language: "INFO" -> "Information" / "Информация"
function Logger.level_title(level: string): string
    return level_title(level)
end

-- The paths of the script's files in a text shown from Stand's folder on, as warnings and errors are logged
function Logger.tidy(text: string): string
    return tidy(text)
end

-- The folder of the log files, e.g. to open it
function Logger.folder(): string
    return log_dir()
end

-- Removes every day file; the next line starts today's file again
-- @return How many files were removed
function Logger.clear(): int
    close_file()
    local removed = 0
    for _, file in ipairs(day_files(log_dir())) do
        if os.remove(file.path) then
            removed += 1
        end
    end
    return removed
end

-- Puts the lines waiting in the file's buffer on disk now (warnings and errors go at once anyway)
function Logger.flush(): void
    flush_file()
end

-- Removes today's file only; the next line starts it again
-- @return Whether there was one to remove
function Logger.clear_today(): bool
    close_file()
    local today = os.date("%Y-%m-%d")
    -- Plain require: the logger loads before the loader is there
    return require($"{Atdar.name}/core/filesystem/file").remove($"{log_dir()}{Atdar.name}_{today}.log")
end

-- Closes the log file and writes no more files until the script starts again (Stand's log goes on).
-- For deleting the script: an open file can't be removed, and a later line would make it again
function Logger.stop_file(): void
    close_file()
    file_broken = true
end

-- Writes files again after stop_file() (e.g. a rename that failed): the next line opens today's file
function Logger.resume_file(): void
    file_broken = false
end

-- Removes the files older than the profile's log_keep_days now (also done when a day's file opens)
function Logger.remove_old(): void
    pcall(remove_old_files, log_dir(), os.date("%Y-%m-%d"))
end

return Logger
