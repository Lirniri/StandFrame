-- lib/AnitaDarin/core/logger.pluto
-- Message delivery: Stand log file, Stand notification or the game's notification feed.

-- Length limit of a single text component in HUD natives
local FEED_CHUNK_SIZE = 99

-- Splits a string into chunks of at most size bytes without breaking UTF-8 characters
local function split_utf8(text, size)
    local chunks, buf = {}, ""
    for _, code in utf8.codes(text) do
        local ch = utf8.char(code)
        if #buf + #ch > size then
            table.insert(chunks, buf)
            buf = ""
        end
        buf ..= ch
    end
    if buf ~= "" then
        table.insert(chunks, buf)
    end
    return chunks
end

local class Logger
    -- Notification targets; order matches the settings menu items
    targets = {
        { id = "stand", label = "Stand" },
        { id = "game",  label = "Game" },
        { id = "none",  label = "None" },
    }

    function __construct(prefix)
        self.prefix = prefix
    end

    -- Writes to the Stand log file
    function log(text)
        util.log($"[{self.prefix}] {text}")
    end

    -- Sends a notification to the chosen target
    function send_text(text, target)
        text = tostring(text)

        if target == "stand" then
            util.toast($"[{self.prefix}] {text}")
        elseif target == "game" then
            self:send_game_feed(text)
        end
    end

    function send_game_feed(text)
        HUD.BEGIN_TEXT_COMMAND_THEFEED_POST("STRING")
        for _, chunk in split_utf8($"{self.prefix}: {text}", FEED_CHUNK_SIZE) do
            HUD.ADD_TEXT_COMPONENT_SUBSTRING_PLAYER_NAME(chunk)
        end
        HUD.END_TEXT_COMMAND_THEFEED_POST_TICKER(false, true)
    end
end

return Logger
