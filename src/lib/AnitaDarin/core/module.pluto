-- lib/AnitaDarin/core/module.pluto
--
-- Internal part of the script that the script itself starts, not the user: no menu item,
-- may depend on other modules and starts after them (see core/module_manager).
-- Something the user switches on and off is a Feature instead.
--
-- Made like a Feature: new Module({ name = ..., deps = {...}, on_start = fn, on_stop = fn, on_tick = fn })
-- or `local class X extends Module` with parent:__construct({ name = ..., deps = {...} }) and on_* overrides

local class_utils = Atdar.globals.pluto.class
local Logger = Atdar.loader.load("core/logger")
local JsonFile = Atdar.loader.load("core/filesystem/json/file")

-- Declared first and assigned explicitly so methods can reference Module
local Module

-- Run by the manager; subclasses override on_* hooks instead
local SEALED = {
    "start",
    "stop",
    "tick",
    "fail",
    "is_running",
    "has_tick",
}

local HOOKS = { on_start = true, on_stop = true, on_tick = true }

local function validate_opts(opts: table): void
    if type(opts.name) ~= "string" or opts.name == "" then
        error($"[Module] name must be a non-empty string, got {type(opts.name)}")
    end
    local label = $"[Module '{opts.name}']"

    for key, value in pairs(opts) do
        if key ~= "name" and key ~= "deps" and not HOOKS[key] then
            error($"{label} unknown option '{key}'")
        end
        if HOOKS[key] and type(value) ~= "function" then
            error($"{label} '{key}' must be a function, got {type(value)}")
        end
    end

    if opts.deps ~= nil then
        if type(opts.deps) ~= "table" then
            error($"{label} deps must be a table of module names, got {type(opts.deps)}")
        end
        for _, dep in ipairs(opts.deps) do
            if type(dep) ~= "string" then
                error($"{label} deps must hold module names, got {type(dep)}")
            end
        end
    end
end

Module = class

    function __construct(opts: table)
        class_utils.fix_index(self)
        class_utils.construct.check_sealed(self, Module, SEALED, $"Module '{opts.name}'")
        validate_opts(opts)

        self.name = opts.name
        -- Own copy: a table shared between instances would change for all of them
        self.deps = {}
        for _, dep in ipairs(opts.deps or {}) do
            table.insert(self.deps, dep)
        end
        -- registered -> running -> stopped, or failed (with the reason in self.error)
        self.status = "registered"
        self.error = nil
        self.log = new Logger(opts.name)

        self.on_start = opts.on_start or self.on_start
        self.on_stop = opts.on_stop or self.on_stop
        self.on_tick = opts.on_tick or self.on_tick
    end

    -- Runs a hook and catches its errors
    -- @return Whether the hook finished without an error
    private function call_hook(name: string): bool
        local ok, err = pcall(self[name], self)
        if not ok then
            self:fail($"{name} failed\n{err}")
        end
        return ok
    end

    function is_running(): bool
        return self.status == "running"
    end

    -- The manager skips modules that don't tick, so they cost nothing per frame
    function has_tick(): bool
        return self.on_tick ~= Module.on_tick
    end

    -- @return Whether the module is running afterwards
    function start(): bool
        if self.status == "running" then
            return true
        end
        if self.status == "failed" then
            return false
        end
        self.error = nil
        if not self:call_hook("on_start") then
            return false
        end
        self.status = "running"
        self.log:debug("started")
        return true
    end

    function stop(): void
        if self.status ~= "running" then
            return
        end
        -- Status first: a failing on_stop marks the module failed, which must stay
        self.status = "stopped"
        self:call_hook("on_stop")
        self.log:debug("stopped")
    end

    function tick(): void
        if self.status ~= "running" then
            return
        end
        if not self:call_hook("on_tick") then
            -- Cleanup, so a module that broke mid-tick doesn't leave its effects behind
            pcall(self.on_stop, self)
        end
    end

    -- Marks the module failed; it isn't started or ticked again
    function fail(reason: string): void
        self.status = "failed"
        self.error = reason
        self.log:error(reason)
    end

    -- Another module, for modules that use their deps
    function get(name: string): table
        return Atdar.modules.get(name)
    end

    -- The folder of the module's file, ending in a slash (lib/<script>/modules/VehicleManager/), or nil
    -- for a module made in code. It's the copy Stand runs: build.py rebuild and clean remove what's there
    function folder(): ?string
        local path = Atdar.modules.file_of(self.name)
        if path == nil then
            return nil
        end
        return path:match("^(.*[/\\])")
    end

    -- A JSON file in the module's folder: module:json_file("vehicles"):write({ ... }), :read()
    -- @return nil for a module made in code (it has no folder)
    function json_file(file_name: string): ?table
        local dir = self:folder()
        if dir == nil then
            return nil
        end
        return new JsonFile($"{dir}{file_name}.json")
    end

    function on_start(): void
        -- body
    end
    function on_stop(): void
        -- body
    end
    function on_tick(): void
        -- body
    end

end

-- Hooks the manager calls; not offered as functions to call by hand
local NOT_CALLABLE = { on_start = true, on_stop = true, on_tick = true }

-- @return The module's own functions, the ones a subclass of Module added (its methods, also those of
-- classes between it and Module), sorted by name: { name, params = { "model", "coords" }, vararg = bool }.
-- Module's own methods and the hooks are left out, and so are names starting with _ (helpers);
-- internal = true gives just those instead (names starting with __ never: they're the class's own)
function Module.functions_of(instance: table, internal: bool = false): table
    local found = {}
    local list = {}
    local cls = getmetatable(instance)
    while type(cls) == "table" and cls ~= Module do
        for name, value in pairs(cls) do
            if type(name) == "string" and type(value) == "function" and not found[name]
                and (name:sub(1, 1) == "_") == internal and name:sub(1, 2) ~= "__"
                and not NOT_CALLABLE[name] and rawget(Module, name) == nil then
                found[name] = true
                -- The parameters' names, without self
                local info = debug.getinfo(value, "u")
                local params = {}
                for i = 2, info.nparams do
                    table.insert(params, debug.getlocal(value, i))
                end
                table.insert(list, { name = name, params = params, vararg = info.isvararg })
            end
        end
        cls = rawget(cls, "__parent")
    end
    table.sort(list, |a, b| -> a.name < b.name)
    return list
end

return Module
