-- lib/AnitaDarin/core/loader.pluto

-- Plain require: the loader is what loads everything else
local Logger = require($"{Atdar.name}/core/logger")
local log = new Logger("Loader")

local module = {}

-- ─── Load times ──────────────────────────────────────────────────────────────
-- Every file load() reads from disk is timed, to see what makes the start slow. Kept always:
-- the first files load before the profile says whether Load Timing is on. A file that loads others
-- includes their time, so each entry has both: total (with nested) and own (without).
-- With Atdar.load_timing (the profile's Load Timing) each load is also logged as it happens

-- { path, total, own, depth } in load order, times in ms
module.timings = {}
-- Loads in progress, innermost last: how much of each went to nested loads
local loading = {}

-- @return Milliseconds from some fixed point, with fractions: Pluto's os.nanos;
-- os.clock and util.current_time_millis count whole milliseconds on Windows, too coarse for one file
function module.now(): number
    if os.nanos then
        return os.nanos() / 1000000
    end
    if os.clock then
        return os.clock() * 1000
    end
    return util.current_time_millis()
end

local function ms(value: number): string
    return string.format("%.1f", value)
end

-- Full paths are shown from Lua Scripts on: "store\AnitaDarin\menu\...\godmode.pluto"
local SCRIPTS_DIR = filesystem.scripts_dir()

local function shorten(what: string): string
    if what:sub(1, #SCRIPTS_DIR) == SCRIPTS_DIR then
        return what:sub(#SCRIPTS_DIR + 1)
    end
    return what
end

-- Runs fn(...) and records how long it took under `what` (a lib path or a file's full path).
-- Loads inside it count as its nested time. Errors from fn pass through, after the time is recorded
-- @return What fn returns
function module.measure(what: string, fn, ...)

    local frame = { nested = 0 }
    table.insert(loading, frame)
    local started = module.now()
    local results = table.pack(pcall(fn, ...))
    local total = module.now() - started
    table.remove(loading)
    local parent = loading[#loading]

    if parent then
        parent.nested += total
    end

    local own = total - frame.nested
    local path = shorten(what)

    table.insert(module.timings, { path = path, total = total, own = own, depth = #loading })

    if Atdar.load_timing then
        log:info($"loaded '{path}' in {ms(total)} ms (own {ms(own)} ms)")
    end

    if not results[1] then
        error(results[2], 0)
    end

    return table.unpack(results, 2, results.n)
end

-- Requires the file, timed; a file already loaded isn't timed again
local function timed_require(path: string, name: string)
    if package.loaded[name] ~= nil then
        return pcall(require, name)
    end
    return pcall(module.measure, path, require, name)
end

-- Logs the load times: how many files and how long, then the slowest by their own time.
-- bootstrap calls it at the end of the start with Load Timing on; any code can call it later too.
-- @param total_ms The whole start, if measured (bootstrap passes it)
-- @param limit How many of the slowest files to list
function module.report(total_ms: ?number, limit: int = 15): void

    local sorted = {}
    local own_sum = 0

    for _, entry in ipairs(module.timings) do
        table.insert(sorted, entry)
        own_sum += entry.own
    end

    table.sort(sorted, |a, b| -> a.own > b.own)

    local summary = $"load times: {#sorted} files, {ms(own_sum)} ms in them"
    if total_ms ~= nil then
        summary ..= $", the whole start {ms(total_ms)} ms"
    end

    log:info(summary)

    for i = 1, math.min(limit, #sorted) do
        local entry = sorted[i]
        log:info(string.format("%8s ms own %8s ms with nested   %s", ms(entry.own), ms(entry.total), entry.path))
    end
end

-- ─── Loading ─────────────────────────────────────────────────────────────────

-- @return The file and line that asked for a load, past the loader's own frames and C functions
-- (require, pcall): "lib/AnitaDarin/natives/visual/hud/thefeed.pluto:13"
local function caller(): string

    local own = debug.getinfo(1, "S").source
    local level = 2

    while true do
        local info = debug.getinfo(level, "Sl")
        if info == nil then
            return "?"
        end

        if info.what ~= "C" and info.source ~= own then
            local file = info.source:gsub("^@", "")
            return $"{shorten(file)}:{info.currentline}"
        end

        level += 1
    end
end

-- Names of the files module.load got, so reload doesn't have to walk the whole package.loaded
local loaded_names = {}

-- Requires lib/AnitaDarin/<path>. On error logs it with the file that asked for it and returns
-- an empty table, so one broken file doesn't take down the whole section
function module.load(path: string): table

    local name = $"{Atdar.name}/{path}"
    local ok, result = timed_require(path, name)

    if not ok then
        log:error($"failed to load '{path}' (from {caller()})\n{result}")
        return {}
    end

    loaded_names[name] = true

    -- An empty file makes require return true instead of a table
    if type(result) ~= "table" then
        log:warn($"'{path}' did not return a table")
        return {}
    end

    return result
end

-- lib/AnitaDarin/; the loader runs before utils/filesystem, so the path is built here
local LIB_DIR = $"{filesystem.scripts_dir()}lib\\{Atdar.name}\\"

-- The tables made by auto and the folder each loads from (weak: a table that's gone takes its entry)
local auto_bases = setmetatable({}, { __mode = "k" })

-- The names a table made by auto could load, from the files of its folder: a facade lists only what was loaded, so
-- what's still on disk is what a viewer of the table (Call Function) has to ask for
-- @return The names sorted; empty for a table not made by auto
function module.auto_keys(tbl: table): table

    local base = auto_bases[tbl]
    local names = {}

    if base == nil then
        return names
    end

    local dir = LIB_DIR .. base:gsub("/", "\\") .. "\\"

    if not filesystem.is_dir(dir) then
        return names
    end

    for _, path in ipairs(filesystem.list_files(dir)) do

        local name = path:match("([^\\/]+)%.pluto$")

        if name ~= nil then
            table.insert(names, name)
        end
    end

    table.sort(names)

    return names
end

-- Fields missing from tbl are loaded on first access from <base>/<field>.pluto and kept in tbl,
-- so a facade doesn't list its submodules. A field with no such file stays nil, so typos aren't hidden.
-- Example: return Atdar.loader.auto(module, "natives/visual/hud") -> hud.minimap loads natives/visual/hud/minimap.pluto
function module.auto(tbl: table, base: string): table

    -- Fields already known to have no file: not checked on disk again
    local missing = {}

    auto_bases[tbl] = base
    return setmetatable(tbl, {
        __index = function(t, key)
            if type(key) ~= "string" or missing[key] then
                return nil
            end
            local path = $"{base}/{key}"
            local file = path:gsub("/", "\\")
            if not filesystem.exists($"{LIB_DIR}{file}.pluto") then
                missing[key] = true
                return nil
            end
            local sub = module.load(path)
            rawset(t, key, sub)
            return sub
        end,
    })
end

-- ─── Reloading ───────────────────────────────────────────────────────────────

-- Tables files keep across a reload, by name (see keep)
local kept = {}

-- A table that outlives reloads of the file asking for it: the same table comes back after the file
-- is loaded again, for state that must not be lost (e.g. the feed posts the script made)
-- Example: local state = Atdar.loader.keep("natives/visual/hud/thefeed")
function module.keep(name: string): table
    if kept[name] == nil then
        kept[name] = {}
    end
    return kept[name]
end

-- Loads the files under lib/AnitaDarin/<base>/ again, each on its first use after this: forgets them
-- in require's cache and takes the loaded ones out of tbl, a table made by auto (e.g. Atdar.natives).
-- Code that asks tbl each time (Atdar.natives.entity.vehicle in a function) gets the new files;
-- a table kept in a variable from before stays the old one
-- @return How many loaded files were forgotten
function module.reload(tbl: table, base: string): int

    local prefix = $"{Atdar.name}/{base}/"
    local forgotten = 0

    -- Only the files module.load knows, not all of package.loaded; one a file required itself isn't forgotten
    for name in pairs(loaded_names) do
        if name:sub(1, #prefix) == prefix then
            package.loaded[name] = nil
            loaded_names[name] = nil
            forgotten += 1
        end
    end

    for key in pairs(tbl) do
        rawset(tbl, key, nil)
    end
    
    -- A fresh auto: files added since are found too
    module.auto(tbl, base)
    return forgotten
end

return module
