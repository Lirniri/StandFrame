-- The script's updater engine: compares the installed files with the release, downloads the changed ones
-- and removes the dropped ones. core/update_manager keeps the state and drives it from the menu.
-- installed.json goes through core JsonFile.
--
-- What a release is: updater/manifest.json in the repo's release branch (main), made by
-- updater/manifest.py - every file of src with its sha256. The updater reads it, compares each file with
-- the one installed, downloads those that differ from raw.githubusercontent.com, checks every download
-- against its hash and only when all came right writes them. A renamed script is updated under its name.
--
-- Kept as they are: what the script writes while it runs (see is_user_data) and files the updater didn't
-- put there (a menu copied to core, a pack of one's own). Removed: only files a previous update put
-- there that the new release doesn't have.
--
-- check and apply yield while downloading: call them from a thread (util.create_thread)

-- The manifest downloaded is read strictly (a cut-off one is no manifest); installed.json goes through JsonFile
local json_parser = Atdar.loader.load("parsers/json")
local crypto = require "pluto:crypto"
local JsonFile = Atdar.loader.load("core/filesystem/json/file")

local module = {}

-- Where releases come from; each can be given in opts instead
module.DEFAULTS = {
    host = "raw.githubusercontent.com",
    repo = "Lirniri/Stand-AnitaDarin",
    branch = "main",
    -- The manifest's place in the repo
    manifest = "updater/manifest.json",
    -- The releases made, newest first: { "versions": [ "0.1.10", ... ] }
    versions = "updater/versions.json",
    -- The repo's folder the manifest's paths are under
    src = "src",
    -- The name in the repo's paths: src/AnitaDarin.pluto, src/lib/AnitaDarin/...
    project = "AnitaDarin",
    -- How long one download may take, ms
    timeout = 15000,
}

-- The manifest format this updater reads (FORMAT in updater/manifest.py)
module.FORMAT = 1

-- The folders of Lua Scripts that hold a <name> folder of the script
local ROOTS = { "lib", "store", "resources" }

-- Compared as they are; any other file is text, compared without \r (a Windows copy has \r\n)
local BINARY = {
    png = true, jpg = true, jpeg = true, gif = true, bmp = true, ico = true, dds = true, ytd = true,
    ttf = true, otf = true, wav = true, mp3 = true, ogg = true, zip = true, dll = true, bin = true,
}

-- What the script writes while it runs, in store/<project>/: its config.json and whatever is in a
-- profiles, logs, commands or user folder (a pack's in store/<project>/menu/<pack>/ too)
local USER_FOLDERS = { profiles = true, logs = true, commands = true, user = true }

-- ─── Paths ───────────────────────────────────────────────────────────────────

-- Project name -> { [root] = "<root>/<project>/" }, what a manifest path of the project starts with. Made
-- once per project: every path of a release is compared with them
local prefixes = {}

local function prefixes_of(project: string): table

    local found = prefixes[project]

    if found ~= nil then
        return found
    end

    found = {}
    for _, root in ipairs(ROOTS) do
        found[root] = $"{root}/{project}/"
    end

    prefixes[project] = found

    return found
end

-- opts over DEFAULTS, plus name (the script's, project if not given) and scripts_dir (Lua Scripts)
local function options(opts: ?table): table
    local o = {}
    for key, value in pairs(module.DEFAULTS) do
        o[key] = value
    end
    for key, value in pairs(opts or {}) do
        o[key] = value
    end
    o.name = o.name or o.project
    o.scripts_dir = o.scripts_dir or filesystem.scripts_dir()
    return o
end

-- Where a manifest path goes in Lua Scripts, under the script's name:
-- "lib/AnitaDarin/core/loader.pluto" -> "<Lua Scripts>lib\<name>\core\loader.pluto".
-- A manifest can't write anywhere else: a path outside the script's own places gives nil
-- @param o The options (scripts_dir, project, name)
-- @return The full path, or nil
function module.target_of(path: string, o: table): ?string
    if path:find("..", 1, true) or path:find("\\", 1, true) or path:find(":", 1, true) or path:sub(1, 1) == "/" then
        return nil
    end

    if path == $"{o.project}.pluto" then
        return $"{o.scripts_dir}{o.name}.pluto"
    end
    
    local starts = prefixes_of(o.project)

    for _, root in ipairs(ROOTS) do
        local prefix = starts[root]
        if path:startswith(prefix) and #path > #prefix then
            local rest = path:sub(#prefix + 1):gsub("/", "\\")
            return $"{o.scripts_dir}{root}\\{o.name}\\{rest}"
        end
    end
    
    return nil
end

-- Whether the file is the user's, written by the script while it runs: made when missing, never
-- replaced or removed. "store/AnitaDarin/config.json", "store/AnitaDarin/profiles/main.json"
function module.is_user_data(path: string, project: string): bool
    
    local prefix = prefixes_of(project).store
    
    if not path:startswith(prefix) then
        return false
    end
    
    local rest = path:sub(#prefix + 1)
    
    if rest == "config.json" then
        return true
    end
    
    for folder in rest:gmatch("([^/]+)/") do
        if USER_FOLDERS[folder] then
            return true
        end
    end
    
    return false
end

-- The file's sha256 as the manifest has it: text without \r, so the same file with \r\n matches
-- @param path Its manifest path (the extension tells text from binary)
function module.hash(path: string, content: string): string
    local extension = path:match("%.([^./]+)$")
    -- Looked for first: gsub copies the whole text even when it has no \r to take out
    if (extension == nil or not BINARY[extension:lower()]) and content:find("\r", 1, true) then
        content = content:gsub("\r\n", "\n")
    end
    return crypto.sha256(content)
end

-- Files read and written as they are (core/filesystem/file)
local plain = Atdar.loader.load("core/filesystem/file")

local function read_file(path: string): ?string
    return plain.read(path, true)
end

-- @return true, or false and why not
local function write_file(path: string, content: string)
    return plain.write(path, content, true)
end

-- The release the last update installed: store/<name>/updater/installed.json
local function installed_file(o: table): table
    return new JsonFile($"{o.scripts_dir}store\\{o.name}\\updater\\installed.json")
end

-- @return { version, files }, or nil if nothing was installed by an update yet
function module.installed(opts: ?table): ?table
    local data = installed_file(options(opts)):read()
    if data == nil or type(data.files) ~= "table" then
        return nil
    end
    return data
end

-- ─── Downloading ─────────────────────────────────────────────────────────────

-- Characters a URL path can't have as they are: "%20" for a space
local function url_path(path: string): string
    return (path:gsub("[^%w%-%._~/]", |c| -> string.format("%%%02X", c:byte())))
end

-- "/Lirniri/Stand-AnitaDarin/main/src/lib/AnitaDarin/core/loader.pluto"
local function raw_path(o: table, path: string): string
    return url_path($"/{o.repo}/{o.branch}/{path}")
end

-- Whether a request is running: Stand's async_http holds one at a time, and a second init made while it
-- runs crashes Stand (the versions list asked twice at once, a check during a list)
local fetching = false
-- When the running request started, and which one it is: an answer that comes after its caller gave up
-- (or after a newer request took over) is told apart by its number and only frees the slot
local fetching_since = 0
local request_id = 0

-- How long a request may hold the slot before it's taken for lost (its answer never came), ms
local STUCK_MS = 60000

-- GETs https://<host><path> and waits for the answer, one request at a time: another thread's request
-- is waited for first. A request that timed out keeps the slot until its answer comes (or STUCK_MS passes),
-- as Stand can't cancel it and a new one started on top of it crashes Stand. Yields: call it from a thread
-- @return The body, or nil and why not
function module.fetch(host: string, path: string, timeout: int = 15000)

    local waiting_since = util.current_time_millis()

    while fetching do
        local now = util.current_time_millis()

        -- Its answer never came: the slot is taken back, and the old request's number no longer matches
        if now - fetching_since > STUCK_MS then
            break
        end
        if now - waiting_since > timeout then
            return nil, "timed out"
        end
        util.yield()
    end

    request_id += 1
    fetching = true
    fetching_since = util.current_time_millis()

    local mine = request_id
    local done, abandoned, body, err = false, false, nil, nil

    -- Frees the slot when this request is still the current one; the caller only hears of it if it still waits
    local function finish(result: ?string, reason: ?string): void
        if mine == request_id then
            fetching = false
        end
        if abandoned then
            return
        end
        body, err, done = result, reason, true
    end

    async_http.init(host, path, function(result, headers, status)
        if status ~= nil and status ~= 200 then
            finish(nil, $"HTTP {status}")
        else
            finish(result, nil)
        end
    end, function(reason)
        finish(nil, reason or "failed")
    end)

    async_http.dispatch()

    local started = util.current_time_millis()

    while not done do
        if util.current_time_millis() - started > timeout then
            -- The slot stays taken: the request is still running in Stand
            abandoned = true
            return nil, "timed out"
        end
        util.yield()
    end

    return body, err
end

-- ─── Check and apply ─────────────────────────────────────────────────────────

local function sorted_keys(tbl: table): table
    local keys = {}
    for key in pairs(tbl) do
        table.insert(keys, key)
    end
    table.sort(keys)
    return keys
end

-- What an update with this manifest would do, comparing it with the installed files (read from disk).
-- Yields now and then, the files being many: call it from a thread
-- @param o The options (see check)
-- @return { version, download = { paths }, remove = { paths }, skipped = { paths }, manifest, opts }:
-- download - missing or different (user data only when missing); remove - put there by the last update,
-- gone from this release; skipped - paths outside the script's places, never written
function module.plan(manifest: table, o: table): table
    local plan = {
        version = manifest.version,
        download = {}, remove = {}, skipped = {},
        manifest = manifest, opts = o
    }

    for i, path in ipairs(sorted_keys(manifest.files)) do
        local target = module.target_of(path, o)

        if target == nil then
            table.insert(plan.skipped, path)
        elseif module.is_user_data(path, o.project) then
            if not filesystem.exists(target) then
                table.insert(plan.download, path)
            end
        else
            local content = read_file(target)
            if content == nil or module.hash(path, content) ~= manifest.files[path].sha256 then
                table.insert(plan.download, path)
            end
        end

        if i % 25 == 0 then
            util.yield()
        end
    end
    -- Only what an update put there: a file the updater doesn't know of stays
    local installed = module.installed(o)

    if installed ~= nil then
        for _, path in ipairs(sorted_keys(installed.files)) do
            local target = module.target_of(path, o)
            if manifest.files[path] == nil and target ~= nil and not module.is_user_data(path, o.project)
                and filesystem.exists(target) then
                table.insert(plan.remove, path)
            end
        end
    end

    return plan
end

-- Whether the plan has nothing to do
function module.is_up_to_date(plan: table): bool
    return #plan.download == 0 and #plan.remove == 0
end

-- Whether the script may use the internet (Stand's Disable Internet Access is off)
function module.has_access(): bool
    return async_http.have_access == nil or async_http.have_access()
end

-- Downloads the release's manifest and compares it with the installed files. Yields: call it from a thread
-- @param opts Over DEFAULTS: name (the script's name, Atdar.name), scripts_dir, repo, branch, ...
-- @return The plan (see plan), or nil and why not
function module.check(opts: ?table)

    local o = options(opts)

    if not module.has_access() then
        return nil, $"the script has no internet access (turn off Disable Internet Access in Stand > Lua Scripts > {o.name})"
    end

    local body, err = module.fetch(o.host, raw_path(o, o.manifest), o.timeout)

    if body == nil then
        return nil, $"manifest: {err}"
    end

    local manifest = json_parser.decode(body)

    if type(manifest) ~= "table" or type(manifest.files) ~= "table" then
        return nil, "manifest: not a manifest"
    end

    if manifest.project ~= o.project then
        return nil, $"manifest: it's for '{tostring(manifest.project)}', not '{o.project}'"
    end

    if manifest.format ~= nil and manifest.format ~= module.FORMAT then
        return nil, $"manifest: format {tostring(manifest.format)} isn't supported, update the script by hand"
    end

    -- Every file needs its hash: one without it would fail the whole plan later
    for path, entry in pairs(manifest.files) do
        if type(path) ~= "string" or type(entry) ~= "table" or type(entry.sha256) ~= "string" then
            return nil, $"manifest: bad entry '{tostring(path)}'"
        end
    end

    return module.plan(manifest, o), nil
end

-- The versions released, from the repo's updater/versions.json. Yields: call it from a thread
-- @param opts As in check
-- @return Entries { version, branch }, newest first (branch: where it was released, nil in an older file), or nil
-- and why not
function module.versions(opts: ?table)

    local o = options(opts)

    if not module.has_access() then
        return nil, $"the script has no internet access (turn off Disable Internet Access in Stand > Lua Scripts > {o.name})"
    end

    local body, err = module.fetch(o.host, raw_path(o, o.versions), o.timeout)

    if body == nil then
        return nil, $"versions: {err}"
    end

    local data = json_parser.decode(body)

    if type(data) ~= "table" or type(data.versions) ~= "table" then
        return nil, "versions: not a list of versions"
    end

    local list = {}

    for _, entry in ipairs(data.versions) do
        if type(entry) == "string" then
            table.insert(list, { version = entry })
        elseif type(entry) == "table" and type(entry.version) == "string" then
            table.insert(list, { version = entry.version, branch = entry.branch })
        end
    end

    return list, nil
end

-- Remembers the release as installed when the plan has nothing to do: the files already match it (an install
-- by build.py, or a copy of the release), so the version is known and the next update knows what to remove
function module.remember(plan: table): void

    if not module.is_up_to_date(plan) then
        return
    end

    local installed = module.installed(plan.opts)

    if installed ~= nil and installed.version == plan.version then
        return
    end

    installed_file(plan.opts):write({ version = plan.version, files = plan.manifest.files })
end

-- Clears what a cut-off update left next to a file: .update (written, not put in place) is removed; .old (the
-- file set aside) is put back when the file itself is missing, else removed
function module.clean_leftovers(target: string): void

    os.remove($"{target}.update")

    if not filesystem.exists($"{target}.old") then
        return
    end

    if filesystem.exists(target) then
        os.remove($"{target}.old")
        return
    end

    os.rename($"{target}.old", target)
end

-- Undoes the swaps made so far: the old files come back, the new ones and the .update files go
-- @param swapped { target, had_old } of each file already replaced
-- @param written The .update paths written
function module.roll_back(swapped: table, written: table): void

    for _, item in ipairs(swapped) do
        os.remove(item.target)

        if item.had_old then
            os.rename($"{item.target}.old", item.target)
        end
    end

    for _, temp in ipairs(written) do
        os.remove(temp)
    end
end

-- Carries the plan out: downloads its files and checks each against the manifest; only when all came
-- right writes them (first next to their places, then over them) and removes the old ones, then
-- remembers the release as installed. Yields: call it from a thread. Restart the script after it
-- @param on_progress function(done, total) after each download; optional
-- @return true, or false and why not (nothing written then); a third value "stale" when a download
-- didn't match the manifest (GitHub's cache)
function module.apply(plan: table, on_progress: ?function)

    local o = plan.opts
    local contents = {}

    for i, path in ipairs(plan.download) do
        local body, err = module.fetch(o.host, raw_path(o, $"{o.src}/{path}"), o.timeout)
        if body == nil then
            return false, $"{path}: {err}"
        end

        -- GitHub may serve a file older than the manifest for a few minutes
        if module.hash(path, body) ~= plan.manifest.files[path].sha256 then
            return false, $"{path}: doesn't match the manifest, try again in a few minutes", "stale"
        end

        contents[path] = body

        if on_progress ~= nil then
            on_progress(i, #plan.download)
        end
    end

    -- Leftovers of an update that was cut off (a crash) are cleared first
    for _, path in ipairs(plan.download) do
        module.clean_leftovers(module.target_of(path, o))
    end

    -- Written next to their places first: a failure leaves the script as it was
    local written = {}
    for _, path in ipairs(plan.download) do

        local temp = module.target_of(path, o) .. ".update"
        local ok, err = write_file(temp, contents[path])

        if not ok then
            for _, done in ipairs(written) do
                os.remove(done)
            end
            return false, $"{path}: {err}"
        end
        
        table.insert(written, temp)
    end

    -- Each old file is set aside as .old and the new one put in its place; if any step fails, everything
    -- done goes back and the script stays as it was
    local swapped = {}

    for _, path in ipairs(plan.download) do

        local target = module.target_of(path, o)
        local had_old = filesystem.exists(target)

        if had_old and not os.rename(target, $"{target}.old") then
            module.roll_back(swapped, written)
            return false, $"{path}: couldn't replace the file (is it in use?). Nothing was changed"
        end

        if not os.rename($"{target}.update", target) then
            if had_old then
                os.rename($"{target}.old", target)
            end
            module.roll_back(swapped, written)
            return false, $"{path}: couldn't put the new file in place. Nothing was changed"
        end

        table.insert(swapped, { target = target, had_old = had_old })
    end

    -- All in place: the old copies aren't needed
    for _, item in ipairs(swapped) do
        os.remove($"{item.target}.old")
    end

    for _, path in ipairs(plan.remove) do
        os.remove(module.target_of(path, o))
    end

    -- The files are in place by now; a failed write is logged by JsonFile, and the next update then
    -- only doesn't know what to remove
    installed_file(o):write({ version = plan.version, files = plan.manifest.files })
    return true
end

return module
