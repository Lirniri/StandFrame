-- lib/AnitaDarin/core/filesystem/file.pluto
--
-- Plain files, read, written and removed the same way everywhere. JSON goes through core JsonFile,
-- which reads with this too.
--
--     local file = Atdar.loader.load("core/filesystem/file")
--     local text = file.read(path)               -- nil if it can't be opened
--     file.write(path, text)                     -- its folder made first
--     file.remove(path)                          -- whether one was there and is gone

local module = {}

-- @param binary Read as it is ("rb"); otherwise as text, Windows' \r\n given as \n
-- @return The whole content, or nil if the file can't be opened
function module.read(path: string, binary: bool = false): ?string
    local handle = io.open(path, binary ? "rb" : "r")
    if handle == nil then
        return nil
    end
    local content = handle:read("*a")
    handle:close()
    return content
end

-- Writes the whole file, its folder made when it isn't there
-- @param binary Written as it is ("wb"); otherwise as text
-- @return true, or false and why not
function module.write(path: string, content: string, binary: bool = false)
    local folder = path:match("^(.+)[\\/][^\\/]+$")
    if folder ~= nil and not filesystem.exists(folder) then
        filesystem.mkdirs(folder)
    end
    local handle, err = io.open(path, binary ? "wb" : "w")
    if handle == nil then
        return false, err
    end
    handle:write(content)
    handle:close()
    return true, nil
end

-- Pluto's os.remove says true for a file that isn't there too, so it's looked at before and after
-- @return Whether there was a file and it's gone now
function module.remove(path: string): bool
    if not filesystem.exists(path) then
        return false
    end
    os.remove(path)
    return not filesystem.exists(path)
end

return module
