-- lib/AnitaDarin/core/filesystem/json/file.pluto
--
-- One JSON file on disk, read and written safely. Every JSON file of the script goes through it.
--   - write() encodes before touching the file, so an encoding error (NaN, inf, a function, a cycle)
--     leaves the old file as it was
--   - the new text goes to <path>.tmp first; the old file becomes <path>.bak, then .tmp takes its place.
--     Doesn't rely on os.rename replacing an existing file: on Windows it may not
--   - read() of a damaged or missing file falls back to <path>.bak. Reading never changes files,
--     so a typo in a pack's language file doesn't make the file disappear
--   - a damaged file being replaced is kept as <path>.broken instead of .bak, so it never pushes out a good backup
--
-- Example:
--     local JsonFile = Atdar.loader.load("core/filesystem/json/file")
--     local file = new JsonFile($"{Atdar.filesystem.paths.store}config.json")
--     local data = file:read() or {}
--     data.profile = "main"
--     file:write(data)

local json = require "pluto:json"
-- Reading: strict, a cut-off file is no file (parsers/json)
local json_parser = Atdar.loader.load("parsers/json")
local Logger = Atdar.loader.load("core/logger")

-- Read with core/filesystem/file; written here, through .tmp and .bak
local plain = Atdar.loader.load("core/filesystem/file")
local read_text = plain.read

local log = new Logger("JsonFile")

local class JsonFile

    -- pretty: indented JSON, easier to edit by hand
    function __construct(path: string, pretty: bool = true)
        self.path = path
        self.pretty = pretty
    end

    function exists(): bool
        return filesystem.exists(self.path)
    end

    -- @return The file's table; nil if there is no file (or it's damaged) and no usable backup
    function read(): ?table
        local text = read_text(self.path)

        if text ~= nil then
            local data = json_parser.decode(text)
            if data ~= nil then
                return data
            end
        end

        local backup_text = read_text($"{self.path}.bak")
        local backup = backup_text ~= nil ? json_parser.decode(backup_text) : nil

        if text == nil then
            -- No file, e.g. the script stopped between the two renames of write()
            if backup ~= nil then
                log:info($"{self.path} is missing, loaded its backup")
            end
            return backup
        end
        if backup ~= nil then
            log:warn($"{self.path} is damaged, loaded its backup instead")
        else
            log:warn($"{self.path} is damaged and has no backup, it's ignored")
        end
        return backup
    end

    -- Encodes first, then replaces the file through <path>.tmp, keeping the previous one as <path>.bak
    -- pretty: overrides the instance's setting for this write
    -- @return Whether the file now holds the data
    function write(data: table, pretty: ?bool): bool
        if pretty == nil then
            pretty = self.pretty
        end

        local ok, text = pcall(json.encode, data, pretty ? "pretty" : nil)
        if not ok then
            log:error($"{self.path} not written, the data can't be stored as JSON: {text}")
            return false
        end

        local folder = self.path:match("^(.+)[\\/][^\\/]+$")
        if folder and not filesystem.exists(folder) then
            filesystem.mkdirs(folder)
        end

        local tmp = $"{self.path}.tmp"
        local file = io.open(tmp, "w")

        if not file then
            log:error($"{self.path} not written, can't create {tmp}")
            return false
        end

        local written = file:write(text)
        local closed = file:close()

        if not written or not closed then
            os.remove(tmp)
            log:error($"{self.path} not written, writing {tmp} failed")
            return false
        end

        -- Move the current file out of the way: os.rename may refuse to replace it
        local moved_to = nil

        if filesystem.exists(self.path) then
            local current = read_text(self.path)
            if current ~= nil and json_parser.decode(current) ~= nil then
                moved_to = $"{self.path}.bak"
            else
                moved_to = $"{self.path}.broken"
                log:warn($"{self.path} was damaged, kept as {moved_to}")
            end
            os.remove(moved_to)
            local moved, err = os.rename(self.path, moved_to)
            if not moved then
                os.remove(tmp)
                log:error($"{self.path} not written, can't move the old file to {moved_to}: {err}")
                return false
            end
        end

        local placed, err = os.rename(tmp, self.path)
        if not placed then
            -- Put the old file back so nothing is lost
            if moved_to then
                os.rename(moved_to, self.path)
            end
            os.remove(tmp)
            log:error($"{self.path} not written: {err}")
            return false
        end
        
        return true
    end

    -- Deletes the file together with its backup and leftovers
    function remove(): void
        for _, suffix in { "", ".bak", ".tmp", ".broken" } do
            os.remove(self.path .. suffix)
        end
    end

end

return JsonFile
