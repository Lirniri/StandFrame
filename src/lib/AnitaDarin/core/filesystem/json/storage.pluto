--[[
    JSON key-value storage on top of JsonFile (core/filesystem/json/file): same safe reads and writes

    Usage:
        local storage = Atdar.filesystem.json.storage

        -- Create an instance with its own table
        local t = storage.new()
        t.load("path/to/russian.json")
        t.get("menu.vehicle.explode", "Explode Vehicle")

        -- Or pass an existing table (e.g. from your own DB / store)
        local t2 = storage.new(my_existing_table)
        t2.get("some.key", "Fallback")
]]

local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Storage")

local module = {}

--- Creates a new independent storage instance.
--- @param initial_table table|nil  Optional ready-made table.
---                                 An empty one is created if omitted.
function module.new(initial_table: ?table)
    local instance = {}

    -- Each instance has its own table and file
    local data: table = initial_table or {}
    local file = nil

    --- Loads a JSON file and fills the instance table.
    --- A missing file is created empty; a damaged one falls back to its backup (JsonFile warns)
    function instance.load(path: string)
        file = new JsonFile(path)
        data = file:read() or {}
        if not file:exists() then
            file:write(data)
        end
    end

    --- Replaces the internal table with the given one (without reading a file).
    --- Useful when the data is already loaded from another source.
    function instance.set_table(tbl: table)
        data = tbl
    end

    --- Returns the instance's current internal table.
    function instance.get_table(): table
        return data
    end

    --- Resets the table and file.
    function instance.reset()
        data = {}
        file = nil
    end

    --- Returns the value for a key.
    --- If the key is missing, writes the fallback to the file and returns it.
    --- @param path         string     Key (e.g. "menu.vehicle.explode")
    --- @param default_val  any|nil    Default value; if nil, path itself is used
    --- @param write_pretty boolean|nil
    function instance.get(path: string, default_val: any|nil, write_pretty: ?bool): any
        if data[path] ~= nil then
            return data[path]
        end

        local fallback = (default_val and default_val ~= "") ? default_val : path

        -- Write the new key to the table and file
        data[path] = fallback

        if file then
            file:write(data, write_pretty ~= false)
        else
            log:info($"key '{path}' requested before load(), skipped writing to file")
        end

        return fallback
    end

    return instance
end

return module
