-- Translations through Stand's own label system, so Stand shows items in its language and
-- profiles store the English names (like Stand's own items) whatever language is shown.
--
-- Strings come from <source>/<language>.json files. The script's own strings live in
-- store/AnitaDarin/language/base/; a loaded menu adds its own folder on top (add_source) and takes it away on unload.
-- Keys are dot paths into nested JSON: "menu.self.godmode" -> { "menu": { "self": { "godmode": "..." } } }
-- en-us.json holds the English text, which is the label's identity; other files are its translations.

local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("i18n")

local ENGLISH = "en-us"

-- Stand's language codes that don't match the ISO code our files start with ("ja-jp" -> Stand's "jp")
local STAND_CODE_ALIASES = { ja = "jp" }

local module = {}

-- Searched from last to first, so a menu's strings win over the script's
local sources = {}
-- key -> label, reset whenever sources change since the text behind a key may change
local labels = {}
-- Every label made so far: label -> { key, english }. Never reset: items already in the menu keep
-- their labels, and set_language() has to reach them all
local made = {}
-- Missing keys already logged
local reported = {}
-- Language code chosen in the profile ("ru-ru"); nil follows Stand's language
local forced = nil
-- What set_language() was last asked for; applied again when Stand's language changes,
-- e.g. it couldn't be shown with Stand in English and now Stand isn't
local requested = nil
-- Called after the shown language changed (on_change), e.g. to rebuild texts made with text()
local listeners = {}

-- @return { [language code] = strings } for every <code>.json in dir; a damaged file gives no strings (JsonFile warns)
local function read_languages(dir: string): table
    local languages = {}
    if filesystem.is_dir(dir) then
        for _, path in ipairs(filesystem.list_files(dir)) do
            local code = path:match("([^\\/]+)%.json$")
            if code then
                languages[code] = new JsonFile(path):read() or {}
            end
        end
    end
    return languages
end

local function lookup(data: table, key: string)
    local value = data
    for part in key:gmatch("[^%.]+") do
        if type(value) ~= "table" then
            return nil
        end
        value = value[part]
    end
    return value
end

-- @return The string at key in language, newest source first
local function find(code: string, key: string): ?string
    for i = #sources, 1, -1 do
        local strings = sources[i].languages[code]
        local text = strings and lookup(strings, key)
        if type(text) == "string" then
            return text
        end
    end
    return nil
end

-- @return Every language code that has a file in any source, except English
local function translated_codes(): table
    local codes, seen = {}, {}
    for _, source in ipairs(sources) do
        for code in pairs(source.languages) do
            if code ~= ENGLISH and not seen[code] then
                seen[code] = true
                table.insert(codes, code)
            end
        end
    end
    return codes
end

-- "ru-ru" -> "ru", "ja-jp" -> "jp"
local function stand_code(code: string): string
    local base = code:match("^(%a+)") or code
    return STAND_CODE_ALIASES[base] or base
end

-- Our file code for Stand's current language (Stand's "ru" -> "ru-ru"), or nil if there's no file for it
local function current_code(): ?string
    local current = lang.get_current()
    for _, code in ipairs(translated_codes()) do
        if stand_code(code) == current then
            return code
        end
    end
    return nil
end

-- A chosen language is shown by giving its text to Stand as the translation into Stand's current
-- language. The label itself stays the English text, so Stand's profiles still match the items.
-- Without a chosen language this puts back the translation for Stand's language (or the English text)
local function apply_current(label: int, key: string, english: string): void
    local code = forced or current_code()
    local text = code and find(code, key) or english
    -- Fails for English (see can_choose_language); then there's nothing to put
    if pcall(lang.set_translate, lang.get_current()) then
        lang.translate(label, text)
    end
end

-- Whether a language other than Stand's can be shown. Stand takes no translations into English,
-- its source language ("Provided language has no data"), so with Stand in English the script follows it
function module.can_choose_language(): bool
    return pcall(lang.set_translate, lang.get_current())
end

-- Adds a folder with <language>.json files; its strings win over the ones added before it
-- @return Handle for remove_source
function module.add_source(dir: string, required: bool = false): table
    local source = { dir = dir, languages = read_languages(dir) }
    if required and not source.languages[ENGLISH] then
        log:warn($"language file not found: {dir}{ENGLISH}.json")
    end
    table.insert(sources, source)
    labels = {}
    return source
end

function module.remove_source(source: table): void
    for i, s in ipairs(sources) do
        if s == source then
            table.remove(sources, i)
            break
        end
    end
    labels = {}
end

-- @return Stand label for key, for menu items: Stand shows it in its language and profiles keep the English text.
-- English text comes from en-us.json, then fallback, then the key itself
function module.label(key: string, fallback: ?string = nil): int
    local cached = labels[key]
    if cached then
        return cached
    end

    local english = find(ENGLISH, key)
    if not english and not reported[key] then
        reported[key] = true
        log:debug($"no English text for '{key}'")
    end
    english = english or fallback or key

    local label = lang.find_registered(english)
    if label == 0 then
        label = lang.register(english)
    end
    -- Same English text means the same label, so its translations are shared too
    for _, code in ipairs(translated_codes()) do
        local text = find(code, key)
        if text then
            lang.set_translate(stand_code(code))
            lang.translate(label, text)
        end
    end
    made[label] = { key = key, english = english }
    if forced then
        apply_current(label, key, english)
    end

    labels[key] = label
    return label
end

-- @return Whether any source has a <code>.json file
function module.has_language(code: string): bool
    for _, source in ipairs(sources) do
        if source.languages[code] then
            return true
        end
    end
    return false
end

-- @return { { code, name } } for every language with a file, English first, the rest by name.
-- The name is the file's own "language_name", e.g. "Русский"
function module.languages(): table
    local list = {}
    local seen = {}
    for _, source in ipairs(sources) do
        for code in pairs(source.languages) do
            if not seen[code] then
                seen[code] = true
                table.insert(list, { code = code, name = find(code, "language_name") or code })
            end
        end
    end
    table.sort(list, function(a, b)
        if (a.code == ENGLISH) ~= (b.code == ENGLISH) then
            return a.code == ENGLISH
        end
        return a.name < b.name
    end)
    return list
end

-- Shows the script in one language whatever Stand's is; "auto" (or nil) follows Stand's language again.
-- Applies to items already in the menu too
function module.set_language(code: ?string): void
    if code == "auto" or code == "" then
        code = nil
    end
    requested = code
    if code and not module.has_language(code) then
        log:warn($"no language file '{code}.json', following Stand's language")
        code = nil
    end
    local can_choose = module.can_choose_language()
    if code and not can_choose then
        log:warn(module.text("profile.language.unavailable"))
        code = nil
    end
    forced = code
    -- With Stand in English nothing was ever put on the labels, so there's nothing to restore either
    if can_choose then
        for label, source in pairs(made) do
            apply_current(label, source.key, source.english)
        end
    end
    for _, fn in ipairs(listeners) do
        fn()
    end
end

-- fn() runs after the shown language changed: labels follow by themselves, texts from text() don't
function module.on_change(fn: function): void
    table.insert(listeners, fn)
end

-- @return The chosen language code, or nil when following Stand's language
function module.get_language(): ?string
    return forced
end

-- Stand's language can change while the script runs: the chosen language is put on its new language
-- (or becomes possible / impossible to show). A string compare per frame
local stand_language = lang.get_current()
util.create_tick_handler(function()
    local current = lang.get_current()
    if current ~= stand_language then
        stand_language = current
        if requested then
            module.set_language(requested)
        else
            -- Labels follow Stand by themselves; texts made with text() have to be made again
            for _, fn in ipairs(listeners) do
                fn()
            end
        end
    end
    return true
end)

-- @return Text for key in Stand's current language, for strings built from parts (format, concatenation)
function module.text(key: string, fallback: ?string = nil): string
    return lang.get_localised(module.label(key, fallback))
end

-- @return The English value at key as is (newest source first), or nil
function module.get(key: string)
    for i = #sources, 1, -1 do
        local strings = sources[i].languages[ENGLISH]
        local value = strings and lookup(strings, key)
        if value ~= nil then
            return value
        end
    end
    return nil
end

-- The script's own strings (independent menu and the rest), always there
module.add_source($"{Atdar.filesystem.paths.store}language\\base\\", true)

return module
