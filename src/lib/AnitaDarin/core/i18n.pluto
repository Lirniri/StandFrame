-- Translations through Stand's own label system, so Stand shows items in its language and
-- profiles store the English names (like Stand's own items) whatever language is shown.
--
-- Strings come from <source>/<language>.json files. The script's own strings live in
-- store/AnitaDarin/base/language/; a loaded menu adds its own folder on top (add_source) and takes it away on unload.
-- Keys are dot paths into nested JSON: "menu.self.godmode" -> { "menu": { "self": { "godmode": "..." } } }
-- en-us.json holds the English text, which is the label's identity; other files are its translations.

local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("i18n")

local ENGLISH = "en-us"

-- Stand's language codes that don't match the ISO code our files start with ("ja-jp" -> Stand's "jp")
local STAND_CODE_ALIASES = { ja = "jp" }

local module = {}

-- Searched from last to first, so a menu's strings win over the script's
local sources = {}
-- key -> label, reset whenever sources change since the text behind a key may change
local labels = {}
-- Every label made so far: label -> { key, english }. Never reset: items already in the menu keep
-- their labels, and set_language() has to reach them all
local made = {}
-- Missing keys already logged
local reported = {}
-- Language code chosen in the profile ("ru-ru"); nil follows Stand's language
local forced = nil
-- What set_language() was last asked for; applied again when Stand's language changes,
-- e.g. it couldn't be shown with Stand in English and now Stand isn't
local requested = nil
-- Show each string's key instead of its text (set_show_keys): a translator sees which key is which
local show_keys = false
-- Called after the shown language changed (on_change), e.g. to rebuild texts made with text()
local listeners = {}

-- A source's languages: files = { [code] = path } of every <code>.json in its folder, and languages =
-- { [code] = strings }, each file read and decoded the first time its strings are asked for. So a start
-- reads English and the language shown, not every translation there is. A damaged file gives no
-- strings (JsonFile warns)
local function read_languages(source: table): void
    local files = {}
    if filesystem.is_dir(source.dir) then
        for _, path in ipairs(filesystem.list_files(source.dir)) do
            local code = path:match("([^\\/]+)%.json$")
            if code then
                files[code] = path
            end
        end
    end
    source.files = files
    source.languages = setmetatable({}, {
        __index = function(languages, code)
            local path = files[code]
            if path == nil then
                return nil
            end
            local strings = new JsonFile(path):read() or {}
            rawset(languages, code, strings)
            return strings
        end,
    })
end

-- A language's name, its "language_name", without decoding the whole file when it isn't read yet:
-- the language list names every language, and needs nothing else from most of them
-- @return The name, or nil if the source doesn't have it
local function name_in(source: table, code: string): ?string
    local strings = rawget(source.languages, code)
    if strings ~= nil then
        local name = strings.language_name
        return type(name) == "string" and name or nil
    end
    local path = source.files[code]
    if path == nil then
        return nil
    end
    local text = Atdar.loader.load("core/filesystem/file").read(path)
    if text == nil then
        return nil
    end
    return text:match('"language_name"%s*:%s*"([^"\\]*)"')
end

local function lookup(data: table, key: string)
    local value = data
    for part in key:gmatch("[^%.]+") do
        if type(value) ~= "table" then
            return nil
        end
        value = value[part]
    end
    return value
end

-- The key as a source holds it: a source with a prefix ("module.VehicleManager") has only the keys under
-- it, with the prefix taken off ("module.VehicleManager.wreck" -> "wreck"); nil when the key isn't its
local function key_in(source: table, key: string): ?string
    local prefix = source.prefix
    if prefix == nil then
        return key
    end
    if key:sub(1, #prefix + 1) == $"{prefix}." then
        return key:sub(#prefix + 2)
    end
    return nil
end

-- @return The string at key in language, newest source first
local function find(code: string, key: string): ?string
    for i = #sources, 1, -1 do
        local source = sources[i]
        local strings = source.languages[code]
        local own_key = key_in(source, key)
        local text = strings and own_key and lookup(strings, own_key)
        if type(text) == "string" then
            return text
        end
    end
    return nil
end

-- @return Every language code that has a file in any source, except English (the files aren't read)
local function translated_codes(): table
    local codes, seen = {}, {}
    for _, source in ipairs(sources) do
        for code in pairs(source.files) do
            if code ~= ENGLISH and not seen[code] then
                seen[code] = true
                table.insert(codes, code)
            end
        end
    end
    return codes
end

-- "ru-ru" -> "ru", "ja-jp" -> "jp"
local function stand_code(code: string): string
    local base = code:match("^(%a+)") or code
    return STAND_CODE_ALIASES[base] or base
end

-- Our file code for Stand's current language (Stand's "ru" -> "ru-ru"), or nil if there's no file for it
local function current_code(): ?string
    local current = lang.get_current()
    for _, code in ipairs(translated_codes()) do
        if stand_code(code) == current then
            return code
        end
    end
    return nil
end

-- A chosen language is shown by giving its text to Stand as the translation into Stand's current
-- language. The label itself stays the English text, so Stand's profiles still match the items.
-- Without a chosen language this puts back the translation for Stand's language (or the English text)
local function apply_current(label: int, key: string, english: string): void
    local code = forced or current_code()
    local text = code and find(code, key) or english
    if show_keys then
        text = key
    end
    -- Fails for English (see can_choose_language); then there's nothing to put
    if pcall(lang.set_translate, lang.get_current()) then
        lang.translate(label, text)
    end
end

-- Puts the language's texts on every label made, as its translation into that language in Stand
local function translate_made(code: string): void
    -- A code Stand has no language for can't take translations: it's still there to be chosen
    if not pcall(lang.set_translate, stand_code(code)) then
        return
    end
    for label, entry in pairs(made) do
        local text = find(code, entry.key)
        if text then
            lang.translate(label, text)
        end
    end
end

-- Stand's language the labels made were last given their translations for. Only that language's file
-- is read: another language is read and put on the labels when Stand switches to it
local translated_for = nil

-- The labels made in Stand's current language, if they aren't yet (Stand switched since)
local function ensure_translated(): void
    local current = lang.get_current()
    if current == translated_for then
        return
    end
    translated_for = current
    local code = current_code()
    if code ~= nil then
        translate_made(code)
    end
end

-- Whether a language other than Stand's can be shown. Stand takes no translations into English,
-- its source language ("Provided language has no data"), so with Stand in English the script follows it
function module.can_choose_language(): bool
    return pcall(lang.set_translate, lang.get_current())
end

-- Adds a folder with <language>.json files; its strings win over the ones added before it.
-- prefix: the folder's keys are under it and it only answers for those ("module.VehicleManager":
-- its "wreck" is "module.VehicleManager.wreck"), so a module's strings never mix with anyone else's
-- @return Handle for remove_source
function module.add_source(dir: string, required: bool = false, prefix: ?string): table
    local source = { dir = dir, prefix = prefix }
    read_languages(source)
    -- English is read at once: every label needs it, and a damaged file is reported when it's added
    local english = source.languages[ENGLISH]
    if required and english == nil then
        log:warn($"language file not found: {dir}{ENGLISH}.json")
    end
    table.insert(sources, source)
    labels = {}
    return source
end

function module.remove_source(source: table): void
    for i, s in ipairs(sources) do
        if s == source then
            table.remove(sources, i)
            break
        end
    end
    labels = {}
end

-- @return Stand label for key, for menu items: Stand shows it in its language and profiles keep the English text.
-- English text comes from en-us.json, then fallback, then the key itself
function module.label(key: string, fallback: ?string = nil): int
    local cached = labels[key]
    if cached then
        return cached
    end

    local english = find(ENGLISH, key)
    if not english and not reported[key] then
        reported[key] = true
        log:debug($"no English text for '{key}'")
    end
    english = english or fallback or key

    local label = lang.find_registered(english)
    if label == 0 then
        label = lang.register(english)
    end
    made[label] = { key = key, english = english }
    -- Its translation into Stand's language now; same English text means the same label, so its
    -- translations are shared too. Other languages come when Stand switches to them (ensure_translated)
    ensure_translated()
    local code = current_code()
    local text = code and find(code, key)
    if text and pcall(lang.set_translate, stand_code(code)) then
        lang.translate(label, text)
    end
    if forced or show_keys then
        apply_current(label, key, english)
    end

    labels[key] = label
    return label
end

-- @return Whether any source has a <code>.json file
function module.has_language(code: string): bool
    for _, source in ipairs(sources) do
        if source.files[code] then
            return true
        end
    end
    return false
end

-- @return { { code, name } } for every language with a file, English first, the rest by name.
-- The name is the file's own "language_name", e.g. "Русский"
function module.languages(): table
    local list = {}
    local seen = {}
    for _, source in ipairs(sources) do
        for code in pairs(source.files) do
            if not seen[code] then
                seen[code] = true
                table.insert(list, { code = code, name = code })
            end
        end
    end
    -- The name, newest source first, read without decoding files not needed yet
    for _, language in ipairs(list) do
        for i = #sources, 1, -1 do
            local name = name_in(sources[i], language.code)
            if name ~= nil then
                language.name = name
                break
            end
        end
    end
    table.sort(list, function(a, b)
        if (a.code == ENGLISH) ~= (b.code == ENGLISH) then
            return a.code == ENGLISH
        end
        return a.name < b.name
    end)
    return list
end

-- Shows the script in one language whatever Stand's is; "auto" (or nil) follows Stand's language again.
-- Applies to items already in the menu too
function module.set_language(code: ?string): void
    if code == "auto" or code == "" then
        code = nil
    end
    requested = code
    if code and not module.has_language(code) then
        log:warn($"no language file '{code}.json', following Stand's language")
        code = nil
    end
    local can_choose = module.can_choose_language()
    if code and not can_choose then
        log:warn(module.text("profile.language.unavailable"))
        code = nil
    end
    forced = code
    -- With Stand in English nothing was ever put on the labels, so there's nothing to restore either
    if can_choose then
        for label, source in pairs(made) do
            apply_current(label, source.key, source.english)
        end
    end
    for _, fn in ipairs(listeners) do
        fn()
    end
end

-- Shows each string's key instead of its text, or the texts again. Like a chosen language it goes through
-- Stand's translations, so it can't be shown with Stand in English. Applies to items already in the menu too
-- @return false when it can't be shown (nothing changes), otherwise true
function module.set_show_keys(on: bool): bool
    local can_choose = module.can_choose_language()
    if on and not can_choose then
        log:warn(module.text("profile.translation.show_keys.unavailable"))
        return false
    end
    show_keys = on
    if can_choose then
        for label, entry in pairs(made) do
            apply_current(label, entry.key, entry.english)
        end
    end
    for _, fn in ipairs(listeners) do
        fn()
    end
    return true
end

-- @return Whether keys are shown instead of texts
function module.get_show_keys(): bool
    return show_keys
end

-- ─── Translations: made and read again while the script runs ─────────────────

-- "de-de", "pt-br", "zh-cn": a language and its country, as the files are named
local CODE_PATTERN = "^%l%l%l?%-%l%l$"

-- @return Whether code is written as a language file's name ("de-de")
function module.is_code(code: string): bool
    return code:match(CODE_PATTERN) ~= nil
end

-- Reads every source's files again: a translation made or edited shows without restarting the script.
-- Labels already in the menu get the new texts, the chosen language is put on them again
function module.reload(): void
    for _, source in ipairs(sources) do
        read_languages(source)
    end
    labels = {}
    translated_for = nil
    ensure_translated()
    module.set_language(requested)
end

-- Starts a translation: <code>.json in every folder with strings (the script's, the loaded menu's,
-- each module's), each a copy of that folder's from-language file to translate in place. The script's
-- gets language_name, the name shown in the language list. A folder that has the code already is left
-- as it is, so nothing translated is lost. The files are read again (reload) at the end
-- @param code The new language's code, "de-de" (is_code)
-- @param name Its name in the language list, "Deutsch"; "" or nil - the code
-- @param from The language copied, English if nil
-- @return How many files were made, or nil and why not: "code" (not a code like de-de), "exists"
function module.create_language(code: string, name: ?string, from: ?string)
    if not module.is_code(code) then
        return nil, "code"
    end
    if module.has_language(code) then
        return nil, "exists"
    end
    from = from or ENGLISH
    local made_count = 0
    for _, source in ipairs(sources) do
        local strings = source.languages[from] or source.languages[ENGLISH]
        if strings ~= nil and not filesystem.exists($"{source.dir}{code}.json") then
            local copy = {}
            for key, value in pairs(strings) do
                copy[key] = value
            end
            -- Only where the language's name lives: the script's own strings, not a module's prefixed ones
            if copy.language_name ~= nil then
                copy.language_name = (name ~= nil and name ~= "") and name or code
            end
            if new JsonFile($"{source.dir}{code}.json"):write(copy) then
                made_count += 1
            end
        end
    end
    module.reload()
    return made_count, nil
end

-- How far a translation has come: every English string (of every folder of strings) against the language's.
-- A string counts as translated when the language has one at its key and it isn't the English text; one
-- the same in both languages on purpose ("Stand", "%s") counts as not, the list shows it
-- @return { total, translated, missing = { keys, as the script asks for them } }
function module.progress(code: string): table
    local result = { total = 0, translated = 0, missing = {} }
    local function walk(english: table, translated, path: string, prefix: ?string): void
        for key, value in pairs(english) do
            local full = path == "" and tostring(key) or $"{path}.{tostring(key)}"
            local other = type(translated) == "table" and translated[key] or nil
            if type(value) == "table" then
                walk(value, other, full, prefix)
            elseif type(value) == "string" and full ~= "language_name" then
                result.total += 1
                if type(other) == "string" and other ~= value then
                    result.translated += 1
                else
                    table.insert(result.missing, prefix and $"{prefix}.{full}" or full)
                end
            end
        end
    end
    for _, source in ipairs(sources) do
        local english = source.languages[ENGLISH]
        if english ~= nil then
            walk(english, source.languages[code], "", source.prefix)
        end
    end
    table.sort(result.missing)
    return result
end

-- The folder of the script's own strings, where a translation's main file goes
function module.base_dir(): ?string
    local first = sources[1]
    return first and first.dir or nil
end

-- fn() runs after the shown language changed: labels follow by themselves, texts from text() don't
function module.on_change(fn: function): void
    table.insert(listeners, fn)
end

-- @return The chosen language code, or nil when following Stand's language
function module.get_language(): ?string
    return forced
end

-- Stand's language can change while the script runs: the chosen language is put on its new language
-- (or becomes possible / impossible to show). A string compare per frame
local stand_language = lang.get_current()
util.create_tick_handler(function()
    local current = lang.get_current()
    if current ~= stand_language then
        stand_language = current
        ensure_translated()
        if requested or show_keys then
            module.set_language(requested)
        else
            -- Labels follow Stand by themselves; texts made with text() have to be made again
            for _, fn in ipairs(listeners) do
                fn()
            end
        end
    end
    return true
end)

-- label and text for the keys under one part of the strings, so a file doesn't write its part each time:
--     local label, text = i18n.scope("modules")
--     label("title")   -- i18n.label("modules.title")
-- @return label(key, fallback), text(key, fallback)
function module.scope(part: string)
    return |key, fallback| -> module.label($"{part}.{key}", fallback),
        |key, fallback| -> module.text($"{part}.{key}", fallback)
end

-- @return Text for key in Stand's current language, for strings built from parts (format, concatenation)
function module.text(key: string, fallback: ?string = nil): string
    local label = module.label(key, fallback)
    ensure_translated()
    return lang.get_localised(label)
end

-- @return The English value at key as is (newest source first), or nil
function module.get(key: string)
    for i = #sources, 1, -1 do
        local strings = sources[i].languages[ENGLISH]
        local own_key = key_in(sources[i], key)
        local value = strings and own_key and lookup(strings, own_key)
        if value ~= nil then
            return value
        end
    end
    return nil
end

-- The script's own strings (independent menu and the rest), always there
module.add_source($"{Atdar.filesystem.paths.store}base\\language\\", true)

return module
