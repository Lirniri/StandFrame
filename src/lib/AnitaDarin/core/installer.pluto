-- Changes to the script's own installation, e.g. renaming it.
-- The script's name is its file's name (see the launcher), and its lib/store/resources folders carry the same name

local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Installer")

local module = {}

-- Letters, digits and _: the name is a file name and becomes Stand's command startlua<name>
function module.valid_name(name: string): bool
    return name:match("^[%w_]+$") ~= nil
end

-- @return { from, to } for every part of the installation that exists, the launcher first
local function rename_plan(old_name: string, new_name: string): table
    local scripts = filesystem.scripts_dir()
    local plan = {
        { from = $"{scripts}{old_name}.pluto", to = $"{scripts}{new_name}.pluto" },
    }

    for _, dir in ipairs({ $"{scripts}lib\\", filesystem.store_dir(), filesystem.resources_dir() }) do
        if filesystem.exists($"{dir}{old_name}") then
            table.insert(plan, { from = $"{dir}{old_name}", to = $"{dir}{new_name}" })
        end
    end

    return plan
end

-- Renames the launcher and the script's folders. Either everything is renamed or nothing:
-- a failed step undoes the ones before it, so the script is never left half-renamed
-- @return true, or false and a reason; a folder that couldn't be renamed comes third, from Lua Scripts on
function module.rename(new_name: string): (bool, string, ?string)

    local old_name = Atdar.name

    if not module.valid_name(new_name) then
        return false, $"'{new_name}' isn't a valid name, use letters, digits and _"
    end

    if new_name == old_name then
        return false, "the name is the same"
    end

    local plan = rename_plan(old_name, new_name)

    for _, step in ipairs(plan) do
        if filesystem.exists(step.to) then
            return false, $"{step.to} already exists"
        end
    end

    -- Windows can't rename a folder with an open file in it: the log file in store/<name>/logs.
    -- Closed first; if the rename fails it's written again (it stays closed after a rename: the script
    -- restarts under the new name)
    Logger.stop_file()
    local done = {}

    for _, step in ipairs(plan) do
        local ok, err = os.rename(step.from, step.to)
        if not ok then
            for i = #done, 1, -1 do
                os.rename(done[i].to, done[i].from)
            end
            Logger.resume_file()
            log:error($"rename failed at {step.from}: {err}; undone")
            -- Pluto's err is "operation failed" whatever the cause. A taken name was ruled out above and the
            -- folder is there, so something holds it or a folder inside it open: Explorer, an editor, a console
            if filesystem.is_dir(step.from) then
                return false, $"couldn't rename {step.from}", step.from:sub(#filesystem.scripts_dir() + 1)
            end
            return false, $"couldn't rename {step.from}"
        end
        table.insert(done, step)
    end

    log:info($"renamed {old_name} -> {new_name} ({#done} part(s))")
    -- Leaving: from here on notifications go to Stand only (utils/util.toast)
    Atdar.leaving = true
    return true, ""
end

-- Starts the script again under the same name: util.restart_script stops this copy and runs it anew.
-- A startlua<name> command can't do it: while the script runs Stand has no such command (it has stoplua<name>).
-- Not for a rename: it starts the file the script was started from, and that one is gone then (see stop:
-- the notice says to start the renamed script by hand, as Stand may not see its file until the list refreshes)
function module.restart(): void
    util.create_thread(function()
        util.yield()
        util.restart_script()
    end)
end


-- Pluto's io.remove also removes (empty) folders; plain Lua's os.remove can't on Windows
local remove_path = io.remove or os.remove

-- Whether a path inside store/<name>/ is the user's data, written by the script while it runs:
-- config.json (and its .bak), profiles/ and user/ (the user's own data: short names, saved functions)
local function is_user_data(relative: string): bool
    local first = relative:match("^[\\/]*([^\\/]+)")
    return first == "profiles" or first == "user" or (first ~= nil and first:match("^config%.json") ~= nil)
end

-- Deletes a folder with everything in it: files first, then the folders from the deepest up.
-- keep(relative_path): files and folders it says yes to stay (and so do the folders holding them)
-- @return Number of files deleted, and whether the folder itself is gone
local function remove_tree(dir: string, keep: ?function = nil): (int, bool)
    local files, folders = {}, {}
    local function collect(path: string)
        for _, child in ipairs(filesystem.list_files(path)) do
            if keep and keep(child:sub(#dir + 1)) then
                -- kept, with everything inside it
            elseif filesystem.is_dir(child) then
                collect($"{child}\\")
                table.insert(folders, child)
            else
                table.insert(files, child)
            end
        end
    end
    collect(dir)
    local removed = 0
    for _, file in ipairs(files) do
        if os.remove(file) then
            removed += 1
        end
    end
    -- A folder is added after everything inside it, so in this order every folder is already empty
    for _, folder in ipairs(folders) do
        pcall(remove_path, folder)
    end
    pcall(remove_path, dir)
    return removed, not filesystem.exists(dir)
end

-- Deletes the script: its launcher and its lib, store and resources folders. keep_user_data keeps
-- the profiles, user/ and config.json in store (what build.py never touches either), so a reinstall finds them.
-- Can't be undone; the menu asks first. The script keeps running from memory until stop()
-- @return true and the number of deleted files, or false and a reason
function module.delete(keep_user_data: bool = true): (bool, any)

    local name = Atdar.name

    -- The name is part of every path below: never delete with an empty or odd one
    if not module.valid_name(name) then
        return false, $"'{name}' isn't a valid script name"
    end

    local scripts = filesystem.scripts_dir()
    local store = $"{filesystem.store_dir()}{name}\\"

    -- The open log file would stay behind (and lines after this would make it again)
    Logger.stop_file()

    local removed = 0
    local left = {}

    for _, dir in ipairs({ $"{scripts}lib\\{name}\\", store, $"{filesystem.resources_dir()}{name}\\" }) do
        if filesystem.exists(dir) then
            local keep = (keep_user_data and dir == store) ? is_user_data : nil
            local count, gone = remove_tree(dir, keep)
            removed += count
            -- store stays on purpose when its user data is kept
            if not gone and not keep then
                table.insert(left, dir)
            end
        end
    end

    local launcher = $"{scripts}{name}.pluto"

    if filesystem.exists(launcher) and os.remove(launcher) then
        removed += 1
    end
    if #left > 0 then
        log:warn($"deleted {removed} file(s); empty folders left behind: {table.concat(left, ', ')}")
    else
        log:info($"deleted {name}: {removed} file(s)")
    end

    -- Leaving: from here on notifications go to Stand only (utils/util.toast)
    Atdar.leaving = true
    
    return true, removed
end

-- Stops this script, e.g. after it was deleted
function module.stop(): void
    util.create_thread(function()
        util.yield()
        util.stop_script()
    end)
end

return module
