-- lib/AnitaDarin/core/module_manager.pluto
-- Loads modules, orders them by dependencies and manages their lifecycle.

local Module = require($"{Atdar.name}/core/module")
local paths = require($"{Atdar.name}/core/filesystem/paths")

local class ModuleManager
    function __construct()
        self.modules = {} -- name -> instance
        self.order = {}   -- instances in init order
        self.ticking = {} -- instances that override on_tick
    end

    function log(msg)
        Atdar.logger:log(msg)
    end

    function fail(mod, err)
        mod.status = "failed"
        mod.error = err
        self:log($"[{mod.name}] error: {err}")
        Atdar.util.toast($"Module '{mod.name}' disabled\n{err}")
    end

    function get(name)
        local mod = self.modules[name]
        if mod ~= nil and mod.status == "ready" then
            return mod
        end
        return nil
    end

    -- Registers a module class, returns the instance or nil
    function register(cls)
        local mod = new cls(self)

        if type(mod.name) ~= "string" or mod.name == "" then
            self:log("unnamed module skipped")
            return nil
        end
        if self.modules[mod.name] ~= nil then
            self:log($"module '{mod.name}' is already registered, duplicate skipped")
            return nil
        end

        self.modules[mod.name] = mod
        return mod
    end

    -- Requires a module file that returns a class
    function load(path)
        local ok, cls = pcall(require, path)
        if not ok then
            self:log($"failed to load '{path}': {cls}")
            return nil
        end
        if type(cls) ~= "table" then
            self:log($"'{path}' must return a module class")
            return nil
        end
        return self:register(cls)
    end

    -- Requires all .pluto files from lib/<name>/<rel>, including subfolders
    function load_dir(rel)
        local dir = paths.lib .. (rel:gsub("/", "\\"))
        if not filesystem.is_dir(dir) then
            self:log($"module folder not found: {dir}")
            return
        end

        local files, dirs = {}, {}
        for _, path in filesystem.list_files(dir) do
            local entry = path:match("([^\\/]+)$")
            if filesystem.is_dir(path) then
                table.insert(dirs, entry)
            else
                local file = entry:match("^(.+)%.pluto$")
                if file ~= nil then
                    table.insert(files, file)
                end
            end
        end
        table.sort(files)
        table.sort(dirs)

        for _, file in files do
            self:load($"{Atdar.name}/{rel}/{file}")
        end
        for _, sub in dirs do
            self:load_dir($"{rel}/{sub}")
        end
    end

    -- Topological sort; modules with broken dependencies are marked failed
    function resolve_order()
        local order, state = {}, {}

        local function visit(mod)
            local s = state[mod.name]
            if s == "done" then return true end
            if s == "failed" then return false end
            if s == "visiting" then
                self:fail(mod, "circular dependency")
                return false
            end

            state[mod.name] = "visiting"
            for _, dep_name in mod.deps do
                local dep = self.modules[dep_name]
                if dep == nil then
                    self:fail(mod, $"missing dependency '{dep_name}'")
                    state[mod.name] = "failed"
                    return false
                end
                if not visit(dep) then
                    if mod.status ~= "failed" then
                        self:fail(mod, $"dependency '{dep_name}' failed to load")
                    end
                    state[mod.name] = "failed"
                    return false
                end
            end

            state[mod.name] = "done"
            table.insert(order, mod)
            return true
        end

        local names = {}
        for name in self.modules do
            table.insert(names, name)
        end
        table.sort(names)

        for _, name in names do
            visit(self.modules[name])
        end
        return order
    end

    function start()
        for _, mod in self:resolve_order() do
            local ok, err = pcall(mod.init, mod)
            if not ok then
                self:fail(mod, err)
                continue
            end
            mod.status = "ready"
            table.insert(self.order, mod)

            if mod.on_tick ~= Module.on_tick then
                table.insert(self.ticking, mod)
            end
        end

        util.create_tick_handler(function()
            for _, mod in self.ticking do
                if mod.status == "ready" and mod.enabled then
                    local ok, err = pcall(mod.on_tick, mod)
                    if not ok then self:fail(mod, err) end
                end
            end
        end)

        util.on_stop(function() self:stop() end)

        self:log($"modules started: {#self.order}")
    end

    -- Stops in reverse order so dependencies outlive their dependents
    function stop()
        for i = #self.order, 1, -1 do
            local mod = self.order[i]
            local ok, err = pcall(mod.shutdown, mod)
            if not ok then self:log($"[{mod.name}] error on shutdown: {err}") end
        end
    end
end

return ModuleManager
