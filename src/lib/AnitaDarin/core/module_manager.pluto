-- lib/AnitaDarin/core/module_manager.pluto
--
-- Keeps the script's modules (core/module): starts them in dependency order, ticks the ones that tick
-- and stops them in reverse order when the script stops. Available as Atdar.modules.
--
-- A module on disk is found by its manifest (core/module_manifest: info.json or <name>.info.json), wherever it
-- lies under a folder load_dir reads. Reading the manifests runs no module code: each gets a stand-in, a Module
-- made from the manifest alone (loaded = false). The module's file runs when the module is first started,
-- and registers the real module in the stand-in's place:
--     return Atdar.modules.add(new Module({ on_tick = function(self) ... end }))
-- A manifest whose entry file isn't there registers a failed stand-in with the reason: Start (or Refresh) looks
-- for the file again.
-- A module's other files (in its folder) are loaded with load_file (self:load_file in a Module): run again for
-- every new instance, so Reload takes their changes too, and watched by file_changed like the entry
-- A .pluto file without a manifest isn't a module: it's never run from here.
-- A module made in code (no file) is added the same way, with a name: new Module({ name = "players" })

local Logger = Atdar.loader.load("core/logger")
local Module = Atdar.loader.load("core/module")
local manifest_reader = Atdar.loader.load("core/module_manifest")

local log = new Logger("Modules")

local module = {}

local by_name = {}

-- Registration order: modules without deps between them start in this order
local order = {}

-- Start order; stop() goes through it backwards, so a module stops before the modules it needs
local started = {}
local tick_handler_created = false

-- Module name -> its file (the manifest's entry), so reload_module() can run it again
local files = {}

-- Module name -> its manifest (core/module_manifest.read)
local manifests = {}

-- Manifest file -> the name of the module registered from it; load_dir and load_new skip these
local manifest_paths = {}

-- The manifest whose file run_entry() is running right now; add() takes the module the file registers for it
local loading = nil

-- Module file -> its text as it was when the code running now was read from it (file_changed)
local loaded_text = {}

-- Module file -> its text when it was run last, even if it failed (file_changed: a failed module whose file
-- was edited since is worth another try)
local attempted = {}

-- Module name -> the other files it loaded (load_file): { [path] = its text when it ran }
local extra_files = {}

-- The folders load_dir read, for load_new to look at again
local dirs = {}

-- Module name -> what its last instance handed over for the next one (hand_over / take_over)
local handed = {}

-- The subfolder of a modules folder with the system modules (is_system)
local SYSTEMS = "systems/"

-- The path with / and in lower case, so paths written either way compare equal
local function normalized(path: string): string
    return (path:gsub("\\", "/")):lower()
end

-- The systems\ folder of each folder load_dir read, normalized and ending in /: what a system module's manifest
-- starts with
local system_roots = {}

-- @return The systems folder of dir, as system_roots keeps it
local function system_root(dir: string): string

    local root = normalized(dir)

    if not root:endswith("/") then
        root ..= "/"
    end

    -- A systems\ folder read on its own (the tests load modules/systems\ alone)
    if not root:endswith($"/{SYSTEMS}") then
        root ..= SYSTEMS
    end

    return root
end

-- Whether the manifest makes a system module: it says so, or it's under one of system_roots
local function is_system_manifest(manifest: table): bool

    local file = normalized(manifest.path)

    if manifest.system then
        return true
    end

    for _, root in ipairs(system_roots) do
        if file:startswith(root) then
            return true
        end
    end

    return false
end

-- File -> its stamp (stamp_of) when its text was last seen to be the one in use: while the stamp
-- stays, file_changed doesn't read the file
local same_stamp = {}

-- The file's write time and size, as core/file_watch stamps a file
-- @return nil when it can't be told or can't be trusted: the file was written this very second, and another
-- write in the same second (of the same size) would leave the same stamp
local function stamp_of(path: string): ?string

    local ok_time, written = pcall(io.writetime, path)
    local ok_size, size = pcall(io.filesize, path)

    if not ok_time or not ok_size or type(written) ~= "number" then
        return nil
    end

    if written >= os.time() then
        return nil
    end

    return $"{written}:{size}"
end

-- The file's whole text, nil if it can't be read
local read_text = Atdar.loader.load("core/filesystem/file").read

-- Dep name -> set of the modules that need it directly: { [dep] = { [module name] = true } }.
-- Kept up to date by add/unregister/register_at, so dependents_of doesn't scan every module
local dependents = {}

-- Adds the module to the dependents index
local function index_deps(mod: table): void
    for _, dep in ipairs(mod.deps) do
        dependents[dep] ??= {}
        dependents[dep][mod.name] = true
    end
end

-- Takes the module out of the dependents index
local function unindex_deps(mod: table): void
    for _, dep in ipairs(mod.deps) do
        local set = dependents[dep]
        if set then
            set[mod.name] = nil
            if next(set) == nil then
                dependents[dep] = nil
            end
        end
    end
end

-- Puts the module where its stand-in was: the same place in the order, the deps indexed again
local function replace(old: table, fresh: table): void

    for i, other in ipairs(order) do
        if other == old then
            order[i] = fresh
            break
        end
    end

    unindex_deps(old)
    by_name[fresh.name] = fresh
    index_deps(fresh)
end

-- Registers a module. Called by a module's file while it runs for its manifest, the module takes what the manifest
-- says and the place of its stand-in; called by other code, it's a module made in code
function module.add(mod: table): table

    local name = mod.name
    local manifest = loading
    local current = by_name[name]

    if type(name) ~= "string" then
        error("[Modules] a module needs a name, create it with new Module({ name = ... })")
    end

    if manifest ~= nil and name ~= manifest.id then
        error($"[Modules] the file of module '{manifest.id}' registers '{name}': the name must be the manifest's id")
    end

    if current ~= nil and (manifest == nil or current.loaded) then
        error($"[Modules] module '{name}' is already registered")
    end

    if manifest ~= nil then
        mod:_apply_manifest(manifest)
        mod.system = is_system_manifest(manifest)
    end

    if current ~= nil then
        replace(current, mod)
        return mod
    end

    by_name[name] = mod
    table.insert(order, mod)
    index_deps(mod)
    files[name] = manifest?.entry
    return mod
end

-- The id of the module whose file is running right now, nil outside of one: a Module made without a name takes it
function module.loading_id(): ?string
    return loading?.id
end

-- The module's file (its manifest's entry), nil for one made in code (not by load_dir)
function module.file_of(name: string): ?string
    return files[name]
end

-- The module's manifest as core/module_manifest read it, nil for one made in code. Don't change it
function module.manifest_of(name: string): ?table
    return manifests[name]
end

-- The folder of the module's manifest, ending in a slash; nil for one made in code
function module.folder_of(name: string): ?string
    return manifests[name]?.dir
end

-- Whether it's a system module: its manifest says "system": true, or lies in systems\ of a folder load_dir read
-- (lib/<script>/modules/systems/), or load_dir read that systems\ folder itself. The script's own menus use them;
-- the Modules list shows them only when asked
-- @return false for a module made in code
function module.is_system(name: string): bool

    local mod = by_name[name]

    if mod == nil then
        return false
    end

    return mod.system == true
end

-- The text the code running now was read from (the file may be edited since): its line numbers are
-- the ones debug.getinfo gives for the module's functions
-- @return nil for a file that isn't a module file or hasn't run
function module.loaded_text_of(path: string): ?string
    return loaded_text[path]
end

function module.get(name: string): table
    local mod = by_name[name]
    if not mod then
        error($"[Modules] unknown module '{name}'")
    end
    return mod
end

-- Whether there's such a module and it's running
function module.is_running(name: string): bool

    local mod = by_name[name]

    if mod == nil then
        return false
    end

    return mod:is_running()
end

-- Keeps data for the module's next instance: its on_stop hands over what Reload (a new instance from its
-- file) should keep. Lives as long as the script runs; a new start of the script begins without any
function module.hand_over(name: string, data: table): void
    handed[name] = data
end

-- What the module's last instance handed over, taken once (its __construct)
-- @return nil if nothing was
function module.take_over(name: string): ?table

    local data = handed[name]

    handed[name] = nil
    return data
end

function module.has(name: string): bool
    return by_name[name] ~= nil
end

-- @return Module names in registration order
function module.names(): table
    local names = {}
    for _, mod in ipairs(order) do
        table.insert(names, mod.name)
    end
    return names
end

-- Makes the manifest the module's: its fields, dependencies and entry
local function take_manifest(mod: table, manifest: table): void
    unindex_deps(mod)
    mod.deps = {}
    mod:_apply_manifest(manifest)
    mod.system = is_system_manifest(manifest)
    index_deps(mod)
    manifests[mod.name] = manifest
    files[mod.name] = manifest.entry
    same_stamp[manifest.path] = nil
end

-- Runs a module's file for its manifest: what it registers (add) is that manifest's module
-- @return Whether it ran without errors, and the error when it didn't
local function run_entry(manifest: table)

    local path = manifest.entry
    local text = read_text(path)

    attempted[path] = text

    -- Timed (loader.report): compiling and running the file, with the lib files it loads
    local ok, err = Atdar.loader.measure(path, function()
        local chunk, load_err = loadfile(path)
        if not chunk then
            return false, load_err
        end

        -- Put back after: a module's file may start another module, whose file runs inside this one
        local outer = loading

        loading = manifest
        local run_ok, run_err = pcall(chunk)
        loading = outer
        return run_ok, run_err
    end)

    if not ok then
        return false, tostring(err)
    end

    -- Only code that ran: after a failed reload the old code runs, and the file still differs from it
    loaded_text[path] = text
    same_stamp[path] = nil
    return true
end

-- Runs the file of a module that's still a stand-in. A file that fails or registers nothing marks the stand-in
-- failed; Start tries it again
-- @return The module the file registered, nil if there's none
local function load_module(stand_in: table): ?table

    local manifest = manifests[stand_in.name]

    -- No entry file when the manifest was read: it may be there by now
    if manifest.entry == nil then

        local again = manifest_reader.read(manifest.path)

        if again ~= nil and again.id == stand_in.name then
            take_manifest(stand_in, again)
            manifest = again
        end
    end

    if manifest.entry == nil then
        stand_in:fail(manifest.problem)
        return nil
    end

    local ok, err = run_entry(manifest)
    local fresh = by_name[stand_in.name]

    if ok and fresh ~= stand_in then
        return fresh
    end

    -- Registered, then failed: not a module to keep
    if fresh ~= stand_in then
        replace(fresh, stand_in)
    end

    if ok then
        err = "the file didn't register the module (Atdar.modules.add)"
    end

    stand_in:fail($"{manifest.entry} failed\n{err}")
    return nil
end

-- Loads the module's file if it hasn't run yet, then starts the module's deps first.
-- chain: names being started right now, in order; a name met twice is a dependency cycle
local function start_one(mod: table, chain: table): bool
    if mod.status == "running" then
        return true
    end

    if mod.status == "failed" then
        return false
    end

    for i, name in ipairs(chain) do
        if name == mod.name then

            local cycle = {}

            for j = i, #chain do
                table.insert(cycle, chain[j])
            end

            table.insert(cycle, mod.name)

            log:error($"dependency cycle: {table.concat(cycle, ' -> ')}")
            return false
        end
    end

    if not mod.loaded then
        mod = load_module(mod)
        if mod == nil then
            return false
        end
    end

    table.insert(chain, mod.name)
    for _, dep in ipairs(mod.deps) do

        local dep_mod = by_name[dep]

        if not dep_mod then
            mod:fail($"needs module '{dep}', which isn't registered")
        elseif not start_one(dep_mod, chain) then
            mod:fail($"needs module '{dep}', which didn't start")
        end

        if mod.status == "failed" then
            table.remove(chain)
            return false
        end
    end
    table.remove(chain)

    if not mod:start() then
        return false
    end
    table.insert(started, mod)
    return true
end

-- One handler for all modules, created on the first start
local function create_tick_handler(): void
    if tick_handler_created then
        return
    end

    tick_handler_created = true

    util.create_tick_handler(function()
        for _, mod in ipairs(started) do
            -- Fields, not is_running() and has_tick(): this runs for every module every frame
            if mod.status == "running" and mod._ticks then
                mod:tick()
            end
        end
        return true
    end)
end

-- Starts every registered module that isn't running yet; can be called again after more modules are added.
-- A module whose dep is missing or failed is marked failed, the others still start. One whose manifest says
-- "enabled": false is left alone, unless a module that starts needs it
-- @return Number of running modules
function module.start(): int

    -- By name: a stand-in is replaced in the order while its file runs
    for _, name in ipairs(module.names()) do

        local mod = by_name[name]

        if mod ~= nil and mod.enabled then
            start_one(mod, {})
        end
    end

    create_tick_handler()

    local running = 0

    for _, mod in ipairs(order) do
        if mod:is_running() then
            running += 1
        end
    end

    log:debug($"{running} of {#order} module(s) running")
    return running
end

-- Stops the running modules, the last started first
function module.stop(): void
    for i = #started, 1, -1 do
        started[i]:stop()
    end
    started = {}
end

-- Takes a module out of the start order, so a later start doesn't tick it twice
local function forget(mod: table): void
    for i = #started, 1, -1 do
        if started[i] == mod then
            table.remove(started, i)
        end
    end
end

-- @return Set of modules that need `name`, directly or through other modules: { [name] = true }
local function dependents_of(name: string): table

    local found = {}
    local queue = { name }

    while #queue > 0 do

        local current = table.remove(queue)

        for dependent in pairs(dependents[current] or {}) do
            if not found[dependent] then
                found[dependent] = true
                table.insert(queue, dependent)
            end
        end
    end

    return found
end

-- Starts one module and its deps. A failed module gets another try
-- @return Whether it's running afterwards
function module.start_module(name: string): bool

    local mod = module.get(name)

    if mod.status == "failed" then
        -- A module that failed in its tick is still in the start order
        forget(mod)
        mod.status = "registered"
        mod.error = nil
    end

    local ok = start_one(mod, {})
    create_tick_handler()
    return ok
end

-- Stops one module; the modules that need it stop first, so none keeps running without its dep
function module.stop_module(name: string): void

    local to_stop = dependents_of(name)
    to_stop[module.get(name).name] = true

    -- Backwards: a module started after its deps, so it stops before them
    for i = #started, 1, -1 do
        local mod = started[i]
        if to_stop[mod.name] then
            mod:stop()
            table.remove(started, i)
        end
    end
end

-- Whether the file's text isn't `text` any more. The file is read only when its write time or size isn't the one
-- it had when it was last compared: a file written again with the same text (a sync, a build) still isn't changed
local function differs(path: string, text: ?string): bool

    local stamp = stamp_of(path)

    if stamp ~= nil and stamp == same_stamp[path] then
        return false
    end

    if read_text(path) ~= text then
        same_stamp[path] = nil
        return true
    end

    same_stamp[path] = stamp

    return false
end

-- Whether the module's file or its manifest differs from what's in use (edited or synced since, so Reload would
-- run something new). For a module whose file failed and never ran: whether the file was edited since that try.
-- Meant for the menu, not for every frame
-- @return false for a module made in code (no file) and for one whose file hasn't been run yet
function module.file_changed(name: string): bool

    local path = files[name]
    local manifest = manifests[name]

    if manifest == nil then
        return false
    end

    -- No entry file: only the manifest can change
    if path == nil then
        return differs(manifest.path, manifest.text)
    end

    local text = loaded_text[path] or attempted[path]

    if text == nil then
        return false
    end

    if differs(path, text) or differs(manifest.path, manifest.text) then
        return true
    end

    for extra, extra_text in pairs(extra_files[name] or {}) do
        if differs(extra, extra_text) then
            return true
        end
    end

    return false
end

-- Runs another file of the module, from its folder: load_file("OutfitManager/Outfit") runs
-- <the manifest's folder>/OutfitManager/Outfit.pluto and gives what it returns. Not kept like a lib file
-- (Atdar.loader.load): every call runs the file, so a reloaded module gets its files' new code. The file
-- is watched by file_changed, and its functions' source is found like the entry's.
-- An error in the file is the caller's: in a module's __construct or on_start it fails the module with the reason
-- @param relative The file from the module's folder, without .pluto; can't go out of the folder
-- @param name The module; the one whose file is running right now when not given
function module.load_file(relative: string, name: ?string)

    local id = name ?? loading?.id
    local manifest = manifests[id]

    if manifest == nil then
        error($"[Modules] load_file '{relative}': '{tostring(id)}' isn't a module with a folder", 2)
    end

    local path, why = Atdar.loader.load("core/filesystem/safe_path").resolve(manifest.dir, $"{relative}.pluto")

    if path == nil then
        error($"[Module '{id}'] load_file '{relative}': {why}", 2)
    end

    local text = read_text(path)
    local chunk, load_err = loadfile(path)

    if not chunk then
        error($"[Module '{id}'] load_file '{relative}': {load_err}", 2)
    end

    local result = Atdar.loader.measure(path, chunk)

    loaded_text[path] = text
    same_stamp[path] = nil
    extra_files[id] ??= {}
    extra_files[id][path] = text

    return result
end

-- Reads a manifest and registers its module as a stand-in; the module's file isn't run. A manifest that can't be
-- used (broken JSON, a wrong field, no entry file) or names a module that's already there is logged and skipped
-- @return Whether the module was registered
local function register(path: string): bool

    local manifest, why = manifest_reader.read(path)

    if manifest == nil then
        log:error($"module manifest skipped: {path}\n{why}")
        return false
    end

    local id = manifest.id

    if by_name[id] ~= nil then
        log:warn($"module '{id}' is already registered, the duplicate is skipped: {path}")
        return false
    end

    local stand_in = new Module({ name = id })

    stand_in.loaded = false
    stand_in:_apply_manifest(manifest)
    stand_in.system = is_system_manifest(manifest)

    manifests[id] = manifest
    manifest_paths[path] = id
    same_stamp[path] = nil
    by_name[id] = stand_in
    table.insert(order, stand_in)
    index_deps(stand_in)
    files[id] = manifest.entry

    -- Registered all the same, so the Modules list shows it with the reason
    if manifest.entry == nil then
        stand_in:fail($"{manifest.problem} ({path})")
    end

    return true
end

-- Registers the modules whose manifests are under dir, the ones not registered yet
-- @return How many were registered
local function register_dir(dir: string): int

    local registered = 0

    for _, path in ipairs(manifest_reader.find(dir)) do
        if manifest_paths[path] == nil and register(path) then
            registered += 1
        end
    end

    return registered
end

-- Registers the module of every manifest in dir and its subfolders, without running the modules' files; a broken
-- manifest skips only itself
-- @return Number of modules registered
function module.load_dir(dir: string): int
    if not filesystem.is_dir(dir) then
        return 0
    end

    local known = false
    for _, other in ipairs(dirs) do
        if other == dir then
            known = true
        end
    end

    if not known then
        table.insert(dirs, dir)
        table.insert(system_roots, system_root(dir))
    end

    return register_dir(dir)
end

-- Registers the modules whose manifests came into the folders load_dir read since (a new one, or one that
-- couldn't be used before), then starts them
-- @return How many modules were registered
function module.load_new(): int

    local before = #order

    -- The modules registered without their entry file: started if it's there by now
    for _, name in ipairs(module.names()) do

        local manifest = manifests[name]

        if manifest ~= nil and manifest.entry == nil and manifest_reader.read(manifest.path)?.entry ~= nil then
            module.start_module(name)
        end
    end

    for _, dir in ipairs(dirs) do
        register_dir(dir)
    end

    local names = module.names()
    local added = #names - before

    -- Only the new ones: start() would also bring back the modules stopped by hand (Stop All)
    for i = before + 1, #names do
        if by_name[names[i]].enabled then
            module.start_module(names[i])
        end
    end

    return added
end

-- Puts a module back into by_name/order/files, at its old place in the order
local function register_at(mod: table, index: int, path: ?string): void
    by_name[mod.name] = mod
    table.insert(order, math.min(index, #order + 1), mod)
    index_deps(mod)
    files[mod.name] = path
end

-- Takes a module out of by_name/order/files
-- @return Its index in the order
local function unregister(mod: table): int
    local index = #order + 1
    for i, other in ipairs(order) do
        if other == mod then
            index = i
            table.remove(order, i)
            break
        end
    end
    unindex_deps(mod)
    by_name[mod.name] = nil
    files[mod.name] = nil
    return index
end

-- The module's manifest read again, for a reload. One that can't be used any more, or has another id now
-- (a new id is a new module: it needs a restart of the script), is logged and the one in use stays
local function manifest_again(name: string): table

    local current = manifests[name]
    local fresh, why = manifest_reader.read(current.path)

    if fresh == nil then
        log:warn($"'{name}': its manifest can't be used, the one read before stays: {current.path}\n{why}")
        return current
    end

    if fresh.id ~= name then
        log:warn($"'{name}': its manifest has the id '{fresh.id}' now, the one read before stays: {current.path}")
        return current
    end

    return fresh
end

-- Reads the module's manifest and runs its file again, so changes in them apply without restarting the script.
-- Modules that need it are stopped for the reload and started again after.
-- If the new code fails to load, the old module is put back and started again.
-- Only the module's own file is re-read: lib files it loads stay as they are (require caches them)
-- @return Whether the reloaded module is running
function module.reload_module(name: string): bool

    local old = module.get(name)
    local previous = manifests[name]

    if previous == nil then
        log:warn($"'{name}' wasn't loaded from a file, can't reload it")
        return false
    end

    local manifest = manifest_again(name)

    -- Its file never ran: there's no old code to keep, the manifest is taken and the module started
    if not old.loaded then
        take_manifest(old, manifest)
        return module.start_module(name)
    end

    -- The entry file is gone since: nothing to run, the code that runs stays
    if manifest.entry == nil then
        log:warn($"'{name}' not reloaded: {manifest.problem} ({manifest.path})")
        return false
    end

    -- The other files it loads are loaded anew by the new code; the old ones come back if it fails
    local old_extra = extra_files[name]

    extra_files[name] = nil

    -- Dependents that were running, to start them again once the module is back
    local restart = {}
    for dep_name in pairs(dependents_of(name)) do
        if by_name[dep_name]:is_running() then
            table.insert(restart, dep_name)
        end
    end

    module.stop_module(name)
    local index = unregister(old)

    local ok, err = run_entry(manifest)
    local fresh = by_name[name]
    local reloaded = ok and fresh ~= nil
    if not reloaded then
        if fresh then
            unregister(fresh)
        end

        if ok then
            log:error($"{manifest.entry} didn't register '{name}' again")
        else
            log:error($"module file failed: {manifest.entry}\n{err}")
        end

        log:warn($"'{name}' not reloaded, the old version is back")
        register_at(old, index, previous.entry)
        extra_files[name] = old_extra
    else
        -- The file registered it at the end; move it back to where it was
        unregister(fresh)
        register_at(fresh, index, manifest.entry)
        manifests[name] = manifest
        same_stamp[manifest.path] = nil
        log:info($"'{name}' reloaded from {manifest.entry}")
    end

    local running = module.start_module(name)

    for _, dep_name in ipairs(restart) do
        module.start_module(dep_name)
    end

    return reloaded and running
end

util.on_stop(module.stop)

return module
