-- lib/AnitaDarin/core/module_manager.pluto
--
-- Keeps the script's modules (core/module): starts them in dependency order, ticks the ones that tick
-- and stops them in reverse order when the script stops. Available as Atdar.modules.
--
-- A module file registers itself, like a feature file:
--     return Atdar.modules.add(new Module({ name = "players", on_tick = function(self) ... end }))

local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Modules")

local module = {}

local by_name = {}

-- Registration order: modules without deps between them start in this order
local order = {}

-- Start order; stop() goes through it backwards, so a module stops before the modules it needs
local started = {}
local tick_handler_created = false

-- Module name -> the file that registered it, so reload_module() can run it again
local files = {}

-- The file run_file() is running right now; add() records it for the modules the file registers
local loading_file = nil

-- Module file -> its text as it was when the code running now was read from it (file_changed)
local loaded_text = {}

-- Module file -> its text when it was run last, even if it failed (load_new doesn't run a broken file again
-- until it changes)
local attempted = {}

-- The folders load_dir read, for load_new to look at again
local dirs = {}

-- Module name -> what its last instance handed over for the next one (hand_over / take_over)
local handed = {}

-- The subfolder of a modules folder with the system modules (is_system)
local SYSTEMS = "systems/"

-- The path with / and in lower case, so paths written either way compare equal
local function normalized(path: string): string
    return (path:gsub("\\", "/")):lower()
end

-- The systems\ folder of each folder load_dir read, normalized and ending in /: what a system module's file
-- starts with. Made when the folder is read, so is_system only compares
local system_roots = {}

-- Module file -> whether it's under one of system_roots (is_system). Emptied when load_dir reads a new folder
local system_files = {}

-- @return The systems folder of dir, as system_roots keeps it
local function system_root(dir: string): string

    local root = normalized(dir)

    if not root:endswith("/") then
        root ..= "/"
    end

    -- A systems\ folder read on its own (the tests load modules/systems\ alone)
    if not root:endswith($"/{SYSTEMS}") then
        root ..= SYSTEMS
    end

    return root
end

-- Module file -> its stamp (stamp_of) when its text was last seen to be the loaded one: while the stamp
-- stays, file_changed doesn't read the file
local same_stamp = {}

-- The file's write time and size, as core/file_watch stamps a file
-- @return nil when it can't be told or can't be trusted: the file was written this very second, and another
-- write in the same second (of the same size) would leave the same stamp
local function stamp_of(path: string): ?string

    local ok_time, written = pcall(io.writetime, path)
    local ok_size, size = pcall(io.filesize, path)

    if not ok_time or not ok_size or type(written) ~= "number" then
        return nil
    end

    if written >= os.time() then
        return nil
    end

    return $"{written}:{size}"
end

-- The file's whole text, nil if it can't be read
local read_text = Atdar.loader.load("core/filesystem/file").read

-- Dep name -> set of the modules that need it directly: { [dep] = { [module name] = true } }.
-- Kept up to date by add/unregister/register_at, so dependents_of doesn't scan every module
local dependents = {}

-- Adds the module to the dependents index
local function index_deps(mod: table): void
    for _, dep in ipairs(mod.deps) do
        dependents[dep] ??= {}
        dependents[dep][mod.name] = true
    end
end

-- Takes the module out of the dependents index
local function unindex_deps(mod: table): void
    for _, dep in ipairs(mod.deps) do
        local set = dependents[dep]
        if set then
            set[mod.name] = nil
            if next(set) == nil then
                dependents[dep] = nil
            end
        end
    end
end

function module.add(mod: table): table
    local name = mod.name
    if type(name) ~= "string" then
        error("[Modules] a module needs a name, create it with new Module({ name = ... })")
    end
    if by_name[name] then
        error($"[Modules] module '{name}' is already registered")
    end
    by_name[name] = mod
    table.insert(order, mod)
    index_deps(mod)
    files[name] = loading_file
    return mod
end

-- The file the module was registered from, nil for one made in code (not by load_dir)
function module.file_of(name: string): ?string
    return files[name]
end

-- Whether it's a system module: its file is in systems\ of a folder load_dir read (lib/<script>/modules/systems/),
-- or load_dir read that systems\ folder itself. The script's own menus use them; the Modules list shows them
-- only when asked
-- @return false for a module made in code
function module.is_system(name: string): bool

    local path = files[name]

    if path == nil then
        return false
    end

    local known = system_files[path]

    if known ~= nil then
        return known
    end

    local file = normalized(path)
    local found = false

    for _, root in ipairs(system_roots) do
        if file:startswith(root) then
            found = true
            break
        end
    end

    system_files[path] = found

    return found
end

-- The text the code running now was read from (the file may be edited since): its line numbers are
-- the ones debug.getinfo gives for the module's functions
-- @return nil for a file that isn't a module file or hasn't run
function module.loaded_text_of(path: string): ?string
    return loaded_text[path]
end

function module.get(name: string): table
    local mod = by_name[name]
    if not mod then
        error($"[Modules] unknown module '{name}'")
    end
    return mod
end

-- Whether there's such a module and it's running
function module.is_running(name: string): bool

    local mod = by_name[name]

    if mod == nil then
        return false
    end

    return mod:is_running()
end

-- Keeps data for the module's next instance: its on_stop hands over what Reload (a new instance from its
-- file) should keep. Lives as long as the script runs; a new start of the script begins without any
function module.hand_over(name: string, data: table): void
    handed[name] = data
end

-- What the module's last instance handed over, taken once (its __construct)
-- @return nil if nothing was
function module.take_over(name: string): ?table

    local data = handed[name]

    handed[name] = nil
    return data
end

function module.has(name: string): bool
    return by_name[name] ~= nil
end

-- @return Module names in registration order
function module.names(): table
    local names = {}
    for _, mod in ipairs(order) do
        table.insert(names, mod.name)
    end
    return names
end

-- Starts the module's deps first.
-- chain: names being started right now, in order; a name met twice is a dependency cycle
local function start_one(mod: table, chain: table): bool
    if mod.status == "running" then
        return true
    end

    if mod.status == "failed" then
        return false
    end

    for i, name in ipairs(chain) do
        if name == mod.name then

            local cycle = {}

            for j = i, #chain do
                table.insert(cycle, chain[j])
            end

            table.insert(cycle, mod.name)

            log:error($"dependency cycle: {table.concat(cycle, ' -> ')}")
            return false
        end
    end

    table.insert(chain, mod.name)
    for _, dep in ipairs(mod.deps) do

        local dep_mod = by_name[dep]

        if not dep_mod then
            mod:fail($"needs module '{dep}', which isn't registered")
        elseif not start_one(dep_mod, chain) then
            mod:fail($"needs module '{dep}', which didn't start")
        end

        if mod.status == "failed" then
            table.remove(chain)
            return false
        end
    end
    table.remove(chain)

    if not mod:start() then
        return false
    end
    table.insert(started, mod)
    return true
end

-- One handler for all modules, created on the first start
local function create_tick_handler(): void
    if tick_handler_created then
        return
    end

    tick_handler_created = true

    util.create_tick_handler(function()
        for _, mod in ipairs(started) do
            -- Fields, not is_running() and has_tick(): this runs for every module every frame
            if mod.status == "running" and mod._ticks then
                mod:tick()
            end
        end
        return true
    end)
end

-- Starts every registered module that isn't running yet; can be called again after more modules are added.
-- A module whose dep is missing or failed is marked failed, the others still start
-- @return Number of running modules
function module.start(): int
    for _, mod in ipairs(order) do
        start_one(mod, {})
    end
    create_tick_handler()

    local running = 0

    for _, mod in ipairs(order) do
        if mod:is_running() then
            running += 1
        end
    end

    log:debug($"{running} of {#order} module(s) running")
    return running
end

-- Stops the running modules, the last started first
function module.stop(): void
    for i = #started, 1, -1 do
        started[i]:stop()
    end
    started = {}
end

-- Takes a module out of the start order, so a later start doesn't tick it twice
local function forget(mod: table): void
    for i = #started, 1, -1 do
        if started[i] == mod then
            table.remove(started, i)
        end
    end
end

-- @return Set of modules that need `name`, directly or through other modules: { [name] = true }
local function dependents_of(name: string): table

    local found = {}
    local queue = { name }

    while #queue > 0 do

        local current = table.remove(queue)

        for dependent in pairs(dependents[current] or {}) do
            if not found[dependent] then
                found[dependent] = true
                table.insert(queue, dependent)
            end
        end
    end

    return found
end

-- Starts one module and its deps. A failed module gets another try
-- @return Whether it's running afterwards
function module.start_module(name: string): bool

    local mod = module.get(name)

    if mod.status == "failed" then
        -- A module that failed in its tick is still in the start order
        forget(mod)
        mod.status = "registered"
        mod.error = nil
    end

    local ok = start_one(mod, {})
    create_tick_handler()
    return ok
end

-- Stops one module; the modules that need it stop first, so none keeps running without its dep
function module.stop_module(name: string): void

    local to_stop = dependents_of(name)
    to_stop[module.get(name).name] = true

    -- Backwards: a module started after its deps, so it stops before them
    for i = #started, 1, -1 do
        local mod = started[i]
        if to_stop[mod.name] then
            mod:stop()
            table.remove(started, i)
        end
    end
end

-- Adds the .pluto files under dir and its subfolders to out; one recursive listing instead of a look at every entry
local function collect_pluto_files(dir: string, out: table): void
    for _, path in io.listdir(dir, true) do
        if path:endswith(".pluto") and io.isfile(path) then
            table.insert(out, path)
        end
    end
end

-- Runs one module file; the modules it registers remember it for reload_module()
-- @return Whether it ran without errors
local function run_file(path: string): bool

    local text = read_text(path)
    attempted[path] = text

    -- Timed (loader.report): compiling and running the file, with the lib files it loads
    local ok, err = Atdar.loader.measure(path, function()
        local chunk, load_err = loadfile(path)
        if not chunk then
            return false, load_err
        end

        loading_file = path
        local run_ok, run_err = pcall(chunk)
        loading_file = nil
        return run_ok, run_err
    end)

    if not ok then
        log:error($"module file failed: {path}\n{err}")
        return false
    end

    -- Only code that ran: after a failed reload the old code runs, and the file still differs from it
    loaded_text[path] = text
    same_stamp[path] = nil
    return true
end

-- Whether the module's file differs from what its running code was read from (edited or synced since,
-- so Reload would run something new). The file is read only when its write time or size isn't the one it had
-- when its text was last compared: a file written again with the same text (a sync, a build) still isn't
-- changed. Meant for the menu, not for every frame
-- @return false for a module made in code (no file)
function module.file_changed(name: string): bool

    local path = files[name]

    if path == nil then
        return false
    end

    local stamp = stamp_of(path)

    if stamp ~= nil and stamp == same_stamp[path] then
        return false
    end

    if read_text(path) ~= loaded_text[path] then
        same_stamp[path] = nil
        return true
    end

    same_stamp[path] = stamp

    return false
end

-- Runs every module file in dir and its subfolders; a broken file skips only itself
-- @return Number of files that ran without errors
function module.load_dir(dir: string): int
    if not filesystem.is_dir(dir) then
        return 0
    end

    local known = false
    for _, other in ipairs(dirs) do
        if other == dir then
            known = true
        end
    end

    if not known then
        table.insert(dirs, dir)
        table.insert(system_roots, system_root(dir))
        system_files = {}
    end
    local paths = {}
    collect_pluto_files(dir, paths)
    table.sort(paths)

    local loaded = 0
    for _, path in ipairs(paths) do
        if run_file(path) then
            loaded += 1
        end
    end

    return loaded
end

-- Runs the files that came into the folders load_dir read since (a new module file, or one that failed
-- before and was changed), then starts the modules they registered
-- @return How many modules the new files registered
function module.load_new(): int

    local before = #order

    for _, dir in ipairs(dirs) do

        local paths = {}
        collect_pluto_files(dir, paths)
        table.sort(paths)

        for _, path in ipairs(paths) do

            local seen = attempted[path]

            -- Never run, or failed before and edited since
            if seen == nil or (loaded_text[path] == nil and read_text(path) ~= seen) then
                run_file(path)
            end
        end
    end

    local added = #order - before

    -- Only the new ones: start() would also bring back the modules stopped by hand (Stop All)
    for i = before + 1, #order do
        module.start_module(order[i].name)
    end

    return added
end

-- Puts a module back into by_name/order/files, at its old place in the order
local function register_at(mod: table, index: int, path: ?string): void
    by_name[mod.name] = mod
    table.insert(order, math.min(index, #order + 1), mod)
    index_deps(mod)
    files[mod.name] = path
end

-- Takes a module out of by_name/order/files
-- @return Its index in the order
local function unregister(mod: table): int
    local index = #order + 1
    for i, other in ipairs(order) do
        if other == mod then
            index = i
            table.remove(order, i)
            break
        end
    end
    unindex_deps(mod)
    by_name[mod.name] = nil
    files[mod.name] = nil
    return index
end

-- Runs the module's file again, so changes in its code apply without restarting the script.
-- Modules that need it are stopped for the reload and started again after.
-- If the new code fails to load, the old module is put back and started again.
-- Only the module's own file is re-read: lib files it loads stay as they are (require caches them)
-- @return Whether the reloaded module is running
function module.reload_module(name: string): bool

    local old = module.get(name)
    local path = files[name]

    if not path then
        log:warn($"'{name}' wasn't loaded from a file, can't reload it")
        return false
    end

    -- Dependents that were running, to start them again once the module is back
    local restart = {}
    for dep_name in pairs(dependents_of(name)) do
        if by_name[dep_name]:is_running() then
            table.insert(restart, dep_name)
        end
    end

    module.stop_module(name)
    local index = unregister(old)

    local ok = run_file(path)
    local fresh = by_name[name]
    local reloaded = ok and fresh ~= nil
    if not reloaded then
        if fresh then
            unregister(fresh)
        elseif ok then
            log:error($"{path} didn't register '{name}' again")
        end
        log:warn($"'{name}' not reloaded, the old version is back")
        register_at(old, index, path)
    else
        -- The file registered it at the end; move it back to where it was
        unregister(fresh)
        register_at(fresh, index, path)
        log:info($"'{name}' reloaded from {path}")
    end

    local running = module.start_module(name)

    for _, dep_name in ipairs(restart) do
        module.start_module(dep_name)
    end
    
    return reloaded and running
end

util.on_stop(module.stop)

return module
