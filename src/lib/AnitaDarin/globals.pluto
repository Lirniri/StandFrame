local module = { 
    pluto = {
        class = {
            construct = {}
        }
    }
}

-- Pluto bug: if a class was instantiated before its subclass is declared, `extends` copies
-- the parent's __index into the subclass, so its instances resolve methods straight from the parent
function module.pluto.class.fix_index(instance: table): void
    local cls = getmetatable(instance)
    if rawget(cls, "__index") ~= cls then
        cls.__index = cls
    end
end

-- Errors if the instance's class replaced any of `sealed` methods defined on `base`
function module.pluto.class.construct.check_sealed(instance: table, base: table, sealed: table, label: string): void
    for _, name in ipairs(sealed) do
        if instance[name] ~= base[name] then
            error($"[{label}] must not override {name}()")
        end
    end
end

return module