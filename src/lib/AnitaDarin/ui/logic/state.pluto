local module = {}

enum MenuType begin
    STAND, SCALEFORM
end
-- The enum's name isn't a value in Pluto (its constants are put in at compile time), so the table is
-- what other files compare with: state.MenuType.STAND
module.MenuType = { STAND = MenuType.STAND, SCALEFORM = MenuType.SCALEFORM }

-- Текущий вид меню
module.current_view = MenuType.STAND

return module
