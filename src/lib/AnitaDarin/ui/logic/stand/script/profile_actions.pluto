-- lib/AnitaDarin/ui/logic/stand/script/profile_actions.pluto
-- What the profile's buttons do: Save, Load, Reset, Delete of a profile, Create Main Profile, Rename Script,
-- the notification examples, Reload Natives. The items and the warnings before them are in
-- ui/stand/script/profile; what keeps the items in step with the profile is profile_view.
-- Each takes after(): what the menu does once the change is made (captions, fields, the entries again).
-- Strings: core/language "profile"

local i18n = Atdar.loader.load("core/i18n")
local installer = Atdar.loader.load("core/installer")
local Logger = Atdar.loader.load("core/logger")
local texture_dict = Atdar.loader.load("natives/streaming/texture_dict/asset")
local thefeed = Atdar.loader.load("natives/visual/hud/thefeed")

local log = new Logger("Profile")
local text = select(2, i18n.scope("profile"))

local module = {}

-- Notifications

-- The kinds of notification an example shows, in order: the logger's method and the strings' key
module.EXAMPLE_KINDS = {
    { method = "notify", key = "info" },
    { method = "warn", key = "warn" },
    { method = "error", key = "error" },
    { method = "success", key = "success" },
}

-- The cards the examples put in the game's feed, taken away again (going back out of Notifications, or
-- before new ones): Stand's own notifications can't be taken away
local example_posts = {}

function module.remove_examples(): void
    for _, id in ipairs(example_posts) do
        pcall(thefeed.remove, id)
    end

    example_posts = {}
end

-- Shows an example of each kind given, the way it really looks (where it shows, subject, colours,
-- emoticon); the examples before are taken away first, so clicking again doesn't pile them up
-- @param kinds Entries of EXAMPLE_KINDS
function module.show_examples(kinds: table): void

    module.remove_examples()

    for _, kind in ipairs(kinds) do
        local id = log[kind.method](log, text($"notify.examples.{kind.key}.text"))
        if id ~= nil then
            table.insert(example_posts, id)
        end
    end
end

-- Asks the game to load the profile's picture now, without waiting, so message cards show it
function module.load_feed_picture(): void

    local name = Atdar.profile.get("notify_feed_picture")

    if type(name) ~= "string" or name == "" then
        return
    end

    pcall(texture_dict.request, name, false)
end

-- Debug

-- The native wrappers read from disk again, to try a change without restarting the script
function module.reload_natives(): void
    local count = Atdar.loader.reload(Atdar.natives, "natives")
    Atdar.loader.load("parsers/proglang/pluto/path").forget_natives()
    log:success(text("reload_natives.done"):format(count))
end

-- Profiles

-- Writes the active profile's values into the profile
function module.save(name: string, after: function): void
    if not Atdar.profile.save_to(name) then
        return
    end

    after()
    log:notify(text("save.done"):format(name))
end

-- Makes the profile the active one
function module.load(name: string, after: function): void
    Atdar.profile.switch(name)
    after()
    log:notify(text("load.done"):format(name))
end

-- Every value of the profile back to the defaults in core/profile
function module.reset(name: string, after: function): void
    if not Atdar.profile.reset(name) then
        log:warn(text("reset.failed"):format(name))
        return
    end

    -- Only the active profile's values are on screen
    if name == Atdar.profile.active_name() then
        after()
    end
    log:notify(text("reset.done"):format(name))
end

-- Takes the profile out. after() runs only when it was deleted
function module.delete(name: string, after: function): void
    if Atdar.profile.delete(name) then
        after()
    end
end

-- Makes the main profile with the defaults; one that's there is made again
function module.create_main(after: function): void
    local main = Atdar.profile.main_name()
    local existed = Atdar.profile.exists(main)

    if not Atdar.profile.create_main() then
        log:warn(text("create_main.failed"):format(main))
        return
    end

    if existed then
        log:notify(text("create_main.recreated"):format(main))
    else
        log:notify(text("create_main.done"):format(main))
    end
    after()
end

-- Rename Script

-- Whether the name can be the script's; says so when it can't
function module.is_valid_name(value: string): bool
    if installer.valid_name(value) then
        return true
    end

    log:warn(text("rename.invalid"):format(value))
    return false
end

-- Renames the script's folders and stops it (it starts again under the new name)
-- @return Whether it was renamed
function module.rename_script(value: string): bool
    local ok, reason, busy_folder = installer.rename(value)

    if not ok then
        if busy_folder then
            log:warn(text("rename.busy"):format(busy_folder))
        else
            log:warn(text("rename.failed"):format(reason))
        end
        return false
    end

    log:notify(text("rename.done"):format(value, value))
    installer.stop()
    return true
end

return module
