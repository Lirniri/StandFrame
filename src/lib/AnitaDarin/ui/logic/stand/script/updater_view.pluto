-- lib/AnitaDarin/ui/logic/stand/script/updater_view.pluto
-- What the Update list shows and does besides starting the manager: the texts of its info lines, the branch
-- picked, the switches kept in the profile, the file with what the available version changes.
-- The items are in ui/stand/script/updater; the checking and installing is core/update_manager.
-- Strings: core/language "updater_menu"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")
local manager = Atdar.loader.load("core/update_manager")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local file = Atdar.loader.load("core/filesystem/file")
local paths = Atdar.loader.load("core/filesystem/paths")

local log = new Logger("Updater")
local text = select(2, i18n.scope("updater_menu"))

local module = {}

-- The repo's branches updates can come from: main - the releases, experiment - the newest, less tried;
-- all - the versions of every branch are listed (each marked with its branch), updates come from main
module.BRANCHES = { "main", "all", "experiment" }

-- Info lines

function module.installed_text(): string
    return manager.installed_version() or text("info.unknown")
end

-- "Installed Version", with a ":" added when the version is known
function module.installed_caption(): string

    local caption = text("info.installed")

    if manager.installed_version() == nil then
        return caption
    end

    return $"{caption}:"
end

-- "Available Version", with a ":" added when a check found one
function module.available_caption(): string

    local caption = text("info.available")

    if manager.available_version() == nil then
        return caption
    end

    return $"{caption}:"
end

-- The version found by the last check, "not checked" before one, marked when it's the one installed
function module.available_text(): string

    local version = manager.available_version()

    if version == nil then
        return text("info.not_checked")
    end

    if manager.is_up_to_date() then
        return text("info.up_to_date"):format(version)
    end

    return version
end

-- "Last Check", with a ":" added once a check ran
function module.last_check_caption(): string

    local caption = text("info.last_check")

    if manager.last_check_time() == 0 then
        return caption
    end

    return $"{caption}:"
end

-- "never" when no check ran, else the time of the last one
function module.last_check_text(): string

    local time = manager.last_check_time()

    if time == 0 then
        return text("info.never")
    end

    return os.date("%Y-%m-%d %H:%M", time)
end

-- The bar of the update's download: "[=====-----] 50%", empty while none runs
function module.progress_text(): string

    local progress = manager.progress

    if progress == nil or progress.total == 0 then
        return text("info.no_progress")
    end

    local width = 10
    local filled = progress.done * width // progress.total
    local percent = progress.done * 100 // progress.total

    return $"[{("="):rep(filled)}{("-"):rep(width - filled)}] {percent}%"
end

-- The progress line's name: "Progress", with a ":" added while an update is downloading
function module.progress_caption(): string

    local caption = text("info.progress")

    if manager.progress == nil then
        return caption
    end

    return $"{caption}:"
end

-- Branch

-- "Branch: main"
function module.branch_caption(): string

    local branch = Atdar.profile.get("update_branch") or "main"

    if branch == "all" then
        branch = text("branch.all_name")
    end

    return text("branch.name"):format(branch)
end

function module.branch_options(): table

    local options = {}

    for _, branch in ipairs(module.BRANCHES) do
        table.insert(options, text($"branch.{branch}"))
    end

    return options
end

-- Picks the branch updates come from, by its place in BRANCHES
function module.set_branch(index: int): void

    local branch = module.BRANCHES[index]

    Atdar.profile.set("update_branch", branch)
    log:notify(text("branch.set"):format(branch))
end

-- Switches and days

-- A switch kept in the profile. Stand also calls it at every start, restoring the state it keeps: only a
-- real change is saved
function module.set_flag(key: string, on: bool): void
    if Atdar.profile.get(key) == on then
        return
    end

    Atdar.profile.set(key, on)
end

-- How often the automatic check runs, in days; 0 - never
function module.set_check_days(days: int): void

    Atdar.profile.set("update_check_days", days)

    if days == 0 then
        log:notify(text("check_days.never"))
        return
    end

    log:notify(text("check_days.set"):format(days))
end

-- Update To Version

-- Installs the release of a version ("0.1.8", or a tag, a branch or a commit), an older one too, then restarts
-- the script
function module.update_to(version: string): void
    util.create_thread(|| -> manager.install_version_and_restart(version))
end

-- Sync With Branch: whether the list of versions is the update branch's (on), or always main's
function module.versions_synced(): bool
    return Atdar.profile.get("update_versions_sync") ~= false
end

-- Sync With Branch was switched: by the user, or by Stand's own Reset Settings
-- @return Whether it changed, for the list to be made again
function module.set_versions_synced(on: bool): bool

    if clicks.is_stopping() or on == module.versions_synced() then
        return false
    end

    Atdar.profile.set("update_versions_sync", on)
    return true
end

-- The version typed in the field. Not Stand putting the text back
function module.update_to_version(value: string, click_type): void

    if not clicks.is_user_action(click_type) then
        return
    end

    local typed = value:match("^%s*(.-)%s*$")

    if typed == "" then
        return
    end

    module.update_to(typed)
end

-- How many of the newest versions the list shows (Limit Shown To), 7 until it's changed
function module.versions_shown(): int
    return Atdar.profile.get("update_versions_shown") or 7
end

-- Whether a list of versions was loaded (the list was opened): until then there is nothing to make again
function module.versions_loaded(): bool
    return manager.versions_found ~= nil
end

-- Limit Shown To changed: by the user, or by Stand's own Reset Settings, Set To Min / Max. Any change is
-- the value to keep; only the script stopping is not
-- @return Whether the value changed, for the list to be made again
function module.set_versions_shown(count: int): bool

    if clicks.is_stopping() or count == module.versions_shown() then
        return false
    end

    Atdar.profile.set("update_versions_shown", count)
    return true
end

-- The released versions for the list under the field: { version, caption } newest first, the installed one
-- marked, no more than Limit Shown To; with Sync With Branch off the caption says the branch ("0.1.11: main"). Yields: call it from a thread. Empty (and told) when they can't be loaded
-- @param kept Take the ones the last fetch got, without going to the network again
function module.version_rows(kept: bool = false): table

    local versions = kept and manager.versions_found or nil
    local err = nil

    -- The list opened less than an hour ago (or in an earlier run) is used, the network isn't asked again
    if versions == nil and not kept then
        versions = manager.cached_versions()
    end

    if versions == nil then
        versions, err = manager.fetch_versions()
    end

    if versions == nil then
        log:warn(text("msg.versions_failed"):format(tostring(err)))
        return {}
    end

    local installed = manager.installed_version()
    local rows = {}

    local with_branch = not module.versions_synced() or Atdar.profile.get("update_branch") == "all"

    for index, entry in ipairs(versions) do

        if index > module.versions_shown() then
            break
        end

        local caption = entry.version

        -- Every branch's versions are in the list: each says which branch it's of, "0.1.11: main"
        if with_branch then
            caption = $"{entry.version}: {entry.branch}"
        end

        if entry.version == installed then
            caption = text("version.installed"):format(caption)
        end

        table.insert(rows, { version = entry.version, caption = caption })
    end

    return rows
end

-- Changes

-- Saves what the available version changes to store/<script>/updater/changes.txt (made again each time)
-- and says its path
function module.save_changes(): void

    local lines = manager.changes()

    if #lines == 0 then
        log:notify(text("changes.none"), "stand")
        return
    end

    local filename = "updater/changes.txt"
    local parts = {}

    for _, line in ipairs(lines) do
        table.insert(parts, text($"changes.{line.kind}"):format(line.path))
    end

    if not file.write($"{paths.store}{filename}", table.concat(parts, "\n")) then
        log:notify(text("changes.error"), "stand")
        return
    end

    log:notify(text("changes.saved"):format(filename), "stand")
end

return module
