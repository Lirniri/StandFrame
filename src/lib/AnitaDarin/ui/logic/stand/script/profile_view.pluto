-- lib/AnitaDarin/ui/logic/stand/script/profile_view.pluto
-- The texts the profile's items show and the rules behind Copy Menu To Core. The items themselves are in
-- ui/stand/script/profile; an item holding a profile value is kept in step by ui/stand/core/profile_items,
-- and the captions below follow the profile and the language through ui/stand/core/live.
--
--     view.begin(packs)          -- a new build of the section: the packs Copy Menu To Core offers
--     view.settings_caption()    -- "Profile: main"
--     view.entry_caption("main") -- "main (active)*"
--
-- Strings: core/language "profile" and "menu_loader.auto_copy"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Profile")

local module = {}

-- Strings under "profile"
local _, text = i18n.scope("profile")

-- The menu packs in store, offered by Copy Menu To Core
local packs = {}

-- Starts a new build of the section
-- @param found Menu packs in store (menu_packs.find_loadable_packs), offered for copying to core
function module.begin(found: table = {}): void
    packs = found
end

-- Captions

-- "main", "main (active)" or "main (active)*" with unsaved changes
function module.entry_caption(name: string): string

    local profile = Atdar.profile

    if name ~= profile.active_name() then
        return name
    end

    local caption = text("entry.active"):format(name)

    if profile.is_dirty() then
        return $"{caption}*"
    end

    return caption
end

-- "Profile: main", the divider on top of the section
function module.settings_caption(): string
    return text("settings.of"):format(Atdar.profile.active_name())
end

-- Copy Menu To Core

-- @return The pack the profile copies to core at start: its info from store; { folder, name, missing = true }
-- with only the folder's name when there's no such pack in store now (it was taken out, or the profile is
-- another one's); nil when it's off
function module.auto_copy_pack(): ?table

    local id = Atdar.profile.get("auto_copy_menu")

    if type(id) ~= "string" or id == "" then
        return nil
    end

    for _, pack in ipairs(packs) do
        if pack.folder == id then
            return pack
        end
    end

    return { folder = id, name = id, missing = true }
end

-- The pack's line under Copy Menu To Core: its name, or the name and that the pack isn't in store
function module.auto_copy_line(pack: table): string
    if pack.missing then
        return i18n.text("menu_loader.auto_copy.missing"):format(pack.name)
    end

    return pack.name
end

-- Off, then every pack in store: the options of Copy Menu To Core
function module.auto_copy_options(): table

    local options = { i18n.label("menu_loader.auto_copy.off") }

    for _, pack in ipairs(packs) do
        table.insert(options, pack.name)
    end

    return options
end

-- "Copy Menu To Core: Off" while it's off; with a pack picked only the name (the pack is on the line under it)
function module.auto_copy_caption(): int
    if module.auto_copy_pack() == nil then
        return i18n.label("menu_loader.auto_copy.name_off")
    end

    return i18n.label("menu_loader.auto_copy.name")
end

-- Its help has the script's name in it, so it's a text made again with the language
function module.auto_copy_help(): string
    return i18n.text("menu_loader.auto_copy.help"):format(Atdar.name)
end

-- Picks the pack copied to core at start (index 1: off); takes effect at the next start
function module.set_auto_copy(index: int): void

    local pack = packs[index - 1]

    if pack == nil then
        Atdar.profile.set("auto_copy_menu", "")
        log:notify(i18n.text("menu_loader.auto_copy.disabled"))
        return
    end

    Atdar.profile.set("auto_copy_menu", pack.folder)
    log:notify(i18n.text("menu_loader.auto_copy.later"):format(pack.name))
end

-- The packs in store were read again (Load Menu was opened)
function module.set_packs(found: table): void
    packs = found
end

-- The profile's language applies to the whole script, also after loading another profile.
-- A new language makes the captions again (i18n.on_change -> ui/stand/core/live)
i18n.set_language(Atdar.profile.get("language"))
Atdar.profile.on_change(function(key: string, value)
    if key == "language" then
        i18n.set_language(value)
    end
end)

return module
