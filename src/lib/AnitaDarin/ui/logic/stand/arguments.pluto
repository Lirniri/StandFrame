-- lib/AnitaDarin/ui/logic/stand/arguments.pluto
--
-- The arguments of a function, worked out from what is typed for them: the function's signature (its
-- parameters with the types and defaults the code says), the kind of value each parameter takes, and the
-- values to call with. The fields the texts are typed in are in ui/stand/core/arguments.
--
--   sig = arguments.signature_of(fn)               -- { params = { { name, type, default } }, vararg }
--   local args, count, err = arguments.read(sig, texts)               -- the values to call with
--
-- The kinds, by the type written in the code:
--   any       no type written, or a type that is none of the below (a number or text, for example)
--   function  a function: its path is typed, as in Function Name (game.repair_vehicle)
--   integer   int
--   float     float, number
--   vector3   vector3: 1, 2, 3 or an expression that gives one (v3.new(1, 2, 3))
--   table     table: values separated by commas, or an expression that gives one
--   userdata  userdata: an expression (v3.new(1, 2, 3), entities.get_user_vehicle_as_handle())
--   string    string: the text as it is, without quotes
--   boolean   bool: true or false
-- A text never typed is the parameter's start value: the default written for it in the code
-- (`speed: float = 1.5`), else one by the kind - 0 for integer and float, false for boolean, 0, 0, 0 for
-- vector3; the other kinds start empty, and so does a parameter written as ?type (it may be left out).
-- Empty is nil: not given.
-- The texts are kept by the caller, texts[i] for the i-th parameter and texts.rest for what a function takes
-- past its parameters (...): several expressions separated by commas.
--
-- A name in an expression may be a short name of Debug > Call Function (its files): user_ped() for
-- players.user_ped(). A call is always written with its brackets: a word without them is text, never a call.
-- Strings: core/language "arguments"

local i18n = Atdar.loader.load("core/i18n")
local args_parser = Atdar.loader.load("parsers/proglang/pluto/args")
local source_parser = Atdar.loader.load("parsers/proglang/pluto/source")
local path_parser = Atdar.loader.load("parsers/proglang/pluto/path")
-- Lua's debug library as it was at load: a module that assigns a global `debug` by mistake
-- (a missing `local`) doesn't break reading functions here
local debug = debug

local module = {}

-- Strings under "arguments"
local text = select(2, i18n.scope("arguments"))

-- The files of Debug > Call Function (short names, the signatures of Stand's API): the system module
-- CallFunction, asked for at every use (Reload makes a new one)
-- @return nil while there's no such module (a test that loads none): no short names, no signatures from files
local function registry(): ?table

    if Atdar.modules == nil or not Atdar.modules.has("CallFunction") then
        return nil
    end

    return Atdar.modules.get("CallFunction")
end

-- A name nothing else has, in an expression: a short name from the files
local function resolve_name(name: string)

    local calls = registry()

    if calls == nil then
        return nil
    end

    return calls:value_of(name)
end

-- Types

-- The type written in the code -> the kind of its field
local KIND_OF_TYPE = {
    int = "integer", integer = "integer",
    float = "float", number = "float",
    string = "string",
    bool = "boolean", boolean = "boolean",
    table = "table",
    ["function"] = "function",
    vector3 = "vector3", v3 = "vector3",
    userdata = "userdata",
}

-- @return The kind of a parameter's field by its type as written ("?int", "int|string", nil): integer, float,
-- string, boolean, table, function, vector3, userdata - or "any" when none is written or it's no one kind
function module.kind_of(type_text: ?string): string
    if type_text == nil then
        return "any"
    end
    local base = type_text:match("^%??(.*)$")
    return KIND_OF_TYPE[base] or "any"
end

-- The names and types as the signature the fields are made from
-- @param names The parameters' names, in order, a method's self left out
-- @param types name -> the type written for it (source.param_types)
-- @param defaults name -> the default written for it (source.param_defaults)
-- @return { params = { { name, type, default } }, vararg }
function module.signature(names: table, types: table, vararg: bool, defaults: table = {}): table
    local params = {}
    for _, name in ipairs(names) do
        table.insert(params, { name = name, type = types[name], default = defaults[name] })
    end
    return { params = params, vararg = vararg }
end

-- What a field of the kind starts with when the code writes no default
local KIND_DEFAULT = { integer = "0", float = "0", boolean = "false", vector3 = "0, 0, 0" }

-- @return The text a parameter's field starts with: its default in the code, else one by its type; nil for none
function module.default_of(param: table): ?string
    if param.default ~= nil then
        return param.default
    end

    -- ?type: may be left out
    if param.type ~= nil and param.type:sub(1, 1) == "?" then
        return nil
    end

    return KIND_DEFAULT[module.kind_of(param.type)]
end

-- The signature of a function as the running code and its source give it. A C function (Stand's natives) says
-- nothing of its parameters: it takes what's given (isvararg), so its signature is only "...".
-- skip_self: a method called with its owner: its self isn't asked for
function module.signature_of(fn, skip_self: ?bool): table

    local info = debug.getinfo(fn, "u")
    local names = {}

    for i = 1, info.nparams do
        local name = debug.getlocal(fn, i)
        if not (i == 1 and skip_self and name == "self") then
            table.insert(names, name)
        end
    end

    return module.signature(names, source_parser.param_types(fn), info.isvararg, source_parser.param_defaults(fn))
end

-- "handle, coords, ...": the parameters' names, and ... when it takes more
function module.params_text(sig: table): string

    local names = {}

    for _, param in ipairs(sig.params) do
        table.insert(names, param.name)
    end

    if sig.vararg then
        table.insert(names, "...")
    end

    return table.concat(names, ", ")
end

-- @return Whether there is anything to type: a parameter or more arguments (...)
function module.has_fields(sig: table): bool
    return #sig.params > 0 or sig.vararg
end

-- Reading

local function trim(value: string): string
    return value:match("^%s*(.-)%s*$")
end

-- What went wrong in a call, as the user can use it: Lua's "file.pluto:12: bad argument #1 to 'f' (number
-- expected, got string)" says where in the code and not what to type. Another error is left as it is, without its place
local function friendly(err): string

    local message = (tostring(err):gsub("^%S+:%d+: ", ""))
    local _, name, expected, got = message:match("bad argument #(%d+) to '([^']+)' %((%w+) expected, got (%w+)%)")

    if name ~= nil then
        local told = text("errors.wrong_type"):format(name, expected, got)
        if got == "string" then
            told ..= " " .. text("errors.bare_word")
        end
        return told
    end

    if message:match("bad argument #%d+ to '[^']+' %(value expected%)") then
        return text("errors.no_value")
    end

    return message
end

-- "name: what was wrong" for a field (or the rest of the arguments)
local function bad(name: string, err): string
    return text("errors.bad"):format(name, friendly(err))
end

-- Whether a path names a function (a short name too, whatever Use Short Names says)
local function names_function(path: string): bool

    local calls = registry()
    local full = path

    if calls ~= nil then
        full = calls:expand(path, true)
    end

    local found, fn = path_parser.resolve(full)

    return found and type(fn) == "function"
end

-- A field's text that is one whole call of a known function (handle_to_pointer(user_ped)), made: what it gives
-- is the value. Its parameters say what each piece is (user_ped -> user_ped()); a function that says nothing of
-- them (tostring, a C function of Stand's) has its pieces read as written
-- @return Whether the text is such a call; then the value, or nil and what was wrong
local function call_value(param: table, typed: string)

    local path = args_parser.call_of(typed)

    if path == nil or not names_function(path) then
        return false
    end

    local call = module.call_in(typed)

    if call == nil then
        local args, count, err = args_parser.parse(typed, resolve_name)
        if err ~= nil then
            return true, nil, bad(param.name, err)
        end

        if count ~= 1 then
            return true, nil, text("errors.one_value"):format(param.name)
        end

        return true, args[1]
    end

    local texts = {}

    for i, piece in ipairs(call.pieces) do
        if i <= #call.sig.params then
            texts[i] = piece
        else
            texts.rest = texts.rest == nil and piece or $"{texts.rest}, {piece}"
        end
    end

    local args, count, err = module.read(call.sig, texts)
    if err ~= nil then
        return true, nil, err
    end

    local given = table.pack(pcall(call.fn, table.unpack(args, 1, count)))
    if not given[1] then
        return true, nil, bad(param.name, given[2])
    end

    return true, given[2]
end

-- Whether a text has every bracket and quote closed, in order: ( ) { } [ ]
local function is_closed(value: string): bool

    local closers = { [")"] = "(", ["}"] = "{", ["]"] = "[" }
    local stack = {}
    local quote = nil
    local at = 1

    while at <= #value do

        local char = value:sub(at, at)

        if quote ~= nil then
            if char == "\\" then
                at += 1 -- the next character is escaped
            elseif char == quote then
                quote = nil
            end
        elseif char == "\"" or char == "'" then
            quote = char
        elseif char == "(" or char == "{" or char == "[" then
            table.insert(stack, char)
        elseif closers[char] ~= nil then
            if stack[#stack] ~= closers[char] then
                return false
            end
            table.remove(stack)
        end

        at += 1
    end

    return quote == nil and #stack == 0
end

-- Whether a parameter must be given: its type is written without ? and there's no default, in the code or by its kind.
-- A parameter with no type written is not required (it isn't known)
local function is_required(param: table): bool
    return param.type ~= nil and param.type:sub(1, 1) ~= "?" and module.default_of(param) == nil
end

-- What a function that takes no more arguments says when it is given more
local function too_many(sig: table, given: int): string
    return text("errors.too_many"):format(module.params_text(sig), #sig.params, given)
end

-- Whether what was typed in a field is what its kind takes at all, checked as it is typed (a call is checked when it is made).
-- Strict for a boolean: true or false, or an expression (a call, a name with a dot); a word like "falsed", a number
-- or a text in quotes isn't one. The same for a number (a word or a text isn't one) and a vector (a text isn't).
-- Any kind but a text needs its brackets and quotes closed
-- @return What is wrong (the text of the error); nil when it is fine or when only a call can tell
function module.check_typed(param: table, typed: ?string): ?string

    if typed == nil or trim(typed) == "" then
        return nil
    end

    local value = trim(typed)
    local kind = module.kind_of(param.type)
    local is_quoted = value:match("^[\"'].*[\"']$") ~= nil
    local is_word = value:match("^[%a_][%w_]*$") ~= nil

    if kind ~= "string" and not is_closed(value) then
        return text("errors.unclosed"):format(param.name)
    end

    if kind == "boolean" and value ~= "true" and value ~= "false"
        and (value:match("^[%w_]+$") ~= nil or is_quoted) then
        return text("errors.boolean"):format(param.name)
    end

    -- A word without brackets is text, never a call, and a text isn't a number
    if kind == "integer" and (is_word or is_quoted) then
        return text("errors.integer"):format(param.name)
    end

    if kind == "float" and (is_word or is_quoted) then
        return text("errors.number"):format(param.name)
    end

    if kind == "vector3" and is_quoted then
        return text("errors.vector"):format(param.name)
    end

    return nil
end

-- One field's text as a value of the kind. Never typed: the field's start value (default_of). Empty: nil
-- @return The value, or nil and what was wrong
local function read_one(param: table, typed: ?string)
    if typed == nil then
        typed = module.default_of(param)
    end

    if typed == nil or trim(typed) == "" then
        if is_required(param) then
            return nil, text("errors.required"):format(param.name)
        end
        return nil
    end

    local kind = module.kind_of(param.type)
    if kind == "string" then
        return typed
    end
    if not is_closed(typed) then
        return nil, text("errors.unclosed"):format(param.name)
    end
    if kind == "function" then
        local path = trim(typed)
        local found, fn = path_parser.resolve(path)
        if not found then
            fn = resolve_name(path)
        end
        if type(fn) ~= "function" then
            return nil, text("errors.not_function"):format(param.name, path)
        end
        return fn
    end

    local args, count, err = args_parser.parse(typed, resolve_name)
    if err ~= nil then
        return nil, bad(param.name, err)
    end

    if kind == "table" then
        if count == 1 and type(args[1]) == "table" then
            return args[1]
        end
        return { table.unpack(args, 1, count) }
    end

    if kind == "vector3" and count == 3 then
        for i = 1, 3 do
            if type(args[i]) ~= "number" then
                return nil, text("errors.vector"):format(param.name)
            end
        end
        return v3.new(args[1], args[2], args[3])
    end

    if count ~= 1 then
        return nil, text(kind == "vector3" and "errors.vector" or "errors.one_value"):format(param.name)
    end

    local value = args[1]

    if kind == "integer" then
        local whole = type(value) == "number" and math.tointeger(value) or nil
        if whole == nil then
            return nil, text("errors.integer"):format(param.name)
        end
        return whole
    end

    if kind == "float" and type(value) ~= "number" then
        return nil, text("errors.number"):format(param.name)
    end

    if kind == "boolean" and type(value) ~= "boolean" then
        return nil, text("errors.boolean"):format(param.name)
    end

    return value
end

-- The values to call a function with, from the texts typed in its fields. Fields left empty are nil, and
-- nils at the end aren't counted (the function's own defaults apply)
-- @return The arguments, how many there are, and what was wrong (nil if nothing)
function module.read(sig: table, texts: table)

    local args, count = {}, 0

    for i, param in ipairs(sig.params) do
        local value, err = read_one(param, texts[i])
        if err ~= nil then
            return {}, 0, err
        end
        args[i] = value
        if value ~= nil then
            count = i
        end
    end

    if not sig.vararg and texts.rest ~= nil and trim(texts.rest) ~= "" then
        return {}, 0, too_many(sig, #sig.params + #args_parser.split(texts.rest))
    end

    if sig.vararg and texts.rest ~= nil and trim(texts.rest) ~= "" then

        local rest, rest_count, err = args_parser.parse(texts.rest, resolve_name)

        if err ~= nil then
            return {}, 0, bad(text("rest.name"), err)
        end

        -- After the named parameters, those left empty in between are nil
        local first = #sig.params
        for i = 1, rest_count do
            args[first + i] = rest[i]
        end

        count = first + rest_count
    end

    return args, count, nil
end

-- The value of the field a #N points at: a call written in it is made (even in a text field), else it is read
-- as the field's kind says. Thrown as text, for the parser to give back as its error
local function field_value(sig: table, texts: table, number: int)

    local param = sig.params[number]

    if param == nil then
        error(text("errors.no_field"):format(number, #sig.params), 0)
    end

    local typed = texts[number]

    if typed == nil or trim(typed) == "" then
        typed = module.default_of(param)
    end

    if typed == nil or trim(typed) == "" then
        if is_required(param) then
            error(text("errors.required"):format(param.name), 0)
        end
        return nil
    end

    local handled, value, err = call_value(param, typed)

    if not handled then
        value, err = read_one(param, typed)
    end

    if err ~= nil then
        error(err, 0)
    end

    return value
end

-- The values to call with from a call written in the Function Name's brackets, where #1, #2 are the fields
-- (util.toast(tostring(#1))): each is worked out, and its value goes where it stands. The commands of the
-- script's own (asstr, allasstr: ui/logic/stand/call_commands) are understood there too
-- @param name The function's name, for what the commands show
-- @param returns function() -> the type the function returns, for the same; nil: none is shown
-- @return The arguments, how many there are, what was wrong (nil if nothing), and what the commands said:
-- { notice = the text to show, only = nothing is to be called }
function module.read_template(sig: table, texts: table, template: string, name: ?string, returns: ?function)

    local commands = Atdar.loader.load("ui/logic/stand/call_commands")
    local calls = registry()
    local aliases = {}

    if calls ~= nil then
        aliases = commands.aliases(calls:commands())
    end

    local cmd = { name = name ?? "", sig = sig, returns = returns, field = |number| -> field_value(sig, texts, number) }

    -- "label = what's in the field: what it gives" for a field (a parameter's number, or "rest"), for the commands'
    -- notices; nil for an empty rest
    cmd.inspect = function(key, label: string): ?string

        local param = sig.params[key]
        local typed = texts[key]

        if typed == nil and param ~= nil then
            typed = module.default_of(param)
        end

        if typed == nil or trim(typed) == "" then
            if key == "rest" then
                return nil
            end
            return $"{label} = nil"
        end

        if param == nil then
            return $"{label} = {trim(typed)}"
        end

        local handled, value, err = call_value(param, typed)

        if not handled then
            return $"{label} = {trim(typed)}"
        end

        if err ~= nil then
            return $"{label} = {trim(typed)}: {err}"
        end

        return $"{label} = {trim(typed)}: {Atdar.loader.load("ui/logic/stand/values").describe(value)}"
    end

    -- The commands first, then the short names
    local function resolve(word: string)

        local fn = commands.function_of(word, aliases, cmd)

        if fn ~= nil then
            return fn
        end

        return resolve_name(word)
    end

    local args, count, err = args_parser.parse(template, resolve, cmd.field,
        |dotted| -> commands.function_of(dotted, aliases, cmd))

    if err ~= nil then
        return {}, 0, friendly(err), cmd
    end

    if not sig.vararg and count > #sig.params then
        return {}, 0, too_many(sig, count), cmd
    end

    return args, count, nil, cmd
end

-- The texts for a signature from arguments written in one line, as a module gives its defaults ("42, true"):
-- the first ones for the parameters, what's left for Arguments
function module.texts_from(sig: table, line: string): table
    local texts = {}
    local pieces = args_parser.split(line)
    for i, piece in ipairs(pieces) do
        if i <= #sig.params then
            texts[i] = piece
        else
            texts.rest = texts.rest == nil and piece or $"{texts.rest}, {piece}"
        end
    end
    return texts
end

-- A vector in an argument

-- Whether a text is only numbers: "1, 2, 3", "v3.new(1.5, -2, 3)"
local function is_written_out(typed: string): bool

    local inner = typed:match("^%s*v3%.new%s*(%b())%s*$")

    if inner ~= nil then
        typed = inner:sub(2, -2)
    end

    return typed:match("^[%s%d%.,%-]+$") ~= nil
end

-- The three numbers a field's text gives, when it gives a vector: 1, 2, 3 or an expression with .x, .y, .z
-- (v3.new(1, 2, 3), a function that returns one). The text is worked out, so a call in it is made
-- @param typed The field's text
-- @return { x, y, z = the axes as texts (as written when there are three, else the numbers it gives), values = the
-- numbers it gives, written = whether the text is only numbers }; nil when it isn't a vector
function module.vector_in(typed: ?string): ?table

    if typed == nil or trim(typed) == "" then
        return nil
    end

    local args, count, err = args_parser.parse(typed, resolve_name)

    if err ~= nil then
        return nil
    end

    local numbers = {}

    if count == 3 then
        numbers = { args[1], args[2], args[3] }
    elseif count == 1 and (type(args[1]) == "userdata" or type(args[1]) == "table") then
        local ok, x, y, z = pcall(function() return args[1].x, args[1].y, args[1].z end)
        if ok then
            numbers = { x, y, z }
        end
    end

    for i = 1, 3 do
        if type(numbers[i]) ~= "number" then
            return nil
        end
    end

    local evaluated = {}

    for i = 1, 3 do
        evaluated[i] = tostring(math.floor(numbers[i] * 1000 + 0.5) / 1000)
    end

    -- Three pieces (1, 2, 3 or v3.new(a, b, f(1))) are the axes as they were written; one text that gives the vector
    -- (a call) has its numbers worked out
    local pieces = args_parser.split(typed:match("^%s*v3%.new%s*%((.*)%)%s*$") or typed)
    local texts = evaluated

    if #pieces == 3 then
        texts = pieces
    end

    return { x = texts[1], y = texts[2], z = texts[3], values = evaluated, written = is_written_out(typed) }
end

-- A call inside an argument

-- The function a field's text calls, when the text is one call of a path (parsers args.call_of) and the
-- function's parameters are known: from its code, or from the files of Call Function for Stand's own
-- @param typed The field's text
-- @return { path = as typed, sig, pieces = the texts of its arguments }; nil for anything else
function module.call_in(typed: ?string): ?table

    if typed == nil then
        return nil
    end

    local path, pieces = args_parser.call_of(typed)
    if path == nil then
        return nil
    end

    local calls = registry()
    local full = path

    -- A call in a field may be a short name whatever Use Short Names says (it is about Function Name and Add)
    if calls ~= nil then
        full = calls:expand(path, true)
    end

    local found, fn = path_parser.resolve(full)

    if not found or type(fn) ~= "function" then
        return nil
    end

    local sig = module.signature_of(fn)

    if #sig.params == 0 and calls ~= nil then
        local registered = calls:registered_signature(full)
        if registered ~= nil then
            sig = registered.sig
        end
    end

    -- Nothing to name a field by: it stays one field
    if #sig.params == 0 then
        return nil
    end

    return { path = path, sig = sig, pieces = pieces, fn = fn }
end

-- "path(a, b)" from the texts of a called function's fields: a parameter never typed is its start value, an
-- empty one in the middle is nil, empty ones at the end are left out
function module.compose(path: string, sig: table, texts: table): string

    local pieces = {}
    local last = 0

    for i, param in ipairs(sig.params) do
        local piece = texts[i]
        if piece == nil then
            piece = module.default_of(param)
        end

        piece = piece ~= nil and trim(piece) or ""
        pieces[i] = piece

        if piece ~= "" then
            last = i
        end
    end

    local written = {}

    for i = 1, last do
        table.insert(written, pieces[i] ~= "" and pieces[i] or "nil")
    end

    if sig.vararg and texts.rest ~= nil and trim(texts.rest) ~= "" then
        -- After every parameter: the ones left empty before it are nil
        for i = last + 1, #sig.params do
            table.insert(written, "nil")
        end
        table.insert(written, trim(texts.rest))
    end

    local joined = table.concat(written, ", ")

    return $"{path}({joined})"
end

return module
