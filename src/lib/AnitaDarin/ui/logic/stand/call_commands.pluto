-- lib/AnitaDarin/ui/logic/stand/call_commands.pluto
--
-- The commands of the script's own that the Stand command box understands in the brackets of the Function Name
-- (util.toast(asstr(#1))). Only there: they are not functions of the script. The names they go by are in
-- store/<script>/core/call_function/system/command.json, an id -> its names:
--     { "as_str": ["asstr", "asstring"] }
--
--   as_str            asstr(#1, #2)     each argument as a text; the function is called with the texts
--   as_int            asint(#1, #2)     each argument as a whole number; the function is called with them
--   as_text           astext(#1, #2)    nothing is called: the function's name and each parameter's name with what's
--                                       in its field are shown as a notice
--   all_as_str        allasstr()        every parameter of the function (no #N needed) as a text, the notice with the
--                                       name and the parameters, and the function is called with the texts
--   all_as_int        allasint()        the same as allasstr, with whole numbers; what is not a number (a text) is
--                                       given as it is
--   all_as_text       allastext()       the notice only, nothing is called
-- A command of all may be written with or without brackets. A name may have a dot (as.text): it is one name there.
--
--   local cmd = { name = "toast", sig = sig, field = |number| -> value,
--                 inspect = |key, label| -> "label = typed: result",
--                 returns = || -> "void" }                                   -- what the call is
--   local fn = commands.function_of("asstr", aliases, cmd)                 -- nil when it isn't a command
--   cmd.notice, cmd.only                                                   -- set by what ran: the text to show, nothing to call

local module = {}

-- The commands by their ids in the file: all - every parameter of the function, not the ones written; only - nothing
-- is called, the notice is all there is; notice - the notice with the name and the parameters is shown; int - the
-- arguments are whole numbers, not texts
local KINDS = {
    as_str = {},
    as_int = { int = true },
    as_text = { only = true, notice = true },
    all_as_str = { all = true, notice = true },
    all_as_int = { all = true, notice = true, int = true },
    all_as_text = { all = true, only = true, notice = true },
}

-- Strings under "arguments"
local text = select(2, Atdar.loader.load("core/i18n").scope("arguments"))

-- The arguments as texts; nil stays nil (it is "not given")
local function as_texts(args: table, count: int): table
    local texts = {}

    for i = 1, count do
        if args[i] ~= nil then
            texts[i] = tostring(args[i])
        end
    end

    return texts
end

-- "toast(text = handle_to_pointer(user_ped): 2172642053072, bitflags = 0): void": the function's name, then every
-- parameter by its name and what is written in its field - with what that gives when it's a call - and the
-- type the function returns, as the Functions list writes it. A call that failed says why
local function notice_of(cmd: table): string

    local parts = {}

    for number, param in ipairs(cmd.sig.params) do
        table.insert(parts, cmd.inspect(number, param.name))
    end

    if cmd.sig.vararg then
        local rest = cmd.inspect("rest", "...")
        if rest ~= nil then
            table.insert(parts, rest)
        end
    end

    local notice = $"{cmd.name}({table.concat(parts, ", ")})"
    local returns = nil

    if cmd.returns ~= nil then
        returns = cmd.returns()
    end

    if returns ~= nil then
        notice ..= $": {returns}"
    end

    return notice
end

-- The arguments as whole numbers; nil stays nil. What can't be one is told, or with soft left as it is
-- (the commands of all take the parameters that are texts too)
local function as_ints(args: table, count: int, soft: bool): table
    local numbers = {}

    for i = 1, count do
        if args[i] ~= nil then
            numbers[i] = math.tointeger(tonumber(args[i]))

            if numbers[i] == nil and soft then
                numbers[i] = args[i]
            elseif numbers[i] == nil then
                error(text("errors.not_integer"):format(tostring(args[i])), 0)
            end
        end
    end

    return numbers
end

-- Runs a command: its own arguments, or (for the ones of all) every parameter of the function
-- @return The values to call with and how many
local function run(kind: table, cmd: table, args: table, count: int)

    if kind.all then
        count = #cmd.sig.params
        args = {}

        for i = 1, count do
            args[i] = cmd.field(i)
        end
    end

    cmd.only = kind.only == true

    if kind.notice then
        cmd.notice = notice_of(cmd)
    end

    local converted = nil

    if kind.int then
        converted = as_ints(args, count, kind.all == true)
    else
        converted = as_texts(args, count)
    end

    local last = 0

    for i = 1, count do
        if converted[i] ~= nil then
            last = i
        end
    end

    return converted, last
end

-- The names -> id, from the file's id -> names
function module.aliases(data: table): table

    local aliases = {}

    for id, names in pairs(data) do
        if type(id) == "string" and type(names) == "table" then
            for _, alias in ipairs(names) do
                if type(alias) == "string" then
                    aliases[alias] = id
                end
            end
        end
    end

    return aliases
end

-- The function a name stands for, or nil when it is no command of the file
-- @param aliases name -> id (aliases)
-- @param cmd The call: name, sig, field(number); notice and only are set on it by what ran
function module.function_of(name: string, aliases: table, cmd: table)

    local kind = KINDS[aliases[name]]

    if kind == nil then
        return nil
    end

    return function(...)
        local args = table.pack(...)
        local converted, count = run(kind, cmd, args, args.n)
        return table.unpack(converted, 1, count)
    end
end

-- A command of all written without brackets (allasstr) gets them: the text the Function Name has in its brackets
function module.with_brackets(template: string, aliases: table): string

    local filled = template:gsub("%f[%w_]([%w_%.]+)%f[^%w_%.]()", function(word, position)
        local kind = KINDS[aliases[word]]

        if kind ~= nil and kind.all and template:sub(position):match("^%s*%(") == nil then
            return word .. "()"
        end
    end)

    return filled
end

return module
