-- lib/AnitaDarin/ui/logic/stand/call_loop.pluto
-- The loop of a called function: one call every frame, or once every `every` ms, until it's stopped or ends
-- by itself. The same for Call Function (ui/stand/script/call_function) and for a module's functions
-- (ui/stand/modules/list); each says what a call is (step) and when the loop is no longer wanted (is_current).
-- What the last call gave is drawn on the screen every frame (ui/stand/core/call_display).

local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local display = Atdar.loader.load("ui/stand/core/call_display")

local module = {}

-- Starts the loop in a tick handler
-- @param loop_run The loop's state: every (ms, nil for every frame), next (ms of the next call), result (the
--                 text drawn between the calls, nil draws nothing)
-- @param is_current Whether this loop is still the wanted one: false once it's stopped or a newer one replaced it
-- @param step One call; false ends the loop (it failed, or what it calls is gone)
function module.start(loop_run: table, is_current: function, step: function): void
    util.create_tick_handler(function()
        if clicks.is_stopping() or not is_current() then
            return false
        end

        -- The result is drawn every frame (debug text shows for one frame only), so it stays between
        -- the calls of a loop with an interval too
        if loop_run.every ~= nil then
            local now = util.current_time_millis()
            if now < loop_run.next then
                display.draw(loop_run.result)
                return true
            end
            loop_run.next = now + loop_run.every
        end

        if not step() then
            return false
        end

        display.draw(loop_run.result)
        return true
    end)
end

-- Runs the call with its time shown on screen (while Show Call Time is on)
-- @param name What the time is shown under
-- @param call The call, returns its packed results
-- @return What call returned
function module.timed(name: string, call: function): table
    local results = nil

    display.timed(name, function()
        results = call()
    end)

    return results
end

return module
