-- Builds Stand command names for menu items: base name -> prefix + separator + base (or, with Prefix At The
-- End, base + separator + prefix), and renames every tracked item right away when the prefix settings change.
-- The script's own commands (Base Commands) and the loaded menu's (Found Commands) each have their own
-- prefix and separator, so the same base name in both can't clash (atdar_settings and atdarsettings).
--
-- Every item can have a custom name: it takes the base name's place, the prefix stays
-- (godmode -> god gives atdargod), and extra words: more commands for it with the same prefix
-- (gm -> atdargm). Each command's are kept in a file of its own, commands/<base>.json:
--     { "name": "god", "words": ["gm", "immortal"] }
-- in the commands folder of whoever made the item:
--   the loaded menu - the menu's own folder (ui/stand/root passes it to begin_menu): the pack's in store,
--                     or core's for the built-in menu
--   the script      - store/<script>/commands/
-- An older commands.json there ({ base: name }) is still read, and goes once the folder is written.
-- Items made between begin_menu() and end_menu() are the menu's, between begin_user() and end_user() the
-- user's own commands (ui/stand/script/user_commands: named by the user, no custom names or words), all others
-- the script's

local Logger = Atdar.loader.load("core/logger")
local JsonFile = Atdar.loader.load("core/filesystem/json/file")
-- What a command name may be, and the files of names read clean
local command_box = Atdar.loader.load("parsers/stand/command_box")

local log = new Logger("Commands")

local module = {}

-- Prefix and separator of each owner: "script" (Base Commands), "menu" (Found Commands) and "user"
-- (User Commands)
local config = {

    use_prefix = true,

    -- separator: "" -> atdargodmode, "_" -> atdar_godmode, "." -> atdar.godmode
    -- at_end: the prefix after the name: godmode.atdar
    script = { prefix = "atdar", separator = ".", at_end = false },
    menu = { prefix = "atdar", separator = "", at_end = false },
    user = { prefix = "", separator = "", at_end = false },
}

-- ref -> base names it was created with
local tracked = {}

-- ref -> "menu" or "script": whose item it is, so whose custom names apply
local owner = {}

-- Whose items are being made: "menu" while the loaded menu builds, "user" while the user's commands
-- are made, nil for the script's
local building = nil

-- Custom names and extra words of each owner: base name -> { name = custom base name or nil,
-- words = { ... } } (all sanitized), the folder they're kept in and the older commands.json there.
-- The script's are read on first use: tests (and a renamed script) point store elsewhere before that
local custom = { menu = {}, script = nil }
local dirs = { menu = nil, script = nil }
local legacy = { menu = nil, script = nil }

-- An owner's names: the older commands.json first, then each commands/<base>.json (they win)
local function read_names(dir: string, old_file: table): table

    local names = {}

    for base, name in pairs(old_file:read() or {}) do
        if type(base) == "string" then
            local clean_base = command_box.sanitize(base)
            if clean_base ~= "" then
                names[clean_base] = command_box.entry(clean_base, name, nil)
            end
        end
    end

    if filesystem.is_dir(dir) then
        for _, path in ipairs(filesystem.list_files(dir)) do
            local base = path:match("([^\\/]+)%.json$")
            local clean_base = base and command_box.sanitize(base) or ""
            if clean_base ~= "" then
                local data = new JsonFile(path):read() or {}
                names[clean_base] = command_box.entry(clean_base, data.name, data.words)
            end
        end
    end

    return names
end

-- The script's names, read from store/<script>/commands/ the first time they're needed
local function script_custom(): table
    if custom.script == nil then
        local store = $"{filesystem.store_dir()}{Atdar.name}\\"
        dirs.script = $"{store}commands\\"
        legacy.script = new JsonFile($"{store}commands.json")
        custom.script = read_names(dirs.script, legacy.script)
    end
    return custom.script
end

-- The user's commands have no custom names or words: the user names them already
local NO_CUSTOM = {}

local function custom_of_owner(who: string): table
    if who == "menu" then
        return custom.menu
    end

    if who == "user" then
        return NO_CUSTOM
    end

    return script_custom()
end

-- @return Sanitized base names without empty ones and duplicates (parsers/stand/command_box);
-- a name with nothing usable in it is warned about when warn is set
local function clean_bases(bases: table, warn: bool): table

    local clean, skipped = command_box.bases(bases)

    if warn then
        for _, base in ipairs(skipped) do
            log:warn($"command '{base}' has no allowed characters (a-z, 0-9, _), skipped")
        end
    end

    return clean
end

-- The base as the owner's custom names have it
local function effective(clean: string, who: string): string
    local entry = custom_of_owner(who)[clean]
    return entry and entry.name or clean
end

-- The base's extra words (sanitized), {} when it has none
local function words_for(clean: string, who: string): table
    local entry = custom_of_owner(who)[clean]
    return entry and entry.words or {}
end

-- who: "script" or "menu", whose prefix and separator
local function full_name(clean: string, who: string): string
    local own = config[who] or config.script

    if not config.use_prefix or own.prefix == "" then
        return clean
    end

    if own.at_end then
        return $"{clean}{own.separator}{own.prefix}"
    end

    return $"{own.prefix}{own.separator}{clean}"
end

-- Whose items are being made now
local function current_owner(): string
    return building or "script"
end

-- @return Full command names for a list of base names, with the custom names of whoever makes the item now
function module.names(bases: table): table
    return module.names_as(bases, current_owner())
end

-- The same for an owner given ("script", "menu", "user"), whoever makes items now: a name worked out
-- without changing whose items are being made
function module.names_as(bases: table, who: string): table

    local names = {}

    for _, clean in ipairs(clean_bases(bases, true)) do
        table.insert(names, full_name(effective(clean, who), who))
        for _, word in ipairs(words_for(clean, who)) do
            table.insert(names, full_name(word, who))
        end
    end

    return names
end

-- Remembers an item so refresh() can rename it; items without valid commands aren't tracked
function module.track(ref, bases: table): void

    -- Quiet: names() already warned about these when the item was created
    local clean = clean_bases(bases, false)

    if #clean > 0 then
        tracked[ref] = clean
        owner[ref] = current_owner()
    end
end

-- Should be called before an item is deleted. One deleted without it is dropped the next time it's
-- looked at (prune), so renaming never touches a deleted item
function module.untrack(ref): void
    tracked[ref] = nil
    owner[ref] = nil
end

-- Whether Stand still has the item. Without menu.is_ref_valid (an older Stand) every item counts as
-- there: dropping them all would be worse, and renaming is guarded by pcall anyway
local function is_valid(ref): bool
    if type(menu.is_ref_valid) ~= "function" then
        return true
    end

    local ok, valid = pcall(menu.is_ref_valid, ref)
    return ok and valid == true
end

-- Forgets items Stand doesn't have any more (deleted without untrack)
local function prune(): void
    for ref in pairs(tracked) do
        if not is_valid(ref) then
            module.untrack(ref)
        end
    end
end

-- @return An item's full command names with the current settings, or nil if it isn't tracked
function module.names_of(ref): ?table
    local clean = tracked[ref]
    if not clean then
        return nil
    end

    local names = {}

    for _, name in ipairs(clean) do
        table.insert(names, full_name(effective(name, owner[ref]), owner[ref]))
        for _, word in ipairs(words_for(name, owner[ref])) do
            table.insert(names, full_name(word, owner[ref]))
        end
    end

    return names
end

-- @return An item's command names without the prefix ("godmode" or its custom name, then its extra
-- words), or nil if it isn't tracked
function module.bases_of(ref): ?table
    local clean = tracked[ref]
    if not clean then
        return nil
    end

    local names = {}

    for _, name in ipairs(clean) do
        table.insert(names, effective(name, owner[ref]))
        for _, word in ipairs(words_for(name, owner[ref])) do
            table.insert(names, word)
        end
    end

    return names
end

-- ─── Custom names ────────────────────────────────────────────────────────────

-- @return The item's own first base name ("godmode"), whatever its custom name, or nil
function module.base_of(ref): ?string
    local clean = tracked[ref]
    if not clean then
        return nil
    end
    return clean[1]
end

-- @return The item's custom name ("god"), or "" while it has its own
function module.custom_of(ref): string
    local base = module.base_of(ref)
    if base == nil then
        return ""
    end
    local entry = custom_of_owner(owner[ref])[base]
    return entry and entry.name or ""
end

-- @return The item's extra words ("gm", "immortal"), a copy; {} when it has none
function module.words_of(ref): table

    local base = module.base_of(ref)
    local words = {}

    if base ~= nil then
        for _, word in ipairs(words_for(base, owner[ref])) do
            table.insert(words, word)
        end
    end

    return words
end

-- @return The commands folder of "script" or "menu" (the loaded menu's), nil while no menu was loaded
function module.folder_of(who: string): ?string
    if who == "script" then
        script_custom()
    end
    return dirs[who]
end

-- @return "menu" or "script": whose item it is (where its custom name is kept), or nil if it isn't tracked
function module.owner_of(ref): ?string
    return owner[ref]
end

-- The loaded menu starts building. Its names are in menu_dir's commands folder (and an older
-- commands.json there) and apply to everything it makes until end_menu()
function module.begin_menu(menu_dir: string): void
    dirs.menu = $"{menu_dir}commands\\"
    legacy.menu = new JsonFile($"{menu_dir}commands.json")
    custom.menu = read_names(dirs.menu, legacy.menu)
    building = "menu"
end

function module.end_menu(): void
    building = nil
end

-- The user's own commands are made (ui/stand/script/user_commands): their prefix and separator until end_user()
function module.begin_user(): void
    building = "user"
end

function module.end_user(): void
    building = nil
end

-- Writes one command's file: its name and words; with neither left the file goes
local function write_entry(dir: string, base: string, entry): bool

    local file = new JsonFile($"{dir}{base}.json")

    if entry == nil then
        if file:exists() then
            file:remove()
        end
        return true
    end

    local data = { words = entry.words }

    if entry.name then
        data.name = entry.name
    end

    return file:write(data)
end

-- Saves one of an owner's commands into its commands folder. An older commands.json still there is
-- moved over first (every name in it gets its own file), then removed
-- @return Whether it was written
local function save(who: string, base: string): bool

    local dir = dirs[who]

    if dir == nil then
        return false
    end

    local names = custom_of_owner(who)
    local old_file = legacy[who]

    if old_file ~= nil and old_file:exists() then
        for other, entry in pairs(names) do
            if not write_entry(dir, other, entry) then
                return false
            end
        end
        old_file:remove()
    end

    return write_entry(dir, base, names[base])
end

-- Whether another item already answers to name (its own, custom name or a word)
-- Compared as Stand sees them, with the prefixes: the script's "settings" (atdar_settings) and a pack's
-- (atdarsettings) are different commands, so neither keeps the other from a name. Stand's own commands
-- count too: a custom name can't take one of them
local function taken_by_other(ref, name: string): bool

    prune()

    local full = full_name(name, owner[ref] or "script")

    for other in pairs(tracked) do
        if other ~= ref then
            for _, other_full in ipairs(module.names_of(other) or {}) do
                if other_full == full then
                    return true
                end
            end
        end
    end

    if type(menu.ref_by_command_name) == "function" then
        local ok, found = pcall(menu.ref_by_command_name, full)
        if ok and found ~= nil and found ~= ref and menu.is_ref_valid(found) then
            return true
        end
    end

    return false
end

-- The entry of an item's first base, made when it has none yet
local function entry_of(ref): table
    local names = custom_of_owner(owner[ref])
    local base = tracked[ref][1]
    names[base] ??= { name = nil, words = {} }
    return names[base]
end

-- Drops an entry left with no name and no words, so its file goes
local function tidy(ref): void
    local names = custom_of_owner(owner[ref])
    local base = tracked[ref][1]
    local entry = names[base]
    if entry ~= nil and entry.name == nil and #entry.words == 0 then
        names[base] = nil
    end
end

-- Gives an item's first command a custom base name and saves it; "" (or its own base) goes back to its own.
-- @return true, or false and why: "taken" (another item has that command already), "not_saved"
function module.set_custom(ref, name: string): (bool, ?string)
    local clean = tracked[ref]
    if not clean then
        return false, "unknown"
    end

    local base = clean[1]
    local new_name = command_box.sanitize(name)
    local entry = entry_of(ref)

    if new_name == "" or new_name == base then
        entry.name = nil
    else
        -- Two items with one command: Stand would only find one of them
        if taken_by_other(ref, new_name) then
            tidy(ref)
            return false, "taken"
        end
        -- One of its own words becomes its name: not twice
        for i, word in ipairs(entry.words) do
            if word == new_name then
                table.remove(entry.words, i)
                break
            end
        end
        entry.name = new_name
    end

    tidy(ref)
    pcall(menu.set_command_names, ref, module.names_of(ref))

    if not save(owner[ref], base) then
        return false, "not_saved"
    end

    return true, nil
end

-- Adds an extra word to an item: one more command for it, with the same prefix ("gm" -> atdargm).
-- @return true, or false and why: "invalid" (nothing usable in it), "own" (the item has it already),
-- "taken" (another item's command), "not_saved"
function module.add_word(ref, word: string): (bool, ?string)
    local clean = tracked[ref]
    if not clean then
        return false, "unknown"
    end

    local new_word = command_box.sanitize(word)
    if new_word == "" then
        return false, "invalid"
    end

    for _, name in ipairs(module.bases_of(ref)) do
        if name == new_word then
            return false, "own"
        end
    end

    if new_word == clean[1] then
        return false, "own"
    end

    if taken_by_other(ref, new_word) then
        return false, "taken"
    end

    table.insert(entry_of(ref).words, new_word)
    pcall(menu.set_command_names, ref, module.names_of(ref))

    if not save(owner[ref], clean[1]) then
        return false, "not_saved"
    end

    return true, nil
end

-- Takes an extra word off an item
-- @return true, or false and why: "unknown" (it has no such word), "not_saved"
function module.remove_word(ref, word: string): (bool, ?string)

    local clean = tracked[ref]

    if not clean then
        return false, "unknown"
    end

    local entry = custom_of_owner(owner[ref])[clean[1]]
    local found = false

    for i, own in ipairs(entry and entry.words or {}) do
        if own == word then
            table.remove(entry.words, i)
            found = true
            break
        end
    end

    if not found then
        return false, "unknown"
    end

    tidy(ref)
    pcall(menu.set_command_names, ref, module.names_of(ref))

    if not save(owner[ref], clean[1]) then
        return false, "not_saved"
    end

    return true, nil
end

-- @return { ref, names } for every item that has commands, sorted by the first name
function module.list(): table
    prune()
    local items = {}
    for ref in pairs(tracked) do
        table.insert(items, { ref = ref, names = module.names_of(ref) })
    end
    table.sort(items, |a, b| -> a.names[1] < b.names[1])
    return items
end

-- Renames every tracked item with the current settings; a deleted one is dropped instead
function module.refresh(): void
    prune()
    for ref in pairs(tracked) do
        -- Still guarded: one item failing mustn't stop the rest from being renamed
        pcall(menu.set_command_names, ref, module.names_of(ref))
    end
end

-- who: "script" (default) or "menu"
function module.set_prefix(prefix: string, who: string = "script"): void
    config[who].prefix = command_box.sanitize(prefix)
    module.refresh()
end

function module.set_use_prefix(use: bool): void
    config.use_prefix = use
    module.refresh()
end

-- Separators a command name may have between its prefix and its name: atdargodmode, atdar_godmode, atdar.godmode
local SEPARATORS = { [""] = true, ["_"] = true, ["."] = true }

-- "", "_" or "."; who: "script" (default), "menu" or "user"
function module.set_separator(separator: string, who: string = "script"): void
    if not SEPARATORS[separator] then
        log:warn($"separator must be '', '_' or '.', got '{separator}'")
        return
    end
    config[who].separator = separator
    module.refresh()
end

-- Puts the prefix after the name (godmode.atdar) or back in front; who: "script" (default), "menu" or "user"
function module.set_at_end(at_end: bool, who: string = "script"): void
    config[who].at_end = at_end
    module.refresh()
end

-- who: "script" (default) or "menu"
function module.get_config(who: string = "script"): table
    return { prefix = config[who].prefix, use_prefix = config.use_prefix, separator = config[who].separator,
        at_end = config[who].at_end }
end

-- Profile keys of each owner's prefix, its place and separator
local PROFILE_KEYS = {
    command_box_base_prefix = { who = "script", what = "prefix" },
    command_box_base_prefix_at_end = { who = "script", what = "at_end" },
    command_box_base_separator = { who = "script", what = "separator" },
    command_box_found_prefix = { who = "menu", what = "prefix" },
    command_box_found_prefix_at_end = { who = "menu", what = "at_end" },
    command_box_found_separator = { who = "menu", what = "separator" },
    command_box_user_prefix = { who = "user", what = "prefix" },
    command_box_user_prefix_at_end = { who = "user", what = "at_end" },
    command_box_user_separator = { who = "user", what = "separator" },
}

-- Whether a change of the profile key renames commands: what shows command names follows those
function module.is_name_key(key: string): bool
    return PROFILE_KEYS[key] ~= nil
end

-- Prefixes and separators come from the script profile and follow its changes; an empty prefix means none
local profile = Atdar.profile

if profile and profile.get then
    for key, target in pairs(PROFILE_KEYS) do

        local value = profile.get(key)

        if target.what == "prefix" then
            -- No command_box_found_prefix in the profile (an old one): the same as the script's
            config[target.who].prefix = command_box.sanitize(value or profile.get("command_box_base_prefix") or "")
        elseif target.what == "at_end" then
            config[target.who].at_end = value == true
        else
            config[target.who].separator = SEPARATORS[value] and value or ""
        end
    end

    profile.on_change(function(key: string, value)
        local target = PROFILE_KEYS[key]
        if target == nil then
            return
        end
        
        if target.what == "prefix" then
            module.set_prefix(value or "", target.who)
        elseif target.what == "at_end" then
            module.set_at_end(value == true, target.who)
        else
            module.set_separator(SEPARATORS[value] and value or "", target.who)
        end
    end)
end

return module
