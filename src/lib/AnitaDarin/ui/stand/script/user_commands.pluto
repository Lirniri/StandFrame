-- lib/AnitaDarin/ui/stand/script/user_commands.pluto
--
-- The user's own commands: a name that runs other commands, Stand's or the script's, one after another -
-- ready -> "godmode on; neverwanted on; tpwaypoint". Made in Command Box > User Commands:
--
--   Prefix, Separator             - of these commands only (profile: command_box_user_prefix / _separator)
--   Create                        - type a name: the command is made, empty
--   Remove                        - pick one: it goes, with its file
--   ── Commands ──
--   ready >    Run                - the command itself: atdar_ready
--              Commands           - what it runs, separated by ;
--              Description        - Run's help
--
-- What they do (files, running, names) is in ui/logic/stand/script/user_commands.
-- Strings: core/language "script_menu.user_commands"

local i18n = Atdar.loader.load("core/i18n")
local commands = Atdar.loader.load("ui/logic/stand/commands")
local profile_menu = Atdar.loader.load("ui/stand/script/profile")
local user_commands = Atdar.loader.load("ui/logic/stand/script/user_commands")

local module = {}

-- Strings under "script_menu.user_commands"
local label = i18n.scope("script_menu.user_commands")

-- One command's list: Run (the command itself), Commands, Description
local function entry_list(node: table, name: string, entry: table): void

    local run = nil

    -- Run is named after what it runs: the items its commands are ("atdar_settings" -> "Settings"), so
    -- the command box and Stand's lists say what it does; with the cursor on it, it reads "Run", a button.
    -- Its name comes back when the cursor leaves or the list is gone back out of
    local function show_command(): void
        run:set_name(user_commands.caption(name, entry))
    end

    local list = node:list({ name = name, help = entry.help, on_back = show_command })

    commands.begin_user()

    -- The caption follows every command's prefix, place and separator: a profile reset or loaded changes
    -- them all at once, and Run must find each command under its new name
    run = list:action({ caption = || -> user_commands.caption(name, entry), help = user_commands.run_help(entry),
        commands = { name }, on_click = || -> user_commands.run(name, entry) })
    run:on_focus(|| -> run:set_name(label("run.name")))
    run:on_blur(show_command)

    list:text_input({ key = "commands", commands = { $"cbuser{name}" }, default = table.concat(entry.commands, "; "),
        on_change = function(value)
            user_commands.set_commands(name, entry, value)
            run:set_help(user_commands.run_help(entry))
            -- Named after what it runs now
            show_command()
        end })

    list:text_input({ key = "description", commands = { $"cbuser{name}help" }, default = entry.help,
        on_change = function(value)
            user_commands.set_help(name, entry, value)
            run:set_help(user_commands.run_help(entry))
            list:set_help(value)
        end })

    commands.end_user()
end

-- User Commands, in node (Command Box's Commands part)
function module.build(node: table): table

    local ui = node:scope("script_menu.user_commands")
    local list = ui:list({ name = label("name"), help = label("help") })
    local shown = { entries = {}, names = {} } -- the commands under the divider, as read from the files
    local remove = nil
    local part = nil

    -- The commands under the divider made again, from the files
    local function refresh(): void
        part.rebuild()
    end

    profile_menu.user_command_box(list)

    list:text_input({ key = "create", commands = { "cbusercreate" }, default = "",
        on_change = |value| -> user_commands.create(value, shown.entries, refresh) })

    remove = list:list_action({ key = "remove", commands = { "cbuserremove" },
        options = user_commands.remove_options({}),
        warning = function(index)
            local name = shown.names[index]
            if name == nil then
                return nil
            end

            return user_commands.remove_warning(name)
        end,
        on_select = function(index)
            local name = shown.names[index]
            if name == nil then
                return
            end

            user_commands.delete(name, refresh)
        end })

    list:divider({ name = i18n.label("script_menu.commands.divider") })
    user_commands.make_example()

    part = list:section(function(section)

        shown.entries = user_commands.read()
        shown.names = user_commands.names_of(shown.entries)

        for _, name in ipairs(shown.names) do
            entry_list(section, name, shown.entries[name])
        end

        if #shown.names == 0 then
            section:readonly_name({ name = label("none") })
        end

        remove:set_options(user_commands.remove_options(shown.names))
    end)

    return list
end

return module
