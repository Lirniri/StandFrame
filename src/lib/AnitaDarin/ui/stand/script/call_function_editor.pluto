-- lib/AnitaDarin/ui/stand/script/call_function_editor.pluto
--
-- Debug > Files Editor, right under Call Function: the JSON files of Call Function (core/call_function and
-- user/call_function in the script's store) as a tree to edit. What it does with the files is in the system
-- module FileEditor (modules/systems/FileEditor); the list is shown only while that module runs.
--
--   Files Editor >   Create File (a name; the file is made in user/call_function)
--                    Files (divider), then a list per file: core/short_name.json, user/short_names.json, ...
--   a file >         Delete File (not for short_name.json and stand_api.json: "Protected File" is there instead)
--                    Add Value, Add Table, Remove, a divider, then the entries
--   a table >        the same: Add Value, Add Table, Remove, a divider, then its entries
--
-- short_name.json and stand_api.json have a shape the logic knows: their own table takes functions only (Add
-- Function, a ready-made entry), a function's params take parameters only (Add Parameter, typed as the code
-- writes one: "speed: float = 1.5"), and a function or a parameter takes only its own keys.
--
-- An entry that is a value is a text field with the value in it: text in quotes (or a bare word), a number,
-- true or false; nil takes the entry away. An entry that is a table is a list to open. Every change is
-- written to the file at once. The lists are made when they're opened and removed when they're left.
-- Strings: core/language "script_menu.call_function.editor"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("CallFunctionEditor")

local module = {}

-- Strings under "script_menu.call_function.editor": the keys of its items
local SCOPE = "script_menu.call_function.editor"
local label, text = i18n.scope(SCOPE)

-- The file logic: the FileEditor module, asked for at every use (Reload makes a new one)
local function files(): table
    return Atdar.modules.get("FileEditor")
end

-- Stand's text fields need a command each: short, unique while the field exists
local command_number = 0

-- @return A base command name no other field has now
local function next_command(): string
    command_number += 1

    return $"callfunceditor{command_number}"
end

-- A text field of the editor; not one of the found commands (its command isn't tracked)
-- @param opts The item's options: key, or name and help; default (what's in it); command (its own name, else a numbered one)
-- @param on_typed function(value) the user typed in it
local function field(node: table, opts: table, on_typed: function): table

    opts.commands = { opts.command or next_command() }
    opts.track = false
    opts.user_only = true
    opts.on_change = |value| -> on_typed(value)

    return node:text_input(opts)
end

-- @param key An entry's key: a name, or a number in a list
-- @return How it's shown: the name, or [number]
local function key_text(key): string
    if type(key) == "number" then
        return $"[{key}]"
    end

    return tostring(key)
end

-- Saves the file the context belongs to; says so when it can't
-- @param context { id, data }
local function save(context: table): void
    if not files():write(context.id, context.data) then
        log:error(text("not_saved"):format(context.id))
    end
end

-- Says why something typed wasn't taken. keys: for "key", the keys that may be there
local function warn(why: string, keys: ?string): void
    if why == "key" then
        log:warn(text("errors.key"):format(keys or ""))
        return
    end

    log:warn(text($"errors.{why}"))
end

-- The divider above a table's entries, by the table's place in its file
local ENTRIES_DIVIDER = { params = "params.divider" }

-- Puts the controls of a table and its entries in node (made empty by the caller)
-- @param context { id, data }: the file, its whole table, for saving
-- @param place The table's place in the file (FileEditor:place_of): what can be added to it
local function fill_table(node: table, context: table, tbl: table, place: string): void

    local ui = node:scope(SCOPE)
    -- The entries, made again after a change
    local entries = nil
    -- The own table of a file with a shape: functions only
    local shaped_root = place == "root" and files():place_of(context.id, place, "") == "entry"

    -- A table added (a function, a parameter or an empty one): typed is its name, or the parameter as code
    local function add_table(typed: string): void
        local ok, why, keys = files():add_table(tbl, typed, context.id, place)

        if not ok then
            warn(why, keys)
            return
        end

        save(context)
        entries.rebuild()
    end

    if place == "params" then
        field(ui, { key = "add_param" }, add_table)
    elseif shaped_root then
        field(ui, { key = "add_function" }, add_table)
    else
        field(ui, { key = "add_value" }, function(value)
            local ok, why, keys = files():add_value(tbl, value, context.id, place)

            if not ok then
                warn(why, keys)
                return
            end

            save(context)
            entries.rebuild()
        end)

        field(ui, { key = "add_table" }, add_table)
    end

    field(ui, { key = "remove" }, function(value)
        if not files():remove(tbl, value) then
            log:warn(text("errors.no_entry"):format(value))
            return
        end

        save(context)
        entries.rebuild()
    end)

    if shaped_root then
        ui:divider({ name = label("functions.divider") })
    else
        ui:divider({ name = label(ENTRIES_DIVIDER[place] or "entries.divider") })
    end

    -- The entries, as the table is now
    entries = ui:section(function()

        local shown = files():entries(tbl)

        if #shown == 0 then
            ui:readonly_name({ name = label("empty") })
        end

        for _, entry in ipairs(shown) do

            local key = entry.key
            local value = entry.value

            if type(value) == "table" then
                local child_place = files():place_of(context.id, place, key)

                ui:list({ name = $"{key_text(key)} ({files():count(value)})", help_key = "table",
                    fill = |child| -> fill_table(child, context, value, child_place) })
            else
                field(ui, { name = key_text(key), help_key = "value", default = files():describe(value) }, function(typed)
                    local ok, why, gone = files():set(tbl, key, typed)

                    if not ok then
                        warn(why)
                        return
                    end

                    save(context)

                    -- Taken away: the entries without it
                    if gone then
                        entries.rebuild()
                    end
                end)
            end
        end
    end)
end

-- A file's list: Delete File (or Protected File), then its table
-- @param file { id, name, area, protected }
-- @param refresh function() the files of the editor made again
local function file_list(parent: table, file: table, refresh: function): void

    local deleted = false
    local cancel = nil

    parent:list({ name = $"{file.area}/{file.name}", help = file.id,
        fill = function(node)

            local context = { id = file.id, data = files():read(file.id) }

            if file.protected then
                node:readonly_name({ name = label("protected") })
            else
                cancel = select(2, node:scope(SCOPE):confirm({ key = "delete",
                    on_confirm = function()
                        local ok, why = files():delete(file.id)

                        if not ok then
                            log:warn(text($"errors.{why}"))
                            return
                        end

                        -- The list is left empty: the notice says it, and the list goes when it's left
                        deleted = true
                        node:clear()
                        log:notify(text("delete.done"):format(file.id))
                    end,
                    on_first = || -> log:warn(text("delete.warning"):format(file.id)),
                }))
            end

            fill_table(node, context, context.data, "root")
        end,
        on_back = function()
            if cancel ~= nil then
                cancel()
            end

            -- A deleted file's list goes now that it's left
            if deleted then
                refresh()
            end
        end,
    })
end

-- Places: user, menu (the packs, and the core menu as "core") and logs, to look at. Nothing here is written

-- A text file: its lines a page at a time, with Previous and Next
local function view_file(parent: table, id: string, name: string|int): void

    parent:list({ name = name, help = id, fill = function(node)

        local page = 1
        local body = nil

        -- Texts to take out of the lines, to shorten them; typed again, one is shown again
        field(node:scope(SCOPE), { key = "view.hide" }, function(value)
            files():hide_text(value)
            body.rebuild()
        end)

        body = node:section(function()

            local data, why = files():read_text(id, page)

            if data == nil then
                node:readonly_name({ name = label($"view.{why}") })
                return
            end

            node:readonly_name({ name = text("view.page"):format(data.page, data.pages) })

            node:scope(SCOPE):action({ key = "view.previous", on_click = function()
                page = math.max(data.page - 1, 1)
                body.rebuild()
            end })
            node:scope(SCOPE):action({ key = "view.next", on_click = function()
                page = math.min(data.page + 1, data.pages)
                body.rebuild()
            end })

            local hidden = files():hidden_texts()

            if #hidden > 0 then
                node:readonly_name({ name = text("view.hidden"):format(table.concat(hidden, ", ")) })
                node:scope(SCOPE):action({ key = "view.clear_hidden", on_click = function()
                    files():clear_hidden()
                    body.rebuild()
                end })
            end

            node:divider({ name = label("view.divider") })

            for _, line in ipairs(data.lines) do
                node:readonly_name({ name = line == "" and " " or line })
            end
        end)
    end })
end

-- A folder: its folders and files, each opened on its own
local function folder_list(parent: table, id: string, name: string|int): void

    parent:list({ name = name, help = id, fill = function(node)

        local found = files():browse(id)

        if found == nil then
            node:readonly_name({ name = label("view.missing") })
            return
        end

        if #found.folders == 0 and #found.files == 0 then
            node:readonly_name({ name = label("empty") })
        end

        for _, folder in ipairs(found.folders) do
            folder_list(node, $"{id}/{folder}", folder)
        end

        for _, file in ipairs(found.files) do
            view_file(node, $"{id}/{file}", file)
        end
    end })
end

-- User code: the .pluto files of core/call_function (core/user_script), a line at a time

-- How many lines of a file a page shows
local CODE_PAGE = 30

-- The code logic: what reads and writes the files
local function code(): table
    return Atdar.user_code
end

-- Tells the mistake in the code, if the save found one (the file is saved anyway)
local function code_saved(name: string, ok: bool, mistake: ?string): void

    if not ok then
        log:error(text("code.not_saved"):format(name))
        return
    end

    if mistake ~= nil then
        log:warn(text("code.mistake"):format(name, mistake))
    end
end

-- A code file: its lines as fields, Add Line, Insert Line, Remove Line and the pages
local function code_file(parent: table, name: string, refresh: function): void

    local deleted = false
    local cancel = nil

    parent:list({ name = $"{name}.pluto", help = label("code.file_help"), fill = function(node)

        local ui = node:scope(SCOPE)
        local page = 1
        local body = nil

        if name == code().MAIN then
            node:readonly_name({ name = label("code.main") })
        else
            cancel = select(2, ui:confirm({ key = "code.delete",
                on_confirm = function()
                    local ok, why = code().delete(name)

                    if not ok then
                        log:warn(text($"code.errors.{why}"))
                        return
                    end

                    deleted = true
                    node:clear()
                    log:notify(text("code.deleted"):format(name))
                end,
                on_first = || -> log:warn(text("code.delete_warning"):format(name)),
            }))
        end

        -- The line is added at the end
        field(ui, { key = "code.add_line" }, function(value)
            local lines = code().read_lines(name) or {}
            local ok, mistake = code().insert_line(name, #lines + 1, value)

            code_saved(name, ok, mistake)
            page = math.huge
            body.rebuild()
        end)

        -- "3: text": a new line before line 3
        field(ui, { key = "code.insert_line" }, function(value)

            local number, line = value:match("^%s*(%d+)%s*:%s?(.*)$")

            if number == nil then
                log:warn(text("code.errors.insert"))
                return
            end

            code_saved(name, code().insert_line(name, tonumber(number), line))
            body.rebuild()
        end)

        field(ui, { key = "code.remove_line" }, function(value)

            local number = tonumber(value)

            if number == nil or not code().remove_line(name, math.tointeger(number) or 0) then
                log:warn(text("code.errors.no_line"):format(value))
                return
            end

            body.rebuild()
        end)

        body = node:section(function()

            local lines = code().read_lines(name)

            if lines == nil then
                node:readonly_name({ name = label("view.missing") })
                return
            end

            local pages = math.max(1, math.ceil(#lines / CODE_PAGE))

            page = math.min(math.max(page, 1), pages)

            node:readonly_name({ name = text("view.page"):format(page, pages) })

            ui:action({ key = "code.previous", on_click = function()
                page = math.max(page - 1, 1)
                body.rebuild()
            end })
            ui:action({ key = "code.next", on_click = function()
                page = math.min(page + 1, pages)
                body.rebuild()
            end })

            node:divider({ name = label("view.divider") })

            for number = (page - 1) * CODE_PAGE + 1, math.min(page * CODE_PAGE, #lines) do

                -- [1]: a bare number would be taken for a translation key
                field(node, { name = $"[{number}]", help = label("code.line_help"), default = lines[number],
                    command = $"callfunceditor_usercode{number}" },
                    function(value)
                        code_saved(name, code().set_line(name, number, value))
                    end)
            end
        end)
    end,
    on_back = function()
        if cancel ~= nil then
            cancel()
        end

        if deleted then
            refresh()
        end
    end })
end

-- The list of the user code: Create File and a list per file
local function code_list(parent: table): void

    parent:list({ name = label("code.name"), help = label("code.help"), fill = function(node)

        local shown = nil

        field(node:scope(SCOPE), { key = "code.create" }, function(value)
            local name, why = code().create(value)

            if name == nil then
                log:warn(text($"code.errors.{why}"))
                return
            end

            log:notify(text("code.created"):format(name))
            shown.rebuild()
        end)

        node:divider({ name = label("files.divider") })

        shown = node:section(function()
            for _, name in ipairs(code().list()) do
                code_file(node, name, || -> shown.rebuild())
            end
        end)
    end })
end

-- Whether the FileEditor module is there and running: the list is shown only then
function module.is_available(): bool
    return Atdar.modules.is_running("FileEditor")
end

-- The Files Editor's list as it was last made, for module.focus
local editor_list = nil

-- Takes the cursor to the Files Editor (a link from Call Function)
-- @return Whether the list is there to go to
function module.focus(): bool

    if editor_list == nil then
        return false
    end

    return editor_list:focus()
end

-- Makes the Files Editor list in node (Debug)
-- @return The Files Editor's list, and when it's shown: while the FileEditor module runs
function module.build(node: table)

    -- The file lists, made again when a file is made or deleted
    local shown = nil
    local list = node:list({ name = label("name"), help = label("help"), fill = function(editor)

        field(editor:scope(SCOPE), { key = "create" }, function(value)
            local ok, result = files():create(value)

            if not ok then
                log:warn(text($"create.{result}"))
                return
            end

            log:notify(text("create.done"):format(result))
            shown.rebuild()
        end)

        -- Asked for by a link (Call Function's Open In Files Editor): shown first
        local requested = files():take_request()

        if requested ~= nil then
            editor:divider({ name = label("opened.divider") })

            if files():browse(requested) ~= nil then
                folder_list(editor, requested, requested)
            else
                view_file(editor, requested, requested)
            end
        end

        -- The user's own code: Atdar.user_script, called from Call Function
        code_list(editor)

        editor:divider({ name = label("files.divider") })

        shown = editor:section(function()
            for _, file in ipairs(files():list()) do
                file_list(editor, file, || -> shown.rebuild())
            end
        end)

        editor:divider({ name = label("places.divider") })

        for _, place in ipairs(files():places()) do
            folder_list(editor, place, label($"places.{place}"))
        end
    end })

    editor_list = list

    return list, module.is_available
end

return module
