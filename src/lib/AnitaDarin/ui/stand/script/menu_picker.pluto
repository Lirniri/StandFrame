-- lib/AnitaDarin/ui/stand/script/menu_picker.pluto
-- The entries of Load Menu: the built-in menu (if any) and every pack in store, with their state.
-- What they say and do is in ui/logic/stand/menu_entries; loading and copying in ui/logic/stand/menu_loader.
-- Strings: core/language "menu_loader"

local i18n = Atdar.loader.load("core/i18n")
local menu_loader = Atdar.loader.load("ui/logic/stand/menu_loader")
local entries = Atdar.loader.load("ui/logic/stand/menu_entries")

local module = {}

-- Strings under "menu_loader"
local label = i18n.scope("menu_loader")

-- Adds an entry per available menu to the node. The section is rebuilt after every load and unload,
-- so the states are always current; the texts follow the language shown
-- @param loader The menu_loader controller the entries act through
function module.fill(node: table, loader: table): void

    local ui = node:scope("menu_loader")
    local builtin = menu_loader.has_builtin()
    local manifest = builtin and menu_loader.core_manifest()
    local packs = menu_loader.find_packs()

    -- With no menu at all, the divider itself says so
    local divider_key = "menus.divider"
    if not builtin and #packs == 0 then
        divider_key = "no_menus"
    end

    -- A copied built-in menu sits above the divider, apart from the menus it can be replaced with
    if not manifest then
        ui:divider({ name = label(divider_key) })
    end

    if builtin then

        local loaded = loader.is_loaded("builtin")

        -- A list with the script's name as its divider, then what can be done with the menu
        local help = || -> label("builtin.help")

        if manifest then
            help = || -> entries.copied_help(manifest)
        end

        local list = ui:list({ caption = || -> entries.builtin_caption(loaded), help_from = help,
            commands = { "menuloaderbuiltinlist" } })

        list:divider({ name = entries.builtin_title() })
        list:action({ name = label("options.load"), help = label("builtin.help"), commands = { "menuloaderbuiltin" },
            on_click = loader.load_builtin })

        if manifest then
            list:action({ name = label("options.remove_from_core"), help = help(),
                on_click = || -> entries.copied_option(loader, 2) })
            ui:divider({ name = label(divider_key) })
        end
    end

    for _, info in ipairs(packs) do

        local loaded = loader.is_loaded("pack", info.folder)
        local in_core = manifest and manifest.pack == info.name
        local options = { label("options.load"), label("options.copy_to_core"), label("options.open_menu_folder"),
            label("options.open_features_folder") }

        ui:list_action({ caption = || -> entries.with_state(info.name, loaded, in_core),
            help_from = || -> entries.pack_help(info), options = options, commands = { entries.pack_command(info) },
            on_select = |index| -> entries.pack_option(loader, info, index) })
    end
end

return module
