-- The Update list of the script's section (script_menu puts it under Open Folder): checking for a new
-- release and installing it.
--
--   Installed Version: unknown     (read-only)
--   Available Version: not checked (read-only)
--   Last Check: never              (read-only, profile: update_last_check)
--   Changes                        (what the available version changes)
--   ── Check ──
--   Check For Updates
--   Check On Start                 (profile: update_check_on_start)
--   Branch: main                   (profile: update_branch)
--   ── Update ──
--   Progress: [=====-----] 50%     (read-only, the download of an update)
--   Update
--   Check Before Updating          (profile: update_check_before)
--   Progress In Notifications      (profile: update_progress_notify)
--   Update Automatically         (profile: auto_update)
--   Check For Updates Every (Days) (profile: update_check_days)
--   Update To Version              (a list)
--     Version                      (a version, a tag, a branch or a commit to install, an older one too)
--     Sync With Branch             (the Branch's releases; off: every branch's, each marked; profile: update_versions_sync)
--     Limit Shown To               (how many of the newest versions are listed; profile: update_versions_shown)
--     ── Versions ──
--     0.1.10, 0.1.9, ...           (the releases, read when the list is opened; one is installed by a click)
--
-- The work is done by core/update_manager (check, install, the automatic check); the menu only starts it
-- in a thread and shows what it found (the lines follow it and the language). The texts of the lines and
-- what the other items do are in ui/logic/stand/script/updater_view.
-- Commands start with updater: updater, updatercheck, updaterinstall, updaterauto, updaterdays,
-- updaterbranch, updaterbefore, updaterprogress, updaterchanges, updaterstart, updaterversion, updatersync
-- Strings: core/language "updater_menu"

local i18n = Atdar.loader.load("core/i18n")
local manager = Atdar.loader.load("core/update_manager")
local live = Atdar.loader.load("ui/stand/core/live")
local updater = Atdar.loader.load("ui/logic/stand/script/updater_view")

local module = {}

-- Strings under "updater_menu"
local label = i18n.scope("updater_menu")

-- Whether the manager already refreshes the info lines: build() runs at every rebuild of the settings, and a
-- listener added each time would be called that many times for every downloaded file
local listening = false

-- An item running a function of the manager in a thread: the check and the install download, so they yield
local function threaded(node: table, key: string, command: string, run: function): void
    node:action({ key = key, commands = { command }, on_click = || -> util.create_thread(run) })
end

-- A switch kept in the profile; on unless the profile says off (default_on), or off unless it says on
local function flag(node: table, key: string, profile_key: string, command: string, default_on: bool): void

    local value = Atdar.profile.get(profile_key)
    local on = value == true

    if default_on then
        on = value ~= false
    end

    node:toggle({ key = key, commands = { command }, default = on,
        on_change = |state| -> updater.set_flag(profile_key, state) })
end

-- Update To Version: a version typed, or picked from the releases listed under the Versions divider
local function version_list(list: table): void

    -- The releases the newest fetch found, made into actions by the section below
    local rows = {}
    local versions = nil
    local part = nil

    -- Made again at every opening, so the list is what the repo has now; kept: with the versions of the last
    -- opening (Limit Shown To changed: nothing new to ask the network)
    local latest = 0

    local function fill_versions(kept: bool = false): void

        latest += 1
        local mine = latest

        util.create_thread(function()

            local found = updater.version_rows(kept)

            -- A newer making started meanwhile (opened again, the limit changed): it fills the list, not this
            -- one. The list may be gone by now too (the section was made again)
            if mine ~= latest or not versions:valid() then
                return
            end

            rows = found
            part.rebuild()
        end)
    end

    versions = list:list({ key = "version", commands = { "updaterversions" }, on_open = || -> fill_versions() })

    local input = nil
    input = versions:text_input({ key = "version.input", commands = { "updaterversion" },
        on_change = function(value, click_type)

            local typed = updater.typed_version(value, click_type)

            if typed == nil then
                return
            end

            input:warn(click_type, updater.update_warning(typed), || -> updater.update_to(typed))
        end })

    versions:toggle({ key = "version.sync", commands = { "updatersync" }, default = updater.versions_synced(),
        on_change = function(on)
            if updater.set_versions_synced(on) and updater.versions_loaded() then
                fill_versions()
            end
        end })
    -- Also Stand's own Reset Settings and Set To Min / Max: the list follows, from the versions it has
    versions:slider({ key = "version.limit", commands = { "updaterversionsshown" }, min = 1, max = 50,
        default = updater.versions_shown(), step = 1, on_change = function(count)
            if updater.set_versions_shown(count) and updater.versions_loaded() then
                fill_versions(true)
            end
        end })
    versions:divider({ name = label("version.divider") })

    part = versions:section(function(node)
        for _, row in ipairs(rows) do

            local item = nil

            item = node:action({ name = row.caption, help = label("version.item_help"),
                on_click = |click_type| -> item:warn(click_type, updater.update_warning(row.version),
                    || -> updater.update_to(row.version)) })
        end
    end)
end

function module.build(node: table): table

    local ui = node:scope("updater_menu")
    local list = ui:list({ name = label("name"), help = label("help"), commands = { "updater" } })

    -- The info lines follow the manager: a check, the download of an update
    list:readonly({ caption = updater.installed_caption, value_from = updater.installed_text })
    list:readonly({ caption = updater.available_caption, value_from = updater.available_text })
    list:readonly({ caption = updater.last_check_caption, value_from = updater.last_check_text })
    if not listening then
        listening = true
        manager.on_change(|| -> live.refresh())
    end
    list:action({ key = "changes", commands = { "updaterchanges" }, on_click = updater.save_changes })

    list:divider({ name = label("check_divider") })
    threaded(list, "check", "updatercheck", manager.check)

    -- The branch updates come from, its name in the item: "Branch: main"
    local branch = nil
    branch = list:list_action({ caption = updater.branch_caption, help_key = "branch",
        options = updater.branch_options(), commands = { "updaterbranch" }, on_select = function(index)
            updater.set_branch(index)
            branch:set_name(updater.branch_caption())
        end })

    flag(list, "on_start", "update_check_on_start", "updaterstart", true)

    list:divider({ name = label("divider") })
    list:readonly({ caption = updater.progress_caption, value_from = updater.progress_text })
    threaded(list, "install", "updaterinstall", manager.install_and_restart)
    flag(list, "before", "update_check_before", "updaterbefore", true)

    -- Applied on a click with the days picked: 0 - never
    list:click_slider({ key = "check_days", commands = { "updaterdays" }, min = 0, max = 30,
        default = Atdar.profile.get("update_check_days") or 1, step = 1,
        on_click = |days| -> updater.set_check_days(days) })

    flag(list, "progress_notify", "update_progress_notify", "updaterprogress", true)
    flag(list, "auto", "auto_update", "updaterauto", false)

    version_list(list)

    return list
end

return module
