-- The Update list of the script's section (script_menu puts it under Open Folder): checking for a new
-- release and installing it.
--
--   Installed Version: unknown     (read-only)
--   Available Version: not checked (read-only)
--   Last Check: never              (read-only, profile: update_last_check)
--   Changes                        (what the available version changes)
--   ── Check ──
--   Check For Updates
--   Check On Start                 (profile: update_check_on_start)
--   Branch: main                   (profile: update_branch)
--   ── Update ──
--   Progress: [=====-----] 50%     (read-only, the download of an update)
--   Update
--   Check Before Updating          (profile: update_check_before)
--   Progress In Notifications      (profile: update_progress_notify)
--   Update Automatically         (profile: auto_update)
--   Check For Updates Every (Days) (profile: update_check_days)
--   Update To Version              (a list)
--     Version                      (a version, a tag, a branch or a commit to install, an older one too)
--     Sync With Branch             (the Branch's releases; off: every branch's, each marked; profile: update_versions_sync)
--     Limit Shown To               (how many of the newest versions are listed; profile: update_versions_shown)
--     ── Versions ──
--     0.1.10, 0.1.9, ...           (the releases, read when the list is opened; one is installed by a click)
--
-- The work is done by core/update_manager (check, install, the automatic check); the menu only starts it
-- in a thread and shows what it found. The texts of the lines and what the other items do are in
-- ui/logic/stand/script/updater_view.
-- Commands start with updater: updater, updatercheck, updaterinstall, updaterauto, updaterdays,
-- updaterbranch, updaterbefore, updaterprogress, updaterchanges, updaterstart, updaterversion, updatersync
-- Strings: core/language "updater_menu"

local i18n = Atdar.loader.load("core/i18n")
local manager = Atdar.loader.load("core/update_manager")
local updater = Atdar.loader.load("ui/logic/stand/script/updater_view")

local module = {}

-- Strings under "updater_menu"
local label = i18n.scope("updater_menu")

-- The info lines and the branch picker made by build
local view = { branch = nil, installed = nil, available = nil, last_check = nil, progress = nil }

-- An item running a function of the manager in a thread: the check and the install download, so they yield
local function threaded(node: table, key: string, command: string, run: function): void
    node:action(label($"{key}.name"), || -> util.create_thread(run), { command }, label($"{key}.help"))
end

-- A switch kept in the profile; on unless the profile says off (default_on), or off unless it says on
local function flag(node: table, key: string, profile_key: string, command: string, default_on: bool): void

    local value = Atdar.profile.get(profile_key)
    local on = value == true

    if default_on then
        on = value ~= false
    end

    node:toggle(label($"{key}.name"), |state| -> updater.set_flag(profile_key, state), { command }, label($"{key}.help"), on)
end

-- Puts what's known into the info lines. A line of a removed section is skipped
local function refresh_info(): void
    if view.installed == nil then
        return
    end

    pcall(menu.set_value, view.installed, updater.installed_text())
    pcall(menu.set_menu_name, view.installed, updater.installed_caption())
    pcall(menu.set_value, view.available, updater.available_text())
    pcall(menu.set_menu_name, view.available, updater.available_caption())
    pcall(menu.set_value, view.last_check, updater.last_check_text())
    pcall(menu.set_menu_name, view.last_check, updater.last_check_caption())
    pcall(menu.set_value, view.progress, updater.progress_text())
    pcall(menu.set_menu_name, view.progress, updater.progress_caption())
end

-- Whether the manager already calls refresh_info: build() runs at every rebuild of the settings, and a listener
-- added each time would be called that many times for every downloaded file
local listening = false

function module.build(node: table): table

    local list = node:list(label("name"), { "updater" }, label("help"))

    view.installed = list:readonly(updater.installed_caption(), "")
    view.available = list:readonly(updater.available_caption(), "")
    view.last_check = list:readonly(updater.last_check_caption(), "")
    refresh_info()
    if not listening then
        listening = true
        manager.on_change(refresh_info)
    end
    list:action(label("changes.name"), updater.save_changes, { "updaterchanges" }, label("changes.help"))

    list:divider(label("check_divider"))
    threaded(list, "check", "updatercheck", manager.check)

    -- The branch updates come from, its name in the item: "Branch: main"
    view.branch = list:list_action(updater.branch_caption(), updater.branch_options(), function(index)
        updater.set_branch(index)
        pcall(menu.set_menu_name, view.branch, updater.branch_caption())
    end, { "updaterbranch" }, label("branch.help"))

    flag(list, "on_start", "update_check_on_start", "updaterstart", true)

    list:divider(label("divider"))
    view.progress = list:readonly(label("info.progress"), updater.progress_text())
    threaded(list, "install", "updaterinstall", manager.install_and_restart)
    flag(list, "before", "update_check_before", "updaterbefore", true)

    -- Applied on a click with the days picked: 0 - never
    list:click_slider(label("check_days.name"), 0, 30, Atdar.profile.get("update_check_days") or 1, 1,
        |days| -> updater.set_check_days(days), { "updaterdays" }, label("check_days.help"))

    flag(list, "progress_notify", "update_progress_notify", "updaterprogress", true)
    flag(list, "auto", "auto_update", "updaterauto", false)
    
    -- A version typed, or picked from the releases made: that release is installed, an older one too
    local versions = nil
    local first_version = 0

    -- Made again at every opening, so the list is what the repo has now; kept: with the versions of the last
    -- opening (Limit Shown To changed: nothing new to ask the network)
    local latest = 0

    local function fill_versions(kept: bool = false): void

        latest += 1
        local mine = latest

        util.create_thread(function()

            local rows = updater.version_rows(kept)

            -- A newer making started meanwhile (opened again, the limit changed): it fills the list, not this one
            if mine ~= latest then
                return
            end

            -- The list may be gone by now (the section was made again)
            pcall(function()
                versions:clear_from(first_version)

                for _, row in ipairs(rows) do
                    versions:action(row.caption, || -> updater.update_to(row.version), {}, label("version.item_help"))
                end
            end)
        end)
    end

    versions = list:list(label("version.name"), { "updaterversions" }, label("version.help"), nil, || -> fill_versions())
    versions:text_input(label("version.input.name"), { "updaterversion" }, function(value, click_type)
        updater.update_to_version(value, click_type)
    end, label("version.input.help"))
    versions:toggle(label("version.sync.name"), function(on)
        if updater.set_versions_synced(on) and updater.versions_loaded() then
            fill_versions()
        end
    end, { "updatersync" }, label("version.sync.help"), updater.versions_synced())
    -- Also Stand's own Reset Settings and Set To Min / Max: the list follows, from the versions it has
    versions:slider(label("version.limit.name"), 1, 50, updater.versions_shown(), 1, function(count)
        if updater.set_versions_shown(count) and updater.versions_loaded() then
            fill_versions(true)
        end
    end, { "updaterversionsshown" }, label("version.limit.help"))
    versions:divider(label("version.divider"))
    first_version = #versions.children + 1

    return list
end

-- The caption and the options are texts in the shown language (or the keys, Show Keys), so they're made
-- again when it changes. The picker may belong to a section already removed: a failed update is skipped
i18n.on_change(function()
    if view.branch == nil then
        return
    end

    refresh_info()
    pcall(menu.set_menu_name, view.branch, updater.branch_caption())
    pcall(menu.set_list_action_options, view.branch, updater.branch_options())
end)

return module
