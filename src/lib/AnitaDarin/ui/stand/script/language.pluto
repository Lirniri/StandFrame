-- lib/AnitaDarin/ui/stand/script/language.pluto
--
-- The Language list in Settings (ui/stand/script/section puts it there):
--
--   Language: Auto (Stand)            - the language picked: Auto follows Stand's (lang)
--   ── Translation ──
--   Create Translation >              - code, name, the language to start from, Create (langcode ... langcreate)
--   (Show Keys is made by show_keys, in Debug > Languages)
--   Translation Progress              - how far each translation has come (langprogress)
--   Reload Translations               - the files read again (langreload)
--   Open Translation Folder           - store/<script>/core/language (langfolder)
--
-- Only the layout is here; what the items do is in ui/logic/stand/script/translation.
-- Strings: core/language "profile.language" and "profile.translation"

local i18n = Atdar.loader.load("core/i18n")
local translation = Atdar.loader.load("ui/logic/stand/script/translation")

local module = {}

-- Strings under "profile"
local label = i18n.scope("profile")

-- The picker made by build, and the code of each of its options
local view = { language = nil, codes = {} }

-- The picker's caption as the profile and the shown language have it now. The picker may belong to a
-- section already removed: a failed update is skipped
local function show_caption(): void
    if view.language ~= nil then
        pcall(menu.set_menu_name, view.language, translation.caption())
    end
end

-- After a translation was made or read again: the picker lists the languages there are now
local function refresh_languages(): void

    local names, codes = translation.options()

    view.codes = codes
    pcall(menu.set_list_action_options, view.language, names)
    show_caption()
end

-- Create Translation: the code, the name and the language to start from, then Create
local function create_translation(list: table): void

    local draft = translation.new_draft()
    local from_names, from_codes = translation.from_options()
    local from_ref = nil

    local create = list:list(label("translation.create.name"), {}, label("translation.create.help"))

    create:text_input(label("translation.code.name"), { "langcode" }, |value| -> translation.set_code(draft, value),
        label("translation.code.help"), draft.code)
    create:text_input(label("translation.language_name.name"), { "langname" }, |value| -> translation.set_name(draft, value),
        label("translation.language_name.help"), "")

    from_ref = create:list_action(translation.from_caption(draft.from), from_names, function(index)
        draft.from = from_codes[index]
        pcall(menu.set_menu_name, from_ref, translation.from_caption(draft.from))
    end, { "langfrom" }, label("translation.from.help"))

    create:action(label("translation.create_button.name"), || -> translation.create(draft, refresh_languages),
        { "langcreate" }, label("translation.create_button.help"))
end

-- Show Keys: each string's key instead of its text, to see which key is which while translating. Not with
-- Stand in English (i18n says so): the switch goes back off. section puts it in Debug > Languages
function module.show_keys(node: table): void

    local keys_ref

    keys_ref = node:toggle(label("translation.show_keys.name"), function(on)
        if not i18n.set_show_keys(on) then
            pcall(menu.set_value, keys_ref, false)
        end
    end, { "langkeys" }, label("translation.show_keys.help"))

    node:divider(label("translation.send.divider"))

    -- The key of the item the cursor is on, in a Stand notification: exact even where items share a text
    node:toggle(label("translation.send_path.name"), |on| -> i18n.set_send_path(on), { "langpath" },
        label("translation.send_path.help"))

    -- The file that string is in, for opening it to translate
    node:toggle(label("translation.send_file.name"), |on| -> i18n.set_send_file(on), { "langfile" },
        label("translation.send_file.help"))
end

-- Auto follows Stand's language; a fixed one shows the script in it whatever Stand's is
function module.build(node: table): void

    local list = node:list(label("language.list.name"), {}, label("language.list.help"))
    local names, codes = translation.options()

    view.codes = codes

    view.language = list:list_action(translation.caption(), names, function(index)
        translation.pick(view.codes[index])
        show_caption()
    end, { "lang" }, label("language.help"))

    list:divider(label("translation.divider"))
    create_translation(list)
    list:action(label("translation.progress.name"), translation.report_progress, { "langprogress" },
        label("translation.progress.help"))
    list:action(label("translation.reload.name"), || -> translation.reload(refresh_languages), { "langreload" },
        label("translation.reload.help"))
    list:action(label("translation.folder.name"), translation.open_folder, { "langfolder" },
        label("translation.folder.help"))
end

-- The picker's caption follows the profile (another one loaded, a reset) and the language shown
Atdar.profile.on_change(show_caption)
i18n.on_change(show_caption)

return module
