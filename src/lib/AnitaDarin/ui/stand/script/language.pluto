-- lib/AnitaDarin/ui/stand/script/language.pluto
--
-- The Language list in Settings (ui/stand/script/section puts it there):
--
--   Language: Auto (Stand)            - the language picked: Auto follows Stand's (lang)
--   ── Translation ──
--   Create Translation >              - code, name, the language to start from, Create (langcode ... langcreate)
--   (Show Keys is made by show_keys, in Debug > Languages)
--   Translation Progress              - how far each translation has come (langprogress)
--   Reload Translations               - the files read again (langreload)
--   Open Translation Folder           - store/<script>/core/language (langfolder)
--
-- Only the layout is here; what the items do is in ui/logic/stand/script/translation.
-- Strings: core/language "profile.language" and "profile.translation"

local i18n = Atdar.loader.load("core/i18n")
local translation = Atdar.loader.load("ui/logic/stand/script/translation")

local module = {}

-- Strings under "profile"
local label = i18n.scope("profile")

-- Create Translation: the code, the name and the language to start from, then Create
-- @param after What Create does once the files are made (the picker lists the languages there are now)
local function create_translation(list: table, after: function): void

    local draft = translation.new_draft()
    local from_names, from_codes = translation.from_options()
    local from = nil

    local create = list:list({ key = "translation.create" })

    create:text_input({ key = "translation.code", commands = { "langcode" }, default = draft.code,
        on_change = |value| -> translation.set_code(draft, value) })
    create:text_input({ key = "translation.language_name", commands = { "langname" }, default = "",
        on_change = |value| -> translation.set_name(draft, value) })

    from = create:list_action({ caption = || -> translation.from_caption(draft.from), help_key = "translation.from",
        options = from_names, commands = { "langfrom" }, on_select = function(index)
            draft.from = from_codes[index]
            from:set_name(translation.from_caption(draft.from))
        end })

    create:action({ key = "translation.create_button", commands = { "langcreate" },
        on_click = || -> translation.create(draft, after) })
end

-- Show Keys: each string's key instead of its text, to see which key is which while translating. Not with
-- Stand in English (i18n says so): the switch goes back off. section puts it in Debug > Languages
function module.show_keys(node: table): void

    local ui = node:scope("profile")
    local keys = nil

    keys = ui:toggle({ key = "translation.show_keys", commands = { "langkeys" }, on_change = function(on)
        if not i18n.set_show_keys(on) then
            keys:set_value(false)
        end
    end })

    ui:divider({ name = label("translation.send.divider") })

    -- The key of the item the cursor is on, in a Stand notification: exact even where items share a text
    ui:toggle({ key = "translation.send_path", commands = { "langpath" }, on_change = |on| -> i18n.set_send_path(on) })

    -- The file that string is in, for opening it to translate
    ui:toggle({ key = "translation.send_file", commands = { "langfile" }, on_change = |on| -> i18n.set_send_file(on) })
end

-- Auto follows Stand's language; a fixed one shows the script in it whatever Stand's is.
-- The picker's caption follows the profile (another one loaded, a reset) and the language shown
function module.build(node: table): void

    local ui = node:scope("profile")
    local list = ui:list({ key = "language.list" })
    local names, codes = translation.options()
    local picker = nil

    -- After a translation was made or read again: the picker lists the languages there are now
    local function refresh_languages(): void

        names, codes = translation.options()

        picker:set_options(names)
        picker:set_name(translation.caption())
    end

    picker = list:list_action({ caption = translation.caption, help_key = "language", options = names,
        commands = { "lang" }, on_select = function(index)
            translation.pick(codes[index])
            picker:set_name(translation.caption())
        end })

    list:divider({ name = label("translation.divider") })
    create_translation(list, refresh_languages)
    list:action({ key = "translation.progress", commands = { "langprogress" }, on_click = translation.report_progress })
    list:action({ key = "translation.reload", commands = { "langreload" },
        on_click = || -> translation.reload(refresh_languages) })
    list:action({ key = "translation.folder", commands = { "langfolder" }, on_click = translation.open_folder })
end

return module
