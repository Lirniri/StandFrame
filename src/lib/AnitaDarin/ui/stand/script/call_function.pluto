-- lib/AnitaDarin/ui/stand/script/call_function.pluto
--
-- Debug > Call Function: calls any function of the script by its name, with typed arguments, or reads
-- a table or a variable by its name.
--
--   Call Function >   Function Name, then the panel (below)
--
-- The panel (module.panel) is the same in every list that calls a function: this one, and the functions
-- found in a table of a Value list (Call Functions In Tables, ui/stand/modules/values):
--
--   Argument, ── Call ──, Call After Typing Function (this list only), Call After Typing Arguments,
--   Notice In Stand (this list only), Call, Call After (ms), Call When Opened, Call When Hovered, Loop,
--   Loop With Interval,
--   ── Tables ──, Table Depth, Call Functions In Tables (these three while the result is a table),
--   then the Variable line and, for a table, the Value list
--
-- The name is a path from Atdar with dots (game.repair_vehicle, game.some_table). A module's name may come
-- first (VehicleManager.get); with a colon the function is called as a method (VehicleManager:get).
-- The arguments are read like the Arguments of a module function (parsers/proglang/pluto/args).
-- Strings: base/language "script_menu.call_function"; the loop ones are the Modules list's ("modules.loop")

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")
local args_parser = Atdar.loader.load("parsers/proglang/pluto/args")

local log = new Logger("CallFunction")

local module = {}

-- Strings under "script_menu.call_function"
local label, text = i18n.scope("script_menu.call_function")
-- The strings of the Modules list's function lists, shared: Call After, Call When Opened, Loop
local mlabel, mtext = i18n.scope("modules")
-- Click types of calls Stand makes by itself (restoring a field's state, bulk changes): not the user's
local NOT_USER_CLICKS = { [4] = true }
for _, name in ipairs({ "CLICK_BULK", "CLICK_AUTO", "CLICK_SCRIPTED" }) do
    if _G[name] ~= nil then
        NOT_USER_CLICKS[_G[name]] = true
    end
end

-- Stand calls text fields again while the script stops; nothing it sends then is the user's
local stopping = false
util.on_stop(function() stopping = true end)

-- The value one step down a path: a module of the manager at the root, else a field
local function step(current, key: string)
    if current == Atdar and Atdar.modules ~= nil and Atdar.modules.has(key) then
        return Atdar.modules.get(key)
    end
    if type(current) ~= "table" then
        return nil
    end
    local ok, value = pcall(function() return current[key] end)
    if not ok then
        return nil
    end
    return value
end

-- The key the result of this list is kept under (its Variable line and Value list)
local RESULT_KEY = "debug.call_function"
-- Longer notices are cut to this many characters
local MAX_NOTICE_CHARS = 200

-- "game.repair_vehicle" -> the function (or table, or any value); "VehicleManager:get" -> the method and
-- the owner to pass as self
-- @return Whether there is something at the path, what it is, and its owner (nil for a plain path)
local function resolve(path: string)
    local owner_path = path
    local method = nil
    local colon = path:find(":", 1, true)
    if colon ~= nil then
        owner_path = path:sub(1, colon - 1)
        method = path:sub(colon + 1)
    end
    local current = Atdar
    local first = true
    for key in owner_path:gmatch("[^%.]+") do
        local was_first = first
        first = false
        -- "Atdar.name" is the same as "name"
        if was_first and key == "Atdar" then
            continue
        end
        local next_value = step(current, key)
        -- The first word that Atdar doesn't have: a global (util, menu, ...)
        if next_value == nil and was_first then
            next_value = _G[key]
        end
        current = next_value
        if current == nil then
            return false
        end
    end
    if method == nil then
        return true, current
    end
    local fn = step(current, method)
    if type(fn) ~= "function" then
        return false
    end
    return true, fn, current
end

-- Runs a function with the arguments (the owner first when it's a method), the results packed
local function run(fn, owner, args: table, count: int): table
    if owner == nil then
        return table.pack(pcall(fn, table.unpack(args, 1, count)))
    end
    return table.pack(pcall(fn, owner, table.unpack(args, 1, count)))
end

-- ─── The panel ───────────────────────────────────────────────────────────────

-- Gives the results out: the Variable line (and the Value list of a table) and the notice
local function deliver(spec: table, results: table, was_call: bool): void
    local values = Atdar.loader.load("ui/stand/modules/values")
    values.show_result(spec.key, results)
    local name = spec.name()
    local message = text("done"):format(name)
    if results.n > 1 then
        message = text("result"):format(name, values.results_text(results))
    elseif not was_call then
        message = text("empty"):format(name)
    end
    -- A long one (a table) is cut: all of it is in the Value list
    local cut = utf8.offset(message, MAX_NOTICE_CHARS + 1)
    if cut ~= nil then
        message = message:sub(1, cut - 1) .. "..."
    end
    -- In Stand (not the game's feed) when its toggle is on
    if spec.state.stand then
        log:notify(message, "stand")
        return
    end
    log:notify(message)
end

-- A function is called with the arguments, in a thread of its own (it may wait); anything else
-- (a table, a variable) is read. Either way the value is what comes out
local function call(spec: table): void
    local name = spec.name()
    if name == "" then
        log:warn(text("no_name"))
        return
    end
    local found, value, owner = spec.target()
    if not found then
        log:warn(text("not_found"):format(name))
        return
    end
    if type(value) ~= "function" then
        deliver(spec, table.pack(true, value), false)
        return
    end
    local args, count, err = args_parser.parse(spec.state.args or "")
    if err ~= nil then
        log:error(text("bad_args"):format(name, err))
        return
    end
    util.create_thread(function()
        local results = run(value, owner, args, count)
        if not results[1] then
            log:error(text("failed"):format(name, tostring(results[2])))
            return
        end
        deliver(spec, results, true)
    end)
end

-- Switches the Loop toggle to how the loop is, without starting or stopping anything
local function sync_toggle(state: table, on: bool): void
    if state.loop_toggle == nil then
        return
    end
    state.syncing = true
    pcall(menu.set_value, state.loop_toggle, on)
    state.syncing = false
end

-- The loop ended by itself or was stopped
local function end_loop(state: table, loop_run: table): void
    if state.loop ~= loop_run then
        return
    end
    state.loop = nil
    sync_toggle(state, false)
end

-- Calls the function every frame (every: nil) or once every `every` ms, until stopped; an error ends it.
-- It works like the loop of a module's function: a table or a variable is read, the Variable line follows
local function start_loop(spec: table, every: ?int): void
    local state = spec.state
    local name = spec.name()
    if name == "" then
        log:warn(text("no_name"))
        sync_toggle(state, false)
        return
    end
    local loop_run = { every = every, next = 0 }
    state.loop = loop_run
    sync_toggle(state, true)
    if every == nil then
        log:notify(mtext("loop.started"):format(name))
    else
        log:notify(mtext("loop.started_every"):format(name, every))
    end
    local values = Atdar.loader.load("ui/stand/modules/values")
    util.create_tick_handler(function()
        -- Stopped, or replaced by a newer loop
        if stopping or state.loop ~= loop_run then
            return false
        end
        if loop_run.every ~= nil then
            local now = util.current_time_millis()
            if now < loop_run.next then
                return true
            end
            loop_run.next = now + loop_run.every
        end
        local found, value, owner = spec.target()
        if not found then
            end_loop(state, loop_run)
            log:warn(text("not_found"):format(name))
            return false
        end
        if type(value) ~= "function" then
            values.show_result(spec.key, table.pack(true, value))
            return true
        end
        local args, count, err = args_parser.parse(state.args or "")
        if err ~= nil then
            end_loop(state, loop_run)
            log:error(text("bad_args"):format(name, err))
            return false
        end
        local results = run(value, owner, args, count)
        if not results[1] then
            end_loop(state, loop_run)
            log:error(text("failed"):format(name, tostring(results[2])))
            return false
        end
        values.show_result(spec.key, results)
        return true
    end)
end

local function stop_loop(spec: table): void
    local state = spec.state
    if state.loop == nil then
        log:notify(mtext("loop.not_running"):format(spec.name()))
        return
    end
    end_loop(state, state.loop)
    log:notify(mtext("loop.stopped"):format(spec.name()))
end

-- Makes the panel in list, from the Argument on.
-- spec.key:             the key the result is kept under (values.show_result)
-- spec.state:           a table kept by the caller between buildings: args, on_enter, on_enter_name, on_open,
--                       on_focus, stand, and the loop; it starts as {} (stand: true for a Notice In Stand default)
-- spec.name:            function() -> the function's name for the notices
-- spec.target:          function() -> found, value, owner: what to call or read (owner: the self of a method)
-- spec.args_command:    the command of the Argument field (Stand's text fields need one)
-- spec.with_name:       Call After Typing Function is there (a list with a Function Name field)
-- spec.with_stand:      Notice In Stand is there
-- spec.kept:            the result lines belong to a list outside Modules (values.add_result_lines)
-- @return { call = function(), opened = function(), name_typed = function() }: Call, what the list does when
--         opened, and what a Function Name field does when typed
function module.panel(list: table, spec: table): table
    local state = spec.state
    local values = Atdar.loader.load("ui/stand/modules/values")

    list:text_input(label("args.name"), { spec.args_command }, function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        state.args = value
        if state.on_enter then
            call(spec)
        end
    end, label("args.help"), state.args or "")

    list:divider(label("call.divider"))

    if spec.with_name then
        list:toggle(label("on_enter_name.name"), function(on)
            state.on_enter_name = on
        end, {}, label("on_enter_name.help"), state.on_enter_name == true)
    end

    list:toggle(label("on_enter.name"), function(on)
        state.on_enter = on
    end, {}, label("on_enter.help"), state.on_enter == true)

    if spec.with_stand then
        list:toggle(label("stand.name"), function(on)
            state.stand = on
        end, {}, label("stand.help"), state.stand == true)
    end

    list:action(label("call.name"), function()
        call(spec)
    end, {}, label("call.help"))

    -- Once, after the ms picked; the arguments are worked out then, not at the click
    list:click_slider(mlabel("loop.call_after"), 100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        log:notify(mtext("loop.call_scheduled"):format(spec.name(), ms))
        util.create_thread(function()
            util.yield(ms)
            if not stopping then
                call(spec)
            end
        end)
    end, {}, mlabel("loop.call_after_help"))

    list:toggle(mlabel("loop.call_on_open"), function(on)
        state.on_open = on
    end, {}, mlabel("loop.call_on_open_help"), state.on_open == true)

    list:toggle(mlabel("loop.call_on_focus"), function(on)
        state.on_focus = on
    end, {}, mlabel("loop.call_on_focus_help"), state.on_focus == true)
    -- The cursor on this list (not inside it)
    menu.on_focus(list.handle, function()
        if state.on_focus and not stopping then
            call(spec)
        end
    end)

    state.loop_toggle = list:toggle(mlabel("loop.loop"), function(on)
        if stopping or state.syncing then
            return
        end
        if on and state.loop == nil then
            start_loop(spec, nil)
            return
        end
        if not on and state.loop ~= nil then
            stop_loop(spec)
        end
    end, {}, mlabel("loop.loop_help"), state.loop ~= nil)

    list:click_slider(mlabel("loop.every"), 100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        start_loop(spec, ms)
    end, {}, mlabel("loop.every_help"))

    -- The Tables divider, Table Depth and Call Functions In Tables: shown only while the result is a table
    local table_divider = list:divider(label("table.divider"))
    -- Stand puts the saved state of these back while the script starts, where the Value list can't be made
    -- again: then it's only remembered (quiet)
    local depth_ref = list:slider(label("depth.name"), 1, 8, values.result_depth(spec.key), 1, function(depth, previous, click_type)
        if stopping then
            return
        end
        values.set_result_depth(spec.key, depth, NOT_USER_CLICKS[click_type])
    end, {}, label("depth.help"))
    -- The functions in the table become lists with the same panel
    local call_ref = list:toggle(mlabel("loop.call_in_tables"), function(on, click_type)
        if stopping then
            return
        end
        values.set_call_in_tables(spec.key, on, NOT_USER_CLICKS[click_type])
    end, {}, mlabel("loop.call_in_tables_help"), values.call_in_tables(spec.key))
    values.bind_depth_items(spec.key, { table_divider, depth_ref, call_ref })

    -- What came out: the Variable line, and for a table the Value list under it
    values.add_result_lines(list, spec.key, spec.kept)

    return {
        call = function() call(spec) end,
        opened = function()
            if state.on_open then
                call(spec)
            end
        end,
        name_typed = function()
            if state.on_enter_name then
                call(spec)
            end
        end,
    }
end

-- ─── The list ────────────────────────────────────────────────────────────────

-- What is typed in the list, kept while the script runs (the menu being built again keeps it)
local main_state = { stand = true }

-- Makes the list in node
-- @return The list's handle
function module.build(node: table): any
    local panel = nil
    local list = node:list(label("name"), {}, label("help"), nil, function()
        if panel ~= nil then
            panel.opened()
        end
    end)

    -- With Call After Typing Function on, typing the name calls it (or reads a table or a variable) at once
    list:text_input(label("function.name"), { "debugcallfuncname" }, function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        main_state.name = value
        if panel ~= nil then
            panel.name_typed()
        end
    end, label("function.help"), main_state.name or "")

    panel = module.panel(list, {
        key = RESULT_KEY,
        state = main_state,
        name = function() return main_state.name or "" end,
        target = function() return resolve(main_state.name or "") end,
        args_command = "debugcallfuncargs",
        with_name = true,
        with_stand = true,
        kept = true,
    })

    return list.handle
end

return module
