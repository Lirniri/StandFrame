-- lib/AnitaDarin/ui/stand/script/call_function.pluto
--
-- Debug > Call Function: calls any function of the script by its name, with typed arguments, or reads
-- a table or a variable by its name.
--
--   Call Function >   Call A Function (list): Function Name, then the panel (below)
--                     Functions (list): Add, Clear, Clear All, Save Functions, the Functions divider, then the
--                     functions added, each with its number
--                     Arguments Guide: how to write the arguments, as a notice in Stand
--                     Settings (divider), Use Short Names, Show Call Time, Show Result On Screen, Result Length On
--                     Screen, Notice In Stand
--
-- Shown only while the CallFunction module runs (Debug's items follow it: ui/stand/modules/place). The Files
-- Editor is a list of its own right under it (ui/stand/script/call_function_editor).
--
-- An added function is named by its number and its path, cut to the last name (PLAYER.PLAYER_PED_ID ->
-- PLAYER_PED_ID, util.toast -> toast) while Use Short Names is on, then
-- what it takes and gives: "1: PLAYER_PED_ID: int" (no arguments), "2: get(handle, ...): bool" (the arguments'
-- names in brackets; the return type is there when the code writes one: void for nothing). One that
-- takes arguments is a list: a field for each of its parameters by the type the code says
-- (ui/stand/core/arguments), then the panel. One that takes none is a button that calls it. Clear takes
-- the number of one out; the numbers follow the order of the list.
--
-- The panel (module.panel) is the same in every list that calls a function: this one, and the functions
-- found in a table of a Value list (ui/stand/modules/values):
--
--   in the order of a function in the Modules list:
--   Call After Typing Function (Call A Function only), Arguments, Call After Typing Arguments,
--   Call, Call After (ms), Call When Opened, Call When Hovered,
--   the Loop Status line, Loop, Loop With Interval, then the Variable line and, for a table, the Value list:
--   a table inside is a list made when it's opened, a function in it a list with this same panel, a value a
--   field to type a new one in (no settings to switch on)
--
-- The name is a path from Atdar with dots (game.repair_vehicle, game.some_table). A module's name may come
-- first (VehicleManager.get); with a colon the function is called as a method (VehicleManager:get)
-- (parsers/proglang/pluto/path).
-- The arguments of the Function Name's panel are one field, read as expressions (parsers/proglang/pluto/args).
--
-- Only the items are here. Calling, the loops, the list of the functions added and the files are the system
-- module CallFunction (modules/systems/CallFunction); what a call gave is shown by ui/stand/modules/values.
-- Strings: core/language "script_menu.call_function"; the loop ones are the Modules list's ("modules.loop")

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local call_loop = Atdar.loader.load("ui/logic/stand/call_loop")
-- Show Call Time, Show Result On Screen and Result Length On Screen: the loops of a module's functions use them too
local display = Atdar.loader.load("ui/stand/core/call_display")

local module = {}

-- Strings under "script_menu.call_function": the keys of its items
local SCOPE = "script_menu.call_function"
local label, text = i18n.scope(SCOPE)

-- The strings of the Modules list's function lists, shared: Call After, Call When Opened, Loop
local LOOP_SCOPE = "modules.loop"
local mlabel = i18n.scope("modules")

-- The logic: the CallFunction module, asked for at every use (Reload makes a new one)
local function calls(): table
    return Atdar.modules.get("CallFunction")
end

-- Whether there's something to call through: the CallFunction module is there and running. While it isn't,
-- the Call Function list is hidden and a function in a table of a Value list is only a line
function module.is_available(): bool
    return Atdar.modules.is_running("CallFunction")
end

-- The argument fields and the result lines are loaded when a panel is first made, not with the script's section
local function arguments(): table
    return Atdar.loader.load("ui/stand/core/arguments")
end

local function values(): table
    return Atdar.loader.load("ui/stand/modules/values")
end

-- A switch that only writes its value into state[field]
local function state_toggle(node: table, key: string, state: table, field: string, default: bool): table
    return node:toggle({ key = key, default = default, on_change = function(on)
        state[field] = on
    end })
end

-- The panel

-- Makes the panel in list, from the Argument on.
-- spec: what the panel calls, as the CallFunction module describes it (key, state, name, target,
-- sig, in_stand), and for the items:
-- spec.args_command:    the command of the Argument field (Stand's text fields need one); with spec.sig the
--                       base of the commands of the parameters' fields ("<base>_1", "<base>_rest")
-- spec.with_name:       Call After Typing Function is there (a list with a Function Name field)
-- spec.kept:            the result lines belong to a list outside Modules (values.add_result_lines)
-- @return { rebuild(), call(), opened(), name_typed() }: the panel made again, Call, what the list does when
--         opened, and what a Function Name field does when typed
function module.panel(list: table, spec: table): table

    local state = spec.state
    local ui = list:scope(SCOPE)
    local loop = list:scope(LOOP_SCOPE)
    -- The Loop Status line and the Loop switch of the latest making
    local status = nil
    local loop_toggle = nil
    -- The Arguments list of the latest making. A field that becomes a list (a function called in it) makes
    -- only these fields again, not the whole panel
    local args_list = nil
    local fill_args
    local panel = nil

    -- The loop started, stopped or failed: the status line says it, the switch follows without starting
    -- or stopping anything
    state.on_loop = function(kind, every)
        if status ~= nil then
            status:set_name(call_loop.status_line(kind, every))
        end
        if loop_toggle ~= nil then
            loop_toggle:set_value(kind == "running" or kind == "every")
        end
    end

    -- The cursor on this list (not inside it)
    list:on_focus(function()
        if state.on_focus and not clicks.is_stopping() then
            calls():call(spec)
        end
    end)

    -- Typed in an argument's field, with Call After Typing Arguments on
    local function typed(): void
        if state.on_enter then
            calls():call(spec)
        end
    end

    fill_args = function()

        if spec.sig ~= nil then
            -- A field for each parameter, by its type
            state.texts ??= {}
            arguments().build(args_list, {
                sig = spec.sig,
                texts = state.texts,
                command = |index| -> $"{spec.args_command}_{index}",
                on_typed = typed,
                on_reshape = function()
                    args_list:clear()
                    fill_args()
                end,
            })
            return
        end

        args_list:text_input({
            name = mlabel("loop.args"),
            help = label("args.help"),
            commands = { spec.args_command },
            default = state.args or "",
            user_only = true,
            on_change = function(value)
                state.args = value
                typed()
            end,
        })
    end

    -- The same order as a function in the Modules list: Arguments, the Call Settings divider, Call, Call After,
    -- Call When Opened / Hovered, the loop's status, Loop, Loop With Interval, the Variable line with its
    -- Value list and table settings
    panel = list:section(function()

        if spec.with_name then
            state_toggle(ui, "on_enter_name", state, "on_enter_name", state.on_enter_name == true)
        end

        args_list = list:list({ name = mlabel("loop.args"), help = mlabel("loop.args_help") })
        fill_args()

        -- The settings of calling, under the arguments
        list:divider({ name = mlabel("loop.settings") })
        state_toggle(ui, "on_enter", state, "on_enter", state.on_enter == true)

        -- Call; with a number of ms picked, Call After
        Atdar.loader.load("ui/stand/core/call_slider").build(list, {
            name_now = mlabel("loop.call"),
            name_after = mlabel("loop.call_after.name"),
            help = label("call.help"),
            call = || -> calls():call(spec),
            call_after = |ms| -> calls():call_after(spec, ms),
        })

        state_toggle(loop, "call_on_open", state, "on_open", state.on_open == true)
        state_toggle(loop, "call_on_focus", state, "on_focus", state.on_focus == true)

        -- What its loop puts on the screen: the time of a call and what it gave
        state_toggle(loop, "show_time", state, "show_time", state.show_time ~= false)
        state_toggle(loop, "show_result", state, "show_result", state.show_result ~= false)

        -- The loop: its status line (as the loop is now), Loop, Loop With Interval
        status = list:divider({ name = call_loop.status_line(calls():loop_status(state)) })

        loop_toggle = loop:toggle({ key = "loop", default = state.loop ~= nil, on_change = function(on)
            if not clicks.is_stopping() then
                calls():set_loop(spec, on)
            end
        end })

        loop:click_slider({ key = "every", min = 100, max = 60000, default = 1000, step = 100, user_only = true,
            on_click = |ms| -> calls():start_loop(spec, ms) })

        -- What came out: the Variable line, and for a table the Value list under it
        values().add_result_lines(list, spec.key, spec.kept)
    end)

    return {
        -- The arguments' fields made again, after the function changed (spec.sig is new)
        rebuild = || -> panel.rebuild(),
        call = || -> calls():call(spec),
        opened = function()
            if state.on_open then
                calls():call(spec)
            end
        end,
        name_typed = function()
            if state.on_enter_name then
                calls():call(spec)
            end
        end,
    }
end

-- The lists

-- Makes the items of the Functions list again; set by the list when it's built
local show_added = nil

-- One added function in list: a list with its parameters' fields and the panel when it takes arguments,
-- a button that calls it when it takes none (or is a table or a variable, which the button reads).
-- Named with its number in the list, the arguments and the return type
local function add_item(list: table, entry: table, number: int): void

    local item = calls():describe(entry, number)
    local panel = nil

    -- A table: a list with what's in it, read when it's opened. The entries are made as it's opened, level by level
    if item.is_table then
        list:list({ name = item.name, help = label("added.table_help"),
            fill = |node| -> values().add_result_lines(node, item.spec.key, true),
            on_back = || -> values().drop_lines(item.spec.key),
            on_open = || -> calls():call(item.spec) })
        return
    end

    if not item.has_fields then
        list:action({ name = item.name, help = label("added.button_help"), on_click = || -> calls():call(item.spec) })
        return
    end

    local node = list:list({ name = item.name, help = label("added.help"), on_open = || -> panel.opened() })
    panel = module.panel(node, item.spec)
end

-- Pick Function

-- How many functions of a module a page of its list shows
local PICK_PAGE = 30

-- Items for each of names, a page at a time, with Previous Page and Next Page
-- @param make function(node, name) makes one item
local function paged(node: table, names: table, make: function): void

    local ui = node:scope(SCOPE)
    local page = 1
    local body = nil

    body = node:section(function()

        local pages = math.max(1, (#names + PICK_PAGE - 1) // PICK_PAGE)

        page = math.min(math.max(page, 1), pages)

        if pages > 1 then
            node:readonly_name({ name = text("pick.page"):format(page, pages) })
            ui:action({ key = "pick.previous", on_click = function()
                page -= 1
                body.rebuild()
            end })
            ui:action({ key = "pick.next", on_click = function()
                page += 1
                body.rebuild()
            end })
        end

        local first = (page - 1) * PICK_PAGE + 1

        for index = first, math.min(first + PICK_PAGE - 1, #names) do
            make(node, names[index])
        end
    end)
end

-- The names of a table (a file's short names), sorted
local function sorted_names(source: table): table

    local names = {}

    for name in pairs(source) do
        table.insert(names, name)
    end

    table.sort(names)

    return names
end

-- The Pick Function list: the function named by a click, not typed. The names come from the user's short names, the
-- registry and the modules; all made when the list is opened
-- @param pick function(path) sets the Function Name
local function build_pick(node: table, pick: function): void

    local ui = node:scope(SCOPE)

    ui:list({ key = "pick", fill = function(list)

        local sub = list:scope(SCOPE)

        -- A list of short names of a file: the name on the button, the path in its help
        local function short_list(key: string, source: table): void
            sub:list({ key = key, fill = function(part)

                local names = sorted_names(source)

                if #names == 0 then
                    part:readonly_name({ name = label("pick.empty") })
                end

                paged(part, names, function(into, name)
                    into:action({ name = name, help = source[name].path or source[name], on_click = || -> pick(name) })
                end)
            end })
        end

        short_list("pick.short_names", calls():short_names())
        short_list("pick.registry", calls():registry())

        sub:list({ key = "pick.modules", fill = function(modules)
            for _, name in ipairs(Atdar.modules.names()) do
                modules:list({ name = name, fill = function(part)

                    local names = calls():module_functions(name)

                    if #names == 0 then
                        part:readonly_name({ name = label("pick.empty") })
                    end

                    paged(part, names, function(into, path)
                        into:action({ name = path:match(":(.*)$") or path, help = path, on_click = || -> pick(path) })
                    end)
                end })
            end
        end })
    end })
end

-- History: the last calls, each calls again with what was typed for it
local function build_history(node: table): void

    local ui = node:scope(SCOPE)

    ui:list({ key = "history", fill = function(list)

        local sub = list:scope(SCOPE)
        local entries = calls():history()

        if #entries > 0 then
            sub:action({ key = "history.repeat_last", on_click = || -> calls():repeat_call(entries[1]) })
        end

        sub:action({ key = "history.clear", on_click = function()
            calls():clear_history()
            list:clear()
            list:readonly_name({ name = label("pick.empty") })
        end })

        list:divider({ name = label("history.divider") })

        if #entries == 0 then
            list:readonly_name({ name = label("pick.empty") })
        end

        for _, entry in ipairs(entries) do
            list:action({ name = calls():describe_entry(entry), help = entry.path,
                on_click = || -> calls():repeat_call(entry) })
        end
    end })
end

-- Opens the Files Editor at a place, from a link in Call Function
local function open_in_editor(id: string): void
    if calls():open_in_editor(id) then
        Atdar.loader.load("ui/stand/script/call_function_editor").focus()
    end
end

-- The Call A Function list: the function typed by its name, with the panel
local function build_by_name(node: table): void

    local panel = nil
    local spec = nil
    local name_field = nil
    local state = calls().main_state
    local list = node:list({ key = "by_name", on_open = || -> panel.opened() })

    -- The name typed, or picked from Pick Function. With Call After Typing Function on, it calls the function (or
    -- reads a table or a variable) at once
    local function name_typed(value: string): void

        local named, changed = calls():set_main_name(value)

        -- Another function: its parameters are the fields now (a table or a variable has none: the one field)
        if changed and panel ~= nil then
            spec.sig = calls():main_signature()
            panel.rebuild()
        end

        if named and panel ~= nil then
            panel.name_typed()
        end
    end

    name_field = list:text_input({ key = "function", commands = { "callfuncname" }, default = state.name or "",
        user_only = true, on_change = name_typed })

    build_pick(list, function(path: string): void
        name_field:set_value(path)
        name_typed(path)
    end)

    spec = {
        key = calls().RESULT_KEY,
        state = state,
        path = || -> calls():main_path(),
        sig = calls():main_signature(),
        name = || -> state.name or "",
        -- (a lambda would give only the first of the three values)
        target = function() return calls():main_target() end,
        args_command = "callfuncargs",
        with_name = true,
        in_stand = || -> calls():in_stand(),
        kept = true,
    }

    panel = module.panel(list, spec)

    -- What it gave, whole, and the files Call Function reads
    local ui = list:scope(SCOPE)

    ui:divider({ name = label("result_tools.divider") })
    ui:action({ key = "copy_result", on_click = || -> calls():copy_result() })
    ui:action({ key = "log_result", on_click = || -> calls():log_result() })
    ui:action({ key = "open_logs", on_click = || -> open_in_editor("logs") })
    ui:action({ key = "open_short_names", on_click = || -> open_in_editor("user/call_function/short_names.json") })
end

-- The Functions list: Add, Clear, Clear All, Save Functions, the Functions divider, then the functions added
local function build_functions(node: table): void

    calls():load_saved()

    local list = node:list({ key = "functions" })

    list:text_input({ key = "add", commands = { "addfunc" }, user_only = true, on_change = function(value)

        local entry, number = calls():add(value)

        if entry ~= nil then
            add_item(list, entry, number)
        end
    end })

    -- The number of the function to take out
    list:text_input({ key = "clear", commands = { "clearfunc" }, user_only = true, on_change = function(value)
        if calls():remove(value) then
            show_added()
        end
    end })

    list:action({ key = "clear_all", on_click = function()
        if calls():clear_all() then
            show_added()
        end
    end })

    list:toggle({ key = "save", default = calls().settings.save, on_change = function(on)
        if not clicks.is_stopping() then
            calls():set_save(on)
        end
    end })

    list:divider({ name = label("functions.name") })

    -- The items of the functions, with the numbers and names they have now; made again by show_added
    local added = list:section(function()
        for number, entry in ipairs(calls():added()) do
            add_item(list, entry, number)
        end
    end)

    show_added = added.rebuild
end

-- Makes the list in node
-- @return The list's Stand handle (the tests look into it), nil without the CallFunction module; and when it's
--         shown: while the module runs
function module.build(node: table)

    -- Its module's file failed to load (the error is in the log): nothing to call through, the rest of the
    -- section is still made
    if not Atdar.modules.has("CallFunction") then
        return nil
    end

    -- The switches' defaults; a change goes to calls().settings, asked for then: a reloaded module is a new
    -- instance with its own
    local settings = calls().settings
    local list = node:list({ name = label("name"), help = label("help") })
    local ui = list:scope(SCOPE)

    build_by_name(ui)
    build_functions(ui)
    build_history(ui)

    ui:action({ key = "guide", on_click = || -> calls():show_guide() })

    ui:divider({ name = label("settings.divider") })

    ui:toggle({ key = "short_names", default = settings.short_names, on_change = function(on, click_type)
        if clicks.is_stopping() or calls().settings.short_names == on then
            return
        end

        calls().settings.short_names = on

        -- The names in the list follow (not while Stand puts the saved state back: the list isn't made then)
        if show_added ~= nil and clicks.is_user_click(click_type) then
            show_added()
        end
    end })

    -- Off by default; on: no function shows it, whatever its own switch says
    ui:toggle({ key = "show_time", default = not display.show_time, on_change = function(on)
        display.show_time = not on
    end })

    ui:toggle({ key = "show_result", default = not display.show_result, on_change = function(on)
        display.show_result = not on
    end })

    ui:slider({ key = "result_length", min = display.LENGTH_MIN, max = display.LENGTH_MAX,
        default = display.result_length, step = 10, on_change = function(value)
        display.result_length = value
    end })

    ui:toggle({ key = "stand", default = settings.stand, on_change = function(on)
        calls().settings.stand = on
    end })

    return list.handle, module.is_available
end

return module
