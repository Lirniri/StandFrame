-- lib/AnitaDarin/ui/stand/script/call_function.pluto
--
-- Debug > Call Function: calls any function of the script by its name, with typed arguments, or reads
-- a table or a variable by its name.
--
--   Call Function >   Function Name, Argument, ── Call ──, Call After Typing Function / Arguments,
--                     Notice In Stand, Call, Call After (ms), Call When Opened, Loop, Loop With Interval,
--                     ── Tables ──, Table Depth, then the Variable line and, for a table, the Value list
--                     (Call After, Call When Opened and the loops work as in the Modules list's functions)
--
-- The name is a path from Atdar with dots (game.repair_vehicle, game.some_table). A module's name may come
-- first (VehicleManager.get); with a colon the function is called as a method (VehicleManager:get).
-- The arguments are read like the Arguments of a module function (parsers/proglang/pluto/args).
-- Strings: base/language "script_menu.call_function"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")
local args_parser = Atdar.loader.load("parsers/proglang/pluto/args")

local log = new Logger("CallFunction")

local module = {}

-- Strings under "script_menu.call_function"
local label, text = i18n.scope("script_menu.call_function")
-- The strings of the Modules list's function lists, shared: Call After, Call When Opened, Loop
local mlabel, mtext = i18n.scope("modules")
-- Click types of calls Stand makes by itself (restoring a field's state, bulk changes): not the user's
local NOT_USER_CLICKS = { [4] = true }
for _, name in ipairs({ "CLICK_BULK", "CLICK_AUTO", "CLICK_SCRIPTED" }) do
    if _G[name] ~= nil then
        NOT_USER_CLICKS[_G[name]] = true
    end
end

-- Stand calls text fields again while the script stops; nothing it sends then is the user's
local stopping = false
util.on_stop(function() stopping = true end)

-- The value one step down a path: a module of the manager at the root, else a field
local function step(current, key: string)
    if current == Atdar and Atdar.modules ~= nil and Atdar.modules.has(key) then
        return Atdar.modules.get(key)
    end
    if type(current) ~= "table" then
        return nil
    end
    local ok, value = pcall(function() return current[key] end)
    if not ok then
        return nil
    end
    return value
end

-- The key its result is kept under (the Variable line and the Value list of the list)
local RESULT_KEY = "debug.call_function"
-- Longer notices are cut to this many characters
local MAX_NOTICE_CHARS = 200

-- "game.repair_vehicle" -> the function (or table, or any value); "VehicleManager:get" -> the method and
-- the owner to pass as self
-- @return Whether there is something at the path, what it is, and its owner (nil for a plain path)
local function resolve(path: string)
    local owner_path = path
    local method = nil
    local colon = path:find(":", 1, true)
    if colon ~= nil then
        owner_path = path:sub(1, colon - 1)
        method = path:sub(colon + 1)
    end
    local current = Atdar
    local first = true
    for key in owner_path:gmatch("[^%.]+") do
        local was_first = first
        first = false
        -- "Atdar.name" is the same as "name"
        if was_first and key == "Atdar" then
            continue
        end
        local next_value = step(current, key)
        -- The first word that Atdar doesn't have: a global (util, menu, ...)
        if next_value == nil and was_first then
            next_value = _G[key]
        end
        current = next_value
        if current == nil then
            return false
        end
    end
    if method == nil then
        return true, current
    end
    local fn = step(current, method)
    if type(fn) ~= "function" then
        return false
    end
    return true, fn, current
end

-- Gives the results out: the Variable line (and the Value list of a table) and the notice
-- stand: the notice goes to Stand (not the game's feed)
local function deliver(name: string, results: table, stand: bool, was_call: bool): void
    local values = Atdar.loader.load("ui/stand/modules/values")
    values.show_result(RESULT_KEY, results)
    local message = text("done"):format(name)
    if results.n > 1 then
        message = text("result"):format(name, values.results_text(results))
    elseif not was_call then
        message = text("empty"):format(name)
    end
    -- A long one (a table) is cut: all of it is in the Value list
    local cut = utf8.offset(message, MAX_NOTICE_CHARS + 1)
    if cut ~= nil then
        message = message:sub(1, cut - 1) .. "..."
    end
    if stand then
        log:notify(message, "stand")
        return
    end
    log:notify(message)
end

-- A function is called with the arguments, in a thread of its own (it may wait); anything else
-- (a table, a variable) is read. Either way the value is what comes out
local function call(name: string, args_text: string, stand: bool): void
    if name == "" then
        log:warn(text("no_name"))
        return
    end
    local found, value, owner = resolve(name)
    if not found then
        log:warn(text("not_found"):format(name))
        return
    end
    if type(value) ~= "function" then
        deliver(name, table.pack(true, value), stand, false)
        return
    end
    local args, count, err = args_parser.parse(args_text)
    if err ~= nil then
        log:error(text("bad_args"):format(name, err))
        return
    end
    util.create_thread(function()
        local results
        if owner == nil then
            results = table.pack(pcall(value, table.unpack(args, 1, count)))
        else
            results = table.pack(pcall(value, owner, table.unpack(args, 1, count)))
        end
        if not results[1] then
            log:error(text("failed"):format(name, tostring(results[2])))
            return
        end
        deliver(name, results, stand, true)
    end)
end

-- ─── Loop ────────────────────────────────────────────────────────────────────

-- The loop going on: { every = ms or nil, next = ms }; nil - none
local loop = nil
-- The Loop toggle, and whether the script itself is switching it (that isn't the user's click)
local loop_toggle = nil
local syncing = false

-- Switches the Loop toggle to how the loop is, without starting or stopping anything
local function sync_toggle(on: bool): void
    if loop_toggle == nil then
        return
    end
    syncing = true
    pcall(menu.set_value, loop_toggle, on)
    syncing = false
end

-- The loop ended by itself or was stopped
local function end_loop(run: table): void
    if loop ~= run then
        return
    end
    loop = nil
    sync_toggle(false)
end

-- Calls the function every frame (every: nil) or once every `every` ms, until stopped; an error ends it.
-- It works like the loop of a module's function: a table or a variable is read, the Variable line follows
local function start_loop(name: string, get_args, every: ?int): void
    if name == "" then
        log:warn(text("no_name"))
        sync_toggle(false)
        return
    end
    local run = { every = every, next = 0 }
    loop = run
    sync_toggle(true)
    if every == nil then
        log:notify(mtext("loop.started"):format(name))
    else
        log:notify(mtext("loop.started_every"):format(name, every))
    end
    local values = Atdar.loader.load("ui/stand/modules/values")
    util.create_tick_handler(function()
        -- Stopped, or replaced by a newer loop
        if stopping or loop ~= run then
            return false
        end
        if run.every ~= nil then
            local now = util.current_time_millis()
            if now < run.next then
                return true
            end
            run.next = now + run.every
        end
        local found, value, owner = resolve(name)
        if not found then
            end_loop(run)
            log:warn(text("not_found"):format(name))
            return false
        end
        if type(value) ~= "function" then
            values.show_result(RESULT_KEY, table.pack(true, value))
            return true
        end
        local args, count, err = args_parser.parse(get_args())
        if err ~= nil then
            end_loop(run)
            log:error(text("bad_args"):format(name, err))
            return false
        end
        local results
        if owner == nil then
            results = table.pack(pcall(value, table.unpack(args, 1, count)))
        else
            results = table.pack(pcall(value, owner, table.unpack(args, 1, count)))
        end
        if not results[1] then
            end_loop(run)
            log:error(text("failed"):format(name, tostring(results[2])))
            return false
        end
        values.show_result(RESULT_KEY, results)
        return true
    end)
end

local function stop_loop(name: string): void
    if loop == nil then
        log:notify(mtext("loop.not_running"):format(name))
        return
    end
    end_loop(loop)
    log:notify(mtext("loop.stopped"):format(name))
end

-- Makes the list in node
-- @return The list's handle
function module.build(node: table): any
    local function_name = ""
    local args_text = ""
    local on_enter = false
    local on_enter_name = false
    local on_open = false
    local stand = true
    local list = node:list(label("name"), {}, label("help"), nil, function()
        if on_open then
            call(function_name, args_text, stand)
        end
    end)

    -- With Call After Typing Function on, typing the name calls it (or reads a table or a variable) at once
    list:text_input(label("function.name"), { "debugcallfuncname" }, function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        function_name = value
        if on_enter_name then
            call(function_name, args_text, stand)
        end
    end, label("function.help"), function_name)

    list:text_input(label("args.name"), { "debugcallfuncargs" }, function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        args_text = value
        if on_enter then
            call(function_name, args_text, stand)
        end
    end, label("args.help"), args_text)

    list:divider(label("call.divider"))

    list:toggle(label("on_enter_name.name"), function(on)
        on_enter_name = on
    end, {}, label("on_enter_name.help"), false)

    list:toggle(label("on_enter.name"), function(on)
        on_enter = on
    end, {}, label("on_enter.help"), false)

    list:toggle(label("stand.name"), function(on)
        stand = on
    end, {}, label("stand.help"), true)

    list:action(label("call.name"), function()
        call(function_name, args_text, stand)
    end, {}, label("call.help"))

    -- Once, after the ms picked; the arguments are worked out then, not at the click
    list:click_slider(mlabel("loop.call_after"), 100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        log:notify(mtext("loop.call_scheduled"):format(function_name, ms))
        util.create_thread(function()
            util.yield(ms)
            if not stopping then
                call(function_name, args_text, stand)
            end
        end)
    end, {}, mlabel("loop.call_after_help"))

    list:toggle(mlabel("loop.call_on_open"), function(on)
        on_open = on
    end, {}, mlabel("loop.call_on_open_help"), false)

    loop_toggle = list:toggle(mlabel("loop.loop"), function(on)
        if stopping or syncing then
            return
        end
        if on and loop == nil then
            start_loop(function_name, || -> args_text, nil)
            return
        end
        if not on and loop ~= nil then
            stop_loop(function_name)
        end
    end, {}, mlabel("loop.loop_help"), false)

    list:click_slider(mlabel("loop.every"), 100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        start_loop(function_name, || -> args_text, ms)
    end, {}, mlabel("loop.every_help"))

    -- The Tables divider and Table Depth: shown only while the last result is a table
    local values = Atdar.loader.load("ui/stand/modules/values")
    local table_divider = list:divider(label("table.divider"))
    local depth_ref = list:slider(label("depth.name"), 1, 8, values.result_depth(RESULT_KEY), 1, function(depth)
        if stopping then
            return
        end
        values.set_result_depth(RESULT_KEY, depth)
    end, {}, label("depth.help"))
    values.bind_depth_items(RESULT_KEY, { table_divider, depth_ref })

    -- What came out: the Variable line, and for a table the Value list under it
    values.add_result_lines(list, RESULT_KEY, true)

    return list.handle
end

return module
