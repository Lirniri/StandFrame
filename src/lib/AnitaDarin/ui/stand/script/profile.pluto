-- Items for the active profile's values, built where ui/stand/script/section.pluto puts them:
--   header      - "Profile: main" divider, Display Name, Short Name
--   (the Language list is ui/stand/script/language)
--   log_name    - Name In Logs
--   appearance  - Appearance > Notifications: where they show, emoticons, errors always in Stand, examples;
--                 under the Stand divider how Stand's look, under the Game divider how they look in the game's
--                 feed (post or message card with its picture, day and night hours, colours for each)
--   profiles    - Profiles list laid out like Stand's: Create Profile, Open Folder, then one list per profile
--                 with Save, Load, Automatically Save, Reset and Delete
--   auto_copy   - Copy Menu To Core, and the pack picked on the line under it
--   command_box_base_prefix / command_box_found_prefix / user_command_box - a prefix, Prefix At The End, a separator
--   debug       - Debug Mode, Stop After Changes, Load Timing, Reload Natives
--   log_keep_days, updater_log_both_ways, log_info_at_once - the Logs settings
--   rename      - Rename Script
--
-- Only the layout is here. What an item does with the profile - writes its value, follows a profile loaded
-- or reset, makes its caption again - is in ui/logic/stand/script/profile_view; what the buttons do is in
-- ui/logic/stand/script/profile_actions.
-- Strings live in core/language under "profile"

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local view = Atdar.loader.load("ui/logic/stand/script/profile_view")
local actions = Atdar.loader.load("ui/logic/stand/script/profile_actions")
local Logger = Atdar.loader.load("core/logger")
local feed_picture = Atdar.loader.load("natives/visual/feed_picture")
local confirm = Atdar.loader.load("ui/stand/core/confirm")

local log = new Logger("Profile")

local module = {}

-- Strings under "profile"
local label, text = i18n.scope("profile")

-- The values of the fixed-choice settings, in the menu's order
local SEPARATORS = { "", "_", "." }
-- Each separator's word in the menu
local SEPARATOR_NAMES = { [""] = "separator.none", ["_"] = "separator.underscore", ["."] = "separator.dot" }
local LOG_NAMES = { "short", "display" }
local NOTIFY_TARGETS = { "stand", "game", "none" }
local FEED_STYLES = { "message", "ticker" }
-- "level" or natives/visual/hud/text COLOR names
local SUBJECT_COLORS = { "level", "default", "white", "grey", "dark_grey", "black", "red", "green", "blue",
    "yellow", "orange", "purple", "pink" }
-- natives/visual/hud/thefeed ICON names
local FEED_ICONS = { "CHAT_BOX", "EMAIL", "FRIEND_REQUEST", "ARROW", "RP", "MONEY", "NONE" }

-- The picture, the icon and the subject are the message card's only: hidden while posts are chosen
local function is_message(): bool
    return Atdar.profile.get("notify_feed_style") == "message"
end

-- Starts a new build of the section
-- @param packs Menu packs in store, offered for copying to core
function module.begin(packs: table = {}): void
    view.begin(packs)
end

-- Header: whose values these are, and the names

function module.header(node: table): void
    view.caption(node:divider(view.settings_caption()), view.settings_caption)
    view.input(node, "display_name")
    view.input(node, "short_name")
end

-- Name In Logs

function module.log_name(node: table): void
    view.choice(node, "log_name", { strings = "log_name", values = LOG_NAMES, commands = { "logname" } })
end

-- Appearance

-- Where notifications show (Stand, the game's feed, log only), emoticons, errors always in Stand, examples
local function notifications(list: table): void

    view.choice(list, "notify", { strings = "notify.target", values = NOTIFY_TARGETS, fallback = "stand", commands = { "" } })

    -- Emoticons: on, and the one for each kind of notification
    local emoticons = list:list(label("notify.emoticons.name"), {}, label("notify.emoticons.help"))
    view.toggle(emoticons, "notify_emoticons", "notify.emoticons.on")
    view.input(emoticons, "notify_emoticon_info", true, "notifyemoticoninfo")
    view.input(emoticons, "notify_emoticon_warn", true, "notifyemoticonwarn")
    view.input(emoticons, "notify_emoticon_error", true, "notifyemoticonerror")
    view.input(emoticons, "notify_emoticon_success", true, "notifyemoticonsuccess")

    view.toggle(list, "notify_errors_in_stand", "notify.errors")

    -- An example of each kind, the way it really looks; the ones before are taken away first
    local examples = list:list(label("notify.examples.name"), {}, label("notify.examples.help"))
    for _, kind in ipairs(actions.EXAMPLE_KINDS) do
        examples:action(label($"notify.examples.{kind.key}.name"), || -> actions.show_examples({ kind }), {},
            label("notify.examples.one.help"))
    end
    examples:action(label("notify.examples.all.name"), || -> actions.show_examples(actions.EXAMPLE_KINDS), {},
        label("notify.examples.all.help"))
end

-- The Stand divider: how Stand's notifications look
local function stand_notifications(list: table): void
    list:divider(label("notify.stand.divider"))
    view.toggle(list, "notify_stand_newline", "notify.stand.newline")
end

-- The message card's subject colour for "day" or "night"
local function subject_color(list: table, period: string): void
    view.shown_when(view.choice(list, $"notify_subject_color_{period}", {
        strings = $"feed.subject_color_{period}",
        values = SUBJECT_COLORS,
        option = |name| -> $"feed.subject_color.{name}",
        fallback = "default",
        commands = { $"notifyfeedsubject{period}" },
    }), is_message)
end

-- The Game divider and below it how notifications look in the game's feed
local function feed(list: table): void

    list:divider(label("feed.name"))

    view.choice(list, "notify_feed_style", {
        strings = "feed.style",
        values = FEED_STYLES,
        fallback = "ticker"
    })

    local feed_general_list = list:list(label("feed.general.name"), {}, label("feed.general.help"))

    -- Flashing is the game feed's only (Stand's notifications don't flash), so it's here
    view.toggle(feed_general_list, "notify_flash", "notify.flash")
    
    view.slider(feed_general_list, "notify_day_start", "feed.day_start", 0, 23, { "notifyfeeddaystart" })
    view.slider(feed_general_list, "notify_night_start", "feed.night_start", 0, 23, { "notifyfeednightstart" })
    
    feed_general_list:divider(label("feed.background_color.divider"))
    
    view.color(feed_general_list, "notify_background_day", "feed.background_day", { "notifyfeedbgday" })
    view.color(feed_general_list, "notify_background_night", "feed.background_night", { "notifyfeedbgnight" })
    
    feed_general_list:divider(label("feed.flash_color.divider"))

    view.color(feed_general_list, "notify_flash_color_day", "feed.flash_color_day", { "notifyfeedflashday" })
    view.color(feed_general_list, "notify_flash_color_night", "feed.flash_color_night", { "notifyfeedflashnight" })

    list:divider("Game > Style: Message/Post")
    
    view.shown_when(view.choice(list, "notify_feed_picture", {
        strings = "feed.picture",
        values = feed_picture.list(),
        title = feed_picture.title,
        after = actions.load_feed_picture,
    }), is_message)
    actions.load_feed_picture()

    view.shown_when(view.choice(list, "notify_feed_icon", {
        strings = "feed.icon",
        values = FEED_ICONS,
        option = |name| -> $"feed.icon.{name:lower()}",
        fallback = "CHAT_BOX",
    }), is_message)

    subject_color(list, "day")
    subject_color(list, "night")
end

-- Appearance > Notifications, with the game's feed under the Game divider (utils/util.toast reads what they set)
function module.appearance(node: table): void
    local appearance = node:list(label("appearance.name"), { "appearance" }, label("appearance.help"))
    -- Going back out of Notifications takes the example cards away too: they were only there to look at
    local list = appearance:list(label("notify.name"), { "notify" }, label("notify.help"), actions.remove_examples)
    notifications(list)
    stand_notifications(list)
    feed(list)
end

-- Profiles

-- One profile's list: Save, Load, Automatically Save, Reset, Delete
-- @param changed function() a profile was made, deleted or loaded: the entries and the section follow
local function build_entry(parent: table, name: string, changed: function): void

    local profile = Atdar.profile
    -- Going back out of the list cancels a first click on Reset
    local cancel_reset = nil

    local entry = parent:list(view.entry_caption(name), {}, label("entry.help"), function()
        if cancel_reset then
            cancel_reset()
        end
    end)
    view.caption(entry.handle, || -> view.entry_caption(name), $"entry.{name}")

    -- The profile's values changed (loaded, reset): the section's items take them in place. The entries
    -- stay: making them again would delete the list the user is in
    local function values_changed(): void
        if not view.update() then
            changed()
        end
    end

    local save_ref
    save_ref = entry:action(label("save.name"), function(click_type)
        local function save(): void
            actions.save(name, view.update_captions)
        end

        -- Saving into another profile overwrites what it had
        if name == profile.active_name() then
            save()
            return
        end

        menu.show_warning(save_ref, click_type, text("save.overwrite"):format(name, profile.active_name()), save)
    end, {}, label("save.help"))

    local load_ref
    load_ref = entry:action(label("load.name"), function(click_type)
        local function load_profile(): void
            actions.load(name, values_changed)
        end

        if not profile.is_dirty() then
            load_profile()
            return
        end

        menu.show_warning(load_ref, click_type, text("load.unsaved"):format(profile.active_name()), load_profile)
    end, {}, label("load.help"))

    entry:toggle(label("autosave.name"), function(on)
        profile.set_autosave(name, on)
        view.update_captions()
    end, {}, label("autosave.help"), profile.is_autosave(name))

    -- Every value back to the defaults in core/profile, after a second click
    local _
    _, cancel_reset = confirm.action(entry, label("reset.name"), label("reset.again"), function()
        actions.reset(name, values_changed)
    end, function()
        log:warn(text("reset.warning"):format(name, confirm.WAIT_MS // 1000))
    end, label("reset.help"))

    local delete_ref
    delete_ref = entry:action(label("delete.name"), function(click_type)
        menu.show_warning(delete_ref, click_type, text("delete.warning"):format(name), function()
            actions.delete(name, changed)
        end)
    end, {}, label("delete.help"))
end

-- The Profiles list. Its entries are made again in place when it's opened and after a profile is made,
-- deleted or loaded; the rest of the section follows the active profile's values (view.update). Rebuilding
-- the whole section from inside this list would leave the user in the old, deleted one.
-- refresh() rebuilds the section: only when the items can't take the values in place
function module.profiles(node: table, refresh: function): void

    local profile = Atdar.profile
    local list = nil
    -- Where the entries start, so they're made again without the items above
    local first = nil
    local changed

    local function fill_entries(): void
        if first == nil then
            return
        end

        list:clear_from(first)

        local names = profile.list()

        for _, name in ipairs(names) do
            build_entry(list, name, changed)
        end

        -- All deleted: the script goes on with the values it has; Create Main Profile or Save brings one back
        if #names == 0 then
            list:readonly_name(label("no_profiles"))
        end
    end

    -- A profile made, deleted or loaded: the entries again, the section's captions and items to its values
    changed = function()
        fill_entries()
        if not view.update() then
            refresh()
        end
    end

    list = node:list(label("name"), { "profiles" }, label("help"), nil, fill_entries)

    list:text_input(label("create.name"), { "newprofile" }, function(value)
        if value ~= "" and profile.create(value) then
            changed()
        end
    end, label("create.help"))

    -- The main profile with the defaults; one that's there is made again only after the warning
    local create_main_ref
    create_main_ref = list:action(label("create_main.name"), function(click_type)
        local main = profile.main_name()
        local function make(): void
            actions.create_main(changed)
        end

        if not profile.exists(main) then
            make()
            return
        end

        menu.show_warning(create_main_ref, click_type, text("create_main.warning"):format(main), make)
    end, {}, label("create_main.help"))

    list:action(label("open_folder.name"), function()
        util.open_folder(profile.folder())
    end, {}, label("open_folder.help"))

    list:divider(label("list.divider"))
    first = #list.children + 1
    fill_entries()
end

-- Copy Menu To Core

-- Off, then every pack in store; takes effect at the next start (menu_loader's auto_copy)
-- @param changed function() another pack was picked: the list makes the line under the item again
function module.auto_copy(node: table, changed: function): void
    local ref = node:list_action(view.auto_copy_caption(), view.auto_copy_options(), function(index)
        view.set_auto_copy(index)
        changed()
    end, { "menuloaderautocopy" }, view.auto_copy_help())

    view.caption(ref, view.auto_copy_caption)
    view.help(ref, view.auto_copy_help)
    module.auto_copy_ref = ref
end

-- The pack picked, on a line of its own right under Copy Menu To Core; nothing while it's off
function module.auto_copy_picked(node: table): void

    local pack = view.auto_copy_pack()

    if pack ~= nil then
        node:divider(pack.name)
    end
end

-- The packs in store were read again (Load Menu was opened): Copy Menu To Core offers what's there now
function module.refresh_packs(packs: table): void
    view.set_packs(packs)
    if module.auto_copy_ref ~= nil then
        pcall(menu.set_list_action_options, module.auto_copy_ref, view.auto_copy_options())
    end
end

-- Command Box: a prefix, where it goes, a separator

-- The three items of one kind of commands
-- @param key The profile key of the prefix ("command_box_prefix"): "<key>_at_end" is where it goes
-- @param separator_key The profile key of the separator, strings: the separator's strings
-- @param command The base of the commands: cbprefix, cbprefixatend
local function prefix_items(node: table, key: string, separator_key: string, strings: string, command: string,
    separator_command: string
): void
    -- body function:
    view.input(node, key, true, command)
    view.toggle(node, $"{key}_at_end", "prefix_at_end", { $"{command}atend" })
    view.choice(node, separator_key, {
        strings = strings,
        values = SEPARATORS,
        option = |value| -> SEPARATOR_NAMES[value],
        commands = { separator_command },
    })
end

-- Of the script's own commands (Base Commands): cbprefix, cbprefixatend, cbseparator
function module.command_box_base_prefix(node: table): void
    prefix_items(node, "command_box_prefix", "command_box_separator", "separator", "cbprefix", "cbseparator")
end

-- Of the loaded menu's commands (Found Commands): cbfoundprefix, cbfoundprefixatend, cbfoundseparator
function module.command_box_found_prefix(node: table): void
    prefix_items(node, "command_box_found_prefix", "command_box_found_separator", "found_separator", "cbfoundprefix",
        "cbfoundseparator")
end

-- Of the user's own commands, at the top of User Commands: cbuserprefix, cbuserprefixatend, cbuserseparator
function module.user_command_box(node: table): void
    prefix_items(node, "command_box_user_prefix", "command_box_user_separator", "user_separator", "cbuserprefix",
        "cbuserseparator")
end

-- Debug Mode

function module.debug(node: table): void

    view.toggle(node, "debug", "debug", { "debug" })

    -- The script stops by itself when its files change on disk (core/file_watch)
    view.toggle(node, "stop_on_change", "stop_on_change", { "stoponchange" }, function(on)
        if on then
            log:notify(text("stop_on_change.on"))
        end
    end)

    -- Works without debug mode too: it only adds lines to the log
    view.toggle(node, "load_timing", "load_timing", { "loadtiming" }, function(on)
        if on then
            log:notify(text("load_timing.on"))
        end
    end)

    -- The native wrappers read from disk again, to try a change without restarting the script
    node:action(label("reload_natives.name"), actions.reload_natives, { "reloadnatives" }, label("reload_natives.help"))
end

-- Logs

-- Days of log files kept (core/logger). Fewer days apply right away, not only at the next start or day
function module.log_keep_days(node: table): void
    view.slider(node, "log_keep_days", "log_keep_days", 0, 365, { "logkeepdays" }, || -> Logger.remove_old())
end

-- Write updater changes to both log file and Stand
function module.updater_log_both_ways(node: table): void
    view.toggle(node, "updater_log_both_ways", "updater_log_both_ways", { "updaterlogbothways" })
end

-- Info lines on disk at once too (core/logger): warnings and errors always are, the rest within a second.
-- What waits goes now: nothing written before stays behind
function module.log_info_at_once(node: table): void
    view.toggle(node, "log_info_at_once", "log_info_at_once", { "loginfoatonce" }, || -> Logger.flush())
end

-- Rename Script

function module.rename(node: table): void

    local rename_ref
    -- Stand calls the field again while the script stops (after a rename, or any stop);
    -- showing a warning then is an error, so nothing is asked then
    local renaming = false

    rename_ref = node:text_input(label("rename.name"), { "renamescript" }, function(value, click_type)
        if renaming or clicks.is_stopping() or value == Atdar.name then
            return
        end

        if not actions.is_valid_name(value) then
            return
        end

        -- Still possible if Stand stops the script before our on_stop handler runs
        local shown = pcall(menu.show_warning, rename_ref, click_type, text("rename.warning"):format(Atdar.name, value), function()
            renaming = true
            if not actions.rename_script(value) then
                renaming = false
            end
        end)

        if not shown then
            log:debug($"rename to '{value}' not asked: the script is stopping")
        end
    end, label("rename.help"), Atdar.name)
end

return module
