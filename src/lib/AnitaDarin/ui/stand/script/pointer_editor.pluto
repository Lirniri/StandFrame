-- lib/AnitaDarin/ui/stand/script/pointer_editor.pluto
--
-- Debug > Pointer Editor, right above Delete Script: the places in the game's memory that are found by a signature
-- (Atdar.natives.memory.pointers) as a list to edit. What it does is in the system module PointerEditor
-- (modules/systems/PointerEditor); the list is shown only while that module runs.
--
--   Pointer Editor >   Add Pointer (name = pattern: "roll = 48 8B ?? ?? 89")
--                      Scan All, Read Bytes (an address, or a pointer's name, and how many: "roll, 16")
--                      Read Value ("roll, 0x8": the int there), Pointer Chain ("roll, 0x8, 0x10A0, 0x280")
--                      Pointers (divider), then a list per pointer
--   a pointer >        Settings > (Pattern, Kind (address / rip / offset), At, Size, Extra, Remove), Scan,
--                      a divider and below it what was found, the delete buttons and Copy Code
--
-- A pointer made here is kept in the script's store and stored again at every start. One that something else
-- stored (the script itself) is shown with its state and can be scanned, but not changed. Every change is
-- saved at once; the lists are made when they are opened and made again after a change.
-- Strings: core/language "script_menu.pointer_editor"

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("PointerEditor")

local module = {}

local SCOPE = "script_menu.pointer_editor"
local label, text = i18n.scope(SCOPE)

-- The kinds of a pointer, in the order they are offered
local KINDS = { "address", "rip", "offset" }

-- The logic: the PointerEditor module, asked for at every use (Reload makes a new one)
local function editor(): table
    return Atdar.modules.get("PointerEditor")
end

-- Stand's text fields need a command each: short, unique while the field exists
local command_number = 0

local function next_command(): string
    command_number += 1

    return $"pointeredit{command_number}"
end

-- A text field of the editor; not one of the found commands (its command isn't tracked)
-- @param opts The item's options: key (or name and help), default (what's in it)
-- @param on_typed function(value) the user typed in it
local function field(node: table, opts: table, on_typed: function): table

    opts.commands = { next_command() }
    opts.track = false
    opts.user_only = true
    opts.on_change = |value| -> on_typed(value)

    return node:text_input(opts)
end

-- The status of a pointer (core/language "status.<key>") by what the module says
local STATUS_KEY = { ["found"] = "found", ["not found"] = "not_found", ["not searched"] = "not_searched" }

-- @return The value as text: an address in hex, a dash for nil
local function hex(value): string

    if value == nil then
        return "-"
    end

    if value < 0 then
        local digits = string.format("%X", -value)

        return $"-0x{digits}"
    end

    local digits = string.format("%X", value)

    return $"0x{digits}"
end

-- The topics of the instruction, in the order of the list (core/language "guide.<topic>")
local GUIDE_TOPICS = { "add", "setup", "scan", "bytes", "value", "chain", "code" }

-- Says why a change was refused
local function warn(why: string): void
    log:warn(text($"errors.{why}"))
end

-- How many scans are shown as lines in each section (the last one and the ones before it); the rest are in a list
local SHOWN_ROWS = 4

-- How a scan was made, for the ones that are not the last: "(At 3, Size 1)". Size, Extra and Kind only when they are
-- not the default
local function settings_note(entry: table): string

    local extras = ""

    if entry.size ~= 4 then
        extras = extras .. text("history.size"):format(entry.size)
    end

    if entry.extra ~= 0 then
        extras = extras .. text("history.extra"):format(entry.extra)
    end

    if entry.kind ~= "address" then
        extras = extras .. text("history.kind"):format(entry.kind)
    end

    return text("history.note"):format(entry.at, extras)
end

-- One scan in a section as a line: "4: 0x7FF6A8120F48", and how it was made when it isn't the last scan
local function result_line(entry: table, kind: string, is_last: bool): string

    local line = text("results.row"):format(entry.id, hex(entry.values[kind]))

    if is_last then
        return line
    end

    return line .. " " .. settings_note(entry)
end

-- One pointer: the settings on top, then Scan, and below the divider what was found
-- @param refresh function() the list of pointers is made again (a pointer went, or its state changed)
local function pointer_list(parent: table, name: string, refresh: function): void

    local gone = false
    local cancel = nil

    parent:list({ name = name, help = label("pointer.help"), fill = function(node)

        local ui = node:scope(SCOPE)
        local info = nil
        local state = nil

        for _, entry in ipairs(editor():list()) do
            if entry.name == name then
                info = entry
            end
        end

        if info == nil then
            node:readonly_name({ name = label("errors.missing") })
            return
        end

        -- A change is saved by the module, and the status goes back to not searched
        local function change(what: string, value): void

            local ok, why = editor():set(name, what, value)

            if not ok then
                warn(why)
            end

            state.rebuild()
        end

        -- The settings on top: they are set once, then Scan is what is used
        if info.own then
            node:list({ name = label("settings.name"), help = label("settings.help"), fill = function(settings)

                local settings_ui = settings:scope(SCOPE)

                field(settings_ui, { key = "pattern", default = info.pattern }, |value| -> change("pattern", value))

                settings_ui:list_action({ key = "kind", options = KINDS, on_select = function(index: int)
                    change("kind", KINDS[index])
                end })

                field(settings_ui, { key = "at", default = tostring(info.at) }, |value| -> change("at", value))
                field(settings_ui, { key = "size", default = tostring(info.size) }, |value| -> change("size", value))
                field(settings_ui, { key = "extra", default = tostring(info.extra) }, |value| -> change("extra", value))

                cancel = select(2, settings_ui:confirm({ key = "remove",
                    on_confirm = function()
                        editor():remove(name)
                        gone = true
                        node:clear()
                        log:notify(text("remove.done"):format(name))
                    end,
                    on_first = || -> log:warn(text("remove.warning"):format(name)),
                }))
            end,
            on_back = function()
                if cancel ~= nil then
                    cancel()
                end
            end })
        else
            node:readonly_name({ name = label("not_own") })
        end

        ui:action({ key = "scan", on_click = function()

            local value = editor():scan(name)

            if value == nil then
                log:warn(text("scan.not_found"):format(name))
            else
                log:notify(text("scan.found"):format(name, hex(value)))
            end

            state.rebuild()
        end })

        -- Copy Code: the code that finds the pointer, in the clipboard (or in the log without a clipboard function)
        local function copy_code_button(): void
            node:action({ name = label("copy_code.name"), help = label("copy_code.help"), on_click = function()

                local code = editor():get_code(name)

                if code == nil then
                    warn("missing")
                    return
                end

                if util.copy_to_clipboard == nil then
                    log:info(code)
                    log:warn(text("copy_code.unavailable"))
                    return
                end

                util.copy_to_clipboard(code)
                log:notify(text("copy_code.done"))
            end })
        end

        -- What was found, section by section, and the buttons that take it away: made again after a scan or a change
        state = node:section(function()

            local current = nil

            for _, entry in ipairs(editor():list()) do
                if entry.name == name then
                    current = entry
                end
            end

            if current == nil then
                return
            end

            local values = editor():get_values(name)
            local scans = editor():get_scans(name)

            -- The last scan found nothing, or there was none: the state
            if values == nil then
                local key = STATUS_KEY[current.status] or "not_searched"

                node:readonly_name({ name = text($"status.{key}"):format(hex(current.value)) })
            end

            if #scans == 0 then
                copy_code_button()
                return
            end

            -- A section for each kind of the value; the one the pointer gives (its Kind) is marked
            for _, kind in ipairs(KINDS) do

                local title = text($"results.{kind}")

                if kind == current.kind then
                    title = title .. text("results.used")
                end

                node:divider({ name = title })

                for index = 1, math.min(#scans, SHOWN_ROWS) do
                    node:readonly_name({ name = result_line(scans[index], kind, index == 1 and values ~= nil) })
                end

                if #scans > SHOWN_ROWS then
                    node:list({ name = label("history.more"), fill = function(more)
                        for index = SHOWN_ROWS + 1, #scans do
                            more:readonly_name({ name = result_line(scans[index], kind, false) })
                        end
                    end })
                end
            end

            node:action({ name = label("delete_one.name"), help = label("delete_one.help"), on_click = function()
                editor():delete_result(name)
                state.rebuild()
            end })

            node:action({ name = label("delete_all.name"), help = label("delete_all.help"), on_click = function()
                editor():delete_all(name)
                state.rebuild()
            end })

            node:action({ name = label("delete_past.name"), help = label("delete_past.help"), on_click = function()
                editor():delete_past(name)
                state.rebuild()
            end })

            copy_code_button()
        end)
    end,
    on_back = function()
        if gone then
            refresh()
        end
    end })
end

-- Whether the PointerEditor module is there and running: the list is shown only then
function module.is_available(): bool
    return Atdar.modules.is_running("PointerEditor")
end

-- Makes the Pointer Editor list in node (Debug)
-- @return The Pointer Editor's list, and when it's shown: while the PointerEditor module runs
function module.build(node: table)

    local shown = nil

    local list = node:list({ name = label("name"), help = label("help"), fill = function(pointers)

        local ui = pointers:scope(SCOPE)

        -- "name = pattern"
        field(ui, { key = "add" }, function(value)

            local name, pattern = value:match("^%s*([^=]-)%s*=%s*(.-)%s*$")

            if name == nil then
                warn("add")
                return
            end

            local ok, why = editor():add(name, pattern)

            if not ok then
                warn(why)
                return
            end

            log:notify(text("add.done"):format(name))
            shown.rebuild()
        end)

        ui:action({ key = "scan_all", on_click = function()

            local found, count = editor():scan_all()

            log:notify(text("scan_all.done"):format(found, count))
            shown.rebuild()
        end })

        -- "address or name": 16 bytes, "address or name, count": that many
        field(ui, { key = "read" }, function(value)

            local where, count = value:match("^%s*([^,]-)%s*,%s*(%d+)%s*$")
            local bytes = editor():read_bytes(where or value, tonumber(count) or 16)

            if bytes == nil then
                warn("bytes")
                return
            end

            log:notify(bytes)
        end)

        -- "address or name": its int at offset 0, "address or name, offset": at that offset (0x.. or decimal)
        field(ui, { key = "read_value" }, function(value)

            local where, offset_text = value:match("^%s*([^,]-)%s*,%s*(%S+)%s*$")
            local offset = tonumber(offset_text or 0)
            local found = nil

            if offset ~= nil then
                found = editor():read_value(where or value:match("^%s*(.-)%s*$"), offset)
            end

            if found == nil then
                warn("bytes")
                return
            end

            log:notify(text("read_value.done"):format(where or value, hex(found.offset), tostring(found.value), hex(found.value)))
        end)

        -- "name, hop, hop, ..., last": the whole text goes to the module, one line per step is shown
        field(ui, { key = "chain" }, function(value)

            local result = editor():read_chain(value)
            local lines = {}

            for index, step in ipairs(result.steps) do
                if step.is_int then
                    lines[#lines + 1] = text("chain.int"):format(step.label, tostring(step.value))
                elseif index == 1 then
                    lines[#lines + 1] = text("chain.first"):format(step.label, hex(step.address))
                else
                    lines[#lines + 1] = text("chain.hop"):format(step.label, hex(step.address))
                end
            end

            if result.error ~= nil then
                lines[#lines + 1] = text($"errors.{result.error}"):format(result.failed_at or 0)
            end

            log:notify(table.concat(lines, "\n"))
        end)

        -- The instruction: a list with a topic for each tool, each one sends a message with an example (ped_factory) to Stand's
        -- notifications, whatever the profile says for the others
        pointers:list({ name = label("guide.name"), help = label("guide.help"), fill = function(guide)

            for _, topic in ipairs(GUIDE_TOPICS) do
                guide:action({
                    name = label($"guide.{topic}.name"), help = label("guide.item_help"),
                    on_click = || -> log:notify(text($"guide.{topic}.text"), "stand"),
                })
            end
        end })

        pointers:divider({ name = label("pointers.divider") })

        shown = pointers:section(function()

            local entries = editor():list()

            if #entries == 0 then
                pointers:readonly_name({ name = label("empty") })
            end

            for _, entry in ipairs(entries) do
                pointer_list(pointers, entry.name, || -> shown.rebuild())
            end
        end)
    end })

    return list, module.is_available
end

return module
