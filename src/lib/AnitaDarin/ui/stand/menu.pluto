local load = require($"{Atdar.name}/core/loader")

local module = {}

module.root = menu.my_root()
module.divider = module.root:divider("AnitaDarin")

local submenus = { "self" }

for _, name in ipairs(submenus) do
    local submenu = load($"ui/stand/menu/{name}")
    if submenu.build then
        module[name] = submenu.build(module)
    end
end

return module
