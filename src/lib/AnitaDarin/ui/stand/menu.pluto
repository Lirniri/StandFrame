-- lib/AnitaDarin/ui/stand/menu.pluto
-- The menu layout is written by hand in m.build(): create lists, place tabs and name refs however you like.
-- A tab file returns function(parent, refs) and only fills the parent it is given.
-- refs is one shared table (Atdar.menu.refs); names in it are up to you.

local m = {}

m.root = menu.my_root()
m.refs = {} -- name -> CommandRef

-- Links a script item into the Stand menu at a path, e.g. "Self"
function m.link(path, ref)
    local parent = menu.ref_by_path(path)
    if not menu.is_ref_valid(parent) then
        Atdar.logger:log($"[menu] Stand path not found: {path}")
        return nil
    end
    return menu.link(parent, ref)
end

-- Ready module or nil; a missing module only skips its items, not the whole tab
function m.module(name)
    local mod = Atdar.modules:get(name)
    if mod == nil then
        Atdar.logger:log($"[menu] module '{name}' is not ready, its items are skipped")
    end
    return mod
end

-- Toggle bound to a ToggleModule
function m.toggle(parent, module_name, label, help = "")
    local mod = m.module(module_name)
    if mod == nil then return nil end

    return parent:toggle(label, {}, help, function(on)
        mod:set_enabled(on)
        Atdar.util.toast(label .. ": " .. (on ? "enabled" : "disabled"))
    end, mod.enabled)
end

-- Fills parent with ui/stand/tabs/<name>; an error only skips that tab
function m.tab(name, parent)
    local ok, build = pcall(require, $"{Atdar.name}/ui/stand/tabs/{name}")
    if not ok then
        Atdar.logger:log($"[menu] failed to load tab '{name}': {build}")
        return
    end

    local built, err = pcall(build, parent, m.refs)
    if not built then
        Atdar.logger:log($"[menu] error in tab '{name}': {err}")
        Atdar.util.toast($"Menu error '{name}'\n{err}")
    end
end

function m.build()
    local refs = m.refs

    refs.divider = m.root:divider(Atdar.name)

    refs.self = m.root:list("Self", {}, "")
    m.tab("self", refs.self)

    -- refs.vehicle = m.root:list("Vehicle", {}, "")
    -- m.tab("vehicle", refs.vehicle)

    refs.settings = m.root:list("Settings", {}, "")
    m.tab("settings", refs.settings)
end

return m
