local module = {}

local root = menu.my_root()


local testDivider = root:divider("AnitaDarin")

local testAction = root:action("Test_Action", {}, "", function()
    util.toast("Pressed")
end)
local testToggle = root:toggle("Test_Toggle", {}, "", function(on)
    util.toast($"Toggle is {on ? "on" : "off"}")
end, true)
local testToggleLoop = root:toggle_loop("Test_ToggleLoop", {}, "", function(on)
    util.toast("Toggle loop started")
end, function()
    util.toast("Toggle loop stopped")
end)

return module