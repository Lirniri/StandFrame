-- Items for the active profile's values, built where ui/stand/script_menu.pluto puts them:
--   header      - "Profile: main" divider, Display Name, Short Name
--   language    - Language list (Auto follows Stand)
--   log_name    - Name In Logs
--   profiles    - Profiles list laid out like Stand's: Create Profile, Open Folder, then one list per profile
--                 with Save, Load, Automatically Save and Delete
--   auto_copy   - Copy Menu To Core
--   command_box - Command Prefix and Separator
--   debug       - Debug Mode
--   rename      - Rename Script
-- Strings live in language/base under "profile".
--
-- Changes apply right away but reach the profile file only on Save, like Stand's own profiles,
-- unless the profile saves automatically.
-- Items are updated in place (captions, field values) rather than by rebuilding the section:
-- rebuilding deletes the list the user is in, which Stand doesn't do cleanly. Only creating and
-- deleting a profile rebuild it, since the list of profiles changes

local i18n = Atdar.loader.load("core/i18n")
local installer = Atdar.loader.load("core/installer")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Profile")

local module = {}

local function label(key: string): int
    return i18n.label($"profile.{key}")
end

local function text(key: string): string
    return i18n.text($"profile.{key}")
end

-- Option index -> profile value for the two fixed-choice settings
local SEPARATORS = { "", "_" }
local LOG_NAMES = { "short", "display" }

-- Profile keys edited through text fields
local INPUT_KEYS = { "display_name", "short_name", "command_prefix" }

-- Items of the latest build, updated in place when profile values change. Reset by begin()
local view = { inputs = {}, entries = {}, packs = {} }
-- Set while values are written from code, so their on_change doesn't count as an edit
local updating = false
-- Stand calls text fields again while the script stops; showing a warning then is an error
local stopping = false
util.on_stop(function() stopping = true end)

-- "main", "main (active)" or "main (active)*" with unsaved changes
local function entry_caption(name: string): string
    local profile = Atdar.profile
    if name ~= profile.active_name() then
        return name
    end
    return text("entry.active"):format(name) .. (profile.is_dirty() ? "*" : "")
end

local function settings_caption(): string
    return text("settings.of"):format(Atdar.profile.active_name())
end

local function separator_caption(): string
    local key = Atdar.profile.get("command_separator") == "_" ? "separator.underscore" : "separator.none"
    return text("separator.name"):format(text(key))
end

local function log_name_caption(): string
    local key = Atdar.profile.get("log_name") == "display" ? "log_name.display" : "log_name.short"
    return text("log_name.name"):format(text(key))
end

-- "Language: Auto (Stand)", "Language: Русский", or the chosen language marked unavailable
-- while Stand can't show it (Stand in English)
local function language_caption(): string
    local code = Atdar.profile.get("language")
    for _, language in ipairs(i18n.languages()) do
        if language.code == code then
            local name = language.name
            if i18n.get_language() ~= code then
                name = text("language.unavailable_mark"):format(name)
            end
            return text("language.name"):format(name)
        end
    end
    return text("language.name"):format(text("language.auto"))
end

-- "Copy Menu To Core: AnitaDarin", "...: Off", or the saved folder marked missing if it's gone from store
local function auto_copy_caption(): string
    local id = Atdar.profile.get("auto_copy_menu")
    if type(id) ~= "string" or id == "" then
        return text("auto_copy.name"):format(text("auto_copy.off"))
    end
    for _, pack in ipairs(view.packs) do
        if pack.folder == id then
            return text("auto_copy.name"):format(pack.name)
        end
    end
    return text("auto_copy.name"):format(text("auto_copy.missing"):format(id))
end

-- The refs may belong to a section that was already removed, so a failed update is just skipped
local function rename(ref, caption: string): void
    if ref then
        pcall(menu.set_menu_name, ref, caption)
    end
end

local function update_captions(): void
    for name, ref in pairs(view.entries) do
        rename(ref, entry_caption(name))
    end
    rename(view.settings_of, settings_caption())
    rename(view.separator, separator_caption())
    rename(view.log_name, log_name_caption())
    rename(view.language, language_caption())
    rename(view.auto_copy, auto_copy_caption())
end

-- After another profile is loaded its values go into the fields
-- @return Whether every field took its new value; if not, the caller rebuilds the section instead
local function update_fields(): bool
    local ok = true
    updating = true
    for _, key in ipairs(INPUT_KEYS) do
        local ref = view.inputs[key]
        if ref and not pcall(menu.set_value, ref, Atdar.profile.get(key)) then
            ok = false
        end
    end
    if view.debug and not pcall(menu.set_value, view.debug, Atdar.profile.get("debug") == true) then
        ok = false
    end
    updating = false
    return ok
end

-- The profile's language applies to the whole script, also after loading another profile.
-- Registered before the captions update below, so captions come out in the new language
i18n.set_language(Atdar.profile.get("language"))
Atdar.profile.on_change(function(key: string, value)
    if key == "language" then
        i18n.set_language(value)
    end
end)

-- Any change (an edit, a load, a save) can change the captions, e.g. the unsaved mark
Atdar.profile.on_change(|| -> update_captions())
-- Captions are texts in the shown language, so they're made again when it changes (also Stand's own)
i18n.on_change(|| -> update_captions())

-- Starts a new build of the section; items made before it are forgotten.
-- packs: menu packs in store (menu_builder.find_loadable_packs), offered for copying to core
function module.begin(packs: table = {}): void
    view = { inputs = {}, entries = {}, packs = packs }
end

-- A text field for a profile value
local function input(node: table, key: string, allow_empty: bool): void
    local command = "profile" .. key:gsub("_", "")
    view.inputs[key] = node:text_input(label($"{key}.name"), { command }, function(value)
        if updating or (value == "" and not allow_empty) then
            return
        end
        Atdar.profile.set(key, value)
    end, label($"{key}.help"), Atdar.profile.get(key))
end

-- ─── Header: whose values these are, and the names ──────────────────────────

function module.header(node: table): void
    view.settings_of = node:divider(settings_caption())
    input(node, "display_name", false)
    input(node, "short_name", false)
end

-- ─── Language ────────────────────────────────────────────────────────────────

-- Auto follows Stand's language; a fixed one shows the script in it whatever Stand's is
function module.language(node: table): void
    local list = node:list(language_caption(), { "scriptlanguage" }, label("language.help"))
    view.language = list.handle
    local function pick(code: string): void
        Atdar.profile.set("language", code)
        -- Also when the profile already had it: picking again tries again (e.g. after Stand's language changed)
        i18n.set_language(code)
        update_captions()
    end
    list:action(label("language.auto"), || -> pick("auto"), {}, label("language.auto_help"))
    for _, language in ipairs(i18n.languages()) do
        list:action(language.name, || -> pick(language.code))
    end
end

-- ─── Name In Logs ────────────────────────────────────────────────────────────

function module.log_name(node: table): void
    view.log_name = node:list_action(log_name_caption(),
        { label("log_name.short"), label("log_name.display") }, function(index)
        Atdar.profile.set("log_name", LOG_NAMES[index])
    end, { "profilelogname" }, label("log_name.help"))
end

-- ─── Profiles ────────────────────────────────────────────────────────────────

local function build_entry(parent: table, name: string, refresh: function): void
    local profile = Atdar.profile
    local entry = parent:list(entry_caption(name), {}, label("entry.help"))
    view.entries[name] = entry.handle

    local save_ref
    save_ref = entry:action(label("save.name"), function(click_type)
        local function save(): void
            if profile.save_to(name) then
                update_captions()
                log:notify(text("save.done"):format(name))
            end
        end
        -- Saving into another profile overwrites what it had
        if name ~= profile.active_name() then
            menu.show_warning(save_ref, click_type, text("save.overwrite"):format(name, profile.active_name()), save)
        else
            save()
        end
    end, {}, label("save.help"))

    local load_ref
    load_ref = entry:action(label("load.name"), function(click_type)
        local function load_profile(): void
            profile.switch(name)
            update_captions()
            if not update_fields() then
                refresh()
            end
            log:notify(text("load.done"):format(name))
        end
        if profile.is_dirty() then
            menu.show_warning(load_ref, click_type, text("load.unsaved"):format(profile.active_name()), load_profile)
        else
            load_profile()
        end
    end, {}, label("load.help"))

    entry:toggle(label("autosave.name"), function(on)
        profile.set_autosave(name, on)
        update_captions()
    end, {}, label("autosave.help"), profile.is_autosave(name))

    local delete_ref
    delete_ref = entry:action(label("delete.name"), function(click_type)
        if name == "main" then
            log:warn(text("delete.main"))
            return
        end
        menu.show_warning(delete_ref, click_type, text("delete.warning"):format(name), function()
            if profile.delete(name) then
                refresh()
            end
        end)
    end, {}, label("delete.help"))
end

-- refresh() rebuilds the settings section: needed after a profile is created or deleted
function module.profiles(node: table, refresh: function): void
    local profile = Atdar.profile
    local list = node:list(label("title"), { "profiles" }, label("help"))

    list:text_input(label("create.name"), { "profilenew" }, function(value)
        if value ~= "" and profile.create(value) then
            refresh()
        end
    end, label("create.help"))

    list:action(label("open_folder.name"), function()
        util.open_folder(profile.folder())
    end, {}, label("open_folder.help"))

    list:divider(label("list"))
    for _, name in ipairs(profile.list()) do
        build_entry(list, name, refresh)
    end
end

-- ─── Copy Menu To Core ───────────────────────────────────────────────────────

-- Off, then every pack in store; takes effect at the next start (see auto_copy in menu.pluto)
function module.auto_copy(node: table): void
    local options = { label("auto_copy.off") }
    for _, pack in ipairs(view.packs) do
        table.insert(options, pack.name)
    end
    view.auto_copy = node:list_action(auto_copy_caption(), options, function(index)
        local pack = view.packs[index - 1]
        Atdar.profile.set("auto_copy_menu", pack ? pack.folder : "")
        if pack then
            log:notify(text("auto_copy.later"):format(pack.name))
        else
            log:notify(text("auto_copy.disabled"))
        end
    end, { "profileautocopy" }, label("auto_copy.help"))
end

-- ─── Command Box: prefix and separator ───────────────────────────────────────

function module.command_box(node: table): void
    input(node, "command_prefix", true)
    view.separator = node:list_action(separator_caption(),
        { label("separator.none"), label("separator.underscore") }, function(index)
        Atdar.profile.set("command_separator", SEPARATORS[index])
    end, { "profileseparator" }, label("separator.help"))
end

-- ─── Debug Mode ──────────────────────────────────────────────────────────────

function module.debug(node: table): void
    view.debug = node:toggle(label("debug.name"), function(on)
        if not updating then
            Atdar.profile.set("debug", on)
        end
    end, { "profiledebug" }, label("debug.help"), Atdar.profile.get("debug") == true)
end

-- ─── Rename Script ───────────────────────────────────────────────────────────

function module.rename(node: table): void
    local rename_ref
    -- Stand calls the field again while the script stops (after a rename, or any stop);
    -- showing a warning then is an error, so nothing is asked then
    local renaming = false
    rename_ref = node:text_input(label("rename.name"), { "renamescript" }, function(value, click_type)
        if renaming or stopping or value == Atdar.name then
            return
        end
        if not installer.valid_name(value) then
            log:warn(text("rename.invalid"):format(value))
            return
        end
        -- Still possible if Stand stops the script before our on_stop handler runs
        local shown = pcall(menu.show_warning, rename_ref, click_type, text("rename.warning"):format(Atdar.name, value), function()
            renaming = true
            local ok, reason = installer.rename(value)
            if not ok then
                renaming = false
                log:warn(text("rename.failed"):format(reason))
                return
            end
            log:notify(text("rename.done"):format(value, value))
            installer.restart_as(value)
        end)
        if not shown then
            log:debug($"rename to '{value}' not asked: the script is stopping")
        end
    end, label("rename.help"), Atdar.name)
end

return module
