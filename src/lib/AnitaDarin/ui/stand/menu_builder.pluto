local JsonFile = Atdar.loader.load("core/filesystem/json/file")
local Logger = Atdar.loader.load("core/logger")
-- Pack files copied and compared as they are
local plain = Atdar.loader.load("core/filesystem/file")

local log = new Logger("MenuBuilder")

local module = {}

-- @return Decoded JSON, or nil if the file is missing or damaged
local function read_json(path: string): ?table
    return new JsonFile(path):read()
end

-- Item types for build_items: the field named after the type holds the item's name (or the
-- feature id), `required` lists the other fields it needs, `build` creates it in the node.
-- A new type is added here only; check_item and build_items read this table
local ITEM_TYPES = {
    list = {
        build = |node, item, where| -> module.build_items(node:list(item.list, item.commands or {}, item.help or ""),
            item.items or {}, $"{where} > {item.list}"),
    },
    feature = {
        build = function(node, item, where)
            if not Atdar.features.has(item.feature) then
                log:warn($"{where}: unknown feature '{item.feature}', skipped")
                return
            end
            node:add_feature(Atdar.features.get(item.feature), item.name or item.feature,
                item.commands or {}, item.help or "")
        end,
    },
    divider = {
        build = |node, item| -> node:divider(item.divider),
    },
    readonly_name = {
        build = |node, item| -> node:readonly_name(item.readonly_name),
    },
    readonly = {
        build = |node, item| -> node:readonly(item.readonly, item.value or ""),
    },
    hyperlink = {
        required = { "link" },
        build = |node, item| -> node:hyperlink(item.hyperlink, item.link, item.help or ""),
    },
    action = {
        required = { "on_click" },
        build = |node, item| -> node:action(item.action, item.on_click, item.commands or {}, item.help or ""),
    },
    toggle = {
        required = { "on_change" },
        build = |node, item| -> node:toggle(item.toggle, item.on_change, item.commands or {}, item.help or "",
            item.default == true),
    },
    slider = {
        required = { "min", "max", "on_change" },
        build = |node, item| -> node:slider(item.slider, item.min, item.max, item.default or item.min,
            item.step or 1, item.on_change, item.commands or {}, item.help or ""),
    },
    textslider = {
        required = { "options", "on_click" },
        build = |node, item| -> node:text_slider(item.textslider, item.options, item.on_click,
            item.commands or {}, item.help or ""),
    },
    list_action = {
        required = { "options", "on_select" },
        build = |node, item| -> node:list_action(item.list_action, item.options, item.on_select,
            item.commands or {}, item.help or ""),
    },
    text_input = {
        -- Stand takes the text through its command box, so the field can't work without a command
        required = { "on_change", "commands" },
        build = |node, item| -> node:text_input(item.text_input, item.commands or {}, item.on_change,
            item.help or "", item.default or ""),
    },
}

-- Fields any item may have besides its type field; the rest are collected from `required` below
local ITEM_FIELDS = {
    items = true,
    name = true,
    commands = true,
    help = true,
    value = true,
    default = true,
    step = true,
}

-- Sorted type names for messages
local TYPE_NAMES = {}
for type_name, spec in pairs(ITEM_TYPES) do
    ITEM_FIELDS[type_name] = true
    for _, field in ipairs(spec.required or {}) do
        ITEM_FIELDS[field] = true
    end
    table.insert(TYPE_NAMES, type_name)
end
table.sort(TYPE_NAMES)

-- Catches layout typos that are valid Lua and would otherwise be silently skipped
-- @return The item's type name, or nil if the item can't be built
local function check_item(item, where: string): ?string
    if type(item) ~= "table" then
        log:warn($"{where}: item must be a table, got {type(item)}")
        return nil
    end
    for key in pairs(item) do
        if not ITEM_FIELDS[key] then
            log:warn($"{where}: unknown field '{tostring(key)}'")
        end
    end
    if item.items ~= nil and item.list == nil then
        log:warn($"{where}: 'items' belongs to a list item, add list = \"Name\" next to it")
        return nil
    end
    local types = {}
    for _, type_name in ipairs(TYPE_NAMES) do
        if item[type_name] ~= nil then
            table.insert(types, type_name)
        end
    end
    if #types ~= 1 then
        local found = #types == 0 ? "none" : table.concat(types, " and ")
        log:warn($"{where}: item needs exactly one of {table.concat(TYPE_NAMES, ', ')}, found {found}")
        return nil
    end
    local type_name = types[1]
    for _, field in ipairs(ITEM_TYPES[type_name].required or {}) do
        if item[field] == nil then
            log:warn($"{where}: {type_name} item needs '{field}'")
            return nil
        end
    end
    return type_name
end

-- Declarative helper for menu files that prefer describing a submenu as a table:
-- { list = "Name", items = {...} }, { feature = "id", name = "Label" }, { divider = "Text" },
-- { readonly = "Name", value = "..." }, { toggle = "Name", on_change = fn }, { slider = "Name", min = 0, max = 10, on_change = fn }...
-- see ITEM_TYPES for every type and the fields it needs
function module.build_items(node: table, items: table, where: string = "menu"): void
    if type(items) ~= "table" then
        log:warn($"{where}: items must be a table, got {type(items)}")
        return
    end
    -- Only the numbered part is built; a named field here is an item that lost its own braces
    for key in pairs(items) do
        if type(key) ~= "number" then
            log:warn($"{where}: '{tostring(key)}' is not an item, wrap each item in its own table")
        end
    end

    for i, item in ipairs(items) do
        local item_where = $"{where} #{i}"
        local type_name = check_item(item, item_where)
        if type_name then
            ITEM_TYPES[type_name].build(node, item, item_where)
        end
    end
end

-- @return The table a menu file returns, or nil if it's missing or failed
local function load_menu_file(path: string): ?table
    -- Timed (loader.report): compiling and running the file
    local ok, result = Atdar.loader.measure(path, function()
        local chunk, err = loadfile(path)
        if not chunk then
            return false, err
        end
        return pcall(chunk)
    end)
    if not ok then
        log:error($"menu file failed: {path}\n{result}")
        return nil
    end
    if type(result) ~= "table" then
        log:warn($"menu file must return a table: {path}")
        return nil
    end
    return result
end

-- Builds the menu in dir: main.pluto returns { build = function(node, ctx) }.
-- ctx.load(name) returns another menu file from the same dir (loaded once per build)
-- @return Whether main.pluto built without errors
function module.build_menu(node: table, dir: string): bool
    local cache = {}
    local ctx = { dir = dir }
    function ctx.load(name: string): ?table
        if cache[name] == nil then
            cache[name] = load_menu_file($"{dir}{name}.pluto") or false
        end
        return cache[name] or nil
    end

    local main = ctx.load("main")
    if not main or type(main.build) ~= "function" then
        log:warn($"{dir}main.pluto must return a table with build(node, ctx)")
        return false
    end
    local ok, err = pcall(main.build, node, ctx)
    if not ok then
        log:error($"menu build failed in {dir}\n{err}")
    end
    return ok
end

function module.layout_dir(pack_dir: string): string
    return $"{pack_dir}menu\\stand\\"
end

-- @return Info of every folder in packs_dir that has an info.json with a name, sorted by name
function module.find_packs(packs_dir: string): table
    local packs = {}
    for _, path in ipairs(filesystem.list_files(packs_dir)) do
        if filesystem.is_dir(path) then
            local info = read_json($"{path}\\info.json")
            if type(info) == "table" and type(info.name) == "string" then
                info.dir = $"{path}\\"
                -- The pack's id, e.g. for the profile's auto_copy_menu
                info.folder = path:match("([^\\/]+)$")
                table.insert(packs, info)
            end
        end
    end
    table.sort(packs, |a, b| -> a.name < b.name)
    return packs
end

local function collect_pluto_files(dir: string, out: table): void
    for _, path in ipairs(filesystem.list_files(dir)) do
        if filesystem.is_dir(path) then
            collect_pluto_files($"{path}\\", out)
        elseif path:match("%.pluto$") then
            table.insert(out, path)
        end
    end
end

-- @return Paths of all .pluto files in dir and its subfolders, sorted; empty if dir doesn't exist
function module.find_feature_files(dir: string): table
    local files = {}
    if filesystem.is_dir(dir) then
        collect_pluto_files(dir, files)
        table.sort(files)
    end
    return files
end

-- Runs each feature file; a broken file or a taken feature id skips only that file
-- @return Number of files that ran without errors
function module.load_feature_files(files: table): int
    local loaded = 0
    for _, path in ipairs(files) do
        -- Timed (loader.report): compiling and running the file, with the lib files it loads
        local ok, err = Atdar.loader.measure(path, function()
            local chunk, load_err = loadfile(path)
            if not chunk then
                return false, load_err
            end
            return pcall(chunk)
        end)
        if ok then
            loaded += 1
        else
            log:error($"feature file failed: {path}\n{err}")
        end
    end
    return loaded
end

local function copy_file(from: string, to: string): bool
    local content = plain.read(from, true)
    if content == nil then
        return false
    end
    return (plain.write(to, content, true))
end

-- Lists what copy_pack_to_core put into lib, so remove_copied_core can take exactly that out
local function manifest_path(lib_dir: string): string
    return $"{lib_dir}ui\\stand\\menu\\.copied.json"
end

-- @return { pack = name, files = { paths relative to lib } } if the built-in menu came from a copy, else nil
function module.read_core_manifest(lib_dir: string): ?table
    local manifest = read_json(manifest_path(lib_dir))
    if type(manifest) ~= "table" or type(manifest.files) ~= "table" then
        return nil
    end
    return manifest
end

-- Deletes the files a pack copy added to lib, then the manifest itself
-- @return true and the number of deleted files, or false and a reason
function module.remove_copied_core(lib_dir: string): (bool, any)
    local manifest = module.read_core_manifest(lib_dir)
    if not manifest then
        return false, "the built-in menu wasn't copied from a pack"
    end
    local removed = 0
    for _, relative in ipairs(manifest.files) do
        if os.remove($"{lib_dir}{relative}") then
            removed += 1
        end
    end
    new JsonFile(manifest_path(lib_dir)):remove()
    return true, removed
end

-- What copying a pack into the script copies: { from, to } for its features, menu files and translations
local function copy_plan(info: table, lib_dir: string): table
    local plan = {}
    local features_dir = $"{info.dir}features\\"
    for _, path in ipairs(info.feature_files) do
        table.insert(plan, { from = path, to = $"{lib_dir}features\\{path:sub(#features_dir + 1)}" })
    end
    local layout = module.layout_dir(info.dir)
    for _, path in ipairs(module.find_feature_files(layout)) do
        table.insert(plan, { from = path, to = $"{lib_dir}ui\\stand\\menu\\{path:sub(#layout + 1)}" })
    end
    -- The menu's translations, where the built-in menu looks for them
    local language_dir = $"{info.dir}language\\"
    if filesystem.is_dir(language_dir) then
        for _, path in ipairs(filesystem.list_files(language_dir)) do
            if path:match("%.json$") then
                table.insert(plan, { from = path, to = $"{lib_dir}language\\{path:sub(#language_dir + 1)}" })
            end
        end
    end
    return plan
end

-- A file's whole content, nil if it can't be read
local function read_bytes(path: string): ?string
    return plain.read(path, true)
end

-- Whether the copy of this pack in the script is the same as the pack: the same files, each with the
-- same content. Then copying again would change nothing and can be skipped
function module.core_copy_is_current(info: table, lib_dir: string): bool
    local manifest = module.read_core_manifest(lib_dir)
    if not manifest or manifest.pack ~= info.name then
        return false
    end
    local plan = copy_plan(info, lib_dir)
    if #plan ~= #manifest.files then
        return false
    end
    local listed = {}
    for _, relative in ipairs(manifest.files) do
        listed[relative] = true
    end
    for _, step in ipairs(plan) do
        if not listed[step.to:sub(#lib_dir + 1)] then
            return false
        end
        local copied = read_bytes(step.to)
        if copied == nil or copied ~= read_bytes(step.from) then
            return false
        end
    end
    return true
end

-- Copies a pack's features and menu files into the script, where they become the built-in menu.
-- Nothing is overwritten: if any target file exists, nothing is copied
-- @return true and the number of copied files, or false and a reason
function module.copy_pack_to_core(info: table, lib_dir: string): (bool, any)
    if module.read_core_manifest(lib_dir) then
        return false, "another copied menu is already in the script, remove it first"
    end
    local plan = copy_plan(info, lib_dir)

    local conflicts = 0
    for _, step in ipairs(plan) do
        if filesystem.exists(step.to) then
            conflicts += 1
        end
    end
    if conflicts > 0 then
        return false, $"{conflicts} file(s) already exist in the script"
    end

    local copied = {}
    for _, step in ipairs(plan) do
        if not copy_file(step.from, step.to) then
            -- Don't leave a half-copied menu behind
            for _, path in ipairs(copied) do
                os.remove(path)
            end
            return false, $"failed to copy {step.from}"
        end
        table.insert(copied, step.to)
    end

    local relative = {}
    for _, path in ipairs(copied) do
        table.insert(relative, path:sub(#lib_dir + 1))
    end
    -- Without the manifest the copy couldn't be removed later, so a failed write undoes it
    if not new JsonFile(manifest_path(lib_dir)):write({ pack = info.name, files = relative }) then
        for _, path in ipairs(copied) do
            os.remove(path)
        end
        return false, "couldn't save the list of copied files"
    end
    return true, #plan
end

-- @return Packs that have a Stand menu, each with feature_files filled in
function module.find_loadable_packs(packs_dir: string): table
    local packs = {}
    for _, info in ipairs(module.find_packs(packs_dir)) do
        if filesystem.exists($"{module.layout_dir(info.dir)}main.pluto") then
            info.feature_files = module.find_feature_files($"{info.dir}features\\")
            table.insert(packs, info)
        end
    end
    return packs
end

return module
