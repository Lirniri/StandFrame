local load = Atdar.loader.load
local MenuNode = load("ui/stand/core/menu_node")
local builder = load("ui/stand/core/menu_builder")
local settings = load("ui/stand/core/settings")
local script_menu = load("ui/stand/script/section")
local i18n = load("core/i18n")
local Logger = load("core/logger")
local commands = load("ui/stand/core/commands")
local JsonFile = load("core/filesystem/json/file")
local features = Atdar.features
local paths = Atdar.filesystem.paths

local log = new Logger("Menu")

local PACKS_DIR = $"{paths.store}menu\\"
-- Built-in menu has the same shape as a pack: main.pluto here, features in lib features/
local BUILTIN_MENU_DIR = $"{paths.lib}ui\\stand\\menu_from_store\\"

local module = {}

module.root = new MenuNode(menu.my_root())

-- @return Built-in feature files: everything in the category folders of lib features/.
-- Top-level files there (Feature, registry) are the core, not features
local function find_builtin_features(): table
    local files = {}
    local dir = $"{paths.lib}features\\"
    if not filesystem.is_dir(dir) then
        return files
    end
    for _, path in ipairs(filesystem.list_files(dir)) do
        if filesystem.is_dir(path) then
            for _, file in ipairs(builder.find_feature_files($"{path}\\")) do
                table.insert(files, file)
            end
        end
    end
    table.sort(files)
    return files
end

-- Checked on demand: copying a pack to core can add a built-in menu while the script runs
local function has_builtin(): bool
    return filesystem.exists($"{BUILTIN_MENU_DIR}main.pluto")
end

-- Everything the loaded menu added (items, features, settings), so it can be taken out again
local current = nil
-- Divider shown while no menu is loaded and there's no built-in one; gone once a menu loads
local notice = nil

-- Made before the settings section is (re)built, so it stays above it. key: its string,
-- "not found" by default, "unloaded" after Unload while a built-in menu is there.
-- i18n directly: label()/text() of this file are declared further down
local function show_notice(key: string = "menu_loader.not_found"): void
    if notice then
        pcall(menu.set_menu_name, notice, i18n.label(key))
    else
        notice = module.root:divider(i18n.label(key))
    end
end

local function unload_current(): void
    if not current then
        return
    end
    -- Settings first: the menu may have hosted them in one of its own lists (settings.set_parent),
    -- and clearing that list would leave module.settings pointing at deleted items
    if module.settings then
        settings.remove(module.settings)
        module.settings = nil
    end
    -- Then items: switching their toggles off disables features the normal way, through Stand
    current.node:clear()
    for _, id in ipairs(current.feature_ids) do
        features.remove(id)
    end
    settings.restore(current.settings_mark)
    i18n.remove_source(current.strings)
    current = nil
end

-- Stand only appends, so anything built after settings lands below them; recreate them at the bottom
local function rebuild_settings(): void
    if module.settings then
        settings.remove(module.settings)
    end
    module.settings = settings.build(module.root)
end

-- Replaces the loaded menu: adds its translations (language_dir), runs feature_files,
-- then build(node) adds the items. kind ("builtin" or "pack") tells later whether the built-in menu is loaded;
-- menu_dir: the menu's folder, where its commands folder (custom command names and words) is: the pack's in store,
-- or the built-in menu's in core; pack: the pack's folder name, so Load Menu can show which pack is loaded
local function load_menu(kind: string, language_dir: string, feature_files: table, build: function, menu_dir: string,
        pack: ?string): void
    if notice then
        menu.delete(notice)
        notice = nil
    end
    unload_current()

    -- Before features and items, so both can already use the menu's strings
    local strings = i18n.add_source(language_dir)
    local ids_before = features.ids()
    local settings_mark = settings.mark()
    local loaded = builder.load_feature_files(feature_files)
    if loaded < #feature_files then
        log:warn($"ran {loaded} of {#feature_files} feature file(s)")
    end

    -- A separate node on the root ref tracks only this menu's items; their custom names apply as they're made
    commands.begin_menu(menu_dir)
    local node = new MenuNode(module.root.handle)
    local built, err = pcall(build, node)
    commands.end_menu()
    if not built then
        log:error($"menu build failed: {err}")
    end

    local feature_ids = {}
    for id in pairs(features.ids()) do
        if not ids_before[id] then
            table.insert(feature_ids, id)
        end
    end
    current = { kind = kind, pack = pack, node = node, feature_ids = feature_ids, settings_mark = settings_mark, strings = strings }
    -- Stand applies the active profile only to items created during the script's main body,
    -- so a menu loaded later by hand starts without the profile's states
    rebuild_settings()
end

local function load_builtin(): void
    load_menu("builtin", builder.core_language_dir(paths.store), find_builtin_features(),
        |node| -> builder.build_menu(node, BUILTIN_MENU_DIR), BUILTIN_MENU_DIR)
end

local function load_pack(info: table): void
    load_menu("pack", $"{info.dir}language\\", info.feature_files,
        |node| -> builder.build_menu(node, builder.layout_dir(info.dir)), info.dir, info.folder)
end

-- Load Menu > Unload: takes the loaded menu out. Like a start without a menu, the root then says so;
-- Load Menu brings one back
local function unload_menu(): void
    if not current then
        log:notify(i18n.text("script_menu.unload.nothing"))
        return
    end
    unload_current()
    show_notice(has_builtin() ? "script_menu.unload.notice" : "menu_loader.not_found")
    rebuild_settings()
    -- The script's notifications in the game's feed go too; "Menu unloaded" is then the only one
    pcall(|| -> Atdar.natives.visual.hud.thefeed.remove_all())
    log:notify(i18n.text("script_menu.unload.done"))
end

local function copy_pack(info: table): void
    local ok, result = builder.copy_pack_to_core(info, paths.lib, paths.store)
    if not ok then
        log:warn($"'{info.name}' not copied: {result}")
        return
    end
    log:notify($"'{info.name}': copied {result} file(s) to core and loaded it as the built-in menu")
    load_builtin()
end


-- Opens the pack's folder in Windows Explorer
local function open_menu_folder(info: table): void
    util.open_folder(info.dir.. "menu")
end
local function open_features_folder(info: table): void
    util.open_folder(info.dir.. "features")
end


-- Takes a copied pack back out of the script; unloads it first if it's the loaded menu
local function remove_builtin(): void
    if current and current.kind == "builtin" then
        unload_current()
    end
    local ok, result = builder.remove_copied_core(paths.lib, paths.store)
    if ok then
        log:notify(i18n.text("menu_loader.builtin.removed"):format(result))
        -- Otherwise the copy silently comes back at the next start
        if (Atdar.profile.get("auto_copy_menu") or "") ~= "" then
            -- i18n directly: label()/text() of this file are declared further down
            log:notify(i18n.text("menu_loader.builtin.auto_copy_again"))
        end
    else
        log:warn($"nothing removed: {result}")
    end
    -- No menu left: the same notice as a start without a built-in menu
    if not current and not has_builtin() then
        show_notice()
    end
    -- Refreshes Load Menu so the built-in entry disappears
    rebuild_settings()
end

-- Strings of the independent menu live in store/AnitaDarin/base/language/ under "menu_loader".
-- label(): Stand label for item names and help, shown in Stand's language;
-- text(): ready string in Stand's current language, for strings filled with format()
-- Strings under "menu_loader"
local label, text = i18n.scope("menu_loader")

local function pack_options(): table
    return { label("options.load"), label("options.copy_to_core"), label("options.open_menu_folder"), label("options.open_features_folder") }
end

local function copied_builtin_options(): table
    return { label("options.load"), label("options.remove_from_core") }
end

-- "AnitaDarin: loaded, in core" - a menu's name with its state, or just the name
local function with_state(name: string, loaded: bool, in_core: bool): string
    local states = {}
    if loaded then
        table.insert(states, text("state.loaded"))
    end
    if in_core then
        table.insert(states, text("state.in_core"))
    end
    if #states == 0 then
        return name
    end
    return text("state.name"):format(name, table.concat(states, ", "))
end

-- A pack's command: menuloader and its folder, lower case, letters and digits only
-- ("Example Pack" -> "menuloaderexamplepack")
local function pack_command(info: table): string
    local word = info.folder:lower():gsub("[^%w]", "")
    return $"menuloader{word}"
end

-- Adds an entry per available menu: the built-in one (if any) and every pack in store, with their state.
-- The section is rebuilt after every load and unload, so the states are always current
local function fill_picker(node: table): void
    local builtin = has_builtin()
    local manifest = builtin and builder.read_core_manifest(paths.lib)
    -- A copied built-in menu sits above the divider, apart from the menus it can be replaced with
    if not manifest then
        node:divider(label("menus"))
    end
    if builtin then
        local name = with_state(text("builtin.name"):format(Atdar.profile.get("display_name") or Atdar.name),
            current and current.kind == "builtin", false)
        if manifest then
            node:list_action(name, copied_builtin_options(), function(index)
                if index == 1 then
                    load_builtin()
                else
                    remove_builtin()
                end
            end, { "menuloaderbuiltin" }, text("builtin.copied_help"):format(manifest.pack))
            node:divider(label("menus"))
        else
            node:action(name, load_builtin, { "menuloaderbuiltin" }, label("builtin.help"))
        end
    end
    local packs = builder.find_loadable_packs(PACKS_DIR)
    for _, info in ipairs(packs) do
        local version = info.version or text("pack.unknown_version")
        local author = info.author or text("pack.unknown_author")
        local help = text("pack.help"):format(version, author) .. "\n" .. text("pack.options_help")
        local loaded = current and current.kind == "pack" and current.pack == info.folder
        local in_core = manifest and manifest.pack == info.name
        node:list_action(with_state(info.name, loaded, in_core), pack_options(), function(index)
            if index == 1 then
                load_pack(info)
            elseif index == 2 then
                copy_pack(info)
            elseif index == 3 then
                open_menu_folder(info)
            elseif index == 4 then
                open_features_folder(info)
            end
        end, { pack_command(info) }, help)
    end
    if not builtin and #packs == 0 then
        node:divider(label("no_menus"))
    end
end

-- The script's own section (script_menu lays it out). Added before any menu loads,
-- so unloading a menu never drops it
settings.add(function(node)
    script_menu.build(node, {
        refresh = rebuild_settings,
        packs = builder.find_loadable_packs(PACKS_DIR),
        fill_menus = fill_picker,
        unload = unload_menu,
    })
end)

-- The active profile can keep a pack copied into core (its auto_copy_menu). At every start the pack is
-- copied again when it changed, so changes made to it in store reach the copy (an unchanged one is
-- left as it is: nothing to write), and then loads as the built-in menu.
-- Built here, in the script's main body, its items get the states saved in Stand's profile,
-- which a menu loaded later by hand doesn't
local function auto_copy(): void
    local id = Atdar.profile.get("auto_copy_menu")
    if type(id) ~= "string" or id == "" then
        return
    end
    local info = nil
    for _, pack in ipairs(builder.find_loadable_packs(PACKS_DIR)) do
        if pack.folder == id then
            info = pack
            break
        end
    end
    if not info then
        log:warn($"menu '{id}' to copy to core isn't in store")
        return
    end
    local manifest = builder.read_core_manifest(paths.lib)
    -- A built-in menu that wasn't copied from a pack belongs to the script: never replaced
    if has_builtin() and not manifest then
        log:warn($"menu '{id}' not copied to core: the script has its own built-in menu")
        return
    end
    if manifest and builder.core_copy_is_current(info, paths.lib, paths.store) then
        log:info($"'{info.name}' in core is the same as in store, not copied again")
        return
    end
    if manifest then
        builder.remove_copied_core(paths.lib, paths.store)
    end
    local ok, result = builder.copy_pack_to_core(info, paths.lib, paths.store)
    if ok then
        log:info($"'{info.name}' copied to core ({result} file(s))")
    else
        log:warn($"'{info.name}' not copied to core: {result}")
    end
end

auto_copy()

if has_builtin() then
    load_builtin()
else
    -- The root says so itself (show_notice): in the log only, no notification on top of it
    log:info("built-in menu not found, a menu can be loaded from store")
    show_notice()
    module.settings = settings.build(module.root)
end

return module
