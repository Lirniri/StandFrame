local globals = Atdar.globals
local Feature = Atdar.loader.load("features/feature")
-- Capitalized: methods below take a `commands` parameter with the item's base command names
local Commands = Atdar.loader.load("ui/stand/commands")
local menu_utils = Atdar.loader.load("utils/menu")

-- Stand item for each Feature kind; names and help may be Stand labels (int) from i18n
local ITEM_FOR_KIND = {

    loop = function(handle, feature: table, name: string|int, commands: table, help: string|int)
        return menu.toggle_loop(handle, name, commands, help,
            function() feature:tick() end,
            function() feature:disable() end)
    end,

    toggle = function(handle, feature: table, name: string|int, commands: table, help: string|int)
        return menu.toggle(handle, name, commands, help, function(on)
            if on then
                feature:enable()
            else
                feature:disable()
            end
        end)
    end,

    action = function(handle, feature: table, name: string|int, commands: table, help: string|int)
        return menu.action(handle, name, commands, help,
            function() feature:trigger() end)
    end,

}

-- A kind added to Feature.KINDS without a menu item would only fail once some feature uses it
for kind in pairs(Feature.KINDS) do
    if not ITEM_FOR_KIND[kind] then
        error($"[MenuNode] no menu item for feature kind '{kind}'")
    end
end

-- Feature kinds whose menu item is an on/off toggle
local TOGGLE_KINDS = { loop = true, toggle = true }

-- Ticks to wait after switching toggles off, so Stand's toggle_loop threads see it and stop
local STOP_TICKS = 2

-- Declared first and assigned explicitly so methods can reference MenuNode:
-- neither `local class` nor `class` on a forward-declared local binds it inside the body in Stand's Pluto
local MenuNode

-- Wraps a Stand command ref and creates child items in it.
-- Several nodes may wrap the same ref: each one tracks only the items created through it
MenuNode = class

    function __construct(handle)
        globals.pluto.class.fix_index(self)

        self.handle = handle
        self.children = {}
        self.sublists = {}
        self.toggles = {}
    end

    -- commands: the item's base command names, so they can be renamed when the prefix settings change
    function track(child_handle, commands: table = {})
        table.insert(self.children, child_handle)
        Commands.track(child_handle, commands)
        return child_handle
    end

    -- Forgets every item in this node and its sublists in Commands, before they're deleted
    function untrack_commands(): void
        for _, child_handle in ipairs(self.children) do
            Commands.untrack(child_handle)
        end
        for _, sublist in ipairs(self.sublists) do
            sublist:untrack_commands()
        end
    end

    -- Switches off every toggle in this node and its sublists, then waits for Stand to stop them.
    -- A toggle_loop deleted while on keeps ticking in Stand and fails with "CommandRef is not valid"
    function stop_toggles(): void
        local stopped = false
        local function stop_in(node)
            for _, ref in ipairs(node.toggles) do
                if menu.get_value(ref) then
                    menu.set_value(ref, false)
                    stopped = true
                end
            end
            for _, sublist in ipairs(node.sublists) do
                stop_in(sublist)
            end
        end
        stop_in(self)
        if stopped then
            for _ = 1, STOP_TICKS do
                util.yield()
            end
        end
    end

    function divider(text: string|int)
        return self:track(menu.divider(self.handle, text))
    end

    -- "Name: value" line; change the value later with menu.set_value(ref, "...")
    function readonly(name: string|int, value: string = "")
        return self:track(menu.readonly(self.handle, name, value))
    end

    -- Text-only line, like a divider but in the normal item style
    function readonly_name(name: string|int)
        return self:track(menu.readonly_name(self.handle, name))
    end

    -- Opens the link in the browser when clicked
    function hyperlink(name: string|int, link: string, help: string|int = "")
        return self:track(menu.hyperlink(self.handle, name, link, help))
    end

    -- on_back(): Stand calls it when the user goes back out of the list (optional; no "= nil" default:
    -- that shifts Pluto's other defaults)
    function list(name: string|int, commands: table = {}, help: string|int = "", on_back): table
        local child = new MenuNode(menu.list(self.handle, name, Commands.names(commands), help, nil, on_back))
        self:track(child.handle, commands)
        table.insert(self.sublists, child)
        return child
    end

    -- Removes this node and everything in it from the Stand menu
    function delete(): void
        self:stop_toggles()
        self:untrack_commands()
        Commands.untrack(self.handle)
        menu.delete(self.handle)
    end

    -- Removes the items from the index-th on (in the order they were made), leaving the ones before:
    -- a part of a list made again (e.g. a module's functions after its code is reloaded)
    function clear_from(index: int): void
        local removed = {}
        for i = #self.children, index, -1 do
            removed[self.children[i]] = true
        end
        -- Toggles switched off first: one deleted while on keeps ticking in Stand
        for i = #self.toggles, 1, -1 do
            local ref = self.toggles[i]
            if removed[ref] then
                if menu.get_value(ref) then
                    menu.set_value(ref, false)
                end
                table.remove(self.toggles, i)
            end
        end
        for i = #self.sublists, 1, -1 do
            local sublist = self.sublists[i]
            if removed[sublist.handle] then
                sublist:untrack_commands()
                table.remove(self.sublists, i)
            end
        end
        for i = #self.children, index, -1 do
            local child_handle = table.remove(self.children, i)
            Commands.untrack(child_handle)
            menu.delete(child_handle)
        end
    end

    -- Removes every item created through this node, leaving the node itself
    function clear(): void
        self:stop_toggles()
        self:untrack_commands()
        for _, child_handle in ipairs(self.children) do
            menu.delete(child_handle)
        end
        self.children = {}
        self.sublists = {}
        self.toggles = {}
    end

    -- List of options where picking one calls on_select(index, option_name, click_type)
    function list_action(name: string|int, options: table, on_select: function, commands: table = {}, help: string|int = "")
        return self:track(menu.list_action(self.handle, name, Commands.names(commands), help, options, on_select), commands)
    end

    -- Text field; on_change(value, click_type) runs when the user enters text.
    -- Stand takes the text through its command box, so the field needs command names
    function text_input(name: string|int, commands: table, on_change: function, help: string|int = "", default: string = "")
        return self:track(menu.text_input(self.handle, name, Commands.names(commands), help, on_change, default), commands)
    end

    -- Plain button that isn't backed by a feature
    function action(name: string|int, on_click: function, commands: table = {}, help: string|int = "")
        return self:track(menu.action(self.handle, name, Commands.names(commands), help, on_click), commands)
    end

    -- Plain on/off switch that isn't backed by a feature; on_change(on, click_type).
    -- Stand calls it only on a change, so nothing keeps running and it needn't be stopped on delete
    function toggle(name: string|int, on_change: function, commands: table = {}, help: string|int = "", default: bool = false)
        return self:track(menu.toggle(self.handle, name, Commands.names(commands), help, on_change, default), commands)
    end

    -- Number picker; on_change(value, prev_value, click_type)
    function slider(name: string|int, min: int, max: int, default: int, step: int, on_change: function, commands: table = {}, help: string|int = "")
        return self:track(menu.slider(self.handle, name, Commands.names(commands), help,
            min, max, default, step, on_change), commands)
    end

    -- Colour picker (utils/menu.color); default { r, g, b, a } 0.0 - 1.0; on_change(colour, click_type).
    -- transparency adds Opacity
    function color(name: string|int, default: table, on_change: function, commands: table = {}, help: string|int = "",
            transparency: bool = false)
        return self:track(menu_utils.color(self.handle, name, Commands.names(commands), help, default, on_change,
            transparency), commands)
    end

    -- Options picked with left/right, without a submenu; on_click(index, option_name, click_type)
    function text_slider(name: string|int, options: table, on_click: function, commands: table = {}, help: string|int = "")
        return self:track(menu.textslider(self.handle, name, Commands.names(commands), help, options, on_click), commands)
    end

    function add_feature(feature: table, name: string|int, commands: table = {}, help: string|int = "")
        local create = ITEM_FOR_KIND[feature.kind]
        if not create then
            error($"[MenuNode] unknown kind '{feature.kind}' for feature '{feature.id}'")
        end
        local ref = self:track(create(self.handle, feature, name, Commands.names(commands), help), commands)
        if TOGGLE_KINDS[feature.kind] then
            table.insert(self.toggles, ref)
            -- A failed feature is switched off; its toggle follows. The ref may be deleted by then
            feature:set_failure_handler(function()
                pcall(menu.set_value, ref, false)
            end)
        end
        return ref
    end

end

return MenuNode
