-- Modules list in the script's settings section, shown only in debug mode: each module a list with its
-- status, deps and error, Start / Restart / Stop / Reload, and under the Functions divider the module's own
-- functions to call by hand (Module.functions_of): a button for one without parameters, a text field for
-- one with, the arguments separated by commas. Strings live in language/base under "modules".
-- Restart runs the same module again; Reload re-reads its file, so code changes apply
--
-- The list's items are made when it's opened and removed when the user goes back out of it, so nothing
-- of it is in the menu while no one looks. In the script's settings the list shows in debug mode only; it's
-- always made and only hidden: rebuilding the section when debug is switched would delete the Profile list
-- the user is in, which Stand doesn't do cleanly.
--
-- Into other menus (a pack's lists), made the same way, only while open:
--     modules_menu.list_in(node)                     -- the whole Modules list
--     modules_menu.module_in(node, "VehicleManager")  -- one module's list: status, actions, functions

local i18n = Atdar.loader.load("core/i18n")
local Logger = Atdar.loader.load("core/logger")
local Module = Atdar.loader.load("core/module")
local commands = Atdar.loader.load("ui/stand/commands")

local log = new Logger("Modules")

local module = {}

local function label(key: string): int
    return i18n.label($"modules.{key}")
end

local function text(key: string): string
    return i18n.text($"modules.{key}")
end

-- The open Modules list's items: list (the MenuNode), entries / statuses / sections per module name.
-- Empty while no Modules list is open
local view = {}
-- The place in the script's settings (build): the "Debug" divider, the list, items added with debug_only()
local place = {}
-- Debug mode, as the profile last said
local debug_mode = Atdar.debug == true

-- Module name -> its on_tick run by hand going on (see "on_tick by hand" below)
local manual_ticks = {}
-- Stops the module's on_tick run by hand; set below, with the runs
local stop_manual_tick
-- Ends the loops of the module's functions (nil: of every module); set below, with the loops
local stop_function_loops

-- The module's number: its place in the registration order, from 1 (0 if it's gone)
local function number_of(name: string): int
    for i, other in ipairs(Atdar.modules.names()) do
        if other == name then
            return i
        end
    end
    return 0
end

-- "Module 1": how notices name a module, short so they fit the game's feed
local function short_name(name: string): string
    return text("entry.short"):format(number_of(name))
end

-- "1: VehicleManager: running", and "· file changed" when its file differs from the code running
local function caption(mod: table): string
    local name = text("entry.name"):format(number_of(mod.name), mod.name, text($"status.{mod.status}"))
    if Atdar.modules.file_changed(mod.name) then
        return $"{name} {text("entry.changed")}"
    end
    return name
end

-- "Status: running", the divider on top of a module's list
local function status_line(mod: table): string
    if manual_ticks[mod.name] ~= nil then
        return text("entry.status_line"):format(text("status.manual"))
    end
    return text("entry.status_line"):format(text($"status.{mod.status}"))
end

local function help(mod: table): string
    local deps = #mod.deps > 0 ? table.concat(mod.deps, ", ") : text("entry.no_deps")
    local lines = {
        text("entry.deps"):format(deps),
        text(mod:has_tick() ? "entry.ticks" : "entry.no_tick"),
    }
    if mod.error then
        table.insert(lines, text("entry.error"):format(mod.error))
    end
    return table.concat(lines, "\n")
end

-- Statuses also change on their own (a module can fail in its tick), so Refresh and every action
-- update all entries. The refs may belong to a section that was already removed: a failed update is skipped
local function refresh(): void
    local modules = Atdar.modules
    for name, ref in pairs(view.entries or {}) do
        if modules.has(name) then
            local mod = modules.get(name)
            pcall(menu.set_menu_name, ref, caption(mod))
            pcall(menu.set_help_text, ref, help(mod))
            local status_ref = (view.statuses or {})[name]
            if status_ref ~= nil then
                pcall(menu.set_menu_name, status_ref, status_line(mod))
            end
        end
    end
end

-- The "Debug" divider, the settings' Modules list and the items added with debug_only() show in debug mode
local function update_visibility(): void
    local refs = { place.divider, place.list and place.list.handle }
    for _, ref in ipairs(place.extra or {}) do
        table.insert(refs, ref)
    end
    for _, ref in pairs(refs) do
        pcall(menu.set_visible, ref, debug_mode)
    end
end

-- Puts an item made after build() under the "Debug" divider's visibility: shown only in debug mode
function module.debug_only(ref): void
    place.extra ??= {}
    table.insert(place.extra, ref)
    pcall(menu.set_visible, ref, debug_mode)
end


-- Options shown for each module, in this order: label key and what it does with the module
local ACTIONS = {
    { key = "start", run = |name| -> Atdar.modules.start_module(name) },
    { key = "restart", run = function(name)
        stop_manual_tick(name)
        stop_function_loops(name)
        Atdar.modules.stop_module(name)
        Atdar.modules.start_module(name)
    end },
    { key = "stop", run = function(name)
        stop_manual_tick(name)
        stop_function_loops(name)
        Atdar.modules.stop_module(name)
    end },
    { key = "reload", run = function(name)
        stop_manual_tick(name)
        stop_function_loops(name)
        Atdar.modules.reload_module(name)
    end },
}

-- The same, by key
local ACTIONS_BY_KEY = {}
for _, action in ipairs(ACTIONS) do
    ACTIONS_BY_KEY[action.key] = action
end

-- ─── Calling a module's functions ────────────────────────────────────────────

-- One argument as typed: nil, true, false, a number, otherwise the text itself
local function value_of(raw: string)
    if raw == "nil" then
        return nil
    end
    if raw == "true" then
        return true
    end
    if raw == "false" then
        return false
    end
    local number = tonumber(raw)
    if number ~= nil then
        return number
    end
    return raw
end

-- 'adder, 5, true, "a, b"' -> "adder", 5, true, "a, b": split by commas, a quoted text kept whole
-- (quotes "" or ''), spaces around each argument dropped. For what isn't a Lua expression (see parse_args)
-- @return The arguments and how many there are (nil ones count too)
local function split_args(input: string)
    local args, count = {}, 0
    local i, len = 1, #input
    while i <= len do
        local c = input:sub(i, i)
        if c:match("%s") then
            i += 1
        elseif c == '"' or c == "'" then
            local close = input:find(c, i + 1, true) or (len + 1)
            count += 1
            args[count] = input:sub(i + 1, close - 1)
            local comma = input:find(",", close + 1, true)
            i = comma ~= nil ? comma + 1 : len + 1
        else
            local comma = input:find(",", i, true)
            local stop = comma ~= nil ? comma - 1 : len
            count += 1
            args[count] = value_of(input:sub(i, stop):match("^%s*(.-)%s*$"))
            i = stop + 2
        end
    end
    return args, count
end

-- ─── Reading the arguments as expressions ────────────────────────────────────
-- Stand's Lua has no load, so the expressions are read here. Understood: nil, true, false, numbers
-- (5, -2.5, 0x1F), "text" / 'text', names the script sees (natives, entities, Atdar, v3, ...) with .field,
-- :method(...) and calls (...) after them. A bare word that names nothing is its own text: adder -> "adder".
-- The reader is a table { src, pos }; what isn't an expression is thrown as { unreadable = why }

local KEYWORDS = { ["nil"] = { n = 1 }, ["true"] = { n = 1, true }, ["false"] = { n = 1, false } }

local function unreadable(reader: table, why: string): void
    error({ unreadable = $"{why} at {reader.pos}" }, 0)
end

-- The next character that isn't a space ("" at the end), without taking it
local function peek(reader: table): string
    reader.pos = reader.src:find("%S", reader.pos) or (#reader.src + 1)
    return reader.src:sub(reader.pos, reader.pos)
end

-- Takes a name (letters, digits, _) if one is next
local function take_name(reader: table): ?string
    peek(reader)
    local name = reader.src:match("^[%a_][%w_]*", reader.pos)
    if name ~= nil then
        reader.pos += #name
    end
    return name
end

-- Takes the name after '.' or ':'
local function need_name(reader: table, after: string): string
    local name = take_name(reader)
    if name == nil then
        unreadable(reader, $"a name expected after '{after}'")
    end
    return name
end

local read_list

-- One expression; its values packed (a call may give several, nil ones too)
local function read_expr(reader: table): table
    local c = peek(reader)
    if c == '"' or c == "'" then
        local close = reader.src:find(c, reader.pos + 1, true)
        if close == nil then
            unreadable(reader, "unclosed text")
        end
        local value = reader.src:sub(reader.pos + 1, close - 1)
        reader.pos = close + 1
        return { n = 1, value }
    end

    local number_text = reader.src:match("^%-?%.?%d[%w%.]*", reader.pos)
    if number_text ~= nil then
        local number = tonumber(number_text)
        if number == nil then
            unreadable(reader, $"'{number_text}' isn't a number")
        end
        reader.pos += #number_text
        return { n = 1, number }
    end

    local name = take_name(reader)
    if name == nil then
        unreadable(reader, $"unexpected '{c}'")
    end
    if KEYWORDS[name] ~= nil then
        return KEYWORDS[name]
    end
    local values = { n = 1, _G[name] }
    local next_c = peek(reader)
    if values[1] == nil then
        if next_c ~= "." and next_c ~= ":" and next_c ~= "(" then
            return { n = 1, name }
        end
        error($"'{name}' isn't known", 0)
    end

    -- .field, :method(...), (...)
    while true do
        next_c = peek(reader)
        if next_c == "." then
            reader.pos += 1
            local field = need_name(reader, ".")
            values = { n = 1, values[1][field] }
        elseif next_c == ":" then
            reader.pos += 1
            local method = need_name(reader, ":")
            if peek(reader) ~= "(" then
                unreadable(reader, "'(' expected after a method")
            end
            reader.pos += 1
            local target = values[1]
            local args, count = read_list(reader, ")")
            values = table.pack(target[method](target, table.unpack(args, 1, count)))
        elseif next_c == "(" then
            reader.pos += 1
            local args, count = read_list(reader, ")")
            values = table.pack(values[1](table.unpack(args, 1, count)))
        else
            return values
        end
    end
end

-- Expressions separated by commas up to close (")", or "" for the end of the text), close taken too.
-- As in Lua, only the last one gives all its values, the others their first
-- @return The values and how many there are
read_list = function(reader, close)
    local args, count = {}, 0
    if peek(reader) == close then
        reader.pos += 1
        return args, count
    end
    while true do
        local values = read_expr(reader)
        local c = peek(reader)
        if c == "," then
            count += 1
            args[count] = values[1]
            reader.pos += 1
        elseif c == close then
            for i = 1, values.n do
                args[count + i] = values[i]
            end
            reader.pos += 1
            return args, count + values.n
        else
            unreadable(reader, close == "" ? "',' expected" : $"',' or '{close}' expected")
        end
    end
end

-- The arguments as typed, read as expressions separated by commas: numbers, true, false, nil, "text",
-- calls (entities.get_user_vehicle_as_handle(), PLAYER.PLAYER_PED_ID()), vectors (v3.new(1, 2, 3)).
-- A bare word is its own text: adder -> "adder". What isn't an expression at all (hello world) is split
-- by commas into texts instead
-- @return The arguments, how many there are (nil ones count too), and the error if working one out failed
function module.parse_args(input: string)
    local ok, args, count = pcall(read_list, { src = input, pos = 1 }, "")
    if ok then
        return args, count, nil
    end
    if type(args) == "table" and args.unreadable ~= nil then
        local texts, texts_count = split_args(input)
        return texts, texts_count, nil
    end
    return {}, 0, tostring(args)
end

-- "create(model, coords, heading)"
local function signature(fn: table): string
    local params = table.concat(fn.params, ", ")
    if fn.vararg then
        params = params == "" ? "..." : $"{params}, ..."
    end
    return $"{fn.name}({params})"
end

-- ─── Showing what a call gave ────────────────────────────────────────────────

-- File path -> its lines, or false if it can't be read; read once
local source_lines = {}

local function lines_of(path: string)
    if source_lines[path] == nil then
        local lines = false
        local file = io.open(path, "r")
        if file ~= nil then
            lines = {}
            for line in file:lines() do
                table.insert(lines, line)
            end
            file:close()
        end
        source_lines[path] = lines
    end
    return source_lines[path]
end

-- The return type written after a function's parameters ("function name(a, b): bool" -> "bool").
-- Type hints are gone once the code runs, so it's read from the file at the line the function starts;
-- the parameters may take a few lines
-- @return The type, or nil if none is written or the file can't be read (lambdas have none)
local function return_type(fn): ?string
    local info = debug.getinfo(fn, "S")
    if info.what ~= "Lua" or info.source:sub(1, 1) ~= "@" or info.linedefined < 1 then
        return nil
    end
    local lines = lines_of(info.source:sub(2))
    if not lines then
        return nil
    end
    local joined = ""
    for i = info.linedefined, math.min(info.linedefined + 5, #lines) do
        joined ..= lines[i] .. " "
        local after = joined:match("function[^(]*%b()(.*)")
        if after ~= nil then
            return after:match("^%s*:%s*([%w_?|%.]+)")
        end
    end
    return nil
end

-- "function(amount, note): void"; a method's self left out, "function(...)" when nothing is known
local function function_text(fn): string
    local info = debug.getinfo(fn, "u")
    local params = {}
    for i = 1, info.nparams do
        local name = debug.getlocal(fn, i)
        if i ~= 1 or name ~= "self" then
            table.insert(params, name)
        end
    end
    if info.isvararg then
        table.insert(params, "...")
    end
    local params_text = table.concat(params, ", ")
    local returns = return_type(fn)
    if returns == nil then
        return $"function({params_text})"
    end
    return $"function({params_text}): {returns}"
end

-- Items shown of one table; the rest is "..."
local MAX_ITEMS = 20
-- Tables inside tables shown this deep; deeper ones are "{...}"
local MAX_DEPTH = 3

local describe

-- A value inside a table: a text in quotes, so "1" and 1 differ
local function describe_item(value, depth: int, seen: table): string
    if type(value) == "string" then
        return $"\"{value}\""
    end
    return describe(value, depth, seen)
end

-- A value as text: a table unpacked ({1, 2}, {"a", "b"}, {name = "x", [5] = true}), a function as its
-- signature, the rest by tostring. seen: the tables being shown, so one inside itself is "{...}"
describe = function(value, depth, seen)
    local kind = type(value)
    if kind == "function" then
        return function_text(value)
    end
    if kind ~= "table" then
        return tostring(value)
    end
    if seen[value] or depth >= MAX_DEPTH then
        return "{...}"
    end
    seen[value] = true

    local parts = {}
    local length = #value
    for i = 1, length do
        table.insert(parts, describe_item(value[i], depth + 1, seen))
    end
    -- The other keys after the list part, in a fixed order
    local keys = {}
    for key in pairs(value) do
        if math.type(key) ~= "integer" or key < 1 or key > length then
            table.insert(keys, key)
        end
    end
    table.sort(keys, |a, b| -> tostring(a) < tostring(b))
    for _, key in ipairs(keys) do
        local key_text = type(key) == "string" and key:match("^[%a_][%w_]*$") ? key
            : $"[{describe_item(key, depth + 1, seen)}]"
        table.insert(parts, $"{key_text} = {describe_item(value[key], depth + 1, seen)}")
    end

    seen[value] = nil
    if #parts > MAX_ITEMS then
        parts = table.move(parts, 1, MAX_ITEMS, 1, {})
        table.insert(parts, "...")
    end
    return "{" .. table.concat(parts, ", ") .. "}"
end

-- A value as it's shown in a call's notice
function module.describe(value): string
    return describe(value, 0, {})
end

-- A call's results for the notice: "5, x, {1, 2}, function(a): bool"
local function results_text(results: table): string
    local parts = {}
    for i = 2, results.n do
        table.insert(parts, module.describe(results[i]))
    end
    return table.concat(parts, ", ")
end

-- Calls a function of the module by name: the module as it is now (Reload makes a new one).
-- In a thread of its own, since a function may wait (e.g. for a model to load)
local function call(module_name: string, fn: table, args: table, count: int): void
    util.create_thread(function()
        local modules = Atdar.modules
        if not modules.has(module_name) then
            return
        end
        local mod = modules.get(module_name)
        local name = $"{short_name(module_name)}.{signature(fn)}"
        local results = table.pack(pcall(mod[fn.name], mod, table.unpack(args, 1, count)))
        if not results[1] then
            -- An error, so it goes to Stand when Errors Always In Stand is on
            log:error(text("call.failed"):format(name, tostring(results[2])))
            return
        end
        if results.n <= 1 then
            log:notify(text("call.done"):format(name))
        else
            log:notify(text("call.result"):format(name, results_text(results)))
        end
    end)
end

-- Click types of Stand's own calls (restoring a field's state, bulk changes): not the user's
local NOT_USER_CLICKS = { [4] = true }
for _, click_name in ipairs({ "CLICK_BULK", "CLICK_AUTO", "CLICK_SCRIPTED" }) do
    if _G[click_name] ~= nil then
        NOT_USER_CLICKS[_G[click_name]] = true
    end
end
-- Stand calls text fields again while the script stops: nothing it sends then is a call
local stopping = false
util.on_stop(function() stopping = true end)

-- ─── on_tick by hand ─────────────────────────────────────────────────────────
-- A module's on_tick run every frame from the menu, with or without a time limit, whatever its status.
-- Each run is a table of its own: a newer run or Stop replaces it, and its tick handler ends then


local function tick_name(module_name: string): string
    return $"{short_name(module_name)}.on_tick()"
end

-- Module name -> the Status line in its on_tick() list
local tick_statuses = {}

-- Shows how the manual on_tick of the module is: state "running" / "running_for" (seconds left) /
-- "stopped" / "failed"
local function show_tick_status(module_name: string, state: string, seconds_left: ?int): void
    local ref = tick_statuses[module_name]
    if ref == nil then
        return
    end
    local value = text($"tick.state.{state}")
    if seconds_left ~= nil then
        value = value:format(seconds_left)
    end
    -- The list may belong to a section that was already removed
    pcall(menu.set_menu_name, ref, text("entry.status_line"):format(value))
    -- The module's Status: "running by hand" while a run goes on
    local status_ref = (view.statuses or {})[module_name]
    if status_ref ~= nil and Atdar.modules.has(module_name) then
        pcall(menu.set_menu_name, status_ref, status_line(Atdar.modules.get(module_name)))
    end
end

-- Seconds left of a run with a limit, rounded up: 10 at the start, 1 in its last second
local function seconds_left(run: table): int
    return math.ceil((run.ends - util.current_time_millis()) / 1000)
end

-- Calls one of the module's hooks by hand for a manual run; an error is told
-- @return Whether it finished without an error
local function run_hook(module_name: string, hook: string): bool
    local modules = Atdar.modules
    if not modules.has(module_name) then
        return false
    end
    local mod = modules.get(module_name)
    local ok, err = pcall(mod[hook], mod)
    if not ok then
        log:error(text("call.failed"):format($"{short_name(module_name)}.{hook}()", tostring(err)))
    end
    return ok
end

-- Ends a run: forgets it, shows the state; a run started with init calls on_stop, so the module cleans up
local function end_run(module_name: string, run: table, state: string): void
    if manual_ticks[module_name] == run then
        manual_ticks[module_name] = nil
    end
    show_tick_status(module_name, state)
    if run.with_init then
        run_hook(module_name, "on_stop")
    end
end

-- Runs the module's on_tick every frame; seconds: for how long, nil - until Stop.
-- with_init: on_start first (a failing one starts nothing), on_stop when the run ends
local function start_tick(module_name: string, seconds: ?int, with_init: bool): void
    -- A running module is ticked by the manager already: stopped, so on_tick runs once a frame, by hand
    local modules = Atdar.modules
    if modules.has(module_name) and modules.get(module_name):is_running() then
        modules.stop_module(module_name)
        refresh()
        log:notify(text("tick.module_stopped"):format(short_name(module_name)))
    end

    -- A run going on is replaced: ended first, so its on_stop comes before the new on_start
    local previous = manual_ticks[module_name]
    if previous ~= nil then
        end_run(module_name, previous, "stopped")
    end

    if with_init and not run_hook(module_name, "on_start") then
        show_tick_status(module_name, "failed")
        return
    end

    local run = { ends = nil, shown = nil, with_init = with_init }
    if seconds ~= nil then
        run.ends = util.current_time_millis() + seconds * 1000
    end
    manual_ticks[module_name] = run
    if seconds == nil then
        show_tick_status(module_name, "running")
        log:notify(text(with_init ? "tick.started_init" : "tick.started"):format(tick_name(module_name)))
    else
        run.shown = seconds
        show_tick_status(module_name, "running_for", seconds)
        log:notify(text("tick.started_for"):format(tick_name(module_name), seconds))
    end

    util.create_tick_handler(function()
        -- Stopped, or replaced by a newer run
        if stopping or manual_ticks[module_name] ~= run then
            return false
        end
        if run.ends ~= nil then
            local left = seconds_left(run)
            if left <= 0 then
                end_run(module_name, run, "stopped")
                log:notify(text("tick.finished"):format(tick_name(module_name)))
                return false
            end
            -- Once a second, not every frame
            if left ~= run.shown then
                run.shown = left
                show_tick_status(module_name, "running_for", left)
            end
        end
        -- The module as it is now (Reload makes a new one)
        local current = Atdar.modules
        if not current.has(module_name) then
            manual_ticks[module_name] = nil
            show_tick_status(module_name, "stopped")
            return false
        end
        local mod = current.get(module_name)
        local ok, err = true, nil
        local function tick_once()
            ok, err = pcall(mod.on_tick, mod)
        end
        -- Stand shows how long it took this frame on screen (info text), under the module's full name
        if profiling ~= nil then
            profiling.tick($"{module_name}.on_tick()", tick_once)
        else
            tick_once()
        end
        if not ok then
            log:error(text("call.failed"):format(tick_name(module_name), tostring(err)))
            end_run(module_name, run, "failed")
            return false
        end
        return true
    end)
end

local function stop_tick(module_name: string): void
    local run = manual_ticks[module_name]
    if run == nil then
        log:notify(text("tick.not_running"):format(tick_name(module_name)))
        return
    end
    end_run(module_name, run, "stopped")
    log:notify(text("tick.stopped"):format(tick_name(module_name)))
end

-- Stop and Restart: a run going on ends (told), none - nothing said
stop_manual_tick = function(module_name)
    if manual_ticks[module_name] ~= nil then
        stop_tick(module_name)
    end
end

-- Stops every manual on_tick (Stop All)
local function stop_all_ticks(): void
    local runs = manual_ticks
    manual_ticks = {}
    for module_name, run in pairs(runs) do
        end_run(module_name, run, "stopped")
    end
end

-- The on_tick() list: Start With Init, Start Loop Only, Start For A While (seconds), Stop, then the Status
local function tick_list(entry: table, mod: table, title: string): void
    local name = mod.name
    local node = entry:list(title, {}, label("tick.help"))
    node:action(label("tick.start_init"), || -> start_tick(name, nil, true), {}, label("tick.start_init_help"))
    node:action(label("tick.start"), || -> start_tick(name, nil, false), {}, label("tick.start_help"))
    node:track(menu.click_slider(node.handle, label("tick.start_for"), {}, label("tick.start_for_help"),
        1, 600, 10, 1, function(seconds, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        start_tick(name, seconds, false)
    end))
    node:action(label("tick.stop"), || -> stop_tick(name), {}, label("tick.stop_help"))
    tick_statuses[name] = node:divider(text("entry.status_line"):format(text("tick.state.stopped")))
    local run = manual_ticks[name]
    if run ~= nil and run.ends ~= nil then
        show_tick_status(name, "running_for", math.max(seconds_left(run), 1))
    elseif run ~= nil then
        show_tick_status(name, "running")
    end
end

-- ─── Functions without parameters: Call, Loop, Loop With Interval ────────────
-- A loop calls the function every frame, or once every so many ms, until Stop; an error ends it

-- "<module>.<function>" -> its loop going on: { module = name, every = ms or nil, next = ms }
local function_loops = {}
-- The same key -> the Status divider in the function's list
local loop_statuses = {}
-- The same key -> the Loop toggle in the function's list: on while a loop of it runs (any kind)
local loop_toggles = {}
-- Keys whose toggle the script itself is switching: its on_change isn't the user's then
local syncing = {}

-- Switches the Loop toggle to how the loop is, without starting or stopping anything
local function sync_loop_toggle(key: string, on: bool): void
    local ref = loop_toggles[key]
    if ref == nil then
        return
    end
    syncing[key] = true
    pcall(menu.set_value, ref, on)
    syncing[key] = nil
end
-- The same key -> true when the function is called each time its list is opened (Call When Opened).
-- Kept by key, so it stays on when Reload makes the list again
local call_on_open = {}
-- The same, for Call When Hovered: called when the cursor comes onto the function's list
local call_on_focus = {}
-- The same key -> the Arguments typed for the function (worked out again at each call)
local call_args = {}

-- "create(model, coords, heading): ?int": the signature with the return type written in the code
local function item_name(fn: table): string
    if fn.returns == nil then
        return signature(fn)
    end
    return $"{signature(fn)}: {fn.returns}"
end

-- The function with the Arguments typed for it; arguments that can't be worked out are told, nothing is called
local function call_with_args(module_name: string, fn: table, key: string): void
    local args, count, err = module.parse_args(call_args[key] or "")
    if err ~= nil then
        log:error(text("call.bad_args"):format($"{short_name(module_name)}.{signature(fn)}", err))
        return
    end
    call(module_name, fn, args, count)
end

local function loop_key(module_name: string, fn_name: string): string
    return $"{module_name}.{fn_name}"
end

-- state: "running" / "every" (ms) / "stopped" / "failed"
local function show_loop_status(key: string, state: string, every: ?int): void
    -- The Loop toggle follows: on while it runs (also with an interval), off when it ended in any way
    sync_loop_toggle(key, state == "running" or state == "every")
    local ref = loop_statuses[key]
    if ref == nil then
        return
    end
    local value = text($"loop.state.{state}")
    if every ~= nil then
        value = value:format(every)
    end
    pcall(menu.set_menu_name, ref, text("entry.status_line"):format(value))
end

-- Calls the function every frame (every: nil) or once every `every` ms. A newer loop replaces the old one
local function start_loop(module_name: string, fn: table, every: ?int): void
    local key = loop_key(module_name, fn.name)
    local name = $"{short_name(module_name)}.{signature(fn)}"
    local run = { module = module_name, every = every, next = 0 }
    function_loops[key] = run
    if every == nil then
        show_loop_status(key, "running")
        log:notify(text("loop.started"):format(name))
    else
        show_loop_status(key, "every", every)
        log:notify(text("loop.started_every"):format(name, every))
    end

    util.create_tick_handler(function()
        -- Stopped, or replaced by a newer loop
        if stopping or function_loops[key] ~= run then
            return false
        end
        -- What the last call gave is drawn once every frame (debug text shows for one frame only), so it
        -- stays between the calls of a loop with an interval too
        local function draw_result()
            if run.result ~= nil and util.draw_debug_text ~= nil then
                util.draw_debug_text(run.result)
            end
        end
        if run.every ~= nil then
            local now = util.current_time_millis()
            if now < run.next then
                draw_result()
                return true
            end
            run.next = now + run.every
        end
        -- The module as it is now (Reload makes a new one)
        local modules = Atdar.modules
        if not modules.has(module_name) then
            function_loops[key] = nil
            show_loop_status(key, "stopped")
            return false
        end
        local mod = modules.get(module_name)
        local args, count, args_err = module.parse_args(call_args[key] or "")
        if args_err ~= nil then
            function_loops[key] = nil
            show_loop_status(key, "failed")
            log:error(text("call.bad_args"):format(name, args_err))
            return false
        end
        local results = nil
        local function call_once()
            results = table.pack(pcall(mod[fn.name], mod, table.unpack(args, 1, count)))
        end
        -- How long a call takes, on screen (info text)
        if profiling ~= nil then
            profiling.tick($"{module_name}.{fn.name}()", call_once)
        else
            call_once()
        end
        if not results[1] then
            function_loops[key] = nil
            show_loop_status(key, "failed")
            log:error(text("call.failed"):format(name, tostring(results[2])))
            return false
        end
        -- Tables unpacked, functions as their signatures (describe); a call that gives nothing shows nothing
        if results.n > 1 then
            run.result = $"{module_name}.{signature(fn)} -> {results_text(results)}"
        else
            run.result = nil
        end
        draw_result()
        return true
    end)
end

local function stop_loop(module_name: string, fn: table): void
    local key = loop_key(module_name, fn.name)
    local name = $"{short_name(module_name)}.{signature(fn)}"
    if function_loops[key] == nil then
        log:notify(text("loop.not_running"):format(name))
        return
    end
    function_loops[key] = nil
    show_loop_status(key, "stopped")
    log:notify(text("loop.stopped"):format(name))
end

stop_function_loops = function(module_name)
    for key, run in pairs(function_loops) do
        if module_name == nil or run.module == module_name then
            function_loops[key] = nil
            show_loop_status(key, "stopped")
        end
    end
end

-- A function of the module: a list of Arguments (when it has parameters), Call, Call When Opened / Hovered,
-- Loop, Loop With Interval (ms), Stop, then its Status
local function function_list(entry: table, mod: table, fn: table): void
    local module_name = mod.name
    local key = loop_key(module_name, fn.name)
    local node = entry:list(item_name(fn), {}, label("loop.help"), nil, function()
        if call_on_open[key] then
            call_with_args(module_name, fn, key)
        end
    end)
    if #fn.params > 0 or fn.vararg then
        -- Only kept: Call and the loops use it. A text field takes its text through the command box, so it
        -- needs a command; not one of the found commands (tracked without its command)
        node:track(menu.text_input(node.handle, label("loop.args"), commands.names({ $"moduleargs{module_name}{fn.name}" }),
            label("call.help"), function(value)
            if not stopping then
                call_args[key] = value
            end
        end, call_args[key] or ""))
    end
    node:action(label("loop.call"), || -> call_with_args(module_name, fn, key), {}, label("call.button_help"))
    -- Once, after the ms picked; the arguments are worked out then, not at the click
    node:track(menu.click_slider(node.handle, label("loop.call_after"), {}, label("loop.call_after_help"),
        100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        log:notify(text("loop.call_scheduled"):format($"{short_name(module_name)}.{signature(fn)}", ms))
        util.create_thread(function()
            util.yield(ms)
            if not stopping then
                call_with_args(module_name, fn, key)
            end
        end)
    end))
    node:toggle(label("loop.call_on_open"), function(on)
        call_on_open[key] = on or nil
    end, {}, label("loop.call_on_open_help"), call_on_open[key] == true)
    node:toggle(label("loop.call_on_focus"), function(on)
        call_on_focus[key] = on or nil
    end, {}, label("loop.call_on_focus_help"), call_on_focus[key] == true)
    -- The cursor on the function's list (not inside it)
    menu.on_focus(node.handle, function()
        if call_on_focus[key] then
            call_with_args(module_name, fn, key)
        end
    end)
    -- On: every frame; off: the loop stops, also one started with an interval. Made as the loop is now
    syncing[key] = true
    loop_toggles[key] = node:toggle(label("loop.loop"), function(on)
        if stopping or syncing[key] then
            return
        end
        -- Only a real change: the toggle following a loop (e.g. one with an interval) starts nothing,
        -- even if Stand calls this later than the switch
        local running = function_loops[key] ~= nil
        if on and not running then
            start_loop(module_name, fn, nil)
        elseif not on and running then
            stop_loop(module_name, fn)
        end
    end, {}, label("loop.loop_help"), function_loops[key] ~= nil)
    syncing[key] = nil
    node:track(menu.click_slider(node.handle, label("loop.every"), {}, label("loop.every_help"),
        100, 60000, 1000, 100, function(ms, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        start_loop(module_name, fn, ms)
    end))
    loop_statuses[key] = node:divider(
        text("entry.status_line"):format(text("loop.state.stopped")))
    local run = function_loops[key]
    if run ~= nil and run.every ~= nil then
        show_loop_status(key, "every", run.every)
    elseif run ~= nil then
        show_loop_status(key, "running")
    end
end

-- ─── Variables: the module's fields and their values now ─────────────────────

-- Fields every module has (Module's own): not the module's variables
local MODULE_FIELDS = { name = true, deps = true, status = true, error = true, log = true }

-- The module's own fields (set in its __construct or later), sorted by name: { name, value }.
-- Functions (hooks given as options) and Module's fields are left out
local function variables_of(mod: table): table
    local list = {}
    for key, value in pairs(mod) do
        if type(key) == "string" and not MODULE_FIELDS[key] and key:sub(1, 2) ~= "__"
            and type(value) ~= "function" then
            table.insert(list, { name = key, value = value })
        end
    end
    table.sort(list, |a, b| -> a.name < b.name)
    return list
end

-- A table's entries in the order they're shown: the list part, then the other keys sorted.
-- @return { key_text, value }: "[1]", "name", "[158214]"
local function table_entries(tbl: table): table
    local entries = {}
    local length = #tbl
    for i = 1, length do
        table.insert(entries, { key_text = $"[{i}]", value = tbl[i] })
    end
    local keys = {}
    for key in pairs(tbl) do
        if math.type(key) ~= "integer" or key < 1 or key > length then
            table.insert(keys, key)
        end
    end
    table.sort(keys, |a, b| -> tostring(a) < tostring(b))
    for _, key in ipairs(keys) do
        local key_text = key
        if type(key) ~= "string" or not key:match("^[%a_][%w_]*$") then
            -- Not a plain name: in brackets, a text in quotes ([158214], ["a b"])
            local shown = describe_item(key, 0, {})
            key_text = $"[{shown}]"
        end
        table.insert(entries, { key_text = key_text, value = tbl[key] })
    end
    return entries
end

-- Entries shown of one table; the rest is a "..." line
local MAX_TABLE_ENTRIES = 100
-- Tables inside tables made lists this deep; deeper ones are a line ("{...}")
local MAX_VARIABLE_DEPTH = 3

-- How often an open Variables list looks at the values again, ms
local VARIABLES_REFRESH_MS = 250

-- A variable as items to show, added to out in menu order: a line { kind = "line", name, text } or
-- for a table a list { kind = "list", name = "name (entries)" } with its entries after it. Each has
-- a path (where it is, unique) and parent (the path of the list it's in, "" - the Variables list).
-- seen: the tables on the way here, so one inside itself is a line, not lists without end
local function collect_variable(out: table, parent: string, name: string, value, depth: int, seen: table): void
    local path = $"{parent}/{name}"
    if type(value) ~= "table" or seen[value] or depth >= MAX_VARIABLE_DEPTH then
        table.insert(out, { kind = "line", path = path, parent = parent, name = name,
            text = describe_item(value, depth, seen) })
        return
    end
    local entries = table_entries(value)
    table.insert(out, { kind = "list", path = path, parent = parent, name = $"{name} ({#entries})" })
    if #entries == 0 then
        table.insert(out, { kind = "note", path = $"{path}/", parent = path, name = "{}" })
        return
    end
    seen[value] = true
    for i, entry in ipairs(entries) do
        if i > MAX_TABLE_ENTRIES then
            table.insert(out, { kind = "note", path = $"{path}/...", parent = path, name = "..." })
            break
        end
        collect_variable(out, path, entry.key_text, entry.value, depth + 1, seen)
    end
    seen[value] = nil
end

-- Every item of the module's Variables, in menu order (collect_variable), nil if there's no such module
local function collect_variables(module_name: string): ?table
    local modules = Atdar.modules
    if not modules.has(module_name) then
        return nil
    end
    local out = {}
    for _, variable in ipairs(variables_of(modules.get(module_name))) do
        collect_variable(out, "", variable.name, variable.value, 0, {})
    end
    return out
end

-- What the items are without their values: the same shape means only values changed
local function shape_of(items: table): string
    local parts = {}
    for _, item in ipairs(items) do
        table.insert(parts, $"{item.kind}:{item.path}:{item.name}")
    end
    return table.concat(parts, "\n")
end

-- Makes the items in list
-- @return path -> the ref of each line, to change its value later
local function build_variables(list: table, items: table): table
    local lines = {}
    if #items == 0 then
        list:readonly_name(label("no_variables"))
        return lines
    end
    local nodes = { [""] = list }
    for _, item in ipairs(items) do
        local parent = nodes[item.parent]
        if item.kind == "list" then
            nodes[item.path] = parent:list(item.name)
        elseif item.kind == "line" then
            lines[item.path] = parent:readonly(item.name, item.text)
        else
            parent:readonly_name(item.name)
        end
    end
    return lines
end

-- The Variables list: a line per field, "count: 0" (texts in quotes), a list per table field.
-- Made when it's opened; while it's open the values are looked at again every VARIABLES_REFRESH_MS:
-- changed values change in place, a field or entry that came or went makes the list again
local function variables_list(node: table, module_name: string): void
    local list = nil
    -- The current opening: a newer one (or going back) ends the refresh of the one before
    local opened = nil
    list = node:list(label("variables"), {}, label("variables_help"), function()
        opened = nil
        list:clear()
    end, function()
        local this = {}
        opened = this
        list:clear()
        local items = collect_variables(module_name) or {}
        local shape = shape_of(items)
        local texts = {}
        for _, item in ipairs(items) do
            texts[item.path] = item.text
        end
        local lines = build_variables(list, items)
        local next_look = util.current_time_millis() + VARIABLES_REFRESH_MS

        util.create_tick_handler(function()
            if stopping or opened ~= this then
                return false
            end
            local now = util.current_time_millis()
            if now < next_look then
                return true
            end
            next_look = now + VARIABLES_REFRESH_MS
            local fresh = collect_variables(module_name)
            if fresh == nil then
                return false
            end
            local fresh_shape = shape_of(fresh)
            if fresh_shape ~= shape then
                -- Something came or went: made again
                list:clear()
                shape = fresh_shape
                texts = {}
                lines = build_variables(list, fresh)
                for _, item in ipairs(fresh) do
                    texts[item.path] = item.text
                end
                return true
            end
            for _, item in ipairs(fresh) do
                if item.kind == "line" and texts[item.path] ~= item.text then
                    texts[item.path] = item.text
                    pcall(menu.set_value, lines[item.path], item.text)
                end
            end
            return true
        end)
    end)
end

-- The hooks the manager calls, to call by hand too (they don't change the module's status)
local HOOKS = {
    { name = "on_start", params = {}, vararg = false },
    { name = "on_tick", params = {}, vararg = false },
    { name = "on_stop", params = {}, vararg = false },
}

-- The Module Functions list (its Variables, then a list per function of the module), then the Base Functions
-- divider with the hooks
local function functions_of(entry: table, mod: table): void
    local functions_node = entry:list(label("functions"), {}, label("functions_help"))
    variables_list(functions_node, mod.name)
    functions_node:divider(label("functions_divider"))
    local functions = Module.functions_of(mod)
    if #functions == 0 then
        functions_node:readonly_name(label("no_functions"))
    end
    for _, fn in ipairs(functions) do
        fn.returns = return_type(mod[fn.name])
        function_list(functions_node, mod, fn)
    end
    -- At the bottom: the module's helpers, the functions named with _ (callable the same way)
    local internal = Module.functions_of(mod, true)
    if #internal > 0 then
        functions_node:divider(label("internal_functions"))
        for _, fn in ipairs(internal) do
            fn.returns = return_type(mod[fn.name])
            function_list(functions_node, mod, fn)
        end
    end

    entry:divider(label("base_functions"))
    for _, hook in ipairs(HOOKS) do
        -- The module's own type, or the one Module declares the hook with (a module's override may leave it out)
        local returns = return_type(mod[hook.name]) or return_type(Module[hook.name])
        local named = { name = hook.name, params = hook.params, vararg = hook.vararg, returns = returns }
        -- on_tick runs every frame, so it's a list to start and stop, not a button
        if hook.name == "on_tick" then
            tick_list(entry, mod, item_name(named))
        else
            entry:action(item_name(named), || -> call(mod.name, hook, {}, 0), {}, label("call.hook_help"))
        end
    end
end

-- After Reload: the module's code is new, so its Base Functions and Module Functions are made again.
-- Its loops by hand end first (they belonged to the old code and their Status lines go with the items)
local function rebuild_functions(name: string): void
    local section = (view.sections or {})[name]
    local modules = Atdar.modules
    if section == nil or not modules.has(name) then
        return
    end
    section.entry:clear_from(section.first)
    functions_of(section.entry, modules.get(name))
end

-- A module's items in its list (entry): Status, Start / Restart / Stop / Reload, then its functions
local function fill_module(entry: table, name: string): void
    local mod = Atdar.modules.get(name)
    view.statuses[name] = entry:divider(status_line(mod))
    for _, action in ipairs(ACTIONS) do
        entry:action(label(action.key), function()
            action.run(name)
            if action.key == "reload" then
                rebuild_functions(name)
            end
            refresh()
        end)
    end
    -- Where the functions start, so Reload can make them again
    view.sections[name] = { entry = entry, first = #entry.children + 1 }
    functions_of(entry, mod)
end

-- The open list's items: actions, then a list per module
local function fill(node: table): void
    local modules = Atdar.modules
    -- Left from a time the user didn't go back out of it (the menu closed): made again
    node:clear()
    view = { list = node, entries = {}, statuses = {}, sections = {} }

    -- The copy Stand runs, which Reload reads, not the project's src
    node:action(label("open_folder.name"), function()
        util.open_folder($"{Atdar.filesystem.paths.lib}modules")
    end, {}, label("open_folder.help"))
    node:action(label("refresh.name"), refresh, {}, label("refresh.help"))
    node:action(label("stop_all.name"), function()
        -- On_tick run by hand stops too: nothing of the modules keeps running
        stop_all_ticks()
        stop_function_loops(nil)
        modules.stop()
        refresh()
        log:notify(text("stop_all.done"))
    end, {}, label("stop_all.help"))
    node:action(label("reload_changed.name"), function()
        local reloaded = 0
        for _, name in ipairs(modules.names()) do
            if modules.file_changed(name) then
                ACTIONS_BY_KEY.reload.run(name)
                rebuild_functions(name)
                reloaded += 1
            end
        end
        refresh()
        if reloaded == 0 then
            log:notify(text("reload_changed.none"))
        else
            log:notify(text("reload_changed.done"):format(reloaded))
        end
    end, {}, label("reload_changed.help"))
    node:divider(label("list"))

    local names = modules.names()
    for _, name in ipairs(names) do
        local mod = modules.get(name)
        local entry = node:list(caption(mod), {}, help(mod))
        view.entries[name] = entry.handle
        fill_module(entry, name)
    end
    if #names == 0 then
        node:readonly_name(label("empty"))
    end
end

-- Going back out: the items go; loops and runs by hand keep going (their Status shows again on opening)
local function empty(node: table): void
    node:clear()
    if view.list == node then
        view = {}
        tick_statuses = {}
        loop_statuses = {}
        loop_toggles = {}
    end
end

-- Puts a Modules list into node (a MenuNode, e.g. a pack's list), its items made only while it's open
-- @return The list (a MenuNode)
function module.list_in(node: table): table
    local list = nil
    list = node:list(label("title"), {}, label("help"), || -> empty(list), || -> fill(list))
    return list
end

-- Puts one module's list into node: its status, Start / Restart / Stop / Reload and its functions, made
-- only while it's open. Named like in the Modules list ("1: VehicleManager: running")
-- @return The list (a MenuNode), nil if there's no such module
function module.module_in(node: table, name: string): ?table
    local modules = Atdar.modules
    if not modules.has(name) then
        log:warn($"module_in: there's no module '{name}'")
        return nil
    end
    local entry = nil
    entry = node:list(caption(modules.get(name)), {}, help(modules.get(name)), || -> empty(entry), function()
        entry:clear()
        view = { list = entry, entries = { [name] = entry.handle }, statuses = {}, sections = {} }
        fill_module(entry, name)
    end)
    return entry
end

-- The place in the script's settings: the "Debug" divider and the Modules list (shown in debug mode)
function module.build(parent: table): void
    -- The manager failed to load: the loader left an empty table
    if type(Atdar.modules.names) ~= "function" then
        return
    end
    -- A section made again (a profile created or deleted): the old place's items are gone
    place = { divider = parent:divider(label("divider")) }
    place.list = module.list_in(parent)
    update_visibility()
end

Atdar.profile.on_change(function(key: string, value)
    if key == "debug" then
        debug_mode = value == true
        update_visibility()
    end
end)

return module
