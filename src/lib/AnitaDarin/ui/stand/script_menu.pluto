-- The script's own section (settings.pluto builds it, at the root or inside a pack's Settings).
-- Lays out the parts from profile_menu, modules_menu and the menu picker of menu.pluto:
--
--   ── Profile: main ──
--   Display Name, Short Name
--   Settings >      Language, Name In Logs, Notifications, Rename Script
--   Profiles >      Create Profile, Open Folder, one list per profile
--   Load Menu >     Unload, Copy Menu To Core, ── Menus ──, the menus with their state
--   Command Box >   Command Prefix, Separator, Found Commands
--   Open Folder >   Lib, Resources, Store
--   Update >        Check For Updates, Update (updater_menu, a stub for now)
--   Debug >         Debug Mode, then at the bottom in debug mode only:
--                   ── Debug ──, Modules, Delete Script (asks first)
--
-- Stand adds every item at the end of its list, so the order of the calls below is the order in the menu.
-- Strings: base/language "script_menu"

local i18n = Atdar.loader.load("core/i18n")
local installer = Atdar.loader.load("core/installer")
local Logger = Atdar.loader.load("core/logger")
local commands = Atdar.loader.load("ui/stand/commands")
local command_box = Atdar.loader.load("parsers/stand/command_box")
local profile_menu = Atdar.loader.load("ui/stand/profile_menu")
local language_menu = Atdar.loader.load("ui/stand/language_menu")
local user_commands = Atdar.loader.load("ui/stand/user_commands")
-- The Modules place only: the list's items (ui/stand/modules_menu) load when it's first opened
local modules_place = Atdar.loader.load("ui/stand/modules_place")
local updater_menu = Atdar.loader.load("ui/stand/updater_menu")

local log = new Logger("Menu")

local module = {}

-- Strings under "script_menu"
local label, text = i18n.scope("script_menu")

-- An item that isn't made yet: says so when used. Unused now, kept for the next new item
local function stub(node: table, key: string): void
    node:action(label($"{key}.name"), || -> log:notify(text("stub")), {}, label("stub"))
end

-- How long the confirm button of Delete Script waits for its second click
local CONFIRM_MS = 5000

-- Delete Script: a list, so deleting takes its own confirm button and never happens on one click.
-- The button deletes on a second click within CONFIRM_MS: the first one renames it and says what goes;
-- going back out of the list cancels it.
-- Not menu.show_warning: in the game it let the delete through without showing anything, whatever the
-- click type. Not a toggle either: Stand keeps toggle states in its profile, so it could start on.
-- Profiles and settings are kept unless switched off. Then the script deletes its files (core/installer) and stops
-- @return The list's handle
local function delete_script(node: table)
    local confirm_ref
    -- Until when a second click deletes; nil - not armed
    local armed_until = nil
    -- Going back out of the list cancels a first click: the button's name comes back on the next tick
    local list = node:list(label("delete_script.name"), {}, label("delete_script.help"), function()
        armed_until = nil
    end)
    list:divider(label("delete_script.cannot_undo"))
    local keep = true
    list:toggle(label("delete_script.keep.name"), function(on) keep = on end, {},
        label("delete_script.keep.help"), true)
    -- Set once the script is deleted: it's stopping, further clicks must do nothing
    local deleted = false
    confirm_ref = list:action(label("delete_script.confirm.name"), function()
        if deleted then
            return
        end
        local now = util.current_time_millis()
        if armed_until == nil or now > armed_until then
            armed_until = now + CONFIRM_MS
            pcall(menu.set_menu_name, confirm_ref, label("delete_script.confirm.again"))
            local warning = text(keep ? "delete_script.warning_keep" : "delete_script.warning"):format(Atdar.name)
            log:warn($"{warning}\n{text('delete_script.confirm.again_notice'):format(CONFIRM_MS // 1000)}")
            -- The button gets its name back when the time is up (or after the delete was cancelled)
            util.create_tick_handler(function()
                if armed_until ~= nil and util.current_time_millis() <= armed_until then
                    return true
                end
                armed_until = nil
                pcall(menu.set_menu_name, confirm_ref, label("delete_script.confirm.name"))
                return false
            end)
            return
        end
        armed_until = nil
        local ok, result = installer.delete(keep)
        if not ok then
            log:warn(text("delete_script.failed"):format(result))
            return
        end
        deleted = true
        log:notify(text("delete_script.done"):format(Atdar.name, result))
        installer.stop()
    end, {}, label("delete_script.confirm.help"))
    return list.handle
end

-- ─── Found Commands ──────────────────────────────────────────────────────────

-- Rows of the latest build: { ref = the item, row = its row (a line or a list), command = the line with
-- the full command inside a list, or nil }
local found_rows = {}

-- An item's name for its row; names may be Stand labels
local function item_name(ref): string
    local ok, name = pcall(menu.get_menu_name, ref)
    if not ok then
        return ""
    end
    if type(name) == "number" then
        return lang.get_localised(name)
    end
    return tostring(name)
end

-- "godmode" - an item's commands without the prefix, easier to read; the full one is inside its list
local function short_names(ref): string
    return table.concat(commands.bases_of(ref) or {}, ", ")
end

local function full_names(ref): string
    return table.concat(commands.names_of(ref) or {}, ", ")
end

-- Click types of calls Stand makes by itself: restoring the state from its profile (the field's default
-- for an item it has no state of), bulk changes. Seen as 4 in the game; the names when Stand has them
local NOT_USER_CLICKS = { [4] = true }
for _, name in ipairs({ "CLICK_BULK", "CLICK_AUTO", "CLICK_SCRIPTED" }) do
    if _G[name] ~= nil then
        NOT_USER_CLICKS[_G[name]] = true
    end
end

-- Stand calls text fields again while the script stops; nothing it sends then is the user's
local stopping = false
util.on_stop(function() stopping = true end)

-- A command: a list with its full command, its custom name and a reset, then its extra words. They're
-- kept by ui/stand/commands: commands/<base>.json in the menu's folder, or store/<script>/commands/
local function command_entry(list: table, ref): table
    local entry = list:list(short_names(ref), {}, item_name(ref))
    local found = { ref = ref, row = entry.handle }
    found.command = entry:readonly(label("found_commands.command"), full_names(ref))

    -- Takes the cursor to the item itself. One hidden for now (debug mode is off) can't be reached
    entry:action(label("found_commands.focus.name"), function()
        if not pcall(menu.focus, ref) then
            log:warn(text("found_commands.focus.failed"))
        end
    end, {}, label("found_commands.focus.help"))

    local function renamed(): void
        pcall(menu.set_menu_name, found.row, short_names(ref))
        pcall(menu.set_value, found.command, full_names(ref))
    end

    -- A text field takes its text through the command box, so it needs a command: cbrename<base> (cb: the
    -- Command Box section, like its cbprefix and cbseparator).
    -- Made without commands.track, so it isn't one of the found commands itself.
    -- Its default is the custom name now: when Stand puts a field back to its default (restoring its
    -- profile's state), that's no change. Only the user's own entries rename
    local base = commands.base_of(ref) or ""
    menu.text_input(entry.handle, label("found_commands.rename.name"), commands.names({ $"cbrename{base}" }),
        label("found_commands.rename.help"), function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] then
            return
        end
        if command_box.sanitize(value) == commands.custom_of(ref) then
            return
        end
        local ok, reason = commands.set_custom(ref, value)
        if reason == "not_saved" then
            -- Renamed for now, but it won't be there at the next start
            renamed()
            log:warn(text("found_commands.not_saved"))
            return
        end
        if not ok then
            log:warn(text(reason == "taken" and "found_commands.rename.taken" or "found_commands.rename.failed"):format(value))
            return
        end
        renamed()
        log:notify(text("found_commands.rename.done"):format(full_names(ref)))
    end, commands.custom_of(ref))

    entry:action(label("found_commands.reset.name"), function()
        local _, reason = commands.set_custom(ref, "")
        if reason == "not_saved" then
            log:warn(text("found_commands.not_saved"))
        end
        renamed()
        log:notify(text("found_commands.reset.done"):format(short_names(ref)))
    end, {}, label("found_commands.reset.help"))

    -- Extra words: more commands for the item, the same prefix. Each a button that takes it off;
    -- made again (at the end of the list) when one is added or taken off
    entry:divider(label("found_commands.words.divider"))
    local word_items = {}
    local function show_words(): void
        for _, item in ipairs(word_items) do
            pcall(menu.delete, item)
        end
        word_items = {}
        for _, word in ipairs(commands.words_of(ref)) do
            table.insert(word_items, menu.action(entry.handle, word, {}, label("found_commands.words.remove_help"), function()
                local _, reason = commands.remove_word(ref, word)
                if reason == "not_saved" then
                    log:warn(text("found_commands.not_saved"))
                end
                renamed()
                show_words()
                log:notify(text("found_commands.words.removed"):format(word))
            end))
        end
    end
    -- A text field needs a command: cbaddword<base>, made without commands.track like cbrename
    menu.text_input(entry.handle, label("found_commands.words.add.name"), commands.names({ $"cbaddword{base}" }),
        label("found_commands.words.add.help"), function(value, click_type)
        if stopping or NOT_USER_CLICKS[click_type] or value == "" then
            return
        end
        local ok, reason = commands.add_word(ref, value)
        if reason == "not_saved" then
            renamed()
            show_words()
            log:warn(text("found_commands.not_saved"))
            return
        end
        if not ok then
            local key = ({ own = "found_commands.words.own", taken = "found_commands.rename.taken" })[reason]
                or "found_commands.rename.failed"
            log:warn(text(key):format(value))
            return
        end
        renamed()
        show_words()
        log:notify(text("found_commands.words.added"):format(command_box.sanitize(value)))
    end, "")
    show_words()
    return found
end

-- One list per item that has commands, named by its commands without the prefix, to rename it:
-- the script's own in Base Commands, the loaded menu's in Found Commands. Filled at the end of the build,
-- so the section's own items are in it too (the loaded menu's are made before the section)
local function fill_command_lists(base: table, found: table): void
    found_rows = {}
    local counts = { script = 0, menu = 0 }
    for _, item in ipairs(commands.list()) do
        local who = commands.owner_of(item.ref)
        -- The user's own commands have their list (User Commands), named there
        if who ~= "user" then
            local list = who == "menu" and found or base
            table.insert(found_rows, command_entry(list, item.ref))
            counts[who] = (counts[who] or 0) + 1
        end
    end
    if counts.script == 0 then
        base:readonly_name(label("base_commands.none"))
    end
    if counts.menu == 0 then
        found:readonly_name(label("found_commands.none"))
    end
end

-- A new prefix or separator renames the commands (ui/stand/commands): the full ones inside the lists follow
Atdar.profile.on_change(function(key: string)
    if key ~= "command_box_prefix" and key ~= "command_box_separator" and key ~= "command_box_found_prefix"
        and key ~= "command_box_found_separator" then
        return
    end
    for _, found in ipairs(found_rows) do
        if found.command then
            pcall(menu.set_value, found.command, full_names(found.ref))
        end
    end
end)

-- Opens one of the script's folders in Explorer; one that doesn't exist yet (resources) is made first,
-- since Explorer can't open a missing folder
local function open_folder(node: table, key: string, path: string): void
    node:action(label($"open_folder.{key}.name"), function()
        if not filesystem.exists(path) then
            filesystem.mkdirs(path)
        end
        util.open_folder(path)
    end, {}, label($"open_folder.{key}.help"))
end

-- A path from Lua Scripts on: "store\AnitaDarin\logs\" - short enough for a warning
local function from_scripts_dir(path: string): string
    local root = filesystem.scripts_dir()
    if path:sub(1, #root) == root then
        return path:sub(#root + 1)
    end
    return path
end

-- Removes every log file, after a warning
local function clear_logs(node: table): void
    -- Today's file only, at once: the lines from before a test, without losing the other days
    node:action(label("clear_log.name"), function()
        if Logger.clear_today() then
            log:notify(text("clear_log.done"))
            return
        end
        log:notify(text("clear_log.none"))
    end, { "clearlog" }, label("clear_log.help"))

    local ref
    ref = node:action(label("clear_logs.name"), function(click_type)
        menu.show_warning(ref, click_type, text("clear_logs.warning"):format(from_scripts_dir(Logger.folder())), function()
            log:notify(text("clear_logs.done"):format(Logger.clear()))
        end)
    end, { "clearlogs" }, label("clear_logs.help"))
end

-- opts.refresh:    rebuilds the section (after a profile is created or deleted)
-- opts.packs:      menu packs in store, offered for copying to core
-- opts.fill_menus: fill_menus(node) adds the Menus divider and an entry per menu (menu.pluto)
function module.build(section: table, opts: table): void
    profile_menu.begin(opts.packs)

    profile_menu.header(section)
    
    local settings = section:list(i18n.label("profile.settings.name"), { "settings" },
        i18n.label("profile.settings.help"))
    profile_menu.appearance(settings)
    language_menu.build(settings)
    settings:divider(i18n.label("profile.script"))
    profile_menu.rename(settings)

    profile_menu.profiles(section, opts.refresh)

    -- Its commands all start with menuloader: menuloader, menuloaderunload, menuloaderautocopy,
    -- menuloaderbuiltin, menuloader<pack folder>
    local load_menu = section:list(i18n.label("menu_loader.load_menu.name"), { "menuloader" },
        i18n.label("menu_loader.load_menu.help"))
    load_menu:action(label("unload.name"), opts.unload, { "menuloaderunload" }, label("unload.help"))
    profile_menu.auto_copy(load_menu)
    opts.fill_menus(load_menu)

    local command_box = section:list(label("command_box.name"), {}, label("command_box.help"))
    profile_menu.command_box(command_box)
    command_box:divider(label("commands_divider"))
    local base_commands = command_box:list(label("base_commands.name"), {}, label("base_commands.help"))
    local found = command_box:list(label("found_commands.name"), {}, label("found_commands.help"))
    user_commands.build(command_box)
    -- The folder each list's names and words are kept in; made when it isn't there yet
    for _, part in ipairs({ { list = base_commands, who = "script" }, { list = found, who = "menu" } }) do
        part.list:action(label("commands_folder.name"), function()
            local dir = commands.folder_of(part.who)
            if dir == nil then
                log:warn(text("commands_folder.no_menu"))
                return
            end
            if not filesystem.exists(dir) then
                filesystem.mkdirs(dir)
            end
            util.open_folder(dir)
        end, {}, label($"commands_folder.{part.who}_help"))
        -- The folder apart from the commands under it
        part.list:divider(label("commands_divider"))
    end

    local folders = section:list(label("open_folder.name"), {}, label("open_folder.help"))
    local paths = Atdar.filesystem.paths
    open_folder(folders, "lib", paths.lib)
    open_folder(folders, "resources", paths.resources)
    open_folder(folders, "store", paths.store)
    open_folder(folders, "logs", Logger.folder())

    updater_menu.build(section)

    local debug = section:list(label("debug.name"), {}, label("debug.help"))
    profile_menu.debug(debug)
    debug:divider(label("logs"))
    profile_menu.log_name(debug)
    profile_menu.log_keep_days(debug)
    profile_menu.log_info_at_once(debug)
    clear_logs(debug)
    -- At the bottom, shown only in debug mode: the "Debug" divider with Modules, then Delete Script
    modules_place.build(debug)
    modules_place.debug_only(delete_script(debug))

    -- The script's cards and posts in the game's feed, all taken away (other scripts' and the game's stay).
    -- Told in Stand: a notice in the feed would be one more to take away
    section:action(label("clear_feed.name"), function()
        local removed = Atdar.natives.visual.hud.thefeed.remove_all()
        if removed == 0 then
            log:notify(text("clear_feed.none"), "stand")
            return
        end
        log:success(text("clear_feed.done"):format(removed), "stand")
    end, { "notifyclearfeed" }, label("clear_feed.help"))

    -- Last, once every item of the section has its commands
    fill_command_lists(base_commands, found)
end

return module
