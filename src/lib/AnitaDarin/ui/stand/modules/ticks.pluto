-- lib/AnitaDarin/ui/stand/modules/ticks.pluto
--
-- The on_tick() list of a module in the Modules list (ui/stand/modules/list): Start With Init, Start Loop Only,
-- Start For A While, Stop and the Status line. What the buttons do (the runs) is in ui/logic/stand/ticks.
-- Loaded with modules_menu, which binds what it knows of the list (bind).
-- Strings: core/language "modules"

local i18n = Atdar.loader.load("core/i18n")
local runs = Atdar.loader.load("ui/logic/stand/ticks")

local module = {}

-- Strings under "modules"
local label, text = i18n.scope("modules")

-- What the Modules list gives (bind): status_changed(name) to show the module's Status again
local hooks = {
    status_changed = |name| -> nil,
}

-- Module name -> the Status line (MenuItem) in its on_tick() list
local tick_statuses = {}

-- Shows how the manual on_tick of the module is: state "running" / "running_for" (seconds left) /
-- "stopped" / "failed"
local function show_tick_status(module_name: string, state: string, seconds_left: ?int): void

    local line = tick_statuses[module_name]
    local value = text($"tick.state.{state}")

    if line == nil then
        return
    end

    if seconds_left ~= nil then
        value = value:format(seconds_left)
    end

    -- The list may belong to a section that was already removed: then nothing changes
    line:set_name(text("entry.status_line"):format(value))

    -- The module's Status: "running by hand" while a run goes on
    hooks.status_changed(module_name)
end

-- @param given short_name(name) for notices, refresh() for every entry, status_changed(name)
function module.bind(given: table): void
    hooks.status_changed = given.status_changed or hooks.status_changed
    runs.bind({ short_name = given.short_name, refresh = given.refresh, show_status = show_tick_status })
end

-- The on_tick() list: Start With Init, Start Loop Only, Start For A While (seconds), Stop, then the Status
function module.list(entry: table, mod: table, title: string): void

    local name = mod.name
    local node = entry:list({ name = title, help = label("tick.help") })
    local ui = node:scope("modules")
    local run = runs.run_of(name)

    ui:action({ key = "tick.start_init", on_click = || -> runs.start(name, nil, true) })
    ui:action({ key = "tick.start", on_click = || -> runs.start(name, nil, false) })
    ui:click_slider({ key = "tick.start_for", min = 1, max = 600, default = 10, step = 1, user_only = true,
        on_click = |seconds| -> runs.start(name, seconds, false) })
    ui:action({ key = "tick.stop", on_click = || -> runs.stop_told(name) })

    tick_statuses[name] = ui:divider({ name = text("entry.status_line"):format(text("tick.state.stopped")) })

    if run ~= nil and run.ends ~= nil then
        show_tick_status(name, "running_for", math.max(runs.seconds_left(run), 1))
    elseif run ~= nil then
        show_tick_status(name, "running")
    end
end

-- The Modules list was gone back out of: the Status lines are gone, the runs go on
function module.forget_lines(): void
    tick_statuses = {}
end

return module
