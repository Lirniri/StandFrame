-- lib/AnitaDarin/ui/stand/modules/values.pluto
--
-- The items that show values: what a call gave - a function's Variable line, the line with a userdata's value
-- and, for a table, the Value list under it with its table settings - and a module's Variables list, its
-- fields kept up to date while it's open. Used by the Modules list (ui/stand/modules/list) and by
-- Debug > Call Function.
--
-- Only the items are here. What a call gave is kept by ui/logic/stand/results (this file follows its changes);
-- what a value looks like as text and a table as items is ui/logic/stand/values.
-- Strings: core/language "modules"

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local Logger = Atdar.loader.load("core/logger")
local logic = Atdar.loader.load("ui/logic/stand/values")
local results = Atdar.loader.load("ui/logic/stand/results")

local log = new Logger("Modules")

-- The fields of a function's arguments, loaded when a table's function first needs them
local function arguments(): table
    return Atdar.loader.load("ui/stand/core/arguments")
end

local module = {}

-- For the callers that have this file at hand: the same as the logic's
module.describe = logic.describe
module.results_text = logic.results_text
module.show_result = results.show
module.result_depth = results.depth
module.call_in_tables = results.call_in_tables
module.edit_in_tables = results.edit_in_tables

-- Strings under "modules"
local label, text = i18n.scope("modules")

-- What a call gave

-- The items (MenuItems) of each key ("<module>.<function>") in the list open now:
--   result_lines   the Variable line
--   detail_lines   the line under it with a userdata's value, hidden while the result isn't one
--   result_tables  the Value list: { list, shape, texts, lines, named }
--   depth_items    Table Depth, Call Functions In Tables, Change Variable Values: { build = function() -> remove,
--                  remove = function or nil }. Made while the result is a table and taken away when it isn't.
--                  Made at the end of the list, so they're right under the Value list: Stand puts an item
--                  that is shown again at the end of its list, wherever it was made
local result_lines = {}
local detail_lines = {}
local result_tables = {}
local depth_items = {}

-- The keys whose lines belong to a list outside Modules (Debug > Call Function): forget_lines leaves them
local kept_keys = {}

-- Makes the Value list show the key's table; set below, with the Variables list it builds like
local update_result_list

local function show_depth_items(key: string): void

    local entry = depth_items[key]

    if entry == nil then
        return
    end

    local on = results.table_of(key) ~= nil

    if on and entry.remove == nil then
        entry.remove = entry.build()
        return
    end

    if not on and entry.remove ~= nil then
        pcall(entry.remove)
        entry.remove = nil
    end
end

-- The line under Variable with a userdata's value: there while the last result is one
local function show_detail(key: string): void

    local line = detail_lines[key]
    local detail = results.detail_of(key)

    if line == nil then
        return
    end

    if detail ~= nil then
        line:set_name(detail)
    end

    line:set_visible(detail ~= nil)
end

-- What a key gave changed: its items follow
results.on_change(function(key: string)

    local line = result_lines[key]

    update_result_list(key)
    show_depth_items(key)
    show_detail(key)

    if line == nil then
        return
    end

    if not line:set_name(results.line(key)) then
        log:debug($"{key}: Variable line not updated")
    end
end)

-- The Value list made again for a table setting changed by the user. Not for a saved state Stand puts back
-- while the script starts (quiet): items can't be made there, the list is made again with the next result.
-- In a thread of its own: items can't be made inside the callback of a setting either
local function setting_changed(key: string, quiet: ?bool): void
    if quiet then
        return
    end

    util.create_thread(function()
        update_result_list(key)
    end)
end

-- How deep tables inside tables open as lists in the Value list of key
function module.set_result_depth(key: string, depth: int, quiet: ?bool): void
    results.set_depth(key, depth)
    setting_changed(key, quiet)
end

-- Call Functions In Tables for key's Value list: the functions in it become lists to open, with their
-- arguments and Call
function module.set_call_in_tables(key: string, on: bool, quiet: ?bool): void
    results.set_call_in_tables(key, on)
    setting_changed(key, quiet)
end

-- Change Variable Values for key's Value list: the values in it become fields to type a new value in
function module.set_edit_in_tables(key: string, on: bool, quiet: ?bool): void
    results.set_edit_in_tables(key, on)
    setting_changed(key, quiet)
end

-- The items of the table settings of key's list: build() makes them at the end of the list and returns a
-- function that takes them away; they exist only while the last result is a table
function module.bind_depth_items(key: string, build): void
    depth_items[key] = { build = build }
    show_depth_items(key)
end

-- A function's Variable line, the line of a userdata's value and its Value list, made in its list (node)
-- @param kept The lines belong to a list outside Modules (Debug > Call Function), so forget_lines leaves them
function module.add_result_lines(node: table, key: string, kept: ?bool): void

    result_lines[key] = node:divider({ name = results.line(key) })

    -- A userdata it gave: its value on a line of its own (hidden while it gave none)
    detail_lines[key] = node:divider({ name = results.detail_of(key) or "-" })
    show_detail(key)

    -- A table it gave: its entries in a list right under (hidden while it gave none)
    result_tables[key] = { list = node:list({ name = text("loop.result_list"):format(0) }), shape = nil,
        texts = {}, lines = {} }

    if kept then
        kept_keys[key] = true
    end

    update_result_list(key)
end

-- The Modules list was gone back out of: its lines are gone, what the calls gave is still remembered
function module.forget_lines(): void

    local lines, details, tables, depth = {}, {}, {}, {}

    for key in pairs(kept_keys) do
        lines[key] = result_lines[key]
        details[key] = detail_lines[key]
        tables[key] = result_tables[key]
        depth[key] = depth_items[key]
    end

    result_lines = lines
    detail_lines = details
    result_tables = tables
    depth_items = depth
end

-- Variables: a table's entries and a module's fields

-- How often an open Variables list looks at the values again, ms
local VARIABLES_REFRESH_MS = 250

-- Makes the items in list
-- scope: the key of the Value list the items are for (nil - the module's Variables: all lines are read only)
-- call_on: Call Functions In Tables - the functions are lists to call
-- edit_on: Change Variable Values - the other values are fields to type a new value in
-- @return path -> the item of each line, to change its value later; and the set of paths whose name carries
--         the value ("name: value"), which is changed with it
local function build_variables(list: table, items: table, scope: ?string, call_on: ?bool, edit_on: ?bool): table

    local lines = {}
    local named = {}

    if #items == 0 then
        list:readonly_name({ name = label("no_variables") })
        return lines, named
    end

    local nodes = { [""] = list }
    local number = 0

    for _, item in ipairs(items) do

        local parent = nodes[item.parent]

        if item.kind == "list" then
            nodes[item.path] = parent:list({ name = item.name })
        elseif item.kind == "line" and item.holder ~= nil and not item.is_function and edit_on then

            -- A value: a field with it typed as an expression (5, true, "text", v3.new(1, 2, 3), nil)
            number += 1
            named[item.path] = true
            lines[item.path] = parent:text_input({ name = $"{item.name}: {item.text}", help = label("edit.help"),
                commands = { $"tablevaredit{results.scope_number(scope)}_{number}" }, default = item.text,
                user_only = true, on_change = function(value)
                    if results.edit(item, value) then
                        update_result_list(scope)
                    end
                end })
        elseif item.kind == "line" and item.holder ~= nil and item.is_function and call_on then

            -- A function: a list with the panel of Debug > Call Function (arguments, Call, Call After, Loop, ...),
            -- without the name and the notice in Stand
            number += 1
            named[item.path] = true

            local id = $"{scope}{item.path}"
            local panel = nil
            -- A field for each parameter the code says (nil for a function that says nothing: one Arguments field)
            local sig = arguments().signature_of(item.holder[item.raw_key])
            local entry = parent:list({ name = $"{item.name}: {item.text}", help = label("loop.help"),
                on_open = function()
                    if panel ~= nil then
                        panel.opened()
                    end
                end })

            lines[item.path] = entry

            panel = Atdar.loader.load("ui/stand/script/call_function").panel(entry, {
                key = id,
                state = results.fn_state(id),
                sig = sig,
                name = || -> item.name,
                -- The function as it is in its table now; a plain call, without self
                target = function()
                    local fn = item.holder[item.raw_key]
                    if type(fn) ~= "function" then
                        return false
                    end
                    return true, fn
                end,
                args_command = $"tablefnargs{results.scope_number(scope)}_{number}",
            })
        elseif item.kind == "line" then
            lines[item.path] = parent:readonly({ name = item.name, value = item.text })
        else
            parent:readonly_name({ name = item.name })
        end
    end

    return lines, named
end

-- Shows an entry's new value on its line; a named one ("name: value") in its name too. A function's list
-- takes no value: it stays as it is
local function set_line(line: ?table, item: table, named: ?bool): void

    if line == nil then
        return
    end

    if named then
        line:set_name($"{item.name}: {item.text}")
    end

    line:set_value(item.text)
end

-- The Value list under a function's Variable line: what a table it gave holds, a line or list per entry
-- like Variables. Hidden when it gave no table; changed values change in place, entries that came or
-- went make the list again
update_result_list = function(key)

    local shown = result_tables[key]

    if shown == nil then
        return
    end

    local items, count = results.items(key)

    if items == nil then
        shown.list:set_visible(false)
        return
    end

    shown.list:set_visible(true)
    shown.list:set_name(text("loop.result_list"):format(count))

    -- With Call Functions In Tables / Change Variable Values on, the lines are lists or fields: another shape
    local call_on = results.call_in_tables(key)
    local edit_on = results.edit_in_tables(key)
    local shape = logic.shape_of(items)

    if call_on then
        shape = shape .. "\ncall"
    end
    if edit_on then
        shape = shape .. "\nedit"
    end

    if shape ~= shown.shape then
        shown.list:clear()
        shown.shape = shape
        shown.lines, shown.named = build_variables(shown.list, items, key, call_on, edit_on)
        shown.texts = {}
        for _, item in ipairs(items) do
            shown.texts[item.path] = item.text
        end
        return
    end

    for _, item in ipairs(items) do
        if item.kind == "line" and shown.texts[item.path] ~= item.text then
            shown.texts[item.path] = item.text
            set_line(shown.lines[item.path], item, (shown.named or {})[item.path])
        end
    end
end

-- The Variables list: a line per field, "count: 0" (texts in quotes), a list per table field.
-- Made when it's opened, gone on going back out; while it's open the values are looked at again every
-- VARIABLES_REFRESH_MS: changed values change in place, a field or entry that came or went makes the list again
-- @param hidden_of function(mod): the fields not shown, as a set (the module's debug.hide)
function module.variables_list(node: table, module_name: string, hidden_of): void

    -- The current opening: a newer one (or going back) ends the refresh of the one before
    local opened = nil

    node:scope("modules"):list({ key = "variables", on_back = function() opened = nil end, fill = function(list)

        local this = {}
        local items = logic.collect_variables(module_name, hidden_of) or {}
        local shape = logic.shape_of(items)
        local texts = {}
        local lines = build_variables(list, items)
        local next_look = util.current_time_millis() + VARIABLES_REFRESH_MS

        opened = this

        for _, item in ipairs(items) do
            texts[item.path] = item.text
        end

        util.create_tick_handler(function()
            if clicks.is_stopping() or opened ~= this then
                return false
            end

            local now = util.current_time_millis()
            if now < next_look then
                return true
            end

            next_look = now + VARIABLES_REFRESH_MS

            local fresh = logic.collect_variables(module_name, hidden_of)
            if fresh == nil then
                return false
            end

            local fresh_shape = logic.shape_of(fresh)
            if fresh_shape ~= shape then
                -- Something came or went: made again
                list:clear()
                shape = fresh_shape
                texts = {}
                lines = build_variables(list, fresh)
                for _, item in ipairs(fresh) do
                    texts[item.path] = item.text
                end
                return true
            end

            for _, item in ipairs(fresh) do
                if item.kind == "line" and texts[item.path] ~= item.text then
                    texts[item.path] = item.text
                    set_line(lines[item.path], item)
                end
            end

            return true
        end)
    end })
end

return module
