-- lib/AnitaDarin/ui/stand/modules/values.pluto
--
-- The items that show values: what a call gave - a function's Variable line, the line with a userdata's value
-- and, for a table, the Value list under it with Table Depth - and a module's Variables list, its
-- fields kept up to date while it's open. Used by the Modules list (ui/stand/modules/list) and by
-- Debug > Call Function.
--
-- Only the items are here. What a call gave is kept by ui/logic/stand/results (this file follows its changes);
-- what a value looks like as text and a table as items is ui/logic/stand/values.
-- Strings: core/language "modules"

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local Logger = Atdar.loader.load("core/logger")
local logic = Atdar.loader.load("ui/logic/stand/values")
local results = Atdar.loader.load("ui/logic/stand/results")

local log = new Logger("Modules")

-- The fields of a function's arguments, loaded when a table's function first needs them
local function arguments(): table
    return Atdar.loader.load("ui/stand/core/arguments")
end

-- Debug > Call Function: its panel for a function in a table, loaded when one is first made (it loads this file)
local function call_function(): table
    return Atdar.loader.load("ui/stand/script/call_function")
end

local module = {}

-- For the callers that have this file at hand: the same as the logic's
module.describe = logic.describe
module.results_text = logic.results_text
module.show_result = results.show

-- Strings under "modules"
local label, text = i18n.scope("modules")

-- What a call gave

-- The items (MenuItems) of each key ("<module>.<function>") in the list open now. They are one block at the end of
-- their list, made in the order they show in, and made again as a whole when the kind of the result changes (nothing,
-- a plain value, a userdata, a table, a function): Stand puts an item that is hidden and shown, or made later, at the
-- end of its list, so nothing in the block is hidden, shown or added alone. The order is the order they're made in:
--   result_lines   the Variable line
--   detail_lines   the line under it with a userdata's value, there while the result is one
--   result_tables  the Value list: { node, list, shape, texts, lines, named }; list is there while the result is a table
--   result_functions  the Parameters list of a function that was read and not called: { node, list, shape }
--   (the tail of the block, made by the caller: the result tools of Call Function, ...)
--   depth_items    Table Depth, right under the Value list (made last, then moved up); hidden while the result
--                  isn't a table
-- A list that is open stays as it is while the result keeps its kind: only what is in it is changed
local result_lines = {}
local detail_lines = {}
local result_tables = {}
local depth_items = {}
local result_functions = {}
-- key -> { node = the list the block is in, tail = function(node) made after the lists, kind = what the block holds }
local blocks = {}

-- The keys whose lines belong to a list outside Modules (Debug > Call Function): forget_lines leaves them
local kept_keys = {}

-- Makes the Value list show the key's table; set below, with the Variables list it builds like
local update_result_list

-- Table Depth is there while the result is a table, opened or only looked at
local function show_depth(key: string): void

    local item = depth_items[key]

    if item ~= nil then
        item:set_visible(results.table_of(key) ~= nil)
    end
end

-- What the block holds for the last result: "d" a userdata's line, "t" a Value list, "f" a Parameters list
local function kind_of(key: string): string

    local kind = ""

    if results.detail_of(key) ~= nil then
        kind ..= "d"
    end

    if results.table_of(key) ~= nil then
        kind ..= "t"
    end

    if results.function_lines(key) ~= nil then
        kind ..= "f"
    end

    return kind
end

-- The Parameters list under the Variable line: there while the last result is a function that was only read.
-- Made with the block; here only what is in it follows
local function update_function_list(key: string): void

    local shown = result_functions[key]

    if shown == nil or shown.list == nil then
        return
    end

    local lines, count = results.function_lines(key)

    if lines == nil then
        return
    end

    shown.list:set_name(text("loop.params_list"):format(count))

    local texts = {}

    for _, line in ipairs(lines) do
        table.insert(texts, line.text)

        for _, inner in ipairs(line.children or {}) do
            table.insert(texts, inner.text)
        end
    end

    local shape = table.concat(texts, "\n")

    if shape == shown.shape then
        return
    end

    -- A parameter is a divider, its default under it; a type made of more is a list
    local ok = pcall(function()
        shown.list:clear()
        for _, line in ipairs(lines) do
            if line.children ~= nil then
                local inner = shown.list:list({ name = line.text })

                for _, child in ipairs(line.children) do
                    inner:readonly_name({ name = child.text })
                end
            elseif line.title then
                shown.list:divider({ name = line.text })
            else
                shown.list:readonly_name({ name = line.text })
            end
        end
    end)

    -- The list is gone (its menu was left): nothing to show in
    if not ok then
        module.drop_lines(key)
        return
    end

    shown.shape = shape
end

-- Makes the whole block of the key in its list: the Variable line, the userdata's line, the Value list or the Parameters
-- list (made empty, filled after), then the tail and Table Depth. Made in this order, so it shows in this order
local function fill_block(key: string): void

    local block = blocks[key]
    local node = block.node
    local detail = results.detail_of(key)

    result_lines[key] = node:divider({ name = results.line(key) })
    detail_lines[key] = nil

    if detail ~= nil then
        detail_lines[key] = node:divider({ name = detail })
    end

    result_tables[key] = { node = node, list = nil, shape = nil, texts = {}, lines = {} }
    result_functions[key] = { node = node, list = nil, shape = nil }

    if results.table_of(key) ~= nil then
        result_tables[key].list = node:list({ name = text("loop.result_list"):format(0) })
    end

    if results.function_lines(key) ~= nil then
        result_functions[key].list = node:list({ name = text("loop.params_list"):format(0) })
    end

    block.kind = kind_of(key)

    if block.tail ~= nil then
        block.tail(node)
    end

    update_result_list(key)
    update_function_list(key)
end

-- The kind of the result changed: the block is taken away from the Variable line to the end of the list and made again
local function rebuild_block(key: string): void

    local block = blocks[key]
    local node = block.node
    local line = result_lines[key]
    local index = nil

    for i, child in ipairs(node.children) do
        if child == line then
            index = i
            break
        end
    end

    -- The line isn't in its list any more (the list was made again): nothing to change
    if index == nil then
        module.drop_lines(key)
        return
    end

    local ok = pcall(function()
        node:clear_from(index)
        fill_block(key)
    end)

    -- The list is gone (its menu was left): nothing to show in
    if not ok then
        module.drop_lines(key)
    end
end

-- What a key gave changed: its items follow
results.on_change(function(key: string)

    local block = blocks[key]

    if block == nil then
        return
    end

    if kind_of(key) ~= block.kind then
        rebuild_block(key)
        return
    end

    local detail = results.detail_of(key)
    local line = result_lines[key]

    update_result_list(key)
    update_function_list(key)

    if detail ~= nil and detail_lines[key] ~= nil then
        detail_lines[key]:set_name(detail)
    end

    if line == nil then
        return
    end

    if not line:set_name(results.line(key)) then
        log:debug($"{key}: Variable line not updated")
    end
end)

-- A function's Variable line, the line of a userdata's value, its Value list or Parameters list, made in its list (node)
-- as one block at the end of it
-- @param kept The lines belong to a list outside Modules (Debug > Call Function), so forget_lines leaves them
-- @param tail function(node): the items under them, made in the same block (the block is made again as a whole, and
-- what is under it would be taken away); Table Depth (add_depth) is made by it
function module.add_result_lines(node: table, key: string, kept: ?bool, tail: ?function): void

    blocks[key] = { node = node, tail = tail, kind = "" }

    if kept then
        kept_keys[key] = true
    end

    fill_block(key)
end

-- Table Depth: how many levels of tables inside the table open as lists. Made by the caller after the tail, then moved
-- right under what the result shows (node:move_after), above the tail. The user's change makes the Value list again
-- (its shape changes)
-- @param kept The item belongs to a list outside Modules, so forget_lines leaves it
function module.add_depth(node: table, key: string, kept: ?bool): void

    depth_items[key] = node:scope("modules"):slider({ key = "loop.table_depth", min = 1, max = 8,
        default = results.depth(key), step = 1, on_change = function(depth: int, previous, click_type)

            if clicks.is_stopping() or not clicks.is_user_click(click_type) then
                return
            end

            results.set_depth(key, depth)
            update_result_list(key)
        end })

    if kept then
        kept_keys[key] = true
    end

    -- Right under what the result shows (the Value list, the Parameters list, the userdata line or the Variable line),
    -- above what the caller has under them (the result tools): the item is made last, so it is moved up
    local anchor = result_lines[key]

    if detail_lines[key] ~= nil then
        anchor = detail_lines[key]
    end

    if result_tables[key] ~= nil and result_tables[key].list ~= nil then
        anchor = result_tables[key].list
    end

    if result_functions[key] ~= nil and result_functions[key].list ~= nil then
        anchor = result_functions[key].list
    end

    if anchor ~= nil then
        node:move_after(depth_items[key], anchor)
    end

    show_depth(key)
end

-- The list the key's lines are in was gone back out of: they're gone, so a loop that still gives results
-- doesn't write into them (Stand says CommandRef is not valid for a deleted list)
function module.drop_lines(key: string): void
    result_lines[key] = nil
    blocks[key] = nil
    detail_lines[key] = nil
    result_tables[key] = nil
    result_functions[key] = nil
    depth_items[key] = nil
    kept_keys[key] = nil
end

-- The Modules list was gone back out of: its lines are gone, what the calls gave is still remembered
function module.forget_lines(): void

    local lines, details, tables, depths, functions, kept_blocks = {}, {}, {}, {}, {}, {}

    for key in pairs(kept_keys) do
        lines[key] = result_lines[key]
        kept_blocks[key] = blocks[key]
        details[key] = detail_lines[key]
        tables[key] = result_tables[key]
        depths[key] = depth_items[key]
        functions[key] = result_functions[key]
    end

    result_lines = lines
    blocks = kept_blocks
    detail_lines = details
    result_tables = tables
    depth_items = depths
    result_functions = functions
end

-- Variables: a table's entries and a module's fields

-- How often an open Variables list looks at the values again, ms
local VARIABLES_REFRESH_MS = 250

-- Makes the items in list
-- scope: the key of the Value list the items are for (nil - the module's Variables: all lines are read only)
-- call_on: the functions are lists to call (with the panel, made when opened)
-- edit_on: the other values are fields to type a new value in
-- @return path -> the item of each line, to change its value later; and the set of paths whose name carries
--         the value ("name: value"), which is changed with it
local function build_variables(list: table, items: table, scope: ?string, call_on: ?bool, edit_on: ?bool): table

    local lines = {}
    local named = {}

    if #items == 0 then
        list:readonly_name({ name = label("no_variables") })
        return lines, named
    end

    -- The items by the list they belong to: a table's entries are made when its list is opened, and gone when it's
    -- left, so a big table costs only the level that's open
    local children = {}
    local number = 0

    for _, item in ipairs(items) do
        children[item.parent] ??= {}
        table.insert(children[item.parent], item)
    end

    -- Makes the entries of the list at parent_path in node
    local function make(node: table, parent_path: string): void

        for _, item in ipairs(children[parent_path] or {}) do

            if item.kind == "list" then

                local path = item.path

                node:list({ name = item.name,
                    fill = |inner| -> make(inner, path),
                    on_back = function()
                        -- What was made in it is gone: its lines aren't changed any more
                        for line_path in pairs(lines) do
                            if line_path:sub(1, #path + 1) == $"{path}/" then
                                lines[line_path] = nil
                                named[line_path] = nil
                            end
                        end
                    end })
            elseif item.kind == "line" and item.holder ~= nil and not item.is_function and edit_on then

                -- A value: a field with it typed as an expression (5, true, "text", v3.new(1, 2, 3), nil)
                number += 1
                named[item.path] = true
                lines[item.path] = node:text_input({ name = $"{item.name}: {item.text}", help = label("edit.help"),
                    commands = { $"tablevaredit{results.scope_number(scope)}_{number}" }, default = item.text,
                    user_only = true, on_change = function(value)
                        if results.edit(item, value) then
                            update_result_list(scope)
                        end
                    end })
            elseif item.kind == "line" and item.holder ~= nil and item.is_function and call_on
                and call_function().is_available() then

                -- A function: a list with the panel of Debug > Call Function (arguments, Call, Call After, Loop, ...),
                -- without the name and the notice in Stand. The panel is made when the list is opened. Only while
                -- the CallFunction module runs, which calls it: else it's a line like the others
                number += 1
                named[item.path] = true

                local id = $"{scope}{item.path}"
                local panel = nil
                local args_command = $"tablefnargs{results.scope_number(scope)}_{number}"
                local entry = nil

                entry = node:list({ name = logic.item_title(item), help = label("loop.help"),
                    fill = function(inner)
                        panel = call_function().panel(inner, {
                            key = id,
                            state = results.fn_state(id),
                            -- A field for each parameter the code says (nil for a function that says nothing: one
                            -- Arguments field)
                            sig = arguments().signature_of(item.holder[item.raw_key]),
                            name = || -> item.name,
                            -- The function as it is in its table now; a plain call, without self
                            target = function()
                                local fn = item.holder[item.raw_key]
                                if type(fn) ~= "function" then
                                    return false
                                end
                                return true, fn
                            end,
                            args_command = args_command,
                        })
                    end,
                    on_open = function()
                        if panel ~= nil then
                            panel.opened()
                        end
                    end,
                    on_back = function()
                        panel = nil
                    end })

                lines[item.path] = entry
            elseif item.kind == "line" then
                lines[item.path] = node:readonly({ name = item.name, value = item.text })
            else
                node:readonly_name({ name = item.name })
            end
        end
    end

    make(list, "")

    return lines, named
end

-- Shows an entry's new value on its line; a named one ("name: value") in its name too. A function's list
-- takes no value: it stays as it is
local function set_line(line: ?table, item: table, named: ?bool): void

    if line == nil then
        return
    end

    if named then
        line:set_name(logic.item_title(item))
    end

    line:set_value(item.text)
end

-- The Value list under a function's Variable line: what a table it gave holds, a line or list per entry
-- like Variables. Made with the block, only while it gave a table; changed values change in place, entries that came or
-- went make the list again
update_result_list = function(key)

    local shown = result_tables[key]

    if shown == nil then
        return
    end

    local items, count = results.items(key)

    show_depth(key)

    -- The list is made with the block, while the result is a table: nothing to follow without it
    if items == nil or shown.list == nil then
        return
    end

    shown.list:set_name(text("loop.result_list"):format(count))

    -- A table that is only looked at (named without {}): nested tables are lists, but its functions can't be called
    -- and its values can't be changed
    local call_on = results.is_opened(key)
    local edit_on = call_on
    local shape = logic.shape_of(items)

    if call_on then
        shape = shape .. "\ncall"
    end
    if edit_on then
        shape = shape .. "\nedit"
    end

    if shape ~= shown.shape then
        local ok, lines, named = pcall(function()
            shown.list:clear()
            return build_variables(shown.list, items, key, call_on, edit_on)
        end)

        -- The list is gone (its menu was left): nothing to show in, so it's forgotten
        if not ok then
            module.drop_lines(key)
            return
        end

        shown.shape = shape
        shown.lines, shown.named = lines, named
        shown.texts = {}
        for _, item in ipairs(items) do
            shown.texts[item.path] = item.text
        end
        return
    end

    for _, item in ipairs(items) do
        if item.kind == "line" and shown.texts[item.path] ~= item.text then
            shown.texts[item.path] = item.text
            set_line(shown.lines[item.path], item, (shown.named or {})[item.path])
        end
    end
end

-- The Variables list: a line per field, "count: 0" (texts in quotes), a list per table field.
-- Made when it's opened, gone on going back out; while it's open the values are looked at again every
-- VARIABLES_REFRESH_MS: changed values change in place, a field or entry that came or went makes the list again
-- @param hidden_of function(mod): the fields not shown, as a set (the module's debug.hide)
function module.variables_list(node: table, module_name: string, hidden_of): void

    -- The current opening: a newer one (or going back) ends the refresh of the one before
    local opened = nil

    node:scope("modules"):list({ key = "variables", on_back = function() opened = nil end, fill = function(list)

        local this = {}
        local items = logic.collect_variables(module_name, hidden_of) or {}
        local shape = logic.shape_of(items)
        local texts = {}
        local lines = build_variables(list, items)
        local next_look = util.current_time_millis() + VARIABLES_REFRESH_MS

        opened = this

        for _, item in ipairs(items) do
            texts[item.path] = item.text
        end

        util.create_tick_handler(function()
            if clicks.is_stopping() or opened ~= this then
                return false
            end

            local now = util.current_time_millis()
            if now < next_look then
                return true
            end

            next_look = now + VARIABLES_REFRESH_MS

            local fresh = logic.collect_variables(module_name, hidden_of)
            if fresh == nil then
                return false
            end

            local fresh_shape = logic.shape_of(fresh)
            if fresh_shape ~= shape then
                -- Something came or went: made again
                list:clear()
                shape = fresh_shape
                texts = {}
                lines = build_variables(list, fresh)
                for _, item in ipairs(fresh) do
                    texts[item.path] = item.text
                end
                return true
            end

            for _, item in ipairs(fresh) do
                if item.kind == "line" and texts[item.path] ~= item.text then
                    texts[item.path] = item.text
                    set_line(lines[item.path], item)
                end
            end

            return true
        end)
    end })
end

return module
