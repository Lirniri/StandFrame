-- lib/AnitaDarin/ui/stand/modules/place.pluto
--
-- The Modules place in the script's settings (Debug): the "Debug" divider and the Modules list, shown in
-- debug mode, and the items put under the divider's visibility (debug_only).
-- Light on purpose: ui/stand/modules/list - the list's items, the script's biggest file with the parsers
-- it needs - loads only when the list is first opened, not at every start.
-- Strings: core/language "modules"

local i18n = Atdar.loader.load("core/i18n")
local live = Atdar.loader.load("ui/stand/core/live")
local MenuItem = Atdar.loader.load("ui/stand/core/menu_item")
local call_loop = Atdar.loader.load("ui/logic/stand/call_loop")
local display = Atdar.loader.load("ui/stand/core/call_display")

local module = {}

-- Strings under "modules"
local label = i18n.scope("modules")

-- Debug mode, as the profile last said
local debug_mode = Atdar.debug == true

-- The loops of called functions (Call Function here, a module's functions in the list) put their time and
-- result on screen. Bound at the start: Call Function's loops run before the Modules list is ever opened
call_loop.bind({ timed = display.timed, draw = display.draw })

local function is_debug(): bool
    return debug_mode
end

-- A MenuItem for what a maker gave: the item itself, or a Stand ref from a menu made the old way
local function item_of(made): table

    if type(made) == "table" and made.shown_when ~= nil then
        return made
    end

    return new MenuItem(made)
end

-- Puts an item made after build() under the "Debug" divider's visibility: shown only in debug mode
-- @param made A MenuItem (or a Stand ref)
function module.debug_only(made): void
    item_of(made):shown_when(is_debug)
end

-- The list's items, loaded the first time they're needed
local function modules_menu(): table
    return Atdar.loader.load("ui/stand/modules/list")
end

-- Puts a Modules list into node (a MenuNode), its items made only while it's open; the file that makes
-- them loads when it's first opened
-- @return The list (a MenuNode)
function module.list_in(node: table): table

    local list = nil

    list = node:list({ name = label("name"), help = label("help"),
        on_back = || -> modules_menu().close(list), on_open = || -> modules_menu().open(list) })

    return list
end

-- Puts one module's list into node: its status, Start / Restart / Stop / Reload and its functions, made only
-- while it's open (ui/stand/modules/list, which loads now)
-- @return The list (a MenuNode), nil if there's no such module
function module.module_in(node: table, name: string): ?table
    return modules_menu().module_in(node, name)
end

-- The place in the script's settings: the "Debug" divider and the Modules list (shown in debug mode).
-- before_list: a function(parent), or an array of them, that make items right under the divider, above Modules,
-- each in its order; every one returns its item (or the item's handle), which is shown in debug mode too
function module.build(parent: table, before_list: ?function|table): void

    local makers = before_list

    -- The manager failed to load: the loader left an empty table
    if Atdar.modules == nil or type(Atdar.modules.names) ~= "function" then
        return
    end

    if type(before_list) == "function" then
        makers = { before_list }
    end

    parent:divider({ name = label("debug.divider"), shown_when = is_debug })

    for _, make in ipairs(makers or {}) do
        module.debug_only(make(parent))
    end

    module.list_in(parent):shown_when(is_debug)
end

-- The items follow at once: whether live's own refresh ran before this one is up to the order of the listeners
Atdar.profile.on_change(function(key: string, value)
    if key == "debug" then
        debug_mode = value == true
        live.refresh()
    end
end)

return module
