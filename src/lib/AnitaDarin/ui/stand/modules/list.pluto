-- Modules list in the script's settings section, shown only in debug mode: each module a list with its
-- status, deps and error, Start / Restart / Stop / Reload, and under the Options divider the Function Call list
-- with the module's own functions to call by hand (Module.functions_of): a list for each, with a field for every
-- parameter by the type the module's code says for it (ui/stand/core/arguments). The Options divider and Function
-- Call are shown only while the module runs. Strings live in core/language under "modules".
-- Restart runs the same module again; Reload re-reads its file, so code changes apply. The system modules
-- (modules/systems, used by the script's menus) are listed only while Show System Modules is on
--
-- The list's items are made when it's opened and removed when the user goes back out of it, so nothing
-- of it is in the menu while no one looks. In the script's settings the list shows in debug mode only; it's
-- always made and only hidden: rebuilding the section when debug is switched would delete the Profile list
-- the user is in, which Stand doesn't do cleanly.
--
-- Only the items are here. What they say and do - names, actions, calls, loops, how a module's functions are
-- laid out - is in ui/logic/stand/modules.
--
-- Into other menus (a pack's lists), made the same way, only while open:
--     modules_menu.list_in(node)                     -- the whole Modules list
--     modules_menu.module_in(node, "VehicleManager")  -- one module's list: status, actions, functions

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local Logger = Atdar.loader.load("core/logger")
local logic = Atdar.loader.load("ui/logic/stand/modules")
local call_loop = Atdar.loader.load("ui/logic/stand/call_loop")
local display = Atdar.loader.load("ui/stand/core/call_display")
-- The fields of a function's arguments
local arguments = Atdar.loader.load("ui/stand/core/arguments")
-- What calls gave and the module's variables, shown (Variable lines, Value and Variables lists)
local values = Atdar.loader.load("ui/stand/modules/values")
-- A module's on_tick run by hand (its on_tick() list)
local ticks = Atdar.loader.load("ui/stand/modules/ticks")
local live = Atdar.loader.load("ui/stand/core/live")

local log = new Logger("Modules")

local module = {}

-- Strings under "modules"
local label = i18n.scope("modules")

-- The loops of a module's functions put their time and result on screen
call_loop.bind({ timed = display.timed, draw = display.draw })

-- The open Modules list's items: list (the MenuNode), entries / statuses (MenuItems) and sections (to make
-- the functions again) per module name. Empty while no Modules list is open
local view = {}

-- A function's key -> the Loop Status line and the Loop switch in its list
local loop_statuses = {}
local loop_toggles = {}

-- Statuses also change on their own (a module can fail in its tick), so Refresh and every action
-- update all entries. An item may belong to a section that was already removed: its update does nothing.
-- The items shown while a module runs follow too: its Function Call list, Debug's Call Function
local function refresh(): void

    local modules = Atdar.modules

    for name, entry in pairs(view.entries or {}) do
        if modules.has(name) then

            local mod = modules.get(name)
            local status = (view.statuses or {})[name]

            entry:set_name(logic.caption(mod))
            entry:set_help(logic.help(mod))

            if status ~= nil then
                status:set_name(logic.status_line(mod))
            end
        end
    end

    live.refresh()
end

-- What the on_tick runs need of this list
ticks.bind({
    short_name = logic.short_name,
    refresh = refresh,
    -- The module's Status divider: "running by hand" while a run goes on
    status_changed = function(module_name)

        local status = (view.statuses or {})[module_name]

        if status ~= nil and Atdar.modules.has(module_name) then
            status:set_name(logic.status_line(Atdar.modules.get(module_name)))
        end
    end,
})

-- A function's loop started, stopped or failed: its Loop switch follows (on while it runs, also with an
-- interval) without starting or stopping anything, its status line says it
logic.on_loop = function(key, kind, every)

    local toggle = loop_toggles[key]
    local status = loop_statuses[key]

    if toggle ~= nil then
        toggle:set_value(kind == "running" or kind == "every")
    end

    if status == nil then
        return
    end

    if not status:set_name(call_loop.status_line(kind, every)) then
        log:debug($"{key}: Loop Status line not updated")
    end
end

-- The Arguments list of a function: a field for each parameter, by its type. A field that becomes a list
-- (a function called in it) makes the fields again
local function arguments_list(node: table, mod: table, fn: table, state: table): void

    local args_list = node:list({ name = label("loop.args"), help = label("loop.args_help") })
    local fields = nil

    -- Call and the loops use what's typed. Stand's text fields take their text through the command box, so
    -- each needs a command: short and the same each time - "moduleargsfor3_2_1": the module's number, the
    -- function's, the parameter's. They're not among the found commands
    fields = args_list:section(function(list)
        arguments.build(list, {
            sig = fn.sig,
            texts = state.texts,
            command = |index| -> $"moduleargsfor{logic.number_of(mod.name)}_{fn.number or 0}_{index}",
            -- Typed by the user (not Stand putting the field back), with Call After Typing on
            on_typed = function()
                if state.on_enter then
                    logic.call_typed(mod, fn)
                end
            end,
            about = |name| -> logic.param_about(mod, fn, name),
            on_reshape = || -> fields.rebuild(),
        })
    end)
end

-- A function of the module: a list of its arguments (when it has parameters), Call Settings, Call, Call After,
-- Call When Opened / Hovered, the loop's status, Loop, Loop With Interval, then what it gave
local function function_list(entry: table, mod: table, fn: table): void

    local key = logic.key_of(mod.name, fn.name)
    local state = logic.state_of(mod, fn)
    local live = logic.is_live(mod, fn)
    -- The current opening of the list: going back (or opening again) ends the live calls of the one before
    local opening = nil
    local node = entry:list({ name = logic.item_name(fn), help = logic.function_help(mod, fn),
        on_back = function()
            opening = nil
        end,
        on_open = function()
            if state.on_open then
                logic.call_typed(mod, fn)
            end

            if live then
                local this = {}
                opening = this
                logic.keep_live(mod, fn, || -> opening == this)
            end
        end,
    })
    local ui = node:scope("modules")

    -- The cursor on the function's list (not inside it)
    node:on_focus(function()
        if state.on_focus then
            logic.call_typed(mod, fn)
        end
    end)

    if arguments.has_fields(fn.sig) then
        arguments_list(node, mod, fn, state)
    end

    -- The settings of calling, under the arguments: Call After Typing (when there are arguments), Call, ...
    ui:divider({ name = label("loop.settings") })

    if arguments.has_fields(fn.sig) then
        ui:toggle({ key = "loop.call_on_enter", default = state.on_enter == true,
            on_change = function(on) state.on_enter = on or nil end })
    end

    -- Call; with a number of ms picked, Call After
    Atdar.loader.load("ui/stand/core/call_slider").build(node, {
        name_now = label("loop.call"),
        name_after = label("loop.call_after.name"),
        help = label("call.button.help"),
        call = || -> logic.call_typed(mod, fn),
        call_after = |ms| -> logic.call_after(mod, fn, ms),
    })

    ui:toggle({ key = "loop.call_on_open", default = state.on_open == true,
        on_change = function(on) state.on_open = on or nil end })

    ui:toggle({ key = "loop.call_on_focus", default = state.on_focus == true,
        on_change = function(on) state.on_focus = on or nil end })

    -- What its loop puts on the screen: the time of a call and what it gave
    ui:toggle({ key = "loop.show_time", default = state.show_time ~= false,
        on_change = function(on) state.show_time = on end })

    ui:toggle({ key = "loop.show_result", default = state.show_result ~= false,
        on_change = function(on) state.show_result = on end })

    -- How its loop is: the status line, Loop, Loop With Interval. Above what it gave, so the table settings
    -- made under the Value list are the last items
    loop_statuses[key] = ui:divider({ name = call_loop.status_line(logic.loop_status(key)) })

    -- On: every frame; off: the loop stops, also one started with an interval. Made as the loop is now
    loop_toggles[key] = ui:toggle({ key = "loop.loop", default = logic.is_looping(key), on_change = function(on)
        if clicks.is_stopping() then
            return
        end

        logic.set_loop(mod, fn, on)
    end })

    ui:click_slider({ key = "loop.every", min = 100, max = 60000, default = 1000, step = 100, user_only = true,
        on_click = |ms| -> logic.start_loop(mod, fn, ms) })

    -- What it gave last and, for a table, its Value list right under
    values.add_result_lines(node, key)

    -- The table settings, while the last result is a table, at the end: right under the Value list.
    -- How deep a table it gave opens in the Value list, the functions in the table become lists with the
    -- panel of Debug > Call Function, the other values become fields to type a new value in
end

-- The Module Functions list (its Variables, then a list per function of the module, as logic.layout puts
-- them), then the Base Functions with the hooks
local function functions_of(entry: table, mod: table): void

    local layout = logic.layout(mod)
    local ui = entry:scope("modules")
    local functions_node = ui:list({ key = "functions" })
    -- The hooks: a Base Functions list like a category, or with categories off a section under its divider
    local hooks_node = entry

    values.variables_list(functions_node, mod.name, logic.hidden_of)

    -- debug.groups first, in the module's order, each under its divider
    for _, group in ipairs(layout.groups) do
        functions_node:divider({ name = group.name })
        for _, fn in ipairs(group.functions) do
            function_list(functions_node, mod, fn)
        end
    end

    -- The rest under Functions: first a list per category with functions in it (Getters, Setters...),
    -- then the ones in none ("No functions" when there are none at all)
    if layout.divider then
        functions_node:divider({ name = label("functions.divider") })
    end

    if layout.none then
        functions_node:readonly_name({ name = label("no_functions") })
    end

    for _, category in ipairs(layout.categories) do
        local category_node = functions_node:list({ name = category.name })
        for _, fn in ipairs(category.functions) do
            function_list(category_node, mod, fn)
        end
    end

    for _, fn in ipairs(layout.loose) do
        function_list(functions_node, mod, fn)
    end

    -- At the bottom: the module's helpers named with _, then its private ones named with __
    -- (callable the same way)
    for _, part in ipairs(layout.parts) do
        functions_node:divider({ name = label(part.key) })
        for _, fn in ipairs(part.functions) do
            function_list(functions_node, mod, fn)
        end
    end

    if logic.categories_off(mod.name) then
        ui:divider({ name = label("base_functions.name") })
    else
        hooks_node = ui:list({ key = "base_functions" })
    end

    for _, hook in ipairs(layout.hooks) do
        -- on_tick runs every frame, so it's a list to start and stop, not a button
        if hook.tick then
            ticks.list(hooks_node, mod, hook.name)
        else
            hooks_node:action({ name = hook.name, help = label("call.hook.help"),
                on_click = || -> logic.call(mod.name, hook.hook, {}, 0) })
        end
    end
end

-- After Reload: the module's code is new, so its Base Functions and Module Functions are made again
local function rebuild_functions(name: string): void

    local section = (view.sections or {})[name]

    if section == nil or not Atdar.modules.has(name) then
        return
    end

    section.rebuild()
end

-- A module's items in its list (entry): Status, Start / Restart / Stop / Reload, then its functions
local function fill_module(entry: table, name: string): void

    local mod = Atdar.modules.get(name)
    local ui = entry:scope("modules")
    -- Its functions are shown only while it runs: a stopped or failed module has nothing to call them on
    local running = || -> Atdar.modules.is_running(name)

    view.statuses[name] = ui:divider({ name = logic.status_line(mod) })

    for _, action in ipairs(logic.ACTIONS) do
        ui:action({ name = label(action), on_click = function()
            logic.run_action(action, name)
            if action == "reload" then
                rebuild_functions(name)
            end
            refresh()
        end })
    end

    -- Nothing else is under it: hidden with the list
    ui:divider({ name = label("options.divider"), shown_when = running })

    -- The module's functions to call by hand, with the toggle that decides how they're laid out
    local calls = ui:list({ key = "function_call", shown_when = running })

    -- Before the functions, so making them again (below) leaves it where it is
    calls:toggle({ key = "no_categories", default = logic.categories_off(name), on_change = function(on)
        if clicks.is_stopping() or logic.categories_off(name) == on then
            return
        end

        logic.set_categories_off(name, on)
        rebuild_functions(name)
    end })

    -- The functions, made again by Reload with the module's new code
    view.sections[name] = calls:section(|node| -> functions_of(node, Atdar.modules.get(name)))
end

-- The modules reloaded have new code: their functions are made again, every status is updated
local function reloaded(names: table): void
    for _, name in ipairs(names) do
        rebuild_functions(name)
    end

    refresh()
end

-- A list for one module in the node, with its status, actions and functions. Opening it and going back out
-- look at the statuses and files again: they change while one is inside (a module failing, a file synced),
-- and a name left behind would say what was
local function add_entry(node: table, name: string): void

    local mod = Atdar.modules.get(name)
    local entry = node:list({ name = logic.caption(mod), help = logic.help(mod), on_back = refresh, on_open = refresh })

    view.entries[name] = entry
    fill_module(entry, name)
end

-- Where a module's list goes: a system module into the System Modules list, made with the first of them
local function parent_of(node: table, name: string): table

    if not Atdar.modules.is_system(name) then
        return node
    end

    if view.system == nil then
        view.system = node:list({ name = label("system.name"), help = label("system.help"), on_back = refresh,
            on_open = refresh })
    end

    return view.system
end

-- Refresh: the new module files are run and their modules join the end of the list (the list the user is
-- in isn't made again: Stand doesn't take that cleanly), then every status is updated
local function refresh_with_new(node: table): void

    logic.load_new_files()

    for _, name in ipairs(logic.listed_names()) do
        if view.entries[name] == nil then
            add_entry(parent_of(node, name), name)
        end
    end

    refresh()
end

-- The modules' lists, the system ones in a System Modules list of their own only while Show System Modules is on
local function fill_entries(node: table): void

    local names = logic.listed_names()

    view.entries = {}
    view.statuses = {}
    view.sections = {}
    view.system = nil

    for _, name in ipairs(names) do
        add_entry(parent_of(node, name), name)
    end

    if #names == 0 then
        node:scope("modules"):readonly_name({ name = label("empty") })
    end
end

-- The open list's items: actions, then a list per module
local function fill(node: table): void

    local ui = node:scope("modules")

    -- Left from a time the user didn't go back out of it (the menu closed): made again
    node:clear()
    view = { list = node, entries = {}, statuses = {}, sections = {} }

    ui:action({ key = "open_folder", on_click = logic.open_folder })
    ui:action({ key = "refresh", on_click = || -> refresh_with_new(node) })

    ui:action({ key = "stop_all", on_click = function()
        logic.stop_all()
        refresh()
    end })

    ui:action({ key = "reload_changed", on_click = function()
        reloaded(logic.reload_changed())
        refresh_with_new(node)
    end })

    ui:action({ key = "reload_all", on_click = || -> reloaded(logic.reload_all()) })

    -- The modules' lists below are made again: the list the user is in stays
    local entries = nil

    ui:toggle({ key = "show_system", default = logic.shows_system(), on_change = function(on)
        if clicks.is_stopping() or logic.shows_system() == on then
            return
        end

        logic.set_show_system(on)
        entries.rebuild()
    end })

    ui:divider({ name = label("list.divider") })

    -- Files added since the start are run first, so their modules are in the list
    logic.load_new_files()

    entries = node:section(fill_entries)
end

-- Going back out: the items go; loops and runs by hand keep going (their Status shows again on opening)
local function empty(node: table): void

    node:clear()

    if view.list ~= node then
        return
    end

    view = {}
    ticks.forget_lines()
    loop_statuses = {}
    loop_toggles = {}
    values.forget_lines()
end

-- A value as it's shown in a call's notice (ui/logic/stand/values)
module.describe = values.describe

-- Adds words to a category of functions, or a category of its own, for every module (ui/logic/stand/modules)
module.add_category = logic.add_category

-- Puts a Modules list into node (a MenuNode, e.g. a pack's list), its items made only while it's open
-- @return The list (a MenuNode)
function module.list_in(node: table): table

    local list = nil

    list = node:list({ name = label("name"), help = label("help"),
        on_back = || -> empty(list), on_open = || -> fill(list) })

    return list
end

-- Puts one module's list into node: its status, Start / Restart / Stop / Reload and its functions, made
-- only while it's open. Named like in the Modules list ("1: VehicleManager: running")
-- @return The list (a MenuNode), nil if there's no such module
function module.module_in(node: table, name: string): ?table

    local modules = Atdar.modules
    local entry = nil

    if not modules.has(name) then
        log:warn($"module_in: there's no module '{name}'")
        return nil
    end

    entry = node:list({ name = logic.caption(modules.get(name)), help = logic.help(modules.get(name)),
        on_back = function()
            empty(entry)
            -- Its name is out of the list it's in: made again here, with the status and file now
            if modules.has(name) then
                entry:set_name(logic.caption(modules.get(name)))
                entry:set_help(logic.help(modules.get(name)))
            end
        end,
        on_open = function()
            entry:clear()
            view = { list = entry, entries = { [name] = entry }, statuses = {}, sections = {} }
            fill_module(entry, name)
        end,
    })

    return entry
end

-- The list's items: made on opening it, gone on going back out (modules_place's list calls these)
function module.open(list: table): void
    fill(list)
end

function module.close(list: table): void
    empty(list)
end

return module
