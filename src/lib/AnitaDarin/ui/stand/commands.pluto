-- Builds Stand command names for menu items: base name -> prefix + separator + base,
-- and renames every tracked item right away when the prefix settings change.
-- The script's own commands (Base Commands) and the loaded menu's (Found Commands) each have their own
-- prefix and separator, so the same base name in both can't clash (atdar_settings and atdarsettings).
--
-- Every item can have a custom name: it takes the base name's place, the prefix stays
-- (godmode -> god gives atdargod). Custom names are kept in a commands.json of whoever made the item:
--   the loaded menu - the menu's own folder (ui/stand/menu passes it to begin_menu): the pack's in store,
--                     or core's for the built-in menu
--   the script      - store/<script>/commands.json
-- Items made between begin_menu() and end_menu() are the menu's, all others the script's

local Logger = Atdar.loader.load("core/logger")
local JsonFile = Atdar.loader.load("core/filesystem/json/file")

local log = new Logger("Commands")

local module = {}

-- Prefix and separator of each owner: "script" (Base Commands) and "menu" (Found Commands)
local config = {
    use_prefix = true,
    script = { prefix = "atdar", separator = "" }, -- separator "" -> atdargodmode, "_" -> atdar_godmode
    menu = { prefix = "atdar", separator = "" },
}

-- ref -> base names it was created with
local tracked = {}
-- ref -> "menu" or "script": whose item it is, so whose custom names apply
local owner = {}
-- Set while the loaded menu builds: items made then are its own
local building_menu = false

-- Custom names of each owner: base name -> custom base name (both sanitized), and the file they're kept in.
-- The script's file is read on first use: tests (and a renamed script) point store elsewhere before that
local custom = { menu = {}, script = nil }
local files = { menu = nil, script = nil }

-- Lowercase, keeps only a-z, 0-9 and _
function module.sanitize(name: string): string
    local clean = name:lower():gsub("[^%w_]", "")
    return clean
end

-- A commands.json's content -> custom names, keeping only sound ones
local function read_custom(file: table): table
    local names = {}
    for base, name in pairs(file:read() or {}) do
        if type(base) == "string" and type(name) == "string" then
            local clean_base, clean_name = module.sanitize(base), module.sanitize(name)
            if clean_base ~= "" and clean_name ~= "" and clean_name ~= clean_base then
                names[clean_base] = clean_name
            end
        end
    end
    return names
end

-- The script's custom names, read from store/<script>/commands.json the first time they're needed
local function script_custom(): table
    if custom.script == nil then
        files.script = new JsonFile($"{filesystem.store_dir()}{Atdar.name}\\commands.json")
        custom.script = read_custom(files.script)
    end
    return custom.script
end

local function custom_of_owner(who: string): table
    if who == "menu" then
        return custom.menu
    end
    return script_custom()
end

-- @return Sanitized base names without empty ones and duplicates. "" is no command, quietly
-- ({ "" } reads as "this item has none"); a name with nothing usable in it is warned about
local function clean_bases(bases: table, warn: bool): table
    local clean, seen = {}, {}
    for _, base in ipairs(bases) do
        local name = module.sanitize(base)
        if name == "" then
            if warn and base ~= "" then
                log:warn($"command '{base}' has no allowed characters (a-z, 0-9, _), skipped")
            end
        elseif not seen[name] then
            seen[name] = true
            table.insert(clean, name)
        end
    end
    return clean
end

-- The base as the owner's custom names have it
local function effective(clean: string, who: string): string
    return custom_of_owner(who)[clean] or clean
end

-- who: "script" or "menu", whose prefix and separator
local function full_name(clean: string, who: string): string
    local own = config[who] or config.script
    if config.use_prefix and own.prefix ~= "" then
        return $"{own.prefix}{own.separator}{clean}"
    end
    return clean
end

-- Whose items are being made now
local function current_owner(): string
    if building_menu then
        return "menu"
    end
    return "script"
end

-- @return Full command names for a list of base names, with the custom names of whoever makes the item now
function module.names(bases: table): table
    local names = {}
    local who = current_owner()
    for _, clean in ipairs(clean_bases(bases, true)) do
        table.insert(names, full_name(effective(clean, who), who))
    end
    return names
end

-- Remembers an item so refresh() can rename it; items without valid commands aren't tracked
function module.track(ref, bases: table): void
    -- Quiet: names() already warned about these when the item was created
    local clean = clean_bases(bases, false)
    if #clean > 0 then
        tracked[ref] = clean
        owner[ref] = current_owner()
    end
end

-- Must be called before an item is deleted, or refresh() would touch a deleted item
function module.untrack(ref): void
    tracked[ref] = nil
    owner[ref] = nil
end

-- @return An item's full command names with the current settings, or nil if it isn't tracked
function module.names_of(ref): ?table
    local clean = tracked[ref]
    if not clean then
        return nil
    end
    local names = {}
    for _, name in ipairs(clean) do
        table.insert(names, full_name(effective(name, owner[ref]), owner[ref]))
    end
    return names
end

-- @return An item's command names without the prefix ("godmode", or its custom name), or nil if it isn't tracked
function module.bases_of(ref): ?table
    local clean = tracked[ref]
    if not clean then
        return nil
    end
    local names = {}
    for _, name in ipairs(clean) do
        table.insert(names, effective(name, owner[ref]))
    end
    return names
end

-- ─── Custom names ────────────────────────────────────────────────────────────

-- @return The item's own first base name ("godmode"), whatever its custom name, or nil
function module.base_of(ref): ?string
    local clean = tracked[ref]
    if not clean then
        return nil
    end
    return clean[1]
end

-- @return The item's custom name ("god"), or "" while it has its own
function module.custom_of(ref): string
    local base = module.base_of(ref)
    if base == nil then
        return ""
    end
    return custom_of_owner(owner[ref])[base] or ""
end

-- @return "menu" or "script": whose item it is (where its custom name is kept), or nil if it isn't tracked
function module.owner_of(ref): ?string
    return owner[ref]
end

-- The loaded menu starts building. Its custom names are in file (a JsonFile: its commands.json)
-- and apply to everything it makes until end_menu()
function module.begin_menu(file: table): void
    files.menu = file
    custom.menu = read_custom(file)
    building_menu = true
end

function module.end_menu(): void
    building_menu = false
end

-- Writes an owner's custom names into its commands.json; with none left the file goes
-- @return Whether it was written
local function save(who: string): bool
    local file = files[who]
    if file == nil then
        return false
    end
    local names = custom_of_owner(who)
    if next(names) == nil then
        file:remove()
        return true
    end
    return file:write(names)
end

-- Gives an item's first command a custom base name and saves it; "" (or its own base) goes back to its own.
-- @return true, or false and why: "taken" (another item has that command already), "not_saved"
function module.set_custom(ref, name: string): (bool, ?string)
    local clean = tracked[ref]
    if not clean then
        return false, "unknown"
    end
    local names = custom_of_owner(owner[ref])
    local base = clean[1]
    local new_name = module.sanitize(name)
    if new_name == "" or new_name == base then
        names[base] = nil
    else
        -- Two items with one command: Stand would only find one of them
        for other in pairs(tracked) do
            if other ~= ref then
                for _, other_name in ipairs(module.bases_of(other)) do
                    if other_name == new_name then
                        return false, "taken"
                    end
                end
            end
        end
        names[base] = new_name
    end
    menu.set_command_names(ref, module.names_of(ref))
    if not save(owner[ref]) then
        return false, "not_saved"
    end
    return true, nil
end

-- @return { ref, names } for every item that has commands, sorted by the first name
function module.list(): table
    local items = {}
    for ref in pairs(tracked) do
        table.insert(items, { ref = ref, names = module.names_of(ref) })
    end
    table.sort(items, |a, b| -> a.names[1] < b.names[1])
    return items
end

-- Renames every tracked item with the current settings
function module.refresh(): void
    for ref in pairs(tracked) do
        menu.set_command_names(ref, module.names_of(ref))
    end
end

-- who: "script" (default) or "menu"
function module.set_prefix(prefix: string, who: string = "script"): void
    config[who].prefix = module.sanitize(prefix)
    module.refresh()
end

function module.set_use_prefix(use: bool): void
    config.use_prefix = use
    module.refresh()
end

-- "" or "_"; who: "script" (default) or "menu"
function module.set_separator(separator: string, who: string = "script"): void
    if separator ~= "" and separator ~= "_" then
        log:warn($"separator must be '' or '_', got '{separator}'")
        return
    end
    config[who].separator = separator
    module.refresh()
end

-- who: "script" (default) or "menu"
function module.get_config(who: string = "script"): table
    return { prefix = config[who].prefix, use_prefix = config.use_prefix, separator = config[who].separator }
end

-- Profile keys of each owner's prefix and separator
local PROFILE_KEYS = {
    command_prefix = { who = "script", what = "prefix" },
    command_separator = { who = "script", what = "separator" },
    found_command_prefix = { who = "menu", what = "prefix" },
    found_command_separator = { who = "menu", what = "separator" },
}

-- Prefixes and separators come from the script profile and follow its changes; an empty prefix means none
local profile = Atdar.profile
if profile and profile.get then
    for key, target in pairs(PROFILE_KEYS) do
        local value = profile.get(key)
        if target.what == "prefix" then
            -- No found_command_prefix in the profile (an old one): the same as the script's
            config[target.who].prefix = module.sanitize(value or profile.get("command_prefix") or "")
        else
            config[target.who].separator = (value == "_") ? "_" : ""
        end
    end
    profile.on_change(function(key: string, value)
        local target = PROFILE_KEYS[key]
        if target == nil then
            return
        end
        if target.what == "prefix" then
            module.set_prefix(value or "", target.who)
        else
            module.set_separator((value == "_") ? "_" : "", target.who)
        end
    end)
end

return module
