local load = require($"{Atdar.name}/core/loader")

local godmode = load("features/self/godmode")
local half_godmode = load("features/self/half_godmode")

local module = {}

function module.build(parent: table): table
    local submenu = { command = {} }

    submenu.root = menu.list(parent.root, "Self", {}, "")

    submenu.movement = load("ui/stand/menu/self/movement").build(submenu)

    submenu.command.godmode = menu.toggle_loop(submenu.root, "Godmode", {}, "",
        godmode.enable, godmode.disable)

    submenu.command.half_godmode = menu.toggle_loop(submenu.root, "Half-Godmode", {}, "",
        half_godmode.enable, half_godmode.disable)

    return submenu
end

return module
