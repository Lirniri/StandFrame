local load = Atdar.loader.load

local godmode = load("features/self/godmode")
local half_godmode = load("features/self/half_godmode")

local module = {}

function module.build(parent: table): table
    local submenu = { node = parent:list("Self"), command = {} }

    submenu.movement = load("ui/stand/menu/self/movement").build(submenu.node)

    submenu.command.godmode = submenu.node:add_feature(godmode, "Godmode")
    submenu.command.half_godmode = submenu.node:add_feature(half_godmode, "Half-Godmode")

    return submenu
end

return module
