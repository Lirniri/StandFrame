local load = require($"{Atdar.name}/core/loader")

local ragdoll_control = load("features/self/movement/ragdoll_control")

local module = {}

function module.build(parent: table): table
    local submenu = { node = parent:list("Movement"), command = {} }

    submenu.command.ragdoll_control = submenu.node:add_feature(ragdoll_control, "Ragdoll Control")

    return submenu
end

return module
