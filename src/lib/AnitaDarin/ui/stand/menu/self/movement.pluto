-- ui/stand/menu/self/movement.pluto
local load = require($"{Atdar.name}/core/loader")
local ragdoll_control = load("features/self/movement/ragdoll_control")

local module = {}

function module.build(parent: table): table
    local submenu = { command = {} }
    submenu.root = menu.list(parent.root, "Movement", {}, "")

    submenu.command.ragdoll_control = menu.toggle_loop(submenu.root, "Ragdoll Control", {}, "",
        ragdoll_control.enable, ragdoll_control.disable)

    return submenu
end

return module
