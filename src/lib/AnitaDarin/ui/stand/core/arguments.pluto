-- lib/AnitaDarin/ui/stand/core/arguments.pluto
--
-- The arguments of a function in the menu: a field for each parameter, by the type the code says for it.
-- Used by Debug > Call Function and by the functions of the Modules list.
--
--   arguments.build(list, { sig, texts, command, on_typed, about })   -- the fields in the list
--
-- Each parameter is a divider with its name and a text field under it named by the kind of value it takes:
-- Argument *, Function, Number, Float Number, 3D Vector, Table, Userdata, Text, Boolean. A function that takes
-- more (...) or whose parameters aren't known (Stand's natives) has one field of Arguments at the end.
-- A field whose text is one call of a function with known parameters - ENTITY.GET_ENTITY_COORDS(user_ped()) -
-- becomes a list (when the caller gives spec.on_reshape): the expression itself, then a field for each
-- parameter of that function, made the same way; typing in one writes the expression again. A vector3 field whose
-- text gives a vector (1, 2, 3 or v3.new(1, 2, 3)) becomes a list the same way: the expression, then x, y and z;
-- when the text isn't only numbers (a call that gives a vector) the values are there too, as a divider.
--
-- Only the fields are here. The signatures, the kinds and working the typed texts out into values are in
-- ui/logic/stand/arguments; its functions are here too (arguments.read, arguments.signature_of...), for the
-- menu files that have this one at hand.
-- Strings: core/language "arguments"

local i18n = Atdar.loader.load("core/i18n")
local clicks = Atdar.loader.load("ui/logic/stand/clicks")
local logic = Atdar.loader.load("ui/logic/stand/arguments")
-- The call written in brackets (#1(>1)): it names the lists of a call's arguments too
local call_template = Atdar.loader.load("ui/logic/stand/call_template")
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Arguments")

-- Everything of the logic, and build() below
local module = setmetatable({}, { __index = logic })

-- Strings under "arguments"
local label, text = i18n.scope("arguments")

-- The fields

-- Makes the fields in list: for each parameter its divider and a field, then Arguments for what's left.
-- spec.sig:       the signature (signature / signature_of)
-- spec.texts:     the table the typed texts are kept in
-- spec.command:   function(index) -> the field's command name; the index is the parameter's number or "rest"
--                 (Stand's text fields take their text through the command box, so each needs one)
-- spec.on_typed:  function() the user typed in a field (Stand putting a field back doesn't call it)
-- spec.about:     function(name) -> what the module says of the parameter, for the field's help (optional)
-- spec.on_reshape: function() a field's text became a call of a function with known parameters, or stopped
--                 being one: the caller makes the fields again (takes them away and calls build), and the
--                 field is a list then. Without it every parameter stays one field
-- spec.verbatim:  the fields hold the arguments as the code would write them (texts in quotes): the fields of
--                 a function called inside an argument, whose texts are put back into its expression
function module.build(list: table, spec: table): void

    local sig, texts = spec.sig, spec.texts

    -- What each field's text calls now (the path), and whether it is a vector, to see when that changes
    local calls = {}
    local vectors = {}

    -- What a vector3 field shows (below, with the vector list); typed_in asks it too
    local vector_view

    -- The vector lists made: index -> function(typed) that makes the list follow the text in place. Typing the
    -- expression doesn't make the list again (the user is in it): its lines and the call's arguments change
    local vector_updaters = {}

    -- The user typed in a field: its text kept, the fields made again when what it calls changed
    -- @param whole The field is the expression of a call's list: its fields follow any change of it
    -- @param item The field's item, to put back what it had when what was typed isn't what the parameter takes
    local function typed_in(index, value: string, click_type, whole: bool, item): void
        if clicks.is_stopping() then
            return
        end

        -- A boolean field takes true or false: anything else is told and the field goes back to what it had
        local param = sig.params[index]

        if param ~= nil and item ~= nil and clicks.is_user_click(click_type) then
            local wrong = module.check_typed(param, value)

            if wrong ~= nil then
                local before = texts[index] ?? module.default_of(param) ?? ""

                log:notify(wrong)
                item:set_value(before)
                return
            end
        end

        texts[index] = value

        if not clicks.is_user_click(click_type) then
            return
        end

        -- A vector list stays where it is while the text is a vector: it follows the text in place
        if vector_updaters[index] ~= nil then
            vector_updaters[index](value)

            if spec.on_typed ~= nil then
                spec.on_typed()
            end

            return
        end

        local call = spec.on_reshape ~= nil and index ~= "rest" and module.call_in(value) or nil
        local path = call?.path
        local is_vector = false

        if spec.on_reshape ~= nil and index ~= "rest" and sig.params[index] ~= nil
            and module.kind_of(sig.params[index].type) == "vector3" then
            is_vector = vector_view(value) ~= nil
        end

        if whole or path ~= calls[index] or is_vector ~= (vectors[index] == true) then
            spec.on_reshape()
        end

        if spec.on_typed ~= nil then
            spec.on_typed()
        end
    end

    -- A field; its command isn't one of the found commands (not renamed with the prefix settings)
    -- @return The field's item
    local function field(node: table, name_label, index, help: string, start: ?string, whole: bool = false): table

        local item = nil

        item = node:text_input({
            name = name_label,
            help = help,
            commands = { spec.command(index) },
            track = false,
            default = texts[index] or start or "",
            on_change = |value, click_type| -> typed_in(index, value, click_type, whole, item),
        })

        return item
    end

    -- A parameter whose text is a call: a list named by the expression, with the expression's own field and
    -- the fields of the function called. Typing in one of those writes the expression again
    local function call_list(name_text: string, index, help: string, call: table): void

        local nested = list:list({ name = $"{name_text}: {texts[index]}", help = help })
        local expression = field(nested, label("call.expression"), index, text("call.expression_help"), nil, true)
        local inner = module.texts_from(call.sig, table.concat(call.pieces, ", "))
        local fields = nil

        -- The fields of the function called, under the expression; a call inside this call makes only these again
        fields = nested:section(function(node)
            module.build(node, {
                sig = call.sig,
                texts = inner,
                verbatim = true,
                command = |sub| -> $"{spec.command(index)}_{sub}",
                on_typed = function()
                    texts[index] = module.compose(call.path, call.sig, inner)
                    nested:set_name($"{name_text}: {texts[index]}")
                    expression:set_value(texts[index])
                    if spec.on_typed ~= nil then
                        spec.on_typed()
                    end
                end,
                on_reshape = || -> fields.rebuild(),
            })
        end)
    end

    -- How a list of a call's arguments is named: the call with the arguments that are given, as in the Function Name -
    -- get_coords(#1), get_coords(#1, #2(>1)); no arguments given: get_coords()
    local function call_label(call: table, given: table): string
        return $"{call.path}({call_template.auto_of(call.sig, given) ?? ""})"
    end

    -- The name of a vector's list: the kind and what is typed, when something is
    local function vector_title(name_text: string, typed: ?string): string

        if typed == nil or typed:match("%S") == nil then
            return name_text
        end

        return $"{name_text}: {typed}"
    end

    -- What a vector3 field shows: the vector its text gives; an empty field is 0, 0, 0 (nothing is given until a number is typed);
    -- a text that isn't a vector (a mistyped name, a call that gives no vector) is marked wrong: the list stays, so the
    -- user is not thrown out of it, and says so
    vector_view = function(typed: ?string): table

        if typed == nil or typed:match("%S") == nil then
            return { x = "0", y = "0", z = "0", values = { "0", "0", "0" }, written = true, empty = true }
        end

        local vec = module.vector_in(typed)

        if vec == nil then
            return { x = "0", y = "0", z = "0", values = { "0", "0", "0" }, written = false, wrong = true }
        end

        return vec
    end

    -- The line under the axes: what the expression gives, or that it is no vector
    local function values_text(vec: table): string

        if vec.wrong then
            return text("vector.wrong")
        end

        return text("vector.values"):format(table.concat(vec.values, ", "))
    end

    -- A vector3 parameter: a list with the whole vector, then x, y, z as lines like a variable's that are fields too,
    -- then what the text gives when it isn't written out. When the whole vector - or an axis - is a call
    -- (get_coords(user_ped())) it is a list: "Expression: get_coords(...)" with its field first and the call's arguments
    -- under it. What is inside is made by a section: when a text becomes a call or stops being one, only the inside is
    -- made again, so the user stays in the list; the rest of what a text does is changed in place
    -- @param call The text is a call that gives the vector (get_coords(user_ped()))
    local function vector_list(name_text: string, index, help: string, vec: table, call: ?table): void

        local nested = list:list({ name = vector_title(name_text, texts[index]), help = help })
        -- The axes as texts (a number or a call that gives one)
        local parts = { vec.x, vec.y, vec.z }
        local expression = nil
        local values_line = nil
        local content = nil
        local whole_args = nil
        -- The call the whole text is now (nil: numbers), and the vector it gives
        local current = call
        local view = vec
        -- What each axis is now: its call (nil: a number), its field, the section with the call's arguments
        local axis_calls = {}
        local axis_items = {}
        local axis_sections = {}

        local function same_call(first: ?table, second: ?table): bool

            if first == nil or second == nil then
                return first == second
            end

            return first.path == second.path
        end

        -- The text of the whole vector, from the axes
        local function write_axes(): void
            texts[index] = table.concat(parts, ", ")
            nested:set_name(vector_title(name_text, texts[index]))
        end

        -- What the vector gives is shown under the lines, when it isn't written out
        local function show_values(): void
            values_line:set_name(values_text(view))
            values_line:set_visible(not view.written)
        end

        -- An axis was typed in (the field of an axis, or of its call)
        local function axis_typed(number: int, value: string, click_type): void

            if clicks.is_stopping() or not clicks.is_user_click(click_type) then
                return
            end

            local call_now = module.call_in(value)
            local was = axis_calls[number]
            local whole_was_call = current ~= nil

            parts[number] = value
            write_axes()
            view = vector_view(texts[index])
            current = nil

            -- The inside is made again when the whole was a call (the axes replace it) or this axis is another kind
            -- of thing now; a call that stays one has only its arguments made again
            if whole_was_call or not same_call(call_now, was) then
                content.rebuild()
            else
                expression:set_value(texts[index])
                show_values()

                if axis_sections[number] ~= nil then
                    axis_calls[number] = call_now
                    axis_sections[number].rebuild()
                end
            end

            if spec.on_typed ~= nil then
                spec.on_typed()
            end
        end

        -- An axis: a field named by it ("x: 1" in Stand), or - when it is a call - a list with the field and the call's
        -- arguments
        local function make_axis(node: table, number: int, axis: string): void

            local shown = axis_calls[number]
            local holder = node
            local field_name = axis

            if shown ~= nil then
                holder = node:list({
                    name = $"{axis}: {call_label(shown, module.texts_from(shown.sig, table.concat(shown.pieces, ", ")))}",
                    help = text("call.expression_help") })
                field_name = label("call.expression")
            end

            axis_items[number] = holder:text_input({
                name = field_name,
                help = text("help.float"),
                commands = { $"{spec.command(index)}_{axis}" },
                track = false,
                default = parts[number],
                on_change = function(value: string, click_type)
                    axis_typed(number, value, click_type)
                end,
            })

            if shown == nil then
                return
            end

            axis_sections[number] = holder:section(function(inner_node)

                local use = axis_calls[number]

                if use == nil then
                    return
                end

                local inner = module.texts_from(use.sig, table.concat(use.pieces, ", "))

                module.build(inner_node, {
                    sig = use.sig,
                    texts = inner,
                    verbatim = true,
                    command = |sub| -> $"{spec.command(index)}_{axis}_{sub}",
                    on_typed = function()
                        parts[number] = module.compose(use.path, use.sig, inner)
                        write_axes()
                        view = vector_view(texts[index])
                        holder:set_name($"{axis}: {call_label(use, inner)}")
                        expression:set_value(texts[index])
                        axis_items[number]:set_value(parts[number])
                        show_values()

                        if spec.on_typed ~= nil then
                            spec.on_typed()
                        end
                    end,
                    on_reshape = || -> axis_sections[number].rebuild(),
                })
            end)
        end

        local function fill(node: table): void

            local start = nil

            axis_items = {}
            axis_sections = {}
            whole_args = nil

            if view.empty then
                start = module.default_of(sig.params[index])
            end

            if current ~= nil then

                local call_node = node:list({
                    name = $"{text("call.expression")}: {call_label(current, module.texts_from(current.sig, table.concat(current.pieces, ", ")))}",
                    help = text("call.expression_help") })
                local fields = nil

                expression = field(call_node, label("call.expression"), index, text("call.expression_help"), start, true)

                -- The call's arguments: the same fields as a call in any argument; typing in one writes the call again.
                -- Made from the call the text is when they are made, so the text typed since is in them
                fields = call_node:section(function(inner_node)

                    local shown = current

                    if shown == nil then
                        return
                    end

                    local inner = module.texts_from(shown.sig, table.concat(shown.pieces, ", "))

                    module.build(inner_node, {
                        sig = shown.sig,
                        texts = inner,
                        verbatim = true,
                        command = |sub| -> $"{spec.command(index)}_{sub}",
                        on_typed = function()
                            texts[index] = module.compose(shown.path, shown.sig, inner)
                            nested:set_name(vector_title(name_text, texts[index]))
                            call_node:set_name($"{text("call.expression")}: {call_label(shown, inner)}")
                            expression:set_value(texts[index])

                            if spec.on_typed ~= nil then
                                spec.on_typed()
                            end
                        end,
                        on_reshape = || -> fields.rebuild(),
                    })
                end)

                whole_args = fields
            else
                expression = field(node, label("call.expression"), index, text("vector.expression_help"), start, true)
            end

            for number, axis in ipairs({ "x", "y", "z" }) do
                axis_calls[number] = module.call_in(parts[number])
                make_axis(node, number, axis)
            end

            -- What the expression gives, when it isn't written out as numbers (they are in the lines above); or that it
            -- gives no vector
            values_line = node:divider({ name = values_text(view) })
            values_line:set_visible(not view.written)
        end

        content = nested:section(fill)

        -- The whole expression was typed: the lines follow it in place; the inside is made again only when the text
        -- became a call or stopped being one (or is another call) or an axis is another kind of thing now
        vector_updaters[index] = function(typed: string): void

            local now = vector_view(typed)
            local call_now = module.call_in(typed)
            local same = same_call(call_now, current)

            -- A text that is no vector leaves the lines as they were
            if not now.wrong then
                parts = { now.x, now.y, now.z }
            end

            nested:set_name(vector_title(name_text, typed))
            current = call_now
            view = now

            for number = 1, 3 do
                if not same_call(module.call_in(parts[number]), axis_calls[number]) then
                    same = false
                end
            end

            if not same then
                content.rebuild()
                return
            end

            for number, item in pairs(axis_items) do
                item:set_value(parts[number])
            end

            show_values()

            for number, section in pairs(axis_sections) do
                axis_calls[number] = module.call_in(parts[number])
                section.rebuild()
            end

            if whole_args ~= nil then
                whole_args.rebuild()
            end
        end
    end

    for i, param in ipairs(sig.params) do

        local kind = module.kind_of(param.type)

        -- As the code would write it, a text is an expression in quotes: not the Text field
        if spec.verbatim and kind == "string" then
            kind = "any"
        end

        local help = text($"help.{kind}")
        local about = spec.about and spec.about(param.name) or nil
        if about ~= nil then
            help = $"{about}\n{help}"
        end

        local call = spec.on_reshape ~= nil and module.call_in(texts[i]) or nil
        local vec = nil
        calls[i] = call?.path

        -- A vector3 parameter is a vector list even when its text is a call that gives one (get_coords(user_ped()))
        if spec.on_reshape ~= nil and kind == "vector3" then
            vec = vector_view(texts[i] ?? module.default_of(param))
        end

        vectors[i] = vec ~= nil

        list:divider({ name = param.name })
        if vec ~= nil then
            vector_list(text($"types.{kind}"), i, help, vec, call)
        elseif call ~= nil then
            call_list(text($"types.{kind}"), i, help, call)
        else
            field(list, label($"types.{kind}"), i, help, module.default_of(param))
        end
    end

    if sig.vararg then
        -- Under the parameters it's the rest of them; alone it's all of them
        if #sig.params > 0 then
            list:divider({ name = "..." })
        end
        field(list, label("rest.name"), "rest", text("rest.help"))
    end
end

return module
