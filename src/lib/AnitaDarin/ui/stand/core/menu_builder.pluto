local Logger = Atdar.loader.load("core/logger")

local log = new Logger("MenuBuilder")

local module = {}

-- Item types for build_items: the field named after the type holds the item's name (or the
-- feature id), `required` lists the other fields it needs, `build` creates it in the node.
-- A new type is added here only; check_item and build_items read this table
local ITEM_TYPES = {
    list = {
        build = |node, item, where| -> module.build_items(node:list(item.list, item.commands or {}, item.help or ""),
            item.items or {}, $"{where} > {item.list}"),
    },
    feature = {
        build = function(node, item, where)
            if not Atdar.features.has(item.feature) then
                log:warn($"{where}: unknown feature '{item.feature}', skipped")
                return
            end
            node:add_feature(Atdar.features.get(item.feature), item.name or item.feature,
                item.commands or {}, item.help or "")
        end,
    },
    divider = {
        build = |node, item| -> node:divider(item.divider),
    },
    readonly_name = {
        build = |node, item| -> node:readonly_name(item.readonly_name),
    },
    readonly = {
        build = |node, item| -> node:readonly(item.readonly, item.value or ""),
    },
    hyperlink = {
        required = { "link" },
        build = |node, item| -> node:hyperlink(item.hyperlink, item.link, item.help or ""),
    },
    action = {
        required = { "on_click" },
        build = |node, item| -> node:action(item.action, item.on_click, item.commands or {}, item.help or ""),
    },
    toggle = {
        required = { "on_change" },
        build = |node, item| -> node:toggle(item.toggle, item.on_change, item.commands or {}, item.help or "",
            item.default == true),
    },
    slider = {
        required = { "min", "max", "on_change" },
        build = |node, item| -> node:slider(item.slider, item.min, item.max, item.default or item.min,
            item.step or 1, item.on_change, item.commands or {}, item.help or ""),
    },
    textslider = {
        required = { "options", "on_click" },
        build = |node, item| -> node:text_slider(item.textslider, item.options, item.on_click,
            item.commands or {}, item.help or ""),
    },
    list_action = {
        required = { "options", "on_select" },
        build = |node, item| -> node:list_action(item.list_action, item.options, item.on_select,
            item.commands or {}, item.help or ""),
    },
    text_input = {
        -- Stand takes the text through its command box, so the field can't work without a command
        required = { "on_change", "commands" },
        build = |node, item| -> node:text_input(item.text_input, item.commands or {}, item.on_change,
            item.help or "", item.default or ""),
    },
}

-- Fields any item may have besides its type field; the rest are collected from `required` below
local ITEM_FIELDS = {
    items = true,
    name = true,
    commands = true,
    help = true,
    value = true,
    default = true,
    step = true,
}

-- Sorted type names for messages
local TYPE_NAMES = {}
for type_name, spec in pairs(ITEM_TYPES) do
    ITEM_FIELDS[type_name] = true
    for _, field in ipairs(spec.required or {}) do
        ITEM_FIELDS[field] = true
    end
    table.insert(TYPE_NAMES, type_name)
end
table.sort(TYPE_NAMES)

-- Catches layout typos that are valid Lua and would otherwise be silently skipped
-- @return The item's type name, or nil if the item can't be built
local function check_item(item, where: string): ?string
    if type(item) ~= "table" then
        log:warn($"{where}: item must be a table, got {type(item)}")
        return nil
    end
    for key in pairs(item) do
        if not ITEM_FIELDS[key] then
            log:warn($"{where}: unknown field '{tostring(key)}'")
        end
    end
    if item.items ~= nil and item.list == nil then
        log:warn($"{where}: 'items' belongs to a list item, add list = \"Name\" next to it")
        return nil
    end
    local types = {}
    for _, type_name in ipairs(TYPE_NAMES) do
        if item[type_name] ~= nil then
            table.insert(types, type_name)
        end
    end
    if #types ~= 1 then
        local found = #types == 0 ? "none" : table.concat(types, " and ")
        log:warn($"{where}: item needs exactly one of {table.concat(TYPE_NAMES, ', ')}, found {found}")
        return nil
    end
    local type_name = types[1]
    for _, field in ipairs(ITEM_TYPES[type_name].required or {}) do
        if item[field] == nil then
            log:warn($"{where}: {type_name} item needs '{field}'")
            return nil
        end
    end
    return type_name
end

-- Declarative helper for menu files that prefer describing a submenu as a table:
-- { list = "Name", items = {...} }, { feature = "id", name = "Label" }, { divider = "Text" },
-- { readonly = "Name", value = "..." }, { toggle = "Name", on_change = fn }, { slider = "Name", min = 0, max = 10, on_change = fn }...
-- see ITEM_TYPES for every type and the fields it needs
function module.build_items(node: table, items: table, where: string = "menu"): void
    if type(items) ~= "table" then
        log:warn($"{where}: items must be a table, got {type(items)}")
        return
    end
    -- Only the numbered part is built; a named field here is an item that lost its own braces
    for key in pairs(items) do
        if type(key) ~= "number" then
            log:warn($"{where}: '{tostring(key)}' is not an item, wrap each item in its own table")
        end
    end

    for i, item in ipairs(items) do
        local item_where = $"{where} #{i}"
        local type_name = check_item(item, item_where)
        if type_name then
            ITEM_TYPES[type_name].build(node, item, item_where)
        end
    end
end

-- @return The table a menu file returns, or nil if it's missing or failed
local function load_menu_file(path: string): ?table
    -- Timed (loader.report): compiling and running the file
    local ok, result = Atdar.loader.measure(path, function()
        local chunk, err = loadfile(path)
        if not chunk then
            return false, err
        end
        return pcall(chunk)
    end)
    if not ok then
        log:error($"menu file failed: {path}\n{result}")
        return nil
    end
    if type(result) ~= "table" then
        log:warn($"menu file must return a table: {path}")
        return nil
    end
    return result
end

-- Builds the menu in dir: main.pluto returns { build = function(node, ctx) }.
-- ctx.load(name) returns another menu file from the same dir (loaded once per build)
-- @return Whether main.pluto built without errors
function module.build_menu(node: table, dir: string): bool
    local cache = {}
    local ctx = { dir = dir }
    function ctx.load(name: string): ?table
        if cache[name] == nil then
            cache[name] = load_menu_file($"{dir}{name}.pluto") or false
        end
        return cache[name] or nil
    end

    local main = ctx.load("main")
    if not main or type(main.build) ~= "function" then
        log:warn($"{dir}main.pluto must return a table with build(node, ctx)")
        return false
    end
    local ok, err = pcall(main.build, node, ctx)
    if not ok then
        log:error($"menu build failed in {dir}\n{err}")
    end
    return ok
end

return module
