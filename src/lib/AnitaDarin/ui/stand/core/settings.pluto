-- Script's own section, shown with any menu (built-in or a pack): at the bottom of the root,
-- or inside the list a menu set with set_parent
local Logger = Atdar.loader.load("core/logger")

local log = new Logger("Settings")

local module = {}

-- Builders rather than built items, so the section can be recreated without losing what was added
local contributors = {}

-- Applied each time the section is built (at start and after every menu load)
local config = {
    name = nil, -- nil: the profile's display name
    divider = nil,
    parent = nil, -- MenuNode to build the section in; nil means the root
}

-- Adds items to the section's list: build_fn(node) gets its MenuNode each time the section is built
function module.add(build_fn: function): void
    table.insert(contributors, build_fn)
end

function module.set_name(name: string|int): void
    config.name = name
end

-- Pass to set_divider(): the divider shows the profile's display name and follows its changes
module.DISPLAY_NAME = {}

-- The profile's display name; the script's file name before the profile has loaded or while it's empty
local function display_name(): string
    local profile = Atdar.profile
    local name = profile and profile.get and profile.get("display_name")
    if type(name) ~= "string" or name == "" then
        return Atdar.name
    end
    return name
end

-- Divider above the list: a text, a label, or module.DISPLAY_NAME; nil removes it
function module.set_divider(text): void
    config.divider = text
end

-- Builds the section inside another list (e.g. a pack's own Settings) instead of the root; nil puts it back
function module.set_parent(node: ?table): void
    config.parent = node
end

-- mark() before loading something and restore() with it later undoes everything set or added in between
function module.mark(): table
    return { count = #contributors, name = config.name, divider = config.divider, parent = config.parent }
end

function module.restore(mark: table): void
    for i = #contributors, mark.count + 1, -1 do
        table.remove(contributors, i)
    end
    config.name = mark.name
    config.divider = mark.divider
    config.parent = mark.parent
end

-- @return The section's items, pass them to remove()
function module.build(root: table): table

    local host = config.parent or root
    local section = {}

    -- The display name follows the profile (ui/stand/core/live): renamed in place rather than rebuilt,
    -- the user may be inside the section when it changes
    if config.divider == module.DISPLAY_NAME then
        section.divider = host:divider({ caption = display_name })
    elseif config.divider then
        section.divider = host:divider({ name = config.divider })
    end

    if config.name == nil then
        section.node = host:list({ caption = display_name })
    else
        section.node = host:list({ name = config.name })
    end

    for _, build_fn in ipairs(contributors) do
        local ok, err = pcall(build_fn, section.node)
        if not ok then
            log:error($"contributor failed\n{err}")
        end
    end

    return section
end

function module.remove(section: table): void

    if section.divider then
        section.divider:remove()
    end

    section.node:delete()
end

return module
