local features = Atdar.features
local lang = Atdar.lang

return {
    build = function(node, ctx)
        local self_menu = node:list(lang.translate("menu.self.title"))

        local movement = self_menu:list("Movement")
        movement:add_feature(features.get("self.movement.ragdoll_control"), "Ragdoll Control")

        self_menu:add_feature(features.get("self.godmode"), lang.translate("menu.self.godmode.menu_name"))
        self_menu:add_feature(features.get("self.half_godmode"), lang.translate("menu.self.half_godmode.menu_name"))
    end,
}
