local features = Atdar.features
local lang = Atdar.lang

return {
    build = function(node, ctx)
        local self_menu = node:list(
            lang.translate("menu.self.name"), 
            { "self" }
        )

        local movement_submenu = self_menu:list(
            lang.translate("menu.self.movement.name")
        )
        movement_submenu:add_feature(
            features.get("self.movement.ragdoll_control"),
            lang.translate("menu.self.movement.ragdoll_control.name"),
            { "ragcontrol" }
        )
        movement_submenu:add_feature(
            features.get("self.movement.scuba_mode"),
            lang.translate("menu.self.movement.scuba_mode.name"),
            { "scubamode" }
        )

        local movement_disables_submenu = movement_submenu:list(
            lang.translate("menu.self.movement.disables.name")
        )
        movement_disables_submenu:add_feature(
            features.get("self.movement.disables.disable_sprint"),
            lang.translate("menu.self.movement.disables.disable_sprint.name"),
            { "disablesprint" }
        )


        local state_submenu = self_menu:list(
            lang.translate("menu.self.state.name")
        )

        state_submenu:divider(
            lang.translate("menu.self.state.health.divider.name")
        )
        state_submenu:add_feature(
            features.get("self.state.restore_health"),
            lang.translate("menu.self.state.restore_health.name"),
            { "restorehealth" }
        )

        local regen = features.get("self.state.regeneration_health")
        local regen_submenu = state_submenu:list(
            lang.translate("menu.self.state.regeneration_health.name")
        )
        regen_submenu:add_feature(
            regen,
            lang.translate("menu.self.state.regeneration_health.start.name"),
            { "regenhealth" }
        )
        regen_submenu:divider(
            lang.translate("menu.self.state.regeneration_health.divider.settings.name")
        )
        -- Sliders start at the feature's values and write back into it
        regen_submenu:slider(
            lang.translate("menu.self.state.regeneration_health.amount.name"),
            1, 100, regen.amount, 1,
            function(value) regen.amount = value end,
            { "regenhealthamount" }
        )
        regen_submenu:slider(
            lang.translate("menu.self.state.regeneration_health.interval.name"),
            10, 2000, regen.interval, 10,
            function(value) regen.interval = value end,
            { "regenhealthinterval" }
        )
        regen_submenu:slider(
            lang.translate("menu.self.state.regeneration_health.target.name"),
            1, 100, regen.target, 1,
            function(value) regen.target = value end,
            { "regenhealthtarget" }
        )

        state_submenu:divider(
            lang.translate("menu.self.state.armor.divider.name")
        )
        state_submenu:add_feature(
            features.get("self.state.restore_armor"),
            lang.translate("menu.self.state.restore_armor.name"),
            { "restorearmor" }
        )

        state_submenu:divider(
            lang.translate("menu.self.state.stamina.divider.name")
        )
        -- state_submenu:add_feature(
        --     features.get("self.state.infinite_stamina"),
        --     lang.translate("menu.self.state.infinite_stamina.name"),
        --     { "infinitestamina" }
        -- )
        state_submenu:add_feature(
            features.get("self.state.restore_stamina"),
            lang.translate("menu.self.state.restore_stamina.name"),
            { "restorestamina" }
        )
        state_submenu:add_feature(
            features.get("self.state.reset_stamina"),
            lang.translate("menu.self.state.reset_stamina.name"),
            { "resetstamina" }
        )


        self_menu:add_feature(
            features.get("self.godmode"),
            lang.translate("menu.self.godmode.name"),
            { "godmode" }
        )
        self_menu:add_feature(
            features.get("self.half_godmode"),
            lang.translate("menu.self.half_godmode.name"),
            { "halfgodmode" }
        )
    end,
}
