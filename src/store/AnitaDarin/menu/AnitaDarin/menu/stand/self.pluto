local features = Atdar.features
local lang = Atdar.lang

return {
    build = function(node, ctx)
        local self_menu = node:list(
            lang.translate("menu.self.menu_name"), 
            { "self" }
        )

        local movement_submenu = self_menu:list(
            lang.translate("menu.self.movement.menu_name")
        )
        movement_submenu:add_feature(
            features.get("self.movement.ragdoll_control"),
            lang.translate("menu.self.movement.ragdoll_control.menu_name"),
            { "ragcontrol" }
        )

        local state_submenu = self_menu:list(
            lang.translate("menu.self.state.menu_name")
        )

        state_submenu:divider(
            lang.translate("menu.self.state.health.divider.menu_name")
        )
        state_submenu:add_feature(
            features.get("self.state.restore_health"),
            lang.translate("menu.self.state.restore_health.menu_name"),
            { "restorehealth" }
        )

        state_submenu:divider(
            lang.translate("menu.self.state.armor.divider.menu_name")
        )
        state_submenu:add_feature(
            features.get("self.state.restore_armor"),
            lang.translate("menu.self.state.restore_armor.menu_name"),
            { "restorearmor" }
        )

        state_submenu:divider(
            lang.translate("menu.self.state.stamina.divider.menu_name")
        )
        state_submenu:add_feature(
            features.get("self.state.restore_stamina"),
            lang.translate("menu.self.state.restore_stamina.menu_name"),
            { "restorestamina" }
        )


        self_menu:add_feature(
            features.get("self.godmode"),
            lang.translate("menu.self.godmode.menu_name"),
            { "godmode" }
        )
        self_menu:add_feature(
            features.get("self.half_godmode"),
            lang.translate("menu.self.half_godmode.menu_name"),
            { "halfgodmode" }
        )
    end,
}
