local builder = Atdar.loader.load("ui/stand/menu_builder")

local lang = Atdar.lang

return {
    build = function(node, ctx)
        builder.build_items(node, {
            { list = lang.translate("menu.vehicle.menu_name"), items = {
                { list = lang.translate("menu.vehicle.last_vehicle.menu_name"), items = {
                    { divider = lang.translate("menu.vehicle.last_vehicle.divider.menu_name") },
                } },
                { list = lang.translate("menu.vehicle.movement.menu_name") },
                { feature = "self.explode", name = lang.translate("menu.vehicle.explode.menu_name"), commands = { "destroyvehicle" } },
            } },
        })
    end,
}

