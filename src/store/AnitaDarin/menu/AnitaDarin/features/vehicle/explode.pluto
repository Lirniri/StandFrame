local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("Explode")

return Atdar.features.add(new Feature({
    id = "self.explode",
    kind = "action",

    on_trigger = function(self)
        local vehicle = Atdar.natives.vehicle.user()
        if not vehicle:is_exist() then
            log:notify($"{self.id}: no vehicle :(")
            return
        end

        local is_online = util.is_session_started()
        if is_online then
            local netID = vehicle:get_net_id()
            if netID == 0 then
                log:notify($"{self.id}: net_id is 0 :(")
                return
            end
            vehicle:explode({ net_id = netID })
            log:debug($"{self.id}: vehicle: {vehicle:handle()} exploded with net_id: {netID} :)")
        else
            vehicle:explode()
            log:debug($"{self.id}: vehicle: {vehicle:handle()} exploded :)")
        end
    end
}))
