local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("RagdollControl")

-- Control is held only while the ped is ragdolling
local class RagdollControl extends Feature
    function __construct()
        parent:__construct({
            id = "self.movement.ragdoll_control", kind = "loop"
        })
        self.given = false
    end

    function is_given(): bool
        local given = self.given
        local text = given ? "is true!" : "!is false!"
        log:debug($"id: {self.id}: {text}")
        return given
    end

    function set_control(toggle: bool): void
        Atdar.natives.player.user():give_ragdoll_control(toggle)
        local debug_text = toggle ? "control is given :)" : "control is removed :("
        self.given = toggle
        log:debug($"id: {self.id}: {debug_text}")
    end

    function on_tick()
        local is_ragdoll = Atdar.natives.ped.user():is_ragdoll()
        if is_ragdoll ~= self.given then
            self:set_control(is_ragdoll)
        end
    end

    function on_disable()
        if self.given then
            self:set_control(false)
        end
    end
end

return Atdar.features.add(new RagdollControl())
