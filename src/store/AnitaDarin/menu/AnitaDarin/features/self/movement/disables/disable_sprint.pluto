local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("DisableSprint")


local class DisableSprint extends Feature
    function __construct()
        parent:__construct({
            id = "self.movement.disables.disable_sprint",
            kind = "loop"
        })
        -- Last value set, so the log only shows changes, not one line every frame
        self.sprint = nil
    end

    function set_sprint(toggle)
        Atdar.natives.player.user().movement:set_sprint(toggle)
        if toggle ~= self.sprint then
            self.sprint = toggle
            local debug_text = toggle ? "sprint is enabled" : "sprint is disabled"
            log:debug($"id: {self.id}: {debug_text}")
        end
    end

    function on_tick()
        local ped = Atdar.natives.ped.user()

        local actions = ped:is_running() or ped:is_sprinting()
        if actions then
            self:set_sprint(false)
        else
            self:set_sprint(true)
        end
    end

    function on_disable()
        self:set_sprint(true)
    end
end

return Atdar.features.add(new DisableSprint())
