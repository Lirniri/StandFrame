local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("Godmode")

-- Ticks because the game resets the flag on death/respawn
return Atdar.features.add(new Feature({
    id = "self.godmode",
    kind = "loop",

    on_tick = function(self)
        local me = Atdar.natives.player.user()
        if not me:is_godmode() then
            log:debug($"id: {self.id}: godmode is given :)")
            me:set_godmode(true)
        end
    end,

    on_disable = function(self)
        Atdar.natives.player.user():set_godmode(false)
        log:debug($"id: {self.id}: godmode is removed :(")
    end,
}))
