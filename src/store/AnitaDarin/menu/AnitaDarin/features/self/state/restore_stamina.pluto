local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("RestoreStamina")

local class RestoreStamina extends Feature
    function __construct()
        parent:__construct({
            id = "self.state.restore_stamina",
            kind = "action" 
        })
    end

    function on_trigger()
        local user = Atdar.natives.player.user
        user.restore_stamina()
    end
end

return Atdar.features.add(new RestoreStamina())
