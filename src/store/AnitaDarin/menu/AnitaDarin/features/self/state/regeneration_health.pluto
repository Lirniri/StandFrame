local load = Atdar.loader.load
local Feature = load("features/feature")

-- Restores health step by step; the menu's sliders change amount, interval and target
local class RegenerationHealth extends Feature
    function __construct()
        parent:__construct({
            id = "self.state.regeneration_health",
            kind = "action",
        })
        self.amount = 10    -- health added per step
        self.interval = 100 -- ms between steps
        self.target = 100   -- stop at this % of max health
    end

    -- Read every step, so moving a slider during regeneration takes effect right away
    function target_health(ped: int): int
        local entity = Atdar.natives.entity
        return math.floor(entity.get_max_health(ped) * self.target / 100)
    end

    function on_trigger()
        local entity = Atdar.natives.entity
        local ped = Atdar.natives.player.get_ped_id()

        while entity.get_health(ped) < self:target_health(ped) do
            if entity.is_dead(ped) then
                return
            end
            local health = entity.get_health(ped) + self.amount
            entity.set_health(ped, math.min(health, self:target_health(ped)))
            util.yield(self.interval) -- clicks meanwhile are ignored (Feature.trigger)
        end
    end
end

return Atdar.features.add(new RegenerationHealth())
