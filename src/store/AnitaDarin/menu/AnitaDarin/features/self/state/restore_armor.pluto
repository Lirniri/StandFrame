local load = Atdar.loader.load

local Feature = load("features/feature")
local Logger = load("core/logger")

local log = new Logger("RestoreArmor")

local class RestoreArmor extends Feature
    function __construct()
        parent:__construct({
            id = "self.state.restore_armor",
            kind = "action"
        })
    end

    function on_trigger()
        Atdar.natives.player.user():restore_armor()
    end
end

return Atdar.features.add(new RestoreArmor())
