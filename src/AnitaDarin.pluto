-- Lua Scripts/AnitaDarin.pluto

pluto_use "0.13.2"


local ATDAR_NAME <const> = SCRIPT_NAME


_G.Atdar = {
    ui = {},
    -- SCRIPT_NAME is this file's name without the extension, so a renamed script finds its lib/store/resources folders of the same name
    name = ATDAR_NAME,
    debug = false, -- will be set from the active profile once profile.pluto loads
}


local ok, err = xpcall(function()
    require(ATDAR_NAME .. "/bootstrap")
end, function(e) return debug.traceback(e) end)

if not ok then util.toast(err) end