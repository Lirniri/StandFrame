-- EXAMPLE: the tables of the game's data (Atdar.util.game.data) and the varint of Atdar.parsers.
--
-- The tables are generated by the tools of tools/ from Stand-OSS (gen_weapon_components.py, gen_vehicle_dlcs.py), so they
-- are changed there. Not checked in game. The vehicle table that is in the project is a SAMPLE of four vehicles
-- until gen_vehicle_dlcs.py is run with the DurtyFree vehicles.json

local data = Atdar.util.game.data

-- The weapon components: the label that holds each name, and the name in the game's language
local components = data.weapon_components
util.log($"{components.count()} components")
util.log(components.get_label("COMPONENT_PISTOL_CLIP_02"))       -- WCT_CLIP2
util.log(tostring(components.get_text("COMPONENT_PISTOL_CLIP_02")))
for _, name in ipairs(components.find("COMPONENT_AT_PI_")) do     -- the attachments of the pistols
    util.log(name)
end

-- The vehicles by the DLC that added them
local dlcs = data.vehicle_dlcs
util.log(dlcs.get_title("mpheist4"))                              -- 1.52 Cayo Perico Heist
util.log(tostring(dlcs.get_dlc("kosatka")))                       -- mpheist4
for dlc, names in pairs(dlcs.group()) do
    util.log($"{dlcs.get_title(dlc)}: {#names} vehicles")
end

-- A whole number in as many bytes as it needs (for binary data: a file, a buffer)
local varint = Atdar.parsers.varint
local bytes = varint.pack_u64(300)                                -- 2 bytes
local value, next_at = varint.unpack_u64(bytes)                   -- 300, 3
util.log($"{value} in {#bytes} bytes, the next number starts at {next_at}")
util.log(tostring(varint.unpack_i64(varint.pack_i64(-5))))        -- -5, one byte
