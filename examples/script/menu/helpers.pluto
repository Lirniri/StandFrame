-- EXAMPLE: ready-made menu helpers, as a menu file of a pack (menu/stand/helpers.pluto).
-- main.pluto calls it: ctx.load("helpers").build(node, ctx)
--
--   node:confirm({ ... })          - a button that acts only on a second click
--   node:spoiler({ ... })          - a line that hides its value until clicked
--   Atdar.menu.builder.build_items - a submenu described as a table
--
-- Every item method takes a table of options and gives back a MenuItem (set_name, set_value, remove, ...).
-- The older forms, Atdar.menu.confirm.action(list, name, again, ...) and Atdar.menu.spoiler(list.handle, ...),
-- still work. Atdar.menu is where a pack takes the parts of the script's menu from (lib/<script>/utils/menu)

local Logger = Atdar.loader.load("core/logger")
local builder = Atdar.menu.builder

local log = new Logger("Helpers")

return {
    build = function(node, ctx)
        -- Leaving the list forgets a first click, so it can't be confirmed by accident later
        local cancel_forget
        local list = node:list({ name = "Helpers", help = "Ready-made menu helpers", on_back = function()
            cancel_forget()
        end })

        -- For what can't be undone: the second click has to come within 5 seconds.
        -- While it waits, the button is called by its second name
        local _, cancel = list:confirm({
            name = "Forget Vehicles",
            again = "Click Again To Forget",
            help = "Asks for a second click",
            on_confirm = function() log:notify("forgotten") end,
            on_first = function() log:warn("click again to forget every saved vehicle") end,
        })
        cancel_forget = cancel

        list:spoiler({ name = "Address", value = "Vinewood 12", hidden = "Click To Show", help = "Hidden until clicked" })

        -- The same items as MenuNode's methods, written as data. A mistake in a table (an unknown type,
        -- a missing field) is a warning in the log and that item is skipped.
        -- A feature goes in as { feature = "self.godmode", name = "God Mode" }
        builder.build_items(list, {
            { divider = "From a table" },
            { readonly = "Version", value = "1.0" },
            { action = "Say Hello", on_click = function() log:notify("hello") end, help = "A notification" },
            { toggle = "A Switch", on_change = function(on) log:info($"switched {tostring(on)}") end },
            { slider = "Amount", min = 0, max = 100, default = 50, step = 5,
                on_change = function(value) log:info($"amount {value}") end },
            { list = "More", items = {
                { readonly_name = "Inside More" },
            } },
        }, "examples/script/menu/helpers")
    end,
}
