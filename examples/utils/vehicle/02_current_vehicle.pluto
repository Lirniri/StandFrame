-- EXAMPLE: changes that hold while the player drives a vehicle: drift mode, less tyre burnouts, no heli auto
-- stabilisation, gravity, drive on water, forge model, and the helper they are built on.
--
-- Atdar.util.game.vehicle.* (lib/AnitaDarin/utils/util/game/vehicle/). Each one is the shape of Graceland: set_* any time, enable(),
-- disable(), is_enabled(). It acts on the vehicle the player DRIVES: done when he gets in, undone when he leaves or gets
-- into another one, done again for the next. Nothing here is checked in game (the memory layout is Stand-OSS's).

local vehicle = Atdar.util.game.vehicle

-- Drift mode: the handling of a drift tune and its flags, per car; no bikes, boats or aircraft
vehicle.drift_mode.set_preset("loose")         -- "stand" (Stand's numbers), "loose" or "grippy"
vehicle.drift_mode.set_traction_scale(0.95)    -- the grip of the tune times this
vehicle.drift_mode.set_value("handbrake_force", 1.2) -- one number of the tune by hand; clear_values() drops them
vehicle.drift_mode.set_flag(vehicle.drift_mode.FLAG.STEER_MOVES, false)
vehicle.drift_mode.enable()

-- Less wheelspin at the start. It shares a field with the drift tune: the last holder wins, and the field is given back
-- by holder (lessen off: the drift value is back, not the original)
vehicle.lessen_burnouts.set_value(0.2)
vehicle.lessen_burnouts.enable()

-- A helicopter that does not level itself; only helicopters
vehicle.heli_stabilisation.set_stabilise_scale(0.0)
vehicle.heli_stabilisation.set_thrust_scale(1.35)
vehicle.heli_stabilisation.enable()

-- Gravity of the vehicle as a multiple of the normal one; aircraft keep the normal one by default
vehicle.gravity.set_multiplier(0.3)
vehicle.gravity.set_not_in_aircraft(true)
vehicle.gravity.enable()

-- A block under the surface carries it over the water (not boats); single player only, it refuses to start online
vehicle.drive_on_water.set_depth(0.3)
vehicle.drive_on_water.enable()

-- The vehicle is taken for another model: its model info is overwritten, so EVERY vehicle of the model carries the name until
-- it is switched off. Risky, single player only
vehicle.forge_model.set_model("ruffian")
vehicle.forge_model.enable()

-- Everything off: the handling, the gravity, the block and the hash are given back
for _, name in { "drift_mode", "lessen_burnouts", "heli_stabilisation", "gravity", "drive_on_water", "forge_model" } do
    vehicle[name].disable()
end

-- Your own change of this kind with on_current.create: change runs once for a vehicle that passes the filter, undo when it is
-- not the current one any more (or on disable), frame every frame in between. An error in a hook is logged, and it stops
-- by itself with the undo done
local on_current = vehicle.on_current

local mine = on_current.create("MyHandling", {
    only = { "car" },                    -- or except = { "air", "aquatic" }; the kinds are in on_current.KIND
    change = function(current, model, behaviour)
        vehicle.handling.set(current, "mass", 500.0, "my_script")
        behaviour.store[model] = { note = "first change of this model" }
    end,
    undo = function(current, model, behaviour)
        vehicle.handling.release_holder("my_script")  -- needs no vehicle: it may be gone
        behaviour.take(model)
    end,
})

mine.enable()
mine.refresh()                           -- the settings changed: undo and do again
print(mine.get_vehicle())                -- the vehicle that is changed now, nil if none
mine.disable()

-- Several users of one change of the game's code: the first holder makes it, the last release undoes it
local holds = Atdar.natives.memory.holds

holds.acquire("my_change", "a", function() print("make") end, function() print("undo") end)
holds.acquire("my_change", "b")           -- already made: nothing happens
holds.release("my_change", "a")           -- still held by "b"
holds.release("my_change", "b")           -- "undo" now
