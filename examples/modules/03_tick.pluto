-- EXAMPLE 3: on_tick, which runs every frame (about 60 times a second).
-- Keep it cheap, and react only when something changes: a notification here without a check
-- would show every frame. A module without on_tick costs nothing per frame
--
-- If on_tick throws an error, the module is marked failed, on_stop runs to clean up,
-- and it stops ticking. Start it again from the Modules menu

local Module = Atdar.loader.load("core/module")

local class SessionWatch extends Module
    function __construct()
        parent:__construct({ name = "example.session_watch" })
        self.online = false
    end

    function on_start()
        self.online = util.is_session_started()
    end

    function on_tick()
        local online = util.is_session_started()
        if online == self.online then
            return -- nothing changed, nothing to do
        end
        self.online = online
        self.log:notify(online ? "joined an online session" : "left the online session")
    end
end

return Atdar.modules.add(new SessionWatch())
