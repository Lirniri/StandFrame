local mgr = {}

function mgr.save_position(entity): vector3
    local getter = ENTITY.GET_ENTITY_COORDS(entity)
    local coords = v3.new(getter)
    return coords
end
function mgr.save_rotation(rotationOrder: int = 2, entity): vector3
    local getter
    if entity == nil entity == 0 then
        getter = CAMERA.GET_GAMEPLAY_CAM_ROT(rotationOrder)
    else
        getter = ENTITY.GET_ENTITY_ROTATION(entity, rotationOrder)
    end
    local rotation = v3.new(getter)
    return rotation
end
function mgr.save_heading(entity): vector3
    local getter = ENTITY.GET_ENTITY_HEADING(entity)
    local heading = v3.new(getter)
    return heading
end

function mgr.save_last_position(entity)
    local data = {}

    data.position = mgr.save_position(entity)
    data.rotation = mgr.save_rotation(2, entity)
    data.heading = mgr.save_heading(entity)

    return data
end

function mgr.set_position(entity, position, heading, rotation, rotationOrder)
    local pos = position
    local rot = rotation
    local hea = heading

    ENTITY.SET_ENTITY_COORDS_NO_OFFSET(entity, pos.x, pos.y, pos.z)
    ENTITY.SET_ENTITY_ROTATION(entity, rot, 2, true)
    ENTITY.SET_ENTITY_HEADING(entity, hea)
end

return mgr