local memory = memory
local m = {}

function m.read_byte(addr, localScr)
    local ptr

    if localScr ~= nil then
        if type(addr) == "string" or math.type(addr) == "number" then
            ptr = memory.script_local(addr, localScr)
        end
    else
        if math.type(addr) == "number" then
            ptr = memory.script_global(addr)
        end
    end

    if ptr ~= nil and ptr ~= 0 then
        return memory.read_byte(ptr)
    end
    return 0
end

function m.write_byte(addr, value, localScr)
    local ptr

    if localScr ~= nil then
        if type(addr) == "string" or math.type(addr) == "number" then
            ptr = memory.script_local(addr, localScr)
        end
    else
        if math.type(addr) == "number" then
            ptr = memory.script_global(addr)
        end
    end

    if ptr ~= nil and ptr ~= 0 then
        return memory.write_byte(ptr, value)
    end
    return 0
end



