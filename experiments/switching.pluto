local function hide_hud()
    if IS_HUD_PREFERENCE_SWITCHED_ON() then
        DISPLAY_HUD(false)
    end
end

local function toggle_hud()
    DISPLAY_HUD(not IS_HUD_PREFERENCE_SWITCHED_ON())
end

local function hide_radar()
    if IS_RADAR_PREFERENCE_SWITCHED_ON() then
        DISPLAY_RADAR(false)
    end
end

local function toggle_radar()
    DISPLAY_RADAR(not IS_RADAR_PREFERENCE_SWITCHED_ON())
end

local function hide_subtitles()
    if IS_SUBTITLE_PREFERENCE_SWITCHED_ON() then
        ENABLE_MOVIE_SUBTITLES(false)
    end
end

local function toggle_subtitles()
    ENABLE_MOVIE_SUBTITLES(not IS_SUBTITLE_PREFERENCE_SWITCHED_ON())
end

local function stop_cinematic_cam()
    if IS_CINEMATIC_CAM_RENDERING() then
        INVALIDATE_IDLE_CAM()
    end
end

local function toggle_cinematic_cam()
    if IS_CINEMATIC_CAM_RENDERING() then
        INVALIDATE_IDLE_CAM()
    else
        SET_CINEMATIC_MODE_ACTIVE(true)
    end
end

hide_hud()
hide_radar()
hide_subtitles()
stop_cinematic_cam()