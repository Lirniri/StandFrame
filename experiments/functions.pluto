function show_player_tasks()
    local ped = players.user_ped()

    local activeTasks = {}
    for i = 1, 531, 1 do
        if TASK.GET_IS_TASK_ACTIVE(ped, i) then
            table.insert(activeTasks, tostring(i))
        end
    end
    util.draw_debug_text($"Active tasks: {#activeTasks > 0 and table.concat(activeTasks, ', ') or 'none'}")
end

function testFunc_01()
    local last_pos = nil
    local last_save = 0
    local was_falling = false
    local SAVE_INTERVAL = 1500 -- мс

    local ped = players.user_ped()
    local falling = PED.IS_PED_FALLING(ped) or PED.IS_PED_RAGDOLL(ped)

    if falling then
        was_falling = true
    elseif was_falling and Atdar.entity.is_entity_on_ground(ped) then
        if last_pos then
            ENTITY.SET_ENTITY_COORDS(ped, last_pos.x, last_pos.y, last_pos.z, false, false, false, false)
        end
        was_falling = false
    elseif not was_falling then
        local now = util.current_time_millis()
        if now - last_save >= SAVE_INTERVAL then
            last_pos = Atdar.entity.get_entity_coords(ped, false)
            last_save = now
        end
    end
end