local module = {}

-- State

-- Get

function module.get_vehicle(include_last_vehicle: bool = true, as_pointer: bool = false)
    if as_pointer then
        return entities.get_user_vehicle_as_pointer(include_last_vehicle)
    end

    return entities.get_user_vehicle_as_handle(include_last_vehicle)
end

-- Set

-- Actions

return module
