local module = {}

-- State

function module.does_particle_fx_looped_exist(ptfx_handle: int): bool
    return GRAPHICS.DOES_PARTICLE_FX_LOOPED_EXIST(ptfx_handle)
end

-- Set

function module.set_particle_fx_non_looped_colour(r: float, g: float, b: float): void
    GRAPHICS.SET_PARTICLE_FX_NON_LOOPED_COLOUR(r, g, b)
end

function module.set_particle_fx_non_looped_alpha(alpha: float): void
    GRAPHICS.SET_PARTICLE_FX_NON_LOOPED_ALPHA(alpha)
end

function module.set_particle_fx_non_looped_scale(scale: float): void
    GRAPHICS.SET_PARTICLE_FX_NON_LOOPED_SCALE(scale)
end

function module.set_particle_fx_non_looped_emitter_size(p0: float, p1: float, scale: float): void
    GRAPHICS.SET_PARTICLE_FX_NON_LOOPED_EMITTER_SIZE(p0, p1, scale)
end

-- Used only once in the scripts (taxi_clowncar)
function module.set_particle_fx_force_vehicle_interior(toggle: bool): void
    GRAPHICS.SET_PARTICLE_FX_FORCE_VEHICLE_INTERIOR(toggle)
end

function module.set_particle_fx_looped_offsets(
    ptfx_handle: int, x: float, y: float, z: float, rot_x: float, rot_y: float, rot_z: float
): void
    -- body function:
    GRAPHICS.SET_PARTICLE_FX_LOOPED_OFFSETS(ptfx_handle, x, y, z, rot_x, rot_y, rot_z)
end

function module.set_particle_fx_looped_evolution(
    ptfx_handle: int, property_name: string, amount: float, no_network: bool
): void
    -- body function:
    GRAPHICS.SET_PARTICLE_FX_LOOPED_EVOLUTION(ptfx_handle, property_name, amount, no_network)
end

function module.set_particle_fx_looped_colour(ptfx_handle: int, r: float, g: float, b: float, p4: bool): void
    GRAPHICS.SET_PARTICLE_FX_LOOPED_COLOUR(ptfx_handle, r, g, b, p4)
end

function module.set_particle_fx_looped_alpha(ptfx_handle: int, alpha: float): void
