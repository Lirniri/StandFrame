    return GRAPHICS.START_PARTICLE_FX_NON_LOOPED_ON_ENTITY_BONE(effect_name, entity, offset_x, offset_y, offset_z, rot_x, rot_y, rot_z, bone_index, scale, axis_x, axis_y, axis_z)
