end

function module.set_particle_fx_looped_far_clip_dist(ptfx_handle: int, range: float): void
    GRAPHICS.SET_PARTICLE_FX_LOOPED_FAR_CLIP_DIST(ptfx_handle, range)
end

function module.set_particle_fx_looped_camera_bias(ptfx_handle: int, p1: float): void
    GRAPHICS._SET_PARTICLE_FX_LOOPED_CAMERA_BIAS(ptfx_handle, p1)
end

function module.set_particle_fx_cam_inside_vehicle(p0: bool): void
