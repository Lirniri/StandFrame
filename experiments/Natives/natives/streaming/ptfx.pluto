    effect_name: string, ped: int, offset_x: float, offset_y: float, offset_z: float, rot_x: float,
    rot_y: float, rot_z: float, bone_index: int, scale: float, axis_x: bool, axis_y: bool,
    axis_z: bool
): bool
    -- body function:
    return GRAPHICS.START_NETWORKED_PARTICLE_FX_NON_LOOPED_ON_PED_BONE(effect_name, ped, offset_x, offset_y, offset_z, rot_x, rot_y, rot_z, bone_index, scale, axis_x, axis_y, axis_z)
end

