    -- body function:
    return GRAPHICS.START_NETWORKED_PARTICLE_FX_LOOPED_ON_ENTITY_BONE(effect_name, entity, x_offset, y_offset, z_offset, x_rot, y_rot, z_rot, bone_index, scale, x_axis, y_axis, z_axis, r, g, b, a)
end

function module.stop_particle_fx_looped(ptfx_handle: int, p1: bool): void
    GRAPHICS.STOP_PARTICLE_FX_LOOPED(ptfx_handle, p1)
end

function module.remove_particle_fx(ptfx_handle: int, p1: bool): void
    GRAPHICS.REMOVE_PARTICLE_FX(ptfx_handle, p1)
end

function module.remove_particle_fx_from_entity(entity: int): void
    GRAPHICS.REMOVE_PARTICLE_FX_FROM_ENTITY(entity)
end

function module.remove_particle_fx_in_range(x: float, y: float, z: float, radius: float): void
    GRAPHICS.REMOVE_PARTICLE_FX_IN_RANGE(x, y, z, radius)
end

function module.force_particle_fx_in_vehicle_interior(p0: any, p1: any): void
    GRAPHICS.FORCE_PARTICLE_FX_IN_VEHICLE_INTERIOR(p0, p1)
end

function module.clear_particle_fx_shootout_boat(): void
    GRAPHICS.CLEAR_PARTICLE_FX_SHOOTOUT_BOAT()
end

function module.disable_in_water(toggle: bool): void
    GRAPHICS.DISABLE_IN_WATER_PTFX(toggle)
end

function module.disable_downwash(toggle: bool): void
    GRAPHICS.DISABLE_DOWNWASH_PTFX(toggle)
end

-- Resets the effect of SET_PARTICLE_FX_OVERRIDE
function module.reset_particle_fx_override(name: string): void
    GRAPHICS.RESET_PARTICLE_FX_OVERRIDE(name)
end

function module.start_vehicle_particle_fx_looped(
    vehicle: int, effect_name: string, front_back: bool, left_right: bool, local_only: bool
): int
    -- body function:
    return GRAPHICS._START_VEHICLE_PARTICLE_FX_LOOPED(vehicle, effect_name, front_back, left_right, local_only)
end

return Atdar.loader.auto(module, "natives/streaming/ptfx")
