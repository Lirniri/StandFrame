end

function module.set_weather_override_curr_level(p0: float): void
    GRAPHICS.SET_WEATHER_PTFX_OVERRIDE_CURR_LEVEL(p0)
end

-- Actions

function module.start_particle_fx_non_looped_at_coord(
    effect_name: string, x_pos: float, y_pos: float, z_pos: float, x_rot: float, y_rot: float,
    z_rot: float, scale: float, x_axis: bool, y_axis: bool, z_axis: bool
): bool
    -- body function:
    return GRAPHICS.START_PARTICLE_FX_NON_LOOPED_AT_COORD(effect_name, x_pos, y_pos, z_pos, x_rot, y_rot, z_rot, scale, x_axis, y_axis, z_axis)
end

function module.start_networked_particle_fx_non_looped_at_coord(
    effect_name: string, x_pos: float, y_pos: float, z_pos: float, x_rot: float, y_rot: float,
    z_rot: float, scale: float, x_axis: bool, y_axis: bool, z_axis: bool, p11: bool
): bool
    -- body function:
    return GRAPHICS.START_NETWORKED_PARTICLE_FX_NON_LOOPED_AT_COORD(effect_name, x_pos, y_pos, z_pos, x_rot, y_rot, z_rot, scale, x_axis, y_axis, z_axis, p11)
end

