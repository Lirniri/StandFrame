    -- body function:
    return GRAPHICS.START_NETWORKED_PARTICLE_FX_NON_LOOPED_ON_ENTITY(effect_name, entity, offset_x, offset_y, offset_z, rot_x, rot_y, rot_z, scale, axis_x, axis_y, axis_z)
end

function module.start_particle_fx_non_looped_on_entity_bone(
    effect_name: string, entity: int, offset_x: float, offset_y: float, offset_z: float,
    rot_x: float, rot_y: float, rot_z: float, bone_index: int, scale: float, axis_x: bool,
