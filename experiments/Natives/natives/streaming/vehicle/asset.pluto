local module = {}

-- Vehicle assets are numbered per model (asset id), not named

-- State

-- asset: vehicle asset id (int), not the model name
function module.is_loaded(asset: int): bool
    return VEHICLE.HAS_VEHICLE_ASSET_LOADED(asset)
end

-- Actions

-- Requests the asset and waits until it loads (yields, see streaming.wait_loaded)
-- model: vehicle model name or hash
-- @return Whether it loaded before the timeout (ms)
function module.request(model: int|string, asset: int, timeout: int = 2000): bool
    local hash = type(model) == "string" ? util.joaat(model) : model
    VEHICLE.REQUEST_VEHICLE_ASSET(hash, asset)
    return Atdar.natives.streaming.wait_loaded($"vehicle asset {asset} of '{model}'", || -> module.is_loaded(asset), timeout)
end

function module.remove(vehicle_asset: int): void
    VEHICLE.REMOVE_VEHICLE_ASSET(vehicle_asset)
end

return module
