-- The app data store (APP natives)

local module = {}

-- State

function module.has_linked_social_club_account(): bool
    return APP.APP_HAS_LINKED_SOCIAL_CLUB_ACCOUNT()
end

function module.has_synced_data(app_name: string): bool
    return APP.APP_HAS_SYNCED_DATA(app_name)
end

-- Get

function module.get_int(property: string): int
    return APP.APP_GET_INT(property)
end

function module.get_float(property: string): float
    return APP.APP_GET_FLOAT(property)
end

function module.get_string(property: string): string
    return APP.APP_GET_STRING(property)
end

function module.get_deleted_file_status(): int
    return APP.APP_GET_DELETED_FILE_STATUS()
end

-- Set

function module.set_int(property: string, value: int): void
    APP.APP_SET_INT(property, value)
end

function module.set_float(property: string, value: float): void
    APP.APP_SET_FLOAT(property, value)
end

function module.set_string(property: string, value: string): void
    APP.APP_SET_STRING(property, value)
end

function module.set_block(block_name: string): void
    APP.APP_SET_BLOCK(block_name)
end

-- Actions

function module.data_valid(): bool
    return APP.APP_DATA_VALID()
end

function module.app_set_app(app_name: string): void
    APP.APP_SET_APP(app_name)
end

function module.clear_block(): void
    APP.APP_CLEAR_BLOCK()
end

function module.close(): void
    APP.APP_CLOSE_APP()
end

function module.close_block(): void
    APP.APP_CLOSE_BLOCK()
end

function module.save_data(): void
    APP.APP_SAVE_DATA()
end

function module.delete_data(app_name: string): bool
    return APP.APP_DELETE_APP_DATA(app_name)
end

return module
