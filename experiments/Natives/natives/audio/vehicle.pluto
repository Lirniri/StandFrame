-- Vehicle sounds: horns, sirens, engine audio

local module = {}

-- State

-- Checks whether the horn of a vehicle is currently played
function module.is_horn_active(vehicle: int): bool
    return AUDIO.IS_HORN_ACTIVE(vehicle)
end

function module.is_audibly_damaged(vehicle: int): bool
    return AUDIO.IS_VEHICLE_AUDIBLY_DAMAGED(vehicle)
end

-- Get

-- Returns hash of default vehicle horn
function module.get_default_horn(vehicle: int): int
    return AUDIO.GET_VEHICLE_DEFAULT_HORN(vehicle)
end

function module.get_default_horn_ignore_mods(vehicle: int): int
    return AUDIO.GET_VEHICLE_DEFAULT_HORN_IGNORE_MODS(vehicle)
end

function module.get_horn_sound_index(vehicle: int): int
    return AUDIO.GET_VEHICLE_HORN_SOUND_INDEX(vehicle)
end

-- Set

function module.set_missile_warning_enabled(vehicle: int, toggle: bool): void
    AUDIO.SET_VEHICLE_MISSILE_WARNING_ENABLED(vehicle, toggle)
end

-- Makes pedestrians sound their horn longer, faster and more agressive when they use their horn
function module.set_aggressive_horns(toggle: bool): void
    AUDIO.SET_AGGRESSIVE_HORNS(toggle)
end

function module.set_siren_with_no_driver(vehicle: int, toggle: bool): void
    AUDIO.SET_SIREN_WITH_NO_DRIVER(vehicle, toggle)
end

function module.set_siren_bypass_mp_driver_check(vehicle: int, toggle: bool): void
    AUDIO.SET_SIREN_BYPASS_MP_DRIVER_CHECK(vehicle, toggle)
end

function module.set_horn_permanently_on(vehicle: int): void
    AUDIO.SET_HORN_PERMANENTLY_ON(vehicle)
end

function module.set_horn_enabled(vehicle: int, toggle: bool): void
    AUDIO.SET_HORN_ENABLED(vehicle, toggle)
end

function module.set_audio_priority(vehicle: int, p1: any): void
    AUDIO.SET_AUDIO_VEHICLE_PRIORITY(vehicle, p1)
end

function module.set_horn_permanently_on_time(vehicle: int, time: float): void
    AUDIO.SET_HORN_PERMANENTLY_ON_TIME(vehicle, time)
end

function module.set_startup_rev_sound(vehicle: int, p1: string, p2: string): void
    AUDIO.SET_VEHICLE_STARTUP_REV_SOUND(vehicle, p1, p2)
end

function module.set_force_reverse_warning(p0: any, p1: any): void
    AUDIO.SET_VEHICLE_FORCE_REVERSE_WARNING(p0, p1)
end

function module.set_audio_engine_damage_factor(vehicle: int, damage_factor: float): void
    AUDIO.SET_VEHICLE_AUDIO_ENGINE_DAMAGE_FACTOR(vehicle, damage_factor)
end

function module.set_audio_body_damage_factor(vehicle: int, intensity: float): void
    AUDIO.SET_VEHICLE_AUDIO_BODY_DAMAGE_FACTOR(vehicle, intensity)
end

function module.set_boost_active(vehicle: int, toggle: bool): void
    AUDIO.SET_VEHICLE_BOOST_ACTIVE(vehicle, toggle)
end

function module.set_player_alarm_audio_active(vehicle: int, toggle: bool): void
    AUDIO.SET_PLAYER_VEHICLE_ALARM_AUDIO_ACTIVE(vehicle, toggle)
end

function module.set_script_update_door_audio(door_hash: int, toggle: bool): void
    AUDIO.SET_SCRIPT_UPDATE_DOOR_AUDIO(door_hash, toggle)
end

function module.set_siren_can_be_controlled_by_audio(vehicle: int, p1: bool): void
    AUDIO.SET_SIREN_CAN_BE_CONTROLLED_BY_AUDIO(vehicle, p1)
end

function module.set_horn_sound_index(vehicle: int, value: int): void
    AUDIO.SET_VEHICLE_HORN_SOUND_INDEX(vehicle, value)
end

-- Actions

-- Plays the siren sound of a vehicle which is otherwise activated when fastly double-pressing the horn key
function module.blip_siren(vehicle: int): void
    AUDIO.BLIP_SIREN(vehicle)
end

-- Overrides the vehicle's horn hash
function module.override_horn(vehicle: int, override: bool, horn_hash: int): void
    AUDIO.OVERRIDE_VEH_HORN(vehicle, override, horn_hash)
end

function module.play_stream(vehicle: int): void
    AUDIO.PLAY_STREAM_FROM_VEHICLE(vehicle)
end

function module.trigger_siren_audio(vehicle: int): void
    AUDIO.TRIGGER_SIREN_AUDIO(vehicle)
end

function module.use_siren_as_horn(vehicle: int, toggle: bool): void
    AUDIO.USE_SIREN_AS_HORN(vehicle, toggle)
end

function module.preload_audio_bank(vehicle_model: int): void
    AUDIO.PRELOAD_VEHICLE_AUDIO_BANK(vehicle_model)
end

function module.reset_startup_rev_sound(vehicle: int): void
    AUDIO.RESET_VEHICLE_STARTUP_REV_SOUND(vehicle)
end

-- Called together with SET_VEHICLE_TYRES_CAN_BURST
function module.force_engine_synth(vehicle: int, force: bool): void
    AUDIO._FORCE_VEHICLE_ENGINE_SYNTH(vehicle, force)
end

function module.enable_fanbelt_damage(vehicle: int, toggle: bool): void
    AUDIO.ENABLE_VEHICLE_FANBELT_DAMAGE(vehicle, toggle)
end

function module.enable_exhaust_pops(vehicle: int, toggle: bool): void
    AUDIO.ENABLE_VEHICLE_EXHAUST_POPS(vehicle, toggle)
end

function module.play_door_open_sound(vehicle: int, door_id: int): void
    AUDIO.PLAY_VEHICLE_DOOR_OPEN_SOUND(vehicle, door_id)
end

function module.play_door_close_sound(vehicle: int, door_id: int): void
    AUDIO.PLAY_VEHICLE_DOOR_CLOSE_SOUND(vehicle, door_id)
end

-- Works for planes only
function module.enable_stall_warning_sounds(vehicle: int, toggle: bool): void
    AUDIO.ENABLE_STALL_WARNING_SOUNDS(vehicle, toggle)
end

function module.enable_drag_race_stationary_warning_sounds(vehicle: int, enable: bool): void
    AUDIO._ENABLE_DRAG_RACE_STATIONARY_WARNING_SOUNDS(vehicle, enable)
end

-- If value is set to true, and ambient siren sound will be played
function module.distant_cop_car_sirens(value: bool): void
    AUDIO.DISTANT_COP_CAR_SIRENS(value)
end

return module
