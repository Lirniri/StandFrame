-- Scripted music and music events

local module = {}

-- State

function module.is_game_in_control(): bool
    return AUDIO.IS_GAME_IN_CONTROL_OF_MUSIC()
end

function module.is_oneshot_playing(): bool
    return AUDIO.IS_MUSIC_ONESHOT_PLAYING()
end

-- Get

function module.get_audible_track_text_id(): int
    return AUDIO.GET_AUDIBLE_MUSIC_TRACK_TEXT_ID()
end

function module.get_playtime(): int
    return AUDIO.GET_MUSIC_PLAYTIME()
end

function module.get_vol_slider(): int
    return AUDIO.GET_MUSIC_VOL_SLIDER()
end

-- Actions

function module.play_end_credits(play: bool): void
    AUDIO.PLAY_END_CREDITS_MUSIC(play)
end

-- Changes start time of a tracklist (milliseconds)
function module.force_track_list(radio_station: string, track_list_name: string, milliseconds: int): void
    AUDIO.FORCE_MUSIC_TRACK_LIST(radio_station, track_list_name, milliseconds)
end

function module.audio_is_playing(): bool
    return AUDIO.AUDIO_IS_MUSIC_PLAYING()
end

-- This is an alias of AUDIO_IS_MUSIC_PLAYING
function module.audio_is_scripted_playing(): bool
    return AUDIO.AUDIO_IS_SCRIPTED_MUSIC_PLAYING()
end

function module.prepare_event(event_name: string): bool
    return AUDIO.PREPARE_MUSIC_EVENT(event_name)
end

function module.cancel_event(event_name: string): bool
    return AUDIO.CANCEL_MUSIC_EVENT(event_name)
end

function module.trigger_event(event_name: string): bool
    return AUDIO.TRIGGER_MUSIC_EVENT(event_name)
end

function module.request_tennis_banks(ped: int): void
    AUDIO.REQUEST_TENNIS_BANKS(ped)
end

function module.unrequest_tennis_banks(): void
    AUDIO.UNREQUEST_TENNIS_BANKS()
end

return module
