-- Radio stations and tracks

local module = {}

-- State

function module.is_retuning(): bool
    return AUDIO.IS_RADIO_RETUNING()
end

function module.is_faded_out(): bool
    return AUDIO.IS_RADIO_FADED_OUT()
end

function module.is_vehicle_on(vehicle: int): bool
    return AUDIO.IS_VEHICLE_RADIO_ON(vehicle)
end

function module.can_vehicle_receive_cb(vehicle: int): bool
    return AUDIO.CAN_VEHICLE_RECEIVE_CB_RADIO(vehicle)
end

function module.does_player_veh_have(): bool
    return AUDIO.DOES_PLAYER_VEH_HAVE_RADIO()
end

function module.is_player_veh_enable(): bool
    return AUDIO.IS_PLAYER_VEH_RADIO_ENABLE()
end

function module.is_station_favourited(radio_station: string): bool
    return AUDIO.IS_RADIO_STATION_FAVOURITED(radio_station)
end

-- Get

-- Returns 255 (radio off index) if the function fails
function module.get_player_station_index(): int
    return AUDIO.GET_PLAYER_RADIO_STATION_INDEX()
end

-- Returns active radio station name
function module.get_player_station_name(): string
    return AUDIO.GET_PLAYER_RADIO_STATION_NAME()
end

function module.get_station_name(radio_station: int): string
    return AUDIO.GET_RADIO_STATION_NAME(radio_station)
end

function module.get_player_station_genre(): int
    return AUDIO.GET_PLAYER_RADIO_STATION_GENRE()
end

function module.get_num_unlocked_stations(): int
    return AUDIO.GET_NUM_UNLOCKED_RADIO_STATIONS()
end

-- Set

function module.set_retune_up(): void
    AUDIO.SET_RADIO_RETUNE_UP()
end

function module.set_retune_down(): void
    AUDIO.SET_RADIO_RETUNE_DOWN()
end

function module.set_to_station_name(station_name: string): void
    AUDIO.SET_RADIO_TO_STATION_NAME(station_name)
end

function module.set_veh_station(vehicle: int, radio_station: string): void
    AUDIO.SET_VEH_RADIO_STATION(vehicle, radio_station)
end

function module.set_veh_has_normal(vehicle: int): void
    AUDIO.SET_VEH_HAS_NORMAL_RADIO(vehicle)
end

function module.set_veh_forced_frame(vehicle: int): void
    AUDIO.SET_VEH_FORCED_RADIO_THIS_FRAME(vehicle)
end

function module.set_emitter_station(emitter_name: string, radio_station: string, p2: any): void
    AUDIO.SET_EMITTER_RADIO_STATION(emitter_name, radio_station, p2)
end

-- Sets radio station by index
function module.set_to_station_index(radio_station: int): void
    AUDIO.SET_RADIO_TO_STATION_INDEX(radio_station)
end

function module.set_frontend_active(active: bool): void
    AUDIO.SET_FRONTEND_RADIO_ACTIVE(active)
end

function module.set_auto_unfreeze(toggle: bool): void
    AUDIO.SET_RADIO_AUTO_UNFREEZE(toggle)
end

function module.set_user_control_enabled(toggle: bool): void
    AUDIO.SET_USER_RADIO_CONTROL_ENABLED(toggle)
end

function module.set_track(radio_station: string, radio_track: string): void
    AUDIO.SET_RADIO_TRACK(radio_station, radio_track)
end

function module.set_track_with_start_offset(radio_station_name: string, mix_name: string, p2: int): void
    AUDIO.SET_RADIO_TRACK_WITH_START_OFFSET(radio_station_name, mix_name, p2)
end

function module.set_next_track(radio_name: string, radio_track: string, p2: string, p3: string): void
    AUDIO.SET_NEXT_RADIO_TRACK(radio_name, radio_track, p2, p3)
end

function module.set_vehicle_loud(vehicle: int, toggle: bool): void
    AUDIO.SET_VEHICLE_RADIO_LOUD(vehicle, toggle)
end

function module.set_vehicle_enabled(vehicle: int, toggle: bool): void
    AUDIO.SET_VEHICLE_RADIO_ENABLED(vehicle, toggle)
end

function module.set_positioned_player_vehicle_emitter_enabled(p0: any): void
    AUDIO.SET_POSITIONED_PLAYER_VEHICLE_RADIO_EMITTER_ENABLED(p0)
end

function module.set_custom_track_list(radio_station: string, track_list_name: string, p2: bool): void
    AUDIO.SET_CUSTOM_RADIO_TRACK_LIST(radio_station, track_list_name, p2)
end

function module.set_station_music_only(radio_station: string, toggle: bool): void
    AUDIO.SET_RADIO_STATION_MUSIC_ONLY(radio_station, toggle)
end

function module.set_frontend_fade_time(fade_time: float): void
    AUDIO.SET_RADIO_FRONTEND_FADE_TIME(fade_time)
end

-- Doesn't have an effect in Story Mode
function module.set_station_as_favourite(radio_station: string, toggle: bool): void
    AUDIO.SET_RADIO_STATION_AS_FAVOURITE(radio_station, toggle)
end

function module.set_position_audio_mute(p0: bool): void
    AUDIO.SET_RADIO_POSITION_AUDIO_MUTE(p0)
end

function module.set_global_signal_level(p0: any): void
    AUDIO.SET_GLOBAL_RADIO_SIGNAL_LEVEL(p0)
end

-- Actions

function module.skip_forward(): void
    AUDIO.SKIP_RADIO_FORWARD()
end

function module.freeze_station(radio_station: string): void
    AUDIO.FREEZE_RADIO_STATION(radio_station)
end

function module.unfreeze_station(radio_station: string): void
    AUDIO.UNFREEZE_RADIO_STATION(radio_station)
end

function module.clear_custom_track_list(radio_station: string): void
    AUDIO.CLEAR_CUSTOM_RADIO_TRACK_LIST(radio_station)
end

function module.find_station_index(station_name_hash: int): int
    return AUDIO.FIND_RADIO_STATION_INDEX(station_name_hash)
end

function module.unlock_station_track_list(radio_station: string, track_list_name: string): void
    AUDIO.UNLOCK_RADIO_STATION_TRACK_LIST(radio_station, track_list_name)
end

function module.lock_station_track_list(radio_station: string, track_list_name: string): void
    AUDIO.LOCK_RADIO_STATION_TRACK_LIST(radio_station, track_list_name)
end

function module.update_unlockable_dj_tracks(enable_mixes: bool): void
    AUDIO.UPDATE_UNLOCKABLE_DJ_RADIO_TRACKS(enable_mixes)
end

-- Disables the radio station (hides it from the radio wheel)
function module.lock_station(radio_station_name: string, toggle: bool): void
    AUDIO.LOCK_RADIO_STATION(radio_station_name, toggle)
end

return module
