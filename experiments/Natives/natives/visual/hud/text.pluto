end

function module.begin_command_get_screen_width_of_display(text: string): void
    HUD.BEGIN_TEXT_COMMAND_GET_SCREEN_WIDTH_OF_DISPLAY_TEXT(text)
end

function module.end_command_get_screen_width_of_display(p0: bool): float
    return HUD.END_TEXT_COMMAND_GET_SCREEN_WIDTH_OF_DISPLAY_TEXT(p0)
end

function module.begin_command_get_number_of_lines_for_string(entry: string): void
    HUD.BEGIN_TEXT_COMMAND_GET_NUMBER_OF_LINES_FOR_STRING(entry)
end

-- Determines how many lines the text string will use when drawn on screen
function module.end_command_get_number_of_lines_for_string(x: float, y: float): int
    return HUD.END_TEXT_COMMAND_GET_NUMBER_OF_LINES_FOR_STRING(x, y)
end

-- Used to be known as _SET_TEXT_COMPONENT_FORMAT
function module.begin_command_display_help(input_type: string): void
    HUD.BEGIN_TEXT_COMMAND_DISPLAY_HELP(input_type)
end

function module.end_command_display_help(p0: int, loop: bool, beep: bool, shape: int): void
