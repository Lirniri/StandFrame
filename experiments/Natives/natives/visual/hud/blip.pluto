end

-- Add a BLIP_GALLERY at the specific coordinate. Used in fm_maintain_transition_players to display race track points
function module.custom_minimap_create(x: float, y: float, z: float): int
    return HUD.CUSTOM_MINIMAP_CREATE_BLIP(x, y, z)
end

function module.custom_minimap_clear_blips(): void
    HUD.CUSTOM_MINIMAP_CLEAR_BLIPS()
end

-- Doesn't actually return anything
function module.force_sonar_blips_this_frame(): bool
    return HUD.FORCE_SONAR_BLIPS_THIS_FRAME()
end

-- Toggles whether or not name labels are shown on the expanded minimap next to player blips, like in GTA:O
function module.display_player_name_tags_on_blips(toggle: bool): void
    HUD.DISPLAY_PLAYER_NAME_TAGS_ON_BLIPS(toggle)
end

return module
