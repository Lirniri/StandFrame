local module = { waypoint = {} }

function module.is_exist(blip: int): bool
    return HUD.DOES_BLIP_EXIST(blip)
end

function module.get_id(sprite: int, next): int
    if next then
        return HUD.GET_NEXT_BLIP_INFO_ID(sprite)
    end
    return HUD.GET_FIRST_BLIP_INFO_ID(sprite)
end

function module.get_type(blip: int): int
    return HUD.GET_BLIP_INFO_ID_TYPE(blip)
end

function module.get_sprite(blip: int): int
    return HUD.GET_BLIP_SPRITE(blip)
end

function module.get_alpha(blip: int): int
    return HUD.GET_BLIP_ALPHA(blip)
end

function module.get_rotation(blip: int): int
    return HUD.GET_BLIP_ROTATION(blip)
end

function module.get_color(blip: int, hud_color: bool = false): int
    if hud_color then
        return HUD.GET_BLIP_HUD_COLOUR(blip)
    end
    return HUD.GET_BLIP_COLOUR(blip)
end

function module.get_coords(blip: int): ?vector3
    if not module.is_exist(blip) then
        return nil
    end
    return v3.new(HUD.GET_BLIP_INFO_ID_COORD(blip))
end

function module.get_from_entity(entity: int): ?int
    local blip = HUD.GET_BLIP_FROM_ENTITY(entity)
    if module.is_exist(blip) then
        return blip
    else
        return nil
    end
end

-- all blips with the specified sprite
function module.get_all(sprite: int = 0): table
    local blips = {}
    local blip = HUD.GET_FIRST_BLIP_INFO_ID(sprite)
    while module.is_exist(blip) do
        table.insert(blips, blip)
        blip = HUD.GET_NEXT_BLIP_INFO_ID(sprite)
    end
    return blips
end

function module.waypoint.get_sprite(): int
    return HUD.GET_WAYPOINT_BLIP_ENUM_ID()
end

-- State

function module.is_short_range(blip: int): bool
    return HUD.IS_BLIP_SHORT_RANGE(blip)
end

function module.is_on_minimap(blip: int): bool
    return HUD.IS_BLIP_ON_MINIMAP(blip)
end

function module.does_have_gps_route(blip: int): bool
    return HUD.DOES_BLIP_HAVE_GPS_ROUTE(blip)
end

function module.is_mission_creator(blip: int): bool
    return HUD.IS_MISSION_CREATOR_BLIP(blip)
end

function module.is_hovering_over_mission_creator(): bool
    return HUD.IS_HOVERING_OVER_MISSION_CREATOR_BLIP()
end

function module.is_flashing(blip: int): bool
    return HUD.IS_BLIP_FLASHING(blip)
end

function module.does_ped_have_ai(ped: int): bool
    return HUD.DOES_PED_HAVE_AI_BLIP(ped)
end

-- Get

function module.get_standard_enum_id(): int
    return HUD.GET_STANDARD_BLIP_ENUM_ID()
end

function module.get_number_of_active_blips(): int
    return HUD.GET_NUMBER_OF_ACTIVE_BLIPS()
end

function module.get_closest_info_id(blip_sprite: int): int
    return HUD.GET_CLOSEST_BLIP_INFO_ID(blip_sprite)
end

function module.get_info_id_display(blip: int): int
    return HUD.GET_BLIP_INFO_ID_DISPLAY(blip)
end

function module.get_info_id_entity_index(blip: int): int
    return HUD.GET_BLIP_INFO_ID_ENTITY_INDEX(blip)
end

function module.get_info_id_pickup_index(blip: int): int
    return HUD.GET_BLIP_INFO_ID_PICKUP_INDEX(blip)
end

function module.get_blip_coords(blip: int): vector3
    return HUD.GET_BLIP_COORDS(blip)
end

-- Returns -1, 0, +1, depending on if the blip is fading out, doing nothing, or fading in respectively
function module.get_fade_direction(blip: int): int
    return HUD.GET_BLIP_FADE_DIRECTION(blip)
end

function module.get_new_selected_mission_creator(): int
    return HUD.GET_NEW_SELECTED_MISSION_CREATOR_BLIP()
end

function module.get_main_player_id(): int
