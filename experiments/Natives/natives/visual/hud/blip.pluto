end

function module.get_ai_ped_ped_index(ped: int): int
    return HUD.GET_AI_PED_PED_BLIP_INDEX(ped)
end

-- Returns the current AI BLIP for the specified ped
function module.get_ai_ped_vehicle_index(ped: int): int
    return HUD.GET_AI_PED_VEHICLE_BLIP_INDEX(ped)
end

-- Set

-- Enable / disable showing route for the Blip-object
function module.set_route(blip: int, enabled: bool): void
