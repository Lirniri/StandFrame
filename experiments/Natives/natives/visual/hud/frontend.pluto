-- The pause menu (frontend)

local module = {}

-- State

function module.is_pause_menu_active(): bool
    return HUD.IS_PAUSE_MENU_ACTIVE()
end

function module.is_pause_menu_restarting(): bool
    return HUD.IS_PAUSE_MENU_RESTARTING()
end

function module.is_ready_for_control(): bool
    return HUD.IS_FRONTEND_READY_FOR_CONTROL()
end

-- Get

function module.get_current_menu_version(): int
    return HUD.GET_CURRENT_FRONTEND_MENU_VERSION()
end

function module.get_pause_menu_state(): int
    return HUD.GET_PAUSE_MENU_STATE()
end

function module.get_pause_menu_position(): vector3
    return HUD.GET_PAUSE_MENU_POSITION()
end

-- Set

function module.set_pause_menu_active(toggle: bool): void
    HUD.SET_PAUSE_MENU_ACTIVE(toggle)
end

function module.set_active(active: bool): void
    HUD.SET_FRONTEND_ACTIVE(active)
end

-- Toggles the light state for the pause menu ped in frontend menus
function module.set_pause_menu_ped_lighting(state: bool): void
    HUD.SET_PAUSE_MENU_PED_LIGHTING(state)
end

-- Toggles the pause menu ped sleep state for frontend menus
function module.set_pause_menu_ped_sleep_state(state: bool): void
    HUD.SET_PAUSE_MENU_PED_SLEEP_STATE(state)
end

-- Actions

function module.disable_pausemenu_spinner(p0: bool): void
    HUD.DISABLE_PAUSEMENU_SPINNER(p0)
end

function module.clear_dynamic_pause_menu_error_message(): void
    HUD.CLEAR_DYNAMIC_PAUSE_MENU_ERROR_MESSAGE()
end

function module.draw_background_this_frame(): void
    HUD.DRAW_FRONTEND_BACKGROUND_THIS_FRAME()
end

function module.activate_menu(menuhash: int, toggle_pause: bool, component: int): void
    HUD.ACTIVATE_FRONTEND_MENU(menuhash, toggle_pause, component)
end

-- Before using this native click the native above and look at the decription
function module.restart_menu(menu_hash: int, p1: int): void
    HUD.RESTART_FRONTEND_MENU(menu_hash, p1)
end

function module.disable_frame(): void
    HUD.DISABLE_FRONTEND_THIS_FRAME()
end

function module.suppress_rendering_this_frame(): void
    HUD.SUPPRESS_FRONTEND_RENDERING_THIS_FRAME()
end

-- Not present in retail version of the game, actual definiton seems to be
function module.force_scripted_gfx_when_active(p0: string): void
    HUD.FORCE_SCRIPTED_GFX_WHEN_FRONTEND_ACTIVE(p0)
end

function module.pause_menuception_go_deeper(page: int): void
    HUD.PAUSE_MENUCEPTION_GO_DEEPER(page)
end

function module.pause_menuception_the_kick(): void
    HUD.PAUSE_MENUCEPTION_THE_KICK()
end

-- Activates the specified frontend menu context
function module.pause_menu_activate_context(context_hash: int): void
    HUD.PAUSE_MENU_ACTIVATE_CONTEXT(context_hash)
end

function module.pause_menu_deactivate_context(context_hash: int): void
    HUD.PAUSE_MENU_DEACTIVATE_CONTEXT(context_hash)
end

function module.pause_menu_is_context_active(context_hash: int): bool
    return HUD.PAUSE_MENU_IS_CONTEXT_ACTIVE(context_hash)
end

function module.pause_menu_is_context_menu_active(): bool
    return HUD.PAUSE_MENU_IS_CONTEXT_MENU_ACTIVE()
end

function module.pause_menu_get_hair_colour_index(): int
    return HUD.PAUSE_MENU_GET_HAIR_COLOUR_INDEX()
end

function module.pause_menu_get_mouse_hover_index(): int
    return HUD.PAUSE_MENU_GET_MOUSE_HOVER_INDEX()
end

function module.pause_menu_get_mouse_hover_unique_id(): int
    return HUD.PAUSE_MENU_GET_MOUSE_HOVER_UNIQUE_ID()
end

-- @param p0 Pointer: pass memory.alloc(size) and read the result back
-- @param p1 Pointer: pass memory.alloc(size) and read the result back
-- @param p2 Pointer: pass memory.alloc(size) and read the result back
function module.pause_menu_get_mouse_click_event(p0: int, p1: int, p2: int): bool
    return HUD.PAUSE_MENU_GET_MOUSE_CLICK_EVENT(p0, p1, p2)
end

function module.pause_menu_redraw_instructional_buttons(p0: int): void
    HUD.PAUSE_MENU_REDRAW_INSTRUCTIONAL_BUTTONS(p0)
end

function module.pause_menu_set_busy_spinner(p0: bool, position: int, spinner_index: int): void
    HUD.PAUSE_MENU_SET_BUSY_SPINNER(p0, position, spinner_index)
end

function module.pause_menu_set_warn_on_tab_change(p0: bool): void
    HUD.PAUSE_MENU_SET_WARN_ON_TAB_CHANGE(p0)
end

function module.take_control(): void
    HUD.TAKE_CONTROL_OF_FRONTEND()
end

function module.release_control(): void
    HUD.RELEASE_CONTROL_OF_FRONTEND()
end

function module.clear_ped_in_pause_menu(): void
    HUD.CLEAR_PED_IN_PAUSE_MENU()
end

function module.give_ped_to_pause_menu(ped: int, p1: int): void
    HUD.GIVE_PED_TO_PAUSE_MENU(ped, p1)
end

return module
