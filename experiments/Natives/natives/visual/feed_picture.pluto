-- Pictures for the game feed's message cards (thefeed.post_message opts.picture): CHAR_* texture
-- dictionaries, each with a texture of the same name - contacts, companies, sites.
-- Source of the names: https://pastebin.com/XdpJVbHz (167 names), plus ACTING_UP. Some dictionaries are loaded only
-- in some game modes; a picture that isn't loaded shows empty on the card.
--
--     local feed_picture = Atdar.natives.visual.feed_picture
--     feed_picture.LESTER               -- "CHAR_LESTER"
--     thefeed.post_message("Text", { picture = feed_picture.LESTER })
--     feed_picture.is_known("CHAR_LESTER") -- true
--     feed_picture.list()               -- every name, e.g. for a menu list
--     feed_picture.title("CHAR_SOCIAL_CLUB") -- "Social Club", for showing it

