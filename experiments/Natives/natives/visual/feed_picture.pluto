-- module.LESTER == "CHAR_LESTER"
local KNOWN = {}
for _, short in ipairs(PICTURES) do
    local full = $"CHAR_{short}"
    module[short] = full
    KNOWN[full] = true
end

-- State

-- @param name A full name, "CHAR_LESTER"
function module.is_known(name: string): bool
    return KNOWN[name] == true
end

-- Get

-- @return Every picture's full name ("CHAR_LESTER"), in the source's order (a copy)
function module.list(): table
    local list = {}
    for _, short in ipairs(PICTURES) do
        table.insert(list, $"CHAR_{short}")
    end
    return list
end

-- @return The name to show: "CHAR_SOCIAL_CLUB" -> "Social Club", "CHAR_MP_FM_CONTACT" -> "Mp Fm Contact"
function module.title(name: string): string
    local words = {}
    for word in name:gsub("^CHAR_", ""):gmatch("[^_]+") do
        table.insert(words, word:sub(1, 1):upper() .. word:sub(2):lower())
    end
    return table.concat(words, " ")
end

return module
