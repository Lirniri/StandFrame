-- 2D / 3D drawing (lines, rects, sprites, polys)

local module = {}

-- Set

function module.set_script_gfx_draw_behind_pausemenu(toggle: bool): void
    GRAPHICS.SET_SCRIPT_GFX_DRAW_BEHIND_PAUSEMENU(toggle)
end

-- Sets the draw order for script draw commands
function module.set_script_gfx_draw_order(draw_order: int): void
    GRAPHICS.SET_SCRIPT_GFX_DRAW_ORDER(draw_order)
end

function module.set_draw_origin(x: float, y: float, z: float, p3: bool): void
    GRAPHICS.SET_DRAW_ORIGIN(x, y, z, p3)
end

-- Actions

function module.draw_debug_line(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, r: int, g: int, b: int,
    alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_LINE(x1, y1, z1, x2, y2, z2, r, g, b, alpha)
end

function module.draw_debug_line_with_two_colours(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, r1: int, g1: int, b1: int,
    r2: int, g2: int, b2: int, alpha1: int, alpha2: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_LINE_WITH_TWO_COLOURS(x1, y1, z1, x2, y2, z2, r1, g1, b1, r2, g2, b2, alpha1, alpha2)
end

function module.draw_debug_sphere(
    x: float, y: float, z: float, radius: float, red: int, green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_SPHERE(x, y, z, radius, red, green, blue, alpha)
end

function module.draw_debug_box(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, r: int, g: int, b: int,
    alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_BOX(x1, y1, z1, x2, y2, z2, r, g, b, alpha)
end

function module.draw_debug_cross(
    x: float, y: float, z: float, size: float, red: int, green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_CROSS(x, y, z, size, red, green, blue, alpha)
end

function module.draw_debug_text(
    text: string, x: float, y: float, z: float, red: int, green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_TEXT(text, x, y, z, red, green, blue, alpha)
end

function module.draw_debug_text_2d(
    text: string, x: float, y: float, z: float, red: int, green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_DEBUG_TEXT_2D(text, x, y, z, red, green, blue, alpha)
end

-- Draws a depth-tested line from one point to another
function module.draw_line(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, red: int, green: int,
    blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_LINE(x1, y1, z1, x2, y2, z2, red, green, blue, alpha)
end

function module.draw_poly(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, x3: float, y3: float,
    z3: float, red: int, green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_POLY(x1, y1, z1, x2, y2, z2, x3, y3, z3, red, green, blue, alpha)
end

function module.draw_textured_poly(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, x3: float, y3: float,
    z3: float, red: int, green: int, blue: int, alpha: int, texture_dict: string,
    texture_name: string, u1: float, v1: float, w1: float, u2: float, v2: float, w2: float,
    u3: float, v3: float, w3: float
): void
    -- body function:
    GRAPHICS.DRAW_TEXTURED_POLY(x1, y1, z1, x2, y2, z2, x3, y3, z3, red, green, blue, alpha, texture_dict, texture_name, u1, v1, w1, u2, v2, w2, u3, v3, w3)
end

function module.draw_textured_poly_with_three_colours(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, x3: float, y3: float,
    z3: float, red1: float, green1: float, blue1: float, alpha1: int, red2: float, green2: float,
    blue2: float, alpha2: int, red3: float, green3: float, blue3: float, alpha3: int,
    texture_dict: string, texture_name: string, u1: float, v1: float, w1: float, u2: float,
    v2: float, w2: float, u3: float, v3: float, w3: float
): void
    -- body function:
    GRAPHICS.DRAW_TEXTURED_POLY_WITH_THREE_COLOURS(x1, y1, z1, x2, y2, z2, x3, y3, z3, red1, green1, blue1, alpha1, red2, green2, blue2, alpha2, red3, green3, blue3, alpha3, texture_dict, texture_name, u1, v1, w1, u2, v2, w2, u3, v3, w3)
end

function module.draw_box(
    x1: float, y1: float, z1: float, x2: float, y2: float, z2: float, red: int, green: int,
    blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_BOX(x1, y1, z1, x2, y2, z2, red, green, blue, alpha)
end

function module.draw_low_quality_photo_to_phone(p0: bool, p1: bool): void
    GRAPHICS.DRAW_LOW_QUALITY_PHOTO_TO_PHONE(p0, p1)
end

-- Draws a rectangle on the screen
function module.draw_rect(
    x: float, y: float, width: float, height: float, r: int, g: int, b: int, a: int, p8: bool
): void
    -- body function:
    GRAPHICS.DRAW_RECT(x, y, width, height, r, g, b, a, p8)
end

-- Draws a 2D sprite on the screen
function module.draw_sprite(
    texture_dict: string, texture_name: string, screen_x: float, screen_y: float, width: float,
    height: float, heading: float, red: int, green: int, blue: int, alpha: int, p11: bool, p12: any
): void
    -- body function:
    GRAPHICS.DRAW_SPRITE(texture_dict, texture_name, screen_x, screen_y, width, height, heading, red, green, blue, alpha, p11, p12)
end

function module.draw_sprite_arx(
    texture_dict: string, texture_name: string, x: float, y: float, width: float, height: float,
    p6: float, red: int, green: int, blue: int, alpha: int, p11: any, p12: any
): void
    -- body function:
    GRAPHICS.DRAW_SPRITE_ARX(texture_dict, texture_name, x, y, width, height, p6, red, green, blue, alpha, p11, p12)
end

-- Similar to _DRAW_SPRITE, but seems to be some kind of "interactive" sprite, at least used by render targets
function module.draw_sprite_named_rendertarget(
    texture_dict: string, texture_name: string, screen_x: float, screen_y: float, width: float,
    height: float, heading: float, red: int, green: int, blue: int, alpha: int, p11: any
): void
    -- body function:
    GRAPHICS.DRAW_SPRITE_NAMED_RENDERTARGET(texture_dict, texture_name, screen_x, screen_y, width, height, heading, red, green, blue, alpha, p11)
end

-- Similar to DRAW_SPRITE, but allows to specify the texture coordinates used to draw the sprite
function module.draw_sprite_arx_with_uv(
    texture_dict: string, texture_name: string, x: float, y: float, width: float, height: float,
    u1: float, v1: float, u2: float, v2: float, heading: float, red: int, green: int, blue: int,
    alpha: int, p15: any
): void
    -- body function:
    GRAPHICS.DRAW_SPRITE_ARX_WITH_UV(texture_dict, texture_name, x, y, width, height, u1, v1, u2, v2, heading, red, green, blue, alpha, p15)
end

function module.clear_draw_origin(): void
    GRAPHICS.CLEAR_DRAW_ORIGIN()
end

function module.draw_bink_movie(
    bink_movie: int, p1: float, p2: float, p3: float, p4: float, p5: float, r: int, g: int, b: int,
    a: int
): void
    -- body function:
    GRAPHICS.DRAW_BINK_MOVIE(bink_movie, p1, p2, p3, p4, p5, r, g, b, a)
end

function module.draw_tv_channel(
    x_pos: float, y_pos: float, x_scale: float, y_scale: float, rotation: float, red: int,
    green: int, blue: int, alpha: int
): void
    -- body function:
    GRAPHICS.DRAW_TV_CHANNEL(x_pos, y_pos, x_scale, y_scale, rotation, red, green, blue, alpha)
end

return module
