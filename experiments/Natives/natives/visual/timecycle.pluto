-- Timecycle modifiers (screen effects)

local module = {}

-- Get

function module.get_modifier_index(): int
    return GRAPHICS.GET_TIMECYCLE_MODIFIER_INDEX()
end

function module.get_transition_modifier_index(): int
    return GRAPHICS.GET_TIMECYCLE_TRANSITION_MODIFIER_INDEX()
end

function module.get_is_transitioning_out(): bool
    return GRAPHICS.GET_IS_TIMECYCLE_TRANSITIONING_OUT()
end

-- Set

-- Loads the specified timecycle modifier. Modifiers are defined separately in another file (e.g. "timecycle_mods_1.xml")
function module.set_modifier(modifier_name: string): void
    GRAPHICS.SET_TIMECYCLE_MODIFIER(modifier_name)
end

function module.set_modifier_strength(strength: float): void
    GRAPHICS.SET_TIMECYCLE_MODIFIER_STRENGTH(strength)
end

function module.set_transition_modifier(modifier_name: string, transition: float): void
    GRAPHICS.SET_TRANSITION_TIMECYCLE_MODIFIER(modifier_name, transition)
end

function module.set_transition_out_modifier(strength: float): void
    GRAPHICS.SET_TRANSITION_OUT_OF_TIMECYCLE_MODIFIER(strength)
end

-- Actions

function module.clear_modifier(): void
    GRAPHICS.CLEAR_TIMECYCLE_MODIFIER()
end

function module.push_modifier(): void
    GRAPHICS.PUSH_TIMECYCLE_MODIFIER()
end

function module.pop_modifier(): void
    GRAPHICS.POP_TIMECYCLE_MODIFIER()
end

return module
