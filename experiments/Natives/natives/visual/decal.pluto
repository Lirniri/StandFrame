-- Decals on surfaces

local module = {}

-- State

function module.is_alive(decal: int): bool
    return GRAPHICS.IS_DECAL_ALIVE(decal)
end

-- Get

function module.get_wash_level(decal: int): float
    return GRAPHICS.GET_DECAL_WASH_LEVEL(decal)
end

function module.get_is_petrol_in_range(x_coord: float, y_coord: float, z_coord: float, radius: float): bool
    return GRAPHICS.GET_IS_PETROL_DECAL_IN_RANGE(x_coord, y_coord, z_coord, radius)
end

-- Set

function module.set_disable_petrol_decals_igniting_this_frame(): void
    GRAPHICS.SET_DISABLE_PETROL_DECALS_IGNITING_THIS_FRAME()
end

function module.set_disable_petrol_decals_recycling_this_frame(): void
    GRAPHICS.SET_DISABLE_PETROL_DECALS_RECYCLING_THIS_FRAME()
end

function module.set_disable_rendering_this_frame(): void
    GRAPHICS.SET_DISABLE_DECAL_RENDERING_THIS_FRAME()
end

function module.set_bullet_impact_range_scale(p0: float): void
    GRAPHICS.SET_DECAL_BULLET_IMPACT_RANGE_SCALE(p0)
end

-- Actions

function module.wash_decals_in_range(x: float, y: float, z: float, range: float, p4: float): void
    GRAPHICS.WASH_DECALS_IN_RANGE(x, y, z, range, p4)
end

function module.wash_decals_from_vehicle(vehicle: int, p1: float): void
    GRAPHICS.WASH_DECALS_FROM_VEHICLE(vehicle, p1)
end

-- Fades nearby decals within the range specified
function module.fade_decals_in_range(x: float, y: float, z: float, p3: float, p4: float): void
    GRAPHICS.FADE_DECALS_IN_RANGE(x, y, z, p3, p4)
end

-- Removes all decals in range from a position, it includes the bullet holes, blood pools, petrol
function module.remove_decals_in_range(x: float, y: float, z: float, range: float): void
    GRAPHICS.REMOVE_DECALS_IN_RANGE(x, y, z, range)
end

function module.remove_decals_from_object(obj: int): void
    GRAPHICS.REMOVE_DECALS_FROM_OBJECT(obj)
end

function module.remove_decals_from_object_facing(obj: int, x: float, y: float, z: float): void
    GRAPHICS.REMOVE_DECALS_FROM_OBJECT_FACING(obj, x, y, z)
end

function module.remove_decals_from_vehicle(vehicle: int): void
    GRAPHICS.REMOVE_DECALS_FROM_VEHICLE(vehicle)
end

function module.add(
    decal_type: int, pos_x: float, pos_y: float, pos_z: float, p4: float, p5: float, p6: float,
    p7: float, p8: float, p9: float, width: float, height: float, r_coef: float, g_coef: float,
    b_coef: float, opacity: float, timeout: float, p17: bool, p18: bool, p19: bool
): int
    -- body function:
    return GRAPHICS.ADD_DECAL(decal_type, pos_x, pos_y, pos_z, p4, p5, p6, p7, p8, p9, width, height, r_coef, g_coef, b_coef, opacity, timeout, p17, p18, p19)
end

function module.add_petrol(
    x: float, y: float, z: float, ground_lvl: float, width: float, transparency: float
): int
    -- body function:
    return GRAPHICS.ADD_PETROL_DECAL(x, y, z, ground_lvl, width, transparency)
end

function module.add_oil(
    x: float, y: float, z: float, ground_lvl: float, width: float, transparency: float
): int
    -- body function:
    return GRAPHICS.ADD_OIL_DECAL(x, y, z, ground_lvl, width, transparency)
end

function module.start_petrol_trail_decals(p0: float): void
    GRAPHICS.START_PETROL_TRAIL_DECALS(p0)
end

function module.add_petrol_trail_info(x: float, y: float, z: float, p3: float): void
    GRAPHICS.ADD_PETROL_TRAIL_DECAL_INFO(x, y, z, p3)
end

function module.end_petrol_trail_decals(): void
    GRAPHICS.END_PETROL_TRAIL_DECALS()
end

function module.remove(decal: int): void
    GRAPHICS.REMOVE_DECAL(decal)
end

function module.patch_diffuse_map(decal_type: int, texture_dict: string, texture_name: string): void
    GRAPHICS.PATCH_DECAL_DIFFUSE_MAP(decal_type, texture_dict, texture_name)
end

function module.unpatch_diffuse_map(decal_type: int): void
    GRAPHICS.UNPATCH_DECAL_DIFFUSE_MAP(decal_type)
end

function module.move_vehicle_decals(p0: any, p1: any): void
    GRAPHICS.MOVE_VEHICLE_DECALS(p0, p1)
end

function module.disable_composite_shotgun_decals(toggle: bool): void
    GRAPHICS.DISABLE_COMPOSITE_SHOTGUN_DECALS(toggle)
end

function module.disable_scuff_decals(toggle: bool): void
    GRAPHICS.DISABLE_SCUFF_DECALS(toggle)
end

return module
