local module = {}

-- Session
function module.is_started()
    return util.is_session_started()
end
function module.is_active()
    return NETWORK.NETWORK_IS_SESSION_ACTIVE()
end
function module.is_busy()
    return NETWORK.NETWORK_IS_SESSION_BUSY()
end
function module.is_visible()
    return NETWORK.NETWORK_SESSION_IS_VISIBLE()
end

function module.is_private(): bool
    return NETWORK.NETWORK_SESSION_IS_PRIVATE()
end
function module.is_closed_crew(): bool
    return NETWORK.NETWORK_SESSION_IS_CLOSED_CREW()
end
function module.is_closed_friends(): bool
    return NETWORK.NETWORK_SESSION_IS_CLOSED_FRIENDS()
end
function module.is_solo(): bool
    return NETWORK.NETWORK_SESSION_IS_SOLO()
end

function module.get_type(): int
    local is_private = module.is_private()
    local is_closed_crew = module.is_closed_crew()
    local is_closed_friends = module.is_closed_friends()
    local is_solo =  module.is_solo()

    if is_private then
        return 1
    end
    if is_closed_crew then
        return 2
    end
    if is_closed_friends then
        return 3
    end
    if is_solo then
        return 4
    end

    return 0
end
function module.get_status(): table
    
end

