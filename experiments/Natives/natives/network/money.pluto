-- Multiplayer cash: earn / spend natives (MONEY)

local module = {}

-- State

function module.can_share_job_cash(): bool
    return MONEY.NETWORK_CAN_SHARE_JOB_CASH()
end

function module.can_bet(amount: int): bool
    return MONEY.NETWORK_CAN_BET(amount)
end

-- @param p3 Pointer: pass memory.alloc(size) and read the result back
function module.can_pay_amount_to_boss(p0: int, p1: int, amount: int, p3: int): bool
    return MONEY.CAN_PAY_AMOUNT_TO_BOSS(p0, p1, amount, p3)
end

