-- Crews (clans)

local module = {}

-- State

-- @param clan_desc Pointer: pass memory.alloc(size) and read the result back
function module.is_rockstar(clan_desc: int, buffer_size: int): bool
    return NETWORK.NETWORK_CLAN_IS_ROCKSTAR_CLAN(clan_desc, buffer_size)
end

function module.has_crewinfo_metadata_been_received(): bool
    return NETWORK.NETWORK_CLAN_HAS_CREWINFO_METADATA_BEEN_RECEIVED()
end

