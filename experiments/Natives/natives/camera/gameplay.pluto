end

-- Actions

function module.reset_full_attach_parent_transform_timer(): void
    CAM.RESET_GAMEPLAY_CAM_FULL_ATTACH_PARENT_TRANSFORM_TIMER()
end

function module.force_bonnet_relative_heading_and_pitch(p0: float, p1: float): void
    CAM.FORCE_BONNET_CAMERA_RELATIVE_HEADING_AND_PITCH(p0, p1)
end

function module.shake(shake_name: string, intensity: float): void
    CAM.SHAKE_GAMEPLAY_CAM(shake_name, intensity)
end

function module.stop_shaking(p0: bool): void
    CAM.STOP_GAMEPLAY_CAM_SHAKING(p0)
end

-- Shows the crosshair even if it wouldn't show normally. Only works for one frame, so make sure to call it repeatedly
function module.disable_altitude_fov_scaling_this_update(): void
    CAM.DISABLE_GAMEPLAY_CAM_ALTITUDE_FOV_SCALING_THIS_UPDATE()
end

-- Sets some flag on cinematic camera
function module.disable_first_person_water_clipping_test_this_update(): void
    CAM.DISABLE_FIRST_PERSON_CAMERA_WATER_CLIPPING_TEST_THIS_UPDATE()
end

-- Disables first person camera for the current frame
function module.disable_on_foot_first_person_view_this_update(): void
    CAM.DISABLE_ON_FOOT_FIRST_PERSON_VIEW_THIS_UPDATE()
end

function module.disable_first_person_flash_effect_this_update(): void
    CAM.DISABLE_FIRST_PERSON_FLASH_EFFECT_THIS_UPDATE()
end

function module.block_first_person_orientation_reset_this_update(): void
    CAM.BLOCK_FIRST_PERSON_ORIENTATION_RESET_THIS_UPDATE()
end

function module.use_vehicle_stunt_settings_this_update(): void
    CAM.USE_VEHICLE_CAM_STUNT_SETTINGS_THIS_UPDATE()
end

-- Sets gameplay camera to hash
function module.use_dedicated_stunt_update(cam_name: string): void
    CAM.USE_DEDICATED_STUNT_CAMERA_THIS_UPDATE(cam_name)
end

function module.force_vehicle_stunt_settings_this_update(): void
    CAM.FORCE_VEHICLE_CAM_STUNT_SETTINGS_THIS_UPDATE()
end

function module.disable_aim_update(): void
    CAM.DISABLE_AIM_CAM_THIS_UPDATE()
end

function module.stop_hint(p0: bool): void
    CAM.STOP_GAMEPLAY_HINT(p0)
end

function module.stop_hint_being_cancelled_this_update(p0: bool): void
    CAM.STOP_GAMEPLAY_HINT_BEING_CANCELLED_THIS_UPDATE(p0)
end

function module.stop_code_hint(p0: bool): void
    CAM.STOP_CODE_GAMEPLAY_HINT(p0)
end

function module.disable_cinematic_bonnet_update(): void
    CAM.DISABLE_CINEMATIC_BONNET_CAMERA_THIS_UPDATE()
end

function module.ignore_menu_preference_for_bonnet_update(): void
    CAM.IGNORE_MENU_PREFERENCE_FOR_BONNET_CAMERA_THIS_UPDATE()
end

return module
