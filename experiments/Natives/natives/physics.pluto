-- Ropes and other physics (PHYSICS natives)

local module = {}

-- State

-- @param rope_id Pointer: pass memory.alloc(size) and read the result back
function module.does_rope_exist(rope_id: int): bool
    return PHYSICS.DOES_ROPE_EXIST(rope_id)
end

-- @param rope_id Pointer: pass memory.alloc(size) and read the result back
function module.is_rope_attached_at_both_ends(rope_id: int): bool
    return PHYSICS.IS_ROPE_ATTACHED_AT_BOTH_ENDS(rope_id)
end

function module.does_script_own_rope(rope_id: int): bool
    return PHYSICS.DOES_SCRIPT_OWN_ROPE(rope_id)
end

-- Get

function module.get_rope_vertex_count(rope_id: int): int
    return PHYSICS.GET_ROPE_VERTEX_COUNT(rope_id)
end

function module.get_rope_last_vertex_coord(rope_id: int): vector3
    return PHYSICS.GET_ROPE_LAST_VERTEX_COORD(rope_id)
end

function module.get_rope_vertex_coord(rope_id: int, vertex: int): vector3
    return PHYSICS.GET_ROPE_VERTEX_COORD(rope_id, vertex)
end

function module.get_damping(entity: int, type: int): vector3
    return PHYSICS.GET_DAMPING(entity, type)
end

function module.get_cgoffset(entity: int): vector3
    return PHYSICS.GET_CGOFFSET(entity)
end

function module.get_is_entity_a_frag(object: int): bool
    return PHYSICS.GET_IS_ENTITY_A_FRAG(object)
end

-- Set

function module.set_damping(entity: int, vertex: int, value: float): void
    PHYSICS.SET_DAMPING(entity, vertex, value)
end

function module.set_cgoffset(entity: int, x: float, y: float, z: float): void
    PHYSICS.SET_CGOFFSET(entity, x, y, z)
end

function module.set_cg_at_boundcenter(entity: int): void
    PHYSICS.SET_CG_AT_BOUNDCENTER(entity)
end

function module.set_disable_breaking(object: int, toggle: bool): void
    PHYSICS.SET_DISABLE_BREAKING(object, toggle)
end

function module.set_disable_frag_damage(object: int, toggle: bool): void
    PHYSICS.SET_DISABLE_FRAG_DAMAGE(object, toggle)
end

function module.set_use_kinematic_physics(entity: int, toggle: bool): void
    PHYSICS.SET_USE_KINEMATIC_PHYSICS(entity, toggle)
end

function module.set_in_stunt_mode(p0: bool): void
    PHYSICS.SET_IN_STUNT_MODE(p0)
end

-- Related to the lower-end of a vehicles fTractionCurve, e.g., from standing starts and acceleration from low/zero speeds
function module.set_in_arena_mode(toggle: bool): void
    PHYSICS.SET_IN_ARENA_MODE(toggle)
end

-- Actions

-- Creates a rope at the specific position, that extends in the specified direction when not attached to any entities
-- @param unk_ptr Pointer: pass memory.alloc(size) and read the result back
function module.add_rope(
    x: float, y: float, z: float, rot_x: float, rot_y: float, rot_z: float, length: float,
    rope_type: int, max_length: float, min_length: float, winding_speed: float, p11: bool,
    p12: bool, rigid: bool, p14: float, break_when_shot: bool, unk_ptr: int
): int
    -- body function:
    return PHYSICS.ADD_ROPE(x, y, z, rot_x, rot_y, rot_z, length, rope_type, max_length, min_length, winding_speed, p11, p12, rigid, p14, break_when_shot, unk_ptr)
end

-- @param rope_id Pointer: pass memory.alloc(size) and read the result back
function module.delete_rope(rope_id: int): void
    PHYSICS.DELETE_ROPE(rope_id)
end

function module.delete_child_rope(rope_id: int): void
    PHYSICS.DELETE_CHILD_ROPE(rope_id)
end

-- @param rope_id Pointer: pass memory.alloc(size) and read the result back
function module.rope_draw_enabled(rope_id: int, p1: bool): void
    PHYSICS.ROPE_DRAW_ENABLED(rope_id, p1)
end

-- @param rope_id Pointer: pass memory.alloc(size) and read the result back
function module.rope_draw_shadow_enabled(rope_id: int, toggle: bool): void
    PHYSICS.ROPE_DRAW_SHADOW_ENABLED(rope_id, toggle)
end

function module.load_rope_data(rope_id: int, rope_preset: string): void
    PHYSICS.LOAD_ROPE_DATA(rope_id, rope_preset)
end

function module.pin_rope_vertex(rope_id: int, vertex: int, x: float, y: float, z: float): void
    PHYSICS.PIN_ROPE_VERTEX(rope_id, vertex, x, y, z)
end

function module.unpin_rope_vertex(rope_id: int, vertex: int): void
    PHYSICS.UNPIN_ROPE_VERTEX(rope_id, vertex)
end

-- Attaches entity 1 to entity 2
-- @param p12 Pointer: pass memory.alloc(size) and read the result back
-- @param p13 Pointer: pass memory.alloc(size) and read the result back
function module.attach_entities_to_rope(
    rope_id: int, ent1: int, ent2: int, ent1_x: float, ent1_y: float, ent1_z: float, ent2_x: float,
    ent2_y: float, ent2_z: float, length: float, p10: bool, p11: bool, p12: int, p13: int
): void
    -- body function:
    PHYSICS.ATTACH_ENTITIES_TO_ROPE(rope_id, ent1, ent2, ent1_x, ent1_y, ent1_z, ent2_x, ent2_y, ent2_z, length, p10, p11, p12, p13)
end

-- The position supplied can be anywhere, and the entity should anchor relative to that point from it's origin
function module.attach_rope_to_entity(rope_id: int, entity: int, x: float, y: float, z: float, p5: bool): void
    PHYSICS.ATTACH_ROPE_TO_ENTITY(rope_id, entity, x, y, z, p5)
end

function module.detach_rope_from_entity(rope_id: int, entity: int): void
    PHYSICS.DETACH_ROPE_FROM_ENTITY(rope_id, entity)
end

function module.rope_set_update_pinverts(rope_id: int): void
    PHYSICS.ROPE_SET_UPDATE_PINVERTS(rope_id)
end

function module.rope_set_update_order(rope_id: int, p1: any): void
    PHYSICS.ROPE_SET_UPDATE_ORDER(rope_id, p1)
end

function module.rope_set_smooth_reelin(rope_id: int, p1: bool): void
    PHYSICS.ROPE_SET_SMOOTH_REELIN(rope_id, p1)
end

function module.start_rope_winding(rope_id: int): void
    PHYSICS.START_ROPE_WINDING(rope_id)
end

function module.stop_rope_winding(rope_id: int): void
    PHYSICS.STOP_ROPE_WINDING(rope_id)
end

function module.start_rope_unwinding_front(rope_id: int): void
    PHYSICS.START_ROPE_UNWINDING_FRONT(rope_id)
end

function module.stop_rope_unwinding_front(rope_id: int): void
    PHYSICS.STOP_ROPE_UNWINDING_FRONT(rope_id)
end

function module.rope_convert_to_simple(rope_id: int): void
    PHYSICS.ROPE_CONVERT_TO_SIMPLE(rope_id)
end

-- Loads rope textures for all ropes in the current scene
function module.rope_load_textures(): void
    PHYSICS.ROPE_LOAD_TEXTURES()
end

function module.rope_are_textures_loaded(): bool
    return PHYSICS.ROPE_ARE_TEXTURES_LOADED()
end

-- Unloads rope textures for all ropes in the current scene
function module.rope_unload_textures(): void
    PHYSICS.ROPE_UNLOAD_TEXTURES()
end

function module.rope_attach_virtual_bound_geom(
    rope_id: int, p1: int, p2: float, p3: float, p4: float, p5: float, p6: float, p7: float,
    p8: float, p9: float, p10: float, p11: float, p12: float, p13: float
): void
    -- body function:
    PHYSICS.ROPE_ATTACH_VIRTUAL_BOUND_GEOM(rope_id, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10, p11, p12, p13)
end

function module.rope_change_script_owner(p0: any, p1: bool, p2: bool): void
    PHYSICS.ROPE_CHANGE_SCRIPT_OWNER(p0, p1, p2)
end

function module.rope_set_refframevelocity_colliderorder(rope_id: int, p1: int): void
    PHYSICS.ROPE_SET_REFFRAMEVELOCITY_COLLIDERORDER(rope_id, p1)
end

function module.rope_get_distance_between_ends(rope_id: int): float
    return PHYSICS.ROPE_GET_DISTANCE_BETWEEN_ENDS(rope_id)
end

-- Forces a rope to a certain length
function module.rope_force_length(rope_id: int, length: float): void
    PHYSICS.ROPE_FORCE_LENGTH(rope_id, length)
end

-- Reset a rope to a certain length
function module.rope_reset_length(rope_id: int, length: float): void
    PHYSICS.ROPE_RESET_LENGTH(rope_id, length)
end

function module.apply_impulse_to_cloth(
    pos_x: float, pos_y: float, pos_z: float, vec_x: float, vec_y: float, vec_z: float,
    impulse: float
): void
    -- body function:
    PHYSICS.APPLY_IMPULSE_TO_CLOTH(pos_x, pos_y, pos_z, vec_x, vec_y, vec_z, impulse)
end

function module.activate_physics(entity: int): void
    PHYSICS.ACTIVATE_PHYSICS(entity)
end

function module.break_entity_glass(
    entity: int, p1: float, p2: float, p3: float, p4: float, p5: float, p6: float, p7: float,
    p8: float, p9: any, p10: bool
): void
    -- body function:
    PHYSICS.BREAK_ENTITY_GLASS(entity, p1, p2, p3, p4, p5, p6, p7, p8, p9, p10)
end

function module.reset_disable_breaking(object: int): void
    PHYSICS.RESET_DISABLE_BREAKING(object)
end

return Atdar.loader.auto(module, "natives/physics")
