-- Vehicle mods, liveries, colours, plates

local module = {}

-- State

function module.is_extra_turned_on(vehicle: int, extra_id: int): bool
    return VEHICLE.IS_VEHICLE_EXTRA_TURNED_ON(vehicle, extra_id)
end

-- Checks via CVehicleModelInfo
function module.does_extra_exist(vehicle: int, extra_id: int): bool
    return VEHICLE.DOES_EXTRA_EXIST(vehicle, extra_id)
end

function module.is_extra_broken_off(vehicle: int, extra_id: int): bool
    return VEHICLE.IS_EXTRA_BROKEN_OFF(vehicle, extra_id)
end

function module.have_mods_streamed_in(vehicle: int): bool
    return VEHICLE.HAVE_VEHICLE_MODS_STREAMED_IN(vehicle)
end

function module.is_mod_gen9_exclusive(vehicle: int, mod_type: int, mod_index: int): bool
    return VEHICLE.IS_VEHICLE_MOD_GEN9_EXCLUSIVE(vehicle, mod_type, mod_index)
end

function module.is_toggle_mod_on(vehicle: int, mod_type: int): bool
    return VEHICLE.IS_TOGGLE_MOD_ON(vehicle, mod_type)
end

function module.has_preload_mods_finished(vehicle: int): bool
    return VEHICLE.HAS_PRELOAD_MODS_FINISHED(vehicle)
end

-- Get

-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_custom_primary_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.GET_VEHICLE_CUSTOM_PRIMARY_COLOUR(vehicle, r, g, b)
end

function module.get_is_primary_colour_custom(vehicle: int): bool
    return VEHICLE.GET_IS_VEHICLE_PRIMARY_COLOUR_CUSTOM(vehicle)
end

-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_custom_secondary_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.GET_VEHICLE_CUSTOM_SECONDARY_COLOUR(vehicle, r, g, b)
end

-- Check if Vehicle Secondary is avaliable for customize
function module.get_is_secondary_colour_custom(vehicle: int): bool
    return VEHICLE.GET_IS_VEHICLE_SECONDARY_COLOUR_CUSTOM(vehicle)
end

-- @param color_primary Pointer: pass memory.alloc(size) and read the result back
-- @param color_secondary Pointer: pass memory.alloc(size) and read the result back
function module.get_colours(vehicle: int, color_primary: int, color_secondary: int): void
    VEHICLE.GET_VEHICLE_COLOURS(vehicle, color_primary, color_secondary)
end

-- Returns the license plate text from a vehicle. 8 chars maximum
function module.get_number_plate_text(vehicle: int): string
    return VEHICLE.GET_VEHICLE_NUMBER_PLATE_TEXT(vehicle)
end

-- Returns the number of *types* of licence plates, enumerated below in SET_VEHICLE_NUMBER_PLATE_TEXT_INDEX
function module.get_number_number_plates(): int
    return VEHICLE.GET_NUMBER_OF_VEHICLE_NUMBER_PLATES()
end

-- Returns the PlateType of a vehicle
function module.get_number_plate_text_index(vehicle: int): int
    return VEHICLE.GET_VEHICLE_NUMBER_PLATE_TEXT_INDEX(vehicle)
end

-- Returns the total amount of color combinations found in the vehicle's carvariations.meta entry
function module.get_number_colours(vehicle: int): int
    return VEHICLE.GET_NUMBER_OF_VEHICLE_COLOURS(vehicle)
end

-- Returns the index of the color combination found in the vehicle's carvariations.meta entry
function module.get_colour_combination(vehicle: int): int
    return VEHICLE.GET_VEHICLE_COLOUR_COMBINATION(vehicle)
end

-- Returns the headlight color index from the vehicle. Value between 0, 12
function module.get_xenon_light_color_index(vehicle: int): int
    return VEHICLE.GET_VEHICLE_XENON_LIGHT_COLOR_INDEX(vehicle)
end

-- @param pearlescent_color Pointer: pass memory.alloc(size) and read the result back
-- @param wheel_color Pointer: pass memory.alloc(size) and read the result back
function module.get_extra_colours(vehicle: int, pearlescent_color: int, wheel_color: int): void
    VEHICLE.GET_VEHICLE_EXTRA_COLOURS(vehicle, pearlescent_color, wheel_color)
end

-- @param color Pointer: pass memory.alloc(size) and read the result back
function module.get_extra_colour_5(vehicle: int, color: int): void
    VEHICLE.GET_VEHICLE_EXTRA_COLOUR_5(vehicle, color)
end

-- @param color Pointer: pass memory.alloc(size) and read the result back
function module.get_extra_colour_6(vehicle: int, color: int): void
    VEHICLE.GET_VEHICLE_EXTRA_COLOUR_6(vehicle, color)
end

function module.get_livery(vehicle: int): int
    return VEHICLE.GET_VEHICLE_LIVERY(vehicle)
end

-- Returns -1 if the vehicle has no livery
function module.get_livery_count(vehicle: int): int
    return VEHICLE.GET_VEHICLE_LIVERY_COUNT(vehicle)
end

-- Returns index of the current vehicle's secondary livery. A getter for SET_VEHICLE_LIVERY2
function module.get_livery2(vehicle: int): int
    return VEHICLE.GET_VEHICLE_LIVERY2(vehicle)
end

-- Returns a number of available secondary liveries, or -1 if vehicle has no secondary liveries available
function module.get_livery2_count(vehicle: int): int
    return VEHICLE.GET_VEHICLE_LIVERY2_COUNT(vehicle)
end

function module.get_model_max_braking_max_mods(model_hash: int): float
    return VEHICLE.GET_VEHICLE_MODEL_MAX_BRAKING_MAX_MODS(model_hash)
end

function module.get_model_acceleration_max_mods(model_hash: int): float
    return VEHICLE.GET_VEHICLE_MODEL_ACCELERATION_MAX_MODS(model_hash)
end

function module.get_num_mod_kits(vehicle: int): int
    return VEHICLE.GET_NUM_MOD_KITS(vehicle)
end

function module.get_mod_kit(vehicle: int): int
    return VEHICLE.GET_VEHICLE_MOD_KIT(vehicle)
end

function module.get_mod_kit_type(vehicle: int): int
    return VEHICLE.GET_VEHICLE_MOD_KIT_TYPE(vehicle)
end

function module.get_num_mod_colors(paint_type: int, p1: bool): int
    return VEHICLE.GET_NUM_MOD_COLORS(paint_type, p1)
end

-- @param paint_type Pointer: pass memory.alloc(size) and read the result back
-- @param color Pointer: pass memory.alloc(size) and read the result back
-- @param pearlescent_color Pointer: pass memory.alloc(size) and read the result back
function module.get_mod_color_1(vehicle: int, paint_type: int, color: int, pearlescent_color: int): void
    VEHICLE.GET_VEHICLE_MOD_COLOR_1(vehicle, paint_type, color, pearlescent_color)
end

-- @param paint_type Pointer: pass memory.alloc(size) and read the result back
-- @param color Pointer: pass memory.alloc(size) and read the result back
function module.get_mod_color_2(vehicle: int, paint_type: int, color: int): void
    VEHICLE.GET_VEHICLE_MOD_COLOR_2(vehicle, paint_type, color)
end

-- Returns a string which is the codename of the vehicle's currently selected primary color
function module.get_mod_color_1_name(vehicle: int, p1: bool): string
    return VEHICLE.GET_VEHICLE_MOD_COLOR_1_NAME(vehicle, p1)
end

-- Returns a string which is the codename of the vehicle's currently selected secondary color
function module.get_mod_color_2_name(vehicle: int): string
    return VEHICLE.GET_VEHICLE_MOD_COLOR_2_NAME(vehicle)
end

function module.get_mod(vehicle: int, mod_type: int): int
    return VEHICLE.GET_VEHICLE_MOD(vehicle, mod_type)
end

function module.get_mod_variation(vehicle: int, mod_type: int): int
    return VEHICLE.GET_VEHICLE_MOD_VARIATION(vehicle, mod_type)
end

-- Returns how many possible mods a vehicle has for a given mod type
function module.get_num_mods(vehicle: int, mod_type: int): int
    return VEHICLE.GET_NUM_VEHICLE_MODS(vehicle, mod_type)
end

-- Returns the text label of a mod type for a given vehicle
function module.get_mod_text_label(vehicle: int, mod_type: int, mod_value: int): string
    return VEHICLE.GET_MOD_TEXT_LABEL(vehicle, mod_type, mod_value)
end

-- Returns the name for the type of vehicle mod(Armour, engine etc)
function module.get_mod_slot_name(vehicle: int, mod_type: int): string
    return VEHICLE.GET_MOD_SLOT_NAME(vehicle, mod_type)
end

function module.get_livery_name(vehicle: int, livery_index: int): string
    return VEHICLE.GET_LIVERY_NAME(vehicle, livery_index)
end

function module.get_mod_modifier_value(vehicle: int, mod_type: int, mod_index: int): int
    return VEHICLE.GET_VEHICLE_MOD_MODIFIER_VALUE(vehicle, mod_type, mod_index)
end

-- Can be used for IS_DLC_VEHICLE_MOD and GET_DLC_VEHICLE_MOD_LOCK_HASH
function module.get_mod_identifier_hash(vehicle: int, mod_type: int, mod_index: int): int
    return VEHICLE.GET_VEHICLE_MOD_IDENTIFIER_HASH(vehicle, mod_type, mod_index)
end

-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_tyre_smoke_color(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.GET_VEHICLE_TYRE_SMOKE_COLOR(vehicle, r, g, b)
end

function module.get_window_tint(vehicle: int): int
    return VEHICLE.GET_VEHICLE_WINDOW_TINT(vehicle)
end

function module.get_num_window_tints(): int
    return VEHICLE.GET_NUM_VEHICLE_WINDOW_TINTS()
end

-- What's this for? Primary and Secondary RGB have their own natives and this one doesn't seem specific
-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_color(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.GET_VEHICLE_COLOR(vehicle, r, g, b)
end

-- Some kind of flags
function module.get_colours_which_can_be_set(vehicle: int): int
    return VEHICLE.GET_VEHICLE_COLOURS_WHICH_CAN_BE_SET(vehicle)
end

function module.get_plate_type(vehicle: int): int
    return VEHICLE.GET_VEHICLE_PLATE_TYPE(vehicle)
end

-- Gets the color of the neon lights of the specified vehicle
-- @param r Pointer: pass memory.alloc(size) and read the result back
-- @param g Pointer: pass memory.alloc(size) and read the result back
-- @param b Pointer: pass memory.alloc(size) and read the result back
function module.get_neon_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.GET_VEHICLE_NEON_COLOUR(vehicle, r, g, b)
end

function module.get_neon_enabled(vehicle: int, index: int): bool
    return VEHICLE.GET_VEHICLE_NEON_ENABLED(vehicle, index)
end

-- Set

function module.set_colours(vehicle: int, color_primary: int, color_secondary: int): void
    VEHICLE.SET_VEHICLE_COLOURS(vehicle, color_primary, color_secondary)
end

function module.set_custom_primary_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.SET_VEHICLE_CUSTOM_PRIMARY_COLOUR(vehicle, r, g, b)
end

function module.set_custom_secondary_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.SET_VEHICLE_CUSTOM_SECONDARY_COLOUR(vehicle, r, g, b)
end

-- Sets a vehicle's license plate text.  8 chars maximum
function module.set_number_plate_text(vehicle: int, plate_text: string): void
    VEHICLE.SET_VEHICLE_NUMBER_PLATE_TEXT(vehicle, plate_text)
end

function module.set_number_plate_text_index(vehicle: int, plate_index: int): void
    VEHICLE.SET_VEHICLE_NUMBER_PLATE_TEXT_INDEX(vehicle, plate_index)
end

function module.set_colour_combination(vehicle: int, color_combination: int): void
    VEHICLE.SET_VEHICLE_COLOUR_COMBINATION(vehicle, color_combination)
end

function module.set_xenon_light_color_index(vehicle: int, color_index: int): void
    VEHICLE.SET_VEHICLE_XENON_LIGHT_COLOR_INDEX(vehicle, color_index)
end

-- They use the same color indexs as SET_VEHICLE_COLOURS
function module.set_extra_colours(vehicle: int, pearlescent_color: int, wheel_color: int): void
    VEHICLE.SET_VEHICLE_EXTRA_COLOURS(vehicle, pearlescent_color, wheel_color)
end

function module.set_extra_colour_5(vehicle: int, color: int): void
    VEHICLE.SET_VEHICLE_EXTRA_COLOUR_5(vehicle, color)
end

function module.set_extra_colour_6(vehicle: int, color: int): void
    VEHICLE.SET_VEHICLE_EXTRA_COLOUR_6(vehicle, color)
end

-- Available extraIds are 1-14, however none of the vehicles have extras above 12
function module.set_extra(vehicle: int, extra_id: int, disable: bool): void
    VEHICLE.SET_VEHICLE_EXTRA(vehicle, extra_id, disable)
end

-- If set to TRUE, it seems to suppress door noises and doesn't allow the horn to be continuous
function module.set_in_car_mod_shop(vehicle: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_IN_CAR_MOD_SHOP(vehicle, toggle)
end

function module.set_livery(vehicle: int, livery: int): void
    VEHICLE.SET_VEHICLE_LIVERY(vehicle, livery)
end

function module.set_livery2(vehicle: int, livery: int): void
    VEHICLE.SET_VEHICLE_LIVERY2(vehicle, livery)
end

function module.set_mod_kit(vehicle: int, mod_kit: int): void
    VEHICLE.SET_VEHICLE_MOD_KIT(vehicle, mod_kit)
end

function module.set_mod_color_1(vehicle: int, paint_type: int, color: int, pearlescent_color: int): void
    VEHICLE.SET_VEHICLE_MOD_COLOR_1(vehicle, paint_type, color, pearlescent_color)
end

-- Changes the secondary paint type and color
function module.set_mod_color_2(vehicle: int, paint_type: int, color: int): void
    VEHICLE.SET_VEHICLE_MOD_COLOR_2(vehicle, paint_type, color)
end

-- In b944, there are 50 (0 - 49) mod types
function module.set_mod(vehicle: int, mod_type: int, mod_index: int, custom_tires: bool): void
    VEHICLE.SET_VEHICLE_MOD(vehicle, mod_type, mod_index, custom_tires)
end

-- Sets the tire smoke's color of this vehicle
function module.set_tyre_smoke_color(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.SET_VEHICLE_TYRE_SMOKE_COLOR(vehicle, r, g, b)
end

function module.set_window_tint(vehicle: int, tint: int): void
    VEHICLE.SET_VEHICLE_WINDOW_TINT(vehicle, tint)
end

-- Sets the color of the neon lights of the specified vehicle
function module.set_neon_colour(vehicle: int, r: int, g: int, b: int): void
    VEHICLE.SET_VEHICLE_NEON_COLOUR(vehicle, r, g, b)
end

-- Index references CVehicleModelColor
function module.set_neon_index_colour(vehicle: int, index: int): void
    VEHICLE.SET_VEHICLE_NEON_INDEX_COLOUR(vehicle, index)
end

-- Sets the neon lights of the specified vehicle on/off
function module.set_neon_enabled(vehicle: int, index: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_NEON_ENABLED(vehicle, index, toggle)
end

function module.set_ambient_neon_enabled(p0: bool): void
    VEHICLE.SET_AMBIENT_VEHICLE_NEON_ENABLED(p0)
end

function module.set_disable_bmx_extra_trick_forces(p0: any): void
    VEHICLE.SET_DISABLE_BMX_EXTRA_TRICK_FORCES(p0)
end

function module.set_parachute_model_tint_index(vehicle: int, texture_variation: int): void
    VEHICLE.VEHICLE_SET_PARACHUTE_MODEL_TINT_INDEX(vehicle, texture_variation)
end

-- Actions

function module.clear_custom_primary_colour(vehicle: int): void
    VEHICLE.CLEAR_VEHICLE_CUSTOM_PRIMARY_COLOUR(vehicle)
end

function module.clear_custom_secondary_colour(vehicle: int): void
    VEHICLE.CLEAR_VEHICLE_CUSTOM_SECONDARY_COLOUR(vehicle)
end

function module.remove_mod(vehicle: int, mod_type: int): void
    VEHICLE.REMOVE_VEHICLE_MOD(vehicle, mod_type)
end

function module.toggle_mod(vehicle: int, mod_type: int, toggle: bool): void
    VEHICLE.TOGGLE_VEHICLE_MOD(vehicle, mod_type, toggle)
end

function module.preload_mod(vehicle: int, mod_type: int, mod_index: int): void
    VEHICLE.PRELOAD_VEHICLE_MOD(vehicle, mod_type, mod_index)
end

function module.release_preload_mods(vehicle: int): void
    VEHICLE.RELEASE_PRELOAD_MODS(vehicle)
end

function module.suppress_neons_on(vehicle: int, toggle: bool): void
    VEHICLE.SUPPRESS_NEONS_ON_VEHICLE(vehicle, toggle)
end

return module
