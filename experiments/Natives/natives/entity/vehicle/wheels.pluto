-- Wheels and tyres

local module = {}

-- State

function module.is_tyre_burst(vehicle: int, wheel_id: int, completely: bool): bool
    return VEHICLE.IS_VEHICLE_TYRE_BURST(vehicle, wheel_id, completely)
end

-- Public Function isVehicleOnAllWheels(vh As Vehicle) As Boolean
function module.is_on_all_wheels(vehicle: int): bool
    return VEHICLE.IS_VEHICLE_ON_ALL_WHEELS(vehicle)
end

-- Get

function module.get_tyres_can_burst(vehicle: int): bool
    return VEHICLE.GET_VEHICLE_TYRES_CAN_BURST(vehicle)
end

function module.get_wheel_type(vehicle: int): int
    return VEHICLE.GET_VEHICLE_WHEEL_TYPE(vehicle)
end

function module.get_has_retractable_wheels(vehicle: int): bool
    return VEHICLE.GET_HAS_RETRACTABLE_WHEELS(vehicle)
end

function module.get_is_wheels_retracted(vehicle: int): bool
    return VEHICLE.GET_IS_WHEELS_RETRACTED(vehicle)
end

function module.get_tyre_health(vehicle: int, wheel_index: int): float
    return VEHICLE.GET_TYRE_HEALTH(vehicle, wheel_index)
end

-- Returns the multiplier value from SET_TYRE_WEAR_RATE
function module.get_tyre_wear_rate(vehicle: int, wheel_index: int): float
    return VEHICLE.GET_TYRE_WEAR_RATE(vehicle, wheel_index)
end

function module.get_drift_tyres_set(vehicle: int): bool
    return VEHICLE.GET_DRIFT_TYRES_SET(vehicle)
end

-- Set

function module.set_use_cutscene_wheel_compression(p0: int, p1: bool, p2: bool, p3: bool): bool
    return VEHICLE.SET_VEHICLE_USE_CUTSCENE_WHEEL_COMPRESSION(p0, p1, p2, p3)
end

function module.set_tyre_burst(vehicle: int, index: int, on_rim: bool, p3: float): void
    VEHICLE.SET_VEHICLE_TYRE_BURST(vehicle, index, on_rim, p3)
end

-- Allows you to toggle bulletproof tires
function module.set_tyres_can_burst(vehicle: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_TYRES_CAN_BURST(vehicle, toggle)
end

function module.set_wheels_can_break(vehicle: int, enabled: bool): void
    VEHICLE.SET_VEHICLE_WHEELS_CAN_BREAK(vehicle, enabled)
end

function module.set_tyre_fixed(vehicle: int, tyre_index: int): void
    VEHICLE.SET_VEHICLE_TYRE_FIXED(vehicle, tyre_index)
end

function module.set_wheel_type(vehicle: int, wheel_type: int): void
    VEHICLE.SET_VEHICLE_WHEEL_TYPE(vehicle, wheel_type)
end

function module.set_can_deform_wheels(vehicle: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_CAN_DEFORM_WHEELS(vehicle, toggle)
end

function module.set_wheels_can_break_off_when_blow_up(vehicle: int, toggle: bool): void
    VEHICLE.SET_VEHICLE_WHEELS_CAN_BREAK_OFF_WHEN_BLOW_UP(vehicle, toggle)
end

function module.set_hydraulic_wheel_state(
    vehicle: int, wheel_id: int, state: int, value: float, p4: any
): void
    -- body function:
    VEHICLE.SET_HYDRAULIC_WHEEL_STATE(vehicle, wheel_id, state, value, p4)
end

function module.set_wheels_extended_instantly(vehicle: int): void
    VEHICLE.SET_WHEELS_EXTENDED_INSTANTLY(vehicle)
end

function module.set_wheels_retracted_instantly(vehicle: int): void
    VEHICLE.SET_WHEELS_RETRACTED_INSTANTLY(vehicle)
end

function module.set_use_boost_button_for_wheel_retract(toggle: bool): void
    VEHICLE.SET_VEHICLE_USE_BOOST_BUTTON_FOR_WHEEL_RETRACT(toggle)
end

-- Enables/disables the ability to wheelie on motorcycles
function module.set_wheelie_enabled(vehicle: int, enabled: bool): void
    VEHICLE.SET_WHEELIE_ENABLED(vehicle, enabled)
end

function module.set_increase_wheel_crush_damage(vehicle: int, toggle: bool): void
    VEHICLE.SET_INCREASE_WHEEL_CRUSH_DAMAGE(vehicle, toggle)
end

-- SET_TYRE_WEAR_RATE must be active, otherwise values set to <1000.0f will default to 350.0f
function module.set_tyre_health(vehicle: int, wheel_index: int, health: float): void
    VEHICLE.SET_TYRE_HEALTH(vehicle, wheel_index, health)
end

function module.set_tyre_wear_rate(vehicle: int, wheel_index: int, multiplier: float): void
    VEHICLE.SET_TYRE_WEAR_RATE(vehicle, wheel_index, multiplier)
end

-- Controls how fast the tires wear out
function module.set_tyre_wear_rate_scale(vehicle: int, wheel_index: int, multiplier: float): void
    VEHICLE.SET_TYRE_WEAR_RATE_SCALE(vehicle, wheel_index, multiplier)
end

-- Controls how much traction the wheel loses
function module.set_tyre_maximum_grip_difference_due_to_wear_rate(
    vehicle: int, wheel_index: int, multiplier: float
): void
    -- body function:
    VEHICLE.SET_TYRE_MAXIMUM_GRIP_DIFFERENCE_DUE_TO_WEAR_RATE(vehicle, wheel_index, multiplier)
end

function module.set_drift_tyres(vehicle: int, toggle: bool): void
    VEHICLE.SET_DRIFT_TYRES(vehicle, toggle)
end

-- Actions

function module.reset_wheels(vehicle: int, toggle: bool): void
    VEHICLE.RESET_VEHICLE_WHEELS(vehicle, toggle)
end

return module
