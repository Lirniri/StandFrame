-- Trains

local module = {}

-- State

function module.is_mission(train: int): bool
    return VEHICLE.IS_MISSION_TRAIN(train)
end

-- Get

function module.get_carriage(train: int, trailer_number: int): int
    return VEHICLE.GET_TRAIN_CARRIAGE(train, trailer_number)
end

-- Returns the vehicle's drivetrain type
function module.get_drivetrain_type(vehicle_model: int): int
    return VEHICLE._GET_VEHICLE_DRIVETRAIN_TYPE(vehicle_model)
end

-- Set

function module.set_disable_random_trains_this_frame(toggle: bool): void
    VEHICLE.SET_DISABLE_RANDOM_TRAINS_THIS_FRAME(toggle)
end

function module.set_random_trains(toggle: bool): void
    VEHICLE.SET_RANDOM_TRAINS(toggle)
end

function module.set_track_spawn_frequency(track_index: int, frequency: int): void
    VEHICLE.SET_TRAIN_TRACK_SPAWN_FREQUENCY(track_index, frequency)
end

function module.set_speed(train: int, speed: float): void
    VEHICLE.SET_TRAIN_SPEED(train, speed)
end

function module.set_cruise_speed(train: int, speed: float): void
    VEHICLE.SET_TRAIN_CRUISE_SPEED(train, speed)
end

-- @param train Pointer: pass memory.alloc(size) and read the result back
function module.set_mission_as_no_longer_needed(train: int, p1: bool): void
    VEHICLE.SET_MISSION_TRAIN_AS_NO_LONGER_NEEDED(train, p1)
end

function module.set_mission_coords(train: int, x: float, y: float, z: float): void
    VEHICLE.SET_MISSION_TRAIN_COORDS(train, x, y, z)
end

function module.set_render_as_derailed(train: int, toggle: bool): void
    VEHICLE.SET_RENDER_TRAIN_AS_DERAILED(train, toggle)
end

-- Actions

-- Train models HAVE TO be loaded (requested) before you use this
function module.create_mission(
    variation: int, x: float, y: float, z: float, direction: bool, p5: any, p6: any
): int
    -- body function:
    return VEHICLE.CREATE_MISSION_TRAIN(variation, x, y, z, direction, p5, p6)
end

-- Toggles whether ambient trains can spawn on the specified track or not
function module.switch_track(track_id: int, state: bool): void
    VEHICLE.SWITCH_TRAIN_TRACK(track_id, state)
end

function module.allow_to_be_removed_by_population(p0: any): void
    VEHICLE.ALLOW_TRAIN_TO_BE_REMOVED_BY_POPULATION(p0)
end

function module.delete_all_trains(): void
    VEHICLE.DELETE_ALL_TRAINS()
end

-- @param train Pointer: pass memory.alloc(size) and read the result back
function module.delete_mission(train: int): void
    VEHICLE.DELETE_MISSION_TRAIN(train)
end

-- Implemented only for trains
function module.network_use_high_precision_blending(vehicle: int, toggle: bool): void
    VEHICLE.NETWORK_USE_HIGH_PRECISION_TRAIN_BLENDING(vehicle, toggle)
end

return module
