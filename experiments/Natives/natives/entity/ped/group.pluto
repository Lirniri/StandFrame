-- Ped groups

local module = {}

-- State

function module.is_group_member(ped: int, group_id: int): bool
    return PED.IS_PED_GROUP_MEMBER(ped, group_id)
end

function module.does_relationship_group_exist(group_hash: int): bool
    return PED.DOES_RELATIONSHIP_GROUP_EXIST(group_hash)
end

function module.does_group_exist(group_id: int): bool
    return PED.DOES_GROUP_EXIST(group_id)
end

function module.is_in_group(ped: int): bool
    return PED.IS_PED_IN_GROUP(ped)
end

-- Get

function module.get_relationship_group_default_hash(ped: int): int
    return PED.GET_PED_RELATIONSHIP_GROUP_DEFAULT_HASH(ped)
end

function module.get_relationship_group_hash(ped: int): int
    return PED.GET_PED_RELATIONSHIP_GROUP_HASH(ped)
end

-- Gets the relationship between two groups. This should be called twice (once for each group)
function module.get_relationship_between_groups(group1: int, group2: int): int
    return PED.GET_RELATIONSHIP_BETWEEN_GROUPS(group1, group2)
end

-- @param p1 Pointer: pass memory.alloc(size) and read the result back
-- @param size_in_members Pointer: pass memory.alloc(size) and read the result back
function module.get_group_size(group_id: int, p1: int, size_in_members: int): void
    PED.GET_GROUP_SIZE(group_id, p1, size_in_members)
end

-- Returns the group id of which the specified ped is a member of
function module.get_group_index(ped: int): int
    return PED.GET_PED_GROUP_INDEX(ped)
end

function module.get_as_group_member(group_id: int, member_number: int): int
    return PED.GET_PED_AS_GROUP_MEMBER(group_id, member_number)
end

function module.get_as_group_leader(group_id: int): int
    return PED.GET_PED_AS_GROUP_LEADER(group_id)
end

-- Set

function module.set_as_group_leader(ped: int, group_id: int): void
    PED.SET_PED_AS_GROUP_LEADER(ped, group_id)
end

function module.set_as_group_member(ped: int, group_id: int): void
    PED.SET_PED_AS_GROUP_MEMBER(ped, group_id)
end

-- This only will teleport the ped to the group leader if the group leader teleports (sets coords)
function module.set_can_teleport_to_group_leader(ped_handle: int, group_handle: int, toggle: bool): void
    PED.SET_PED_CAN_TELEPORT_TO_GROUP_LEADER(ped_handle, group_handle, toggle)
end

-- Sets the range at which members will automatically leave the group
function module.set_group_separation_range(group_handle: int, separation_range: float): void
    PED.SET_GROUP_SEPARATION_RANGE(group_handle, separation_range)
end

function module.set_relationship_group_default_hash(ped: int, hash: int): void
    PED.SET_PED_RELATIONSHIP_GROUP_DEFAULT_HASH(ped, hash)
end

function module.set_relationship_group_hash(ped: int, hash: int): void
    PED.SET_PED_RELATIONSHIP_GROUP_HASH(ped, hash)
end

-- Sets the relationship between two groups. This should be called twice (once for each group)
function module.set_relationship_between_groups(relationship: int, group1: int, group2: int): void
    PED.SET_RELATIONSHIP_BETWEEN_GROUPS(relationship, group1, group2)
end

function module.set_relationship_group_affects_wanted_level(group: int, p1: bool): void
    PED.SET_RELATIONSHIP_GROUP_AFFECTS_WANTED_LEVEL(group, p1)
end

function module.set_group_formation(group_id: int, formation_type: int): void
    PED.SET_GROUP_FORMATION(group_id, formation_type)
end

function module.set_group_formation_spacing(group_id: int, x: float, y: float, z: float): void
    PED.SET_GROUP_FORMATION_SPACING(group_id, x, y, z)
end

function module.set_never_leaves_group(ped: int, toggle: bool): void
    PED.SET_PED_NEVER_LEAVES_GROUP(ped, toggle)
end

function module.set_gesture_group(ped: int, anim_group_gesture: string): void
    PED.SET_PED_GESTURE_GROUP(ped, anim_group_gesture)
end

function module.set_group_member_passenger_index(ped: int, index: int): void
    PED.SET_PED_GROUP_MEMBER_PASSENGER_INDEX(ped, index)
end

-- Actions

-- Creates a new ped group
function module.create_group(unused: int): int
    return PED.CREATE_GROUP(unused)
end

function module.remove_group(group_id: int): void
    PED.REMOVE_GROUP(group_id)
end

function module.remove_from_group(ped: int): void
    PED.REMOVE_PED_FROM_GROUP(ped)
end

-- Clears the relationship between two groups. This should be called twice (once for each group)
function module.clear_relationship_between_groups(relationship: int, group1: int, group2: int): void
    PED.CLEAR_RELATIONSHIP_BETWEEN_GROUPS(relationship, group1, group2)
end

-- @param group_hash Pointer: pass memory.alloc(size) and read the result back
function module.add_relationship_group(name: string, group_hash: int): bool
    return PED.ADD_RELATIONSHIP_GROUP(name, group_hash)
end

function module.remove_relationship_group(group_hash: int): void
    PED.REMOVE_RELATIONSHIP_GROUP(group_hash)
end

function module.tell_group_peds_in_area_to_attack(
    ped: int, p1: any, p2: float, hash: int, p4: any, p5: any
): void
    -- body function:
    PED.TELL_GROUP_PEDS_IN_AREA_TO_ATTACK(ped, p1, p2, hash, p4, p5)
end

function module.reset_group_formation_default_spacing(group_handle: int): void
    PED.RESET_GROUP_FORMATION_DEFAULT_SPACING(group_handle)
end

return module
