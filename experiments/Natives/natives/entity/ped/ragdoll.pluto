-- Ragdoll state of peds

local module = {}

-- State

function module.is_running_task(ped: int): bool
    return PED.IS_PED_RUNNING_RAGDOLL_TASK(ped)
end

-- Get

function module.get_bone_index(ped: int, bone: int): int
    return PED.GET_PED_RAGDOLL_BONE_INDEX(ped, bone)
end

-- Set

function module.set_corpse_friction(ped: int, p1: float): void
    PED.SET_CORPSE_RAGDOLL_FRICTION(ped, p1)
end

function module.set_to_ragdoll(
    ped: int, time1: int, time2: int, ragdoll_type: int, p4: bool, p5: bool, p6: bool
): bool
    -- body function:
    return PED.SET_PED_TO_RAGDOLL(ped, time1, time2, ragdoll_type, p4, p5, p6)
end

-- Return variable is never used in R*'s scripts
function module.set_with_fall(
    ped: int, time: int, p2: int, ragdoll_type: int, x: float, y: float, z: float, velocity: float,
    p8: float, p9: float, p10: float, p11: float, p12: float, p13: float
): bool
    -- body function:
    return PED.SET_PED_TO_RAGDOLL_WITH_FALL(ped, time, p2, ragdoll_type, x, y, z, velocity, p8, p9, p10, p11, p12, p13)
end

function module.set_on_collision(ped: int, toggle: bool): void
    PED.SET_PED_RAGDOLL_ON_COLLISION(ped, toggle)
end

function module.set_force_fall(ped: int): void
    PED.SET_PED_RAGDOLL_FORCE_FALL(ped)
end

function module.set_can(ped: int, toggle: bool): void
    PED.SET_PED_CAN_RAGDOLL(ped, toggle)
end

-- Works for both player and peds,
function module.set_blocking_flags(ped: int, blocking_flag: int): void
    PED.SET_RAGDOLL_BLOCKING_FLAGS(ped, blocking_flag)
end

function module.set_can_from_player_impact(ped: int, toggle: bool): void
    PED.SET_PED_CAN_RAGDOLL_FROM_PLAYER_IMPACT(ped, toggle)
end

-- Actions

function module.reset_timer(ped: int): void
    PED.RESET_PED_RAGDOLL_TIMER(ped)
end

function module.clear_blocking_flags(ped: int, blocking_flag: int): void
    PED.CLEAR_RAGDOLL_BLOCKING_FLAGS(ped, blocking_flag)
end

function module.request_bounds_update(p0: any, p1: any): void
    PED.REQUEST_RAGDOLL_BOUNDS_UPDATE(p0, p1)
end

return module
