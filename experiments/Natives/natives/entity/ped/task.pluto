function module.request_move_network_state_transition(ped: int, name: string): bool
    return TASK.REQUEST_TASK_MOVE_NETWORK_STATE_TRANSITION(ped, name)
end

function module.synchronized_scene(
    ped: int, scene: int, anim_dictionary: string, animation_name: string, blend_in: float,
    blend_out: float, flags: int, ragdoll_blocking_flags: int, mover_blend_delta: float,
    ik_flags: int
): void
    -- body function:
    TASK.TASK_SYNCHRONIZED_SCENE(ped, scene, anim_dictionary, animation_name, blend_in, blend_out, flags, ragdoll_blocking_flags, mover_blend_delta, ik_flags)
end

function module.agitated_action_confront_response(ped: int, ped2: int): void
    TASK.TASK_AGITATED_ACTION_CONFRONT_RESPONSE(ped, ped2)
end

-- This function is called on peds in vehicles
function module.sweep_aim_entity(
    ped: int, anim_dict: string, low_anim_name: string, med_anim_name: string, hi_anim_name: string,
    runtime: int, target_entity: int, turn_rate: float, blend_in_duration: float
): void
    -- body function:
    TASK.TASK_SWEEP_AIM_ENTITY(ped, anim_dict, low_anim_name, med_anim_name, hi_anim_name, runtime, target_entity, turn_rate, blend_in_duration)
end

function module.update_sweep_aim_entity(ped: int, entity: int): void
    TASK.UPDATE_TASK_SWEEP_AIM_ENTITY(ped, entity)
end

function module.sweep_aim_position(
    ped: int, anim_dict: string, low_anim_name: string, med_anim_name: string, hi_anim_name: string,
    runtime: int, x: float, y: float, z: float, turn_rate: float, blend_in_duration: float
): void
    -- body function:
    TASK.TASK_SWEEP_AIM_POSITION(ped, anim_dict, low_anim_name, med_anim_name, hi_anim_name, runtime, x, y, z, turn_rate, blend_in_duration)
end

function module.update_sweep_aim_position(ped: int, x: float, y: float, z: float): void
    TASK.UPDATE_TASK_SWEEP_AIM_POSITION(ped, x, y, z)
end

function module.arrest(ped: int, target: int): void
    TASK.TASK_ARREST_PED(ped, target)
end

function module.uncuff(ped: int): void
    TASK.UNCUFF_PED(ped)
end

return module
