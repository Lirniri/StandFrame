-- Actions

-- Waits until is_loaded() or the timeout runs out; warns on timeout.
-- Yields, so call it from a tick or thread, not the script's main body
-- @return Whether the asset loaded
function module.wait_loaded(what: string, is_loaded: function, timeout: int): bool

    local deadline = util.current_time_millis() + timeout
    
    while not is_loaded() and util.current_time_millis() < deadline do
        util.yield()
    end

    if is_loaded() then
        return true
    end

    log:warn($"{what} didn't load in {timeout} ms")

    return false
end

-- Asset type -> its request function, picked by request()
local REQUEST = {
    action_mode = |opts| -> module.action_mode.asset.request(opts.name, opts.timeout),
    stealth_mode = |opts| -> module.stealth_mode.asset.request(opts.name, opts.timeout),
    ptfx = |opts| -> module.ptfx.asset.request(opts.name, opts.timeout),
    vehicle = |opts| -> module.vehicle.asset.request(opts.model, opts.asset, opts.timeout),
    texture_dict = |opts| -> module.texture_dict.asset.request(opts.name, opts.timeout),
    model = |opts| -> module.model.asset.request(opts.model, opts.timeout),
}

-- One entry point for all asset types; opts.what picks the type, the rest are its arguments:
--   { what = "action_mode" | "stealth_mode" | "ptfx" | "texture_dict", name = "...", timeout = 2000 }
--   { what = "vehicle", model = "adder", asset = 0, timeout = 2000 }
--   { what = "model", model = "adder", timeout = 2000 }
-- @return Whether the asset loaded
function module.request(opts: table): bool
    local request = REQUEST[opts.what]
    if not request then
        log:error($"unknown asset type '{tostring(opts.what)}', expected action_mode, stealth_mode, ptfx, texture_dict, model or vehicle")
        return false
    end
    return request(opts)
end

