local builder = Atdar.loader.load("ui/stand/core/menu_builder")
local lang = Atdar.lang

return {
    build = function(node, ctx)
        builder.build_items(node, {
            { list = lang.translate("menu.self.menu_name"), items = {
                { list = lang.translate("menu.self.movement.menu_name"), items = {
                    { feature = "self.movement.ragdoll_control",
                      name = lang.translate("menu.self.movement.ragdoll_control.menu_name"),
                      commands = { "ragcontrol" } },
                } },
                { feature = "self.godmode",
                  name = lang.translate("menu.self.godmode.menu_name"),
                  commands = { "godmode" } },
                { feature = "self.half_godmode",
                  name = lang.translate("menu.self.half_godmode.menu_name"),
                  commands = { "halfgodmode" } },
            } },
        })
    end,
}





local features = Atdar.features
local lang = Atdar.lang

return {
    build = function(node, ctx)
        local self_menu = node:list(
            lang.translate("menu.self.menu_name")
        )

        local movement = self_menu:list(
            lang.translate("menu.self.movement.menu_name")
        )
        movement:add_feature(
            features.get("self.movement.ragdoll_control"),
            lang.translate("menu.self.movement.ragdoll_control.menu_name"),
            { "ragcontrol" }
        )

        self_menu:add_feature(
            features.get("self.godmode"),
            lang.translate("menu.self.godmode.menu_name"),
            { "godmode" }
        )
        self_menu:add_feature(
            features.get("self.half_godmode"),
            lang.translate("menu.self.half_godmode.menu_name"),
            { "halfgodmode" }
        )
    end,
}
